# ============================================================================
# Loss functions
# ============================================================================
def mse_loss(input: Tensor, target: Tensor, reduction: str = 'mean') -> Tensor: ...
def l1_loss(input: Tensor, target: Tensor, reduction: str = 'mean') -> Tensor: ...
def smooth_l1_loss(input: Tensor, target: Tensor, reduction: str = 'mean',
