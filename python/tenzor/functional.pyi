def cross_entropy(input: Tensor, target: Tensor, weight: Optional[Tensor] = None,
                  reduction: str = 'mean', label_smoothing: float = 0.0) -> Tensor: ...
def nll_loss(input: Tensor, target: Tensor, weight: Optional[Tensor] = None,
             reduction: str = 'mean') -> Tensor: ...
def bce_loss(input: Tensor, target: Tensor, weight: Optional[Tensor] = None,
             reduction: str = 'mean') -> Tensor: ...
def binary_cross_entropy_with_logits(input: Tensor, target: Tensor,
                                      weight: Optional[Tensor] = None,
                                      reduction: str = 'mean',
                                      pos_weight: Optional[Tensor] = None) -> Tensor: ...
def kl_div(input: Tensor, target: Tensor, reduction: str = 'mean',
           log_target: bool = False) -> Tensor: ...
def focal_loss(input: Tensor, target: Tensor, alpha: float = 0.25,
