                  running_var: Optional[Tensor] = None,
                  weight: Optional[Tensor] = None, bias: Optional[Tensor] = None,
                  training: bool = True, momentum: float = 0.1,
                  eps: float = 1e-5) -> Tensor: ...
def rms_norm(input: Tensor, normalized_shape: List[int],
