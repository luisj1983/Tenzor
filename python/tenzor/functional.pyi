def dice_loss(input: Tensor, target: Tensor, smooth: float = 1.0,
              reduction: str = 'mean') -> Tensor: ...
def ctc_loss(log_probs: Tensor, targets: Tensor, input_lengths: Tensor,
             target_lengths: Tensor, blank: int = 0,
             reduction: str = 'mean') -> Tensor: ...
def soft_margin_loss(input: Tensor, target: Tensor, reduction: str = 'mean') -> Tensor: ...
def hinge_embedding_loss(input: Tensor, target: Tensor, margin: float = 1.0,
                         reduction: str = 'mean') -> Tensor: ...
def poisson_nll_loss(input: Tensor, target: Tensor, log_input: bool = True,
                     full: bool = False, eps: float = 1e-8,
                     reduction: str = 'mean') -> Tensor: ...
