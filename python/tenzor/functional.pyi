           groups: int = 1) -> Tensor: ...
def conv3d(input: Tensor, weight: Tensor, bias: Optional[Tensor] = None,
           stride: Union[int, Tuple[int, int, int]] = 1,
           padding: Union[int, Tuple[int, int, int]] = 0,
           dilation: Union[int, Tuple[int, int, int]] = 1,
           groups: int = 1) -> Tensor: ...
