# Audit-8 II.12: ``tenzor.exceptions`` is the namespaced surface for the
# typed Tenzor exceptions (ShapeError, DTypeError, ValueError, ...). The
# typed exceptions live there rather than at the root to avoid shadowing
# Python builtins on ``from tenzor import *``. Unqualified attribute access
# such as ``tz.ShapeError`` still works at runtime through the wildcard
# import of ``tenzor_core``.
from . import exceptions as exceptions

# Type aliases
Shape = Union[Tuple[int, ...], List[int]]
Scalar = Union[int, float, bool]
ArrayLike = Union[Scalar, Sequence[Scalar], np.ndarray]

class DType(Enum):
    """Data type enumeration."""
    Float32: DType
    Float64: DType
    Float16: DType
    BFloat16: DType
    Int8: DType
    Int16: DType
    Int32: DType
    Int64: DType
    UInt8: DType
    Bool: DType
    Complex64: DType
    Complex128: DType

class DeviceType(Enum):
    """Device type enumeration."""
    CPU: DeviceType
    CUDA: DeviceType
    ROCM: DeviceType
    OneAPI: DeviceType

class Device:
    """Device specification for tensor operations."""

    type: DeviceType
    index: int

    def __init__(self, type: DeviceType, index: int = 0) -> None: ...

    @staticmethod
    def cpu() -> Device: ...

    @staticmethod
    def cuda(index: int = 0) -> Device: ...

    @staticmethod
    def rocm(index: int = 0) -> Device: ...

    @staticmethod
    def oneapi(index: int = 0) -> Device: ...

    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

