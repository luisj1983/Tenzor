def fp8_max_value(fp8_dtype: DType) -> float: ...
def compute_amax(tensor: Tensor) -> float: ...
def compute_fp8_scale(amax: float, fp8_dtype: DType) -> float: ...
def quantize_to_fp8(
    input: Tensor,
    fp8_dtype: DType,
    scale: Optional[float] = None,
    stochastic_rounding: bool = False
) -> Tuple[Tensor, Any]: ...
def dequantize_from_fp8(fp8_tensor: Tensor, scale: float) -> Tensor: ...

