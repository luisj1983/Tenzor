# Autograd context managers
class _NoGradContext:
    """Context manager and decorator to disable gradient computation."""
    def __enter__(self) -> _NoGradContext: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    def __call__(self, func: Any) -> Any: ...

class _EnableGradContext:
    """Context manager and decorator to enable gradient computation."""
    def __enter__(self) -> _EnableGradContext: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    def __call__(self, func: Any) -> Any: ...

class _SetGradEnabledContext:
    """Context manager to set gradient computation mode."""
    def __enter__(self) -> _SetGradEnabledContext: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

def no_grad() -> _NoGradContext: ...
def enable_grad() -> _EnableGradContext: ...
def set_grad_enabled(mode: bool) -> _SetGradEnabledContext: ...

