@PACKAGE_INIT@

set(TENZOR_VERSION "@PROJECT_VERSION@")

# Backend availability flags — reflect what was ACTUALLY built (the backend's
# target existed at configure time), not merely what was requested via
# TENZOR_BUILD_*. A requested backend can be auto-disabled (e.g. CUDA with no
# compiler), so keying off the request would falsely advertise it as available.
set(Tenzor_CUDA_FOUND @TENZOR_CUDA_BUILT@)
set(Tenzor_ROCM_FOUND @TENZOR_ROCM_BUILT@)
set(Tenzor_ONEAPI_FOUND @TENZOR_ONEAPI_BUILT@)
set(Tenzor_VULKAN_FOUND @TENZOR_VULKAN_BUILT@)
set(Tenzor_MPS_FOUND @TENZOR_MPS_BUILT@)

# Find required dependencies
include(CMakeFindDependencyMacro)
find_dependency(Threads)
# OpenMP is optional for the core library (see root CMakeLists), so only
# require it downstream if it was actually found at build time.
if(@TENZOR_OPENMP_FOUND@)
    find_dependency(OpenMP)
endif()

# Model Hub dependencies (CURL + OpenSSL are linked PUBLIC when enabled)
if(@TENZOR_BUILD_MODEL_HUB@)
    find_dependency(CURL)
    find_dependency(OpenSSL)
endif()

# Component checking: allow find_package(Tenzor COMPONENTS CUDA Vulkan ...)
foreach(_comp ${Tenzor_FIND_COMPONENTS})
    if(NOT Tenzor_${_comp}_FOUND)
        set(Tenzor_FOUND FALSE)
        set(Tenzor_NOT_FOUND_MESSAGE "Required component '${_comp}' not available")
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/TenzorTargets.cmake")

check_required_components(Tenzor)
