# Include C++ headers and sources
recursive-include include *.hpp *.h
recursive-include src *.cpp *.cu *.hip.cpp *.hpp *.h

# Include Vulkan/compute shaders
recursive-include src *.comp *.glsl *.spv

# Include CMake build files
include CMakeLists.txt
recursive-include cmake *.cmake *.cmake.in *.pc.in
recursive-include src CMakeLists.txt

# Include project metadata and build config
include pyproject.toml
include setup.py
include MANIFEST.in

# Include documentation
include README.md
include LICENSE
include CONTRIBUTING.md
recursive-include docs *.md *.rst

# Include Python files and type stubs
recursive-include python *.py *.pyi
include python/tenzor/py.typed

# Include examples
recursive-include examples *.py *.cpp

# Exclude build artifacts and caches
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .git*
global-exclude *.so
global-exclude *.o
global-exclude *.obj
global-exclude *.a
global-exclude *.lib
prune build
prune dist
prune .eggs
prune .tox
prune .mypy_cache
prune .pytest_cache
