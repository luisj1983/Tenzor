#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Bitwise left shift (int64, native): output[i] = a[i] << b[i]. Avoids the
// lossy Int32-narrowing path used for other integer widths (see
// bitwise_and_i64.comp).
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputA { int64_t data[]; } a_buf;
layout(set = 0, binding = 1) readonly buffer InputB { int64_t data[]; } b_buf;
layout(set = 0, binding = 2) writeonly buffer OutputBuffer { int64_t data[]; } output_buf;

layout(push_constant) uniform PushConstants { uint num_elements; } pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    // Shift amounts outside [0, 64) are GLSL-spec-undefined; guard explicitly
    // to match CPU's defined out-of-range semantics (result is 0).
    int64_t a = a_buf.data[idx];
    int64_t b = b_buf.data[idx];
    output_buf.data[idx] = (b < int64_t(0) || b >= int64_t(64))
        ? int64_t(0)
        : int64_t(uint64_t(a) << uint64_t(b));
}
