#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// SearchSorted for BFloat16: binary search per query element over a sorted array
// BFloat16 elements are packed 2 per 32-bit word in uint buffers
// Output is Int32 indices (not packed)
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer SortedArray { uint sorted_data[]; };   // Packed BF16 pairs
layout(binding = 1) buffer QueryValues { uint query_data[]; };    // Packed BF16 pairs
layout(binding = 2) buffer OutputIndices { int output_indices[]; };

layout(push_constant) uniform PushConstants {
    uint array_size;    // Length of the sorted array (in elements)
    uint num_queries;   // Number of query values (in elements)
} params;

// Read a single BFloat16 element from packed uint32 sorted array
float readSorted(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (sorted_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackBF16x2(bits).x;
}

// Read a single BFloat16 element from packed uint32 query array
float readQuery(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (query_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackBF16x2(bits).x;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_queries) return;

    float query = readQuery(idx);

    // Standard binary search: find leftmost insertion point
    uint lo = 0;
    uint hi = params.array_size;

    while (lo < hi) {
        uint mid = lo + (hi - lo) / 2;
        if (readSorted(mid) < query) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }

    output_indices[idx] = int(lo);
}
