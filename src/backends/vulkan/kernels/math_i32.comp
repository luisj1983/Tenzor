#version 450

// Math operations for int32: add, sub, mul, div, neg, abs, sign
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { int a[]; };
layout(binding = 1) buffer InputB { int b[]; };
layout(binding = 2) buffer Output { int result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 7=neg, 8=abs, 10=sign, 36=gcd, 37=lcm
    float param;     // Unused for int ops (kept for layout compatibility)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    int val_a = a[idx];
    int val_b = b[idx];

    switch (params.op) {
        case 0: // add
            result[idx] = val_a + val_b;
            break;
        case 1: // sub
            result[idx] = val_a - val_b;
            break;
        case 2: // mul
            result[idx] = val_a * val_b;
            break;
        case 3: // div
            result[idx] = (val_b != 0) ? (val_a / val_b) : 0;
            break;
        case 24: // fmod (binary, truncated; matches torch.fmod)
            result[idx] = (val_b != 0) ? (val_a % val_b) : 0;
            break;
        case 25: { // remainder (binary, floored; matches torch.remainder)
            int r = (val_b != 0) ? (val_a % val_b) : 0;
            if (r != 0 && ((r < 0) != (val_b < 0))) r += val_b;
            result[idx] = r;
            break;
        }
        case 7: // neg (unary)
            result[idx] = -val_a;
            break;
        case 8: // abs (unary)
            result[idx] = (val_a < 0) ? -val_a : val_a;
            break;
        case 10: // sign (unary)
            if (val_a < 0) {
                result[idx] = -1;
            } else if (val_a > 0) {
                result[idx] = 1;
            } else {
                result[idx] = 0;
            }
            break;
        case 36: { // gcd (binary)
            int ga = val_a < 0 ? -val_a : val_a;
            int gb = val_b < 0 ? -val_b : val_b;
            while (gb != 0) { int t = gb; gb = ga - (ga / gb) * gb; ga = t; }
            result[idx] = ga;
            break;
        }
        case 37: { // lcm (binary)
            int ga = val_a < 0 ? -val_a : val_a;
            int gb = val_b < 0 ? -val_b : val_b;
            int ta = ga; int tb = gb;
            while (tb != 0) { int t = tb; tb = ta - (ta / tb) * tb; ta = t; }
            int g = ta;
            result[idx] = (g == 0) ? 0 : (ga / g) * gb;
            break;
        }
        case 52: { // bitwise_not
            result[idx] = ~val_a;
            break;
        }
        default:
            result[idx] = val_a;
            break;
    }
}
