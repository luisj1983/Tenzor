#version 450

// Blocked QR — panel factorization using Householder reflections
// Factorizes columns [col_start, col_start+panel_cols) of matrix A
// Stores Householder vectors below diagonal, R on/above diagonal
// Also builds compact WY representation: Q = I - V*T*V^T
// One workgroup with 256 threads.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer Matrix { float A[]; };
layout(set = 0, binding = 1) buffer TauBuf { float tau[]; };  // Householder scalars

layout(push_constant) uniform PushConstants {
    uint m;          // number of rows
    uint n;          // number of columns
    uint col_start;  // starting column of this panel
    uint panel_cols; // number of columns in panel
    uint batch_idx;
};

// Sized to the maximum supported workgroup size (optimalWorkgroupSize caps at
// 1024). The actual workgroup size is the runtime spec constant gl_WorkGroupSize.x.
shared float col_data[1024];  // per-lane partial sums for reductions
shared float norm_sq;
shared float alpha;
shared float tau_k;
shared float vhead;          // x[k] - alpha, the Householder vector head

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = batch_idx * m * n;
    uint panel_rows = m - col_start;

    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;

        // Compute the column 2-norm in parallel: each lane sums a strided
        // subset of rows [k, panel_rows) into col_data[tid], then a shared
        // tree reduction combines them. This replaces the previous serial
        // tid==0 loop and is safe for any panel_rows.
        float local_nsq = 0.0;
        for (uint r = k + tid; r < panel_rows; r += gl_WorkGroupSize.x) {
            float v = A[base + (col_start + r) * n + col];
            local_nsq += v * v;
        }
        col_data[tid] = local_nsq;
        barrier();
        {
            uint s0 = 1u;
            while (s0 < gl_WorkGroupSize.x) s0 <<= 1;
            for (s0 >>= 1; s0 > 0u; s0 >>= 1) {
                if (tid < s0 && (tid + s0) < gl_WorkGroupSize.x) {
                    col_data[tid] += col_data[tid + s0];
                }
                barrier();
            }
        }

        if (tid == 0) {
            norm_sq = col_data[0];

            alpha = -sign(A[base + (col_start + k) * n + col]) * sqrt(norm_sq);
            float v_k = A[base + (col_start + k) * n + col] - alpha;
            vhead = v_k;

            if (abs(v_k) < 1e-30) {
                tau_k = 0.0;
            } else {
                // tau = 2 / (1 + sum(v[k+1:]^2) / v_k^2), with v[k] = 1 implicit.
                float sub_norm = norm_sq - A[base + (col_start + k) * n + col] * A[base + (col_start + k) * n + col];
                tau_k = (sub_norm + v_k * v_k) / (v_k * v_k);
                tau_k = 2.0 / tau_k;
            }

            // Set R diagonal and store Householder vector head
            A[base + (col_start + k) * n + col] = alpha;
            tau[batch_idx * n + col] = tau_k;
        }
        barrier();

        if (abs(tau_k) < 1e-30) continue;

        // Normalize the below-diagonal Householder entries in place:
        //   v[r] = x[r] / (x[k] - alpha)   for r > k,  with v[k] = 1 implicit.
        // tau was derived for this v[k]=1 convention, and Ormqr reads the
        // stored sub-diagonal as v[k+1:]; without this division the reflectors
        // were inconsistent with tau (Q@R did not reconstruct A).
        for (uint r = k + 1 + tid; r < panel_rows; r += gl_WorkGroupSize.x) {
            A[base + (col_start + r) * n + col] /= vhead;
        }
        barrier();

        // Apply reflection to remaining columns: A[:,j] -= tau * v * (v^T * A[:,j])
        for (uint j = col + 1; j < min(col_start + panel_cols, n); j++) {
            // Compute dot = v^T * A[:,j] in parallel: each thread accumulates a
            // strided partial sum over the sub-diagonal rows (v[k]=1 implicit,
            // so thread 0 adds the head term A[k,j]), then a shared-memory tree
            // reduction combines them.
            float local_dot = 0.0;
            for (uint r = k + 1 + tid; r < panel_rows; r += gl_WorkGroupSize.x) {
                float v_r = A[base + (col_start + r) * n + col];
                local_dot += v_r * A[base + (col_start + r) * n + j];
            }
            if (tid == 0) {
                // v[k]=1 contribution (A[k,col] already overwritten with alpha)
                local_dot += A[base + (col_start + k) * n + j];
            }
            col_data[tid] = local_dot;
            barrier();

            // Tree reduction over the workgroup. Start at the largest power of
            // two >= workgroup size so all active lanes are folded in; entries
            // at/above gl_WorkGroupSize.x are treated as 0.
            {
                uint s = 1u;
                while (s < gl_WorkGroupSize.x) s <<= 1;
                for (s >>= 1; s > 0u; s >>= 1) {
                    if (tid < s && (tid + s) < gl_WorkGroupSize.x) {
                        col_data[tid] += col_data[tid + s];
                    }
                    barrier();
                }
            }

            float dot = col_data[0];
            barrier();

            // Update: A[r,j] -= tau * v[r] * dot
            for (uint r = k + 1 + tid; r < panel_rows; r += gl_WorkGroupSize.x) {
                float v_r = A[base + (col_start + r) * n + col];
                A[base + (col_start + r) * n + j] -= tau_k * v_r * dot;
            }
            if (tid == 0) {
                A[base + (col_start + k) * n + j] -= tau_k * dot;
            }
            barrier();
        }
    }
}
