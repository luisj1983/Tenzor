#version 450

// Layer Normalization
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };
layout(binding = 2) buffer Gamma { float gamma_data[]; };    // Optional affine parameter
layout(binding = 3) buffer Beta { float beta_data[]; };      // Optional affine parameter
// Phase P0 / Fix 4: persist saved stats so backward (and FusedLayerNorm
// wrappers) can read mean/rstd without recomputing on the host.
// One scalar per batch element.
layout(binding = 4) buffer MeanOut { float mean_out[]; };
layout(binding = 5) buffer RstdOut { float rstd_out[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint normalized_shape;  // Size of dimensions to normalize over
    float epsilon;
    uint affine;           // 0=no affine, 1=with affine
} params;

shared float shared_sum[WORKGROUP_SIZE];
shared float shared_sum_sq[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.normalized_shape;

    // Step 1: Compute mean
    float local_sum = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += WORKGROUP_SIZE) {
        local_sum += input_data[base_idx + i];
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    float mean = shared_sum[0] / float(params.normalized_shape);
    barrier();

    // Step 2: Compute variance
    float local_sum_sq = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += WORKGROUP_SIZE) {
        float diff = input_data[base_idx + i] - mean;
        local_sum_sq += diff * diff;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    // Parallel reduction for sum of squares
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    float variance = shared_sum_sq[0] / float(params.normalized_shape);
    float inv_std = 1.0 / sqrt(variance + params.epsilon);
    barrier();

    // Persist mean and rstd from thread 0 only — one scalar per batch
    // element. Backward / FusedLayerNorm consumers read these directly.
    if (tid == 0) {
        mean_out[batch_idx] = mean;
        rstd_out[batch_idx] = inv_std;
    }
    barrier();

    // Step 3: Normalize and apply affine transformation
    for (uint i = tid; i < params.normalized_shape; i += WORKGROUP_SIZE) {
        float normalized = (input_data[base_idx + i] - mean) * inv_std;

        if (params.affine > 0) {
            normalized = normalized * gamma_data[i] + beta_data[i];
        }

        output_data[base_idx + i] = normalized;
    }
}
