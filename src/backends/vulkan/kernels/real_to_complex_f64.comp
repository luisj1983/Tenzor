#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable

// Convert real-valued Float64 buffer to interleaved complex (imag = 0)

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float64_t data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;
    data_out[idx * 2]     = data_in[idx];       // real part
    data_out[idx * 2 + 1] = float64_t(0.0);     // imag part = 0
}
