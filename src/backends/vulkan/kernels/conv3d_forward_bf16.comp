#version 450

// 3D Convolution Forward Pass - BFloat16 version (with groups support)
// BF16 stored packed two-per-uint32 word; all computation in float32 for
// precision, results written back as BF16 (round-to-nearest-even) via a
// bounded compare-and-swap on the shared 32-bit word.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // Packed BF16
layout(binding = 1) buffer Weight { uint weight_data[]; };  // Packed BF16
layout(binding = 2) buffer Bias { uint bias_data[]; };      // Packed BF16
layout(binding = 3) buffer Output { uint output_data[]; };  // Packed BF16

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint in_channels;
    uint out_channels;
    uint in_depth;
    uint in_height;
    uint in_width;
    uint kernel_d;
    uint kernel_h;
    uint kernel_w;
    uint stride_d;
    uint stride_h;
    uint stride_w;
    uint padding_d;
    uint padding_h;
    uint padding_w;
    uint dilation_d;
    uint dilation_h;
    uint dilation_w;
    uint groups;
    uint out_d;
    uint out_h;
    uint out_w;
    uint has_bias;
} params;

// Read a BF16 element from one of the three input buffers (0=input, 1=weight, 2=bias).
float readBF16_buf(uint element_idx, uint buf_id) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed;
    if (buf_id == 0) packed = input_data[word_idx];
    else if (buf_id == 1) packed = weight_data[word_idx];
    else packed = bias_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Write a single BF16 element to the packed output via bounded CAS (two adjacent
// output elements share a 32-bit word and may be written by distinct invocations).
void writeBF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint shift = word_offset * 16;
    uint mask = 0xFFFFu << shift;
    uint bf16_bits = ((floatBitsToUint(val) + 0x7FFFu +
                      ((floatBitsToUint(val) >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint new_half = bf16_bits << shift;

    uint prev = output_data[word_idx];
    uint desired = (prev & ~mask) | new_half;
    for (uint attempt = 0u; attempt < 65536u; ++attempt) {
        desired = (prev & ~mask) | new_half;
        uint observed = atomicCompSwap(output_data[word_idx], prev, desired);
        if (observed == prev) return;
        prev = observed;
    }
    output_data[word_idx] = desired;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) {
        return;
    }

    uint ow = idx % params.out_w;
    uint temp = idx / params.out_w;
    uint oh = temp % params.out_h;
    temp /= params.out_h;
    uint od = temp % params.out_d;
    temp /= params.out_d;
    uint oc = temp % params.out_channels;
    uint n = temp / params.out_channels;

    // Use float32 for accumulation to maintain precision
    float sum = 0.0;

    uint channels_per_group = params.in_channels / params.groups;
    uint out_channels_per_group = params.out_channels / params.groups;
    uint group_id = oc / out_channels_per_group;
    uint ic_start = group_id * channels_per_group;
    uint ic_end = ic_start + channels_per_group;

    for (uint ic = ic_start; ic < ic_end; ic++) {
        for (uint kd = 0; kd < params.kernel_d; kd++) {
            for (uint kh = 0; kh < params.kernel_h; kh++) {
                for (uint kw = 0; kw < params.kernel_w; kw++) {
                    int id = int(od * params.stride_d) - int(params.padding_d) + int(kd * params.dilation_d);
                    int ih = int(oh * params.stride_h) - int(params.padding_h) + int(kh * params.dilation_h);
                    int iw = int(ow * params.stride_w) - int(params.padding_w) + int(kw * params.dilation_w);

                    if (id >= 0 && id < int(params.in_depth) &&
                        ih >= 0 && ih < int(params.in_height) &&
                        iw >= 0 && iw < int(params.in_width)) {
                        uint input_idx = ((n * params.in_channels + ic) * params.in_depth + uint(id)) *
                                         params.in_height * params.in_width +
                                         uint(ih) * params.in_width + uint(iw);

                        uint ic_local = ic - ic_start;
                        uint weight_idx = ((oc * channels_per_group + ic_local) * params.kernel_d + kd) *
                                          params.kernel_h * params.kernel_w +
                                          kh * params.kernel_w + kw;

                        sum += readBF16_buf(input_idx, 0) * readBF16_buf(weight_idx, 1);
                    }
                }
            }
        }
    }

    if (params.has_bias == 1) {
        sum += readBF16_buf(oc, 2);
    }

    writeBF16(idx, sum);
}
