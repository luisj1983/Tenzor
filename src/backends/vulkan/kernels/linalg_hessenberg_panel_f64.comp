#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Panel Hessenberg reduction (Float64 variant)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer MatrixA { float64_t A[]; };
layout(set = 0, binding = 1) buffer TauBuf  { float64_t tau[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

shared float64_t norm_sq;
shared float64_t alpha_val;
shared float64_t tau_k;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = batch_idx * n * n;
    uint tau_base = batch_idx * n;

    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;
        if (col + 2 > n) break;

        if (tid == 0) {
            norm_sq = 0.0lf;
            for (uint r = col + 1; r < n; r++) {
                float64_t v = A[base + r * n + col];
                norm_sq += v * v;
            }

            float64_t norm_val = sqrt(norm_sq);
            if (norm_val < 1e-60lf) {
                tau_k = 0.0lf;
                alpha_val = A[base + (col + 1) * n + col];
            } else {
                alpha_val = -sign(A[base + (col + 1) * n + col]) * norm_val;
                float64_t v0 = A[base + (col + 1) * n + col] - alpha_val;

                float64_t v_norm_sq = v0 * v0;
                for (uint r = col + 2; r < n; r++) {
                    v_norm_sq += A[base + r * n + col] * A[base + r * n + col];
                }

                if (abs(v0) < 1e-60lf) {
                    tau_k = 0.0lf;
                } else {
                    tau_k = 2.0lf / v_norm_sq;
                    for (uint r = col + 2; r < n; r++) {
                        A[base + r * n + col] /= v0;
                    }
                }

                A[base + (col + 1) * n + col] = alpha_val;
            }

            tau[tau_base + col] = tau_k;
        }
        barrier();

        if (abs(tau_k) < 1e-60lf) continue;

        // Apply from left: A = H * A
        for (uint j = col + tid; j < n; j += 256) {
            float64_t dot = A[base + (col + 1) * n + j];
            for (uint r = col + 2; r < n; r++) {
                dot += A[base + r * n + col] * A[base + r * n + j];
            }
            dot *= tau_k;

            A[base + (col + 1) * n + j] -= dot;
            for (uint r = col + 2; r < n; r++) {
                A[base + r * n + j] -= A[base + r * n + col] * dot;
            }
        }
        barrier();

        // Apply from right: A = A * H^T
        for (uint i = tid; i < n; i += 256) {
            float64_t dot = A[base + i * n + (col + 1)];
            for (uint c = col + 2; c < n; c++) {
                dot += A[base + i * n + c] * A[base + c * n + col];
            }
            dot *= tau_k;

            A[base + i * n + (col + 1)] -= dot;
            for (uint c = col + 2; c < n; c++) {
                A[base + i * n + c] -= dot * A[base + c * n + col];
            }
        }
        barrier();
    }
}
