#version 450

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer Keys { int keys[]; };
layout(set = 0, binding = 1) buffer Histograms     { uint histos[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint digit;
    uint n_wgs;
};

shared uint local_histo[256];

uint int32_to_sortable(int val) {
    return uint(val) ^ 0x80000000u;  // flip sign bit
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    local_histo[lid] = 0;
    barrier();

    uint tile_size = (n + n_wgs - 1) / n_wgs;
    uint tile_start = wg_id * tile_size;
    uint tile_end = min(tile_start + tile_size, n);

    for (uint i = tile_start + lid; i < tile_end; i += 256) {
        uint sortable = int32_to_sortable(keys[i]);
        uint digit_val = (sortable >> (digit * 8)) & 0xFFu;
        atomicAdd(local_histo[digit_val], 1);
    }
    barrier();

    histos[lid * n_wgs + wg_id] = local_histo[lid];
}
