#version 450

// Scatter for 16-bit dtypes (Int16 / UInt16): raw 16-bit element scatter.
// Elements are packed 2 per 32-bit word; the target 16-bit field is updated
// with a CAS loop so concurrent writes to the two halves of a word don't race.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // packed 2x u16
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { uint output_data[]; };  // packed 2x u16
layout(binding = 3) buffer Values { uint values[]; };       // packed 2x u16

layout(push_constant) uniform PushConstants {
    uint input_size;        // indices.numel() (== values.numel())
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uint output_size;       // total output/self size (OOB guard)
    uint reduction;         // 0=none, 1=add, 2=multiply
    uint use_values;        // 0=use input_data, 1=use values buffer
    uint _pad;
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

uint getU16(uint e, bool from_values) {
    uint w = from_values ? values[e >> 1] : input_data[e >> 1];
    return ((e & 1u) == 0u) ? (w & 0xFFFFu) : (w >> 16);
}

void updateU16(uint e, uint new16, uint reduction) {
    uint widx = e >> 1;
    uint shift = (e & 1u) * 16u;
    uint mask = 0xFFFFu << shift;
    uint old = output_data[widx];
    uint expected;
    do {
        expected = old;
        uint cur = (expected >> shift) & 0xFFFFu;
        uint res;
        if (reduction == 1u)      res = (cur + new16) & 0xFFFFu;
        else if (reduction == 2u) res = (cur * new16) & 0xFFFFu;
        else                      res = new16 & 0xFFFFu;
        uint nw = (expected & ~mask) | (res << shift);
        old = atomicCompSwap(output_data[widx], expected, nw);
    } while (old != expected);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.input_size) return;

    int scatter_idx = indices[idx];
    if (scatter_idx < 0) scatter_idx += int(params.dim_size);
    if (scatter_idx < 0 || scatter_idx >= int(params.dim_size)) return;

    uint temp = idx;
    uint out_idx = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_idx += uint(scatter_idx) * selfStride(d);
        } else {
            out_idx += coord * selfStride(d);
        }
    }

    // Guard the computed output offset against the destination size. The non-scatter
    // dims of the values/index tensor can exceed the output's, yielding out_idx >=
    // output_size; without this guard that is an out-of-bounds device write.
    if (out_idx >= params.output_size) return;

    uint v = getU16(idx, params.use_values > 0u);
    updateU16(out_idx, v, params.reduction);
}
