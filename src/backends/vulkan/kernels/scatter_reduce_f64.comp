#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// ScatterReduce (Float64): scatter double source values into output along a
// dimension with reduction, accumulating in full Float64 (53 mantissa bits)
// rather than rounding through Float32. Uses 64-bit CAS-loop atomics.
// Modes: 0=sum, 1=prod, 2=mean(sum pass), 3=amax, 4=amin
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint64_t out_data[]; };   // uint64_t for CAS atomics
layout(binding = 1) buffer Source { float64_t src_data[]; };  // Source values
layout(binding = 2) buffer Index  { int idx_data[]; };        // 1-D index tensor (int32)
layout(binding = 3) buffer Counts { int count_data[]; };      // Count buffer (for mean mode)

layout(push_constant) uniform PushConstants {
    uint n;                 // index.numel()
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uint mode;              // 0=sum, 1=prod, 2=mean, 3=amax, 4=amin
    uint pad0;
    uint pad1;
    uint pad2;
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

float64_t bitsToF64(uint64_t bits) {
    return float64_t(packDouble2x32(uvec2(uint(bits), uint(bits >> 32u))));
}

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

void atomicAddF64(uint pos, float64_t val) {
    uint64_t old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint64_t new_bits = f64ToBits(bitsToF64(old_bits) + val);
        uint64_t result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void atomicMulF64(uint pos, float64_t val) {
    uint64_t old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint64_t new_bits = f64ToBits(bitsToF64(old_bits) * val);
        uint64_t result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void atomicMaxF64(uint pos, float64_t val) {
    uint64_t old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        if (val <= bitsToF64(old_bits)) return;
        uint64_t new_bits = f64ToBits(val);
        uint64_t result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void atomicMinF64(uint pos, float64_t val) {
    uint64_t old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        if (val >= bitsToF64(old_bits)) return;
        uint64_t new_bits = f64ToBits(val);
        uint64_t result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= params.n) return;

    int dest_idx = idx_data[tid];
    if (dest_idx < 0) dest_idx += int(params.dim_size);
    if (dest_idx < 0 || dest_idx >= int(params.dim_size)) return;

    // Per-dim decode of the flat index position, recomposed onto self strides.
    uint temp = tid;
    uint out_pos = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_pos += uint(dest_idx) * selfStride(d);
        } else {
            out_pos += coord * selfStride(d);
        }
    }

    float64_t val = src_data[tid];

    if (params.mode == 0u || params.mode == 2u) {
        atomicAddF64(out_pos, val);
        if (params.mode == 2u) {
            atomicAdd(count_data[out_pos], 1);
        }
    } else if (params.mode == 1u) {
        atomicMulF64(out_pos, val);
    } else if (params.mode == 3u) {
        atomicMaxF64(out_pos, val);
    } else if (params.mode == 4u) {
        atomicMinF64(out_pos, val);
    }
}
