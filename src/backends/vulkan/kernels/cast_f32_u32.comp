#version 450

// Cast Float32 -> UInt32 (saturating to [0, 4294967295], then truncate).
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    float data[];
} input_buf;

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
    uint data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    float v = clamp(input_buf.data[idx], 0.0, 4294967295.0);
    output_buf.data[idx] = uint(v);
}
