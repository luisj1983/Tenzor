#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Log softmax backward: grad_input = grad_output - exp(output) * sum(grad_output)
// This requires reduction along a dimension

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };
layout(binding = 1) buffer OutputBuffer { float output_data[]; };  // log_softmax output
layout(binding = 2) buffer GradInput { float grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint outer_size;   // Product of dimensions before reduction dim
    uint dim_size;     // Size of the reduction dimension
    uint inner_size;   // Product of dimensions after reduction dim
} params;

void main() {
    // Each thread handles one (outer, inner) position
    uint global_idx = gl_GlobalInvocationID.x;
    uint total_threads = params.outer_size * params.inner_size;

    if (global_idx >= total_threads) {
        return;
    }

    uint outer_idx = global_idx / params.inner_size;
    uint inner_idx = global_idx % params.inner_size;
    uint offset = (outer_idx * params.dim_size * params.inner_size) + inner_idx;

    // Compute sum of gradients along dimension.
    // Accumulate in double to match the forward log_softmax, which deliberately
    // uses double accumulation to meet Float32 parity vs CPU.
    double sum_grad = 0.0lf;
    for (uint d = 0; d < params.dim_size; ++d) {
        uint idx = offset + d * params.inner_size;
        sum_grad += double(grad_output[idx]);
    }

    // Compute gradient: grad_output - exp(log_softmax) * sum_grad.
    // exp() is evaluated in float (GLSL has no double exp here), but the
    // subtraction and the sum_grad factor stay in double so the dominant
    // reduction error — the sum over the reduction dim — is double-accurate.
    for (uint d = 0; d < params.dim_size; ++d) {
        uint idx = offset + d * params.inner_size;
        double softmax = double(exp(output_data[idx]));
        double g = double(grad_output[idx]) - softmax * sum_grad;
        grad_input[idx] = float(g);
    }
}
