#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Batch Normalization 2D Backward Pass - Float64 variant (three-pass, no atomics)
// Pass 1 (this shader): each workgroup writes per-workgroup partial sums for
//   grad_gamma and grad_beta into intermediate buffers. It does NOT compute
//   grad_input — the training-mode input gradient depends on the per-channel
//   sums of grad_out and grad_out*x_hat over the ENTIRE (N, H, W), which span
//   every workgroup of a channel and are therefore unknown until after the
//   reduction (pass 2). The previous single-pass form wrote
//   grad_out * gamma * invstd, which is the *inference-mode* backward and
//   drops the two mean-correction terms required during training.
// Pass 2 uses reduce_partial_sums_f64.comp to sum partials across workgroups
//   into final per-channel grad_gamma[c] / grad_beta[c].
// Pass 3 (batchnorm2d_backward_grad_input_f64.comp) consumes those final
//   per-channel sums and computes the correct training-mode grad_input:
//     grad_in = gamma * invstd *
//               (grad_out - grad_beta[c]/N - x_hat * grad_gamma[c]/N)
//   with N = batch * spatial_size.
//
// Dispatch: one workgroup per (batch, channel) pair.
//   gl_WorkGroupID.x = batch_idx * channels + channel_idx
// Each workgroup iterates over the spatial dimension (H * W).

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer GradOutput { double grad_output[]; };  // (N, C, H, W)
layout(binding = 1) buffer Input { double input_data[]; };         // (N, C, H, W)
layout(binding = 2) buffer Mean { double mean_data[]; };           // (C)
layout(binding = 3) buffer InvStd { double invstd_data[]; };        // (C) - pre-computed 1/sqrt(var+eps)
layout(binding = 4) buffer Gamma { double gamma_data[]; };         // (C)
layout(binding = 5) buffer GradInput { double grad_input[]; };     // (N, C, H, W)
layout(binding = 6) buffer PartialGradGamma { double partial_grad_gamma[]; };  // (N * C) partials for C channels
layout(binding = 7) buffer PartialGradBeta { double partial_grad_beta[]; };    // (N * C) partials for C channels

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Total elements (N * C * H * W)
    uint batch;          // N
    uint channels;       // C
    uint spatial_size;   // H * W
    float eps;           // Epsilon for numerical stability
    uint has_gamma;      // 1 if gamma is provided, 0 otherwise
} params;

shared double shared_grad_gamma[WORKGROUP_SIZE];
shared double shared_grad_beta[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;  // batch_idx * channels + channel_idx

    uint c = wg_id % params.channels;
    uint b = wg_id / params.channels;

    if (b >= params.batch) {
        return;
    }

    // Base offset into the (b, c) slice of the (N, C, H, W) tensor
    uint base_idx = (b * params.channels + c) * params.spatial_size;

    double mean = mean_data[c];
    double inv_std = invstd_data[c];
    // gamma / has_gamma are unused in pass 1 (grad_gamma/grad_beta do not
    // depend on gamma). The Gamma binding is still declared above so the
    // descriptor layout matches the host (which binds all 8 buffers). gamma is
    // applied in the grad_input pass.

    // Each thread accumulates over a strided portion of the spatial dimension
    double local_gg = 0.0lf;
    double local_gb = 0.0lf;

    for (uint s = tid; s < params.spatial_size; s += WORKGROUP_SIZE) {
        uint idx = base_idx + s;
        double x = input_data[idx];
        double grad_out = grad_output[idx];
        double x_normalized = (x - mean) * inv_std;

        // grad_input is intentionally NOT written here: it requires the full
        // per-channel sums (computed in pass 2) and is produced by the
        // dedicated grad_input pass (pass 3). Writing it here would only give
        // the inference-mode gradient, which is wrong during training.

        // Accumulate partial sums for grad_gamma and grad_beta
        local_gg += grad_out * x_normalized;
        local_gb += grad_out;
    }

    // Shared memory reduction within workgroup
    shared_grad_gamma[tid] = local_gg;
    shared_grad_beta[tid] = local_gb;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_grad_gamma[tid] += shared_grad_gamma[tid + s];
            shared_grad_beta[tid] += shared_grad_beta[tid + s];
        }
        barrier();
    }

    // Thread 0 writes the workgroup's partial sum
    // Index: one partial per workgroup, and there are (batch * channels) workgroups.
    // The reduction shader will sum over the batch dimension for each channel.
    // Layout: partial_grad_gamma[b * channels + c] for workgroup (b, c)
    if (tid == 0) {
        partial_grad_gamma[wg_id] = shared_grad_gamma[0];
        partial_grad_beta[wg_id] = shared_grad_beta[0];
    }
}
