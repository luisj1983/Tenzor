#version 450

// Bitonic sort (BFloat16 variant)
// One compare-and-swap pass per dispatch
// Operates on (value, index) pairs: sorts by value, produces sorted indices
// Values stored as packed uint32 (2 x bfloat16 per word)
// Multiple dispatches required: log2(N) * (log2(N)+1) / 2 passes total
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Values { uint values[]; };       // Packed bfloat16 pairs
layout(binding = 1) buffer Indices { int indices[]; };       // Corresponding indices (output)

layout(push_constant) uniform PushConstants {
    uint n;               // Original (unpadded) number of elements
    uint padded_n;        // Padded to power-of-2
    uint stage;           // Current stage (0, 1, 2, ...)
    uint substage;        // Current substage within stage
    uint descending;      // 0 = ascending, 1 = descending
} params;

// Read a bfloat16 element from packed buffer, returning as float for comparison
float readBF16(uint elem_idx) {
    uint word_idx = elem_idx / 2;
    uint half_idx = elem_idx % 2;
    uint packed = values[word_idx];
    uint bits = (half_idx == 0) ? (packed & 0xFFFFu) : (packed >> 16);
    return uintBitsToFloat(bits << 16);
}

// Write a float value back as bfloat16 into the packed buffer.
// Two packed elements share one uint word; concurrent threads may update the
// two halves of the same word in the same pass, so use an atomic CAS retry
// loop instead of a plain read-modify-write store. The RNE bias can produce a
// 17-bit value (e.g. negative-NaN inputs) so mask to 16 bits before merging.
void writeBF16(uint elem_idx, float val) {
    uint word_idx = elem_idx / 2;
    uint half_offset = (elem_idx % 2) * 16;
    uint new_bits = ((floatBitsToUint(val) + 0x7FFFu + ((floatBitsToUint(val) >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = values[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(values[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint gid = gl_GlobalInvocationID.x;

    // Each thread handles one compare-and-swap
    if (gid >= params.padded_n / 2) return;

    // Compute the pair of elements to compare
    uint block_size = 1u << (params.stage + 1);
    uint half_block = 1u << params.substage;

    // Determine position within the block structure
    uint block_id = gid / half_block;
    uint offset = gid % half_block;

    uint i = block_id * (half_block * 2) + offset;
    uint j = i + half_block;

    if (j >= params.padded_n) return;

    // Determine sort direction for this block
    uint sort_block = i / block_size;
    bool ascending_block = ((sort_block % 2) == 0);
    if (params.descending != 0) ascending_block = !ascending_block;

    // Read bfloat16 values as float32 for comparison
    float val_i = readBF16(i);
    float val_j = readBF16(j);

    bool should_swap;
    if (ascending_block) {
        should_swap = (val_i > val_j);
    } else {
        should_swap = (val_i < val_j);
    }

    if (should_swap) {
        writeBF16(i, val_j);
        writeBF16(j, val_i);
        int tmp = indices[i];
        indices[i] = indices[j];
        indices[j] = tmp;
    }
}
