#version 450

// Blocked QR — apply Householder reflections from panel to trailing columns
// After panel factorization of columns [col_start, col_start+panel_cols),
// apply the accumulated reflections to columns [col_start+panel_cols, n).
// Each workgroup handles one trailing column.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Matrix { float A[]; };
layout(set = 0, binding = 1) readonly buffer TauBuf { float tau[]; };

layout(push_constant) uniform PushConstants {
    uint m;
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

shared float dot_val;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = batch_idx * m * n;
    uint panel_rows = m - col_start;

    // This workgroup handles trailing column j
    uint j = col_start + panel_cols + gl_WorkGroupID.x;
    if (j >= n) return;

    // Apply each Householder reflection k = 0..panel_cols-1
    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;
        float tau_k = tau[batch_idx * n + col];
        if (abs(tau_k) < 1e-30) continue;

        // Compute dot = v^T * A[:,j] where v[k]=1, v[k+1:] stored in A[k+1:,col]
        if (tid == 0) {
            float dot = A[base + (col_start + k) * n + j];  // v[k] = 1
            for (uint r = k + 1; r < panel_rows; r++) {
                dot += A[base + (col_start + r) * n + col] * A[base + (col_start + r) * n + j];
            }
            dot_val = dot;
        }
        barrier();

        float dot = dot_val;

        // Update: A[r,j] -= tau * v[r] * dot
        for (uint r = k + 1 + tid; r < panel_rows; r += 256) {
            A[base + (col_start + r) * n + j] -= tau_k * A[base + (col_start + r) * n + col] * dot;
        }
        if (tid == 0) {
            A[base + (col_start + k) * n + j] -= tau_k * dot;
        }
        barrier();
    }
}
