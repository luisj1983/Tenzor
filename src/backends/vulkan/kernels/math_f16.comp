#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Math operations for Float16: add, sub, mul, div, sqrt, exp, log, neg, abs, pow, sign,
//   floor, ceil, round, trunc, reciprocal, log2, log10, log1p, exp2, expm1, erf, erfc,
//   atan2, fmod, remainder, minimum, maximum
// Float16 elements are packed 2 per 32-bit word
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { uint a[]; };
layout(binding = 1) buffer InputB { uint b[]; };
layout(binding = 2) buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation code
    float param;     // Parameter for operations like pow
} params;

// Helper to read float16 from packed buffer
float16_t readF16(uint packed, uint offset) {
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

// Helper to pack two float16 values
uint packF16Pair(float16_t v0, float16_t v1) {
    uint bits0 = packHalf2x16(vec2(float(v0), 0.0)).x & 0xFFFFu;
    uint bits1 = packHalf2x16(vec2(float(v1), 0.0)).x & 0xFFFFu;
    return bits0 | (bits1 << 16);
}

// pow(base, exponent) with explicit domain handling, computed in float32
// (matches the existing F16 fast-path convention of upcasting for pow).
// GLSL pow(x,y) is exp2(y*log2(x)): NaN for x<0, and spec-undefined for the
// negative-base/integer-exponent case (which is well-defined mathematically,
// e.g. pow(-2,4)==16) and for negative-base/non-integer-exponent (where
// std::pow deterministically returns NaN). Mirrors math.comp's case 9.
float powSafeF32(float base, float exponent) {
    if (exponent == 1.0) return base;
    if (exponent == 0.0) return 1.0;
    if (exponent == 2.0) return base * base;
    if (exponent == 3.0) return base * base * base;
    if (exponent == -1.0) return 1.0 / base;
    if (base < 0.0) {
        if (exponent == trunc(exponent)) {
            float mag = pow(abs(base), exponent);
            bool odd = mod(abs(exponent), 2.0) != 0.0;
            return odd ? -mag : mag;
        }
        // Negative base, non-integer exponent: real-valued result is
        // undefined (complex) — match std::pow's deterministic NaN instead
        // of falling through to GLSL's spec-undefined pow().
        return uintBitsToFloat(0x7fc00000u);
    }
    return pow(base, exponent);
}

// Round-half-away-from-zero to match std::round / CUDA/ROCm/OneAPI round
// semantics. GLSL's round() has implementation-defined 0.5 tie-breaking;
// every other backend rounds ties away from zero. Mirrors math.comp's
// round_half_away_f32.
float roundHalfAwayF32(float x) {
    return sign(x) * floor(abs(x) + 0.5);
}

void main() {
    // Process 2 elements per thread
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    if (idx0 >= params.n) {
        return;
    }

    uint a_packed = a[pair_idx];
    uint b_packed = b[pair_idx];

    float16_t val_a0 = readF16(a_packed, 0);
    float16_t val_b0 = readF16(b_packed, 0);
    float16_t val_a1 = readF16(a_packed, 1);
    float16_t val_b1 = readF16(b_packed, 1);

    float16_t res0, res1;

    // Binary ops: compute in float32 to avoid overflow in float16 range (±65504).
    // This matches the CPU backend which upcasts F16→F32 before computing.
    float fa0 = float(val_a0), fb0 = float(val_b0);
    float fa1 = float(val_a1), fb1 = float(val_b1);

    switch (params.op) {
        case 0: // add
            res0 = float16_t(fa0 + fb0);
            res1 = float16_t(fa1 + fb1);
            break;
        case 1: // sub
            res0 = float16_t(fa0 - fb0);
            res1 = float16_t(fa1 - fb1);
            break;
        case 2: // mul
            res0 = float16_t(fa0 * fb0);
            res1 = float16_t(fa1 * fb1);
            break;
        case 3: // div
            res0 = float16_t(fa0 / fb0);
            res1 = float16_t(fa1 / fb1);
            break;
        case 4: // sqrt (unary)
            res0 = float16_t(sqrt(float(val_a0)));
            res1 = float16_t(sqrt(float(val_a1)));
            break;
        case 5: // exp (unary)
            res0 = float16_t(exp(float(val_a0)));
            res1 = float16_t(exp(float(val_a1)));
            break;
        case 6: // log (unary)
            res0 = float16_t(log(float(val_a0)));
            res1 = float16_t(log(float(val_a1)));
            break;
        case 7: // neg (unary)
            res0 = -val_a0;
            res1 = -val_a1;
            break;
        case 8: // abs (unary)
            res0 = abs(val_a0);
            res1 = abs(val_a1);
            break;
        case 9: // pow (unary with parameter) — domain-guarded to match
                // std::pow for negative bases; see powSafeF32 above.
            res0 = float16_t(powSafeF32(float(val_a0), params.param));
            res1 = float16_t(powSafeF32(float(val_a1), params.param));
            break;
        case 10: // sign (unary)
            res0 = float16_t(sign(float(val_a0)));
            res1 = float16_t(sign(float(val_a1)));
            break;
        case 11: // floor
            res0 = float16_t(floor(float(val_a0)));
            res1 = float16_t(floor(float(val_a1)));
            break;
        case 12: // ceil
            res0 = float16_t(ceil(float(val_a0)));
            res1 = float16_t(ceil(float(val_a1)));
            break;
        case 13: // round — round-half-away-from-zero (matches
                 // std::round / CUDA/ROCm/OneAPI), not GLSL round()'s
                 // implementation-defined tie-break.
            res0 = float16_t(roundHalfAwayF32(float(val_a0)));
            res1 = float16_t(roundHalfAwayF32(float(val_a1)));
            break;
        case 14: // trunc
            res0 = float16_t(trunc(float(val_a0)));
            res1 = float16_t(trunc(float(val_a1)));
            break;
        case 15: // reciprocal
            res0 = float16_t(1.0 / float(val_a0));
            res1 = float16_t(1.0 / float(val_a1));
            break;
        case 16: // log2
            res0 = float16_t(log2(fa0));
            res1 = float16_t(log2(fa1));
            break;
        case 17: // log10
            res0 = float16_t(log2(fa0) / log2(10.0));
            res1 = float16_t(log2(fa1) / log2(10.0));
            break;
        case 18: // log1p
            res0 = float16_t(log(1.0 + fa0));
            res1 = float16_t(log(1.0 + fa1));
            break;
        case 19: // exp2
            res0 = float16_t(exp2(fa0));
            res1 = float16_t(exp2(fa1));
            break;
        case 20: // expm1
            res0 = float16_t(exp(fa0) - 1.0);
            res1 = float16_t(exp(fa1) - 1.0);
            break;
        case 21: { // erf - Abramowitz & Stegun approximation
            float ax0 = abs(fa0);
            float t0 = 1.0 / (1.0 + 0.3275911 * ax0);
            float y0 = 1.0 - (((((1.061405429 * t0 - 1.453152027) * t0) + 1.421413741) * t0 - 0.284496736) * t0 + 0.254829592) * t0 * exp(-ax0 * ax0);
            res0 = float16_t(fa0 < 0.0 ? -y0 : y0);
            float ax1 = abs(fa1);
            float t1 = 1.0 / (1.0 + 0.3275911 * ax1);
            float y1 = 1.0 - (((((1.061405429 * t1 - 1.453152027) * t1) + 1.421413741) * t1 - 0.284496736) * t1 + 0.254829592) * t1 * exp(-ax1 * ax1);
            res1 = float16_t(fa1 < 0.0 ? -y1 : y1);
            break;
        }
        case 22: { // erfc
            float ax0 = abs(fa0);
            float t0 = 1.0 / (1.0 + 0.3275911 * ax0);
            float y0 = 1.0 - (((((1.061405429 * t0 - 1.453152027) * t0) + 1.421413741) * t0 - 0.284496736) * t0 + 0.254829592) * t0 * exp(-ax0 * ax0);
            float erf0 = fa0 < 0.0 ? -y0 : y0;
            res0 = float16_t(1.0 - erf0);
            float ax1 = abs(fa1);
            float t1 = 1.0 / (1.0 + 0.3275911 * ax1);
            float y1 = 1.0 - (((((1.061405429 * t1 - 1.453152027) * t1) + 1.421413741) * t1 - 0.284496736) * t1 + 0.254829592) * t1 * exp(-ax1 * ax1);
            float erf1 = fa1 < 0.0 ? -y1 : y1;
            res1 = float16_t(1.0 - erf1);
            break;
        }
        case 23: // atan2 (binary)
            res0 = float16_t(atan(fa0, fb0));
            res1 = float16_t(atan(fa1, fb1));
            break;
        case 24: // fmod (binary)
            res0 = float16_t(fa0 - trunc(fa0 / fb0) * fb0);
            res1 = float16_t(fa1 - trunc(fa1 / fb1) * fb1);
            break;
        case 25: { // remainder (binary) - divisor-sign convention, matches
                   // the f32/f64 shaders and CPU/CUDA/ROCm/OneAPI.
            float r0 = fa0 - trunc(fa0 / fb0) * fb0;
            if (r0 != 0.0 && ((r0 < 0.0) != (fb0 < 0.0))) r0 += fb0;
            res0 = float16_t(r0);
            float r1 = fa1 - trunc(fa1 / fb1) * fb1;
            if (r1 != 0.0 && ((r1 < 0.0) != (fb1 < 0.0))) r1 += fb1;
            res1 = float16_t(r1);
            break;
        }
        case 26: // minimum (binary) — NaN-propagating (torch.minimum): NaN in
                 // either operand → NaN. GLSL min() suppresses NaN; branch in
                 // float space (no fast-math, so `x != x` is reliable).
            res0 = float16_t((fa0 != fa0 || fb0 != fb0) ? uintBitsToFloat(0x7fc00000u) : min(fa0, fb0));
            res1 = float16_t((fa1 != fa1 || fb1 != fb1) ? uintBitsToFloat(0x7fc00000u) : min(fa1, fb1));
            break;
        case 27: // maximum (binary) — NaN-propagating (torch.maximum).
            res0 = float16_t((fa0 != fa0 || fb0 != fb0) ? uintBitsToFloat(0x7fc00000u) : max(fa0, fb0));
            res1 = float16_t((fa1 != fa1 || fb1 != fb1) ? uintBitsToFloat(0x7fc00000u) : max(fa1, fb1));
            break;
        case 28: // rsqrt (unary)
            res0 = float16_t(inversesqrt(fa0));
            res1 = float16_t(inversesqrt(fa1));
            break;
        case 29: // square (unary)
            res0 = float16_t(fa0 * fa0);
            res1 = float16_t(fa1 * fa1);
            break;
        case 30: // asinh (unary)
            res0 = float16_t(asinh(fa0));
            res1 = float16_t(asinh(fa1));
            break;
        case 31: // acosh (unary) — GLSL acosh() is spec-undefined for x<1;
                 // std::acosh deterministically returns NaN there (matches
                 // math.comp's case 31).
            res0 = float16_t((fa0 < 1.0) ? uintBitsToFloat(0x7fc00000u) : acosh(fa0));
            res1 = float16_t((fa1 < 1.0) ? uintBitsToFloat(0x7fc00000u) : acosh(fa1));
            break;
        case 32: // atanh (unary) — GLSL atanh() is spec-undefined for
                 // |x|>=1. std::atanh matches: NaN for |x|>1, +-Inf for the
                 // exact pole |x|==1 (matches math.comp's case 32).
            res0 = float16_t((abs(fa0) > 1.0) ? uintBitsToFloat(0x7fc00000u) :
                              (fa0 == 1.0) ? uintBitsToFloat(0x7f800000u) :
                              (fa0 == -1.0) ? uintBitsToFloat(0xff800000u) : atanh(fa0));
            res1 = float16_t((abs(fa1) > 1.0) ? uintBitsToFloat(0x7fc00000u) :
                              (fa1 == 1.0) ? uintBitsToFloat(0x7f800000u) :
                              (fa1 == -1.0) ? uintBitsToFloat(0xff800000u) : atanh(fa1));
            break;
        case 33: // hypot (binary)
            res0 = float16_t(sqrt(fa0 * fa0 + fb0 * fb0));
            res1 = float16_t(sqrt(fa1 * fa1 + fb1 * fb1));
            break;
        case 34: // copysign (binary)
            res0 = float16_t(fb0 < 0.0 ? -abs(fa0) : abs(fa0));
            res1 = float16_t(fb1 < 0.0 ? -abs(fa1) : abs(fa1));
            break;
        case 44: // deg2rad (unary)
            res0 = float16_t(fa0 * 0.01745329251994329577);
            res1 = float16_t(fa1 * 0.01745329251994329577);
            break;
        case 45: // rad2deg (unary)
            res0 = float16_t(fa0 * 57.29577951308232087680);
            res1 = float16_t(fa1 * 57.29577951308232087680);
            break;
        case 46: { // logit (unary)
            float eps = params.param > 0.0 ? params.param : 1.17549435e-38;
            float c0 = clamp(fa0, eps, 1.0 - eps);
            float c1 = clamp(fa1, eps, 1.0 - eps);
            res0 = float16_t(log(c0 / (1.0 - c0)));
            res1 = float16_t(log(c1 / (1.0 - c1)));
            break;
        }
        case 47: // float_power (binary)
            res0 = float16_t(pow(fa0, fb0));
            res1 = float16_t(pow(fa1, fb1));
            break;
        case 48: { // xlog1py (binary)
            res0 = float16_t(fa0 == 0.0 ? 0.0 : fa0 * log(1.0 + fb0));
            res1 = float16_t(fa1 == 0.0 ? 0.0 : fa1 * log(1.0 + fb1));
            break;
        }
        case 49: // ldexp (binary)
            res0 = float16_t(fa0 * exp2(fb0));
            res1 = float16_t(fa1 * exp2(fb1));
            break;
        case 50: // frac (unary): x - trunc(x) — sign-preserving (PyTorch convention)
            res0 = float16_t(fa0 - trunc(fa0));
            res1 = float16_t(fa1 - trunc(fa1));
            break;
        case 51: // log_sigmoid (unary)
            res0 = float16_t(-log(1.0 + exp(-fa0)));
            res1 = float16_t(-log(1.0 + exp(-fa1)));
            break;
        default:
            res0 = float16_t(0.0);
            res1 = float16_t(0.0);
            break;
    }

    // Handle odd number of elements
    if (idx1 >= params.n) {
        res1 = float16_t(0.0);
    }

    result[pair_idx] = packF16Pair(res0, res1);
}
