#version 450

// Phase 8.4: density normalization for histogramdd that reads bin steps from
// params_buf on device. inv_norm = 1 / (N * prod_d step[d]).

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer CountsF { float counts_f[]; };
layout(binding = 1) buffer ParamsB { float dim_params[]; };
layout(binding = 2) buffer OutputB { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint total_bins;
    uint D;
    uint N;
} params;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.total_bins) return;

    // Compute bin_volume on each invocation. D is small (typically 2-3) so
    // recomputing per-thread is cheaper than a separate reduce + sync.
    float bin_volume = 1.0;
    for (uint d = 0u; d < params.D; ++d) {
        bin_volume *= dim_params[d * 2u + 1u];  // step
    }
    float norm = float(params.N) * bin_volume;
    float inv_norm = (norm > 0.0) ? (1.0 / norm) : 0.0;

    output_data[i] = counts_f[i] * inv_norm;
}
