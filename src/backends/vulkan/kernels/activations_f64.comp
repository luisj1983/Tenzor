#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Activation functions: ReLU, Sigmoid, Tanh, GELU, LeakyReLU, Swish, ELU, SELU, Mish, Softplus (Float64)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint activation; // 0=ReLU, 1=Sigmoid, 2=Tanh, 3=GELU, 4=LeakyReLU, 5=Swish, 6=ELU, 7=SELU, 8=Mish, 9=Softplus
    double alpha;    // Parameter for LeakyReLU, ELU, Softplus beta
} params;

const double PI = 3.141592653589793;
const double SELU_ALPHA = 1.6732632423543772848170429916717;
const double SELU_SCALE = 1.0507009873554804934193349852946;

// Double-precision exp using range reduction
double exp_d(double x) {
    if (x != x) return x;  // NaN
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;

    // Range reduction: exp(x) = 2^k * exp(r)
    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));

    // exp(r) via degree-13 Taylor polynomial (Horner's method)
    // |r| <= ln(2)/2, error bound < r^14/14! < 1e-19
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0 +
        r * (1.0/6227020800.0)))))))))))));


    // Compute 2^|k| via binary exponentiation
    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) pow2 *= base;
        base *= base;
        abs_k >>= 1;
    }

    return (k >= 0) ? (exp_r * pow2) : (exp_r / pow2);
}

// Double-precision tanh using exp_d. Always uses the double-precision
// formula: the moderate-|x| shortcut `double(tanh(float(x)))` cost ~16 bits
// of mantissa and made Float64 activation tests fail gradcheck.
double tanh_d(double x) {
    if (x != x) return x;  // NaN
    if (x > 20.0) return 1.0;
    if (x < -20.0) return -1.0;
    double e2x = exp_d(2.0 * x);
    return (e2x - 1.0) / (e2x + 1.0);
}

// Double-precision log via IEEE 754 bit extraction + atanh series.
double log_d(double x) {
    if (x != x) return x;
    if (x < 0.0) return 0.0 / 0.0;
    if (x == 0.0) return -1.0 / 0.0;
    if (x == 1.0) return 0.0;
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;
    int biased_exp = int((hi >> 20u) & 0x7FFu);
    int exp_val = biased_exp - 1023;
    uint hi_normalized = (hi & 0x000FFFFFu) | 0x3FF00000u;
    double m = packDouble2x32(uvec2(lo, hi_normalized));
    if (m > 1.4142135623730950488) { m *= 0.5; exp_val += 1; }
    double f = m - 1.0;
    double s = f / (2.0 + f);
    double s2 = s * s;
    double c1 = 0.6666666666666735130;
    double c2 = 0.3999999999940941908;
    double c3 = 0.2857142874366239149;
    double c4 = 0.2222219843214978396;
    double c5 = 0.1818357216161805012;
    double c6 = 0.1531383769920937332;
    double c7 = 0.1479819860511658591;
    double s4 = s2 * s2;
    double t1 = c1 + c2 * s2 + c3 * s4;
    double s6 = s4 * s2;
    double t2 = c4 + c5 * s2 + c6 * s4 + c7 * s6;
    double R = t1 + t2 * s6;
    double log_m = 2.0 * s + s * s2 * R;
    double ln2_hi = 0.69314718055994530942;
    double ln2_lo = 2.3190468138462995584e-17;
    double exp_dbl = double(exp_val);
    return exp_dbl * ln2_hi + (log_m + exp_dbl * ln2_lo);
}

double relu(double x) {
    return max(0.0, x);
}

double sigmoid(double x) {
    return 1.0 / (1.0 + exp_d(-x));
}

// erf via Abramowitz & Stegun 7.1.26 (max abs error ~1.5e-7). Exact erf GELU
// matches PyTorch's default (approximate='none') and the other backends.
double erf_approx_d(double x) {
    double s = sign(x);
    double ax = abs(x);
    double t = 1.0 / (1.0 + 0.3275911 * ax);
    double y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t
                       - 0.284496736) * t + 0.254829592) * t * exp_d(-ax * ax);
    return s * y;
}

double gelu(double x) {
    // Exact GELU: 0.5 * x * (1 + erf(x / sqrt(2)))
    return 0.5 * x * (1.0 + erf_approx_d(x * 0.70710678118654752));
}

double leaky_relu(double x, double alpha) {
    return x > 0.0 ? x : alpha * x;
}

double swish(double x) {
    return x / (1.0 + exp_d(-x));
}

double elu(double x, double alpha) {
    return x > 0.0 ? x : alpha * (exp_d(x) - 1.0);
}

double selu(double x) {
    return x > 0.0 ? SELU_SCALE * x : SELU_SCALE * SELU_ALPHA * (exp_d(x) - 1.0);
}

double softplus_d(double x, double beta) {
    double bx = beta * x;
    if (bx > 20.0) return x;
    if (bx < -20.0) return exp_d(bx) / beta;
    return log_d(1.0 + exp_d(bx)) / beta;
}

double softplus_d1(double x) {
    if (x > 20.0) return x;
    if (x < -20.0) return exp_d(x);
    return log_d(1.0 + exp_d(x));
}

double mish(double x) {
    double sp = softplus_d1(x);
    return x * tanh_d(sp);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    double x = input_data[idx];
    double result;

    switch (params.activation) {
        case 0: // ReLU
            result = relu(x);
            break;
        case 1: // Sigmoid
            result = sigmoid(x);
            break;
        case 2: // Tanh
            result = tanh_d(x);
            break;
        case 3: // GELU
            result = gelu(x);
            break;
        case 4: // LeakyReLU
            result = leaky_relu(x, params.alpha);
            break;
        case 5: // Swish
            result = swish(x);
            break;
        case 6: // ELU
            result = elu(x, params.alpha);
            break;
        case 7: // SELU
            result = selu(x);
            break;
        case 8: // Mish
            result = mish(x);
            break;
        case 9: // Softplus
            result = softplus_d(x, params.alpha);
            break;
        default:
            result = x;
    }

    output_data[idx] = result;
}
