#version 450

// Hyperbolic functions: sinh, cosh, tanh
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputBuffer { float input_data[]; };
layout(binding = 1) buffer OutputBuffer { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=sinh, 1=cosh, 2=tanh
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    float val = input_data[idx];

    switch (params.op) {
        case 0: // sinh
            output_data[idx] = sinh(val);
            break;
        case 1: // cosh
            output_data[idx] = cosh(val);
            break;
        case 2: // tanh
            output_data[idx] = tanh(val);
            break;
        default:
            output_data[idx] = 0.0;
            break;
    }
}
