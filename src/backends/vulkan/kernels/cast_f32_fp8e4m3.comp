#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Cast Float32 to FP8 E4M3 (1 sign, 4 exponent, 3 mantissa, bias=7)
// E4M3 has no infinity; max exponent + non-zero mantissa = NaN
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    float data[];
} input_buf;

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
    uint8_t data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;

    float f = input_buf.data[idx];
    uint f_bits = floatBitsToUint(f);

    uint sign = (f_bits >> 31) & 0x1u;
    uint exp = (f_bits >> 23) & 0xFFu;
    uint mantissa = f_bits & 0x7FFFFFu;

    uint h_sign = sign;
    uint h_exp;
    uint h_mantissa;

    if (exp == 0xFFu) {
        // Float32 Inf/NaN -> E4M3 NaN
        h_exp = 0xFu;
        h_mantissa = 0x7u;
    } else if (exp == 0u) {
        // Float32 zero/denorm -> E4M3 zero
        h_exp = 0u;
        h_mantissa = 0u;
    } else {
        // float32 bias=127, e4m3 bias=7
        int new_exp = int(exp) - 127 + 7;

        if (new_exp >= 15) {
            // Overflow -> max finite value (E4M3 has no infinity).
            // In E4M3 (OCP fp8): exp=15 (0xF) with mantissa 0..6 are finite,
            // mantissa=7 (0x7) is reserved for NaN. The largest finite value is
            // therefore exp=15, mantissa=6 = 448.0 — matching the CPU converter
            // (src/core/dtype.cpp). (exp=15, mantissa=0 would only be 256.0.)
            h_exp = 0xFu;
            h_mantissa = 0x6u;
        } else if (new_exp <= 0) {
            // Denormalized or underflow, round-to-nearest-even (matches CPU
            // converter in src/core/dtype.cpp).
            if (new_exp >= -3) {
                uint m = (mantissa | 0x800000u) >> uint(1 - new_exp);
                uint kept = (m >> 20) & 0x7u;
                uint remainder = m & 0xFFFFFu;        // low 20 bits
                uint halfway = 0x80000u;              // 1 << 19
                if (remainder > halfway || (remainder == halfway && (kept & 1u) != 0u)) {
                    kept++;  // may carry subnormal -> smallest normal (exp field 1)
                }
                // kept can be 0x8 after carry: promotes to exp=1, mant=0, which
                // the packed (h_exp<<3)|h_mantissa layout encodes naturally.
                h_exp = kept >> 3;
                h_mantissa = kept & 0x7u;
            } else {
                h_exp = 0u;
                h_mantissa = 0u;
            }
        } else {
            // Normalized, round-to-nearest-even on the 20 discarded mantissa bits.
            uint kept = (mantissa >> 20) & 0x7u;
            uint remainder = mantissa & 0xFFFFFu;     // low 20 bits
            uint halfway = 0x80000u;                  // 1 << 19
            // Pack so a mantissa carry propagates into the exponent.
            uint packed = (uint(new_exp) << 3) | kept;
            if (remainder > halfway || (remainder == halfway && (kept & 1u) != 0u)) {
                packed++;
            }
            uint r_exp = packed >> 3;
            uint r_mant = packed & 0x7u;
            // Clamp to the max finite E4M3 value (exp=0xF, mant=0x6 = 448);
            // exp==0xF with mant>=0x7 would be NaN, so saturate per NVIDIA RN.
            if (r_exp > 0xFu || (r_exp == 0xFu && r_mant >= 0x7u)) {
                r_exp = 0xFu;
                r_mant = 0x6u;
            }
            h_exp = r_exp;
            h_mantissa = r_mant;
        }
    }

    output_buf.data[idx] = int8_t(int((h_sign << 7) | (h_exp << 3) | h_mantissa));
}
