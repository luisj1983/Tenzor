#version 450

// Roll operation for BFloat16: shift elements along a dimension with wrap-around.
// BF16 buffers pack 2 BFloat16 per uint32. Writing a single element needs a
// read-modify-write of the shared 32-bit word, which RACES when two invocations
// update the two halves of the same word concurrently (one clobbers the other,
// leaving the loser's element as 0). To avoid that, each output WORD is written
// exactly once: only even-element invocations run, and each gathers both halves
// and stores the full packed word in a single write.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input { uint in_data[]; };
layout(binding = 1) buffer Output { uint out_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements
    uint dim_size;       // Size of the roll dimension
    uint shift;          // Shift amount (already normalized to [0, dim_size))
    uint inner_size;     // Product of sizes of dims after the roll dim
} params;

// Read a single bfloat16 element from packed uint buffer.
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2u;
    uint word_offset = element_idx % 2u;
    uint packed = in_data[word_idx];
    uint bits = (packed >> (word_offset * 16u)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16u);
}

// Convert float -> bfloat16 bits with round-to-nearest-even.
uint packBF16(float val) {
    uint fb = floatBitsToUint(val);
    return ((fb + 0x7FFFu + ((fb >> 16u) & 1u)) >> 16u) & 0xFFFFu;
}

// Map an output element index to its source element index under the roll.
uint srcIndex(uint e) {
    uint inner_idx = e % params.inner_size;
    uint dim_idx = (e / params.inner_size) % params.dim_size;
    uint outer_idx = e / (params.inner_size * params.dim_size);
    uint src_dim_idx = (dim_idx - params.shift + params.dim_size) % params.dim_size;
    return (outer_idx * params.dim_size + src_dim_idx) * params.inner_size + inner_idx;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;
    if ((idx & 1u) != 0u) return;  // even invocation owns the whole 32-bit word

    uint loBits = packBF16(readBF16(srcIndex(idx)));

    uint hiBits = 0u;
    if (idx + 1u < params.n) {
        hiBits = packBF16(readBF16(srcIndex(idx + 1u)));
    }

    out_data[idx / 2u] = loBits | (hiBits << 16u);
}
