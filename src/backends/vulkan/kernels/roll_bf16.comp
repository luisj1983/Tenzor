#version 450

// Roll operation for BFloat16: shift elements along a dimension with wrap-around
// BF16 packed buffers (2 BFloat16 per uint32)
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input { uint in_data[]; };
layout(binding = 1) buffer Output { uint out_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements
    uint dim_size;       // Size of the roll dimension
    uint shift;          // Shift amount (already normalized to [0, dim_size))
    uint inner_size;     // Product of sizes of dims after the roll dim
} params;

// Read a single bfloat16 element from packed uint buffer
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = in_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Write a single bfloat16 element to packed uint buffer
void writeBF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = ((floatBitsToUint(val) + 0x7FFFu + ((floatBitsToUint(val) >> 16) & 1u)) >> 16);
    uint existing = out_data[word_idx];
    uint mask = 0xFFFFu << (word_offset * 16);
    out_data[word_idx] = (existing & ~mask) | (bits << (word_offset * 16));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;

    uint inner_idx = idx % params.inner_size;
    uint dim_idx = (idx / params.inner_size) % params.dim_size;
    uint outer_idx = idx / (params.inner_size * params.dim_size);

    // Source index with wrap-around
    uint src_dim_idx = (dim_idx - params.shift + params.dim_size) % params.dim_size;
    uint src_idx = (outer_idx * params.dim_size + src_dim_idx) * params.inner_size + inner_idx;

    float val = readBF16(src_idx);
    writeBF16(idx, val);
}
