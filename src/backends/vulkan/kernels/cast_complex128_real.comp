#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Cast complex128 (interleaved float64 pairs) to real (float64).
// Extracts the real part of each complex element.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input  { float64_t input_data[]; };
layout(binding = 1) writeonly buffer Output { float64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;  // number of complex elements
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;

    output_data[idx] = input_data[idx * 2];  // extract real part
}
