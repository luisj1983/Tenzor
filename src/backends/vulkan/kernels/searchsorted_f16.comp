#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// SearchSorted for Float16: binary search per query element over a sorted array
// Float16 elements are packed 2 per 32-bit word in uint buffers
// Output is Int32 indices (not packed)
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer SortedArray { uint sorted_data[]; };   // Packed F16 pairs
layout(binding = 1) buffer QueryValues { uint query_data[]; };    // Packed F16 pairs
layout(binding = 2) buffer OutputIndices { int output_indices[]; };

layout(push_constant) uniform PushConstants {
    uint array_size;    // Length of the sorted array (in elements)
    uint num_queries;   // Number of query values (in elements)
    uint right;         // 0 = leftmost (lower_bound), 1 = rightmost (upper_bound)
} params;

// Read a single Float16 element from packed uint32 sorted array
float readSorted(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (sorted_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

// Read a single Float16 element from packed uint32 query array
float readQuery(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (query_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_queries) return;

    float query = readQuery(idx);

    // Binary search: right=0 -> leftmost insertion (lower_bound, sorted[mid] < query),
    // right=1 -> rightmost insertion (upper_bound, sorted[mid] <= query).
    uint lo = 0;
    uint hi = params.array_size;

    while (lo < hi) {
        uint mid = lo + (hi - lo) / 2;
        float sval = readSorted(mid);
        bool go_right = (params.right != 0u) ? (sval <= query) : (sval < query);
        if (go_right) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }

    output_indices[idx] = int(lo);
}
