#version 450

// Transform operations: reshape, transpose, permute
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Total number of elements
    uint ndim;       // Number of dimensions
    uint transform;  // 0=copy, 1=transpose, 2=permute
    uint rows;       // Number of rows (input dim0)
    uint cols;       // Number of cols (input dim1)
} params;

// Transpose for arbitrary 2D matrix (rows x cols) -> (cols x rows)
void transpose_2d(uint idx) {
    uint row = idx / params.cols;
    uint col = idx % params.cols;
    uint new_idx = col * params.rows + row;
    output_data[new_idx] = input_data[idx];
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    switch (params.transform) {
        case 0: // copy/reshape
            output_data[idx] = input_data[idx];
            break;
        case 1: // transpose
            transpose_2d(idx);
            break;
        default:
            output_data[idx] = input_data[idx];
    }
}
