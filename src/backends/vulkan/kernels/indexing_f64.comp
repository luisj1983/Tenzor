#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Indexing operations: slicing, gather, scatter (Float64 variant)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float64_t input_data[]; };
layout(binding = 1) buffer Indices { int indices_data[]; };
layout(binding = 2) buffer Output { float64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of output elements
    uint op;         // 0=gather, 1=scatter
    uint dim;        // Dimension to index along
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    if (params.op == 0) {
        // Gather: output[i] = input[indices[i]].
        // Bound the source index by the actual INPUT buffer length, not the
        // output element count (params.n): the input may have a different number
        // of elements, so checking against params.n would both drop valid
        // indices and allow out-of-bounds reads.
        int src_idx = indices_data[idx];
        if (src_idx >= 0 && src_idx < int(input_data.length())) {
            output_data[idx] = input_data[src_idx];
        }
    } else {
        // Scatter: output[indices[i]] = input[i].
        // Bound the destination index by the actual OUTPUT buffer length.
        int dst_idx = indices_data[idx];
        if (dst_idx >= 0 && dst_idx < int(output_data.length())) {
            output_data[dst_idx] = input_data[idx];
        }
    }
}
