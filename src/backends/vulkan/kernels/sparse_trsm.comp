#version 450

// Sparse triangular solve: L*X = B (lower) or U*X = B (upper)
// L/U is a CSR sparse matrix (N x N), B and X are dense matrices (N x K_rhs).
//
// Same level-set approach as sparse_trsv but solves for multiple RHS columns.
// Each workgroup handles one row, with threads cooperating across RHS columns.

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer RowOffsets { int row_offsets[]; };
layout(set = 0, binding = 1) readonly buffer ColIndices { int col_indices[]; };
layout(set = 0, binding = 2) readonly buffer Values     { float values[];     };
layout(set = 0, binding = 3) readonly buffer RHS        { float B[];          };
layout(set = 0, binding = 4) buffer Output              { float X[];          };
layout(set = 0, binding = 5) buffer SolvedCounter        { int solved[];       };

layout(push_constant) uniform PushConstants {
    uint n;       // matrix dimension (N x N)
    uint k_rhs;   // number of RHS columns
    uint upper;   // 0 = lower triangular, 1 = upper triangular
};

void main() {
    uint wg = gl_WorkGroupID.x;    // maps to processing order index
    uint tid = gl_LocalInvocationID.x;
    if (wg >= n) return;

    uint row = (upper != 0u) ? (n - 1u - wg) : wg;

    // Wait for dependency rows
    if (wg > 0u) {
        uint rs = uint(row_offsets[row]);
        uint re = uint(row_offsets[row + 1]);
        for (uint i = rs; i < re; i++) {
            uint col = uint(col_indices[i]);
            bool is_dep = (upper == 0u) ? (col < row) : (col > row);
            if (is_dep) {
                while (atomicOr(solved[col], 0) == 0) { }
            }
        }
    }

    // Solve row for each RHS column this thread handles
    uint rs = uint(row_offsets[row]);
    uint re = uint(row_offsets[row + 1]);

    for (uint c = tid; c < k_rhs; c += 256) {
        float rhs = B[row * k_rhs + c];
        float diag = 1.0;

        for (uint i = rs; i < re; i++) {
            uint col = uint(col_indices[i]);
            if (col == row) {
                diag = values[i];
            } else {
                rhs -= values[i] * X[col * k_rhs + c];
            }
        }

        X[row * k_rhs + c] = rhs / diag;
    }

    // Ensure all threads in this workgroup have written before signaling
    barrier();

    // Signal row completion (only one thread per workgroup)
    if (tid == 0u) {
        atomicExchange(solved[row], 1);
    }
}
