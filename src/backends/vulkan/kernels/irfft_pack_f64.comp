#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Complex-to-Real IFFT: Pack N/2+1 complex frequency bins into N/2 complex values — Float64

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;                // Original real FFT size (N)
    uint batch_size;       // Number of independent FFTs
    uint in_batch_stride;  // Stride between input batches (in double elements)
    uint out_batch_stride; // Stride between output batches (in complex elements)
};

const double PI_D = 3.14159265358979323846LF;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint half_n = n / 2;
    uint total_items = half_n * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / half_n;
    uint local_tid = tid % half_n;

    uint in_base = batch_idx * in_batch_stride;
    uint out_base = batch_idx * out_batch_stride;

    if (local_tid == 0) {
        double x0_re = data_in[in_base];
        double xn_re = data_in[in_base + half_n * 2];
        data_out[out_base * 2]     = x0_re + xn_re;
        data_out[out_base * 2 + 1] = x0_re - xn_re;
        return;
    }

    uint k = local_tid;
    uint conj_k = half_n - k;

    double xk_re = data_in[in_base + k * 2];
    double xk_im = data_in[in_base + k * 2 + 1];
    double xc_re =  data_in[in_base + conj_k * 2];
    double xc_im = -data_in[in_base + conj_k * 2 + 1];

    double a_re = xk_re + xc_re;
    double a_im = xk_im + xc_im;
    double b_re = xk_re - xc_re;
    double b_im = xk_im - xc_im;

    double angle = 2.0LF * PI_D * double(k) / double(n);
    float angle_f = float(angle);
    double w_re = double(cos(angle_f));
    double w_im = double(sin(angle_f));

    double iw_b_re = -(w_im * b_re + w_re * b_im);
    double iw_b_im =   w_re * b_re - w_im * b_im;

    data_out[(out_base + k) * 2]     = a_re + iw_b_re;
    data_out[(out_base + k) * 2 + 1] = a_im + iw_b_im;
}
