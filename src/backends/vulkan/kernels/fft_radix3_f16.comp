#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Stockham mixed-radix FFT: radix-3 butterfly stage (Float16)
// Data layout: interleaved real/imag pairs, packed as uint32 (2 f16 per word)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };  // packed f16 pairs
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint stage_stride;
    uint direction;
    uint batch_size;    // Number of independent FFTs
    uint batch_stride;  // Stride between batches (in complex elements)
};

const float PI = 3.14159265358979323846;
const float COS_2PI_3 = -0.5;
const float SIN_2PI_3 = 0.86602540378443864676;

float readF16Element(uint element_idx) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint packed = data_in[pair_idx];
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return float(float16_t(unpackHalf2x16(bits | (bits << 16)).x));
}

void writeF16Element(uint element_idx, float val) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    if (offset == 0) {
        uint existing = data_out[pair_idx] & 0xFFFF0000u;
        data_out[pair_idx] = existing | bits;
    } else {
        uint existing = data_out[pair_idx] & 0x0000FFFFu;
        data_out[pair_idx] = existing | (bits << 16);
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 3;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    uint group = local_tid / stage_stride;
    uint pos = local_tid % stage_stride;

    uint i0 = group * stage_stride * 3 + pos;
    uint i1 = i0 + stage_stride;
    uint i2 = i1 + stage_stride;

    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;
    uint o2 = o1 + n_butterflies;

    // Apply batch stride
    uint base = batch_idx * batch_stride;
    uint b0_in = (base + i0) * 2;
    uint b1_in = (base + i1) * 2;
    uint b2_in = (base + i2) * 2;
    uint b0_out = (base + o0) * 2;
    uint b1_out = (base + o1) * 2;
    uint b2_out = (base + o2) * 2;

    // Read and compute in F32
    float a0_re = readF16Element(b0_in), a0_im = readF16Element(b0_in + 1);
    float a1_re = readF16Element(b1_in), a1_im = readF16Element(b1_in + 1);
    float a2_re = readF16Element(b2_in), a2_im = readF16Element(b2_in + 1);

    float angle1 = -2.0 * PI * float(pos) / float(stage_stride * 3);
    float angle2 = 2.0 * angle1;
    if (direction == 1) { angle1 = -angle1; angle2 = -angle2; }

    float w1_re = cos(angle1), w1_im = sin(angle1);
    float w2_re = cos(angle2), w2_im = sin(angle2);

    float t1_re = a1_re * w1_re - a1_im * w1_im;
    float t1_im = a1_re * w1_im + a1_im * w1_re;
    float t2_re = a2_re * w2_re - a2_im * w2_im;
    float t2_im = a2_re * w2_im + a2_im * w2_re;

    float s1_re = t1_re + t2_re, s1_im = t1_im + t2_im;
    float d1_re = t1_re - t2_re, d1_im = t1_im - t2_im;

    writeF16Element(b0_out,     a0_re + s1_re);
    writeF16Element(b0_out + 1, a0_im + s1_im);
    writeF16Element(b1_out,     a0_re + COS_2PI_3 * s1_re - SIN_2PI_3 * d1_im);
    writeF16Element(b1_out + 1, a0_im + COS_2PI_3 * s1_im + SIN_2PI_3 * d1_re);
    writeF16Element(b2_out,     a0_re + COS_2PI_3 * s1_re + SIN_2PI_3 * d1_im);
    writeF16Element(b2_out + 1, a0_im + COS_2PI_3 * s1_im - SIN_2PI_3 * d1_re);
}
