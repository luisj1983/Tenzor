#version 450

// Sequential NMS — correctness over throughput.
// The previous parallel version raced on `suppressed[j]`: thread i could
// read suppressed[j]==0 before thread j had written its self-suppression,
// which made box i measure IoU against a box that was about to be
// suppressed. PyTorch's sequential algorithm skips already-suppressed
// boxes, so this produced extra suppressions — the parity test returned
// 3 boxes where CPU returned 4.
//
// We dispatch as (1, 1, 1). Thread 0 walks the sorted box list and
// suppresses every later box that overlaps a kept one, so writes to
// `suppressed` always precede the matching reads.
layout(local_size_x = 1) in;

layout(set = 0, binding = 0) readonly buffer Boxes { float boxes[]; };
layout(set = 0, binding = 1) buffer Suppressed { uint suppressed[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    float iou_threshold;
};

void main() {
    if (gl_GlobalInvocationID.x != 0u) return;

    for (uint i = 0u; i < N; ++i) {
        if (suppressed[i] != 0u) continue;

        float x1_i = boxes[i * 4u + 0u];
        float y1_i = boxes[i * 4u + 1u];
        float x2_i = boxes[i * 4u + 2u];
        float y2_i = boxes[i * 4u + 3u];
        float area_i = (x2_i - x1_i) * (y2_i - y1_i);

        for (uint j = i + 1u; j < N; ++j) {
            if (suppressed[j] != 0u) continue;

            float x1_j = boxes[j * 4u + 0u];
            float y1_j = boxes[j * 4u + 1u];
            float x2_j = boxes[j * 4u + 2u];
            float y2_j = boxes[j * 4u + 3u];

            float inter_x1 = max(x1_i, x1_j);
            float inter_y1 = max(y1_i, y1_j);
            float inter_x2 = min(x2_i, x2_j);
            float inter_y2 = min(y2_i, y2_j);

            float inter_w = max(inter_x2 - inter_x1, 0.0);
            float inter_h = max(inter_y2 - inter_y1, 0.0);
            float inter_area = inter_w * inter_h;

            float area_j = (x2_j - x1_j) * (y2_j - y1_j);
            float union_area = area_i + area_j - inter_area;

            if (union_area > 0.0 && inter_area / union_area > iou_threshold) {
                suppressed[j] = 1u;
            }
        }
    }
}
