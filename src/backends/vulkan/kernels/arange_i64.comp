#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Arange for Int64 / UInt64: output[i] = start + i*step, computed from
// double-precision start/step so large integer sequences (>2^24) stay exact.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { int64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
    uint _pad;
    double start;
    double step;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) {
        return;
    }
    output_data[idx] = int64_t(params.start) + int64_t(idx) * int64_t(params.step);
}
