#version 450

// Full operation: create tensor filled with specific value
layout(local_size_x = 256) in;

layout(binding = 0) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;   // Number of elements
    float fill_value;  // Value to fill with
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    output_data[idx] = params.fill_value;
}
