#version 450

// Full operation: create tensor filled with specific value
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;   // Number of elements
    uint fill_value_bits;  // Value to fill with (as raw bits)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Write raw bits directly - works for both float and int32
    output_data[idx] = params.fill_value_bits;
}
