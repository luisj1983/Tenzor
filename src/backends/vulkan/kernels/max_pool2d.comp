#version 450

// Max Pooling 2D Forward Pass
// Finds maximum value in pooling window
// Supports dilation parameter

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };    // (N, C, H, W)
layout(binding = 1) buffer Output { float output_data[]; };  // (N, C, H_out, W_out)

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output elements (N * C * H_out * W_out)
    uint batch;               // N
    uint channels;            // C
    uint in_height;           // H
    uint in_width;            // W
    uint out_height;          // H_out
    uint out_width;           // W_out
    uint kernel_h;            // Kernel height
    uint kernel_w;            // Kernel width
    uint stride_h;            // Stride height
    uint stride_w;            // Stride width
    uint padding_h;           // Padding height
    uint padding_w;           // Padding width
    uint dilation_h;          // Dilation height
    uint dilation_w;          // Dilation width
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Bounds check
    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Compute input window bounds
    int h_start = int(h_out * params.stride_h) - int(params.padding_h);
    int w_start = int(w_out * params.stride_w) - int(params.padding_w);

    // Initialize max value to negative infinity
    float max_val = -1.0 / 0.0;

    // Iterate over pooling window with dilation
    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int h_in = h_start + int(kh * params.dilation_h);
            int w_in = w_start + int(kw * params.dilation_w);

            // Check if within input bounds
            if (h_in >= 0 && h_in < int(params.in_height) &&
                w_in >= 0 && w_in < int(params.in_width)) {

                // Compute input index: (n, c, h_in, w_in)
                uint input_idx = n * params.channels * params.in_height * params.in_width +
                                c * params.in_height * params.in_width +
                                uint(h_in) * params.in_width +
                                uint(w_in);

                float val = input_data[input_idx];
                max_val = (val > max_val || val != val) ? val : max_val;
            }
        }
    }

    // Write output
    output_data[idx] = max_val;
}
