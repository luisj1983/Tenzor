#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Group Normalization Backward Pass - Float64 variant (two-pass, no atomics)
// Pass 1: One workgroup per (batch, group) pair. Each workgroup computes:
//   1. Shared memory reductions for sum_dy and sum_dy_xhat (within the group)
//   2. Per-element grad_input (no contention)
//   3. Per-workgroup partial sums for grad_weight and grad_bias per channel
// Pass 2 uses reduce_partial_sums_f64.comp to sum partials across workgroups.
//
// Dispatch: batch_size * num_groups workgroups.

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer GradOutput { double grad_output[]; };  // (N, C, H, W)
layout(binding = 1) buffer Input { double input_data[]; };         // (N, C, H, W)
layout(binding = 2) buffer Mean { double mean_data[]; };           // (N * num_groups)
layout(binding = 3) buffer Rstd { double rstd_data[]; };           // (N * num_groups)
layout(binding = 4) buffer Weight { double weight_data[]; };       // (C)
layout(binding = 5) buffer GradInput { double grad_input[]; };     // (N, C, H, W)
layout(binding = 6) buffer PartialGradWeight { double partial_grad_weight[]; };  // (N * num_groups, C)
layout(binding = 7) buffer PartialGradBias { double partial_grad_bias[]; };      // (N * num_groups, C)

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_channels;
    uint height;
    uint width;
    uint num_groups;
    float epsilon;
    uint affine;
    uint padding;
} params;

shared double shared_sum_dy[WORKGROUP_SIZE];
shared double shared_sum_dy_xhat[WORKGROUP_SIZE];
shared double shared_grad_w[WORKGROUP_SIZE];
shared double shared_grad_b[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;
    uint batch_idx = wg_id / params.num_groups;
    uint group_idx = wg_id % params.num_groups;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint channels_per_group = params.num_channels / params.num_groups;
    uint spatial_size = params.height * params.width;
    uint group_size = channels_per_group * spatial_size;

    uint group_start = batch_idx * params.num_channels * spatial_size +
                       group_idx * channels_per_group * spatial_size;

    // Read mean and rstd for this (batch, group) pair
    uint stats_idx = batch_idx * params.num_groups + group_idx;
    double mean = mean_data[stats_idx];
    double rstd = rstd_data[stats_idx];

    // Step 1: Compute sum_dy and sum_dy_xhat over group elements
    double local_sum_dy = 0.0lf;
    double local_sum_dy_xhat = 0.0lf;

    for (uint i = tid; i < group_size; i += WORKGROUP_SIZE) {
        uint idx = group_start + i;
        uint local_channel = i / spatial_size;
        uint global_channel = group_idx * channels_per_group + local_channel;

        double grad_out = grad_output[idx];
        double x = input_data[idx];
        double xhat = (x - mean) * rstd;

        double w = 1.0lf;
        if (params.affine > 0) {
            w = weight_data[global_channel];
        }

        local_sum_dy += grad_out * w;
        local_sum_dy_xhat += grad_out * w * xhat;
    }

    shared_sum_dy[tid] = local_sum_dy;
    shared_sum_dy_xhat[tid] = local_sum_dy_xhat;
    barrier();

    // Parallel reduction for sum_dy and sum_dy_xhat
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_dy[tid] += shared_sum_dy[tid + s];
            shared_sum_dy_xhat[tid] += shared_sum_dy_xhat[tid + s];
        }
        barrier();
    }

    double sum_dy = shared_sum_dy[0];
    double sum_dy_xhat = shared_sum_dy_xhat[0];
    barrier();

    // Step 2: Compute grad_input (no contention)
    double fgroup_size = double(group_size);

    for (uint i = tid; i < group_size; i += WORKGROUP_SIZE) {
        uint idx = group_start + i;
        uint local_channel = i / spatial_size;
        uint global_channel = group_idx * channels_per_group + local_channel;

        double grad_out = grad_output[idx];
        double x = input_data[idx];
        double xhat = (x - mean) * rstd;

        double w = 1.0lf;
        if (params.affine > 0) {
            w = weight_data[global_channel];
        }

        double grad_in = rstd * (grad_out * w - sum_dy / fgroup_size - xhat * sum_dy_xhat / fgroup_size);
        grad_input[idx] = grad_in;
    }

    // Step 3: Compute per-workgroup partial sums for grad_weight and grad_bias
    // per channel within this group. We iterate over channels_per_group, doing a
    // shared memory reduction for each channel.
    uint partial_base = wg_id * params.num_channels;

    // Zero out channels outside this workgroup's group (not strictly needed if
    // the reduction shader only sums the relevant entries, but keeps things clean)
    for (uint gc = tid; gc < params.num_channels; gc += WORKGROUP_SIZE) {
        partial_grad_weight[partial_base + gc] = 0.0lf;
        partial_grad_bias[partial_base + gc] = 0.0lf;
    }
    barrier();

    for (uint lc = 0; lc < channels_per_group; lc++) {
        uint global_channel = group_idx * channels_per_group + lc;
        uint channel_start = group_start + lc * spatial_size;

        // Each thread accumulates over its portion of the spatial dimension
        double local_gw = 0.0lf;
        double local_gb = 0.0lf;

        for (uint s = tid; s < spatial_size; s += WORKGROUP_SIZE) {
            uint idx = channel_start + s;
            double grad_out = grad_output[idx];
            double x = input_data[idx];
            double xhat = (x - mean) * rstd;

            local_gw += grad_out * xhat;
            local_gb += grad_out;
        }

        shared_grad_w[tid] = local_gw;
        shared_grad_b[tid] = local_gb;
        barrier();

        // Parallel reduction
        for (uint rs = WORKGROUP_SIZE / 2; rs > 0; rs >>= 1) {
            if (tid < rs) {
                shared_grad_w[tid] += shared_grad_w[tid + rs];
                shared_grad_b[tid] += shared_grad_b[tid + rs];
            }
            barrier();
        }

        if (tid == 0) {
            partial_grad_weight[partial_base + global_channel] = shared_grad_w[0];
            partial_grad_bias[partial_base + global_channel] = shared_grad_b[0];
        }
        barrier();
    }
}
