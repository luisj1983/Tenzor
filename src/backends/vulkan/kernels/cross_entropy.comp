#version 450

// Cross Entropy Loss
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer LogProbs { float log_probs[]; };    // Log probabilities (batch_size x num_classes)
layout(binding = 1) buffer Targets { int targets[]; };         // Target class indices (batch_size)
layout(binding = 2) buffer Losses { float losses[]; };         // Output losses (batch_size)

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint reduction;  // 0=none, 1=mean, 2=sum
} params;

shared float shared_sum[WORKGROUP_SIZE];

float sample_loss(uint s_idx) {
    int target = targets[s_idx];
    if (target >= 0 && target < int(params.num_classes)) {
        // Cross entropy: -log(p[target])
        return -log_probs[s_idx * params.num_classes + uint(target)];
    }
    return 0.0;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;

    if (params.reduction == 0) {
        // No reduction: one element per sample. The host launches enough
        // workgroups to cover the batch, so use the global index directly.
        if (idx < params.batch_size) {
            losses[idx] = sample_loss(idx);
        }
        return;
    }

    // Reduction (mean/sum): the host launches exactly ONE workgroup, so each
    // thread must block-stride over the whole batch before the tree reduction.
    // (Previously only samples with idx < WORKGROUP_SIZE were summed, so the
    // total under-counted while mean still divided by the full batch_size.)
    float acc = 0.0;
    for (uint i = tid; i < params.batch_size; i += WORKGROUP_SIZE) {
        acc += sample_loss(i);
    }
    shared_sum[tid] = acc;
    barrier();

    // Parallel tree reduction over the workgroup (spec-constant size).
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        float total = shared_sum[0];
        if (params.reduction == 1) { // mean
            total /= float(params.batch_size);
        }
        losses[0] = total;
    }
}

