#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Embedding Backward Pass (Float64) — non-atomic-int64 fallback.
//
// OUTPUT-CENTRIC, RACE-FREE accumulation: this shader is used on devices that
// lack GL_EXT_shader_atomic_int64, so a CAS-based f64 atomicAdd is unavailable.
// Rather than the (racy) index-centric `grad_weight[idx] += ...` scatter — which
// silently drops gradient contributions when duplicate token indices appear in a
// batch — each invocation OWNS exactly one grad_weight element (target_row, dim)
// and sums every index position whose (wrapped) row equals target_row. Because
// each output element is written by a single thread, no atomics are required and
// duplicate indices accumulate correctly (matching CPU/OneAPI).
//
// Dispatched over num_embeddings * embedding_dim threads (see the host, which
// selects this thread count for the Float64 fallback path).
//
// Input: grad_output (num_indices, embedding_dim), indices (num_indices)
// Output: grad_weight (num_embeddings, embedding_dim)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float64_t grad_output_data[]; };
layout(binding = 1) buffer Indices { int indices_data[]; };
layout(binding = 2) buffer GradWeight { float64_t grad_weight_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_indices;
    uint embedding_dim;
    uint num_embeddings;
} params;

void main() {
    uint global_id = gl_GlobalInvocationID.x;

    uint target_row = global_id / params.embedding_dim;
    uint dim = global_id % params.embedding_dim;

    if (target_row >= params.num_embeddings) {
        return;
    }

    // Race-free reduction: sum every grad_output row whose (wrapped) index equals
    // this thread's target_row. Negative indices wrap (forward maps row -1 ->
    // num_embeddings-1); a still-out-of-range index never matches a valid
    // target_row and is therefore dropped, matching the forward.
    float64_t acc = float64_t(0.0);
    for (uint i = 0u; i < params.num_indices; ++i) {
        int signed_row = indices_data[i];
        if (signed_row < 0) signed_row += int(params.num_embeddings);
        if (signed_row == int(target_row)) {
            acc += grad_output_data[i * params.embedding_dim + dim];
        }
    }

    grad_weight_data[target_row * params.embedding_dim + dim] = acc;
}
