#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Embedding Backward Pass (Float64)
// Scatter-add: accumulates gradients from grad_output into grad_weight rows indexed by indices
//
// RACE CONDITION NOTE: The += on grad_weight_data is non-atomic. When duplicate indices
// exist in the batch, multiple invocations may write to the same row concurrently, causing
// lost updates (not corruption — just missed gradient contributions). This is a known
// limitation because:
//   1. GL_EXT_shader_atomic_int64 is not widely available on consumer GPUs
//   2. Float64 atomics via CAS on uint64 would require the extension anyway
//   3. In practice, duplicate embedding indices within a single batch are uncommon
//      (e.g., word indices in NLP — each position typically has a unique token)
//   4. Even with rare duplicates, SGD training is robust to occasional gradient noise
//
// For correctness-critical use cases with many duplicate indices, the host dispatcher
// should pre-sort indices and use a serial accumulation path or fall back to CPU.
//
// Input: grad_output (num_indices, embedding_dim), indices (num_indices)
// Output: grad_weight (num_embeddings, embedding_dim)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float64_t grad_output_data[]; };
layout(binding = 1) buffer Indices { int indices_data[]; };
layout(binding = 2) buffer GradWeight { float64_t grad_weight_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_indices;
    uint embedding_dim;
    uint num_embeddings;
} params;

void main() {
    uint global_id = gl_GlobalInvocationID.x;

    uint index_pos = global_id / params.embedding_dim;
    uint dim = global_id % params.embedding_dim;

    if (index_pos >= params.num_indices) {
        return;
    }

    uint target_row = uint(indices_data[index_pos]);

    // Bounds check on target row
    if (target_row >= params.num_embeddings) {
        return;
    }

    grad_weight_data[target_row * params.embedding_dim + dim] +=
        grad_output_data[index_pos * params.embedding_dim + dim];
}
