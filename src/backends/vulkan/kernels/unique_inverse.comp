#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Compute inverse mapping for unique operation.
// For each sorted position i: inverse[sorted_indices[i]] = group_id[i]
// where group_id is derived from boundaries via prefix_sum - 1.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer SortedIndices { int64_t sorted_indices[]; };
layout(set = 0, binding = 1) readonly buffer PrefixSum { int prefix_sum[]; };
layout(set = 0, binding = 2) writeonly buffer Inverse { int64_t inverse_data[]; };

layout(push_constant) uniform PushConstants {
    uint numel;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= numel) return;

    // prefix_sum is inclusive scan of boundary flags, so group_id = prefix_sum[i] - 1
    int64_t group_id = int64_t(prefix_sum[gid]) - int64_t(1);
    int64_t orig_idx = sorted_indices[gid];
    inverse_data[orig_idx] = group_id;
}
