#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// FractionalMaxPool3d Forward Float64.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input   { double input_data[]; };
layout(binding = 1) writeonly buffer Output  { double output_data[]; };
layout(binding = 2) writeonly buffer Indices { int    indices_data[]; };
layout(binding = 3) readonly buffer Samples  { float  samples_data[]; };

layout(push_constant) uniform PushConstants {
    uint N; uint C; uint D; uint H; uint W;
    uint out_d; uint out_h; uint out_w;
    uint total_output;
    uint has_samples;
    uint kernel_d; uint kernel_h; uint kernel_w;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_output) return;

    uint ow = idx % params.out_w;
    uint tmp = idx / params.out_w;
    uint oh = tmp % params.out_h;
    tmp = tmp / params.out_h;
    uint od = tmp % params.out_d;
    tmp = tmp / params.out_d;
    uint c = tmp % params.C;
    uint n = tmp / params.C;

    float sample_d = 0.5, sample_h = 0.5, sample_w = 0.5;
    if (params.has_samples != 0) {
        uint si = (n * params.C + c) * 3;
        sample_d = samples_data[si];
        sample_h = samples_data[si + 1];
        sample_w = samples_data[si + 2];
    }

    // Pool regions use Graham's disjoint-subsequence method (arXiv:1412.6071),
    // matching the CPU reference kernel exactly (see
    // cpu/kernels/pooling.cpp fractional_maxpool3d_impl):
    //   start_i = floor((i + u) * (in/out) - u)
    //   end_i   = floor((i + 1 + u) * (in/out) - u)
    // The earlier kernel-window formula floor((i+u)*(in-k)/(out-1)) chose a
    // different window than the CPU for u >= 0.5 and broke backend parity.
    float d_alpha = float(params.D) / float(params.out_d);
    float h_alpha = float(params.H) / float(params.out_h);
    float w_alpha = float(params.W) / float(params.out_w);

    int d_start = int(floor((float(od) + sample_d) * d_alpha - sample_d));
    int h_start = int(floor((float(oh) + sample_h) * h_alpha - sample_h));
    int w_start = int(floor((float(ow) + sample_w) * w_alpha - sample_w));

    int d_end = int(floor((float(od) + 1.0 + sample_d) * d_alpha - sample_d));
    int h_end = int(floor((float(oh) + 1.0 + sample_h) * h_alpha - sample_h));
    int w_end = int(floor((float(ow) + 1.0 + sample_w) * w_alpha - sample_w));

    d_start = max(d_start, 0); d_end = min(d_end, int(params.D));
    h_start = max(h_start, 0); h_end = min(h_end, int(params.H));
    w_start = max(w_start, 0); w_end = min(w_end, int(params.W));
    if (d_end <= d_start) d_end = d_start + 1;
    if (h_end <= h_start) h_end = h_start + 1;
    if (w_end <= w_start) w_end = w_start + 1;
    d_end = min(d_end, int(params.D));
    h_end = min(h_end, int(params.H));
    w_end = min(w_end, int(params.W));

    double max_val = -1.0lf / 0.0lf;
    int max_idx = (d_start * int(params.H) + h_start) * int(params.W) + w_start;

    uint base = (n * params.C + c) * params.D * params.H * params.W;
    for (int d = d_start; d < d_end; d++) {
        for (int h = h_start; h < h_end; h++) {
            for (int w = w_start; w < w_end; w++) {
                double val = input_data[base + (uint(d) * params.H + uint(h)) * params.W + uint(w)];
                if (val > max_val) {
                    max_val = val;
                    max_idx = (d * int(params.H) + h) * int(params.W) + w;
                }
            }
        }
    }

    output_data[idx]  = max_val;
    indices_data[idx] = max_idx;
}
