#version 450

// Batch Normalization
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Mean { float mean_data[]; };
layout(binding = 2) buffer Variance { float var_data[]; };
layout(binding = 3) buffer Gamma { float gamma_data[]; };
layout(binding = 4) buffer Beta { float beta_data[]; };
layout(binding = 5) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint height;
    uint width;
    float epsilon;
    uint affine; // 0=no affine, 1=with affine
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch * params.channels * params.height * params.width;

    if (idx >= total) {
        return;
    }

    // Calculate channel index
    uint spatial_size = params.height * params.width;
    uint c = (idx / spatial_size) % params.channels;

    // Normalize
    float x = input_data[idx];
    float mean = mean_data[c];
    float variance = var_data[c];
    float normalized = (x - mean) / sqrt(variance + params.epsilon);

    // Apply affine transformation if enabled
    if (params.affine > 0) {
        normalized = normalized * gamma_data[c] + beta_data[c];
    }

    output_data[idx] = normalized;
}
