#version 450

// Scale complex array by 1/N for inverse FFT normalization
// Data layout: interleaved real/imag pairs

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer DataBuf { float data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of complex elements
    float inv_n;     // 1.0 / n
};

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= n) return;

    // Each complex element = 2 floats
    uint base = tid * 2;
    data[base]     *= inv_n;
    data[base + 1] *= inv_n;
}
