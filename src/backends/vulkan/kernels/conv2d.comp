#version 450

// 2D Convolution
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Weight { float weight_data[]; };
layout(binding = 2) buffer Bias { float bias_data[]; };
layout(binding = 3) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint in_channels;
    uint in_height;
    uint in_width;
    uint out_channels;
    uint out_height;
    uint out_width;
    uint kernel_h;
    uint kernel_w;
    uint stride;
    uint padding;
    uint dilation;
    uint has_bias;
} params;

void main() {
    uint out_x = gl_GlobalInvocationID.x;
    uint out_y = gl_GlobalInvocationID.y;
    uint out_c = gl_GlobalInvocationID.z;

    if (out_x >= params.out_width || out_y >= params.out_height ||
        out_c >= params.out_channels) {
        return;
    }

    // Compute convolution for this output position
    float sum = 0.0;

    for (uint in_c = 0; in_c < params.in_channels; in_c++) {
        for (uint kh = 0; kh < params.kernel_h; kh++) {
            for (uint kw = 0; kw < params.kernel_w; kw++) {
                int in_y = int(out_y * params.stride) - int(params.padding) +
                          int(kh * params.dilation);
                int in_x = int(out_x * params.stride) - int(params.padding) +
                          int(kw * params.dilation);

                if (in_y >= 0 && in_y < int(params.in_height) &&
                    in_x >= 0 && in_x < int(params.in_width)) {
                    uint input_idx = in_c * params.in_height * params.in_width +
                                    uint(in_y) * params.in_width + uint(in_x);
                    uint weight_idx = out_c * params.in_channels * params.kernel_h * params.kernel_w +
                                     in_c * params.kernel_h * params.kernel_w +
                                     kh * params.kernel_w + kw;

                    sum += input_data[input_idx] * weight_data[weight_idx];
                }
            }
        }
    }

    // Add bias if present
    if (params.has_bias > 0) {
        sum += bias_data[out_c];
    }

    // Write output
    uint output_idx = out_c * params.out_height * params.out_width +
                     out_y * params.out_width + out_x;
    output_data[output_idx] = sum;
}
