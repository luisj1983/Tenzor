#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// FractionalMaxPool2d Forward Float64 — preserves precision through autograd.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input   { double input_data[]; };
layout(binding = 1) writeonly buffer Output  { double output_data[]; };
layout(binding = 2) writeonly buffer Indices { int    indices_data[]; };
layout(binding = 3) readonly buffer Samples  { float  samples_data[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint C;
    uint H;
    uint W;
    uint out_h;
    uint out_w;
    uint total_output;
    uint has_samples;
    uint kernel_h;
    uint kernel_w;
} params;

// PyTorch FractionalMaxPool window start for output index `i` along one axis;
// windows are `pool`-wide (== kernel_size) and OVERLAP (see the Float32 shader).
int frac_pool_start(int i, int in_size, int out_size, int pool, float u) {
    int start;
    if (out_size <= 1 || i == out_size - 1) {
        start = in_size - pool;
    } else {
        float alpha = float(in_size - pool) / float(out_size - 1);
        start = int((float(i) + u) * alpha) - int(u * alpha);
    }
    return clamp(start, 0, in_size - pool);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_output) return;

    uint ow = idx % params.out_w;
    uint tmp = idx / params.out_w;
    uint oh = tmp % params.out_h;
    tmp = tmp / params.out_h;
    uint c = tmp % params.C;
    uint n = tmp / params.C;

    float sample_h = 0.5;
    float sample_w = 0.5;
    if (params.has_samples != 0) {
        uint sample_idx = (n * params.C + c) * 2;
        sample_h = samples_data[sample_idx];
        sample_w = samples_data[sample_idx + 1];
    }

    // PyTorch overlapping windows of width == kernel_h x kernel_w, positioned by
    // the pseudo-random sample offset. Earlier versions ignored kernel_h/kernel_w
    // and used the input/output ratio (adaptive-style), diverging from torch.nn.
    int h_start = frac_pool_start(int(oh), int(params.H), int(params.out_h), int(params.kernel_h), sample_h);
    int w_start = frac_pool_start(int(ow), int(params.W), int(params.out_w), int(params.kernel_w), sample_w);

    int h_end = min(h_start + int(params.kernel_h), int(params.H));
    int w_end = min(w_start + int(params.kernel_w), int(params.W));

    double max_val = -1.0lf / 0.0lf;  // -inf as double
    int max_idx = h_start * int(params.W) + w_start;

    uint base = (n * params.C + c) * params.H * params.W;
    for (int h = h_start; h < h_end; h++) {
        for (int w = w_start; w < w_end; w++) {
            double val = input_data[base + uint(h) * params.W + uint(w)];
            if (val > max_val || val != val) {
                max_val = val;
                max_idx = h * int(params.W) + w;
            }
        }
    }

    output_data[idx]  = max_val;
    indices_data[idx] = max_idx;
}
