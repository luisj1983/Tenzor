#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Put operation for BFloat16: scatter source values to indexed positions in a flat output
// BFloat16 elements are packed 2 per 32-bit word in uint buffers
// Uses CAS loop for both replace and accumulate modes (packed half-word writes)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint output_data[]; };    // Destination (packed BF16, uint for atomics)
layout(binding = 1) buffer Indices { int indices[]; };         // Target indices
layout(binding = 2) buffer Source { uint source_data[]; };     // Values to put (packed BF16)

layout(push_constant) uniform PushConstants {
    uint numel;        // Total number of output elements (for bounds checking)
    uint num_indices;  // Number of indices (= source size)
    uint accumulate;   // 0 = replace, 1 = add
} params;

// Read a single BFloat16 element from packed uint32 source array
float readBF16Source(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (source_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackBF16x2(bits).x;
}

// Write a single BFloat16 element to packed uint32 output array using CAS loop
void writeBF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_bits = ((floatBitsToUint(value) + 0x7FFFu + ((floatBitsToUint(value) >> 16) & 1u)) >> 16);
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

// Atomic add for BFloat16 using CAS loop on the uint32 word
void atomicAddBF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        // Extract current BF16 value
        uint old_bits = (old_word >> half_offset) & 0xFFFFu;
        float old_val = unpackBF16x2(old_bits).x;
        float new_val = old_val + val;
        uint new_bits = ((floatBitsToUint(new_val) + 0x7FFFu + ((floatBitsToUint(new_val) >> 16) & 1u)) >> 16);

        // Build new word with updated half
        uint new_word = (old_word & ~(0xFFFFu << half_offset)) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_indices) return;

    int put_idx = indices[idx];

    // Bounds check: skip out-of-range indices
    if (put_idx < 0 || put_idx >= int(params.numel)) return;

    float value = readBF16Source(idx);
    uint dest = uint(put_idx);

    if (params.accumulate == 0) {
        // Replace mode: CAS write (last-write-wins for duplicate indices)
        writeBF16(dest, value);
    } else {
        // Accumulate mode: atomic add via CAS loop
        atomicAddBF16(dest, value);
    }
}
