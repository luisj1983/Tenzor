#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Backward activation functions for Float64 autograd
// Operations: 0=relu, 1=sigmoid, 2=tanh, 3=leaky_relu, 4=gelu, 5=elu, 6=selu, 7=mish, 8=softplus

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { double grad_output[]; };
layout(binding = 1) buffer InputOrOutput { double input_or_output[]; };
layout(binding = 2) buffer GradInput { double grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation code
    double alpha;    // For leaky_relu_backward (stored as double for alignment)
} params;

const double PI = 3.141592653589793;
const double SELU_ALPHA = 1.6732632423543772848170429916717;
const double SELU_SCALE = 1.0507009873554804934193349852946;

// Double-precision exp using range reduction
double exp_d(double x) {
    if (x != x) return x;  // NaN
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;

    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));

    // exp(r) via degree-13 Taylor polynomial (Horner's method)
    // |r| <= ln(2)/2, error bound < r^14/14! < 1e-19
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0 +
        r * (1.0/6227020800.0)))))))))))));


    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) pow2 *= base;
        base *= base;
        abs_k >>= 1;
    }

    return (k >= 0) ? (exp_r * pow2) : (exp_r / pow2);
}

// Double-precision tanh — always uses double formula; float shortcut cost
// ~16 mantissa bits and broke Float64 activation-backward gradcheck.
double tanh_d(double x) {
    if (x != x) return x;  // NaN
    if (x > 20.0) return 1.0;
    if (x < -20.0) return -1.0;
    double e2x = exp_d(2.0 * x);
    return (e2x - 1.0) / (e2x + 1.0);
}

// Double-precision log via IEEE 754 bit extraction + atanh series.
double log_d(double x) {
    if (x != x) return x;
    if (x < 0.0) return 0.0 / 0.0;
    if (x == 0.0) return -1.0 / 0.0;
    if (x == 1.0) return 0.0;
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;
    int biased_exp = int((hi >> 20u) & 0x7FFu);
    int exp_val = biased_exp - 1023;
    uint hi_normalized = (hi & 0x000FFFFFu) | 0x3FF00000u;
    double m = packDouble2x32(uvec2(lo, hi_normalized));
    if (m > 1.4142135623730950488) { m *= 0.5; exp_val += 1; }
    double f = m - 1.0;
    double s = f / (2.0 + f);
    double s2 = s * s;
    double c1 = 0.6666666666666735130;
    double c2 = 0.3999999999940941908;
    double c3 = 0.2857142874366239149;
    double c4 = 0.2222219843214978396;
    double c5 = 0.1818357216161805012;
    double c6 = 0.1531383769920937332;
    double c7 = 0.1479819860511658591;
    double s4 = s2 * s2;
    double t1 = c1 + c2 * s2 + c3 * s4;
    double s6 = s4 * s2;
    double t2 = c4 + c5 * s2 + c6 * s4 + c7 * s6;
    double R = t1 + t2 * s6;
    double log_m = 2.0 * s + s * s2 * R;
    double ln2_hi = 0.69314718055994530942;
    double ln2_lo = 2.3190468138462995584e-17;
    double exp_dbl = double(exp_val);
    return exp_dbl * ln2_hi + (log_m + exp_dbl * ln2_lo);
}

// Double-precision erf via fdlibm-style rational approximations (~1e-16),
// ported from math_f64.comp (uses exp_d). Replaces the ~1.5e-7 A&S form so the
// Float64 GELU backward matches the forward and the other backends.
double erf_d(double x) {
    if (x != x) return x;  // NaN
    double sgn = (x < 0.0) ? -1.0 : 1.0;
    double ax = (x < 0.0) ? -x : x;
    if (ax >= 6.0) return sgn * 1.0;

    if (ax < 0.84375) {
        if (ax < 3.7252902984e-9) return sgn * ax * 1.1283791670955126;
        double z = ax * ax;
        double pp0 =  1.28379167095512558561e-01;
        double pp1 = -3.25042107247001499370e-01;
        double pp2 = -2.84817495755985104766e-02;
        double pp3 = -5.77027029648944159157e-03;
        double pp4 = -2.37630166566501626084e-05;
        double qq1 =  3.97917223959155352819e-01;
        double qq2 =  6.50222499887672944485e-02;
        double qq3 =  5.08130628187576562776e-03;
        double qq4 =  1.32494738004321644526e-04;
        double qq5 = -3.96022827877536812320e-06;
        double r = pp0 + z * (pp1 + z * (pp2 + z * (pp3 + z * pp4)));
        double s = 1.0 + z * (qq1 + z * (qq2 + z * (qq3 + z * (qq4 + z * qq5))));
        return sgn * (ax + ax * (r / s));
    }
    if (ax < 1.25) {
        double s_ = ax - 1.0;
        double pa0 = -2.36211856075265944077e-03;
        double pa1 =  4.14856118683748331666e-01;
        double pa2 = -3.72207876035701323847e-01;
        double pa3 =  3.18346619901161753674e-01;
        double pa4 = -1.10894694282396677476e-01;
        double pa5 =  3.54783043256182359371e-02;
        double pa6 = -2.16637559486879084300e-03;
        double qa1 =  1.06420880400844228286e-01;
        double qa2 =  5.40397917702171048937e-01;
        double qa3 =  7.18286544141962662868e-02;
        double qa4 =  1.26171219808761642112e-01;
        double qa5 =  1.36370839120290507362e-02;
        double qa6 =  1.19844998467991074170e-02;
        double P = pa0 + s_ * (pa1 + s_ * (pa2 + s_ * (pa3 + s_ * (pa4 + s_ * (pa5 + s_ * pa6)))));
        double Q = 1.0 + s_ * (qa1 + s_ * (qa2 + s_ * (qa3 + s_ * (qa4 + s_ * (qa5 + s_ * qa6)))));
        double erx = 8.45062911510467529297e-01;
        return sgn * (erx + P / Q);
    }
    if (ax < 2.857142857142857) {
        double s_ = 1.0 / (ax * ax);
        double ra0 = -9.86494403484714822705e-03;
        double ra1 = -6.93858572707181764372e-01;
        double ra2 = -1.05586262253232909814e+01;
        double ra3 = -6.23753324503260060396e+01;
        double ra4 = -1.62396669462573470355e+02;
        double ra5 = -1.84605092906711035994e+02;
        double ra6 = -8.12874355063065934246e+01;
        double ra7 = -9.81432934416256659757e+00;
        double sa1 =  1.96512716674392571292e+01;
        double sa2 =  1.37657754143519042600e+02;
        double sa3 =  4.34565877475229228821e+02;
        double sa4 =  6.45387271733267880336e+02;
        double sa5 =  4.29008140027567833386e+02;
        double sa6 =  1.08635005541779435134e+02;
        double sa7 =  6.57024977031928170135e+00;
        double sa8 = -6.04244152148580987438e-02;
        double R = ra0 + s_ * (ra1 + s_ * (ra2 + s_ * (ra3 + s_ * (ra4 + s_ * (ra5 + s_ * (ra6 + s_ * ra7))))));
        double S = 1.0 + s_ * (sa1 + s_ * (sa2 + s_ * (sa3 + s_ * (sa4 + s_ * (sa5 + s_ * (sa6 + s_ * (sa7 + s_ * sa8)))))));
        double erfc_val = exp_d(-ax * ax - 0.5625 + R / S) / ax;
        return sgn * (1.0 - erfc_val);
    }
    // Large |x| (>= 2.857142857142857, < 6.0): see activations_f64.comp's
    // erf_d for the full rationale -- the old Rb/Sb rational-polynomial +
    // bit-truncation branch had a ~1e-4 relative error bug (verified
    // independent of any GPU/driver behavior). Replaced with Lentz's
    // continued fraction for erfc, accurate to ~1e-15 relative error here.
    double cf = 0.0;
    for (int k = 30; k >= 1; --k) {
        cf = (double(k) * 0.5) / (ax + cf);
    }
    cf = 1.0 / (ax + cf);
    const double INV_SQRT_PI = 0.5641895835477562869480794515607726;
    double erfc_val = exp_d(-ax * ax) * INV_SQRT_PI * cf;
    return sgn * (1.0 - erfc_val);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    double g_out = grad_output[idx];
    double val = input_or_output[idx];

    switch (params.op) {
        case 0: // relu_backward: grad_output * (input > 0 ? 1 : 0)
            grad_input[idx] = (val > 0.0) ? g_out : 0.0;
            break;

        case 1: // sigmoid_backward: grad_output * output * (1 - output)
            // val is the output of sigmoid
            grad_input[idx] = g_out * val * (1.0 - val);
            break;

        case 2: // tanh_backward: grad_output * (1 - output * output)
            // val is the output of tanh
            grad_input[idx] = g_out * (1.0 - val * val);
            break;

        case 3: // leaky_relu_backward: grad_output * (input > 0 ? 1 : alpha)
            // val is the input
            grad_input[idx] = (val > 0.0) ? g_out : params.alpha * g_out;
            break;

        case 4: { // gelu_backward (exact erf):
            // gelu'(x) = 0.5*(1+erf(x/sqrt(2))) + x*(1/sqrt(2*pi))*exp(-x^2/2)
            double x = val;  // val is the input
            double cdf = 0.5 * (1.0 + erf_d(x * 0.70710678118654752));
            double pdf = 0.39894228040143268 * exp_d(-0.5 * x * x);  // 1/sqrt(2*pi)
            grad_input[idx] = g_out * (cdf + x * pdf);
            break;
        }

        case 5: // elu_backward: grad_output * (x > 0 ? 1 : alpha * exp(x))
            // val is the input
            if (val > 0.0) {
                grad_input[idx] = g_out;
            } else {
                grad_input[idx] = g_out * params.alpha * exp_d(val);
            }
            break;

        case 6: // selu_backward: grad_output * (x > 0 ? scale : scale * alpha * exp(x))
            // val is the input
            if (val > 0.0) {
                grad_input[idx] = g_out * SELU_SCALE;
            } else {
                grad_input[idx] = g_out * SELU_SCALE * SELU_ALPHA * exp_d(val);
            }
            break;

        case 7: { // mish_backward: Complex formula
            // val is the input
            double x = val;
            double sp = x > 20.0 ? x : (x < -20.0 ? exp_d(x) : log_d(1.0 + exp_d(x)));
            double tanh_sp = tanh_d(sp);
            double sigmoid_x = 1.0 / (1.0 + exp_d(-x));
            double derivative = tanh_sp + x * sigmoid_x * (1.0 - tanh_sp * tanh_sp);
            grad_input[idx] = g_out * derivative;
            break;
        }

        case 8: { // softplus_backward: grad_output * sigmoid(beta * x)
            // val is the input, params.alpha is beta
            double bx = params.alpha * val;
            double grad;
            if (bx > 20.0) {
                grad = 1.0;
            } else if (bx < -20.0) {
                grad = exp_d(bx);
            } else {
                grad = 1.0 / (1.0 + exp_d(-bx));
            }
            grad_input[idx] = g_out * grad;
            break;
        }

        default:
            grad_input[idx] = 0.0;
            break;
    }
}
