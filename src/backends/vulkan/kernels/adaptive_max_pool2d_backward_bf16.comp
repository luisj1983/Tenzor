#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Adaptive Max Pool 2D Backward Pass (BFloat16 version)
// Routes gradients back to the positions recorded by forward pass indices
// Uses atomicCompSwap-based accumulation since BFloat16 doesn't support atomicAdd
// BFloat16 elements packed 2 per uint32 word

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };  // Packed BF16: [N, C, out_h, out_w]
layout(binding = 1) buffer Indices { int indices[]; };           // [N, C, out_h, out_w] -- flat index into input
layout(binding = 2) buffer GradInput { uint grad_input[]; };    // Packed BF16: [N, C, in_h, in_w]

layout(push_constant) uniform PushConstants {
    uint n_elements;      // Total elements in grad_output (N * C * out_h * out_w)
    uint grad_input_size; // Total elements in grad_input (N * C * in_h * in_w)
    uint channels;
    uint in_h;
    uint in_w;
    uint out_plane;  // out_h * out_w, per-(n,c) output plane (F043)
} params;

float readBF16(uint element_idx) {
    uint word_idx = element_idx >> 1u;
    uint packed = grad_output[word_idx];
    vec2 pair = unpackBF16x2(packed);
    return ((element_idx & 1u) == 0u) ? pair.x : pair.y;
}

// Atomic add for BFloat16 packed in uint32 words
// Reads current value, adds grad, writes back using CAS loop
void atomicAddBF16(uint element_idx, float grad) {
    uint word_idx = element_idx >> 1u;
    uint word_offset = element_idx & 1u;
    uint shift = word_offset * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = grad_input[word_idx];
    for (uint iter = 0u; iter < 65536u; iter++) {
        uint expected = old_val;
        // Extract current bfloat16 value
        uint cur_bits = (expected >> shift) & 0xFFFFu;
        float cur_val = unpackBF16x2(cur_bits | (cur_bits << 16u)).x;
        // Add gradient
        float new_val_f = cur_val + grad;
        // Pack back
        uint new_bits = ((floatBitsToUint(new_val_f) + 0x7FFFu + ((floatBitsToUint(new_val_f) >> 16) & 1u)) >> 16);
        uint new_word = (expected & ~mask) | (new_bits << shift);

        old_val = atomicCompSwap(grad_input[word_idx], expected, new_word);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word (X.7 / Y.11 / Y.16).
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    float grad = readBF16(idx);
    // F043: forward stores PLANE-LOCAL argmax (in_y*in_w + in_x); rebuild
    // the global grad_input offset via the per-(n,c) plane base.
    int plane_local = indices[idx];
    uint nc = idx / params.out_plane;
    int target_idx = int(nc * params.in_h * params.in_w) + plane_local;
    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAddBF16(uint(target_idx), grad);
    }
}
