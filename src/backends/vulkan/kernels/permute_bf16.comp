#version 450

// Permute operation for BFloat16: arbitrary dimension reordering
// BF16 packed buffers (2 BFloat16 per uint32)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };
layout(binding = 2) buffer InputShape { int shape[]; };       // Input shape
layout(binding = 3) buffer InputStrides { int strides[]; };   // Input strides
layout(binding = 4) buffer PermuteDims { int perm[]; };       // Permutation order

layout(push_constant) uniform PushConstants {
    uint n;          // Total number of elements
    uint ndim;       // Number of dimensions
} params;

// Read a single bfloat16 element from packed uint input buffer
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Write a single bfloat16 element to packed uint output buffer.
// Two bfloat16 elements share one 32-bit word, and neighbouring output
// elements are written by independent invocations, so the packed
// read-modify-write must be done atomically (CAS loop) to avoid one
// invocation's update being lost.
void writeBF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_bits = ((floatBitsToUint(val) + 0x7FFFu + ((floatBitsToUint(val) >> 16) & 1u)) >> 16);
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint observed = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (observed == old_word) return;
        old_word = observed;
    }
}

// Convert linear index to multi-dimensional indices based on output shape
void index_to_coords(uint linear_idx, uint ndims, out int coords[8]) {
    uint remaining = linear_idx;
    int out_shape[8];
    for (uint i = 0; i < ndims && i < 8u; i++) {
        out_shape[i] = max(shape[perm[i]], 1);
    }

    for (int i = int(ndims) - 1; i >= 0; i--) {
        int s = out_shape[i];
        coords[i] = int(remaining % uint(s));
        remaining /= uint(s);
    }
}

// Convert multi-dimensional indices to linear index using strides
uint coords_to_index(int coords[8], uint ndims, int stride_array[8]) {
    uint idx = 0;
    for (uint i = 0; i < ndims; i++) {
        idx += uint(coords[i] * stride_array[i]);
    }
    return idx;
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.n) return;
    if (params.ndim > 8u) return;

    // Get output coordinates
    int out_coords[8];
    index_to_coords(out_idx, params.ndim, out_coords);

    // Permute coordinates to get input coordinates
    int in_coords[8];
    for (uint i = 0; i < params.ndim; i++) {
        in_coords[perm[i]] = out_coords[i];
    }

    // Convert input coordinates to linear index
    int in_strides[8];
    for (uint i = 0; i < params.ndim; i++) {
        in_strides[i] = strides[i];
    }
    uint in_idx = coords_to_index(in_coords, params.ndim, in_strides);

    // Copy data through BF16 pack/unpack
    float val = readBF16(in_idx);
    writeBF16(out_idx, val);
}
