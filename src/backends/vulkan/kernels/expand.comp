#version 450

// Expand operation: broadcast tensor to larger size
// Supports multi-dimensional broadcasting following NumPy rules
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;        // Total output elements
    uint input_ndim;        // Input dimensions
    uint output_ndim;       // Output dimensions
    uint input_shape[8];    // Input shape (max 8 dims)
    uint output_shape[8];   // Output shape (max 8 dims)
    uint input_strides[8];  // Input strides for indexing
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Decode output flat index to multi-dimensional indices
    uint out_indices[8];
    uint temp = idx;
    for (int i = int(params.output_ndim) - 1; i >= 0; i--) {
        out_indices[i] = temp % params.output_shape[i];
        temp /= params.output_shape[i];
    }

    // Map output indices to input indices using broadcasting rules
    // If input dimension is 1, use index 0; otherwise use output index
    uint input_idx = 0;
    for (uint i = 0; i < params.input_ndim; i++) {
        // Align dimensions from the right
        uint out_dim_idx = params.output_ndim - params.input_ndim + i;
        uint in_idx = (params.input_shape[i] == 1) ? 0 : out_indices[out_dim_idx];
        input_idx += in_idx * params.input_strides[i];
    }

    // Copy value from input to output
    output_data[idx] = input_data[input_idx];
}
