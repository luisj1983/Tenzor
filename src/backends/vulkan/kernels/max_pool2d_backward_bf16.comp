#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Max Pooling 2D Backward Pass for BFloat16
// Gradient flows only to max element, recomputes max indices in shader.
// grad_input is a PACKED-BF16 buffer (2 bytes/elem). A float32 atomicAdd would
// write 4 bytes per element index — OOB for the upper half of the tensor and
// corrupting adjacent packed halves (it also misroutes gradients because index
// i*4 lands at the wrong element). Accumulate into packed-BF16 via a CAS loop.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };   // Packed BF16 (N, C, H_out, W_out)
layout(binding = 1) buffer Input { uint input_data[]; };         // Packed BF16 (N, C, H, W)
layout(binding = 2) buffer GradInput { uint grad_input[]; };     // Packed BF16, CAS-accumulated

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output gradient elements (N * C * H_out * W_out)
    uint batch;               // N
    uint channels;            // C
    uint in_height;           // H
    uint in_width;            // W
    uint out_height;          // H_out
    uint out_width;           // W_out
    uint kernel_h;            // Kernel height
    uint kernel_w;            // Kernel width
    uint stride_h;            // Stride height
    uint stride_w;            // Stride width
    uint padding_h;           // Padding height
    uint padding_w;           // Padding width
    uint dilation_h;          // Dilation height
    uint dilation_w;          // Dilation width
} params;

float readBF16GradOut(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = grad_output[word_idx];
    vec2 pair = unpackBF16x2(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readBF16Input(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = input_data[word_idx];
    vec2 pair = unpackBF16x2(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

// Atomically add a BF16 value to a packed BF16 buffer element via a CAS loop on
// the enclosing uint32 word (no native BF16 atomicAdd). Round-to-nearest-even
// packing via packBF16x2; only the targeted half is updated.
void atomicAddBF16(uint flat_idx, float add_val) {
    uint word_idx = flat_idx >> 1u;
    uint half_idx = flat_idx & 1u;

    uint old_val = grad_input[word_idx];
    uint expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        vec2 cur = unpackBF16x2(expected);
        float current = (half_idx == 0u) ? cur.x : cur.y;
        float updated = current + add_val;
        vec2 nv = (half_idx == 0u) ? vec2(updated, cur.y) : vec2(cur.x, updated);
        uint new_word = packBF16x2(nv);
        // packBF16x2 rewrites both halves from the unpacked pair, so the
        // untouched half is preserved exactly; mask is implicit in the pair.
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_word);
        if (old_val == expected) return;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Bounds check
    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Get output gradient
    float grad_out = readBF16GradOut(idx);

    // Compute input window bounds
    int h_start = int(h_out * params.stride_h) - int(params.padding_h);
    int w_start = int(w_out * params.stride_w) - int(params.padding_w);

    // Find max value and its position (recompute from forward pass)
    float max_val = -1.0 / 0.0;
    int max_h = -1;
    int max_w = -1;

    // Iterate over pooling window with dilation to find max
    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int h_in = h_start + int(kh * params.dilation_h);
            int w_in = w_start + int(kw * params.dilation_w);

            // Check if within input bounds
            if (h_in >= 0 && h_in < int(params.in_height) &&
                w_in >= 0 && w_in < int(params.in_width)) {

                // Compute input index: (n, c, h_in, w_in)
                uint input_idx = n * params.channels * params.in_height * params.in_width +
                                c * params.in_height * params.in_width +
                                uint(h_in) * params.in_width +
                                uint(w_in);

                float val = readBF16Input(input_idx);

                // Update max if current value is larger
                if (val > max_val || val != val) {
                    max_val = val;
                    max_h = h_in;
                    max_w = w_in;
                }
            }
        }
    }

    // Propagate gradient only to max element
    if (max_h >= 0 && max_w >= 0) {
        // Compute input index for max element
        uint max_idx = n * params.channels * params.in_height * params.in_width +
                      c * params.in_height * params.in_width +
                      uint(max_h) * params.in_width +
                      uint(max_w);

        // Atomically add gradient into the packed-BF16 buffer via CAS.
        atomicAddBF16(max_idx, grad_out);
    }
}
