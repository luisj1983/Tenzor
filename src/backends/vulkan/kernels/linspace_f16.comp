#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Linspace for Float16: generate linearly-spaced values from start to end
// F16 packed buffers (2 Float16 per uint32), arithmetic in float32
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    float start;
    float end_val;
    uint num_steps;
} params;

void main() {
    // Each thread handles one uint32 word (2 F16 elements)
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    if (idx0 >= params.num_steps) return;

    // Compute values in float32
    float val0;
    float val1;

    if (params.num_steps == 1) {
        val0 = params.start;
        val1 = 0.0;
    } else {
        float denom = float(params.num_steps - 1);
        float t0 = float(idx0) / denom;
        val0 = params.start + t0 * (params.end_val - params.start);

        if (idx1 < params.num_steps) {
            float t1 = float(idx1) / denom;
            val1 = params.start + t1 * (params.end_val - params.start);
        } else {
            val1 = 0.0;
        }
    }

    // Pack two F16 values into one uint32
    uint bits0 = packHalf2x16(vec2(val0, 0.0)) & 0xFFFFu;
    uint bits1 = packHalf2x16(vec2(val1, 0.0)) & 0xFFFFu;
    output_data[pair_idx] = bits0 | (bits1 << 16);
}
