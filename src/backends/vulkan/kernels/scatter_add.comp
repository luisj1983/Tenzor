#version 450

// ScatterAdd operation: atomically accumulates source values into output along a dimension.
// Equivalent to: output[...][index[i]][...] += src[i]
// Uses CAS-loop atomics for thread-safe float addition (no GL_EXT_shader_atomic_float required).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Src { float src_data[]; };         // Source values to add
layout(binding = 1) buffer Index { int idx_data[]; };          // Index tensor (same shape as src)
layout(binding = 2) buffer Output { uint out_data[]; };        // Self/output (uint for CAS atomics)

// Per-dim decode (matches CPU scatter_add_kernel). The flat position i is
// decomposed into per-dim coords using the INDEX tensor's own contiguous
// strides; the output offset is recomposed with the SELF/output strides
// (substituting the index value on the scatter dim). A collapsed inner/outer
// scheme mis-decodes whenever index.size(d) < self.size(d) on a non-scatter
// axis (gather-backward in 3D+).
layout(push_constant) uniform PushConstants {
    uint n;                 // Number of source/index elements (index.numel())
    uint ndim;              // Number of dimensions (<= 8)
    uint dim;               // Normalized scatter dimension
    uint dim_size;          // Size of scatter dimension in output (for wrap + bounds)
    uvec4 index_strides0;   // Contiguous strides of INDEX tensor, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // Contiguous strides of SELF/output tensor, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

// Atomic add for float using compare-and-swap loop (bounded to prevent hangs)
void atomicAddFloat(uint idx, float val) {
    uint old_bits = out_data[idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        uint new_bits = floatBitsToUint(old_val + val);
        uint result = atomicCompSwap(out_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    // Get destination dim index from index tensor
    int dest_dim_idx = idx_data[i];
    // Normalize negative indices like the CPU reference (idx += dim_size) before the
    // bounds check, so a valid negative index wraps instead of being silently dropped.
    if (dest_dim_idx < 0) dest_dim_idx += int(params.dim_size);

    // Bounds check
    if (dest_dim_idx < 0 || dest_dim_idx >= int(params.dim_size)) return;

    // Per-dim decode of the flat index position, recomposed onto self strides.
    uint temp = i;
    uint out_idx = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_idx += uint(dest_dim_idx) * selfStride(d);
        } else {
            out_idx += coord * selfStride(d);
        }
    }

    atomicAddFloat(out_idx, src_data[i]);
}
