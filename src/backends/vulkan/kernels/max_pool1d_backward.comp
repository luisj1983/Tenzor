#version 450
#extension GL_EXT_shader_atomic_float : enable

// Max Pooling 1D Backward: scatter grad_output to grad_input at positions
// named by `indices` (produced by the forward shader as Int32). The
// original shader declared `float indices[]` and cast the bit pattern,
// which silently reinterpreted small positive int indices as subnormal
// floats (all truncating to 0); every gradient was sent to position 0.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, L_out)
layout(binding = 1) buffer Indices    { int   indices[];     };  // (N, C, L_out), Int32 from forward
layout(binding = 2) buffer GradInput  { float grad_input[];  };  // (N, C, L_in)

layout(push_constant) uniform PushConstants {
    uint n_elements;          // N * C * L_out
    uint grad_input_size;     // N * C * L_in
    uint out_plane;   // per-(n,c) output plane size (F043)
    uint in_plane;    // per-(n,c) input plane size (F043)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    float grad = grad_output[idx];
    // F043: forward stores PLANE-LOCAL argmax; rebuild the global
    // grad_input offset via the per-(n,c) plane base.
    int plane_local = indices[idx];
    uint nc = idx / params.out_plane;
    int target = int(nc * params.in_plane) + plane_local;
    if (target >= 0 && target < int(params.grad_input_size)) {
        atomicAdd(grad_input[target], grad);
    }
}
