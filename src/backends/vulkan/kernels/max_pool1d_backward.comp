#version 450
#extension GL_EXT_shader_atomic_float : enable

// Max Pooling 1D Backward Pass using pre-computed indices
// Scatters gradients to the positions where max values were found
// Uses atomic operations for overlapping pooling windows
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, L_out) flattened
layout(binding = 1) buffer Indices { float indices[]; };          // Pre-computed max indices
layout(binding = 2) buffer GradInput { float grad_input[]; };     // (N, C, L) output

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output gradient elements (N * C * L_out)
    uint grad_input_size;     // Total input gradient elements (N * C * L)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Get gradient and target index
    float grad = grad_output[idx];
    int target_idx = int(indices[idx]);

    // Bounds check and scatter gradient
    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAdd(grad_input[target_idx], grad);
    }
}
