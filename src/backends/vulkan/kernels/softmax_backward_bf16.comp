#version 450

// Softmax backward for BFloat16: grad_input = output * (grad_output - dot(grad_output, output))
// BFloat16 elements are packed 2 per 32-bit word

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };
layout(binding = 1) buffer OutputBuffer { uint output_data[]; };
layout(binding = 2) buffer GradInput { uint grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint outer_size;   // Product of dimensions before reduction dim
    uint dim_size;     // Size of the reduction dimension
    uint inner_size;   // Product of dimensions after reduction dim
} params;

float readBF16(uint buffer_type, uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed;
    if (buffer_type == 0) {
        packed = grad_output[word_idx];
    } else {
        packed = output_data[word_idx];
    }
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Helper to write bfloat16 at element index using atomic compare-exchange
// Two threads writing adjacent elements share the same uint32 word,
// so we must use atomicCompSwap to avoid clobbering each other's data.
void writeBF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;

    uint bits = ((floatBitsToUint(value) + 0x7FFFu + ((floatBitsToUint(value) >> 16) & 1u)) >> 16);
    uint shift = word_offset * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = grad_input[word_idx];
    for (uint iter = 0; iter < 1024; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Fallback: direct write after exceeding retry limit
    grad_input[word_idx] = (grad_input[word_idx] & ~mask) | (bits << shift);
}

// Helper to pack two bfloat16 values (round-to-nearest-even)
uint packBF16Pair(float v0, float v1) {
    uint b0 = floatBitsToUint(v0);
    uint b1 = floatBitsToUint(v1);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

void main() {
    // Each thread handles one (outer, inner) position
    uint global_idx = gl_GlobalInvocationID.x;
    uint total_threads = params.outer_size * params.inner_size;

    if (global_idx >= total_threads) {
        return;
    }

    uint outer_idx = global_idx / params.inner_size;
    uint inner_idx = global_idx % params.inner_size;
    uint offset = (outer_idx * params.dim_size * params.inner_size) + inner_idx;

    // Compute dot product: sum(grad_output * output) along dimension
    // Use float for accumulation to avoid precision loss
    float dot_product = 0.0;
    for (uint d = 0; d < params.dim_size; ++d) {
        uint elem_idx = offset + d * params.inner_size;
        float grad_val = readBF16(0, elem_idx);  // grad_output
        float out_val = readBF16(1, elem_idx);   // output
        dot_product += grad_val * out_val;
    }

    // Compute gradient: output * (grad_output - dot)
    for (uint d = 0; d < params.dim_size; ++d) {
        uint elem_idx = offset + d * params.inner_size;
        float grad_val = readBF16(0, elem_idx);  // grad_output
        float out_val = readBF16(1, elem_idx);   // output
        float grad_input_val = out_val * (grad_val - dot_product);
        writeBF16(elem_idx, grad_input_val);
    }
}
