#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Reduction operations: sum, mean, max, min (Float64 variant)
// This shader handles reduction along a specific dimension or full tensor reduction
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements in input
    uint reduce_size;    // Size of dimension to reduce
    uint outer_size;     // Number of output elements
    uint inner_size;     // Product of dimensions after reduction dim
    uint op;             // 0=sum, 1=mean, 2=max, 3=min
} params;

shared double shared_data[WORKGROUP_SIZE];
shared double shared_comp[WORKGROUP_SIZE]; // Kahan compensation for tree reduction

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint output_idx = gl_WorkGroupID.x;

    // Each workgroup handles one output element
    if (output_idx >= params.outer_size) {
        return;
    }

    // Initialize accumulator based on operation
    double accum;
    double compensation = 0.0LF; // Kahan compensation for per-thread accumulation
    if (params.op == 2) { // max
        accum = -1.0LF / 0.0LF; // -infinity
    } else if (params.op == 3) { // min
        accum = 1.0LF / 0.0LF; // +infinity
    } else {
        accum = 0.0LF;
    }

    // For dimensional reduction, we need to compute the proper indices
    // The input tensor is flattened, but we need to access elements along the reduction dimension
    // Formula: For output element at flat index output_idx, we need to sum over reduce_size elements
    //          with stride inner_size between them

    // Calculate the position in output space
    // outer_idx = output_idx / inner_size (which "outer" slice we're in)
    // inner_idx = output_idx % inner_size (position within the inner dimensions)
    uint outer_idx = output_idx / params.inner_size;
    uint inner_idx = output_idx % params.inner_size;

    // Starting position in input: outer_idx * (reduce_size * inner_size) + inner_idx
    uint base_idx = outer_idx * params.reduce_size * params.inner_size + inner_idx;

    // Each thread processes multiple elements along the reduction dimension
    for (uint i = tid; i < params.reduce_size; i += WORKGROUP_SIZE) {
        uint idx = base_idx + i * params.inner_size;
        if (idx < params.n) {
            double val = input_data[idx];
            switch (params.op) {
                case 0: // sum
                case 1: // mean
                {
                    // Kahan compensated summation for better floating-point accuracy
                    double y = val - compensation;
                    double t = accum + y;
                    compensation = (t - accum) - y;
                    accum = t;
                    break;
                }
                case 2: // max
                    accum = max(accum, val);
                    break;
                case 3: // min
                    accum = min(accum, val);
                    break;
            }
        }
    }

    shared_data[tid] = accum;
    shared_comp[tid] = compensation;
    barrier();

    // Parallel reduction in shared memory
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            switch (params.op) {
                case 0: // sum
                case 1: // mean
                {
                    // Kahan compensated addition for tree reduction
                    // Combine compensations first, then add the partial sum
                    double comp = shared_comp[tid] + shared_comp[tid + s];
                    double y = shared_data[tid + s] - comp;
                    double t = shared_data[tid] + y;
                    shared_comp[tid] = (t - shared_data[tid]) - y;
                    shared_data[tid] = t;
                    break;
                }
                case 2: // max
                    shared_data[tid] = max(shared_data[tid], shared_data[tid + s]);
                    break;
                case 3: // min
                    shared_data[tid] = min(shared_data[tid], shared_data[tid + s]);
                    break;
            }
        }
        barrier();
    }

    // Write result
    if (tid == 0) {
        double result = shared_data[0];
        if (params.op == 1) { // mean
            result /= double(params.reduce_size);
        }
        output_data[output_idx] = result;
    }
}
