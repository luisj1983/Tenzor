#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// ScatterAdd for Float64: atomically accumulates source values into output along a dimension.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Src { float64_t src_data[]; };
layout(binding = 1) buffer Index { int idx_data[]; };
layout(binding = 2) buffer Output { uint64_t out_data[]; };   // uint64_t for CAS atomics

// Per-dim decode (matches CPU scatter_add_kernel): decode the flat index
// position with the INDEX tensor's contiguous strides, recompose onto SELF
// strides (index value substitutes the coord on the scatter dim).
layout(push_constant) uniform PushConstants {
    uint n;                 // index.numel()
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

// Bit-cast helpers
float64_t bitsToF64(uint64_t bits) {
    return float64_t(packDouble2x32(uvec2(uint(bits), uint(bits >> 32u))));
}

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

void atomicAddF64(uint idx, float64_t val) {
    uint64_t old_bits = out_data[idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float64_t old_val = bitsToF64(old_bits);
        uint64_t new_bits = f64ToBits(old_val + val);
        uint64_t result = atomicCompSwap(out_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    int dest_dim_idx = idx_data[i];
    // Normalize negative indices like the CPU reference (idx += dim_size) before the
    // bounds check, so a valid negative index wraps instead of being silently dropped.
    if (dest_dim_idx < 0) dest_dim_idx += int(params.dim_size);

    if (dest_dim_idx < 0 || dest_dim_idx >= int(params.dim_size)) return;

    uint temp = i;
    uint out_idx = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_idx += uint(dest_dim_idx) * selfStride(d);
        } else {
            out_idx += coord * selfStride(d);
        }
    }

    atomicAddF64(out_idx, src_data[i]);
}
