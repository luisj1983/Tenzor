#version 450

// Bilinear Interpolation Forward Pass
// Resizes input tensor to target size using bilinear interpolation
// Input shape: (N, C, H_in, W_in)
// Output shape: (N, C, H_out, W_out)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Total output elements
    uint batch;          // N
    uint channels;       // C
    uint in_height;      // H_in
    uint in_width;       // W_in
    uint out_height;     // H_out
    uint out_width;      // W_out
    uint align_corners;  // 1 if align_corners, 0 otherwise
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Compute source coordinates
    float h_real, w_real;
    if (params.align_corners != 0 && params.out_height > 1) {
        h_real = float(h_out) * float(params.in_height - 1) / float(params.out_height - 1);
    } else {
        h_real = (float(h_out) + 0.5) * float(params.in_height) / float(params.out_height) - 0.5;
    }

    if (params.align_corners != 0 && params.out_width > 1) {
        w_real = float(w_out) * float(params.in_width - 1) / float(params.out_width - 1);
    } else {
        w_real = (float(w_out) + 0.5) * float(params.in_width) / float(params.out_width) - 0.5;
    }

    // Clamp to valid range
    h_real = max(0.0, min(h_real, float(params.in_height - 1)));
    w_real = max(0.0, min(w_real, float(params.in_width - 1)));

    // Compute integer coordinates and fractional parts
    uint h0 = uint(floor(h_real));
    uint w0 = uint(floor(w_real));
    uint h1 = min(h0 + 1, params.in_height - 1);
    uint w1 = min(w0 + 1, params.in_width - 1);

    float h_frac = h_real - float(h0);
    float w_frac = w_real - float(w0);

    // Compute input base offset for (n, c)
    uint base = n * params.channels * params.in_height * params.in_width +
                c * params.in_height * params.in_width;

    // Bilinear interpolation
    float v00 = input_data[base + h0 * params.in_width + w0];
    float v01 = input_data[base + h0 * params.in_width + w1];
    float v10 = input_data[base + h1 * params.in_width + w0];
    float v11 = input_data[base + h1 * params.in_width + w1];

    float result = v00 * (1.0 - h_frac) * (1.0 - w_frac) +
                   v01 * (1.0 - h_frac) * w_frac +
                   v10 * h_frac * (1.0 - w_frac) +
                   v11 * h_frac * w_frac;

    output_data[idx] = result;
}
