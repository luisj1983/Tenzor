#version 450
#extension GL_EXT_shader_atomic_float : enable

// Batch Normalization 2D - Compute Mean and Variance
// Computes running mean and variance across batch and spatial dimensions
//
// Input shape: (N, C, H, W)
// Output shapes: mean (C), variance (C)
//
// For each channel c:
// mean[c] = sum(input[n, c, h, w]) / (N * H * W)
// var[c] = sum((input[n, c, h, w] - mean[c])^2) / (N * H * W)

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };      // (N, C, H, W)
layout(binding = 1) buffer Mean { float mean_data[]; };        // (C) - output
layout(binding = 2) buffer Variance { float var_data[]; };     // (C) - output
layout(binding = 3) buffer TempSum { float temp_sum[]; };      // (C) - temporary for two-pass algorithm

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Total elements (N * C * H * W)
    uint batch;          // N
    uint channels;       // C
    uint spatial_size;   // H * W
    uint pass_id;        // 0 = compute mean, 1 = compute variance
} params;

// Direct per-channel global atomic add. A prior version used a shared-memory
// workgroup aggregation indexed by (c % 256), which aliases channels ≥ 256 onto
// the same slot and corrupts the reduction at any C > 256. The F16 variant of
// this shader already does the direct-atomic approach; keep parity here.

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Decode flat index to (b, c, h, w)
    uint temp = idx;
    uint w = temp % params.spatial_size;
    temp /= params.spatial_size;
    uint c = temp % params.channels;

    float value = input_data[idx];

    if (params.pass_id == 0) {
        atomicAdd(temp_sum[c], value);
    } else {
        float mean = mean_data[c];
        float diff = value - mean;
        atomicAdd(var_data[c], diff * diff);
    }
}
