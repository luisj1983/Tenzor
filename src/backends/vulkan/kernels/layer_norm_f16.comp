#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Layer Normalization for Float16
// Float16 elements are packed 2 per 32-bit word
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };
layout(binding = 2) buffer Gamma { uint gamma_data[]; };    // Optional affine parameter (packed f16)
layout(binding = 3) buffer Beta { uint beta_data[]; };      // Optional affine parameter (packed f16)

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint normalized_shape;  // Size of dimensions to normalize over
    float epsilon;
    uint affine;           // 0=no affine, 1=with affine
} params;

shared float shared_sum[256];
shared float shared_sum_sq[256];

// Helper to read float16 from input
float16_t readInput(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

// Helper to read float16 from gamma
float16_t readGamma(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = gamma_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

// Helper to read float16 from beta
float16_t readBeta(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = beta_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

// Helper to write float16 to output
void writeOutput(uint element_idx, float16_t val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = packHalf2x16(vec2(float(val), 0.0)).x & 0xFFFFu;

    if (word_offset == 0) {
        uint existing = output_data[word_idx];
        output_data[word_idx] = (existing & 0xFFFF0000u) | bits;
    } else {
        uint existing = output_data[word_idx];
        output_data[word_idx] = (existing & 0x0000FFFFu) | (bits << 16);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.normalized_shape;

    // Step 1: Compute mean (use float for accumulation)
    float local_sum = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        local_sum += float(readInput(base_idx + i));
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    float mean = shared_sum[0] / float(params.normalized_shape);
    barrier();

    // Step 2: Compute variance
    float local_sum_sq = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        float val = float(readInput(base_idx + i));
        float diff = val - mean;
        local_sum_sq += diff * diff;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    // Parallel reduction for sum of squares
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    float variance = shared_sum_sq[0] / float(params.normalized_shape);
    float inv_std = 1.0 / sqrt(variance + params.epsilon);
    barrier();

    // Step 3: Normalize and apply affine transformation
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        float val = float(readInput(base_idx + i));
        float normalized = (val - mean) * inv_std;

        if (params.affine > 0) {
            float gamma = float(readGamma(i));
            float beta = float(readBeta(i));
            normalized = normalized * gamma + beta;
        }

        writeOutput(base_idx + i, float16_t(normalized));
    }
}
