#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Layer Normalization for Float16
// Float16 elements are packed 2 per 32-bit word
// Uses paired writes to avoid race conditions
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };
layout(binding = 2) buffer Gamma { uint gamma_data[]; };    // Optional affine parameter (packed f16)
layout(binding = 3) buffer Beta { uint beta_data[]; };      // Optional affine parameter (packed f16)

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint normalized_shape;  // Size of dimensions to normalize over
    float epsilon;
    uint affine;           // 0=no affine, 1=with affine
} params;

shared float shared_sum[256];
shared float shared_sum_sq[256];

// Helper to read float16 from buffer at element index
float readF16(uint buffer_idx, uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed;
    if (buffer_idx == 0) {
        packed = input_data[word_idx];
    } else if (buffer_idx == 2) {
        packed = gamma_data[word_idx];
    } else {
        packed = beta_data[word_idx];
    }
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Helper to pack two float16 values
uint packF16Pair(float v0, float v1) {
    uint bits0 = packHalf2x16(vec2(v0, 0.0)).x & 0xFFFFu;
    uint bits1 = packHalf2x16(vec2(v1, 0.0)).x & 0xFFFFu;
    return bits0 | (bits1 << 16);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.normalized_shape;

    // Step 1: Compute mean (use float for accumulation)
    float local_sum = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        local_sum += readF16(0, base_idx + i);
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    float mean = shared_sum[0] / float(params.normalized_shape);
    barrier();

    // Step 2: Compute variance
    float local_sum_sq = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        float val = readF16(0, base_idx + i);
        float diff = val - mean;
        local_sum_sq += diff * diff;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    // Parallel reduction for sum of squares
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    float variance = shared_sum_sq[0] / float(params.normalized_shape);
    float inv_std = 1.0 / sqrt(variance + params.epsilon);
    barrier();

    // Step 3: Normalize and write output as packed pairs
    // Each thread writes complete words (2 elements) to avoid race conditions
    uint num_words = (params.normalized_shape + 1) / 2;
    for (uint word_idx = tid; word_idx < num_words; word_idx += 256) {
        uint elem0 = word_idx * 2;
        uint elem1 = word_idx * 2 + 1;

        float val0, val1;

        // Process element 0
        if (elem0 < params.normalized_shape) {
            float input_val = readF16(0, base_idx + elem0);
            val0 = (input_val - mean) * inv_std;
            if (params.affine > 0) {
                float gamma = readF16(2, elem0);
                float beta = readF16(3, elem0);
                val0 = val0 * gamma + beta;
            }
        } else {
            val0 = 0.0;
        }

        // Process element 1
        if (elem1 < params.normalized_shape) {
            float input_val = readF16(0, base_idx + elem1);
            val1 = (input_val - mean) * inv_std;
            if (params.affine > 0) {
                float gamma = readF16(2, elem1);
                float beta = readF16(3, elem1);
                val1 = val1 * gamma + beta;
            }
        } else {
            val1 = 0.0;
        }

        // Write packed pair - no race condition since each thread owns its word
        output_data[(base_idx / 2) + word_idx] = packF16Pair(val0, val1);
    }
}
