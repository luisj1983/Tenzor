#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Bit-reversal permutation for FFT input/output reordering — Float16
// Each complex element is one uint32 word (real in low 16, imag in high 16)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;             // FFT size (power of 2)
    uint log2_n;        // log2(n)
    uint batch_size;    // Number of independent FFTs
    uint batch_stride;  // Stride between batches (in complex elements)
};

uint bit_reverse(uint x, uint bits) {
    uint result = 0;
    for (uint i = 0; i < bits; i++) {
        result = (result << 1) | (x & 1);
        x >>= 1;
    }
    return result;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total_items = n * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n;
    uint local_tid = tid % n;

    uint rev = bit_reverse(local_tid, log2_n);

    // Copy complex element from position local_tid to position rev
    // Each complex element = 1 uint32 word
    uint base = batch_idx * batch_stride;
    data_out[base + rev] = data_in[base + local_tid];
}
