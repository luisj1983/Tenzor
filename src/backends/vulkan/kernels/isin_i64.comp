#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Isin — set membership test, native Int64 variant.
// Compares int64 values directly instead of downcasting through Float32,
// which collides distinct Int32/Int64/UInt32/UInt64 values once their
// magnitude exceeds Float32's 24-bit exact-integer range (false-positive
// membership). Mirrors the CPU isin_kernel fix (advanced.cpp) that widens
// every integral dtype to Int64 for exact comparison.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Elements     { int64_t elements_data[]; };
layout(binding = 1) readonly buffer TestElements { int64_t test_data[]; };
layout(binding = 2) writeonly buffer Output      { uint8_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;      // number of elements to test
    uint num_test_elements; // size of the test set
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;

    int64_t val = elements_data[idx];
    uint8_t found = uint8_t(0);

    for (uint i = 0; i < params.num_test_elements; i++) {
        if (val == test_data[i]) {
            found = uint8_t(1);
            break;
        }
    }

    output_data[idx] = found;
}
