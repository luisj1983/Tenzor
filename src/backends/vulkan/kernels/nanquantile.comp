#version 450

// Nanquantile — NaN-ignoring quantile along a dimension
// Each invocation handles one slice. Compacts non-NaN values,
// sorts them, then performs linear interpolation.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input  { float input_data[]; };
layout(binding = 1) writeonly buffer Output { float output_data[]; };
layout(binding = 2)          buffer Scratch { float scratch_data[]; };

layout(push_constant) uniform PushConstants {
    uint total_slices;
    uint dim_size;
    uint inner_size;
    float q;
} params;

void main() {
    uint slice_idx = gl_GlobalInvocationID.x;
    if (slice_idx >= params.total_slices) return;

    uint outer_idx = slice_idx / params.inner_size;
    uint inner_idx = slice_idx % params.inner_size;
    uint base = outer_idx * params.dim_size * params.inner_size + inner_idx;

    // Copy non-NaN values into scratch
    uint scratch_base = slice_idx * params.dim_size;
    uint count = 0;
    for (uint i = 0; i < params.dim_size; i++) {
        float val = input_data[base + i * params.inner_size];
        if (!isnan(val)) {
            scratch_data[scratch_base + count] = val;
            count++;
        }
    }

    if (count == 0) {
        output_data[slice_idx] = 0.0 / 0.0; // NaN
        return;
    }

    // Insertion sort on compacted values
    for (uint i = 1; i < count; i++) {
        float key = scratch_data[scratch_base + i];
        int j = int(i) - 1;
        while (j >= 0 && scratch_data[scratch_base + uint(j)] > key) {
            scratch_data[scratch_base + uint(j) + 1] = scratch_data[scratch_base + uint(j)];
            j--;
        }
        scratch_data[scratch_base + uint(j) + 1] = key;
    }

    // Linear interpolation
    float pos = params.q * float(count - 1);
    uint lo = uint(pos);
    uint hi = min(lo + 1, count - 1);
    float frac = pos - float(lo);

    output_data[slice_idx] = scratch_data[scratch_base + lo] * (1.0 - frac)
                           + scratch_data[scratch_base + hi] * frac;
}
