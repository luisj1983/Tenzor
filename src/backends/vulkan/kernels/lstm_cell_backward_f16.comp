#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// LSTM Cell backward compute shader for Float16 -- computes gradients for one timestep
// Recomputes forward gate activations from saved pre-activation gates, then
// backpropagates through the LSTM equations.
//
// Inputs:
//   binding 0: grad_h -- gradient of hidden state [batch, hidden]
//   binding 1: grad_c_next -- gradient of cell state from next step [batch, hidden]
//   binding 2: gates -- pre-activation combined gates [batch, 4*hidden]
//   binding 3: c_prev -- previous cell state [batch, hidden]
//   binding 4: c_out -- output cell state (from forward) [batch, hidden]
// Outputs:
//   binding 5: grad_gates -- gradient w.r.t. gates [batch, 4*hidden]
//   binding 6: grad_c_prev -- gradient w.r.t. c_prev [batch, hidden]
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradH     { uint grad_h[]; };      // Packed F16
layout(binding = 1) buffer GradCNext { uint grad_c_next[]; }; // Packed F16
layout(binding = 2) buffer Gates     { uint gates[]; };        // Packed F16
layout(binding = 3) buffer CPrev     { uint c_prev[]; };       // Packed F16
layout(binding = 4) buffer COut      { uint c_out[]; };        // Packed F16
layout(binding = 5) buffer GradGates { uint grad_gates[]; };   // Packed F16
layout(binding = 6) buffer GradCPrev { uint grad_c_prev[]; };  // Packed F16

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint hidden_size;
} params;

float readF16(uint buf_idx, uint idx) {
    // We can't index by buffer id at runtime, so use per-buffer readers below
    return 0.0;
}

float readF16GradH(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = grad_h[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readF16GradCNext(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = grad_c_next[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readF16Gates(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = gates[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readF16CPrev(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = c_prev[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readF16COut(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = c_out[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

void writeF16GradGates(uint idx, float val) {
    // Adjacent elements share a 32-bit word (two packed F16 lanes); a plain
    // read-modify-write races with the neighbouring lane's writer and loses
    // updates. Use a bounded atomicCompSwap masked write so each lane is
    // updated without clobbering its partner.
    uint word_idx = idx >> 1u;
    uint shift = (idx & 1u) * 16u;
    uint mask = 0xFFFFu << shift;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;

    uint old_val = grad_gates[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(grad_gates[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT add a non-atomic fallback store, it would clobber
    // the neighbouring packed half-word.
}

void writeF16GradCPrev(uint idx, float val) {
    // See writeF16GradGates: adjacent global indices idx and idx+1 share a
    // word, so the store must be a collision-safe masked atomicCompSwap.
    uint word_idx = idx >> 1u;
    uint shift = (idx & 1u) * 16u;
    uint mask = 0xFFFFu << shift;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;

    uint old_val = grad_c_prev[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(grad_c_prev[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT add a non-atomic fallback store, it would clobber
    // the neighbouring packed half-word.
}

float sigmoid(float x) {
    return 1.0 / (1.0 + exp(-x));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch_size * params.hidden_size;

    if (idx >= total) return;

    uint b = idx / params.hidden_size;
    uint h = idx % params.hidden_size;

    uint H = params.hidden_size;
    uint gate_base = b * (4 * H);

    // Indices into the gate array: [i | f | g | o]
    uint i_idx = gate_base + h;
    uint f_idx = gate_base + H + h;
    uint g_idx = gate_base + 2 * H + h;
    uint o_idx = gate_base + 3 * H + h;

    // ---- Recompute forward gate activations ----
    float i_gate = sigmoid(readF16Gates(i_idx));
    float f_gate = sigmoid(readF16Gates(f_idx));
    float g_gate = tanh(readF16Gates(g_idx));
    float o_gate = sigmoid(readF16Gates(o_idx));

    float tanh_c = tanh(readF16COut(idx));

    // ---- Backward through h_out = o * tanh(c_out) ----
    float dh = readF16GradH(idx);
    float d_o = dh * tanh_c;
    float dc = dh * o_gate * (1.0 - tanh_c * tanh_c) + readF16GradCNext(idx);

    // ---- Backward through c_out = f * c_prev + i * g ----
    float d_f = dc * readF16CPrev(idx);
    float d_i = dc * g_gate;
    float d_g = dc * i_gate;
    float dc_prev = dc * f_gate;

    // ---- Gate gradients (through sigmoid/tanh nonlinearities) ----
    float di_gate = d_i * i_gate * (1.0 - i_gate);
    float df_gate = d_f * f_gate * (1.0 - f_gate);
    float dg_gate = d_g * (1.0 - g_gate * g_gate);
    float do_gate = d_o * o_gate * (1.0 - o_gate);

    // ---- Write grad_gates: [di_gate, df_gate, dg_gate, do_gate] ----
    writeF16GradGates(i_idx, di_gate);
    writeF16GradGates(f_idx, df_gate);
    writeF16GradGates(g_idx, dg_gate);
    writeF16GradGates(o_idx, do_gate);

    // ---- Write grad_c_prev ----
    writeF16GradCPrev(idx, dc_prev);
}
