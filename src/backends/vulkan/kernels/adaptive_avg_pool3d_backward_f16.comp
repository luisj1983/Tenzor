#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Adaptive Average Pool 3D Backward (Float16).
// Float16 doesn't support atomic add, so each thread handles one INPUT position
// and accumulates contributions from every output window that covers it.
// Adjacent input elements share a packed uint32 word, so the final write uses
// atomicCompSwap to avoid clobbering the neighbouring half-word.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };  // Packed float16 (2 per uint)
layout(binding = 1) buffer GradInput { uint grad_input[]; };    // Packed float16 (2 per uint)

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint D_in;
    uint H_in;
    uint W_in;
    uint D_out;
    uint H_out;
    uint W_out;
} params;

float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = (grad_output[word_idx] >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint new_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint shift = word_offset * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = grad_input[word_idx];
    for (uint iter = 0u; iter < 65536u; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_input = params.batch * params.channels * params.D_in * params.H_in * params.W_in;
    if (idx >= total_input) return;

    uint w_in = idx % params.W_in;
    uint h_in = (idx / params.W_in) % params.H_in;
    uint d_in = (idx / (params.W_in * params.H_in)) % params.D_in;
    uint c = (idx / (params.W_in * params.H_in * params.D_in)) % params.channels;
    uint n = idx / (params.W_in * params.H_in * params.D_in * params.channels);

    float grad_sum = 0.0;

    for (uint d_out = 0; d_out < params.D_out; ++d_out) {
        uint d_start = (d_out * params.D_in) / params.D_out;
        uint d_end = ((d_out + 1) * params.D_in) / params.D_out;
        if (d_in < d_start || d_in >= d_end) continue;
        for (uint h_out = 0; h_out < params.H_out; ++h_out) {
            uint h_start = (h_out * params.H_in) / params.H_out;
            uint h_end = ((h_out + 1) * params.H_in) / params.H_out;
            if (h_in < h_start || h_in >= h_end) continue;
            for (uint w_out = 0; w_out < params.W_out; ++w_out) {
                uint w_start = (w_out * params.W_in) / params.W_out;
                uint w_end = ((w_out + 1) * params.W_in) / params.W_out;
                if (w_in < w_start || w_in >= w_end) continue;
                uint count = (d_end - d_start) * (h_end - h_start) * (w_end - w_start);
                if (count > 0u) {
                    uint out_idx = (((n * params.channels + c) * params.D_out + d_out) * params.H_out + h_out) * params.W_out + w_out;
                    grad_sum += readF16(out_idx) / float(count);
                }
            }
        }
    }

    writeF16(idx, grad_sum);
}
