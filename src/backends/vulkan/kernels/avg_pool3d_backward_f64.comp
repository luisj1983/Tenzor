#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Average Pooling 3D Backward Pass - Float64 variant
// Input-centric gather pattern: one thread per input element, no atomics needed.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { double grad_output[]; };
layout(binding = 1) buffer GradInput { double grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch_channels;
    uint in_depth;
    uint in_height;
    uint in_width;
    uint out_depth;
    uint out_height;
    uint out_width;
    uint kernel_d;
    uint kernel_h;
    uint kernel_w;
    uint stride_d;
    uint stride_h;
    uint stride_w;
    uint padding_d;
    uint padding_h;
    uint padding_w;
    uint count_include_pad;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Decode flat index to (bc, d_in, h_in, w_in) - now over INPUT elements
    uint temp = idx;
    uint w_in = temp % params.in_width;
    temp /= params.in_width;
    uint h_in = temp % params.in_height;
    temp /= params.in_height;
    uint d_in = temp % params.in_depth;
    uint bc = temp / params.in_depth;

    // Which output positions have pooling windows that cover (d_in, h_in, w_in)?

    // Depth dimension
    int num_d = int(d_in) + int(params.padding_d) - int(params.kernel_d) + 1;
    int d_out_min;
    if (num_d <= 0) {
        d_out_min = 0;
    } else {
        d_out_min = (num_d + int(params.stride_d) - 1) / int(params.stride_d);
    }
    int d_out_max = min((int(d_in) + int(params.padding_d)) / int(params.stride_d),
                        int(params.out_depth) - 1);

    // Height dimension
    int num_h = int(h_in) + int(params.padding_h) - int(params.kernel_h) + 1;
    int h_out_min;
    if (num_h <= 0) {
        h_out_min = 0;
    } else {
        h_out_min = (num_h + int(params.stride_h) - 1) / int(params.stride_h);
    }
    int h_out_max = min((int(h_in) + int(params.padding_h)) / int(params.stride_h),
                        int(params.out_height) - 1);

    // Width dimension
    int num_w = int(w_in) + int(params.padding_w) - int(params.kernel_w) + 1;
    int w_out_min;
    if (num_w <= 0) {
        w_out_min = 0;
    } else {
        w_out_min = (num_w + int(params.stride_w) - 1) / int(params.stride_w);
    }
    int w_out_max = min((int(w_in) + int(params.padding_w)) / int(params.stride_w),
                        int(params.out_width) - 1);

    uint in_spatial = params.in_depth * params.in_height * params.in_width;
    uint out_spatial = params.out_depth * params.out_height * params.out_width;

    double sum = 0.0lf;

    for (int d_out = d_out_min; d_out <= d_out_max; d_out++) {
        int d_start = d_out * int(params.stride_d) - int(params.padding_d);

        for (int h_out = h_out_min; h_out <= h_out_max; h_out++) {
            int h_start = h_out * int(params.stride_h) - int(params.padding_h);

            for (int w_out = w_out_min; w_out <= w_out_max; w_out++) {
                int w_start = w_out * int(params.stride_w) - int(params.padding_w);

                // Compute pool count for this output position
                uint count = 0;
                if (params.count_include_pad != 0) {
                    count = params.kernel_d * params.kernel_h * params.kernel_w;
                } else {
                    for (uint kd = 0; kd < params.kernel_d; kd++) {
                        int pd = d_start + int(kd);
                        if (pd < 0 || pd >= int(params.in_depth)) continue;
                        for (uint kh = 0; kh < params.kernel_h; kh++) {
                            int ph = h_start + int(kh);
                            if (ph < 0 || ph >= int(params.in_height)) continue;
                            for (uint kw = 0; kw < params.kernel_w; kw++) {
                                int pw = w_start + int(kw);
                                if (pw >= 0 && pw < int(params.in_width)) {
                                    count++;
                                }
                            }
                        }
                    }
                }

                if (count > 0) {
                    uint out_idx = bc * out_spatial +
                                  uint(d_out) * params.out_height * params.out_width +
                                  uint(h_out) * params.out_width +
                                  uint(w_out);
                    sum += grad_output[out_idx] / double(count);
                }
            }
        }
    }

    grad_input[idx] = sum;
}
