#version 450
#extension GL_EXT_shader_atomic_float : enable

// Batch Normalization backward pass
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer GradOutput { float grad_output[]; };
layout(binding = 2) buffer Mean { float mean_data[]; };
layout(binding = 3) buffer Variance { float var_data[]; };
layout(binding = 4) buffer Gamma { float gamma_data[]; };
layout(binding = 5) buffer GradInput { float grad_input[]; };
layout(binding = 6) buffer GradGamma { float grad_gamma[]; };
layout(binding = 7) buffer GradBeta { float grad_beta[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint height;
    uint width;
    float epsilon;
    uint affine; // 0=no affine, 1=with affine
} params;

shared float shared_grad_gamma[256];
shared float shared_grad_beta[256];

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;
    uint total = params.batch * params.channels * params.height * params.width;
    uint spatial_size = params.height * params.width;
    uint batch_size = params.batch * spatial_size;

    // Initialize shared memory
    if (tid < params.channels) {
        shared_grad_gamma[tid] = 0.0;
        shared_grad_beta[tid] = 0.0;
    }
    barrier();

    if (idx >= total) {
        return;
    }

    // Calculate channel index
    uint c = (idx / spatial_size) % params.channels;

    float x = input_data[idx];
    float grad_out = grad_output[idx];
    float mean = mean_data[c];
    float variance = var_data[c];
    float inv_std = 1.0 / sqrt(variance + params.epsilon);

    // Normalized input
    float x_hat = (x - mean) * inv_std;

    // Compute gradients for affine parameters
    if (params.affine > 0 && tid < params.channels) {
        atomicAdd(shared_grad_gamma[c], grad_out * x_hat);
        atomicAdd(shared_grad_beta[c], grad_out);
    }
    barrier();

    // Write affine parameter gradients
    if (params.affine > 0 && tid < params.channels) {
        atomicAdd(grad_gamma[tid], shared_grad_gamma[tid]);
        atomicAdd(grad_beta[tid], shared_grad_beta[tid]);
    }

    // Compute input gradient
    float grad_x_hat = grad_out;
    if (params.affine > 0) {
        grad_x_hat *= gamma_data[c];
    }

    // Gradient through normalization
    // dx = (1/N) * inv_std * (N * grad_x_hat - sum(grad_x_hat) - x_hat * sum(grad_x_hat * x_hat))
    // Simplified version for now (exact version requires multiple passes)
    float grad_in = grad_x_hat * inv_std;

    grad_input[idx] = grad_in;
}
