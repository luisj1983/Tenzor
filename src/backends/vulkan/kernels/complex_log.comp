#version 450

// Complex64 log: log(a+bi) = log(hypot(a,b)) + i*atan2(b, a)

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { float data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;
    float a = data_in[idx * 2u];
    float b = data_in[idx * 2u + 1u];
    // Scale-free magnitude for numerical stability.
    float ar = abs(a);
    float ai = abs(b);
    float m = max(ar, ai);
    float mag = (m == 0.0) ? 0.0 : m * sqrt((ar / m) * (ar / m) + (ai / m) * (ai / m));
    data_out[idx * 2u]      = log(mag);
    data_out[idx * 2u + 1u] = atan(b, a);  // GLSL atan(y, x) is atan2
}
