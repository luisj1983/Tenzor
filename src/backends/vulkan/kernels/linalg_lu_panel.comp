#version 450

// Blocked LU Panel Factorization — factorizes a single 32-column panel
// Input: A[n x n] stored row-major. This kernel factorizes columns [col_start, col_start+32)
// using partial pivoting within the panel, then applies row swaps to the full matrix.
// One workgroup with 256 threads.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Matrix { float A[]; };
layout(set = 0, binding = 1) buffer PivotBuf { int pivots[]; };  // pivot indices output

layout(push_constant) uniform PushConstants {
    uint n;          // matrix dimension
    uint col_start;  // starting column of this panel
    uint panel_cols; // number of columns in this panel (min(32, n - col_start))
    uint batch_idx;  // batch element index
};

shared float panel[256][32];  // rows of current panel (max 256 rows)
shared float max_val;
shared uint max_row;
shared int pivot_idx;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = batch_idx * n * n;

    // Load panel columns into shared memory
    uint panel_rows = n - col_start;
    for (uint r = tid; r < panel_rows; r += 256) {
        for (uint c = 0; c < panel_cols; c++) {
            panel[r][c] = A[base + (col_start + r) * n + (col_start + c)];
        }
    }
    barrier();

    // Factor each column with partial pivoting
    for (uint k = 0; k < panel_cols; k++) {
        // Find pivot (max abs in column k, rows k..panel_rows)
        if (tid == 0) {
            max_val = 0.0;
            max_row = k;
            for (uint r = k; r < panel_rows; r++) {
                float v = abs(panel[r][k]);
                if (v > max_val) {
                    max_val = v;
                    max_row = r;
                }
            }
            pivot_idx = int(col_start + max_row);
        }
        barrier();

        // Store pivot
        if (tid == 0) {
            pivots[col_start + k] = pivot_idx;
        }

        // Swap rows k and max_row in the panel
        if (max_row != k) {
            for (uint c = tid; c < panel_cols; c += 256) {
                float tmp = panel[k][c];
                panel[k][c] = panel[max_row][c];
                panel[max_row][c] = tmp;
            }
            // Also swap in the full matrix (left of panel)
            for (uint c = tid; c < col_start; c += 256) {
                uint row_k = base + (col_start + k) * n + c;
                uint row_m = base + (col_start + max_row) * n + c;
                float tmp = A[row_k];
                A[row_k] = A[row_m];
                A[row_m] = tmp;
            }
            // Swap in the full matrix (right of panel)
            for (uint c = col_start + panel_cols + tid; c < n; c += 256) {
                uint row_k = base + (col_start + k) * n + c;
                uint row_m = base + (col_start + max_row) * n + c;
                float tmp = A[row_k];
                A[row_k] = A[row_m];
                A[row_m] = tmp;
            }
        }
        barrier();

        // Compute multipliers and eliminate
        float diag = panel[k][k];
        if (abs(diag) < 1e-30) {
            barrier();
            continue;
        }
        float inv_diag = 1.0 / diag;

        for (uint r = k + 1 + tid; r < panel_rows; r += 256) {
            float mult = panel[r][k] * inv_diag;
            panel[r][k] = mult;  // Store L factor in-place
            for (uint c = k + 1; c < panel_cols; c++) {
                panel[r][c] -= mult * panel[k][c];
            }
        }
        barrier();
    }

    // Write panel back to global memory
    for (uint r = tid; r < panel_rows; r += 256) {
        for (uint c = 0; c < panel_cols; c++) {
            A[base + (col_start + r) * n + (col_start + c)] = panel[r][c];
        }
    }
}
