#version 450

// Bitwise left shift (int32): output[i] = a[i] << b[i]
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputA { int data[]; } a_buf;
layout(set = 0, binding = 1) readonly buffer InputB { int data[]; } b_buf;
layout(set = 0, binding = 2) writeonly buffer OutputBuffer { int data[]; } output_buf;

layout(push_constant) uniform PushConstants { uint num_elements; } pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    // Shift amounts outside [0, 32) are GLSL-spec-undefined; guard explicitly
    // to match CPU/CUDA's defined out-of-range semantics (result is 0).
    int a = a_buf.data[idx];
    int b = b_buf.data[idx];
    output_buf.data[idx] = (b < 0 || b >= 32) ? 0 : int(uint(a) << uint(b));
}
