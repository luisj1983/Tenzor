#version 450

// Normal sampling: out[i] = mean[i] + std[i] * z, where z ~ N(0,1)
// Uses Box-Muller transform with per-invocation LCG PRNG.
// Float32 only — host promotes other dtypes via dispatchCast.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer MeanBuf   { float mean_data[]; };
layout(binding = 1) buffer StdBuf    { float std_data[];  };
layout(binding = 2) buffer OutputBuf { float out_data[];  };

layout(push_constant) uniform PushConstants {
    uint n;
    uint seed_lo;
    uint seed_hi;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;

    // Per-invocation LCG state (same seeding as bernoulli.comp)
    uint state = params.seed_lo ^ (params.seed_hi * 0x9E3779B9u) ^ (idx * 0x85EBCA77u);

    // Generate two uniform random numbers for Box-Muller
    state = state * 1664525u + 1013904223u;
    float u1 = float(state) / 4294967295.0;
    u1 = max(u1, 1.0e-7);  // Clamp away from zero for log safety

    state = state * 1664525u + 1013904223u;
    float u2 = float(state) / 4294967295.0;

    // Box-Muller transform
    float z = sqrt(-2.0 * log(u1)) * cos(2.0 * 3.14159265358979323846 * u2);

    out_data[idx] = mean_data[idx] + std_data[idx] * z;
}
