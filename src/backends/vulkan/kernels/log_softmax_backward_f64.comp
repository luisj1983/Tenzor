#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Log softmax backward for Float64: grad_input = grad_output - exp(output) * sum(grad_output)
// This requires reduction along a dimension

layout(local_size_x = 256) in;

layout(binding = 0) buffer GradOutput { double grad_output[]; };
layout(binding = 1) buffer OutputBuffer { double output_data[]; };  // log_softmax output
layout(binding = 2) buffer GradInput { double grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint outer_size;   // Product of dimensions before reduction dim
    uint dim_size;     // Size of the reduction dimension
    uint inner_size;   // Product of dimensions after reduction dim
} params;

// Double-precision exp using range reduction
double exp_d(double x) {
    if (x != x) return x;  // NaN
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;

    // Range reduction: exp(x) = 2^k * exp(r)
    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));

    // exp(r) via degree-13 Taylor polynomial (Horner's method)
    // |r| <= ln(2)/2, error bound < r^14/14! < 1e-19
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0 +
        r * (1.0/6227020800.0)))))))))))));

    // Compute 2^|k| via binary exponentiation
    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) pow2 *= base;
        base *= base;
        abs_k >>= 1;
    }

    return (k >= 0) ? (exp_r * pow2) : (exp_r / pow2);
}

void main() {
    // Each thread handles one (outer, inner) position
    uint global_idx = gl_GlobalInvocationID.x;
    uint total_threads = params.outer_size * params.inner_size;

    if (global_idx >= total_threads) {
        return;
    }

    uint outer_idx = global_idx / params.inner_size;
    uint inner_idx = global_idx % params.inner_size;
    uint offset = (outer_idx * params.dim_size * params.inner_size) + inner_idx;

    // Compute sum of gradients along dimension
    double sum_grad = 0.0;
    for (uint d = 0; d < params.dim_size; ++d) {
        uint idx = offset + d * params.inner_size;
        sum_grad += grad_output[idx];
    }

    // Compute gradient: grad_output - exp(log_softmax) * sum_grad
    for (uint d = 0; d < params.dim_size; ++d) {
        uint idx = offset + d * params.inner_size;
        grad_input[idx] = grad_output[idx] - exp_d(output_data[idx]) * sum_grad;
    }
}
