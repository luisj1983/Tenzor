#version 450

// Stockham mixed-radix FFT: radix-3 butterfly stage
// Data layout: interleaved real/imag pairs
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { float data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;             // Total FFT size
    uint stage_stride;  // Stride for this stage (product of previous radices)
    uint direction;     // 0 = forward, 1 = inverse
    uint batch_size;    // Number of independent FFTs
    uint batch_stride;  // Stride between batches (in complex elements)
};

const float PI = 3.14159265358979323846;
const float HALF_PI = 1.57079632679489661923;
// W3 = exp(-2*pi*i/3): cos(2pi/3) = -0.5, sin(2pi/3) = sqrt(3)/2
const float COS_2PI_3 = -0.5;
const float SIN_2PI_3 = 0.86602540378443864676;

// Compute cos(2*PI*frac) and sin(2*PI*frac) for frac in [0, 1) (one full turn).
// GLSL cos/sin only guarantee ~2^-11 absolute accuracy outside [-PI/2, PI/2],
// so reduce the angle into the first quadrant [0, PI/2] and rebuild cos/sin by
// quadrant (matching the radix-2 kernel fft.comp). The radix-3 twiddle angles
// reach up to ~4*PI/3, well past PI/2, so this reduction is required for parity.
void cos_sin_turn(float frac, out float c, out float s) {
    // Wrap into [0, 1) defensively, then into one of four quadrants.
    frac = frac - floor(frac);          // [0, 1)
    float q = frac * 4.0;               // [0, 4)
    uint quadrant = uint(q);            // 0,1,2,3
    float r = (q - float(quadrant)) * HALF_PI; // angle within quadrant, [0, PI/2)
    float cr = cos(r);
    float sr = sin(r);
    if (quadrant == 0u) {        // [0, PI/2)
        c =  cr; s =  sr;
    } else if (quadrant == 1u) { // [PI/2, PI)
        c = -sr; s =  cr;
    } else if (quadrant == 2u) { // [PI, 3PI/2)
        c = -cr; s = -sr;
    } else {                     // [3PI/2, 2PI)
        c =  sr; s = -cr;
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 3;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    uint group = local_tid / stage_stride;
    uint pos = local_tid % stage_stride;

    uint i0 = group * stage_stride * 3 + pos;
    uint i1 = i0 + stage_stride;
    uint i2 = i1 + stage_stride;

    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;
    uint o2 = o1 + n_butterflies;

    // Apply batch stride
    uint base = batch_idx * batch_stride;
    uint b0_in = (base + i0) * 2;
    uint b1_in = (base + i1) * 2;
    uint b2_in = (base + i2) * 2;
    uint b0_out = (base + o0) * 2;
    uint b1_out = (base + o1) * 2;
    uint b2_out = (base + o2) * 2;

    // Load
    float a0_re = data_in[b0_in], a0_im = data_in[b0_in + 1];
    float a1_re = data_in[b1_in], a1_im = data_in[b1_in + 1];
    float a2_re = data_in[b2_in], a2_im = data_in[b2_in + 1];

    // Twiddle factors for positions 1 and 2.
    // angle1 = -2*PI*pos/(stage_stride*3) for forward (negated for inverse),
    // angle2 = 2*angle1. Build cos/sin via quadrant reduction (cos even, sin odd)
    // so the trig argument stays in [0, PI/2] and matches radix-2 precision.
    float frac1 = float(pos) / float(stage_stride * 3); // [0, 1/3)
    float frac2 = 2.0 * frac1;                           // [0, 2/3)
    float c1, s1, c2, s2;
    cos_sin_turn(frac1, c1, s1); // cos(2*PI*frac1), sin(2*PI*frac1)
    cos_sin_turn(frac2, c2, s2);
    // Forward angle is -2*PI*frac (sin negated); inverse flips the sin sign back.
    float sin_sign = (direction == 1) ? 1.0 : -1.0;
    float w1_re = c1, w1_im = sin_sign * s1;
    float w2_re = c2, w2_im = sin_sign * s2;

    // Apply twiddle
    float t1_re = a1_re * w1_re - a1_im * w1_im;
    float t1_im = a1_re * w1_im + a1_im * w1_re;
    float t2_re = a2_re * w2_re - a2_im * w2_im;
    float t2_im = a2_re * w2_im + a2_im * w2_re;

    // 3-point DFT butterfly
    // X[0] = x0 + x1 + x2
    // X[1] = x0 + W3*x1 + W3^2*x2
    // X[2] = x0 + W3^2*x1 + W3*x2 (conjugate for real twiddles)
    float s1_re = t1_re + t2_re;
    float s1_im = t1_im + t2_im;
    float d1_re = t1_re - t2_re;
    float d1_im = t1_im - t2_im;

    data_out[b0_out]     = a0_re + s1_re;
    data_out[b0_out + 1] = a0_im + s1_im;
    data_out[b1_out]     = a0_re + COS_2PI_3 * s1_re - SIN_2PI_3 * d1_im;
    data_out[b1_out + 1] = a0_im + COS_2PI_3 * s1_im + SIN_2PI_3 * d1_re;
    data_out[b2_out]     = a0_re + COS_2PI_3 * s1_re + SIN_2PI_3 * d1_im;
    data_out[b2_out + 1] = a0_im + COS_2PI_3 * s1_im - SIN_2PI_3 * d1_re;
}
