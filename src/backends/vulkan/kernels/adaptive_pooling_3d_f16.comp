#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Adaptive pooling 3D for Float16
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };
layout(binding = 2) buffer Indices { int max_indices[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch_channels;
    uint in_depth;
    uint in_height;
    uint in_width;
    uint out_depth;
    uint out_height;
    uint out_width;
    uint pool_type;
} params;

float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;

    uint new_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint shift = word_offset * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_val = (old_val & ~mask) | (new_bits << shift);
        uint result = atomicCompSwap(output_data[word_idx], old_val, new_val);
        if (result == old_val) return;
        old_val = result;
    }
}

int start_index(int a, int b, int c) {
    return int(floor(float(a * c) / float(b)));
}

int end_index(int a, int b, int c) {
    // Floor end-index (integer division) to match the CPU adaptive-pooling
    // convention and Vulkan's floor-based backward; ceil-end diverged for
    // non-divisible shapes.
    return int((a + 1) * c) / int(b);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint d_out = temp % params.out_depth;
    uint bc = temp / params.out_depth;

    int d_start = start_index(int(d_out), int(params.out_depth), int(params.in_depth));
    int d_end = end_index(int(d_out), int(params.out_depth), int(params.in_depth));
    int h_start = start_index(int(h_out), int(params.out_height), int(params.in_height));
    int h_end = end_index(int(h_out), int(params.out_height), int(params.in_height));
    int w_start = start_index(int(w_out), int(params.out_width), int(params.in_width));
    int w_end = end_index(int(w_out), int(params.out_width), int(params.in_width));

    float result;
    int max_idx = -1;

    if (params.pool_type == 0) {
        result = -1.0 / 0.0;
    } else {
        result = 0.0;
    }

    uint count = 0;
    uint in_spatial = params.in_depth * params.in_height * params.in_width;

    for (int id = d_start; id < d_end; id++) {
        for (int ih = h_start; ih < h_end; ih++) {
            for (int iw = w_start; iw < w_end; iw++) {
                uint input_idx = bc * in_spatial +
                                uint(id) * params.in_height * params.in_width +
                                uint(ih) * params.in_width + uint(iw);
                float value = readF16(input_idx);

                if (params.pool_type == 0) {
                    if (value > result) {
                        result = value;
                        max_idx = int(input_idx);
                    }
                } else {
                    result += value;
                    count++;
                }
            }
        }
    }

    if (params.pool_type == 1 && count > 0) {
        result /= float(count);
    }

    writeF16(idx, result);
    if (params.pool_type == 0) {
        max_indices[idx] = max_idx;
    }
}
