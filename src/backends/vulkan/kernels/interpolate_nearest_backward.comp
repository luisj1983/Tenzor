#version 450
#extension GL_EXT_shader_atomic_float : enable

// M14 Vulkan: nearest-mode interpolate backward via atomic-float scatter.
// Mirrors the ROCm `interpolate_nearest_backward_kernel_hip` and CUDA
// `interpolate_nearest_backward_kernel` (Wave H4 / M11 fixes).
//
// PyTorch nearest forward: oh -> floor(oh * in_h / out_h). No half-pixel
// offset, no align_corners. The backward scatters each output pixel's
// gradient back to that single source input pixel.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, out_h, out_w)
layout(binding = 1) buffer GradInput  { float grad_input[]; };   // (N, C, in_h, in_w)

layout(push_constant) uniform PushConstants {
    uint n_elements;     // N * C * out_h * out_w
    uint batch;
    uint channels;
    uint in_h;
    uint in_w;
    uint out_h;
    uint out_w;
    uint align_corners;  // ignored — nearest mode doesn't use it; field
                         // present so the host can share the bilinear struct
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint ow = temp % params.out_w; temp /= params.out_w;
    uint oh = temp % params.out_h; temp /= params.out_h;
    uint c  = temp % params.channels; temp /= params.channels;
    uint b  = temp;

    uint y = (oh * params.in_h) / params.out_h;
    uint x = (ow * params.in_w) / params.out_w;
    if (y > params.in_h - 1u) y = params.in_h - 1u;
    if (x > params.in_w - 1u) x = params.in_w - 1u;

    uint base_idx = b * (params.channels * params.in_h * params.in_w)
                  + c * (params.in_h * params.in_w);
    atomicAdd(grad_input[base_idx + y * params.in_w + x], grad_output[idx]);
}
