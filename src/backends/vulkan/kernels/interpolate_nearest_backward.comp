#version 450
#extension GL_EXT_shader_atomic_float : enable

// M14 Vulkan: nearest-mode interpolate backward via atomic-float scatter.
//
// PyTorch nearest forward: oh -> floor(oh * in_h / out_h) computed in FLOAT.
// No half-pixel offset, no align_corners. The backward scatters each output
// pixel's gradient back to that single source input pixel, using the SAME
// float-floor mapping as the forward (nearest_interpolate.comp) and as
// CPU/CUDA/ROCm — not integer division, which can floor to a different pixel.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, out_h, out_w)
layout(binding = 1) buffer GradInput  { float grad_input[]; };   // (N, C, in_h, in_w)

layout(push_constant) uniform PushConstants {
    uint n_elements;     // N * C * out_h * out_w
    uint batch;
    uint channels;
    uint in_h;
    uint in_w;
    uint out_h;
    uint out_w;
    uint align_corners;  // ignored — nearest mode doesn't use it; field
                         // present so the host can share the bilinear struct
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint ow = temp % params.out_w; temp /= params.out_w;
    uint oh = temp % params.out_h; temp /= params.out_h;
    uint c  = temp % params.channels; temp /= params.channels;
    uint b  = temp;

    // Match the nearest FORWARD (and CPU/CUDA/ROCm): float floor, not integer
    // division. Integer arithmetic can select a different source pixel than the
    // float-floor forward at near-integer products, sending grad to the wrong
    // cell. Mirror nearest_interpolate.comp exactly.
    uint y = min(uint(floor(float(oh) * float(params.in_h) / float(params.out_h))),
                 params.in_h - 1u);
    uint x = min(uint(floor(float(ow) * float(params.in_w) / float(params.out_w))),
                 params.in_w - 1u);

    uint base_idx = b * (params.channels * params.in_h * params.in_w)
                  + c * (params.in_h * params.in_w);
    atomicAdd(grad_input[base_idx + y * params.in_w + x], grad_output[idx]);
}
