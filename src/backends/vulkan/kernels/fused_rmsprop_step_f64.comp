#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Fused RMSprop optimizer step (Float64)
// Per-element: updates square_avg, momentum_buffer, and param in one kernel
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { float64_t grad_data[]; };
layout(binding = 1) buffer Param { float64_t param_data[]; };
layout(binding = 2) buffer SquareAvg { float64_t square_avg[]; };
layout(binding = 3) buffer MomentumBuf { float64_t momentum_buf[]; };
layout(binding = 4) buffer GradAvg { float64_t grad_avg[]; };

layout(push_constant) uniform PushConstants {
    uint numel;
    float lr;
    float alpha;          // decay rate for square_avg
    float eps;
    float weight_decay;
    float momentum;
    uint centered;        // 0 = not centered, 1 = centered
    uint has_momentum;    // 0 = no momentum buffer, 1 = has momentum
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.numel) return;

    float64_t g = grad_data[gid];

    float64_t lr_d = float64_t(params.lr);
    float64_t alpha_d = float64_t(params.alpha);
    float64_t eps_d = float64_t(params.eps);
    float64_t wd_d = float64_t(params.weight_decay);
    float64_t momentum_d = float64_t(params.momentum);

    // Weight decay
    if (params.weight_decay > 0.0) {
        g += wd_d * param_data[gid];
    }

    // Update square average: sq_avg = alpha * sq_avg + (1 - alpha) * g^2
    float64_t sq = alpha_d * square_avg[gid] + (1.0LF - alpha_d) * g * g;
    square_avg[gid] = sq;

    // GLSL sqrt only works on float — cast down for sqrt
    float64_t denom;
    if (params.centered != 0) {
        // Centered RMSprop: subtract squared mean gradient
        float64_t ga = alpha_d * grad_avg[gid] + (1.0LF - alpha_d) * g;
        grad_avg[gid] = ga;
        denom = float64_t(sqrt(float(sq - ga * ga + eps_d)));
    } else {
        denom = float64_t(sqrt(float(sq + eps_d)));
    }

    if (params.has_momentum != 0) {
        // With momentum
        float64_t buf = momentum_d * momentum_buf[gid] + g / denom;
        momentum_buf[gid] = buf;
        param_data[gid] -= lr_d * buf;
    } else {
        // Without momentum
        param_data[gid] -= lr_d * g / denom;
    }
}
