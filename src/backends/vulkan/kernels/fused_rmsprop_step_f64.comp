#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Fused RMSprop optimizer step (Float64)
// Per-element: updates square_avg, momentum_buffer, and param in one kernel
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { float64_t grad_data[]; };
layout(binding = 1) buffer Param { float64_t param_data[]; };
layout(binding = 2) buffer SquareAvg { float64_t square_avg[]; };
layout(binding = 3) buffer MomentumBuf { float64_t momentum_buf[]; };
layout(binding = 4) buffer GradAvg { float64_t grad_avg[]; };

// Hyperparameters are `double` push constants, not `float` — this is the F64
// kernel; a float32 push constant would cap every downstream float64_t
// computation to float32 precision regardless of in-shader math (see
// fused_adam_step_f64.comp for the diagnosis).
layout(push_constant) uniform PushConstants {
    uint numel;
    uint centered;        // 0 = not centered, 1 = centered
    uint has_momentum;    // 0 = no momentum buffer, 1 = has momentum
    uint padding0;
    double lr;
    double alpha;          // decay rate for square_avg
    double eps;
    double weight_decay;
    double momentum;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.numel) return;

    float64_t g = grad_data[gid];

    float64_t lr_d = float64_t(params.lr);
    float64_t alpha_d = float64_t(params.alpha);
    float64_t eps_d = float64_t(params.eps);
    float64_t wd_d = float64_t(params.weight_decay);
    float64_t momentum_d = float64_t(params.momentum);

    // Weight decay
    if (params.weight_decay > 0.0) {
        g += wd_d * param_data[gid];
    }

    // Update square average: sq_avg = alpha * sq_avg + (1 - alpha) * g^2
    float64_t sq = alpha_d * square_avg[gid] + (1.0LF - alpha_d) * g * g;
    square_avg[gid] = sq;

    // GLSL sqrt only works on float — cast down for sqrt
    float64_t denom;
    // Per attention-contract.md F64 sqrt rule: refine in F64 (audit C10 Vulkan).
    // eps is applied OUTSIDE the sqrt (denom = sqrt(v) + eps), matching
    // PyTorch/eager and the other backends — NOT sqrt(v + eps).
    // Clamp away from exact zero (and, for the centered branch, away from
    // negative values a subtractive squared-mean can round to) before the
    // reciprocal-sqrt: 1/sqrt(0) = inf, and the Newton-Raphson refinement
    // below then computes 0 * inf = NaN, silently poisoning the parameter —
    // reproduces on the very first step whenever a gradient is exactly 0
    // (e.g. a dead ReLU unit). 1e-30 survives the float32 downcast and is
    // many orders below any real eps, so real (non-zero) values are unaffected.
    if (params.centered != 0) {
        // Centered RMSprop: subtract squared mean gradient
        float64_t ga = alpha_d * grad_avg[gid] + (1.0LF - alpha_d) * g;
        grad_avg[gid] = ga;
        float64_t s = max(sq - ga * ga, float64_t(1e-30));
        float64_t inv = float64_t(1.0) / float64_t(sqrt(float(s)));
        inv = inv * (float64_t(1.5) - float64_t(0.5) * s * inv * inv);
        inv = inv * (float64_t(1.5) - float64_t(0.5) * s * inv * inv);
        denom = s * inv + eps_d;
    } else {
        float64_t s = max(sq, float64_t(1e-30));
        float64_t inv = float64_t(1.0) / float64_t(sqrt(float(s)));
        inv = inv * (float64_t(1.5) - float64_t(0.5) * s * inv * inv);
        inv = inv * (float64_t(1.5) - float64_t(0.5) * s * inv * inv);
        denom = s * inv + eps_d;
    }

    if (params.has_momentum != 0) {
        // With momentum
        float64_t buf = momentum_d * momentum_buf[gid] + g / denom;
        momentum_buf[gid] = buf;
        param_data[gid] -= lr_d * buf;
    } else {
        // Without momentum
        param_data[gid] -= lr_d * g / denom;
    }
}
