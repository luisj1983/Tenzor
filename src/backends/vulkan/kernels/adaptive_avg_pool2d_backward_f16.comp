#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Adaptive Average Pool 2D Backward for Float16
// Distributes gradients from output back to input positions
// Float16 doesn't support atomics, so we iterate over INPUT positions
// and accumulate contributions from all output positions that map to each input
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };  // Packed float16 (2 per uint)
layout(binding = 1) buffer GradInput { uint grad_input[]; };    // Packed float16 (2 per uint)

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint H_in;
    uint W_in;
    uint H_out;
    uint W_out;
} params;

// Helper to read float16 at element index
float readF16(uint element_idx, uint buffer_type) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed;
    if (buffer_type == 0) {
        packed = grad_output[word_idx];
    } else {
        packed = grad_input[word_idx];
    }
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Helper to write float16 at element index using atomic compare-exchange
// Two threads writing adjacent elements share the same uint32 word,
// so we must use atomicCompSwap to avoid clobbering each other's data.
void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;

    // Convert value to float16 bits
    uint new_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint shift = word_offset * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = grad_input[word_idx];
    for (uint iter = 0u; iter < 65536u; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word (X.7 / Y.11 / Y.16).
}

void main() {
    // Process input positions - each thread handles one input position
    uint idx = gl_GlobalInvocationID.x;
    uint total_input = params.batch * params.channels * params.H_in * params.W_in;

    if (idx >= total_input) return;

    // Decode input index
    uint w_in = idx % params.W_in;
    uint h_in = (idx / params.W_in) % params.H_in;
    uint c = (idx / (params.W_in * params.H_in)) % params.channels;
    uint n = idx / (params.W_in * params.H_in * params.channels);

    // Initialize gradient sum
    float grad_sum = 0.0;

    // Find all output positions that map to this input position
    // and accumulate their contributions
    for (uint h_out = 0; h_out < params.H_out; ++h_out) {
        uint h_start = (h_out * params.H_in) / params.H_out;
        uint h_end = ((h_out + 1) * params.H_in) / params.H_out;

        // Check if this input h is in the window
        if (h_in >= h_start && h_in < h_end) {
            for (uint w_out = 0; w_out < params.W_out; ++w_out) {
                uint w_start = (w_out * params.W_in) / params.W_out;
                uint w_end = ((w_out + 1) * params.W_in) / params.W_out;

                // Check if this input w is in the window
                if (w_in >= w_start && w_in < w_end) {
                    uint count = (h_end - h_start) * (w_end - w_start);
                    if (count > 0) {
                        uint out_idx = ((n * params.channels + c) * params.H_out + h_out) * params.W_out + w_out;
                        float grad_val = readF16(out_idx, 0);
                        grad_sum += grad_val / float(count);
                    }
                }
            }
        }
    }

    writeF16(idx, grad_sum);
}
