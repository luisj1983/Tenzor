#version 450

// On-device probe used by linalg.eig to decide between the eigh fast-path
// and the QR fallback.
// Computes:
//   pair[0] = max over (b, i, j) of |A[b, i, j]|
//   pair[1] = max over (b, i, j>i) of |A[b, i, j] - A[b, j, i]|
// Eliminates the previous host download + nested loop.
//
// Both reductions are non-negative, so the IEEE-754 bit pattern of the
// floats is monotonic and atomicMax on uint reinterpretation works.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer InBuf  { float A[]; };
layout(set = 0, binding = 1) buffer        PairBuf { uint pair[]; };  // [max_abs, max_diff]

layout(push_constant) uniform PC {
    uint nbatch;
    uint n;
};

shared uint s_max_abs;
shared uint s_max_diff;

void main() {
    uint b = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint wsz = gl_WorkGroupSize.x;
    if (b >= nbatch) return;

    if (tid == 0u) {
        s_max_abs = 0u;
        s_max_diff = 0u;
    }
    barrier();

    uint base = b * n * n;
    uint total = n * n;
    for (uint idx = tid; idx < total; idx += wsz) {
        uint i = idx / n;
        uint j = idx - i * n;
        float v = A[base + idx];
        float av = abs(v);
        atomicMax(s_max_abs, floatBitsToUint(av));
        if (j > i) {
            float vt = A[base + j * n + i];
            float d = abs(v - vt);
            atomicMax(s_max_diff, floatBitsToUint(d));
        }
    }
    barrier();

    if (tid == 0u) {
        atomicMax(pair[0], s_max_abs);
        atomicMax(pair[1], s_max_diff);
    }
}
