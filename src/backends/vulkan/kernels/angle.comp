#version 450

// Compute phase angle of complex numbers: output[i] = atan2(imag, real)
// Input is interleaved (real, imag) pairs.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input { float in_data[]; };
layout(binding = 1) buffer Output { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_complex;  // Number of complex numbers (output size)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_complex) return;

    float real_part = in_data[2u * idx];
    float imag_part = in_data[2u * idx + 1u];
    out_data[idx] = atan(imag_part, real_part);
}
