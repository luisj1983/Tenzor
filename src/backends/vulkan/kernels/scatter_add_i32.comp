#version 450

// ScatterAdd (Int32): atomically accumulates integer source values into the
// output along a dimension. Equivalent to: output[...][index[i]][...] += src[i].
// Integer atomicAdd is core Vulkan (no extension needed), so no CAS loop.
// Narrow integer dtypes are widened to Int32 by the host before dispatch;
// 64-bit integers are narrowed to Int32 (sparse counts/indices are in range).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Src { int src_data[]; };      // Source values
layout(binding = 1) buffer Index { int idx_data[]; };    // Index tensor (same shape as src)
layout(binding = 2) buffer Output { int out_data[]; };   // Self/output

// Per-dim decode (matches CPU scatter_add_kernel): decode the flat index
// position with the INDEX tensor's contiguous strides, recompose onto SELF
// strides (index value substitutes the coord on the scatter dim).
layout(push_constant) uniform PushConstants {
    uint n;                 // index.numel()
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    int dest_dim_idx = idx_data[i];
    // Normalize negative indices like the CPU reference (idx += dim_size) before the
    // bounds check, so a valid negative index wraps instead of being silently dropped.
    if (dest_dim_idx < 0) dest_dim_idx += int(params.dim_size);

    if (dest_dim_idx < 0 || dest_dim_idx >= int(params.dim_size)) return;

    uint temp = i;
    uint out_idx = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_idx += uint(dest_dim_idx) * selfStride(d);
        } else {
            out_idx += coord * selfStride(d);
        }
    }

    atomicAdd(out_data[out_idx], src_data[i]);
}
