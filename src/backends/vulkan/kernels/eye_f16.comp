#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Eye for Float16: generate identity matrix
// F16 packed buffers (2 Float16 per uint32)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
} params;

void main() {
    // Each thread handles one uint32 word (2 F16 elements)
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    uint total = params.rows * params.cols;
    if (idx0 >= total) return;

    uint row0 = idx0 / params.cols;
    uint col0 = idx0 % params.cols;
    float val0 = (row0 == col0) ? 1.0 : 0.0;

    float val1 = 0.0;
    if (idx1 < total) {
        uint row1 = idx1 / params.cols;
        uint col1 = idx1 % params.cols;
        val1 = (row1 == col1) ? 1.0 : 0.0;
    }

    // Pack two F16 values into one uint32
    uint bits0 = packHalf2x16(vec2(val0, 0.0)) & 0xFFFFu;
    uint bits1 = packHalf2x16(vec2(val1, 0.0)) & 0xFFFFu;
    output_data[pair_idx] = bits0 | (bits1 << 16);
}
