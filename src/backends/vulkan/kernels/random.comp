#version 450

// GPU Random Number Generation using Philox 4x32 counter-based RNG
// Generates uniform random floats in [0, 1) or normal distribution
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Number of elements to generate
    uint seed;           // Random seed
    uint offset;         // Offset for different invocations
    uint distribution;   // 0 = uniform [0,1), 1 = normal (Box-Muller)
} params;

// Philox constants
const uint PHILOX_M0 = 0xD2511F53u;
const uint PHILOX_M1 = 0xCD9E8D57u;
const uint PHILOX_W0 = 0x9E3779B9u;
const uint PHILOX_W1 = 0xBB67AE85u;

// 32-bit multiply returning high 32 bits (emulated without 64-bit)
uint mulhi(uint a, uint b) {
    // Split into 16-bit parts
    uint a_lo = a & 0xFFFFu;
    uint a_hi = a >> 16;
    uint b_lo = b & 0xFFFFu;
    uint b_hi = b >> 16;

    // Partial products
    uint p0 = a_lo * b_lo;
    uint p1 = a_lo * b_hi;
    uint p2 = a_hi * b_lo;
    uint p3 = a_hi * b_hi;

    // Sum with carry
    uint carry = ((p0 >> 16) + (p1 & 0xFFFFu) + (p2 & 0xFFFFu)) >> 16;
    return p3 + (p1 >> 16) + (p2 >> 16) + carry;
}

// Single round of Philox
void philox_round(inout uvec4 ctr, uvec2 key) {
    uint hi0 = mulhi(ctr.x, PHILOX_M0);
    uint lo0 = ctr.x * PHILOX_M0;
    uint hi1 = mulhi(ctr.z, PHILOX_M1);
    uint lo1 = ctr.z * PHILOX_M1;

    ctr = uvec4(hi1 ^ ctr.y ^ key.x, lo1, hi0 ^ ctr.w ^ key.y, lo0);
}

// Full Philox 4x32-10 PRNG
uvec4 philox4x32(uvec4 ctr, uvec2 key) {
    // 10 rounds of Philox
    for (int i = 0; i < 10; i++) {
        philox_round(ctr, key);
        key.x += PHILOX_W0;
        key.y += PHILOX_W1;
    }
    return ctr;
}

// Convert uint32 to float in [0, 1)
float uint_to_float01(uint x) {
    // Use upper 24 bits for mantissa (standard technique)
    return float(x >> 8) * (1.0 / 16777216.0);
}

// Box-Muller transform for normal distribution
vec2 box_muller(float u1, float u2) {
    // Avoid log(0)
    u1 = max(u1, 1e-10);
    float r = sqrt(-2.0 * log(u1));
    float theta = 6.283185307179586 * u2;  // 2 * PI
    return vec2(r * cos(theta), r * sin(theta));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Create counter from thread index
    uint element_idx = idx + params.offset;
    uvec4 ctr = uvec4(element_idx, element_idx >> 16, 0, 0);
    uvec2 key = uvec2(params.seed, params.seed ^ 0xDEADBEEF);

    // Generate 4 random uint32s
    uvec4 rand_vals = philox4x32(ctr, key);

    if (params.distribution == 0) {
        // Uniform distribution [0, 1)
        output_data[idx] = uint_to_float01(rand_vals.x);
    } else {
        // Normal distribution using Box-Muller
        float u1 = uint_to_float01(rand_vals.x);
        float u2 = uint_to_float01(rand_vals.y);
        vec2 normal = box_muller(u1, u2);
        output_data[idx] = normal.x;
    }
}
