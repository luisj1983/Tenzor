#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Cumulative trapezoidal integration along a flattened dimension - Float64 variant.
// Input y is logically (outer, n, inner), output is (outer, n-1, inner).
// Accumulates in float64_t to preserve full double precision.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer YBuf   { float64_t y_data[]; };
layout(binding = 1) buffer XBuf   { float64_t x_data[]; };
layout(binding = 2) buffer OutBuf { float64_t out_data[]; };

layout(push_constant) uniform PushConstants {
    uint outer;
    uint inner;
    uint n;
    uint total;    // outer * inner
    double dx;
    uint has_x;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total) return;

    uint o = idx / params.inner;
    uint i_inner = idx % params.inner;

    float64_t cumsum = 0.0LF;
    uint n_out = params.n - 1;
    for (uint k = 0; k < n_out; ++k) {
        uint idx_k  = (o * params.n + k) * params.inner + i_inner;
        uint idx_k1 = (o * params.n + k + 1) * params.inner + i_inner;
        float64_t h = (params.has_x != 0) ? (x_data[idx_k1] - x_data[idx_k]) : params.dx;
        cumsum += 0.5LF * (y_data[idx_k] + y_data[idx_k1]) * h;
        out_data[(o * n_out + k) * params.inner + i_inner] = cumsum;
    }
}
