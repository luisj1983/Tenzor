#version 450

// Dropout backward for BFloat16: grad_input = grad_output * mask * scale
// Each thread processes 2 elements (one packed uint32 word)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };
layout(binding = 1) buffer Mask { uint mask_data[]; };
layout(binding = 2) buffer GradInput { uint grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    float scale;
} params;

float readGradOutput(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = grad_output[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float(uintBitsToFloat(bits << 16));
}

float readMask(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = mask_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float(uintBitsToFloat(bits << 16));
}

// Convert float to BFloat16 (truncation of upper 16 bits of IEEE 754 float32,
// with round-to-nearest-even). Must match random_bf16.comp's float_to_bf16 —
// this shader's own readGradOutput()/readMask() decode BF16 as
// uintBitsToFloat(bits << 16), so the encoder must produce the upper-16-bits
// truncation, NOT an FP16 (binary16) encoding. Using an FP16 encoder here
// previously corrupted every gradient by ~128x (e.g. float_to_half(1.0) ==
// 0x3C00, which decodes as a BF16 bit pattern to 2^-7 ≈ 0.0078, not 1.0).
uint float_to_bf16(float f) {
    uint bits = floatBitsToUint(f);
    // Round-to-nearest-even: add 0x7FFF + bit 16 (LSB of result) for unbiased rounding
    return (bits + 0x7FFFu + ((bits >> 16) & 1u)) >> 16;
}

void main() {
    uint word_idx = gl_GlobalInvocationID.x;
    uint elem0 = word_idx * 2;
    uint elem1 = word_idx * 2 + 1;

    if (elem0 >= params.n_elements) {
        return;
    }

    float g0 = float(readGradOutput(elem0));
    float m0 = float(readMask(elem0));
    float out0 = g0 * m0 * params.scale;

    float out1 = 0.0;
    if (elem1 < params.n_elements) {
        float g1 = float(readGradOutput(elem1));
        float m1 = float(readMask(elem1));
        out1 = g1 * m1 * params.scale;
    }

    uint half0 = float_to_bf16(out0);
    uint half1 = float_to_bf16(out1);
    grad_input[word_idx] = half0 | (half1 << 16);
}
