#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// CTCLossForward — Float64 (double-precision) variant of ctc_forward.comp.
// Same log-domain forward-backward DP; see ctc_forward.comp for the
// algorithm description. This variant exists so Float64 log_probs get a
// genuine double-precision DP recursion (matching CPU/CUDA/ROCm/OneAPI's
// native double-precision CTC kernels) instead of being silently downcast
// to Float32 before dispatch.
//
// GLSL's built-in exp()/log() have no double overload (core profile genType
// is float-only), so a double(exp(float(x))) shortcut would erase ~16 bits
// of mantissa and defeat the entire point of a Float64 path. exp_d/log_d
// below are the same double-precision range-reduction implementations used
// by logsumexp_f64.comp.

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 128;

layout(binding = 0) readonly buffer LogProbs { float64_t log_probs[]; };       // (T_max, N, C)
layout(binding = 1) readonly buffer Targets { int targets[]; };                // (N, S_max)
layout(binding = 2) readonly buffer InputLengths { int input_lengths[]; };     // (N,)
layout(binding = 3) readonly buffer TargetLengths { int target_lengths[]; };   // (N,)
layout(binding = 4) buffer AlphaBuf { float64_t alpha_buf[]; };                // (N, T_max, L_max)
layout(binding = 5) buffer BetaBuf { float64_t beta_buf[]; };                  // (N, T_max, L_max)
layout(binding = 6) buffer PostScratch { float64_t post_scratch[]; };          // (N, T_max, C)
layout(binding = 7) buffer LossOut { float64_t loss_out[]; };                  // (N,)
layout(binding = 8) buffer GradOut { float64_t grad_out[]; };                  // (T_max, N, C)

layout(push_constant) uniform PushConstants {
    uint T_max;
    uint N;
    uint C;
    uint S_max;
    uint L_max;
    int  blank;
    uint zero_infinity;   // bool encoded as 0/1
} pc;

const float64_t NEG_INF = -1.0LF / 0.0LF;

// Double-precision exp via range reduction + Horner polynomial.
float64_t exp_d(float64_t x) {
    if (x != x) return x;  // NaN
    if (x > 709.0LF) return 1.0e308LF;
    if (x < -745.0LF) return 0.0LF;
    float64_t ln2 = 0.6931471805599453LF;
    float64_t k_dbl = floor(x / ln2 + 0.5LF);
    float64_t r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0LF, 1100.0LF));
    float64_t exp_r = 1.0LF + r * (1.0LF + r * (0.5LF + r * (1.0LF/6.0LF + r * (1.0LF/24.0LF + r * (1.0LF/120.0LF +
        r * (1.0LF/720.0LF + r * (1.0LF/5040.0LF + r * (1.0LF/40320.0LF + r * (1.0LF/362880.0LF +
        r * (1.0LF/3628800.0LF + r * (1.0LF/39916800.0LF + r * (1.0LF/479001600.0LF +
        r * (1.0LF/6227020800.0LF)))))))))))));
    float64_t pow2 = 1.0LF;
    int abs_k = (k >= 0) ? k : -k;
    float64_t base = 2.0LF;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) pow2 *= base;
        base *= base;
        abs_k >>= 1;
    }
    return (k >= 0) ? (exp_r * pow2) : (exp_r / pow2);
}

// Double-precision log via IEEE 754 bit extraction + atanh series.
float64_t log_d(float64_t x) {
    if (x != x) return x;
    if (x < 0.0LF) return 0.0LF / 0.0LF;
    if (x == 0.0LF) return -1.0LF / 0.0LF;
    if (x == 1.0LF) return 0.0LF;
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;
    int biased_exp = int((hi >> 20u) & 0x7FFu);
    int exp_val = biased_exp - 1023;
    uint hi_normalized = (hi & 0x000FFFFFu) | 0x3FF00000u;
    float64_t m = packDouble2x32(uvec2(lo, hi_normalized));
    if (m > 1.4142135623730950488LF) { m *= 0.5LF; exp_val += 1; }
    float64_t f = m - 1.0LF;
    float64_t s = f / (2.0LF + f);
    float64_t s2 = s * s;
    float64_t c1 = 0.6666666666666735130LF;
    float64_t c2 = 0.3999999999940941908LF;
    float64_t c3 = 0.2857142874366239149LF;
    float64_t c4 = 0.2222219843214978396LF;
    float64_t c5 = 0.1818357216161805012LF;
    float64_t c6 = 0.1531383769920937332LF;
    float64_t c7 = 0.1479819860511658591LF;
    float64_t s4 = s2 * s2;
    float64_t t1 = c1 + c2 * s2 + c3 * s4;
    float64_t s6 = s4 * s2;
    float64_t t2 = c4 + c5 * s2 + c6 * s4 + c7 * s6;
    float64_t R = t1 + t2 * s6;
    float64_t log_m = 2.0LF * s + s * s2 * R;
    float64_t ln2_hi = 0.69314718055994530942LF;
    float64_t ln2_lo = 2.3190468138462995584e-17LF;
    float64_t exp_dbl = float64_t(exp_val);
    return exp_dbl * ln2_hi + (log_m + exp_dbl * ln2_lo);
}

// Numerically stable log(exp(a) + exp(b)), double precision.
float64_t log_add(float64_t a, float64_t b) {
    if (a == NEG_INF) return b;
    if (b == NEG_INF) return a;
    float64_t m = max(a, b);
    return m + log_d(1.0LF + exp_d(-abs(a - b)));
}

// ext_label[s]: blank at even s, target[s/2] at odd s.
int ext_label(int s, uint n) {
    if ((s & 1) == 0) return pc.blank;
    return targets[n * pc.S_max + uint(s / 2)];
}

shared float64_t s_logZ;
shared int s_T_n;
shared int s_S_n;
shared int s_L_n;
shared uint s_is_inf;  // 0/1, set after loss computation

void main() {
    uint n = gl_WorkGroupID.x;
    if (n >= pc.N) return;
    uint tid = gl_LocalInvocationID.x;
    uint nthreads = gl_WorkGroupSize.x;

    // Per-batch metadata (broadcast via shared mem).
    if (tid == 0) {
        s_T_n = input_lengths[n];
        s_S_n = target_lengths[n];
        s_L_n = 2 * s_S_n + 1;
    }
    barrier();
    int T_n = s_T_n;
    int S_n = s_S_n;
    int L_n = s_L_n;

    // Per-batch base offsets into global workspaces.
    uint alpha_base = n * pc.T_max * pc.L_max;
    uint beta_base  = n * pc.T_max * pc.L_max;
    uint post_base  = n * pc.T_max * pc.C;

    // Degenerate case: zero loss, zero grad. Also reject T_n > T_max (matching
    // CUDA/OneAPI): the forward recurrence indexes alpha/beta (sized T_max*L_max)
    // at t up to T_n-1 and writes grad_out, so an input_length exceeding the
    // log_probs time dim would otherwise scatter out of bounds (device heap
    // corruption). The host validates blank/target labels before dispatch,
    // but per-sample length degeneracy is still handled here.
    if (T_n <= 0 || S_n <= 0 || uint(T_n) > pc.T_max || uint(L_n) > pc.L_max) {
        if (tid == 0) loss_out[n] = 0.0LF;
        for (uint idx = tid; idx < pc.T_max * pc.C; idx += nthreads) {
            uint t = idx / pc.C;
            uint c = idx % pc.C;
            grad_out[t * pc.N * pc.C + n * pc.C + c] = 0.0LF;
        }
        return;
    }

    // -------- Forward DP: alpha[t, s] --------
    // Initialise alpha at t = 0.
    for (uint s = tid; s < uint(L_n); s += nthreads) {
        int sx = int(s);
        if (sx == 0) {
            alpha_buf[alpha_base + 0u * pc.L_max + 0u] =
                log_probs[0u * pc.N * pc.C + n * pc.C + uint(ext_label(0, n))];
        } else if (sx == 1 && L_n > 1) {
            alpha_buf[alpha_base + 0u * pc.L_max + 1u] =
                log_probs[0u * pc.N * pc.C + n * pc.C + uint(ext_label(1, n))];
        } else {
            alpha_buf[alpha_base + 0u * pc.L_max + s] = NEG_INF;
        }
    }
    barrier();

    for (int t = 1; t < T_n; ++t) {
        for (uint s = tid; s < uint(L_n); s += nthreads) {
            int sx = int(s);
            float64_t a = alpha_buf[alpha_base + uint(t - 1) * pc.L_max + s];
            if (sx > 0) {
                a = log_add(a, alpha_buf[alpha_base + uint(t - 1) * pc.L_max + uint(sx - 1)]);
            }
            int c_s = ext_label(sx, n);
            if (sx > 1 && c_s != pc.blank && c_s != ext_label(sx - 2, n)) {
                a = log_add(a, alpha_buf[alpha_base + uint(t - 1) * pc.L_max + uint(sx - 2)]);
            }
            alpha_buf[alpha_base + uint(t) * pc.L_max + s] =
                a + log_probs[uint(t) * pc.N * pc.C + n * pc.C + uint(c_s)];
        }
        barrier();
    }

    // -------- logZ --------
    if (tid == 0) {
        float64_t term1 = alpha_buf[alpha_base + uint(T_n - 1) * pc.L_max + uint(L_n - 1)];
        float64_t term2 = (L_n > 1)
            ? alpha_buf[alpha_base + uint(T_n - 1) * pc.L_max + uint(L_n - 2)]
            : NEG_INF;
        s_logZ = log_add(term1, term2);
    }
    barrier();
    float64_t logZ = s_logZ;

    // -------- Backward DP: beta[t, s] --------
    for (uint s = tid; s < uint(L_n); s += nthreads) {
        int sx = int(s);
        if (sx == L_n - 1 || (sx == L_n - 2 && L_n > 1)) {
            beta_buf[beta_base + uint(T_n - 1) * pc.L_max + s] = 0.0LF;
        } else {
            beta_buf[beta_base + uint(T_n - 1) * pc.L_max + s] = NEG_INF;
        }
    }
    barrier();

    for (int t = T_n - 2; t >= 0; --t) {
        for (uint s = tid; s < uint(L_n); s += nthreads) {
            int sx = int(s);
            int c_s = ext_label(sx, n);
            float64_t b = beta_buf[beta_base + uint(t + 1) * pc.L_max + s]
                    + log_probs[uint(t + 1) * pc.N * pc.C + n * pc.C + uint(c_s)];
            if (sx < L_n - 1) {
                int c_s1 = ext_label(sx + 1, n);
                float64_t term = beta_buf[beta_base + uint(t + 1) * pc.L_max + uint(sx + 1)]
                           + log_probs[uint(t + 1) * pc.N * pc.C + n * pc.C + uint(c_s1)];
                b = log_add(b, term);
            }
            if (sx < L_n - 2 && c_s != pc.blank && c_s != ext_label(sx + 2, n)) {
                int c_s2 = ext_label(sx + 2, n);
                float64_t term = beta_buf[beta_base + uint(t + 1) * pc.L_max + uint(sx + 2)]
                           + log_probs[uint(t + 1) * pc.N * pc.C + n * pc.C + uint(c_s2)];
                b = log_add(b, term);
            }
            beta_buf[beta_base + uint(t) * pc.L_max + s] = b;
        }
        barrier();
    }

    // -------- Loss --------
    float64_t per_sample_loss = -logZ;
    bool is_inf = isinf(per_sample_loss);
    if (pc.zero_infinity != 0u && is_inf) {
        per_sample_loss = 0.0LF;
    }
    if (tid == 0) {
        loss_out[n] = per_sample_loss;
        s_is_inf = is_inf ? 1u : 0u;
    }
    barrier();
    bool inf_flag = (s_is_inf != 0u);

    // -------- Gradient --------
    // Zero-infinity short-circuit: zero out the full (T_max, n, :) row.
    if (pc.zero_infinity != 0u && inf_flag) {
        for (uint idx = tid; idx < pc.T_max * pc.C; idx += nthreads) {
            uint t = idx / pc.C;
            uint c = idx % pc.C;
            grad_out[t * pc.N * pc.C + n * pc.C + c] = 0.0LF;
        }
        return;
    }

    // Accumulate log-posteriors into post_scratch[n, *, *], then convert in
    // one pass. Pre-zero the grad row (for t in [T_n, T_max)) and seed
    // scratch with NEG_INF.
    for (uint idx = tid; idx < pc.T_max * pc.C; idx += nthreads) {
        uint t = idx / pc.C;
        uint c = idx % pc.C;
        grad_out[t * pc.N * pc.C + n * pc.C + c] = 0.0LF;
        post_scratch[post_base + t * pc.C + c] = NEG_INF;
    }
    barrier();

    // Single-thread accumulation over (t, s) — matches CPU reference.
    if (tid == 0) {
        for (int t = 0; t < T_n; ++t) {
            for (int s = 0; s < L_n; ++s) {
                int c = ext_label(s, n);
                float64_t posterior = alpha_buf[alpha_base + uint(t) * pc.L_max + uint(s)]
                                + beta_buf[beta_base + uint(t) * pc.L_max + uint(s)];
                uint slot_idx = post_base + uint(t) * pc.C + uint(c);
                post_scratch[slot_idx] = log_add(post_scratch[slot_idx], posterior);
            }
        }
    }
    barrier();

    // Pass 2: convert log-posterior to gradient.
    uint TnC = uint(T_n) * pc.C;
    for (uint idx = tid; idx < TnC; idx += nthreads) {
        uint t = idx / pc.C;
        uint c = idx % pc.C;
        float64_t lp = log_probs[t * pc.N * pc.C + n * pc.C + c];
        float64_t post = post_scratch[post_base + t * pc.C + c];
        float64_t prob = exp_d(lp);
        float64_t post_prob = (post == NEG_INF) ? 0.0LF : exp_d(post - logZ);
        grad_out[t * pc.N * pc.C + n * pc.C + c] = prob - post_prob;
    }
}
