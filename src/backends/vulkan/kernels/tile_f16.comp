#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Tile operation for Float16: repeat tensor along dimensions using modular indexing
// Float16 elements are packed 2 per 32-bit word in uint buffers
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };       // Packed F16 pairs
layout(binding = 1) buffer Output { uint output_data[]; };     // Packed F16 pairs
layout(binding = 2) buffer InputShape { uint input_shape[]; };
layout(binding = 3) buffer OutputShape { uint output_shape[]; };

layout(push_constant) uniform PushConstants {
    uint output_numel;  // Total output elements
    uint ndims;         // Number of dimensions
} params;

// Read a single Float16 element from packed uint32 input array
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (input_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

// Write a single Float16 element to packed uint32 output array using CAS loop
void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.output_numel) return;

    // Decompose output flat index into multi-dimensional coordinates,
    // then map each coordinate to input space via modulo.
    uint in_coords[8];
    uint in_strides[8];

    uint dims = min(params.ndims, 8u);
    if (dims > 0) {
        in_strides[dims - 1] = 1;
        for (int d = int(dims) - 2; d >= 0; d--) {
            in_strides[d] = in_strides[d + 1] * input_shape[d + 1];
        }
    }

    // Decompose output index and map to input via modulo
    uint temp = idx;
    for (int d = int(dims) - 1; d >= 0; d--) {
        uint out_coord = temp % output_shape[d];
        temp /= output_shape[d];

        // Map output coordinate to input coordinate via modulo
        uint in_coord = out_coord % input_shape[d];
        in_coords[d] = in_coord;
    }

    // Compute input flat index from input coordinates and strides
    uint input_idx = 0;
    for (uint d = 0; d < dims; d++) {
        input_idx += in_coords[d] * in_strides[d];
    }

    writeF16(idx, readF16(input_idx));
}
