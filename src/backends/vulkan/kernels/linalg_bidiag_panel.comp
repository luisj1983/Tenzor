#version 450

// Blocked bidiagonal reduction — panel factorization using Householder reflections
// Reduces columns [col_start, col_start+panel_cols) to bidiagonal form.
// Left Householder: zeros below diagonal in column j
// Right Householder: zeros right of superdiagonal in row j
// Stores left HH vectors below diagonal, right HH vectors above superdiagonal.
// One workgroup with 256 threads.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer MatrixA { float A[]; };
layout(set = 0, binding = 1) buffer TauL { float tau_l[]; };
layout(set = 0, binding = 2) buffer TauR { float tau_r[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // matrix dimension (square n x n)
    uint col_start;  // starting column of this panel
    uint panel_cols; // min(32, n - col_start)
    uint batch_idx;
};

shared float col_data[256];
shared float norm_sq;
shared float alpha;
shared float tau_k;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = batch_idx * n * n;

    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;

        // ---- Left Householder: zero A[col+1:n, col] ----
        // Compute norm of A[col:n, col]
        if (tid == 0) {
            norm_sq = 0.0;
            for (uint r = col; r < n; r++) {
                float v = A[base + r * n + col];
                norm_sq += v * v;
            }

            float a_diag = A[base + col * n + col];
            alpha = -sign(a_diag) * sqrt(norm_sq);
            float v_k = a_diag - alpha;

            if (abs(v_k) < 1e-30) {
                tau_k = 0.0;
            } else {
                float sub_norm = norm_sq - a_diag * a_diag;
                tau_k = (sub_norm + v_k * v_k) / (v_k * v_k);
                tau_k = 2.0 / tau_k;
            }

            // Store diagonal element of bidiagonal and tau
            A[base + col * n + col] = alpha;
            tau_l[batch_idx * n + col] = tau_k;
        }
        barrier();

        float left_tau = tau_k;

        // Apply left Householder to columns [col+1, col_start+panel_cols)
        if (abs(left_tau) > 1e-30) {
            for (uint j = col + 1; j < min(col_start + panel_cols, n); j++) {
                // Compute dot = v_L^T * A[:,j]
                // v_L[col] = 1 (implicit), v_L[col+1:] stored in A[col+1:, col]
                if (tid == 0) {
                    float dot = A[base + col * n + j];  // v[col] = 1
                    for (uint r = col + 1; r < n; r++) {
                        dot += A[base + r * n + col] * A[base + r * n + j];
                    }
                    col_data[0] = dot;
                }
                barrier();

                float dot = col_data[0];

                // Update: A[r,j] -= tau_L * v_L[r] * dot
                for (uint r = col + 1 + tid; r < n; r += 256) {
                    A[base + r * n + j] -= left_tau * A[base + r * n + col] * dot;
                }
                if (tid == 0) {
                    A[base + col * n + j] -= left_tau * dot;
                }
                barrier();
            }
        }

        // ---- Right Householder: zero A[col, col+2:n] ----
        // Only if there are at least 2 columns to the right
        if (col + 2 >= n) {
            if (tid == 0) {
                tau_r[batch_idx * n + col] = 0.0;
            }
            barrier();
            continue;
        }

        if (tid == 0) {
            norm_sq = 0.0;
            for (uint c = col + 1; c < n; c++) {
                float v = A[base + col * n + c];
                norm_sq += v * v;
            }

            float a_super = A[base + col * n + (col + 1)];
            alpha = -sign(a_super) * sqrt(norm_sq);
            float v_k_r = a_super - alpha;

            if (abs(v_k_r) < 1e-30) {
                tau_k = 0.0;
            } else {
                float sub_norm = norm_sq - a_super * a_super;
                tau_k = (sub_norm + v_k_r * v_k_r) / (v_k_r * v_k_r);
                tau_k = 2.0 / tau_k;
            }

            // Store superdiagonal element and tau
            A[base + col * n + (col + 1)] = alpha;
            tau_r[batch_idx * n + col] = tau_k;
        }
        barrier();

        float right_tau = tau_k;

        // Apply right Householder to rows [col+1, col_start+panel_cols)
        // v_R[col+1] = 1 (implicit), v_R[col+2:] stored in A[col, col+2:]
        if (abs(right_tau) > 1e-30) {
            for (uint i = col + 1; i < min(col_start + panel_cols, n); i++) {
                // Compute dot = A[i,:] * v_R
                if (tid == 0) {
                    float dot = A[base + i * n + (col + 1)];  // v_R[col+1] = 1
                    for (uint c = col + 2; c < n; c++) {
                        dot += A[base + i * n + c] * A[base + col * n + c];
                    }
                    col_data[0] = dot;
                }
                barrier();

                float dot = col_data[0];

                // Update: A[i,c] -= tau_R * dot * v_R[c]
                for (uint c = col + 2 + tid; c < n; c += 256) {
                    A[base + i * n + c] -= right_tau * dot * A[base + col * n + c];
                }
                if (tid == 0) {
                    A[base + i * n + (col + 1)] -= right_tau * dot;
                }
                barrier();
            }
        }
    }
}
