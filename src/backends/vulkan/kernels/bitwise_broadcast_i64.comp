#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Broadcasting-aware bitwise binary operations (int64, native). Mirrors
// bitwise_broadcast.comp (int32) but operates on genuine int64_t buffers via
// GL_EXT_shader_explicit_arithmetic_types_int64, avoiding the lossy
// Int32-narrowing path.
//
// op: 0=and, 1=or, 2=xor, 3=left_shift, 4=right_shift (arithmetic, sign-
// preserving). Shift amounts outside [0, 64) are undefined behavior in
// GLSL's own << / >> operators; guarded explicitly to match CPU's defined
// out-of-range semantics (left -> 0, right -> sign-saturated).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { int64_t a[]; };
layout(binding = 1) buffer InputB { int64_t b[]; };
layout(binding = 2) buffer Output { int64_t result[]; };

layout(push_constant) uniform PushConstants {
    uint output_size;
    uint op;
    uint ndim_a;
    uint ndim_b;
    uint ndim_out;
    uint strides_a[8];
    uint strides_b[8];
    uint shape_out[8];
} params;

void main() {
    uint out_idx = gl_GlobalInvocationID.x;
    if (out_idx >= params.output_size) {
        return;
    }

    uint idx_a = 0;
    uint idx_b = 0;
    uint tmp = out_idx;

    for (uint i = 0; i < params.ndim_out; i++) {
        uint dim_idx = params.ndim_out - 1 - i;
        uint coord = tmp % params.shape_out[dim_idx];
        tmp /= params.shape_out[dim_idx];
        idx_a += coord * params.strides_a[dim_idx];
        idx_b += coord * params.strides_b[dim_idx];
    }

    int64_t val_a = a[idx_a];
    int64_t val_b = b[idx_b];
    int64_t res = int64_t(0);

    switch (params.op) {
        case 0u: // and
            res = val_a & val_b;
            break;
        case 1u: // or
            res = val_a | val_b;
            break;
        case 2u: // xor
            res = val_a ^ val_b;
            break;
        case 3u: // left_shift
            if (val_b < int64_t(0) || val_b >= int64_t(64)) {
                res = int64_t(0);
            } else {
                res = int64_t(uint64_t(val_a) << uint64_t(val_b));
            }
            break;
        case 4u: // right_shift (arithmetic)
            if (val_b < int64_t(0) || val_b >= int64_t(64)) {
                res = (val_a < int64_t(0)) ? int64_t(-1) : int64_t(0);
            } else {
                res = val_a >> val_b;
            }
            break;
        default:
            res = int64_t(0);
            break;
    }

    result[out_idx] = res;
}
