#version 450

// Box IoU computation (supports IoU, GIoU, DIoU, CIoU)
// Each thread computes one (i, j) pair in the NxM IoU matrix
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Boxes1 { float boxes1[]; };     // (N, 4) x1,y1,x2,y2
layout(binding = 1) buffer Boxes2 { float boxes2[]; };     // (M, 4) x1,y1,x2,y2
layout(binding = 2) buffer Result { float result[]; };      // (N, M) IoU matrix

layout(push_constant) uniform PushConstants {
    uint N;
    uint M;
    uint iou_type;   // 0=IoU, 1=GIoU, 2=DIoU, 3=CIoU
    uint padding;
} params;

const float PI = 3.14159265358979323846;
const float EPS = 1e-7;

void main() {
    uint gid = gl_GlobalInvocationID.x;

    uint total = params.N * params.M;
    if (gid >= total) return;

    uint i = gid / params.M;
    uint j = gid % params.M;

    // Box 1
    float x1_1 = boxes1[i * 4 + 0];
    float y1_1 = boxes1[i * 4 + 1];
    float x2_1 = boxes1[i * 4 + 2];
    float y2_1 = boxes1[i * 4 + 3];
    float w1 = x2_1 - x1_1;
    float h1 = y2_1 - y1_1;
    float area1 = w1 * h1;

    // Box 2
    float x1_2 = boxes2[j * 4 + 0];
    float y1_2 = boxes2[j * 4 + 1];
    float x2_2 = boxes2[j * 4 + 2];
    float y2_2 = boxes2[j * 4 + 3];
    float w2 = x2_2 - x1_2;
    float h2 = y2_2 - y1_2;
    float area2 = w2 * h2;

    // Intersection
    float inter_x1 = max(x1_1, x1_2);
    float inter_y1 = max(y1_1, y1_2);
    float inter_x2 = min(x2_1, x2_2);
    float inter_y2 = min(y2_1, y2_2);
    float inter_w = max(0.0, inter_x2 - inter_x1);
    float inter_h = max(0.0, inter_y2 - inter_y1);
    float inter_area = inter_w * inter_h;

    // Union
    float union_area = area1 + area2 - inter_area;

    // IoU. Matches CPU exactly: for degenerate/inverted input boxes union_area
    // can be <= 0; the unguarded division can return a negative or blown-up
    // IoU instead of the defined 0.
    float iou = (union_area > 0.0) ? (inter_area / union_area) : 0.0;

    if (params.iou_type == 0) {
        // Standard IoU
        result[gid] = iou;
    } else if (params.iou_type == 1) {
        // GIoU
        float enclose_x1 = min(x1_1, x1_2);
        float enclose_y1 = min(y1_1, y1_2);
        float enclose_x2 = max(x2_1, x2_2);
        float enclose_y2 = max(y2_1, y2_2);
        float enclose_area = (enclose_x2 - enclose_x1) * (enclose_y2 - enclose_y1);
        result[gid] = iou - (enclose_area - union_area) / max(enclose_area, EPS);
    } else if (params.iou_type == 2) {
        // DIoU
        float cx1 = (x1_1 + x2_1) * 0.5;
        float cy1 = (y1_1 + y2_1) * 0.5;
        float cx2 = (x1_2 + x2_2) * 0.5;
        float cy2 = (y1_2 + y2_2) * 0.5;

        float enclose_x1 = min(x1_1, x1_2);
        float enclose_y1 = min(y1_1, y1_2);
        float enclose_x2 = max(x2_1, x2_2);
        float enclose_y2 = max(y2_1, y2_2);
        float enclose_w = enclose_x2 - enclose_x1;
        float enclose_h = enclose_y2 - enclose_y1;

        float center_dist_sq = (cx1 - cx2) * (cx1 - cx2) + (cy1 - cy2) * (cy1 - cy2);
        float diag_dist_sq = enclose_w * enclose_w + enclose_h * enclose_h;
        result[gid] = iou - center_dist_sq / (diag_dist_sq + EPS);
    } else {
        // CIoU (type == 3)
        float cx1 = (x1_1 + x2_1) * 0.5;
        float cy1 = (y1_1 + y2_1) * 0.5;
        float cx2 = (x1_2 + x2_2) * 0.5;
        float cy2 = (y1_2 + y2_2) * 0.5;

        float enclose_x1 = min(x1_1, x1_2);
        float enclose_y1 = min(y1_1, y1_2);
        float enclose_x2 = max(x2_1, x2_2);
        float enclose_y2 = max(y2_1, y2_2);
        float enclose_w = enclose_x2 - enclose_x1;
        float enclose_h = enclose_y2 - enclose_y1;

        float center_dist_sq = (cx1 - cx2) * (cx1 - cx2) + (cy1 - cy2) * (cy1 - cy2);
        float diag_dist_sq = enclose_w * enclose_w + enclose_h * enclose_h;

        float four_over_pi_sq = 4.0 / (PI * PI);
        float v = four_over_pi_sq * pow(atan(w2 / (h2 + EPS)) - atan(w1 / (h1 + EPS)), 2.0);
        float alpha = v / (1.0 - iou + v + EPS);
        result[gid] = iou - center_dist_sq / (diag_dist_sq + EPS) - alpha * v;
    }
}
