#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Stack (Float64) along an arbitrary dim. Mirrors stack.comp semantics:
// output[outer, tensor, inner] = input_tensors[tensor][outer*inner_size + inner].
// The previous stack_f64 assumed dim=0 only and collapsed 3D output accesses,
// which produced transposed data when called with dim >= 1 (e.g. vander stack).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float64_t input_data[]; };
layout(binding = 1) buffer Output { float64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_tensors;
    uint elements_per_tensor;
    uint output_numel;
    uint outer_size;
    uint inner_size;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.output_numel) return;

    uint inner = idx % params.inner_size;
    uint tmp   = idx / params.inner_size;
    uint tensor_idx = tmp % params.num_tensors;
    uint outer = tmp / params.num_tensors;

    uint input_offset = tensor_idx * params.elements_per_tensor
                      + outer * params.inner_size
                      + inner;
    output_data[idx] = input_data[input_offset];
}
