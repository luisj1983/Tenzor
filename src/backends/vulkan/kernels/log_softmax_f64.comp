#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Log Softmax with numerical stability for Float64
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint dim;
} params;

shared double shared_max[WORKGROUP_SIZE];
shared double shared_sum[WORKGROUP_SIZE];

// Double-precision exp approximation with range reduction
// Uses O(log(k)) binary exponentiation to avoid slow linear loops
double exp_d(double x) {
    // Handle NaN
    if (x != x) return x;  // NaN propagation

    // Clamp to avoid overflow/underflow
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;

    // Range reduction: exp(x) = 2^k * exp(r) where x = k*ln(2) + r
    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));

    // exp(r) via degree-13 Taylor polynomial (Horner's method)
    // |r| <= ln(2)/2, error bound < r^14/14! < 1e-19
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0 +
        r * (1.0/6227020800.0)))))))))))));


    // Compute 2^|k| using O(log(k)) binary exponentiation
    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) {
            pow2 *= base;
        }
        base *= base;
        abs_k >>= 1;
    }

    if (k >= 0) {
        return exp_r * pow2;
    } else {
        return exp_r / pow2;
    }
}

// Double-precision log approximation
double log_d(double x) {
    // Handle special cases
    if (x != x) return x;  // NaN propagation
    if (x <= 0.0) return -1.0 / 0.0;  // -inf for x <= 0
    if (x == 1.0) return 0.0;

    // For values that fit in float range with good precision, use float log
    if (x >= 1.0e-30 && x <= 1.0e30) {
        return double(log(float(x)));
    }

    // For extreme values, use range reduction with bounded loop
    double ln2 = 0.6931471805599453;
    int e = 0;
    double m = x;

    // Normalize to range [1, 2) with bounded iterations
    // Double precision exponent range is about [-1022, 1023]
    for (int i = 0; i < 1100 && m >= 2.0; i++) { m *= 0.5; e++; }
    for (int i = 0; i < 1100 && m < 1.0; i++) { m *= 2.0; e--; }

    // Now m is in [1, 2), compute log(m) using float
    double log_m = double(log(float(m)));

    return log_m + double(e) * ln2;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.num_classes;

    // Step 1: Find maximum for numerical stability
    double local_max = -1.0 / 0.0; // -infinity
    for (uint i = tid; i < params.num_classes; i += 256) {
        local_max = max(local_max, input_data[base_idx + i]);
    }
    shared_max[tid] = local_max;
    barrier();

    // Parallel reduction for max
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
        }
        barrier();
    }

    double row_max = shared_max[0];
    barrier();

    // Step 2: Compute sum(exp(x - max))
    double local_sum = 0.0;
    for (uint i = tid; i < params.num_classes; i += 256) {
        local_sum += exp_d(input_data[base_idx + i] - row_max);
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    double log_sum_exp = log_d(shared_sum[0]);
    barrier();

    // Step 3: Compute log_softmax = x - max - log(sum(exp(x - max)))
    for (uint i = tid; i < params.num_classes; i += 256) {
        output_data[base_idx + i] = input_data[base_idx + i] - row_max - log_sum_exp;
    }
}
