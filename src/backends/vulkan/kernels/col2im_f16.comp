#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Col2im (Fold) operation for Float16
// Transforms (N, C*K*K, L) -> (N,C,H,W) with accumulation
// F16 packed buffers (2 Float16 per uint32), arithmetic in float32
// Note: Cannot use atomicAdd on packed F16 — use read-modify-write
// (col2im threads may race on the same output element, so this shader
//  is only safe when dispatched with non-overlapping output mapping,
//  or when used as part of a serial accumulation strategy.)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;    // Total elements to process
    uint batch;
    uint channels;
    uint height;
    uint width;
    uint kernel_size;
    uint stride;
    uint padding;
    uint dilation;
    uint out_h;
    uint out_w;
} params;

// Read a single float16 element from packed uint buffer
float readF16Input(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

float readF16Output(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = output_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void writeF16Output(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint existing = output_data[word_idx];
    uint mask = 0xFFFFu << (word_offset * 16);
    output_data[word_idx] = (existing & ~mask) | (bits << (word_offset * 16));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Calculate derived values
    uint num_blocks = params.out_h * params.out_w;
    uint col_channels = params.channels * params.kernel_size * params.kernel_size;

    // Decode flat index to (b, col_c, block_idx)
    uint temp = idx;
    uint block_idx = temp % num_blocks; temp /= num_blocks;
    uint col_c = temp % col_channels; temp /= col_channels;
    uint b = temp;

    // Decode col_c to (c, kh, kw)
    uint kw = col_c % params.kernel_size;
    uint kh = (col_c / params.kernel_size) % params.kernel_size;
    uint c = col_c / (params.kernel_size * params.kernel_size);

    // Calculate output position from block_idx
    uint oh = block_idx / params.out_w;
    uint ow = block_idx % params.out_w;

    // Calculate output position in image
    int ih = int(oh * params.stride) - int(params.padding) + int(kh * params.dilation);
    int iw = int(ow * params.stride) - int(params.padding) + int(kw * params.dilation);

    // Check bounds
    if (ih >= 0 && ih < int(params.height) && iw >= 0 && iw < int(params.width)) {
        uint input_idx = b * (col_channels * num_blocks) +
                        col_c * num_blocks +
                        block_idx;

        uint output_idx = b * (params.channels * params.height * params.width) +
                         c * (params.height * params.width) +
                         uint(ih) * params.width + uint(iw);

        // Read input value, read existing output, accumulate, write back
        float in_val = readF16Input(input_idx);
        float out_val = readF16Output(output_idx);
        writeF16Output(output_idx, out_val + in_val);
    }
}
