#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Col2im (Fold) operation for Float16
// Transforms (N, C*K_h*K_w, L) -> (N,C,H,W) with accumulation of overlapping
// patches. Dispatched input-centric (one thread per column entry), identical to
// the Float32 atomicAdd path. F16 packed buffers (2 Float16 per uint32),
// arithmetic in float32.
//
// Core Vulkan has no native atomicAdd for 16-bit floats, so overlapping sliding
// windows (stride < kernel) would race when multiple threads accumulate into the
// same output pixel (and the same packed uint32 word). A plain read-modify-write
// silently drops contributions. We instead accumulate with an atomicCompSwap
// loop on the backing uint32 word (same pattern as put_bf16.comp / softmax_f16),
// which updates only the targeted half-word atomically and never clobbers its
// neighbour. This matches the F32 atomicAdd semantics for cross-backend parity.
// HH.6: per-axis kernel/stride/padding/dilation.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;    // Total elements to process
    uint batch;
    uint channels;
    uint height;
    uint width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint dil_h;
    uint dil_w;
    uint out_h;
    uint out_w;
} params;

// Read a single float16 element from packed uint buffer
float readF16Input(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Atomic add for Float16 using a bounded CAS loop on the backing uint32 word.
// Reads the current packed half, adds in float32, repacks to F16, and commits
// only the targeted 16-bit lane via atomicCompSwap so concurrent threads racing
// on the same output pixel (or the neighbouring half of the same word) all have
// their contributions applied without loss or clobbering.
void atomicAddF16Output(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint shift = (element_idx % 2) * 16;
    uint mask = 0xFFFFu << shift;

    uint old_word = output_data[word_idx];
    // Bounded retries to prevent GPU hangs from infinite spinning under
    // pathological contention (hardware/driver failure).
    for (uint attempt = 0u; attempt < 65536u; ++attempt) {
        uint old_bits = (old_word >> shift) & 0xFFFFu;
        float old_val = unpackHalf2x16(old_bits | (old_bits << 16)).x;
        float new_val = old_val + val;
        uint new_bits = packHalf2x16(vec2(new_val, 0.0)) & 0xFFFFu;
        uint new_word = (old_word & ~mask) | (new_bits << shift);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
    // Saturation: do NOT fall back to a non-atomic store — it would clobber the
    // neighbouring packed half-word.
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Calculate derived values
    uint num_blocks = params.out_h * params.out_w;
    uint col_channels = params.channels * params.kernel_h * params.kernel_w;

    // Decode flat index to (b, col_c, block_idx)
    uint temp = idx;
    uint block_idx = temp % num_blocks; temp /= num_blocks;
    uint col_c = temp % col_channels; temp /= col_channels;
    uint b = temp;

    // Decode col_c to (c, kh, kw)
    uint kw = col_c % params.kernel_w;
    uint kh = (col_c / params.kernel_w) % params.kernel_h;
    uint c = col_c / (params.kernel_h * params.kernel_w);

    // Calculate output position from block_idx
    uint oh = block_idx / params.out_w;
    uint ow = block_idx % params.out_w;

    // Calculate output position in image
    int ih = int(oh * params.stride_h) - int(params.pad_h) + int(kh * params.dil_h);
    int iw = int(ow * params.stride_w) - int(params.pad_w) + int(kw * params.dil_w);

    // Check bounds
    if (ih >= 0 && ih < int(params.height) && iw >= 0 && iw < int(params.width)) {
        uint input_idx = b * (col_channels * num_blocks) +
                        col_c * num_blocks +
                        block_idx;

        uint output_idx = b * (params.channels * params.height * params.width) +
                         c * (params.height * params.width) +
                         uint(ih) * params.width + uint(iw);

        // Read input value and atomically accumulate into the output pixel.
        float in_val = readF16Input(input_idx);
        atomicAddF16Output(output_idx, in_val);
    }
}
