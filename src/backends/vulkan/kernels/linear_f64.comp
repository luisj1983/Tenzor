#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Linear layer for Float64: output = input @ weight^T + bias
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Weight { double weight_data[]; };
layout(binding = 2) buffer Bias { double bias_data[]; };
layout(binding = 3) buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
    uint has_bias;
} params;

shared double tileA[16][16];
shared double tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    double sum = 0.0;

    uint num_tiles = (params.K + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        uint a_col = t * 16 + local_col;
        if (row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = input_data[row * params.K + a_col];
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        uint b_row = t * 16 + local_row;
        if (col < params.N && b_row < params.K) {
            tileB[local_row][local_col] = weight_data[col * params.K + b_row];
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        for (uint k = 0; k < 16; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    if (row < params.M && col < params.N) {
        if (params.has_bias != 0) {
            sum += bias_data[col];
        }
        output_data[row * params.N + col] = sum;
    }
}
