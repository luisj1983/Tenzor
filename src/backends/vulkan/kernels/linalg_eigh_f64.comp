#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf { float64_t data_in[];   };
layout(set = 0, binding = 1) buffer WBuf     { float64_t data_w[];    };
layout(set = 0, binding = 2) buffer VBuf     { float64_t data_v[];    };

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch;
};

shared float64_t D[32][32];
shared float64_t V[32][32];
shared float64_t converged;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (batch_idx >= batch) return;

    uint mat_offset = batch_idx * n * n;

    for (uint row = 0; row < n; row++) {
        if (tid < n) {
            D[row][tid] = data_in[mat_offset + row * n + tid];
        }
        if (tid < n) {
            V[row][tid] = (row == tid) ? 1.0lf : 0.0lf;
        }
    }
    barrier();

    for (uint sweep = 0; sweep < 30; sweep++) {
        if (tid == 0) converged = 1.0lf;
        barrier();

        for (uint p = 0; p < n; p++) {
            for (uint q = p + 1; q < n; q++) {
                if (tid == 0) {
                    float64_t app = D[p][p], aqq = D[q][q], apq = D[p][q];

                    if (abs(apq) > 1e-14lf * sqrt(abs(app * aqq))) {
                        converged = 0.0lf;

                        float64_t tau_val = (aqq - app) / (2.0lf * apq);
                        float64_t t = sign(tau_val) / (abs(tau_val) + sqrt(1.0lf + tau_val * tau_val));
                        float64_t c = 1.0lf / sqrt(1.0lf + t * t);
                        float64_t s = t * c;

                        for (uint i = 0; i < n; i++) {
                            if (i != p && i != q) {
                                float64_t dip = D[i][p], diq = D[i][q];
                                D[i][p] = c * dip - s * diq;
                                D[p][i] = D[i][p];
                                D[i][q] = s * dip + c * diq;
                                D[q][i] = D[i][q];
                            }
                        }

                        float64_t new_pp = c*c*app - 2.0lf*s*c*apq + s*s*aqq;
                        float64_t new_qq = s*s*app + 2.0lf*s*c*apq + c*c*aqq;
                        D[p][p] = new_pp;
                        D[q][q] = new_qq;
                        D[p][q] = 0.0lf;
                        D[q][p] = 0.0lf;

                        for (uint i = 0; i < n; i++) {
                            float64_t vip = V[i][p], viq = V[i][q];
                            V[i][p] = c * vip - s * viq;
                            V[i][q] = s * vip + c * viq;
                        }
                    }
                }
                barrier();
            }
        }

        if (converged > 0.5lf) break;
        barrier();
    }

    if (tid < n) {
        data_w[batch_idx * n + tid] = D[tid][tid];
    }

    for (uint row = 0; row < n; row++) {
        if (tid < n) {
            data_v[mat_offset + row * n + tid] = V[row][tid];
        }
    }
}
