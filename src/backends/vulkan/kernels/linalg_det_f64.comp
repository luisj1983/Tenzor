#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Determinant via LU factorization for small matrices (<= 32x32) — Float64

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch;
};

shared double mat[32][32];
shared int pivot_sign;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;

    if (batch_idx >= batch) return;

    uint mat_offset = batch_idx * n * n;

    if (tid == 0) pivot_sign = 1;
    barrier();

    for (uint row = 0; row < n; row++) {
        if (tid < n) {
            mat[row][tid] = data_in[mat_offset + row * n + tid];
        }
    }
    barrier();

    for (uint col = 0; col < n; col++) {
        if (tid == 0) {
            uint max_row = col;
            double max_val = abs(mat[col][col]);
            for (uint row = col + 1; row < n; row++) {
                double val = abs(mat[row][col]);
                if (val > max_val) {
                    max_val = val;
                    max_row = row;
                }
            }
            if (max_row != col) {
                pivot_sign = -pivot_sign;
                for (uint j = 0; j < n; j++) {
                    double tmp = mat[col][j];
                    mat[col][j] = mat[max_row][j];
                    mat[max_row][j] = tmp;
                }
            }
        }
        barrier();

        if (tid > col && tid < n) {
            double pivot = mat[col][col];
            if (abs(pivot) > 1e-300LF) {
                double factor = mat[tid][col] / pivot;
                for (uint j = col + 1; j < n; j++) {
                    mat[tid][j] -= factor * mat[col][j];
                }
                mat[tid][col] = factor;
            }
        }
        barrier();
    }

    if (tid == 0) {
        double det = double(pivot_sign);
        for (uint i = 0; i < n; i++) {
            det *= mat[i][i];
        }
        data_out[batch_idx] = det;
    }
}
