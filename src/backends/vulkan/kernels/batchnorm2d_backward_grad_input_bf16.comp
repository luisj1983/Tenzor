#version 450

// Batch Normalization 2D Backward — Pass 2 for BFloat16: compute grad_input.
// Consumes grad_gamma / grad_beta produced by pass 1
// (batchnorm2d_backward_bf16.comp). Using the identity
//   grad_gamma[c] = sum_grad_norm (sum of grad_out * normalized over N*H*W)
//   grad_beta[c]  = sum_grad       (sum of grad_out)
// the input gradient is
//   grad_in = gamma * invstd * (grad_out - sum_grad/N - normalized * sum_grad_norm/N)
// with N = batch * spatial_size.
//
// Input/grad tensors are packed BF16 (2 elements per 32-bit word); statistics
// and parameter gradients are Float32. Bindings and push-constants mirror the
// BF16 pass-1 shader exactly.

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// Helper to pack two bfloat16 values (round-to-nearest-even)
uint packBF16Pair(float v0, float v1) {
    uint b0 = floatBitsToUint(v0);
    uint b1 = floatBitsToUint(v1);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };   // Packed BF16 (N, C, H, W)
layout(binding = 1) buffer Input { uint input_data[]; };          // Packed BF16 (N, C, H, W)
layout(binding = 2) buffer Mean { float mean_data[]; };           // (C) Float32
layout(binding = 3) buffer InvStd { float invstd_data[]; };        // (C) Float32 - pre-computed 1/sqrt(var+eps)
layout(binding = 4) buffer Gamma { float gamma_data[]; };         // (C) Float32
layout(binding = 5) buffer GradInput { uint grad_input[]; };      // Packed BF16 (N, C, H, W)
layout(binding = 6) buffer GradGamma { float grad_gamma[]; };     // (C) Float32 - sum_grad_norm per channel
layout(binding = 7) buffer GradBeta { float grad_beta[]; };       // (C) Float32 - sum_grad per channel

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint spatial_size;
    float eps;
    uint has_gamma;
} params;

// Compute grad_input for a single element. half_idx selects which BF16 lane of
// the packed word.
float processElement(uint flat_idx, uint word_idx, uint half_idx) {
    // Decode to get channel
    uint temp = flat_idx;
    temp /= params.spatial_size;
    uint c = temp % params.channels;

    // Read input and grad_output (packed BF16)
    uint packed_x = input_data[word_idx];
    uint packed_grad = grad_output[word_idx];
    float x = (half_idx == 0u) ? unpackBF16x2(packed_x).x : unpackBF16x2(packed_x >> 16).x;
    float grad_out = (half_idx == 0u) ? unpackBF16x2(packed_grad).x : unpackBF16x2(packed_grad >> 16).x;

    float mean = mean_data[c];
    float inv_std = invstd_data[c];
    float normalized = (x - mean) * inv_std;

    float N = float(params.batch * params.spatial_size);
    float mean_grad = grad_beta[c] / N;
    float mean_grad_norm = grad_gamma[c] / N;

    float gamma = (params.has_gamma != 0u) ? gamma_data[c] : 1.0;
    float grad_normalized = grad_out - mean_grad - normalized * mean_grad_norm;
    return gamma * inv_std * grad_normalized;
}

void main() {
    // Each thread processes one 32-bit word (2 BF16 elements).
    uint word_idx = gl_GlobalInvocationID.x;
    uint num_words = (params.n_elements + 1u) / 2u;
    if (word_idx >= num_words) return;

    uint elem0 = word_idx * 2u;
    uint elem1 = word_idx * 2u + 1u;

    float result0 = 0.0;
    float result1 = 0.0;
    if (elem0 < params.n_elements) {
        result0 = processElement(elem0, word_idx, 0u);
    }
    if (elem1 < params.n_elements) {
        result1 = processElement(elem1, word_idx, 1u);
    }

    grad_input[word_idx] = packBF16Pair(result0, result1);
}
