#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer QBuf      { float64_t data_q[];   };
layout(set = 0, binding = 2) buffer RBuf      { float64_t data_r[];   };

layout(push_constant) uniform PushConstants {
    uint m;
    uint n_cols;
    uint batch;
};

shared float64_t R[32][32];
shared float64_t Q[32][32];
shared float64_t v[32];
shared float64_t norm_val;
shared float64_t tau;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (batch_idx >= batch) return;

    uint r_off = batch_idx * m * n_cols;
    uint q_off = batch_idx * m * m;

    for (uint row = 0; row < m; row++) {
        if (tid < n_cols) {
            R[row][tid] = data_in[r_off + row * n_cols + tid];
        }
        if (tid < m) {
            Q[row][tid] = (row == tid) ? 1.0lf : 0.0lf;
        }
    }
    barrier();

    uint min_mn = min(m, n_cols);

    for (uint col = 0; col < min_mn; col++) {
        if (tid == 0) {
            float64_t sigma = 0.0lf;
            for (uint i = col; i < m; i++) {
                v[i] = R[i][col];
                sigma += v[i] * v[i];
            }
            float64_t norm = sqrt(sigma);
            float64_t sign_val = (v[col] >= 0.0lf) ? 1.0lf : -1.0lf;
            v[col] += sign_val * norm;

            float64_t v_norm_sq = 0.0lf;
            for (uint i = col; i < m; i++) {
                v_norm_sq += v[i] * v[i];
            }
            norm_val = v_norm_sq;
            tau = (v_norm_sq > 1e-30lf) ? 2.0lf / v_norm_sq : 0.0lf;
        }
        barrier();

        if (norm_val < 1e-30lf) {
            barrier();
            continue;
        }

        if (tid < n_cols && tid >= col) {
            float64_t dot = 0.0lf;
            for (uint i = col; i < m; i++) {
                dot += v[i] * R[i][tid];
            }
            dot *= tau;
            for (uint i = col; i < m; i++) {
                R[i][tid] -= dot * v[i];
            }
        }
        barrier();

        if (tid < m) {
            float64_t dot = 0.0lf;
            for (uint i = col; i < m; i++) {
                dot += Q[tid][i] * v[i];
            }
            dot *= tau;
            for (uint i = col; i < m; i++) {
                Q[tid][i] -= dot * v[i];
            }
        }
        barrier();
    }

    for (uint row = 0; row < m; row++) {
        if (tid < m) {
            data_q[q_off + row * m + tid] = Q[row][tid];
        }
        if (tid < n_cols) {
            data_r[r_off + row * n_cols + tid] = R[row][tid];
        }
    }
}
