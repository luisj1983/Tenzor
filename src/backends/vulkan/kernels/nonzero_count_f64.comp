#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Nonzero - Pass 1 (Float64 native): Count nonzero elements and write per-element
// flags, testing zero-ness at full double precision. A Float64 magnitude below
// Float32's smallest subnormal (~1.4e-45) rounds to exactly 0.0f, so downcasting
// to Float32 before this test (as the base nonzero_count.comp shader does for
// other dtypes) would silently drop such elements — this variant matches
// CPU/CUDA/ROCm/OneAPI's nonzero, which compares against T(0) in the input's own
// dtype. Output format (flags/count) is identical to nonzero_count.comp so the
// downstream prefix_sum/nonzero_gather passes are shared unchanged.
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float64_t input_data[]; };
layout(binding = 1) buffer Flags { uint flags[]; };         // Per-element: 1 if nonzero, 0 if zero
layout(binding = 2) buffer Count { uint count[]; };         // Workgroup counts, then total

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint pass;            // 0 = per-element flag + workgroup count, 1 = reduce workgroup counts
} params;

shared uint shared_count[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wid = gl_WorkGroupID.x;

    if (params.pass == 0) {
        // Pass 0: Write per-element flags and compute workgroup count
        uint is_nonzero = 0;

        if (gid < params.n_elements) {
            float64_t val = input_data[gid];
            is_nonzero = (val != float64_t(0.0)) ? 1u : 0u;
            // Write as float-encoded bits so prefix_sum's uintBitsToFloat()
            // sees 1.0 (normalized) instead of denormalized 1.4e-45 which
            // would be flushed to zero by GPU FTZ mode
            flags[gid] = is_nonzero != 0u ? floatBitsToUint(1.0) : 0u;
        }

        shared_count[tid] = is_nonzero;
        barrier();

        // Parallel reduction for workgroup count
        for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
            if (tid < s) {
                shared_count[tid] += shared_count[tid + s];
            }
            barrier();
        }

        if (tid == 0) {
            count[wid] = shared_count[0];
        }
    } else {
        // Pass 1: Sum workgroup counts to get total.
        // Pass 0 launched div_wg(n, WORKGROUP_SIZE) workgroups (host uses the
        // same spec-constant workgroup size), so the reduction bound must use
        // WORKGROUP_SIZE here, not a hardcoded 256 — otherwise it reads
        // uninitialized/OOB count[] entries.
        uint n_workgroups = (params.n_elements + WORKGROUP_SIZE - 1u) / WORKGROUP_SIZE;

        uint local_sum = 0;
        for (uint i = tid; i < n_workgroups; i += WORKGROUP_SIZE) {
            local_sum += count[i];
        }

        shared_count[tid] = local_sum;
        barrier();

        for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
            if (tid < s) {
                shared_count[tid] += shared_count[tid + s];
            }
            barrier();
        }

        if (tid == 0) {
            count[0] = shared_count[0];
        }
    }
}
