#version 450

// Strided copy operation for Float16: copy non-contiguous tensor to contiguous layout
// Float16 is stored as uint16, we use uint (32-bit) and handle 2 elements at once when possible
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { uint input_data[]; };   // Packed uint16 pairs
layout(binding = 1) buffer Output { uint output_data[]; }; // Packed uint16 pairs

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint ndims;
    uint base_offset;
    uvec4 shape_0_3;
    uvec4 shape_4_7;
    ivec4 strides_0_3;
    ivec4 strides_4_7;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Each thread handles one float16 element
    if (idx >= params.n_elements) {
        return;
    }

    uint remaining = idx;
    int src_offset = int(params.base_offset);

    uint shape[8];
    int strides[8];
    shape[0] = params.shape_0_3.x;
    shape[1] = params.shape_0_3.y;
    shape[2] = params.shape_0_3.z;
    shape[3] = params.shape_0_3.w;
    shape[4] = params.shape_4_7.x;
    shape[5] = params.shape_4_7.y;
    shape[6] = params.shape_4_7.z;
    shape[7] = params.shape_4_7.w;
    strides[0] = params.strides_0_3.x;
    strides[1] = params.strides_0_3.y;
    strides[2] = params.strides_0_3.z;
    strides[3] = params.strides_0_3.w;
    strides[4] = params.strides_4_7.x;
    strides[5] = params.strides_4_7.y;
    strides[6] = params.strides_4_7.z;
    strides[7] = params.strides_4_7.w;

    for (int dim = int(params.ndims) - 1; dim >= 0; dim--) {
        uint dim_idx = remaining % shape[dim];
        remaining /= shape[dim];
        src_offset += int(dim_idx) * strides[dim];
    }

    // Read source uint16 from packed uint32
    uint src_word_idx = uint(src_offset) / 2;
    uint src_half_idx = uint(src_offset) % 2;
    uint src_packed = input_data[src_word_idx];
    uint src_val = (src_half_idx == 0) ? (src_packed & 0xFFFF) : (src_packed >> 16);

    // Write to destination packed uint32
    uint dst_word_idx = idx / 2;
    uint dst_half_idx = idx % 2;

    // Atomic operation to safely update the packed value
    if (dst_half_idx == 0) {
        uint old_val = output_data[dst_word_idx];
        output_data[dst_word_idx] = (old_val & 0xFFFF0000) | src_val;
    } else {
        uint old_val = output_data[dst_word_idx];
        output_data[dst_word_idx] = (old_val & 0x0000FFFF) | (src_val << 16);
    }
}
