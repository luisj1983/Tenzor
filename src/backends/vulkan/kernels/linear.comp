#version 450

// Linear layer: output = input @ weight^T + bias
// input: (M, K), weight: (N, K), bias: (N,), output: (M, N)
// Uses tiled matrix multiplication with optional bias addition
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Weight { float weight_data[]; };
layout(binding = 2) buffer Bias { float bias_data[]; };
layout(binding = 3) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint M;        // batch size (rows of input)
    uint N;        // output features (rows of weight)
    uint K;        // input features (cols of input / cols of weight)
    uint has_bias; // 1 if bias is present, 0 otherwise
} params;

shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;  // output row (batch index)
    uint col = gl_GlobalInvocationID.x;  // output col (feature index)
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    float sum = 0.0;

    uint num_tiles = (params.K + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from input
        uint a_col = t * 16 + local_col;
        if (row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = input_data[row * params.K + a_col];
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from weight (transposed access: weight[col, k])
        uint b_row = t * 16 + local_row;
        if (col < params.N && b_row < params.K) {
            tileB[local_row][local_col] = weight_data[col * params.K + b_row];
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        for (uint k = 0; k < 16; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    if (row < params.M && col < params.N) {
        if (params.has_bias != 0) {
            sum += bias_data[col];
        }
        output_data[row * params.N + col] = sum;
    }
}
