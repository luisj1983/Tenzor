#version 450

// Matrix inverse via Gauss-Jordan elimination for small matrices (<= 32x32) - Float16 variant
// Input/output use packed uint32 buffers (2 float16 values per word)
// All computation done in float32.

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch;
};

shared float aug[32][64];

float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = data_in[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void writeF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = data_out[word_idx];
    uint new_val, expected;
    for (uint iter = 0; iter < 1024; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(data_out[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    data_out[word_idx] = new_val;
}

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;

    if (batch_idx >= batch) return;

    uint mat_offset = batch_idx * n * n;
    uint n2 = n * 2;

    // Load augmented matrix: left half = A, right half = I
    for (uint row = 0; row < n; row++) {
        if (tid < n) {
            aug[row][tid] = readF16(mat_offset + row * n + tid);
            aug[row][tid + n] = (row == tid) ? 1.0 : 0.0;
        }
    }
    barrier();

    // Gauss-Jordan elimination
    for (uint col = 0; col < n; col++) {
        if (tid == 0) {
            uint max_row = col;
            float max_val = abs(aug[col][col]);
            for (uint row = col + 1; row < n; row++) {
                float val = abs(aug[row][col]);
                if (val > max_val) {
                    max_val = val;
                    max_row = row;
                }
            }
            if (max_row != col) {
                for (uint j = 0; j < n2; j++) {
                    float tmp = aug[col][j];
                    aug[col][j] = aug[max_row][j];
                    aug[max_row][j] = tmp;
                }
            }
        }
        barrier();

        // Scale pivot row
        if (tid == 0) {
            float pivot = aug[col][col];
            if (abs(pivot) > 1e-30) {
                float inv_pivot = 1.0 / pivot;
                for (uint j = 0; j < n2; j++) {
                    aug[col][j] *= inv_pivot;
                }
            }
        }
        barrier();

        // Eliminate column in all other rows
        if (tid < n && tid != col) {
            float factor = aug[tid][col];
            for (uint j = 0; j < n2; j++) {
                aug[tid][j] -= factor * aug[col][j];
            }
        }
        barrier();
    }

    // Write inverse from right half of augmented matrix
    for (uint row = 0; row < n; row++) {
        if (tid < n) {
            writeF16(mat_offset + row * n + tid, aug[row][tid + n]);
        }
    }
}
