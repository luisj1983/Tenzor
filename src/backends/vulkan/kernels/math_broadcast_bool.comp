#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Broadcasting-aware binary operations for Boolean tensors
// Bool is stored as uint8 (1 byte per element)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { uint8_t a[]; };
layout(binding = 1) buffer InputB { uint8_t b[]; };
layout(binding = 2) buffer Output { uint8_t result[]; };

layout(push_constant) uniform PushConstants {
    uint output_size;      // Total number of output elements
    uint op;               // Operation: 0=add (OR), 1=sub, 2=mul (AND), 3=div
    uint dtype;            // Unused for bool, kept for compatibility
    uint ndim_a;           // Number of dimensions in tensor A
    uint ndim_b;           // Number of dimensions in tensor B
    uint ndim_out;         // Number of dimensions in output
    uint strides_a[8];
    uint strides_b[8];
    uint shape_out[8];
} params;

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.output_size) {
        return;
    }

    // Convert flat output index to multi-dimensional coordinates
    uint idx_a = 0;
    uint idx_b = 0;
    uint tmp = out_idx;

    for (uint i = 0; i < params.ndim_out; i++) {
        uint dim_idx = params.ndim_out - 1 - i;
        uint coord = tmp % params.shape_out[dim_idx];
        tmp /= params.shape_out[dim_idx];

        idx_a += coord * params.strides_a[dim_idx];
        idx_b += coord * params.strides_b[dim_idx];
    }

    // Boolean operations: values are 0 (false) or non-zero (true)
    bool val_a = (a[idx_a] != uint8_t(0));
    bool val_b = (b[idx_b] != uint8_t(0));
    bool res;

    switch (params.op) {
        case 0: // add -> OR for booleans
            res = val_a || val_b;
            break;
        case 1: // sub -> XOR for booleans (a and not b)
            res = val_a && !val_b;
            break;
        case 2: // mul -> AND for booleans
            res = val_a && val_b;
            break;
        case 3: // div -> same as mul (AND) for booleans
            res = val_a && val_b;
            break;
        default:
            res = false;
            break;
    }

    result[out_idx] = res ? uint8_t(1) : uint8_t(0);
}
