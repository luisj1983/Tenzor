#version 450

// Col2im (Fold) operation for BFloat16
// Transforms (N, C*K_h*K_w, L) -> (N,C,H,W) with accumulation
// BF16 packed buffers (2 BFloat16 per uint32), arithmetic in float32
// Dispatched INPUT-CENTRIC (one thread per column entry); overlapping fold
// windows make multiple threads target the same output element, so the
// accumulation MUST be atomic. Core Vulkan has no native atomicAdd for
// packed BF16, so we use an atomicCompSwap CAS loop on the enclosing uint32
// word (same pattern as avg_pool2d_backward_bf16 / put_bf16). This makes the
// fold deterministic and matches the F32 atomicAdd path. Arithmetic is in
// float32 with round-to-nearest-even narrowing back to BF16.
// HH.6: per-axis kernel/stride/padding/dilation.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;    // Total elements to process
    uint batch;
    uint channels;
    uint height;
    uint width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint dil_h;
    uint dil_w;
    uint out_h;
    uint out_w;
} params;

// Read a single bfloat16 element from packed uint buffer
float readBF16Input(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Atomically add a value (in float32) into a packed BF16 output element.
// Since there's no native BF16 atomicAdd, use a bounded CAS loop on the
// enclosing uint32 word, touching only the target half. Narrowing uses
// round-to-nearest-even. (Pattern shared with avg_pool2d_backward_bf16.)
void atomicAddBF16Output(uint element_idx, float add_val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint mask = 0xFFFFu << (half_idx * 16);

    uint old_val = output_data[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        uint bits = (expected >> (half_idx * 16)) & 0xFFFFu;
        float current = uintBitsToFloat(bits << 16);
        float updated = current + add_val;
        uint new_bits = ((floatBitsToUint(updated) + 0x7FFFu + ((floatBitsToUint(updated) >> 16) & 1u)) >> 16);

        // Build the new word with only the target half changed
        new_val = (expected & ~mask) | (new_bits << (half_idx * 16));

        old_val = atomicCompSwap(output_data[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word.
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Calculate derived values
    uint num_blocks = params.out_h * params.out_w;
    uint col_channels = params.channels * params.kernel_h * params.kernel_w;

    // Decode flat index to (b, col_c, block_idx)
    uint temp = idx;
    uint block_idx = temp % num_blocks; temp /= num_blocks;
    uint col_c = temp % col_channels; temp /= col_channels;
    uint b = temp;

    // Decode col_c to (c, kh, kw)
    uint kw = col_c % params.kernel_w;
    uint kh = (col_c / params.kernel_w) % params.kernel_h;
    uint c = col_c / (params.kernel_h * params.kernel_w);

    // Calculate output position from block_idx
    uint oh = block_idx / params.out_w;
    uint ow = block_idx % params.out_w;

    // Calculate output position in image
    int ih = int(oh * params.stride_h) - int(params.pad_h) + int(kh * params.dil_h);
    int iw = int(ow * params.stride_w) - int(params.pad_w) + int(kw * params.dil_w);

    // Check bounds
    if (ih >= 0 && ih < int(params.height) && iw >= 0 && iw < int(params.width)) {
        uint input_idx = b * (col_channels * num_blocks) +
                        col_c * num_blocks +
                        block_idx;

        uint output_idx = b * (params.channels * params.height * params.width) +
                         c * (params.height * params.width) +
                         uint(ih) * params.width + uint(iw);

        // Read input value, atomically accumulate into the output element.
        float in_val = readBF16Input(input_idx);
        atomicAddBF16Output(output_idx, in_val);
    }
}
