#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Bool predicate operations: isnan, isinf, isfinite
// Input: float, Output: uint8_t (Bool)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { float a[]; };
layout(binding = 1) buffer Output { uint8_t result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=isnan, 1=isinf, 2=isfinite
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    float val = a[idx];
    uint8_t result_val;

    switch (params.op) {
        case 0: // isnan
            result_val = isnan(val) ? uint8_t(1) : uint8_t(0);
            break;
        case 1: // isinf
            result_val = isinf(val) ? uint8_t(1) : uint8_t(0);
            break;
        case 2: // isfinite
            result_val = (!isnan(val) && !isinf(val)) ? uint8_t(1) : uint8_t(0);
            break;
        default:
            result_val = uint8_t(0);
            break;
    }

    result[idx] = result_val;
}
