#version 450
#extension GL_EXT_shader_atomic_float : enable

// Grid sample backward (bilinear and nearest, configurable padding) for 2D.
// Audit Q.4: replaces the previous CPU shuttle in function_vision.cpp.
// Float32 only — host dispatcher promotes/demotes via dispatchCast.
//
// F072 (KNOWN VULKAN CONSTRAINT): this backward (and affine_grid backward,
// affine_grid_backward.comp) is computed in Float32 for every dtype. CPU/CUDA/
// ROCm/OneAPI have native Float64 backward paths, so a Float64 grid_sample /
// affine_grid gradcheck on Vulkan is evaluated in FP32 and truncated and will
// NOT match the CPU FP64 reference to tight tolerance. There is no FP64
// grid_sample/affine_grid backward shader variant; relax the Vulkan tolerance
// for Float64 grid_sample/affine_grid or add an FP64 shader if exact FP64
// gradients are required.
//
// One thread per (n, h_out, w_out) output spatial location. Each thread
// loops over channels, scatters grad_input via atomicAdd (overlapping
// neighbours under bilinear) and writes the single (n,h,w,:) entry of
// grad_grid directly.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputBuf      { float input_data[]; };       // (N,C,H_in,W_in)
layout(binding = 1) buffer GridBuf       { float grid_data[]; };        // (N,H_out,W_out,2)
layout(binding = 2) buffer GradOutputBuf { float grad_output[]; };      // (N,C,H_out,W_out)
layout(binding = 3) buffer GradInputBuf  { float grad_input[]; };       // (N,C,H_in,W_in)
layout(binding = 4) buffer GradGridBuf   { float grad_grid[]; };        // (N,H_out,W_out,2)

layout(push_constant) uniform PushConstants {
    int N;
    int C;
    int H_in;
    int W_in;
    int H_out;
    int W_out;
    int padding_mode;   // 0=zeros, 1=border, 2=reflection
    int align_corners;  // bool as int
    int mode;           // 0=bilinear, 1=nearest
    int total;          // N*H_out*W_out
} params;

float denormalize(float coord, int size) {
    if (params.align_corners != 0) {
        return (coord + 1.0) * 0.5 * float(size - 1);
    }
    return ((coord + 1.0) * float(size) - 1.0) * 0.5;
}

float reflect_coord(float coord, int size, int align_corners) {
    if (size <= 1) return 0.0;
    float twice_low  = (align_corners != 0) ? 0.0 : -1.0;
    float twice_high = (align_corners != 0) ? float(2 * (size - 1)) : float(2 * size - 1);
    float mn = twice_low * 0.5;
    float span = (twice_high - twice_low) * 0.5;
    float c = abs(coord - mn);
    float extra = mod(c, span);
    int flips = int(floor(c / span));
    float reflected = ((flips % 2) == 0) ? (extra + mn) : (span - extra + mn);
    return clamp(reflected, 0.0, float(size - 1));
}

// d(reflect_coord)/d(coord): +1 or -1 fold-sign (align_corners-aware). The
// backward must chain this into grad_grid for reflection padding.
float reflect_coord_grad(float coord, int size, int align_corners) {
    if (size <= 1) return 0.0;
    float twice_low  = (align_corners != 0) ? 0.0 : -1.0;
    float twice_high = (align_corners != 0) ? float(2 * (size - 1)) : float(2 * size - 1);
    float mn = twice_low * 0.5;
    float span = (twice_high - twice_low) * 0.5;
    float d = coord - mn;
    float s = (d < 0.0) ? -1.0 : 1.0;
    int flips = int(floor(abs(d) / span));
    if ((flips % 2) != 0) s = -s;
    return s;
}

float safe_get(int n, int c, int y, int x) {
    if (y >= 0 && y < params.H_in && x >= 0 && x < params.W_in) {
        return input_data[((n * params.C + c) * params.H_in + y) * params.W_in + x];
    }
    return 0.0;
}

// Bicubic neighbour fetch with padding (matches forward bicubic_get).
float bicubic_get(int n, int c, int y, int x) {
    if (params.padding_mode == 0) {
        if (y < 0 || y >= params.H_in || x < 0 || x >= params.W_in) return 0.0;
    } else {
        y = clamp(y, 0, params.H_in - 1);
        x = clamp(x, 0, params.W_in - 1);
    }
    return input_data[((n * params.C + c) * params.H_in + y) * params.W_in + x];
}

void cubic_weights(float t, out float w[4]) {
    float a = -0.5;
    float t2 = t * t;
    float t3 = t2 * t;
    w[0] = ((a * t - 2.0 * a) * t + a) * t;
    w[1] = ((a + 2.0) * t3 - (a + 3.0) * t2 + 1.0);
    float u = 1.0 - t;
    float u2 = u * u;
    float u3 = u2 * u;
    w[2] = ((a + 2.0) * u3 - (a + 3.0) * u2 + 1.0);
    w[3] = ((a * u - 2.0 * a) * u + a) * u;
}

void cubic_dweights(float t, out float dw[4]) {
    float a = -0.5;
    float u = 1.0 - t;
    dw[0] = (3.0 * a * t * t - 4.0 * a * t + a);
    dw[1] = (3.0 * (a + 2.0) * t * t - 2.0 * (a + 3.0) * t);
    dw[2] = -(3.0 * (a + 2.0) * u * u - 2.0 * (a + 3.0) * u);
    dw[3] = -(3.0 * a * u * u - 4.0 * a * u + a);
}

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= params.total) return;

    int w = idx % params.W_out;
    int h = (idx / params.W_out) % params.H_out;
    int n = idx / (params.W_out * params.H_out);

    int grid_idx = ((n * params.H_out + h) * params.W_out + w) * 2;
    float gx = grid_data[grid_idx];
    float gy = grid_data[grid_idx + 1];
    float ix = denormalize(gx, params.W_in);
    float iy = denormalize(gy, params.H_in);

    bool in_bounds_ix = (ix >= 0.0 && ix <= float(params.W_in - 1));
    bool in_bounds_iy = (iy >= 0.0 && iy <= float(params.H_in - 1));

    // Reflection contributes a +/-1 fold-sign to the coordinate gradient;
    // capture it from the PRE-reflection coordinate before ix/iy are overwritten.
    float refl_sign_x = 1.0;
    float refl_sign_y = 1.0;
    if (params.padding_mode == 1) {
        ix = clamp(ix, 0.0, float(params.W_in - 1));
        iy = clamp(iy, 0.0, float(params.H_in - 1));
    } else if (params.padding_mode == 2) {
        refl_sign_x = reflect_coord_grad(ix, params.W_in, params.align_corners);
        refl_sign_y = reflect_coord_grad(iy, params.H_in, params.align_corners);
        ix = reflect_coord(ix, params.W_in, params.align_corners);
        iy = reflect_coord(iy, params.H_in, params.align_corners);
    }

    if (params.mode == 1) {
        // nearest
        int nx = int(round(ix));
        int ny = int(round(iy));
        grad_grid[grid_idx]     = 0.0;
        grad_grid[grid_idx + 1] = 0.0;
        if (ny >= 0 && ny < params.H_in && nx >= 0 && nx < params.W_in) {
            for (int c = 0; c < params.C; ++c) {
                float go = grad_output[((n * params.C + c) * params.H_out + h) * params.W_out + w];
                atomicAdd(grad_input[((n * params.C + c) * params.H_in + ny) * params.W_in + nx], go);
            }
        }
        return;
    }

    float dix_dgx, diy_dgy;
    if (params.align_corners != 0) {
        dix_dgx = 0.5 * float(params.W_in - 1);
        diy_dgy = 0.5 * float(params.H_in - 1);
    } else {
        dix_dgx = 0.5 * float(params.W_in);
        diy_dgy = 0.5 * float(params.H_in);
    }
    dix_dgx *= refl_sign_x;
    diy_dgy *= refl_sign_y;

    if (params.mode == 2) {
        // bicubic backward (Catmull-Rom 4x4): scatter grad_input via atomicAdd
        // and accumulate grad_grid from the cubic derivative weights.
        int ix_floor = int(floor(ix));
        int iy_floor = int(floor(iy));
        float tx = ix - float(ix_floor);
        float ty = iy - float(iy_floor);
        float wx[4]; float wy[4]; float dwx[4]; float dwy[4];
        cubic_weights(tx, wx);
        cubic_weights(ty, wy);
        cubic_dweights(tx, dwx);
        cubic_dweights(ty, dwy);

        float sum_dx = 0.0;
        float sum_dy = 0.0;
        for (int c = 0; c < params.C; ++c) {
            float go = grad_output[((n * params.C + c) * params.H_out + h) * params.W_out + w];
            float dval_dix = 0.0;
            float dval_diy = 0.0;
            for (int dy = -1; dy <= 2; ++dy) {
                for (int dx = -1; dx <= 2; ++dx) {
                    int yy = iy_floor + dy;
                    int xx = ix_floor + dx;
                    float weight = wy[dy + 1] * wx[dx + 1];
                    // Scatter (padding-aware): zeros => skip OOB; border/reflection => clamp.
                    if (params.padding_mode == 0) {
                        if (yy >= 0 && yy < params.H_in && xx >= 0 && xx < params.W_in) {
                            atomicAdd(grad_input[((n * params.C + c) * params.H_in + yy) * params.W_in + xx],
                                      go * weight);
                        }
                    } else {
                        int cy = clamp(yy, 0, params.H_in - 1);
                        int cx = clamp(xx, 0, params.W_in - 1);
                        atomicAdd(grad_input[((n * params.C + c) * params.H_in + cy) * params.W_in + cx],
                                  go * weight);
                    }
                    float v = bicubic_get(n, c, yy, xx);
                    dval_dix += wy[dy + 1] * dwx[dx + 1] * v;
                    dval_diy += dwy[dy + 1] * wx[dx + 1] * v;
                }
            }
            sum_dx += go * dval_dix;
            sum_dy += go * dval_diy;
        }
        grad_grid[grid_idx]     = sum_dx * dix_dgx;
        grad_grid[grid_idx + 1] = sum_dy * diy_dgy;
        return;
    }

    // bilinear

    int x0 = int(floor(ix));
    int y0 = int(floor(iy));
    int x1 = x0 + 1;
    int y1 = y0 + 1;
    float wx1 = ix - float(x0);
    float wy1 = iy - float(y0);
    float wx0 = 1.0 - wx1;
    float wy0 = 1.0 - wy1;

    float sum_dx = 0.0;
    float sum_dy = 0.0;

    for (int c = 0; c < params.C; ++c) {
        float go = grad_output[((n * params.C + c) * params.H_out + h) * params.W_out + w];

        // Scatter grad_input via atomicAdd (four neighbours, bounds-checked).
        if (y0 >= 0 && y0 < params.H_in && x0 >= 0 && x0 < params.W_in) {
            atomicAdd(grad_input[((n * params.C + c) * params.H_in + y0) * params.W_in + x0],
                      go * wy0 * wx0);
        }
        if (y0 >= 0 && y0 < params.H_in && x1 >= 0 && x1 < params.W_in) {
            atomicAdd(grad_input[((n * params.C + c) * params.H_in + y0) * params.W_in + x1],
                      go * wy0 * wx1);
        }
        if (y1 >= 0 && y1 < params.H_in && x0 >= 0 && x0 < params.W_in) {
            atomicAdd(grad_input[((n * params.C + c) * params.H_in + y1) * params.W_in + x0],
                      go * wy1 * wx0);
        }
        if (y1 >= 0 && y1 < params.H_in && x1 >= 0 && x1 < params.W_in) {
            atomicAdd(grad_input[((n * params.C + c) * params.H_in + y1) * params.W_in + x1],
                      go * wy1 * wx1);
        }

        float v00 = safe_get(n, c, y0, x0);
        float v01 = safe_get(n, c, y0, x1);
        float v10 = safe_get(n, c, y1, x0);
        float v11 = safe_get(n, c, y1, x1);

        sum_dx += go * (wy0 * (-v00 + v01) + wy1 * (-v10 + v11));
        sum_dy += go * (wx0 * (-v00 + v10) + wx1 * (-v01 + v11));
    }

    // For both zeros (0) and border (1) padding, an out-of-bounds (clamped)
    // coordinate does not move the sampled value as the grid changes, so its
    // grid-gradient is 0. The previous condition only handled zeros padding,
    // leaving a spurious grad_grid under border padding when the coord clamped.
    float scale_x = (params.padding_mode <= 1 && !in_bounds_ix) ? 0.0 : dix_dgx;
    float scale_y = (params.padding_mode <= 1 && !in_bounds_iy) ? 0.0 : diy_dgy;
    grad_grid[grid_idx]     = sum_dx * scale_x;
    grad_grid[grid_idx + 1] = sum_dy * scale_y;
}
