#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Col2im (Fold) operation for Float64.
// Transforms (N, C*K_h*K_w, L) -> (N,C,H,W) with accumulation of overlapping
// patches. Core Vulkan has no atomicAdd for float64, so this uses an
// OUTPUT-CENTRIC GATHER: one thread per output element (b,c,ih,iw) loops over
// every kernel position that maps onto it, sums the contributing column entries
// locally, and writes the result exactly once. This avoids the data race the
// previous input-centric read-modify-write had when sliding windows overlap.
// (The Float32/Float16/BFloat16 variants use atomicAdd instead.)
// HH.6: per-axis kernel/stride/padding/dilation.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float64_t input_data[]; };
layout(binding = 1) buffer Output { float64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;    // Total OUTPUT elements to process (batch*channels*H*W)
    uint batch;
    uint channels;
    uint height;
    uint width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint dil_h;
    uint dil_w;
    uint out_h;
    uint out_w;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint num_blocks = params.out_h * params.out_w;
    uint col_channels = params.channels * params.kernel_h * params.kernel_w;

    // Decode flat OUTPUT index to (b, c, ih, iw)
    uint temp = idx;
    uint iw = temp % params.width;    temp /= params.width;
    uint ih = temp % params.height;   temp /= params.height;
    uint c  = temp % params.channels; temp /= params.channels;
    uint b  = temp;

    float64_t sum = 0.0lf;

    // Gather every (kh, kw) whose sliding window lands on (ih, iw):
    //   ih = oh*stride_h - pad_h + kh*dil_h  =>  oh = (ih + pad_h - kh*dil_h)/stride_h
    // valid only when the numerator is non-negative, divisible by the stride,
    // and the resulting oh/ow are within the output extent.
    for (uint kh = 0; kh < params.kernel_h; ++kh) {
        int oh_num = int(ih) + int(params.pad_h) - int(kh * params.dil_h);
        if (oh_num < 0) continue;
        if (uint(oh_num) % params.stride_h != 0u) continue;
        uint oh = uint(oh_num) / params.stride_h;
        if (oh >= params.out_h) continue;

        for (uint kw = 0; kw < params.kernel_w; ++kw) {
            int ow_num = int(iw) + int(params.pad_w) - int(kw * params.dil_w);
            if (ow_num < 0) continue;
            if (uint(ow_num) % params.stride_w != 0u) continue;
            uint ow = uint(ow_num) / params.stride_w;
            if (ow >= params.out_w) continue;

            uint col_c = c * (params.kernel_h * params.kernel_w) + kh * params.kernel_w + kw;
            uint block_idx = oh * params.out_w + ow;
            uint input_idx = b * (col_channels * num_blocks) + col_c * num_blocks + block_idx;
            sum += input_data[input_idx];
        }
    }

    uint output_idx = b * (params.channels * params.height * params.width) +
                      c * (params.height * params.width) +
                      ih * params.width + iw;
    // Each output element is written exactly once — no atomics, no race.
    output_data[output_idx] = sum;
}
