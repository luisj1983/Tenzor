#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Log Softmax with numerical stability for Float16
// Float16 elements are packed 2 per 32-bit word
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint dim;
} params;

shared float shared_max[WORKGROUP_SIZE];
shared float shared_sum[WORKGROUP_SIZE];

// Read a single float16 value from packed buffer
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write a single float16 value to the packed output buffer using atomic CAS.
// Two adjacent threads in a row write the two halves of the same 32-bit word
// (element 0 → low half, element 1 → high half). A plain read-modify-write
// would let the last writer clobber the neighbour's half-word, so we must use
// a bounded atomicCompSwap loop (mirrors softmax_f16.comp).
void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = output_data[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(output_data[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT add a non-atomic fallback store — it would clobber the
    // neighbouring packed half-word.
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.num_classes;

    // Step 1: Find maximum for numerical stability
    float local_max = -1.0 / 0.0; // -infinity
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        local_max = max(local_max, readF16(base_idx + i));
    }
    shared_max[tid] = local_max;
    barrier();

    // Parallel reduction for max
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
        }
        barrier();
    }

    float row_max = shared_max[0];
    barrier();

    // Step 2: Compute sum(exp(x - max))
    float local_sum = 0.0;
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        local_sum += exp(readF16(base_idx + i) - row_max);
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    float log_sum_exp = log(shared_sum[0]);
    barrier();

    // Step 3: Compute log_softmax = x - max - log(sum(exp(x - max)))
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        float result = readF16(base_idx + i) - row_max - log_sum_exp;
        writeF16(base_idx + i, result);
    }
}
