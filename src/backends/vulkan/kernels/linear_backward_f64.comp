#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Linear backward for Float64 — computes grad_input = grad_output @ weight
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer GradOutput { double grad_output[]; };
layout(binding = 1) buffer Weight { double weight_data[]; };
layout(binding = 2) buffer GradInput { double grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
} params;

shared double tileA[16][16];
shared double tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    double sum = 0.0;

    uint num_tiles = (params.N + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        uint a_col = t * 16 + local_col;
        if (row < params.M && a_col < params.N) {
            tileA[local_row][local_col] = grad_output[row * params.N + a_col];
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        uint b_row = t * 16 + local_row;
        if (b_row < params.N && col < params.K) {
            tileB[local_row][local_col] = weight_data[b_row * params.K + col];
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        for (uint k = 0; k < 16; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    if (row < params.M && col < params.K) {
        grad_input[row * params.K + col] = sum;
    }
}
