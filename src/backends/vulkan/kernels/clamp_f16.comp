#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Clamp operation for Float16: clamp values to [min, max] range
// Float16 elements are packed 2 per uint32
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;    // Number of elements (in float16 count)
    float min_value;    // Minimum value (as float, cast to f16 in shader)
    float max_value;    // Maximum value (as float, cast to f16 in shader)
} params;

// Helper to read float16 from packed buffer
float16_t readF16(uint packed, uint offset) {
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

// Helper to pack two float16 values
uint packF16Pair(float16_t v0, float16_t v1) {
    uint bits0 = packHalf2x16(vec2(float(v0), 0.0)) & 0xFFFFu;
    uint bits1 = packHalf2x16(vec2(float(v1), 0.0)) & 0xFFFFu;
    return bits0 | (bits1 << 16);
}

void main() {
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    if (idx0 >= params.n_elements) return;

    uint packed = input_data[pair_idx];
    float val0 = float(readF16(packed, 0));
    float val1 = float(readF16(packed, 1));

    // Clamp in float32 for precision, then convert back
    val0 = max(params.min_value, min(params.max_value, val0));
    val1 = max(params.min_value, min(params.max_value, val1));

    // Handle odd number of elements
    if (idx1 >= params.n_elements) {
        val1 = 0.0;
    }

    output_data[pair_idx] = packF16Pair(float16_t(val0), float16_t(val1));
}
