#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Log-Cumulative-Sum-Exp along a dimension — Float64 variant
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float64_t input_data[]; };
layout(binding = 1) buffer Output { float64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint total_lines;
    uint reduce_size;
    uint inner_size;
} params;

void main() {
    uint line_idx = gl_GlobalInvocationID.x;
    if (line_idx >= params.total_lines) return;

    uint outer_idx = line_idx / params.inner_size;
    uint inner_idx = line_idx % params.inner_size;

    uint base = outer_idx * params.reduce_size * params.inner_size + inner_idx;

    float64_t running = input_data[base];
    output_data[base] = running;

    for (uint i = 1; i < params.reduce_size; i++) {
        uint idx = base + i * params.inner_size;
        float64_t x = input_data[idx];

        float64_t m = max(running, x);
        float64_t diff = abs(running - x);

        if (diff > 50.0LF) {
            running = m;
        } else {
            // exp/log not available for float64 in GLSL; compute in float32
            float fdiff = float(-diff);
            running = m + float64_t(log(1.0 + exp(fdiff)));
        }
        output_data[idx] = running;
    }
}
