#version 450

// ScatterReduce (Int32): scatter integer source values into output along a
// dimension with reduction. Integer atomics are core Vulkan, so no CAS loop is
// needed for sum/min/max; prod uses a bounded CAS loop. Narrow integers widen
// losslessly to Int32 on the host; Int64 narrows to Int32. Previously every
// integer dtype was routed through the Float32 shader, which rounded values
// above 2^24 and reinterpreted integer bits as floats.
// Modes: 0=sum, 1=prod, 2=mean(sum pass), 3=amax, 4=amin
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { int out_data[]; };       // Output (int atomics)
layout(binding = 1) buffer Source { int src_data[]; };        // Source values
layout(binding = 2) buffer Index  { int idx_data[]; };        // 1-D index tensor (int32)
layout(binding = 3) buffer Counts { int count_data[]; };      // Count buffer (for mean mode)

layout(push_constant) uniform PushConstants {
    uint n;                 // index.numel()
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uint mode;              // 0=sum, 1=prod, 2=mean, 3=amax, 4=amin
    uint pad0;
    uint pad1;
    uint pad2;
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

void atomicMulInt(uint pos, int val) {
    int old_val = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        int new_val = old_val * val;
        int result = atomicCompSwap(out_data[pos], old_val, new_val);
        if (result == old_val) return;
        old_val = result;
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= params.n) return;

    int dest_idx = idx_data[tid];
    if (dest_idx < 0) dest_idx += int(params.dim_size);
    if (dest_idx < 0 || dest_idx >= int(params.dim_size)) return;

    // Per-dim decode of the flat index position, recomposed onto self strides.
    uint temp = tid;
    uint out_pos = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_pos += uint(dest_idx) * selfStride(d);
        } else {
            out_pos += coord * selfStride(d);
        }
    }

    int val = src_data[tid];

    if (params.mode == 0u || params.mode == 2u) {
        atomicAdd(out_data[out_pos], val);
        if (params.mode == 2u) {
            atomicAdd(count_data[out_pos], 1);
        }
    } else if (params.mode == 1u) {
        atomicMulInt(out_pos, val);
    } else if (params.mode == 3u) {
        atomicMax(out_data[out_pos], val);
    } else if (params.mode == 4u) {
        atomicMin(out_data[out_pos], val);
    }
}
