#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Bitwise OR (int64, native) -- see bitwise_and_i64.comp for rationale.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputA { int64_t data[]; } a_buf;
layout(set = 0, binding = 1) readonly buffer InputB { int64_t data[]; } b_buf;
layout(set = 0, binding = 2) writeonly buffer OutputBuffer { int64_t data[]; } output_buf;

layout(push_constant) uniform PushConstants { uint num_elements; } pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    output_buf.data[idx] = a_buf.data[idx] | b_buf.data[idx];
}
