#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Average Pooling 1D Backward Pass - Float64 variant
// Input-centric gather pattern: one thread per input element, no atomics needed.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { double grad_output[]; };  // (N, C, L_out)
layout(binding = 1) buffer GradInput { double grad_input[]; };    // (N, C, L)

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint in_length;
    uint out_length;
    uint kernel_size;
    uint stride;
    uint padding;
    uint count_include_pad;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Decode flat index to (n, c, l_in) - now over INPUT elements
    uint temp = idx;
    uint l_in = temp % params.in_length;
    temp /= params.in_length;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Which output positions have pooling windows that cover l_in?
    // Window for l_out starts at: l_out * stride - padding
    // It covers [l_out * stride - padding, l_out * stride - padding + kernel_size - 1]
    // We need: l_out * stride - padding <= l_in <= l_out * stride - padding + kernel_size - 1
    // => l_in - kernel_size + 1 + padding <= l_out * stride <= l_in + padding
    // => ceil((l_in + padding - kernel_size + 1) / stride) <= l_out <= (l_in + padding) / stride

    int numerator = int(l_in) + int(params.padding) - int(params.kernel_size) + 1;
    int l_out_min;
    if (numerator <= 0) {
        l_out_min = 0;
    } else {
        // Ceiling division for positive integers: (a + b - 1) / b
        l_out_min = (numerator + int(params.stride) - 1) / int(params.stride);
    }

    int l_out_max_candidate = (int(l_in) + int(params.padding)) / int(params.stride);
    int l_out_max = min(l_out_max_candidate, int(params.out_length) - 1);

    double sum = 0.0lf;

    for (int l_out = l_out_min; l_out <= l_out_max; l_out++) {
        int l_start = l_out * int(params.stride) - int(params.padding);

        // Compute the pool count for this output position
        uint count = 0;
        if (params.count_include_pad != 0) {
            count = params.kernel_size;
        } else {
            for (uint k = 0; k < params.kernel_size; k++) {
                int pos = l_start + int(k);
                if (pos >= 0 && pos < int(params.in_length)) {
                    count++;
                }
            }
        }

        if (count > 0) {
            uint out_idx = n * params.channels * params.out_length +
                          c * params.out_length + uint(l_out);
            sum += grad_output[out_idx] / double(count);
        }
    }

    grad_input[idx] = sum;
}
