#version 450

// Ones operation: create tensor filled with 1.0 (or 1 for integer types)
layout(local_size_x = 256) in;

layout(binding = 0) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Number of elements
    uint one_value_bits; // Bits for value 1.0 or 1 (depends on dtype)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    output_data[idx] = params.one_value_bits;
}
