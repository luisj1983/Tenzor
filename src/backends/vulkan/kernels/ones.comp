#version 450

// Ones operation: create tensor filled with 1.0
layout(local_size_x = 256) in;

layout(binding = 0) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;   // Number of elements
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    output_data[idx] = 1.0;
}
