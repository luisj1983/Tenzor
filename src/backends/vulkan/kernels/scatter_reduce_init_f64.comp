#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// scatter_reduce !include_self init pass (Float64).
// Writes the per-mode identity value to every output position that will be
// touched by the subsequent scatter_reduce_f64 dispatch.
// Modes: 0=sum, 1=prod, 2=mean, 3=amax, 4=amin
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint64_t out_data[]; };  // float64 storage as uint64
layout(binding = 1) buffer Index  { int idx_data[]; };

layout(push_constant) uniform PushConstants {
    uint outer;
    uint dim_size;
    uint idx_n;
    uint inner;
    uint mode;
} params;

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

float64_t identity_for(uint mode) {
    if (mode == 0u || mode == 2u) return 0.0LF;                 // sum / mean
    if (mode == 1u) return 1.0LF;                               // prod
    if (mode == 3u) return -1.7976931348623157e+308LF;          // amax (-DBL_MAX)
    return 1.7976931348623157e+308LF;                           // amin (+DBL_MAX)
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total = params.outer * params.idx_n * params.inner;
    if (tid >= total) return;

    uint j = tid % params.inner;
    uint k = (tid / params.inner) % params.idx_n;
    uint o = tid / (params.inner * params.idx_n);

    uint idx_pos = (o * params.idx_n + k) * params.inner + j;
    int dest = idx_data[idx_pos];
    if (dest < 0 || dest >= int(params.dim_size)) return;

    uint out_pos = (o * params.dim_size + uint(dest)) * params.inner + j;
    out_data[out_pos] = f64ToBits(identity_for(params.mode));
}
