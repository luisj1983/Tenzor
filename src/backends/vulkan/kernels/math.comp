#version 450

// Math operations: add, sub, mul, div, sqrt, exp, log, neg, abs, pow, sign, floor, ceil, round, trunc, reciprocal,
//   log2, log10, log1p, exp2, expm1, erf, erfc, atan2, fmod, remainder, minimum, maximum
// Supports denormal number preservation for add/sub operations
layout(local_size_x_id = 0) in;

// Use uint buffers for raw bit access to support denormal preservation
layout(binding = 0) buffer InputA { uint a[]; };
layout(binding = 1) buffer InputB { uint b[]; };
layout(binding = 2) buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 4=sqrt, 5=exp, 6=log, 7=neg, 8=abs, 9=pow, 10=sign, 11=floor, 12=ceil, 13=round, 14=trunc, 15=reciprocal, 16=log2, 17=log10, 18=log1p, 19=exp2, 20=expm1, 21=erf, 22=erfc, 23=atan2, 24=fmod, 25=remainder, 26=minimum, 27=maximum, 28=rsqrt, 29=square, 30=asinh, 31=acosh, 32=atanh, 33=hypot, 34=copysign, 35=nextafter, 36=gcd, 37=lcm, 38=igamma, 39=igammac, 40=addcmul, 41=addcdiv, 42=fmax, 43=fmin, 44=deg2rad, 45=rad2deg, 46=logit, 47=float_power, 48=xlog1py, 49=ldexp, 50=frac, 51=log_sigmoid, 52=bitwise_not
    float param;     // Parameter for operations like pow (exponent), addcmul/addcdiv (value)
} params;

// ----- High-accuracy Float32 erf -----
// Port of fdlibm's `erff.c` (single-precision rational approximations).
// Achieves ~1 ULP accuracy across the full range, vs ~3-5e-7 for the
// previous A&S 7.1.26 5-coefficient polynomial. Needed so cross-backend
// parity tests against CPU oneDNN's libm erf pass within tight Float32
// tolerances (atol ~1e-7).
//
// Four sub-ranges:
//   |x| < 0.84375    — series for erf
//   |x| < 1.25       — rational on (|x|-1)
//   |x| < 3.75       — erfc rational, range a
//   |x| <= ~10       — erfc rational, range b (then erf = 1 - erfc)
//   |x| > ~3.92      — saturate to ±1
float erf_f32(float x) {
    if (isnan(x)) return x;
    float sgn = (x < 0.0) ? -1.0 : 1.0;
    float ax = abs(x);

    // Saturation: erf(x) is ±1 to within Float32 for |x| > ~3.92.
    if (ax >= 3.92) return sgn;

    // Range 1: |x| < 0.84375 — series for erf
    if (ax < 0.84375) {
        // Below ~1e-4 the higher-order terms are below Float32 precision;
        // first-term linearisation is correct.
        if (ax < 9.7656250e-4) {
            return sgn * ax * 1.1283791670955126; // 2/sqrt(pi)
        }
        float z = ax * ax;
        // fdlibm float-precision P,Q for |x| < 0.84375
        float p = 1.28379166e-01 + z * (-3.25042114e-01 + z * (-2.84817555e-02 +
                  z * (-5.77027030e-03 + z * (-2.37630166e-05))));
        float q = 1.0 + z * (3.97917223e-01 + z * (6.50222499e-02 +
                  z * (5.08130628e-03 + z * (1.32494738e-04 + z * (-3.96022827e-06)))));
        return sgn * (ax + ax * (p / q));
    }

    // Range 2: 0.84375 <= |x| < 1.25 — rational on (|x| - 1)
    if (ax < 1.25) {
        float s = ax - 1.0;
        float P = -2.36211856e-03 + s * (4.14856118e-01 + s * (-3.72207876e-01 +
                  s * (3.18346619e-01 + s * (-1.10894694e-01 + s * (3.54783043e-02 +
                  s * (-2.16637559e-03))))));
        float Q = 1.0 + s * (1.06420880e-01 + s * (5.40397917e-01 + s * (7.18286544e-02 +
                  s * (1.26171219e-01 + s * (1.36370839e-02 + s * 1.19844998e-02)))));
        const float erx = 8.45062911e-01; // erf(1)
        return sgn * (erx + P / Q);
    }

    // Range 3 & 4: 1.25 <= |x| < 3.92 — use erfc-rational form.
    //   erfc(x) ≈ (1/x) * exp(-x*x - 0.5625) * R(1/x²) / S(1/x²)
    float s = 1.0 / (ax * ax);
    float R, S;
    if (ax < 2.857142857) {
        // Range a: 1.25 <= |x| < ~2.857
        R = -9.86494403e-03 + s * (-6.93858572e-01 + s * (-1.05586262e+01 +
            s * (-6.23753324e+01 + s * (-1.62396669e+02 + s * (-1.84605092e+02 +
            s * (-8.12874355e+01 + s * (-9.81432934e+00)))))));
        S = 1.0 + s * (1.96512716e+01 + s * (1.37657754e+02 + s * (4.34565877e+02 +
            s * (6.45387271e+02 + s * (4.29008140e+02 + s * (1.08635005e+02 +
            s * (6.57024977e+00 + s * (-6.04244152e-02))))))));
    } else {
        // Range b: 2.857 <= |x| < 3.92
        R = -9.86494292e-03 + s * (-7.99283237e-01 + s * (-1.77579549e+01 +
            s * (-1.60636384e+02 + s * (-6.37566443e+02 + s * (-1.25029579e+03 +
            s * (-1.05089413e+03 + s * (-3.70319441e+02 + s * (-3.56042851e+01))))))));
        S = 1.0 + s * (3.03380607e+01 + s * (3.25792510e+02 + s * (1.53672857e+03 +
            s * (3.19985824e+03 + s * (2.55305040e+03 + s * (4.74528542e+02 +
            s * (-2.24409525e+01)))))));
    }
    // fdlibm: r = exp(-x²-0.5625) * exp(R/S) / x, then erfc = r, erf = 1 - r.
    // The two-stage exp keeps both factors representable; merging them via
    // exp((-x²-0.5625) + R/S) is also fine but composes the rounding errors.
    float erfc_val = exp(-ax * ax - 0.5625) * exp(R / S) / ax;
    return sgn * (1.0 - erfc_val);
}

// High-accuracy Float32 erfc = 1 - erf, but for large |x| use the erfc rational
// directly (avoids cancellation when erf(x) ≈ 1).
float erfc_f32(float x) {
    if (isnan(x)) return x;
    float ax = abs(x);
    if (ax >= 3.92) return (x < 0.0) ? 2.0 : 0.0;
    // For |x| < 1.25, 1 - erf(x) has no catastrophic cancellation.
    if (ax < 1.25) {
        return 1.0 - erf_f32(x);
    }
    // Direct erfc rational for |x| >= 1.25.
    float s = 1.0 / (ax * ax);
    float R, S;
    if (ax < 2.857142857) {
        R = -9.86494403e-03 + s * (-6.93858572e-01 + s * (-1.05586262e+01 +
            s * (-6.23753324e+01 + s * (-1.62396669e+02 + s * (-1.84605092e+02 +
            s * (-8.12874355e+01 + s * (-9.81432934e+00)))))));
        S = 1.0 + s * (1.96512716e+01 + s * (1.37657754e+02 + s * (4.34565877e+02 +
            s * (6.45387271e+02 + s * (4.29008140e+02 + s * (1.08635005e+02 +
            s * (6.57024977e+00 + s * (-6.04244152e-02))))))));
    } else {
        R = -9.86494292e-03 + s * (-7.99283237e-01 + s * (-1.77579549e+01 +
            s * (-1.60636384e+02 + s * (-6.37566443e+02 + s * (-1.25029579e+03 +
            s * (-1.05089413e+03 + s * (-3.70319441e+02 + s * (-3.56042851e+01))))))));
        S = 1.0 + s * (3.03380607e+01 + s * (3.25792510e+02 + s * (1.53672857e+03 +
            s * (3.19985824e+03 + s * (2.55305040e+03 + s * (4.74528542e+02 +
            s * (-2.24409525e+01)))))));
    }
    float erfc_pos = exp(-ax * ax - 0.5625) * exp(R / S) / ax;
    return (x < 0.0) ? (2.0 - erfc_pos) : erfc_pos;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    // Read as raw bits for denormal handling
    uint bits_a = a[idx];
    uint bits_b = b[idx];
    float val_a = uintBitsToFloat(bits_a);
    float val_b = uintBitsToFloat(bits_b);

    // Check if both values are denormals (exponent == 0, mantissa != 0) or zeros
    // Denormals have format: [sign:1][exp:8=0][mantissa:23!=0]
    uint exp_a = (bits_a >> 23) & 0xFFu;
    uint exp_b = (bits_b >> 23) & 0xFFu;
    bool both_denorm_or_zero = (exp_a == 0u) && (exp_b == 0u);

    uint res_bits;

    switch (params.op) {
        case 0: // add
            if (both_denorm_or_zero) {
                // For denormals/zeros with same sign, use integer arithmetic
                // to preserve denormal results
                uint sign_a = bits_a & 0x80000000u;
                uint sign_b = bits_b & 0x80000000u;
                uint mant_a = bits_a & 0x007FFFFFu;
                uint mant_b = bits_b & 0x007FFFFFu;

                if (sign_a == sign_b) {
                    // Same sign: add mantissas
                    uint mant_sum = mant_a + mant_b;
                    if (mant_sum >= 0x00800000u) {
                        // Overflow to normalized number (exponent becomes 1)
                        res_bits = sign_a | 0x00800000u | ((mant_sum - 0x00800000u) & 0x007FFFFFu);
                    } else {
                        // Still denormal
                        res_bits = sign_a | mant_sum;
                    }
                } else {
                    // Different signs: subtract mantissas
                    if (mant_a >= mant_b) {
                        res_bits = sign_a | (mant_a - mant_b);
                    } else {
                        res_bits = sign_b | (mant_b - mant_a);
                    }
                }
                result[idx] = res_bits;
            } else {
                result[idx] = floatBitsToUint(val_a + val_b);
            }
            break;
        case 1: // sub
            if (both_denorm_or_zero) {
                // For denormals, subtraction is like adding with flipped sign
                uint sign_a = bits_a & 0x80000000u;
                uint sign_b = bits_b ^ 0x80000000u;  // Flip sign of b
                uint mant_a = bits_a & 0x007FFFFFu;
                uint mant_b = bits_b & 0x007FFFFFu;

                if (sign_a == sign_b) {
                    uint mant_sum = mant_a + mant_b;
                    if (mant_sum >= 0x00800000u) {
                        res_bits = sign_a | 0x00800000u | ((mant_sum - 0x00800000u) & 0x007FFFFFu);
                    } else {
                        res_bits = sign_a | mant_sum;
                    }
                } else {
                    if (mant_a >= mant_b) {
                        res_bits = sign_a | (mant_a - mant_b);
                    } else {
                        res_bits = sign_b | (mant_b - mant_a);
                    }
                }
                result[idx] = res_bits;
            } else {
                result[idx] = floatBitsToUint(val_a - val_b);
            }
            break;
        case 2: // mul
            result[idx] = floatBitsToUint(val_a * val_b);
            break;
        case 3: // div
            result[idx] = floatBitsToUint(val_a / val_b);
            break;
        case 4: // sqrt (unary - uses a only)
            result[idx] = floatBitsToUint(sqrt(val_a));
            break;
        case 5: // exp (unary)
            result[idx] = floatBitsToUint(exp(val_a));
            break;
        case 6: // log (unary)
            result[idx] = floatBitsToUint(log(val_a));
            break;
        case 7: // neg (unary)
            result[idx] = floatBitsToUint(-val_a);
            break;
        case 8: // abs (unary)
            result[idx] = floatBitsToUint(abs(val_a));
            break;
        case 9: // pow (unary with parameter)
            // GLSL pow(x,y) is defined as exp2(y*log2(x)), which returns NaN
            // for x<0. Handle common integer exponents explicitly so x^n
            // stays finite for negative x — this is what PowBackward feeds
            // back into pow for x^(n-1).
            if (params.param == 1.0) {
                result[idx] = floatBitsToUint(val_a);
            } else if (params.param == 0.0) {
                result[idx] = floatBitsToUint(1.0);
            } else if (params.param == 2.0) {
                result[idx] = floatBitsToUint(val_a * val_a);
            } else if (params.param == 3.0) {
                result[idx] = floatBitsToUint(val_a * val_a * val_a);
            } else if (params.param == -1.0) {
                result[idx] = floatBitsToUint(1.0 / val_a);
            } else {
                result[idx] = floatBitsToUint(pow(val_a, params.param));
            }
            break;
        case 10: // sign (unary)
            if (val_a < 0.0) {
                result[idx] = floatBitsToUint(-1.0);
            } else if (val_a > 0.0) {
                result[idx] = floatBitsToUint(1.0);
            } else {
                result[idx] = floatBitsToUint(0.0);
            }
            break;
        case 11: // floor (unary)
            result[idx] = floatBitsToUint(floor(val_a));
            break;
        case 12: // ceil (unary)
            result[idx] = floatBitsToUint(ceil(val_a));
            break;
        case 13: // round (unary)
            result[idx] = floatBitsToUint(round(val_a));
            break;
        case 14: // trunc (unary)
            result[idx] = floatBitsToUint(trunc(val_a));
            break;
        case 15: // reciprocal (unary)
            result[idx] = floatBitsToUint(1.0 / val_a);
            break;
        case 16: // log2 (unary)
            result[idx] = floatBitsToUint(log2(val_a));
            break;
        case 17: // log10 (unary)
            result[idx] = floatBitsToUint(log2(val_a) / log2(10.0));
            break;
        case 18: // log1p (unary)
            result[idx] = floatBitsToUint(log(1.0 + val_a));
            break;
        case 19: // exp2 (unary)
            result[idx] = floatBitsToUint(exp2(val_a));
            break;
        case 20: // expm1 (unary)
            result[idx] = floatBitsToUint(exp(val_a) - 1.0);
            break;
        case 21: { // erf — fdlibm-style float-precision rational, ~1 ULP
            result[idx] = floatBitsToUint(erf_f32(val_a));
            break;
        }
        case 22: { // erfc — fdlibm-style float-precision rational, ~1 ULP
            result[idx] = floatBitsToUint(erfc_f32(val_a));
            break;
        }
        case 23: // atan2 (binary)
            result[idx] = floatBitsToUint(atan(val_a, val_b));
            break;
        case 24: // fmod (binary)
            result[idx] = floatBitsToUint(val_a - trunc(val_a / val_b) * val_b);
            break;
        case 25: { // remainder (binary) - IEEE remainder
            float quot = val_a / val_b;
            float rounded = round(quot);
            result[idx] = floatBitsToUint(val_a - rounded * val_b);
            break;
        }
        case 26: // minimum (binary)
            result[idx] = floatBitsToUint(min(val_a, val_b));
            break;
        case 27: // maximum (binary)
            result[idx] = floatBitsToUint(max(val_a, val_b));
            break;
        case 28: // rsqrt (unary)
            result[idx] = floatBitsToUint(inversesqrt(val_a));
            break;
        case 29: // square (unary)
            result[idx] = floatBitsToUint(val_a * val_a);
            break;
        case 30: // asinh (unary)
            result[idx] = floatBitsToUint(asinh(val_a));
            break;
        case 31: // acosh (unary)
            result[idx] = floatBitsToUint(acosh(val_a));
            break;
        case 32: // atanh (unary)
            result[idx] = floatBitsToUint(atanh(val_a));
            break;
        case 33: // hypot (binary)
            result[idx] = floatBitsToUint(sqrt(val_a * val_a + val_b * val_b));
            break;
        case 34: { // copysign (binary)
            float mag = abs(val_a);
            result[idx] = floatBitsToUint(val_b < 0.0 ? -mag : mag);
            break;
        }
        case 35: { // nextafter (binary) - approximation via ULP step
            if (val_a == val_b) {
                result[idx] = bits_a;
            } else {
                uint ua = bits_a;
                // For positive values or zero moving toward positive: increment
                // For negative values moving toward negative: increment magnitude
                if ((val_a >= 0.0 && val_b > val_a) || (val_a < 0.0 && val_b > val_a)) {
                    if (val_a >= 0.0) ua = ua + 1u;
                    else ua = ua - 1u;
                } else {
                    if (val_a > 0.0) ua = ua - 1u;
                    else if (val_a < 0.0) ua = ua + 1u;
                    else ua = 0x80000001u; // -0 -> smallest negative denorm
                }
                result[idx] = ua;
            }
            break;
        }
        case 36: { // gcd (integer via float encoding)
            int ia = int(val_a);
            int ib = int(val_b);
            ia = ia < 0 ? -ia : ia;
            ib = ib < 0 ? -ib : ib;
            while (ib != 0) { int t = ib; ib = ia - (ia / ib) * ib; ia = t; }
            result[idx] = floatBitsToUint(float(ia));
            break;
        }
        case 37: { // lcm (integer via float encoding)
            int ia = int(val_a);
            int ib = int(val_b);
            int oa = ia < 0 ? -ia : ia;
            int ob = ib < 0 ? -ib : ib;
            int ga = oa; int gb = ob;
            while (gb != 0) { int t = gb; gb = ga - (ga / gb) * gb; ga = t; }
            int g = ga;
            result[idx] = floatBitsToUint(g == 0 ? 0.0 : float((oa / g) * ob));
            break;
        }
        case 38: { // igamma (binary) - lower regularized incomplete gamma P(a, x)
            // Stirling alone was wildly inaccurate for small `a`. Use Lanczos
            // g=7 for lgamma and shift small a up by integer steps, subtracting
            // the corresponding log-products (gamma(a) = (a-1)! recursion).
            float a = val_a;
            float x = val_b;
            if (x <= 0.0) { result[idx] = floatBitsToUint(0.0); break; }
            // Lanczos coefficients (g=7, n=9)
            const float lan_g = 7.0;
            const float lan_c0 =  0.99999999999980993;
            const float lan_c1 = 676.5203681218851;
            const float lan_c2 = -1259.1392167224028;
            const float lan_c3 = 771.32342877765313;
            const float lan_c4 = -176.61502916214059;
            const float lan_c5 = 12.507343278686905;
            const float lan_c6 = -0.13857109526572012;
            const float lan_c7 = 9.9843695780195716e-6;
            const float lan_c8 = 1.5056327351493116e-7;
            float z = a - 1.0;
            float sx = lan_c0;
            sx += lan_c1 / (z + 1.0);
            sx += lan_c2 / (z + 2.0);
            sx += lan_c3 / (z + 3.0);
            sx += lan_c4 / (z + 4.0);
            sx += lan_c5 / (z + 5.0);
            sx += lan_c6 / (z + 6.0);
            sx += lan_c7 / (z + 7.0);
            sx += lan_c8 / (z + 8.0);
            float t = z + lan_g + 0.5;
            float lg = 0.9189385332046727 + (z + 0.5) * log(t) - t + log(sx);

            float term = 1.0 / a;
            float sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + float(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-7) break;
            }
            float res = exp(-x + a * log(x) - lg) * sum;
            res = clamp(res, 0.0, 1.0);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 39: { // igammac (binary) - upper regularized incomplete gamma = 1 - igamma
            float a = val_a;
            float x = val_b;
            if (x <= 0.0) { result[idx] = floatBitsToUint(1.0); break; }
            const float lan_g = 7.0;
            const float lan_c0 =  0.99999999999980993;
            const float lan_c1 = 676.5203681218851;
            const float lan_c2 = -1259.1392167224028;
            const float lan_c3 = 771.32342877765313;
            const float lan_c4 = -176.61502916214059;
            const float lan_c5 = 12.507343278686905;
            const float lan_c6 = -0.13857109526572012;
            const float lan_c7 = 9.9843695780195716e-6;
            const float lan_c8 = 1.5056327351493116e-7;
            float z = a - 1.0;
            float sx = lan_c0;
            sx += lan_c1 / (z + 1.0);
            sx += lan_c2 / (z + 2.0);
            sx += lan_c3 / (z + 3.0);
            sx += lan_c4 / (z + 4.0);
            sx += lan_c5 / (z + 5.0);
            sx += lan_c6 / (z + 6.0);
            sx += lan_c7 / (z + 7.0);
            sx += lan_c8 / (z + 8.0);
            float t = z + lan_g + 0.5;
            float lg = 0.9189385332046727 + (z + 0.5) * log(t) - t + log(sx);

            float term = 1.0 / a;
            float sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + float(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-7) break;
            }
            float res = exp(-x + a * log(x) - lg) * sum;
            res = clamp(res, 0.0, 1.0);
            result[idx] = floatBitsToUint(1.0 - res);
            break;
        }
        case 42: { // fmax (binary) - NaN-propagating max: fmax(NaN, x) = x
            float res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = max(val_a, val_b);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 43: { // fmin (binary) - NaN-propagating min: fmin(NaN, x) = x
            float res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = min(val_a, val_b);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 44: // deg2rad (unary): x * (PI / 180)
            result[idx] = floatBitsToUint(val_a * 0.01745329251994329577);
            break;
        case 45: // rad2deg (unary): x * (180 / PI)
            result[idx] = floatBitsToUint(val_a * 57.29577951308232087680);
            break;
        case 46: { // logit (unary): log(clamp(x,eps,1-eps) / (1 - clamp(x,eps,1-eps)))
            float eps = params.param > 0.0 ? params.param : 1.17549435e-38;
            float clamped = clamp(val_a, eps, 1.0 - eps);
            result[idx] = floatBitsToUint(log(clamped / (1.0 - clamped)));
            break;
        }
        case 47: // float_power (binary): pow(a, b) in float (f64 promotion done on host)
            result[idx] = floatBitsToUint(pow(val_a, val_b));
            break;
        case 48: { // xlog1py (binary): x == 0 ? 0 : x * log(1+y)
            float res;
            if (val_a == 0.0) res = 0.0;
            else res = val_a * log(1.0 + val_b);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 49: // ldexp (binary): x * 2^n (n is val_b as int)
            result[idx] = floatBitsToUint(val_a * exp2(val_b));
            break;
        case 50: // frac (unary): x - trunc(x) — sign-preserving (PyTorch convention)
            result[idx] = floatBitsToUint(val_a - trunc(val_a));
            break;
        case 51: // log_sigmoid (unary): log(1 / (1 + exp(-x))) = -log(1 + exp(-x))
            result[idx] = floatBitsToUint(-log(1.0 + exp(-val_a)));
            break;
        case 52: // bitwise_not (unary): ~bits
            result[idx] = ~bits_a;
            break;
    }
}
