#version 450

// Math operations: add, sub, mul, div, sqrt, exp, log, neg, abs, pow, sign, floor, ceil, round, trunc, reciprocal,
//   log2, log10, log1p, exp2, expm1, erf, erfc, atan2, fmod, remainder, minimum, maximum
// Supports denormal number preservation for add/sub operations
layout(local_size_x_id = 0) in;

// Use uint buffers for raw bit access to support denormal preservation
layout(binding = 0) buffer InputA { uint a[]; };
layout(binding = 1) buffer InputB { uint b[]; };
layout(binding = 2) buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 4=sqrt, 5=exp, 6=log, 7=neg, 8=abs, 9=pow, 10=sign, 11=floor, 12=ceil, 13=round, 14=trunc, 15=reciprocal, 16=log2, 17=log10, 18=log1p, 19=exp2, 20=expm1, 21=erf, 22=erfc, 23=atan2, 24=fmod, 25=remainder, 26=minimum, 27=maximum, 28=rsqrt, 29=square, 30=asinh, 31=acosh, 32=atanh, 33=hypot, 34=copysign, 35=nextafter, 36=gcd, 37=lcm, 38=igamma, 39=igammac, 40=addcmul, 41=addcdiv, 42=fmax, 43=fmin, 44=deg2rad, 45=rad2deg, 46=logit, 47=float_power, 48=xlog1py, 49=ldexp, 50=frac, 51=log_sigmoid, 52=bitwise_not
    float param;     // Parameter for operations like pow (exponent), addcmul/addcdiv (value)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    // Read as raw bits for denormal handling
    uint bits_a = a[idx];
    uint bits_b = b[idx];
    float val_a = uintBitsToFloat(bits_a);
    float val_b = uintBitsToFloat(bits_b);

    // Check if both values are denormals (exponent == 0, mantissa != 0) or zeros
    // Denormals have format: [sign:1][exp:8=0][mantissa:23!=0]
    uint exp_a = (bits_a >> 23) & 0xFFu;
    uint exp_b = (bits_b >> 23) & 0xFFu;
    bool both_denorm_or_zero = (exp_a == 0u) && (exp_b == 0u);

    uint res_bits;

    switch (params.op) {
        case 0: // add
            if (both_denorm_or_zero) {
                // For denormals/zeros with same sign, use integer arithmetic
                // to preserve denormal results
                uint sign_a = bits_a & 0x80000000u;
                uint sign_b = bits_b & 0x80000000u;
                uint mant_a = bits_a & 0x007FFFFFu;
                uint mant_b = bits_b & 0x007FFFFFu;

                if (sign_a == sign_b) {
                    // Same sign: add mantissas
                    uint mant_sum = mant_a + mant_b;
                    if (mant_sum >= 0x00800000u) {
                        // Overflow to normalized number (exponent becomes 1)
                        res_bits = sign_a | 0x00800000u | ((mant_sum - 0x00800000u) & 0x007FFFFFu);
                    } else {
                        // Still denormal
                        res_bits = sign_a | mant_sum;
                    }
                } else {
                    // Different signs: subtract mantissas
                    if (mant_a >= mant_b) {
                        res_bits = sign_a | (mant_a - mant_b);
                    } else {
                        res_bits = sign_b | (mant_b - mant_a);
                    }
                }
                result[idx] = res_bits;
            } else {
                result[idx] = floatBitsToUint(val_a + val_b);
            }
            break;
        case 1: // sub
            if (both_denorm_or_zero) {
                // For denormals, subtraction is like adding with flipped sign
                uint sign_a = bits_a & 0x80000000u;
                uint sign_b = bits_b ^ 0x80000000u;  // Flip sign of b
                uint mant_a = bits_a & 0x007FFFFFu;
                uint mant_b = bits_b & 0x007FFFFFu;

                if (sign_a == sign_b) {
                    uint mant_sum = mant_a + mant_b;
                    if (mant_sum >= 0x00800000u) {
                        res_bits = sign_a | 0x00800000u | ((mant_sum - 0x00800000u) & 0x007FFFFFu);
                    } else {
                        res_bits = sign_a | mant_sum;
                    }
                } else {
                    if (mant_a >= mant_b) {
                        res_bits = sign_a | (mant_a - mant_b);
                    } else {
                        res_bits = sign_b | (mant_b - mant_a);
                    }
                }
                result[idx] = res_bits;
            } else {
                result[idx] = floatBitsToUint(val_a - val_b);
            }
            break;
        case 2: // mul
            result[idx] = floatBitsToUint(val_a * val_b);
            break;
        case 3: // div
            result[idx] = floatBitsToUint(val_a / val_b);
            break;
        case 4: // sqrt (unary - uses a only)
            result[idx] = floatBitsToUint(sqrt(val_a));
            break;
        case 5: // exp (unary)
            result[idx] = floatBitsToUint(exp(val_a));
            break;
        case 6: // log (unary)
            result[idx] = floatBitsToUint(log(val_a));
            break;
        case 7: // neg (unary)
            result[idx] = floatBitsToUint(-val_a);
            break;
        case 8: // abs (unary)
            result[idx] = floatBitsToUint(abs(val_a));
            break;
        case 9: // pow (unary with parameter)
            result[idx] = floatBitsToUint(pow(val_a, params.param));
            break;
        case 10: // sign (unary)
            if (val_a < 0.0) {
                result[idx] = floatBitsToUint(-1.0);
            } else if (val_a > 0.0) {
                result[idx] = floatBitsToUint(1.0);
            } else {
                result[idx] = floatBitsToUint(0.0);
            }
            break;
        case 11: // floor (unary)
            result[idx] = floatBitsToUint(floor(val_a));
            break;
        case 12: // ceil (unary)
            result[idx] = floatBitsToUint(ceil(val_a));
            break;
        case 13: // round (unary)
            result[idx] = floatBitsToUint(round(val_a));
            break;
        case 14: // trunc (unary)
            result[idx] = floatBitsToUint(trunc(val_a));
            break;
        case 15: // reciprocal (unary)
            result[idx] = floatBitsToUint(1.0 / val_a);
            break;
        case 16: // log2 (unary)
            result[idx] = floatBitsToUint(log2(val_a));
            break;
        case 17: // log10 (unary)
            result[idx] = floatBitsToUint(log2(val_a) / log2(10.0));
            break;
        case 18: // log1p (unary)
            result[idx] = floatBitsToUint(log(1.0 + val_a));
            break;
        case 19: // exp2 (unary)
            result[idx] = floatBitsToUint(exp2(val_a));
            break;
        case 20: // expm1 (unary)
            result[idx] = floatBitsToUint(exp(val_a) - 1.0);
            break;
        case 21: { // erf (unary) - Abramowitz & Stegun approximation
            float x = val_a;
            float ax = abs(x);
            float t = 1.0 / (1.0 + 0.3275911 * ax);
            float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-ax * ax);
            result[idx] = floatBitsToUint(x < 0.0 ? -y : y);
            break;
        }
        case 22: { // erfc (unary)
            float x = val_a;
            float ax = abs(x);
            float t = 1.0 / (1.0 + 0.3275911 * ax);
            float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-ax * ax);
            float erf_val = x < 0.0 ? -y : y;
            result[idx] = floatBitsToUint(1.0 - erf_val);
            break;
        }
        case 23: // atan2 (binary)
            result[idx] = floatBitsToUint(atan(val_a, val_b));
            break;
        case 24: // fmod (binary)
            result[idx] = floatBitsToUint(val_a - trunc(val_a / val_b) * val_b);
            break;
        case 25: { // remainder (binary) - IEEE remainder
            float quot = val_a / val_b;
            float rounded = round(quot);
            result[idx] = floatBitsToUint(val_a - rounded * val_b);
            break;
        }
        case 26: // minimum (binary)
            result[idx] = floatBitsToUint(min(val_a, val_b));
            break;
        case 27: // maximum (binary)
            result[idx] = floatBitsToUint(max(val_a, val_b));
            break;
        case 28: // rsqrt (unary)
            result[idx] = floatBitsToUint(inversesqrt(val_a));
            break;
        case 29: // square (unary)
            result[idx] = floatBitsToUint(val_a * val_a);
            break;
        case 30: // asinh (unary)
            result[idx] = floatBitsToUint(asinh(val_a));
            break;
        case 31: // acosh (unary)
            result[idx] = floatBitsToUint(acosh(val_a));
            break;
        case 32: // atanh (unary)
            result[idx] = floatBitsToUint(atanh(val_a));
            break;
        case 33: // hypot (binary)
            result[idx] = floatBitsToUint(sqrt(val_a * val_a + val_b * val_b));
            break;
        case 34: { // copysign (binary)
            float mag = abs(val_a);
            result[idx] = floatBitsToUint(val_b < 0.0 ? -mag : mag);
            break;
        }
        case 35: { // nextafter (binary) - approximation via ULP step
            if (val_a == val_b) {
                result[idx] = bits_a;
            } else {
                uint ua = bits_a;
                // For positive values or zero moving toward positive: increment
                // For negative values moving toward negative: increment magnitude
                if ((val_a >= 0.0 && val_b > val_a) || (val_a < 0.0 && val_b > val_a)) {
                    if (val_a >= 0.0) ua = ua + 1u;
                    else ua = ua - 1u;
                } else {
                    if (val_a > 0.0) ua = ua - 1u;
                    else if (val_a < 0.0) ua = ua + 1u;
                    else ua = 0x80000001u; // -0 -> smallest negative denorm
                }
                result[idx] = ua;
            }
            break;
        }
        case 36: { // gcd (integer via float encoding)
            int ia = int(val_a);
            int ib = int(val_b);
            ia = ia < 0 ? -ia : ia;
            ib = ib < 0 ? -ib : ib;
            while (ib != 0) { int t = ib; ib = ia - (ia / ib) * ib; ia = t; }
            result[idx] = floatBitsToUint(float(ia));
            break;
        }
        case 37: { // lcm (integer via float encoding)
            int ia = int(val_a);
            int ib = int(val_b);
            int oa = ia < 0 ? -ia : ia;
            int ob = ib < 0 ? -ib : ib;
            int ga = oa; int gb = ob;
            while (gb != 0) { int t = gb; gb = ga - (ga / gb) * gb; ga = t; }
            int g = ga;
            result[idx] = floatBitsToUint(g == 0 ? 0.0 : float((oa / g) * ob));
            break;
        }
        case 38: { // igamma (binary) - series expansion for lower regularized incomplete gamma
            float a = val_a;
            float x = val_b;
            if (x <= 0.0) { result[idx] = floatBitsToUint(0.0); break; }
            float term = 1.0 / a;
            float sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + float(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-6) break;
            }
            float lga = log(abs(val_a));  // approximate lgamma
            // Stirling approx for lgamma: (a-0.5)*ln(a) - a + 0.5*ln(2*pi)
            float lg = (a - 0.5) * log(a) - a + 0.9189385;
            float res = exp(-x + a * log(x) - lg) * sum;
            res = clamp(res, 0.0, 1.0);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 39: { // igammac (binary) - upper regularized incomplete gamma = 1 - igamma
            float a = val_a;
            float x = val_b;
            if (x <= 0.0) { result[idx] = floatBitsToUint(1.0); break; }
            float term = 1.0 / a;
            float sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + float(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-6) break;
            }
            float lg = (a - 0.5) * log(a) - a + 0.9189385;
            float res = exp(-x + a * log(x) - lg) * sum;
            res = clamp(res, 0.0, 1.0);
            result[idx] = floatBitsToUint(1.0 - res);
            break;
        }
        case 42: { // fmax (binary) - NaN-propagating max: fmax(NaN, x) = x
            float res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = max(val_a, val_b);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 43: { // fmin (binary) - NaN-propagating min: fmin(NaN, x) = x
            float res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = min(val_a, val_b);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 44: // deg2rad (unary): x * (PI / 180)
            result[idx] = floatBitsToUint(val_a * 0.01745329251994329577);
            break;
        case 45: // rad2deg (unary): x * (180 / PI)
            result[idx] = floatBitsToUint(val_a * 57.29577951308232087680);
            break;
        case 46: { // logit (unary): log(clamp(x,eps,1-eps) / (1 - clamp(x,eps,1-eps)))
            float eps = params.param > 0.0 ? params.param : 1.17549435e-38;
            float clamped = clamp(val_a, eps, 1.0 - eps);
            result[idx] = floatBitsToUint(log(clamped / (1.0 - clamped)));
            break;
        }
        case 47: // float_power (binary): pow(a, b) in float (f64 promotion done on host)
            result[idx] = floatBitsToUint(pow(val_a, val_b));
            break;
        case 48: { // xlog1py (binary): x == 0 ? 0 : x * log(1+y)
            float res;
            if (val_a == 0.0) res = 0.0;
            else res = val_a * log(1.0 + val_b);
            result[idx] = floatBitsToUint(res);
            break;
        }
        case 49: // ldexp (binary): x * 2^n (n is val_b as int)
            result[idx] = floatBitsToUint(val_a * exp2(val_b));
            break;
        case 50: // frac (unary): x - floor(x)
            result[idx] = floatBitsToUint(val_a - floor(val_a));
            break;
        case 51: // log_sigmoid (unary): log(1 / (1 + exp(-x))) = -log(1 + exp(-x))
            result[idx] = floatBitsToUint(-log(1.0 + exp(-val_a)));
            break;
        case 52: // bitwise_not (unary): ~bits
            result[idx] = ~bits_a;
            break;
    }
}
