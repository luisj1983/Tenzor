#version 450

// Math operations: add, sub, mul, div, sqrt, exp, log, neg, abs
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputA { float a[]; };
layout(binding = 1) buffer InputB { float b[]; };
layout(binding = 2) buffer Output { float result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 4=sqrt, 5=exp, 6=log, 7=neg, 8=abs
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    float val_a = a[idx];
    float val_b = b[idx];

    switch (params.op) {
        case 0: // add
            result[idx] = val_a + val_b;
            break;
        case 1: // sub
            result[idx] = val_a - val_b;
            break;
        case 2: // mul
            result[idx] = val_a * val_b;
            break;
        case 3: // div
            result[idx] = val_a / val_b;
            break;
        case 4: // sqrt (unary - uses a only)
            result[idx] = sqrt(val_a);
            break;
        case 5: // exp (unary)
            result[idx] = exp(val_a);
            break;
        case 6: // log (unary)
            result[idx] = log(val_a);
            break;
        case 7: // neg (unary)
            result[idx] = -val_a;
            break;
        case 8: // abs (unary)
            result[idx] = abs(val_a);
            break;
    }
}
