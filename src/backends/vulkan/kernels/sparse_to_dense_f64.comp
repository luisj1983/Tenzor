#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Convert CSR sparse matrix to dense (row-major, Float64)
// One workgroup per row: zero the row, then scatter non-zero values
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer RowOffsets { int row_offsets[]; };
layout(set = 0, binding = 1) readonly buffer ColIndices { int col_indices[]; };
layout(set = 0, binding = 2) readonly buffer Values     { float64_t values[]; };
layout(set = 0, binding = 3) buffer Dense               { float64_t dense[];  };

layout(push_constant) uniform PushConstants {
    uint n_rows;
    uint n_cols;
};

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= n_rows) return;

    for (uint col = tid; col < n_cols; col += gl_WorkGroupSize.x) {
        dense[row * n_cols + col] = 0.0lf;
    }
    barrier();

    uint row_start = uint(row_offsets[row]);
    uint row_end = uint(row_offsets[row + 1]);
    for (uint i = row_start + tid; i < row_end; i += gl_WorkGroupSize.x) {
        uint col = uint(col_indices[i]);
        dense[row * n_cols + col] = values[i];
    }
}
