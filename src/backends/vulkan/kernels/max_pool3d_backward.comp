#version 450
#extension GL_EXT_shader_atomic_float : enable

// Max Pooling 3D Backward Pass using pre-computed indices
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };
// Indices come from MaxPool3dForward as Int32 — read them with matching type
// so the bit pattern is interpreted correctly. Reading Int32 bytes as float
// silently corrupts every index.
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer GradInput { float grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint grad_input_size;
    uint out_plane;   // per-(n,c) output plane size (F043)
    uint in_plane;    // per-(n,c) input plane size (F043)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    float grad = grad_output[idx];
    // F043: forward stores PLANE-LOCAL argmax; rebuild the global
    // grad_input offset via the per-(n,c) plane base.
    int plane_local = indices[idx];
    uint nc = idx / params.out_plane;
    int target_idx = int(nc * params.in_plane) + plane_local;
    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAdd(grad_input[target_idx], grad);
    }
}
