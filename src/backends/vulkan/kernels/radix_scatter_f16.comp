#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x_id = 0) in;

// F16 sort: keys stored as individual uint16 values packed in uint32 pairs
// But for sorting we need individual access, so we use a flat uint16 view via uint buffer
layout(set = 0, binding = 0) readonly buffer KeysIn   { uint keys_in[];   };  // packed f16 pairs
layout(set = 0, binding = 1) readonly buffer IdxIn    { int idx_in[];     };
layout(set = 0, binding = 2) buffer KeysOut            { uint keys_out[];  };
layout(set = 0, binding = 3) buffer IdxOut             { int idx_out[];    };
layout(set = 0, binding = 4) buffer Histograms         { uint histos[];    };

layout(push_constant) uniform PushConstants {
    uint n;
    uint digit;  // 0 or 1 for 16-bit keys
    uint n_wgs;
    uint descending; // 0 = ascending, 1 = descending
};

shared uint local_offsets[256];

uint f16_to_sortable(uint bits16) {
    // Float16 sign-bit flip for correct ordering. For a descending sort invert
    // all 16 bits of the sortable key so an ascending LSD radix yields
    // descending values with stable (ascending-index) tie order, matching the
    // histogram pass.
    uint mask = uint(-int(bits16 >> 15)) | 0x8000u;
    uint sortable = (bits16 ^ mask) & 0xFFFFu;
    if (descending != 0u) sortable = (~sortable) & 0xFFFFu;
    return sortable;
}

uint readF16Bits(uint element_idx) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint packed = keys_in[pair_idx];
    return (packed >> (offset * 16)) & 0xFFFFu;
}

void writeF16Bits(uint element_idx, uint bits16) {
    // Two elements with the same digit get consecutive destination indices that
    // can share the SAME packed uint32 word. A plain read-modify-write of one
    // 16-bit half would race with the concurrent write to the other half and
    // lose updates. Merge only the targeted half with a CAS loop, mirroring
    // updateU16 in scatter_i16.comp and atomicAddF16 in scatter_add_f16.comp.
    uint pair_idx = element_idx / 2;
    uint shift = (element_idx % 2) * 16u;
    uint mask = 0xFFFFu << shift;
    uint half_word = (bits16 & 0xFFFFu) << shift;
    uint old = keys_out[pair_idx];
    uint expected;
    do {
        expected = old;
        uint nw = (expected & ~mask) | half_word;
        old = atomicCompSwap(keys_out[pair_idx], expected, nw);
    } while (old != expected);
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    if (lid < 256) {
        local_offsets[lid] = histos[lid * n_wgs + wg_id];
    }
    barrier();

    uint tile_size = (n + n_wgs - 1) / n_wgs;
    uint tile_start = wg_id * tile_size;
    uint tile_end = min(tile_start + tile_size, n);

    for (uint i = tile_start + lid; i < tile_end; i += 256) {
        uint bits16 = readF16Bits(i);
        uint sortable = f16_to_sortable(bits16);
        uint digit_val = (sortable >> (digit * 8)) & 0xFFu;
        uint dest = atomicAdd(local_offsets[digit_val], 1);
        writeF16Bits(dest, bits16);
        idx_out[dest] = idx_in[i];
    }
}
