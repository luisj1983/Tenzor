#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable

// Extract real parts from interleaved Float64 complex buffer.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float64_t data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;
    data_out[idx] = data_in[idx * 2];  // extract real part
}
