#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// One-Hot Encoding (Float64)
// Each thread handles one (batch, class) pair
// Output 1.0 if indices[batch] == class, else 0.0
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Indices { int indices_data[]; };        // (batch_size,) class indices
layout(binding = 1) buffer Output { float64_t output_data[]; };    // (batch_size, num_classes)

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;

    uint total = params.batch_size * params.num_classes;
    if (gid >= total) return;

    uint batch = gid / params.num_classes;
    uint cls = gid % params.num_classes;

    int target_class = indices_data[batch];
    output_data[gid] = (uint(target_class) == cls) ? float64_t(1.0) : float64_t(0.0);
}
