#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Gather operation for Float16: gather elements along specified dimension
// Float16 elements are packed 2 per 32-bit word in uint buffers
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // Packed F16 pairs
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { uint output_data[]; };  // Packed F16 pairs

layout(push_constant) uniform PushConstants {
    uint input_size;       // Total input size (in elements, not words)
    uint output_size;      // Total output size (in elements)
    uint dim;              // Dimension to gather along
    uint dim_size;         // Size of the dimension being gathered
    uint inner_size;       // Product of dimensions after dim
    uint outer_size;       // Product of dimensions before dim
} params;

// Read a single Float16 element from packed uint32 array
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (input_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

// Write a single Float16 element to packed uint32 output array using atomics
void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;

    // Clear the target half-word and set the new value atomically
    atomicAnd(output_data[word_idx], ~(0xFFFFu << half_offset));
    atomicOr(output_data[word_idx], bits << half_offset);
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.output_size) {
        return;
    }

    // Decompose output index
    uint outer_idx = out_idx / (params.inner_size * params.dim_size);
    uint remainder = out_idx % (params.inner_size * params.dim_size);
    uint dim_idx = remainder / params.inner_size;
    uint inner_idx = remainder % params.inner_size;

    // Get the index to gather from
    int gather_idx = indices[out_idx];

    // Bounds check
    if (gather_idx < 0 || gather_idx >= int(params.dim_size)) {
        writeF16(out_idx, 0.0);
        return;
    }

    // Compute input index
    uint in_idx = outer_idx * (params.dim_size * params.inner_size) +
                  uint(gather_idx) * params.inner_size +
                  inner_idx;

    writeF16(out_idx, readF16(in_idx));
}
