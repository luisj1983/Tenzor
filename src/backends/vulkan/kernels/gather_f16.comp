#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Gather operation for Float16: gather elements along specified dimension
// Float16 elements are packed 2 per 32-bit word in uint buffers
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // Packed F16 pairs
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { uint output_data[]; };  // Packed F16 pairs

// See gather.comp for the per-dim decomposition rationale.
layout(push_constant) uniform PushConstants {
    uint output_size;
    uint input_size;
    uint ndim;
    uint dim;
    uint input_dim_size;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    uvec4 idx_shape_0_3;
    uvec4 idx_shape_4_7;
    ivec4 in_stride_0_3;
    ivec4 in_stride_4_7;
} params;

// Read a single Float16 element from packed uint32 array
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (input_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

// Write a single Float16 element to packed uint32 output array using CAS loop
// Two separate atomicAnd/atomicOr would race when multiple threads
// write to the same word (OR of bits instead of last-writer-wins).
void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.output_size) {
        return;
    }
    if (params.ndim > 8u) {
        return;
    }

    uint ish[8];
    ish[0] = max(params.idx_shape_0_3.x, 1u);
    ish[1] = max(params.idx_shape_0_3.y, 1u);
    ish[2] = max(params.idx_shape_0_3.z, 1u);
    ish[3] = max(params.idx_shape_0_3.w, 1u);
    ish[4] = max(params.idx_shape_4_7.x, 1u);
    ish[5] = max(params.idx_shape_4_7.y, 1u);
    ish[6] = max(params.idx_shape_4_7.z, 1u);
    ish[7] = max(params.idx_shape_4_7.w, 1u);
    int ist[8];
    ist[0] = params.in_stride_0_3.x;
    ist[1] = params.in_stride_0_3.y;
    ist[2] = params.in_stride_0_3.z;
    ist[3] = params.in_stride_0_3.w;
    ist[4] = params.in_stride_4_7.x;
    ist[5] = params.in_stride_4_7.y;
    ist[6] = params.in_stride_4_7.z;
    ist[7] = params.in_stride_4_7.w;

    int gather_idx = indices[out_idx];
    if (gather_idx < 0) gather_idx += int(params.input_dim_size);

    if (gather_idx < 0 || gather_idx >= int(params.input_dim_size)) {
        writeF16(out_idx, 0.0);
        return;
    }

    uint remaining = out_idx;
    int in_off = 0;
    for (int d = int(params.ndim) - 1; d >= 0; --d) {
        uint coord = remaining % ish[d];
        remaining /= ish[d];
        uint c = (uint(d) == params.dim) ? uint(gather_idx) : coord;
        in_off += int(c) * ist[d];
    }

    if (in_off < 0 || uint(in_off) >= params.input_size) {
        writeF16(out_idx, 0.0);
        return;
    }

    writeF16(out_idx, readF16(uint(in_off)));
}
