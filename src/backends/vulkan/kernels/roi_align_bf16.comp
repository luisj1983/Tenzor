#version 450

// ROI Align Forward Pass (BFloat16)
// BF16 stored packed two-per-uint32 word (no native GLSL bfloat16 type).
// All math in float32; output written back as BF16 (round-to-nearest-even) via
// a bounded compare-and-swap on the shared 32-bit word.
// Input: features (N, C, H, W), rois (num_rois, 5) = [batch_idx, x1, y1, x2, y2]
// Output: (num_rois, C, output_h, output_w)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Features { uint features_data[]; };  // Packed BF16
layout(binding = 1) buffer ROIs { uint rois_data[]; };          // Packed BF16
layout(binding = 2) buffer Output { uint output_data[]; };      // Packed BF16

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint num_rois;
    uint channels;
    uint feat_height;
    uint feat_width;
    uint output_h;
    uint output_w;
    uint spatial_scale_bits;
    uint sampling_ratio;
    uint aligned;
    uint batch_size;          // N (number of feature-map batches) for ROI bounds check
} params;

// buf_id: 0 = features, 1 = rois
float readBF16(uint buf_id, uint element_idx) {
    uint word_idx = element_idx >> 1u;
    uint word_offset = element_idx & 1u;
    uint packed = (buf_id == 0u) ? features_data[word_idx] : rois_data[word_idx];
    uint bits = (packed >> (word_offset * 16u)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

void writeBF16(uint element_idx, float value) {
    uint word_idx = element_idx >> 1u;
    uint word_offset = element_idx & 1u;
    uint shift = word_offset * 16u;
    uint mask = 0xFFFFu << shift;
    uint bf16_bits = ((floatBitsToUint(value) + 0x7FFFu +
                      ((floatBitsToUint(value) >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint new_half = bf16_bits << shift;

    uint prev = output_data[word_idx];
    for (uint attempt = 0u; attempt < 65536u; ++attempt) {
        uint desired = (prev & ~mask) | new_half;
        uint observed = atomicCompSwap(output_data[word_idx], prev, desired);
        if (observed == prev) return;
        prev = observed;
    }
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word written by another invocation.
}

float bilinear_interpolate(uint base_offset, float y, float x) {
    int height = int(params.feat_height);
    int width = int(params.feat_width);

    if (y < -1.0 || y > float(height) || x < -1.0 || x > float(width)) {
        return 0.0;
    }

    y = max(0.0, min(y, float(height - 1)));
    x = max(0.0, min(x, float(width - 1)));

    int y_low = int(floor(y));
    int x_low = int(floor(x));
    int y_high = min(y_low + 1, height - 1);
    int x_high = min(x_low + 1, width - 1);

    float ly = y - float(y_low);
    float lx = x - float(x_low);
    float hy = 1.0 - ly;
    float hx = 1.0 - lx;

    float v1 = readBF16(0u, base_offset + uint(y_low * width + x_low));
    float v2 = readBF16(0u, base_offset + uint(y_low * width + x_high));
    float v3 = readBF16(0u, base_offset + uint(y_high * width + x_low));
    float v4 = readBF16(0u, base_offset + uint(y_high * width + x_high));

    return hy * hx * v1 + hy * lx * v2 + ly * hx * v3 + ly * lx * v4;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    uint temp = idx;
    uint pw = temp % params.output_w;
    temp /= params.output_w;
    uint ph = temp % params.output_h;
    temp /= params.output_h;
    uint c = temp % params.channels;
    uint roi_idx = temp / params.channels;

    uint roi_base = roi_idx * 5;
    // Validate ROI batch index (see roi_align.comp); out-of-range -> zero output.
    int batch_idx_signed = int(readBF16(1u, roi_base));
    if (batch_idx_signed < 0 || uint(batch_idx_signed) >= params.batch_size) {
        writeBF16(idx, 0.0);
        return;
    }
    uint batch_idx = uint(batch_idx_signed);
    float spatial_scale = uintBitsToFloat(params.spatial_scale_bits);

    float roi_x1 = readBF16(1u, roi_base + 1) * spatial_scale;
    float roi_y1 = readBF16(1u, roi_base + 2) * spatial_scale;
    float roi_x2 = readBF16(1u, roi_base + 3) * spatial_scale;
    float roi_y2 = readBF16(1u, roi_base + 4) * spatial_scale;

    if (params.aligned != 0) {
        roi_x1 -= 0.5;
        roi_y1 -= 0.5;
        roi_x2 -= 0.5;
        roi_y2 -= 0.5;
    }

    float roi_width = roi_x2 - roi_x1;
    float roi_height = roi_y2 - roi_y1;

    // Non-aligned mode clamps ROI extent to a minimum of 1 (torchvision / CPU
    // reference); the aligned path intentionally does not clamp. (Was missing
    // from the f16/bf16/f64 variants — present only in the f32 kernel.)
    if (params.aligned == 0u) {
        roi_width = max(roi_width, 1.0);
        roi_height = max(roi_height, 1.0);
    }

    float bin_size_h = roi_height / float(params.output_h);
    float bin_size_w = roi_width / float(params.output_w);

    // Clamp adaptive grid to >= 1 (matching torchvision): a degenerate/zero-area
    // ROI gives bin_size <= 0 -> ceil() == 0 -> count == 0 -> 0/0 NaN.
    uint roi_bin_grid_h = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : max(1u, uint(ceil(bin_size_h)));
    uint roi_bin_grid_w = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : max(1u, uint(ceil(bin_size_w)));

    uint count = roi_bin_grid_h * roi_bin_grid_w;

    uint base_offset = batch_idx * params.channels * params.feat_height * params.feat_width
                     + c * params.feat_height * params.feat_width;

    float sum = 0.0;

    for (uint iy = 0; iy < roi_bin_grid_h; iy++) {
        for (uint ix = 0; ix < roi_bin_grid_w; ix++) {
            float y = roi_y1 + float(ph) * bin_size_h
                    + (float(iy) + 0.5) * bin_size_h / float(roi_bin_grid_h);
            float x = roi_x1 + float(pw) * bin_size_w
                    + (float(ix) + 0.5) * bin_size_w / float(roi_bin_grid_w);

            sum += bilinear_interpolate(base_offset, y, x);
        }
    }

    writeBF16(idx, count > 0u ? sum / float(count) : 0.0);
}
