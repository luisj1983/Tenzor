#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Stockham mixed-radix FFT: radix-2 butterfly stage (Float64)
// Data layout: interleaved real/imag pairs
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float64_t data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint stage_stride;
    uint direction;
    uint batch_size;
    uint batch_stride;
};

const float64_t PI = 3.14159265358979323846lf;

// Double-precision sin/cos via range reduction + polynomial.
// The prior `float(cos(float(angle)))` shortcut dropped twiddle factors to
// Float32 precision — each FFT butterfly multiplied that error forward, so
// gradcheck on an 8-point FFT ended up ~1e-4 off while expecting ~1e-5.
const float64_t TWO_OVER_PI_F = 0.6366197723675814lf;
const float64_t PI_OVER_2_HI = 1.5707963267948966lf;
const float64_t PI_OVER_2_LO = 6.123233995736766e-17lf;

void trig_reduce_f(float64_t x, out float64_t r, out int q) {
    float64_t j = floor(x * TWO_OVER_PI_F + 0.5lf);
    q = int(j) & 3;
    r = x - j * PI_OVER_2_HI;
    r = r - j * PI_OVER_2_LO;
}
float64_t sin_poly_f(float64_t x) {
    float64_t x2 = x * x;
    return x * (1.0lf - x2 * (1.0lf/6.0lf - x2 * (1.0lf/120.0lf - x2 * (1.0lf/5040.0lf - x2 / 362880.0lf))));
}
float64_t cos_poly_f(float64_t x) {
    float64_t x2 = x * x;
    return 1.0lf - x2 * (0.5lf - x2 * (1.0lf/24.0lf - x2 * (1.0lf/720.0lf - x2 / 40320.0lf)));
}
float64_t sin_df(float64_t x) {
    float64_t r; int q;
    trig_reduce_f(x, r, q);
    switch (q) {
        case 0: return sin_poly_f(r);
        case 1: return cos_poly_f(r);
        case 2: return -sin_poly_f(r);
        case 3: return -cos_poly_f(r);
    }
    return 0.0lf;
}
float64_t cos_df(float64_t x) {
    float64_t r; int q;
    trig_reduce_f(x, r, q);
    switch (q) {
        case 0: return cos_poly_f(r);
        case 1: return -sin_poly_f(r);
        case 2: return -cos_poly_f(r);
        case 3: return sin_poly_f(r);
    }
    return 0.0lf;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 2;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;
    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    uint group = local_tid / stage_stride;
    uint pos = local_tid % stage_stride;

    uint i0 = group * stage_stride * 2 + pos;
    uint i1 = i0 + stage_stride;

    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;

    uint b0_in = (batch_idx * batch_stride + i0) * 2;
    uint b1_in = (batch_idx * batch_stride + i1) * 2;
    uint b0_out = (batch_idx * batch_stride + o0) * 2;
    uint b1_out = (batch_idx * batch_stride + o1) * 2;

    float64_t a0_re = data_in[b0_in], a0_im = data_in[b0_in + 1];
    float64_t a1_re = data_in[b1_in], a1_im = data_in[b1_in + 1];

    float64_t angle = -2.0lf * PI * float64_t(pos) / float64_t(stage_stride * 2);
    if (direction == 1) angle = -angle;

    float64_t w_re = cos_df(angle), w_im = sin_df(angle);

    float64_t t_re = a1_re * w_re - a1_im * w_im;
    float64_t t_im = a1_re * w_im + a1_im * w_re;

    data_out[b0_out]     = a0_re + t_re;
    data_out[b0_out + 1] = a0_im + t_im;
    data_out[b1_out]     = a0_re - t_re;
    data_out[b1_out + 1] = a0_im - t_im;
}
