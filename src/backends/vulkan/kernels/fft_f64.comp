#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Cooley-Tukey radix-2 decimation-in-frequency FFT (complex-to-complex) — Float64
// Data layout: interleaved real/imag pairs — [re0, im0, re1, im1, ...]

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;           // FFT size (power of 2)
    uint stage;       // Current butterfly stage (0 to log2(n)-1)
    uint direction;   // 0 = forward, 1 = inverse
    uint batch_size;  // Number of batches
    uint batch_stride; // Stride between batches (in complex elements)
};

const double PI_D = 3.14159265358979323846LF;

// Double-precision sin/cos (GLSL built-ins are only float).
// The previous float cast dropped twiddle factors to float precision, and
// errors compounded through log2(N) butterfly stages — enough to fail
// Float64 FFT gradcheck even at N=8.
const double TWO_OVER_PI_D = 0.6366197723675814LF;
const double PI_OVER_2_HI_D = 1.5707963267948966LF;
const double PI_OVER_2_LO_D = 6.123233995736766e-17LF;

void trig_reduce_fd(double x, out double r, out int q) {
    double j = floor(x * TWO_OVER_PI_D + 0.5LF);
    q = int(j) & 3;
    r = x - j * PI_OVER_2_HI_D;
    r = r - j * PI_OVER_2_LO_D;
}
double sin_poly_fd(double x) {
    double x2 = x * x;
    return x * (1.0LF - x2 * (1.0LF/6.0LF - x2 * (1.0LF/120.0LF - x2 * (1.0LF/5040.0LF - x2 / 362880.0LF))));
}
double cos_poly_fd(double x) {
    double x2 = x * x;
    return 1.0LF - x2 * (0.5LF - x2 * (1.0LF/24.0LF - x2 * (1.0LF/720.0LF - x2 / 40320.0LF)));
}
double sin_fd(double x) {
    double r; int q;
    trig_reduce_fd(x, r, q);
    switch (q) {
        case 0: return sin_poly_fd(r);
        case 1: return cos_poly_fd(r);
        case 2: return -sin_poly_fd(r);
        case 3: return -cos_poly_fd(r);
    }
    return 0.0LF;
}
double cos_fd(double x) {
    double r; int q;
    trig_reduce_fd(x, r, q);
    switch (q) {
        case 0: return cos_poly_fd(r);
        case 1: return -sin_poly_fd(r);
        case 2: return -cos_poly_fd(r);
        case 3: return sin_poly_fd(r);
    }
    return 0.0LF;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;

    uint n_butterflies = n / 2;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    uint half_size = 1u << stage;
    uint group_size = half_size << 1;

    uint group_idx = local_tid / half_size;
    uint pos_in_group = local_tid % half_size;

    uint idx_top = group_idx * group_size + pos_in_group;
    uint idx_bot = idx_top + half_size;

    if (idx_bot >= n) return;

    uint base_top = (batch_idx * batch_stride + idx_top) * 2;
    uint base_bot = (batch_idx * batch_stride + idx_bot) * 2;

    double a_re = data_in[base_top];
    double a_im = data_in[base_top + 1];
    double b_re = data_in[base_bot];
    double b_im = data_in[base_bot + 1];

    double angle = -2.0LF * PI_D * double(pos_in_group) / double(group_size);
    if (direction == 1) angle = -angle;

    double w_re = cos_fd(angle);
    double w_im = sin_fd(angle);

    double tw_re = b_re * w_re - b_im * w_im;
    double tw_im = b_re * w_im + b_im * w_re;

    data_out[base_top]     = a_re + tw_re;
    data_out[base_top + 1] = a_im + tw_im;
    data_out[base_bot]     = a_re - tw_re;
    data_out[base_bot + 1] = a_im - tw_im;
}
