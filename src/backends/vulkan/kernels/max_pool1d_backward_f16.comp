#version 450

// Max Pooling 1D Backward Pass for Float16 using pre-computed indices.
// grad_input is PACKED-F16 (2 bytes/elem); a float32 atomicAdd would write 4
// bytes per element index (OOB + misrouted gradients). Accumulate via CAS.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };   // Packed float16 pairs
// Indices come from MaxPool1dForward as Int32, regardless of data dtype.
// Reading them as packed Float16 silently corrupts every index (a separate bug
// from the grad_input OOB — the forward stores DType::Int32).
layout(binding = 1) buffer Indices { int indices_data[]; };
layout(binding = 2) buffer GradInput { uint grad_input[]; };     // Packed F16, CAS-accumulated

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint grad_input_size;
    uint out_plane;   // per-(n,c) output plane size (F043)
    uint in_plane;    // per-(n,c) input plane size (F043)
} params;

// Convert half to float
float half_to_float(uint h) {
    uint sign = (h & 0x8000u) << 16;
    uint exp = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;

    if (exp == 0u) {
        if (mant == 0u) {
            return uintBitsToFloat(sign);
        }
        // Denormalized
        while ((mant & 0x400u) == 0u) {
            mant <<= 1;
            exp--;
        }
        exp++;
        mant &= ~0x400u;
        exp += 127u - 15u;
        return uintBitsToFloat(sign | (exp << 23) | (mant << 13));
    } else if (exp == 31u) {
        return uintBitsToFloat(sign | 0x7F800000u | (mant << 13));
    }
    exp += 127u - 15u;
    return uintBitsToFloat(sign | (exp << 23) | (mant << 13));
}

void atomicAddF16(uint flat_idx, float add_val) {
    uint word_idx = flat_idx / 2u;
    uint half_idx = flat_idx % 2u;
    uint mask = 0xFFFFu << (half_idx * 16u);
    uint old_val = grad_input[word_idx];
    uint expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        uint bits = (expected >> (half_idx * 16u)) & 0xFFFFu;
        float current = unpackHalf2x16(bits | (bits << 16u)).x;
        float updated = current + add_val;
        uint new_bits = packHalf2x16(vec2(updated, 0.0)).x & 0xFFFFu;
        uint new_val = (expected & ~mask) | (new_bits << (half_idx * 16u));
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Read gradient from packed float16
    uint grad_word_idx = idx / 2;
    uint grad_half_idx = idx % 2;
    uint grad_packed = grad_output[grad_word_idx];
    uint grad_half = (grad_half_idx == 0) ? (grad_packed & 0xFFFFu) : (grad_packed >> 16);
    float grad = half_to_float(grad_half);

    // Indices are Int32, one per output element.
    // F043: forward stores PLANE-LOCAL argmax; rebuild the global
    // grad_input offset via the per-(n,c) plane base.
    int plane_local = indices_data[idx];
    uint nc = idx / params.out_plane;
    int target_idx = int(nc * params.in_plane) + plane_local;
    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAddF16(uint(target_idx), grad);
    }
}
