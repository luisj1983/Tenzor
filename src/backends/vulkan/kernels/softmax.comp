#version 450

// Softmax with numerical stability
// Uses shared memory for max and sum - no external buffers needed
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint dim;           // Dimension to apply softmax (usually last)
    uint mode;          // 0=forward, 1=backward
} params;

shared float shared_max[WORKGROUP_SIZE];
shared float shared_sum[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.num_classes;

    if (params.mode == 0) {
        // Forward pass

        // Step 1: Find maximum for numerical stability
        float local_max = -1.0 / 0.0; // -infinity
        for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
            local_max = max(local_max, input_data[base_idx + i]);
        }
        shared_max[tid] = local_max;
        barrier();

        // Parallel reduction for max
        for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
            if (tid < s) {
                shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
            }
            barrier();
        }

        float row_max = shared_max[0];
        barrier();

        // Step 2: Compute exp(x - max) and sum
        float local_sum = 0.0;
        for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
            float exp_val = exp(input_data[base_idx + i] - row_max);
            output_data[base_idx + i] = exp_val;
            local_sum += exp_val;
        }
        shared_sum[tid] = local_sum;
        barrier();

        // Parallel reduction for sum
        for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
            if (tid < s) {
                shared_sum[tid] += shared_sum[tid + s];
            }
            barrier();
        }

        float row_sum = shared_sum[0];
        barrier();

        // Step 3: Divide by sum
        for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
            output_data[base_idx + i] /= row_sum;
        }
    }
}
