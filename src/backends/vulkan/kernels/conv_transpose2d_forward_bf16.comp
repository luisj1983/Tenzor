#version 450

// 2D Transposed Convolution Forward Pass for BFloat16
// Input/output packed BF16, accumulation in float32
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // Packed BF16
layout(binding = 1) buffer Weight { uint weight_data[]; };  // Packed BF16
layout(binding = 2) buffer Bias { uint bias_data[]; };      // Packed BF16
layout(binding = 3) buffer Output { uint output_data[]; };  // Packed BF16

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint in_channels;
    uint out_channels;
    uint in_height;
    uint in_width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint output_padding_h;
    uint output_padding_w;
    uint dil_h;
    uint dil_w;
    uint groups;
    uint out_h;
    uint out_w;
    uint has_bias;
} params;

float readBF16AsFloat(uint flat_idx, bool use_weight) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = use_weight ? weight_data[word_idx] : input_data[word_idx];
    uint bits = (packed >> (half_idx * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

float readBiasBF16(uint flat_idx) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = bias_data[word_idx];
    uint bits = (packed >> (half_idx * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

void writeBF16Element(uint flat_idx, float val) {
    uint word_idx = flat_idx / 2;
    uint half_offset = (flat_idx % 2) * 16;
    uint b = floatBitsToUint(val);
    uint new_bits = (b + 0x7FFFu + ((b >> 16) & 1u)) >> 16;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint r = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (r == old_word) return;
        old_word = r;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint ow = idx % params.out_w;
    uint temp = idx / params.out_w;
    uint oh = temp % params.out_h;
    temp /= params.out_h;
    uint oc = temp % params.out_channels;
    uint n = temp / params.out_channels;

    float sum = 0.0;

    uint in_channels_per_group = params.in_channels / params.groups;
    uint out_channels_per_group = params.out_channels / params.groups;
    uint group_id = oc / out_channels_per_group;
    uint oc_local = oc % out_channels_per_group;
    uint ic_start = group_id * in_channels_per_group;

    for (uint ic = 0; ic < in_channels_per_group; ic++) {
        for (uint kh = 0; kh < params.kernel_h; kh++) {
            for (uint kw = 0; kw < params.kernel_w; kw++) {
                int h_shifted = int(oh) + int(params.pad_h) - int(kh * params.dil_h);
                int w_shifted = int(ow) + int(params.pad_w) - int(kw * params.dil_w);

                if (h_shifted >= 0 && h_shifted % int(params.stride_h) == 0 &&
                    w_shifted >= 0 && w_shifted % int(params.stride_w) == 0) {
                    int ih = h_shifted / int(params.stride_h);
                    int iw = w_shifted / int(params.stride_w);

                    if (ih >= 0 && ih < int(params.in_height) && iw >= 0 && iw < int(params.in_width)) {
                        uint input_idx = n * (params.in_channels * params.in_height * params.in_width) +
                                        (ic_start + ic) * (params.in_height * params.in_width) +
                                        uint(ih) * params.in_width + uint(iw);
                        uint weight_idx = (ic_start + ic) * (out_channels_per_group * params.kernel_h * params.kernel_w) +
                                         oc_local * (params.kernel_h * params.kernel_w) +
                                         kh * params.kernel_w + kw;
                        sum += readBF16AsFloat(input_idx, false) * readBF16AsFloat(weight_idx, true);
                    }
                }
            }
        }
    }

    if (params.has_bias == 1) {
        sum += readBiasBF16(oc);
    }

    writeBF16Element(idx, sum);
}
