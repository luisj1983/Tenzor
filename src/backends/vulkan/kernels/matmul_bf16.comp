#version 450

// Matrix multiplication with tiling for BFloat16 — per-vendor workgroup specialization
// BFloat16 elements are packed 2 per 32-bit word
// Each thread computes TWO adjacent output elements to avoid race conditions
layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout(constant_id = 0) const uint TILE_X = 16;  // default fallback
layout(constant_id = 1) const uint TILE_Y = 16;  // default fallback

layout(binding = 0) buffer MatrixA { uint a[]; };
layout(binding = 1) buffer MatrixB { uint b[]; };
layout(binding = 2) buffer MatrixC { uint c[]; };

layout(push_constant) uniform PushConstants {
    uint M;  // rows of A
    uint N;  // cols of B
    uint K;  // cols of A / rows of B
} params;

shared float tileA[TILE_Y][TILE_X];
shared float tileB[TILE_X][TILE_X * 2];  // Double width for processing two columns

// Helper to read bfloat16 at a given element index
float readA(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = a[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float(uintBitsToFloat(bits << 16));
}

float readB(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = b[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float(uintBitsToFloat(bits << 16));
}

// Atomic half-word writer for the packed BFloat16 output. A blind whole-word
// store (c[word]=bits0|bits1<<16) assumes row*N is even; for odd N + odd row
// the element belongs in the high half so the truncated word_idx writes the
// wrong slot and clobbers the neighbour. Write each element independently with
// element_idx&1 + atomicCompSwap, matching matmul_f16::writeC. RNE-round to
// bf16 and mask to 16 bits (the bias can carry into bit 16 on NaN payloads).
void writeC(uint element_idx, float value) {
    uint word_idx = element_idx >> 1u;
    uint shift = (element_idx & 1u) * 16u;
    uint bits = floatBitsToUint(value);
    uint new_bits = ((bits + 0x7FFFu + ((bits >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint mask = 0xFFFFu << shift;

    uint old_val = c[word_idx];
    for (uint iter = 0u; iter < 65536u; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(c[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    // Each thread processes 2 adjacent columns to write a complete packed word
    uint col_pair = gl_GlobalInvocationID.x;
    uint col0 = col_pair * 2;
    uint col1 = col_pair * 2 + 1;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;
    uint linear_id = local_row * TILE_X + local_col;
    uint num_threads = TILE_X * TILE_Y;

    // IMPORTANT: Accumulate in float32 for precision, convert to bfloat16 only at the end
    // This matches how CUDA tensor cores work (FP16 inputs, FP32 accumulator, FP16 output)
    float sum0 = 0.0;
    float sum1 = 0.0;

    // Tile-based computation — K is tiled in steps of TILE_X
    uint num_tiles = (params.K + TILE_X - 1) / TILE_X;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from A: TILE_Y x TILE_X, one per thread
        uint a_row = row;
        uint a_col = t * TILE_X + local_col;
        if (a_row < params.M && a_col < params.K) {
            uint a_idx = a_row * params.K + a_col;
            tileA[local_row][local_col] = readA(a_idx);
        } else {
            tileA[local_row][local_col] = float(0.0);
        }

        // Load tile from B: TILE_X x (TILE_X*2) elements, linearized
        uint total_B = TILE_X * TILE_X * 2;
        for (uint i = linear_id; i < total_B; i += num_threads) {
            uint br = i / (TILE_X * 2);
            uint bc = i % (TILE_X * 2);
            uint b_row = t * TILE_X + br;
            uint b_col = gl_WorkGroupID.x * TILE_X * 2 + bc;
            if (b_row < params.K && b_col < params.N) {
                tileB[br][bc] = readB(b_row * params.N + b_col);
            } else {
                tileB[br][bc] = float(0.0);
            }
        }

        barrier();

        // Compute partial dot products for both columns
        // Convert to float32 for multiply-accumulate to maintain precision
        for (uint k = 0; k < TILE_X; k++) {
            float a_val = float(tileA[local_row][k]);
            sum0 += a_val * float(tileB[k][local_col * 2]);
            sum1 += a_val * float(tileB[k][local_col * 2 + 1]);
        }

        barrier();
    }

    // Write each result element independently via atomic half-word merge so
    // odd N / odd row never clobbers a neighbouring element's half.
    if (row < params.M && col0 < params.N) {
        writeC(row * params.N + col0, sum0);
    }
    if (row < params.M && col1 < params.N) {
        writeC(row * params.N + col1, sum1);
    }
}
