#version 450

// Affine grid generator: produces a sampling grid from an affine theta matrix.
// Replaces the previous CPU-roundtrip fallback. Float32 only.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer ThetaBuf { float theta[]; };
layout(binding = 1) buffer GridBuf  { float grid[]; };

layout(push_constant) uniform PushConstants {
    int N;
    int H;
    int W;
    int align_corners;  // bool
    int total;          // N*H*W
} params;

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= params.total) return;

    int w = idx % params.W;
    int h = (idx / params.W) % params.H;
    int n = idx / (params.H * params.W);

    float x_norm, y_norm;
    if (params.align_corners != 0) {
        x_norm = (params.W > 1) ? (2.0 * float(w) / float(params.W - 1) - 1.0) : 0.0;
        y_norm = (params.H > 1) ? (2.0 * float(h) / float(params.H - 1) - 1.0) : 0.0;
    } else {
        x_norm = (2.0 * float(w) + 1.0) / float(params.W) - 1.0;
        y_norm = (2.0 * float(h) + 1.0) / float(params.H) - 1.0;
    }

    int t_off = n * 6;
    float x_out = theta[t_off + 0] * x_norm + theta[t_off + 1] * y_norm + theta[t_off + 2];
    float y_out = theta[t_off + 3] * x_norm + theta[t_off + 4] * y_norm + theta[t_off + 5];

    int out_idx = ((n * params.H + h) * params.W + w) * 2;
    grid[out_idx]     = x_out;
    grid[out_idx + 1] = y_out;
}
