#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Bit-reversal permutation for FFT input/output reordering — Float64

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint log2_n;
    uint batch_size;
    uint batch_stride;
};

uint bit_reverse(uint x, uint bits) {
    uint result = 0;
    for (uint i = 0; i < bits; i++) {
        result = (result << 1) | (x & 1);
        x >>= 1;
    }
    return result;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;

    uint total_items = n * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n;
    uint local_tid = tid % n;

    uint rev = bit_reverse(local_tid, log2_n);

    uint src = (batch_idx * batch_stride + local_tid) * 2;
    uint dst = (batch_idx * batch_stride + rev) * 2;

    data_out[dst]     = data_in[src];
    data_out[dst + 1] = data_in[src + 1];
}
