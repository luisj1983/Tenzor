#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Average Pooling 3D Backward Pass for Float16
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };
layout(binding = 1) buffer GradInput { uint grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch_channels;
    uint in_depth;
    uint in_height;
    uint in_width;
    uint out_depth;
    uint out_height;
    uint out_width;
    uint kernel_d;
    uint kernel_h;
    uint kernel_w;
    uint stride_d;
    uint stride_h;
    uint stride_w;
    uint padding_d;
    uint padding_h;
    uint padding_w;
    uint count_include_pad;
} params;

float16_t readF16Element(uint flat_idx) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = grad_output[word_idx];
    uint bits = (packed >> (half_idx * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

void atomicAddF16(uint flat_idx, float add_val) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint mask = 0xFFFFu << (half_idx * 16);

    uint old_val = grad_input[word_idx];
    uint new_val, expected;
    for (uint iter = 0; iter < 1024; iter++) {
        expected = old_val;
        uint bits = (expected >> (half_idx * 16)) & 0xFFFFu;
        float current = unpackHalf2x16(bits | (bits << 16)).x;
        float updated = current + add_val;
        uint new_bits = packHalf2x16(vec2(updated, 0.0)).x & 0xFFFFu;
        new_val = (expected & ~mask) | (new_bits << (half_idx * 16));
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint d_out = temp % params.out_depth;
    uint bc = temp / params.out_depth;

    float grad_out = float(readF16Element(idx));

    int d_start = int(d_out * params.stride_d) - int(params.padding_d);
    int h_start = int(h_out * params.stride_h) - int(params.padding_h);
    int w_start = int(w_out * params.stride_w) - int(params.padding_w);

    uint count = 0;
    for (uint kd = 0; kd < params.kernel_d; kd++) {
        int d_in = d_start + int(kd);
        for (uint kh = 0; kh < params.kernel_h; kh++) {
            int h_in = h_start + int(kh);
            for (uint kw = 0; kw < params.kernel_w; kw++) {
                int w_in = w_start + int(kw);
                if (d_in >= 0 && d_in < int(params.in_depth) &&
                    h_in >= 0 && h_in < int(params.in_height) &&
                    w_in >= 0 && w_in < int(params.in_width)) {
                    count++;
                } else if (params.count_include_pad != 0) {
                    count++;
                }
            }
        }
    }

    float grad_per_element = 0.0;
    if (count > 0) {
        grad_per_element = grad_out / float(count);
    }

    uint in_spatial = params.in_depth * params.in_height * params.in_width;

    for (uint kd = 0; kd < params.kernel_d; kd++) {
        int d_in = d_start + int(kd);
        if (d_in < 0 || d_in >= int(params.in_depth)) continue;
        for (uint kh = 0; kh < params.kernel_h; kh++) {
            int h_in = h_start + int(kh);
            if (h_in < 0 || h_in >= int(params.in_height)) continue;
            for (uint kw = 0; kw < params.kernel_w; kw++) {
                int w_in = w_start + int(kw);
                if (w_in < 0 || w_in >= int(params.in_width)) continue;

                uint input_idx = bc * in_spatial +
                                uint(d_in) * params.in_height * params.in_width +
                                uint(h_in) * params.in_width + uint(w_in);
                atomicAddF16(input_idx, grad_per_element);
            }
        }
    }
}
