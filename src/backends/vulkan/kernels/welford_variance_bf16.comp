#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Single-pass Welford variance/std for BFloat16 input/output.
// See welford_variance.comp for the algorithm.

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint reduce_size;
    uint outer_size;
    uint inner_size;
    uint unbiased;
    uint compute_std;
} params;

shared double shared_mean[WORKGROUP_SIZE];
shared double shared_m2[WORKGROUP_SIZE];
shared uint   shared_count[WORKGROUP_SIZE];

float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2u;
    uint word_offset = element_idx % 2u;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16u)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16u);
}

// Write a single BF16 element via a bounded atomicCompSwap loop. The output
// buffer is packed 2 x bf16 per uint32 and adjacent output elements (handled by
// different workgroups running concurrently) share a word, so a plain
// read-modify-write would race and clobber the neighbouring half-word.
void writeBF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2u;
    uint word_offset = element_idx % 2u;
    uint v = floatBitsToUint(value);
    // Round-to-nearest-even when truncating from float32 to bf16.
    uint bits = ((v + 0x7FFFu + ((v >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint shift = word_offset * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = output_data[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(output_data[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT fall back to a non-atomic store — it would clobber
    // the neighbouring packed half-word written by the adjacent workgroup.
}

void welford_merge(inout double meanA, inout double m2A, inout uint countA,
                   double meanB, double m2B, uint countB) {
    if (countB == 0u) return;
    if (countA == 0u) {
        meanA = meanB;
        m2A = m2B;
        countA = countB;
        return;
    }
    uint n = countA + countB;
    double delta = meanB - meanA;
    double nA = double(countA);
    double nB = double(countB);
    double nTot = double(n);
    meanA = meanA + delta * nB / nTot;
    m2A = m2A + m2B + delta * delta * nA * nB / nTot;
    countA = n;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint output_idx = gl_WorkGroupID.x;
    if (output_idx >= params.outer_size) return;

    uint outer_idx = output_idx / params.inner_size;
    uint inner_idx = output_idx % params.inner_size;
    uint base_idx  = outer_idx * params.reduce_size * params.inner_size + inner_idx;

    double local_mean = 0.0lf;
    double local_m2   = 0.0lf;
    uint   local_n    = 0u;

    for (uint i = tid; i < params.reduce_size; i += WORKGROUP_SIZE) {
        uint idx = base_idx + i * params.inner_size;
        if (idx < params.n) {
            double x = double(readBF16(idx));
            local_n += 1u;
            double delta = x - local_mean;
            local_mean = local_mean + delta / double(local_n);
            double delta2 = x - local_mean;
            local_m2 = local_m2 + delta * delta2;
        }
    }

    shared_mean[tid]  = local_mean;
    shared_m2[tid]    = local_m2;
    shared_count[tid] = local_n;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2u; s > 0u; s >>= 1) {
        if (tid < s) {
            welford_merge(shared_mean[tid], shared_m2[tid], shared_count[tid],
                          shared_mean[tid + s], shared_m2[tid + s], shared_count[tid + s]);
        }
        barrier();
    }

    if (tid == 0u) {
        uint count = shared_count[0];
        double denom = (params.unbiased != 0u && count > 1u)
                       ? double(count - 1u)
                       : double(max(count, 1u));
        double variance = shared_m2[0] / denom;
        double result = (params.compute_std != 0u) ? sqrt(variance) : variance;
        writeBF16(output_idx, float(result));
    }
}
