#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Fused Adadelta optimizer step (Float64)
// Per-element: updates square_avg, acc_delta, and param in one kernel
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { float64_t grad_data[]; };
layout(binding = 1) buffer Param { float64_t param_data[]; };
layout(binding = 2) buffer SquareAvg { float64_t square_avg[]; };
layout(binding = 3) buffer AccDelta { float64_t acc_delta[]; };

layout(push_constant) uniform PushConstants {
    uint numel;
    float lr;
    float rho;
    float eps;
    float weight_decay;
    uint padding0;
    uint padding1;
    uint padding2;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.numel) return;

    float64_t g = grad_data[gid];

    float64_t lr_d = float64_t(params.lr);
    float64_t rho_d = float64_t(params.rho);
    float64_t eps_d = float64_t(params.eps);
    float64_t wd_d = float64_t(params.weight_decay);

    // Weight decay
    if (params.weight_decay > 0.0) {
        g += wd_d * param_data[gid];
    }

    // Accumulate squared gradient
    float64_t sq = rho_d * square_avg[gid] + (1.0LF - rho_d) * g * g;
    square_avg[gid] = sq;

    // Compute update delta
    // GLSL sqrt only works on float — cast down for sqrt
    float64_t std_delta = float64_t(sqrt(float(acc_delta[gid] + eps_d)));
    float64_t std_grad = float64_t(sqrt(float(sq + eps_d)));
    float64_t delta = std_delta / std_grad * g;

    // Accumulate squared update
    acc_delta[gid] = rho_d * acc_delta[gid] + (1.0LF - rho_d) * delta * delta;

    // Update parameter
    param_data[gid] -= lr_d * delta;
}
