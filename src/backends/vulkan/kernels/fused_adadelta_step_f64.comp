#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Fused Adadelta optimizer step (Float64)
// Per-element: updates square_avg, acc_delta, and param in one kernel
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { float64_t grad_data[]; };
layout(binding = 1) buffer Param { float64_t param_data[]; };
layout(binding = 2) buffer SquareAvg { float64_t square_avg[]; };
layout(binding = 3) buffer AccDelta { float64_t acc_delta[]; };

// Hyperparameters are `double` push constants, not `float` — this is the F64
// kernel; a float32 push constant would cap every downstream float64_t
// computation to float32 precision regardless of in-shader math (see
// fused_adam_step_f64.comp for the diagnosis).
layout(push_constant) uniform PushConstants {
    uint numel;
    uint padding0;
    double lr;
    double rho;
    double eps;
    double weight_decay;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.numel) return;

    float64_t g = grad_data[gid];

    float64_t lr_d = float64_t(params.lr);
    float64_t rho_d = float64_t(params.rho);
    float64_t eps_d = float64_t(params.eps);
    float64_t wd_d = float64_t(params.weight_decay);

    // Weight decay
    if (params.weight_decay > 0.0) {
        g += wd_d * param_data[gid];
    }

    // Accumulate squared gradient
    float64_t sq = rho_d * square_avg[gid] + (1.0LF - rho_d) * g * g;
    square_avg[gid] = sq;

    // Per attention-contract.md F64 sqrt rule: refine a float guess in F64
    // (audit C10 Vulkan). Helper computes sqrt(x) ≈ x * (1/sqrt(float(x)))
    // refined via two Newton-Raphson iterations in F64 (full ~52-bit mantissa).
    float64_t ad_in = acc_delta[gid] + eps_d;
    float64_t inv_sd = float64_t(1.0) / float64_t(sqrt(float(ad_in)));
    inv_sd = inv_sd * (float64_t(1.5) - float64_t(0.5) * ad_in * inv_sd * inv_sd);
    inv_sd = inv_sd * (float64_t(1.5) - float64_t(0.5) * ad_in * inv_sd * inv_sd);
    float64_t std_delta = ad_in * inv_sd;
    float64_t sg_in = sq + eps_d;
    float64_t inv_sg = float64_t(1.0) / float64_t(sqrt(float(sg_in)));
    inv_sg = inv_sg * (float64_t(1.5) - float64_t(0.5) * sg_in * inv_sg * inv_sg);
    inv_sg = inv_sg * (float64_t(1.5) - float64_t(0.5) * sg_in * inv_sg * inv_sg);
    float64_t std_grad = sg_in * inv_sg;
    float64_t delta = std_delta / std_grad * g;

    // Accumulate squared update
    acc_delta[gid] = rho_d * acc_delta[gid] + (1.0LF - rho_d) * delta * delta;

    // Update parameter
    param_data[gid] -= lr_d * delta;
}
