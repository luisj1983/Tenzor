#version 450

// MaxUnpool2d Forward — scatter input values to output positions given by indices.
// Output is zero-initialized before dispatch.
// Each invocation handles one input element.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input   { float input_data[]; };   // [N, C, H_in, W_in]
layout(binding = 1) readonly buffer Indices { int   indices_data[]; };  // [N, C, H_in, W_in]
layout(binding = 2) writeonly buffer Output { float output_data[]; };   // [N, C, out_h, out_w]

layout(push_constant) uniform PushConstants {
    uint total_input;    // N * C * H_in * W_in
    uint in_spatial;     // H_in * W_in
    uint out_spatial;    // out_h * out_w
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_input) return;

    uint channel_idx = idx / params.in_spatial;
    uint base_out = channel_idx * params.out_spatial;

    int unpool_idx = indices_data[idx];
    // Guard against an out-of-range index (prevents an out-of-bounds device write).
    if (unpool_idx >= 0 && uint(unpool_idx) < params.out_spatial) {
        output_data[base_out + uint(unpool_idx)] = input_data[idx];
    }
}
