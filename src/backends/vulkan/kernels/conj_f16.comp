#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Complex conjugate: negate the imaginary part of each complex number — Float16
// Each complex element is one uint32 word (real in low 16, imag in high 16)
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input { uint in_data[]; };
layout(binding = 1) buffer Output { uint out_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_complex;  // Number of complex numbers
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_complex) return;

    vec2 val = unpackHalf2x16(in_data[idx]);
    // Negate imaginary part
    out_data[idx] = packHalf2x16(vec2(val.x, -val.y));
}
