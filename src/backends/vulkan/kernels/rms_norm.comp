#version 450

// RMS Normalization (Float32)
// One workgroup per batch element
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };
layout(binding = 2) buffer Weight { float weight_data[]; };
layout(binding = 3) buffer RrmsOut { float rrms_out[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint normalized_shape;
    float epsilon;
    uint padding;
} params;

shared float shared_sum_sq[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.normalized_shape;

    // JIT-R164: Kahan (compensated) summation for the per-thread serial
    // accumulation -- this is the dominant error source (up to
    // normalized_shape/WORKGROUP_SIZE terms per thread), unlike the final
    // log2(WORKGROUP_SIZE)-step tree reduction below, which has too few
    // additions to need compensation. GLSL has no portable native double
    // without gating on VK_KHR_shader_float64 (not all devices support it);
    // Kahan summation is the portable fix, and is the same technique this
    // codebase's own CPU/CUDA codegen already uses for Sum/Mean/Softmax
    // reductions (extended_codegen.cpp), not a stopgap workaround.
    float local_sum_sq = 0.0;
    float c = 0.0;  // running compensation for low-order bits lost to rounding
    for (uint i = tid; i < params.normalized_shape; i += WORKGROUP_SIZE) {
        float val = input_data[base_idx + i];
        float term = val * val;
        float y = term - c;
        float t = local_sum_sq + y;
        c = (t - local_sum_sq) - y;
        local_sum_sq = t;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    // Parallel reduction for sum of squares
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    float rms = sqrt(shared_sum_sq[0] / float(params.normalized_shape) + params.epsilon);
    float rrms = 1.0 / rms;
    barrier();

    // Store rrms for backward pass
    if (tid == 0) {
        rrms_out[batch_idx] = rrms;
    }

    // Step 2: Normalize and apply weight
    for (uint i = tid; i < params.normalized_shape; i += WORKGROUP_SIZE) {
        output_data[base_idx + i] = input_data[base_idx + i] * rrms * weight_data[i];
    }
}
