#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// Bincount (Float64): count weighted occurrences of each value in an integer tensor.
// Accumulates weights in double precision via a 64-bit CAS-loop atomic (same pattern
// as scatter_add_f64), so the result matches the CPU Float64 reference instead of
// losing precision through a Float32 accumulator.
//
// Requires GL_EXT_shader_atomic_int64 (and the int64/float64 explicit-arithmetic-type
// extensions). The host gates dispatch of this shader on devices_[device_id].hasAtomicInt64.
//
// Input values must be non-negative integers stored as int32. Weights (binding 1) are
// always present for this variant (has_weights is implicitly 1).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { int input_data[]; };              // Input integer values
layout(binding = 1) buffer Weights { float64_t weights_data[]; };    // Weights (Float64)
layout(binding = 2) buffer Output { uint64_t output_data[]; };       // Output bins (uint64_t for CAS atomics)

layout(push_constant) uniform PushConstants {
    uint n;              // Number of input elements
    uint num_bins;       // Number of output bins
    uint has_weights;    // Always 1 for this variant (kept for push-constant layout parity)
} params;

// Bit-cast helpers (match scatter_add_f64.comp)
float64_t bitsToF64(uint64_t bits) {
    return float64_t(packDouble2x32(uvec2(uint(bits), uint(bits >> 32u))));
}

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

// Atomic add for double using a compare-and-swap loop
void atomicAddF64(uint idx, float64_t val) {
    uint64_t old_bits = output_data[idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float64_t old_val = bitsToF64(old_bits);
        uint64_t new_bits = f64ToBits(old_val + val);
        uint64_t result = atomicCompSwap(output_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    int val = input_data[i];
    if (val < 0 || uint(val) >= params.num_bins) return;

    atomicAddF64(uint(val), weights_data[i]);
}
