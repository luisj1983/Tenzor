#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Softmax with numerical stability for Float16
// Float16 elements are packed 2 per 32-bit word
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };
layout(binding = 2) buffer MaxVals { uint max_vals[]; };    // Pre-computed max per row (packed)
layout(binding = 3) buffer SumVals { uint sum_vals[]; };    // Pre-computed sum per row (packed)

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint dim;           // Dimension to apply softmax (usually last)
    uint mode;          // 0=forward, 1=backward
} params;

shared float shared_max[256];
shared float shared_sum[256];

// Helper to read float16 at element index
float16_t readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

// Helper to write float16 at element index
void writeF16(uint element_idx, float16_t val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = packHalf2x16(vec2(float(val), 0.0)).x & 0xFFFFu;

    if (word_offset == 0) {
        uint existing = output_data[word_idx];
        output_data[word_idx] = (existing & 0xFFFF0000u) | bits;
    } else {
        uint existing = output_data[word_idx];
        output_data[word_idx] = (existing & 0x0000FFFFu) | (bits << 16);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.num_classes;

    if (params.mode == 0) {
        // Forward pass

        // Step 1: Find maximum for numerical stability (use float for reduction)
        float local_max = -1.0 / 0.0; // -infinity
        for (uint i = tid; i < params.num_classes; i += 256) {
            float val = float(readF16(base_idx + i));
            local_max = max(local_max, val);
        }
        shared_max[tid] = local_max;
        barrier();

        // Parallel reduction for max
        for (uint s = 128; s > 0; s >>= 1) {
            if (tid < s) {
                shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
            }
            barrier();
        }

        float row_max = shared_max[0];
        barrier();

        // Step 2: Compute exp(x - max) and sum (using float for intermediate values)
        float local_sum = 0.0;
        for (uint i = tid; i < params.num_classes; i += 256) {
            float val = float(readF16(base_idx + i));
            float exp_val = exp(val - row_max);
            writeF16(base_idx + i, float16_t(exp_val));
            local_sum += exp_val;
        }
        shared_sum[tid] = local_sum;
        barrier();

        // Parallel reduction for sum
        for (uint s = 128; s > 0; s >>= 1) {
            if (tid < s) {
                shared_sum[tid] += shared_sum[tid + s];
            }
            barrier();
        }

        float row_sum = shared_sum[0];
        barrier();

        // Step 3: Divide by sum
        for (uint i = tid; i < params.num_classes; i += 256) {
            uint elem_idx = base_idx + i;
            uint word_idx = elem_idx / 2;
            uint word_offset = elem_idx % 2;
            uint packed = output_data[word_idx];
            uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
            float16_t current = float16_t(unpackHalf2x16(bits | (bits << 16)).x);
            writeF16(elem_idx, float16_t(float(current) / row_sum));
        }

        // Store max and sum for backward pass (as Float16 packed)
        if (tid == 0) {
            uint max_bits = packHalf2x16(vec2(row_max, 0.0)).x & 0xFFFFu;
            uint sum_bits = packHalf2x16(vec2(row_sum, 0.0)).x & 0xFFFFu;
            max_vals[batch_idx / 2] = (batch_idx % 2 == 0) ?
                ((max_vals[batch_idx / 2] & 0xFFFF0000u) | max_bits) :
                ((max_vals[batch_idx / 2] & 0x0000FFFFu) | (max_bits << 16));
            sum_vals[batch_idx / 2] = (batch_idx % 2 == 0) ?
                ((sum_vals[batch_idx / 2] & 0xFFFF0000u) | sum_bits) :
                ((sum_vals[batch_idx / 2] & 0x0000FFFFu) | (sum_bits << 16));
        }
    }
}
