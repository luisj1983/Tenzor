#version 450

// Fused RMSprop optimizer step for BFloat16 parameters
// Grad/param buffers are packed BF16; state buffers are Float32 (master weights)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { uint grad_data[]; };                // Packed BF16
layout(binding = 1) buffer Param { uint param_data[]; };              // Packed BF16
layout(binding = 2) buffer SquareAvg { float square_avg[]; };         // Float32
layout(binding = 3) buffer MomentumBuf { float momentum_buf[]; };     // Float32
layout(binding = 4) buffer GradAvg { float grad_avg[]; };             // Float32

layout(push_constant) uniform PushConstants {
    uint numel;
    float lr;
    float alpha;
    float eps;
    float weight_decay;
    float momentum;
    uint centered;
    uint has_momentum;
} params;

// Helper to read bfloat16 from packed buffer
// flat_idx: element index; buf_sel: 0 = grad, 1 = param
float readBF16(uint flat_idx, uint buf_sel) {
    uint word_idx = flat_idx / 2u;
    uint half_idx = flat_idx % 2u;
    uint packed;
    if (buf_sel == 0u) packed = grad_data[word_idx];
    else packed = param_data[word_idx];
    uint bits = (packed >> (half_idx * 16u)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

float rmspropStep(uint idx) {
    float g = readBF16(idx, 0);
    float p = readBF16(idx, 1);

    if (params.weight_decay > 0.0) {
        g += params.weight_decay * p;
    }

    float sq = params.alpha * square_avg[idx] + (1.0 - params.alpha) * g * g;
    square_avg[idx] = sq;

    float denom;
    if (params.centered != 0) {
        float ga = params.alpha * grad_avg[idx] + (1.0 - params.alpha) * g;
        grad_avg[idx] = ga;
        denom = sqrt(sq - ga * ga + params.eps);
    } else {
        denom = sqrt(sq + params.eps);
    }

    if (params.has_momentum != 0) {
        float buf = params.momentum * momentum_buf[idx] + g / denom;
        momentum_buf[idx] = buf;
        p -= params.lr * buf;
    } else {
        p -= params.lr * g / denom;
    }

    return p;
}

void main() {
    uint word_idx = gl_GlobalInvocationID.x;
    uint num_words = (params.numel + 1) / 2;
    if (word_idx >= num_words) return;

    uint elem0 = word_idx * 2;
    uint elem1 = word_idx * 2 + 1;

    float p0 = 0.0, p1 = 0.0;

    if (elem0 < params.numel) {
        p0 = rmspropStep(elem0);
    }
    if (elem1 < params.numel) {
        p1 = rmspropStep(elem1);
    }

    uint bits0 = ((floatBitsToUint(p0) + 0x7FFFu + ((floatBitsToUint(p0) >> 16) & 1u)) >> 16);
    uint bits1 = ((floatBitsToUint(p1) + 0x7FFFu + ((floatBitsToUint(p1) >> 16) & 1u)) >> 16);
    param_data[word_idx] = bits0 | (bits1 << 16);
}
