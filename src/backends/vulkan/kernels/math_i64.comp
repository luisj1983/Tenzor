#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Math operations for Int64 dtype: add, sub, mul, div, neg, abs, sign
// Uses 64-bit integer extension for proper 64-bit arithmetic
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { int64_t a[]; };
layout(binding = 1) buffer InputB { int64_t b[]; };
layout(binding = 2) buffer Output { int64_t result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 7=neg, 8=abs, 10=sign, 36=gcd, 37=lcm
    int param;       // Parameter for operations (unused for basic ops)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    int64_t val_a = a[idx];
    int64_t val_b = b[idx];
    int64_t res = int64_t(0);

    switch (params.op) {
        case 0: // add
            res = val_a + val_b;
            break;
        case 1: // sub
            res = val_a - val_b;
            break;
        case 2: // mul
            res = val_a * val_b;
            break;
        case 3: // div
            res = val_a / val_b;
            break;
        case 7: // neg (unary)
            res = -val_a;
            break;
        case 8: // abs (unary)
            res = (val_a < int64_t(0)) ? -val_a : val_a;
            break;
        case 10: // sign (unary)
            if (val_a < int64_t(0)) {
                res = int64_t(-1);
            } else if (val_a > int64_t(0)) {
                res = int64_t(1);
            } else {
                res = int64_t(0);
            }
            break;
        case 36: { // gcd (binary)
            int64_t ga = val_a < int64_t(0) ? -val_a : val_a;
            int64_t gb = val_b < int64_t(0) ? -val_b : val_b;
            while (gb != int64_t(0)) { int64_t t = gb; gb = ga - (ga / gb) * gb; ga = t; }
            res = ga;
            break;
        }
        case 37: { // lcm (binary)
            int64_t ga = val_a < int64_t(0) ? -val_a : val_a;
            int64_t gb = val_b < int64_t(0) ? -val_b : val_b;
            int64_t ta = ga; int64_t tb = gb;
            while (tb != int64_t(0)) { int64_t t = tb; tb = ta - (ta / tb) * tb; ta = t; }
            int64_t g = ta;
            res = (g == int64_t(0)) ? int64_t(0) : (ga / g) * gb;
            break;
        }
        case 52: { // bitwise_not
            res = ~val_a;
            break;
        }
        default:
            res = int64_t(0);
            break;
    }

    // Result naturally wraps on overflow for int64
    result[idx] = res;
}
