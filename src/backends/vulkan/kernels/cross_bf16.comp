#version 450

// Cross product along a dimension for BFloat16
// BFloat16: upper 16 bits of float32, stored as 2 per uint word
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { uint a_buf[]; };
layout(binding = 1) buffer InputB { uint b_buf[]; };
layout(binding = 2) buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint num_pairs;
    uint dim_stride;
} params;

float readBF16A(uint flat_idx) {
    uint word = a_buf[flat_idx >> 1];
    uint shift = (flat_idx & 1u) * 16u;
    uint bits = (word >> shift) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

float readBF16B(uint flat_idx) {
    uint word = b_buf[flat_idx >> 1];
    uint shift = (flat_idx & 1u) * 16u;
    uint bits = (word >> shift) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

void writeBF16(uint flat_idx, float val) {
    uint word_idx = flat_idx >> 1;
    uint shift = (flat_idx & 1u) * 16u;
    uint bits = (floatBitsToUint(val) >> 16) & 0xFFFFu;
    atomicAnd(result[word_idx], ~(0xFFFFu << shift));
    atomicOr(result[word_idx], bits << shift);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_pairs) return;

    uint o = idx / params.dim_stride;
    uint i = idx % params.dim_stride;
    uint base = o * 3 * params.dim_stride + i;

    float a0 = readBF16A(base);
    float a1 = readBF16A(base + params.dim_stride);
    float a2 = readBF16A(base + 2 * params.dim_stride);
    float b0 = readBF16B(base);
    float b1 = readBF16B(base + params.dim_stride);
    float b2 = readBF16B(base + 2 * params.dim_stride);

    writeBF16(base,                           a1*b2 - a2*b1);
    writeBF16(base + params.dim_stride,       a2*b0 - a0*b2);
    writeBF16(base + 2 * params.dim_stride,   a0*b1 - a1*b0);
}
