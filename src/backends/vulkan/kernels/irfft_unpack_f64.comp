#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Complex-to-Real IFFT: Unpack N/2 complex values back to N real values — Float64

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;                // Original real FFT size (N)
    uint batch_size;       // Number of independent FFTs
    uint in_batch_stride;  // Stride between input batches (in double elements)
    uint out_batch_stride; // Stride between output batches (in real elements)
};

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint half_n = n / 2;
    uint total_items = half_n * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / half_n;
    uint local_tid = tid % half_n;

    uint src_base = batch_idx * in_batch_stride + local_tid * 2;
    uint dst_base = batch_idx * out_batch_stride + local_tid * 2;

    data_out[dst_base]     = data_in[src_base];
    data_out[dst_base + 1] = data_in[src_base + 1];
}
