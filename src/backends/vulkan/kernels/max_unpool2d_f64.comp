#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// MaxUnpool2d Forward Float64 — scatter input values to output positions
// given by indices. Output is zero-initialized before dispatch.
// audit-2026-05-03 — added so the Float64 autograd path doesn't go through
// f32 (which dropped ~30 mantissa bits and broke gradcheck).
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input   { double input_data[]; };
layout(binding = 1) readonly buffer Indices { int    indices_data[]; };
layout(binding = 2) writeonly buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint total_input;
    uint in_spatial;
    uint out_spatial;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_input) return;

    uint channel_idx = idx / params.in_spatial;
    uint base_out = channel_idx * params.out_spatial;

    int unpool_idx = indices_data[idx];
    // Guard against an out-of-range index (prevents an out-of-bounds device write).
    if (unpool_idx >= 0 && uint(unpool_idx) < params.out_spatial) {
        output_data[base_out + uint(unpool_idx)] = input_data[idx];
    }
}
