#version 450

// Convert CSR sparse matrix to dense (row-major)
// One workgroup per row: zero the row, then scatter non-zero values
//
// Duplicate (row,col) entries within a single CSR row are summed (matching
// CPU/CUDA/ROCm's SparseTensor::to_dense() scatter_add semantics), not
// overwritten. Distinct threads/invocations in the same workgroup can target
// the same dense output element for such duplicates, so the write must be
// atomic — a plain read-modify-write here would be a data race.
#extension GL_EXT_shader_atomic_float : enable

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer RowOffsets { int row_offsets[]; };
layout(set = 0, binding = 1) readonly buffer ColIndices { int col_indices[]; };
layout(set = 0, binding = 2) readonly buffer Values     { float values[];     };
layout(set = 0, binding = 3) buffer Dense               { float dense[];      };

layout(push_constant) uniform PushConstants {
    uint n_rows;
    uint n_cols;
};

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= n_rows) return;

    // Zero out this row first
    for (uint col = tid; col < n_cols; col += gl_WorkGroupSize.x) {
        dense[row * n_cols + col] = 0.0;
    }
    barrier();

    // Scatter non-zero values
    uint row_start = uint(row_offsets[row]);
    uint row_end = uint(row_offsets[row + 1]);
    for (uint i = row_start + tid; i < row_end; i += gl_WorkGroupSize.x) {
        uint col = uint(col_indices[i]);
        // Accumulate rather than overwrite: duplicate column entries within
        // this row must sum, and different invocations may race on the same
        // (row,col) slot.
        atomicAdd(dense[row * n_cols + col], values[i]);
    }
}
