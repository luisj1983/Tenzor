#version 450

// scatter_reduce !include_self init pass.
// Writes the per-mode identity value to every output position that will be
// touched by the subsequent scatter_reduce dispatch. Positions never
// touched retain their original input value, matching CPU semantics.
//
// Modes: 0=sum, 1=prod, 2=mean, 3=amax, 4=amin (identity values vary).
//
// Phase 7.6 SumNoIncludeSelf fix.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint out_data[]; };  // float storage as uint
layout(binding = 1) buffer Index  { int idx_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;                 // index.numel()
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uint mode;              // 0=sum, 1=prod, 2=mean, 3=amax, 4=amin
    uint pad0;
    uint pad1;
    uint pad2;
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

float identity_for(uint mode) {
    if (mode == 0u || mode == 2u) return 0.0;       // sum / mean
    if (mode == 1u) return 1.0;                      // prod
    if (mode == 3u) return -3.402823466e+38;         // amax (-FLT_MAX)
    return 3.402823466e+38;                          // amin (+FLT_MAX)
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= params.n) return;

    int dest = idx_data[tid];
    if (dest < 0) dest += int(params.dim_size);
    if (dest < 0 || dest >= int(params.dim_size)) return;

    // Per-dim decode of the flat index position, recomposed onto self strides.
    uint temp = tid;
    uint out_pos = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_pos += uint(dest) * selfStride(d);
        } else {
            out_pos += coord * selfStride(d);
        }
    }
    out_data[out_pos] = floatBitsToUint(identity_for(params.mode));
}
