#version 450

// Phase 8.4: histc variant that reads min/max from a device-side range buffer
// (same 3-float layout as histogram_dyn: range[0]=min, range[1]=max, range[2]=bin_width).

layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input  { float input_data[]; };
layout(binding = 1)          buffer Output { uint  output_data[]; };
layout(binding = 2) readonly buffer Range  { float range[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
    uint num_bins;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;

    float min_val   = range[0];
    float max_val   = range[1];
    float bin_width = range[2];

    float val = input_data[idx];
    // NaN: CPU explicitly skips NaN entries (std::isnan(val) -> continue).
    // Without this check NaN falls through the range test below (both
    // comparisons are false for NaN) into uint((val-min_val)/bin_width), and
    // converting a NaN float to uint is GLSL UB. `val != val` is a reliable
    // NaN test in shaders (see reduction.comp: GLSL's isnan() builtin is
    // driver-flaky, so avoid it for a correctness-critical check).
    if (val != val) return;
    if (val < min_val || val > max_val) return;
    uint bin = uint((val - min_val) / bin_width);
    if (bin >= params.num_bins) bin = params.num_bins - 1;
    atomicAdd(output_data[bin], 1u);
}
