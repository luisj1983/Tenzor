#version 450

// Linear layer for BFloat16: output = input @ weight^T + bias
// BFloat16 elements packed 2 per 32-bit word
// Each thread computes 2 adjacent output columns
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Weight { uint weight_data[]; };
layout(binding = 2) buffer Bias { uint bias_data[]; };
layout(binding = 3) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
    uint has_bias;
} params;

shared float tileA[16][16];
shared float tileB[16][32];

float readInput(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float(uintBitsToFloat(bits << 16));
}

float readWeight(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = weight_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float(uintBitsToFloat(bits << 16));
}

float readBias(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = bias_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return float(uintBitsToFloat(bits << 16));
}

// Write a single BF16 element to packed output using bounded CAS masked-RMW.
//
// Two invocations writing to adjacent BF16 lanes in the same uint32 word
// race when a non-atomic full-word store is used. For odd N the column pair
// (col0, col1) owned by one invocation may straddle word boundaries shared
// with another invocation's columns (e.g. col0 on an odd flat index lands in
// the high lane of one word while col1 lands in the low lane of the next
// word, which another invocation also writes). Compute the word/lane for each
// element from its own flat index and CAS only that lane. Matches the pattern
// in bmm_strided_bf16.comp / bmm_bf16.comp::writeBF16C.
void writeBF16Out(uint out_idx, float value) {
    uint out_word = out_idx / 2;
    uint out_off = out_idx % 2;
    uint shift = out_off * 16u;
    uint mask = 0xFFFFu << shift;
    uint new_bits = ((floatBitsToUint(value) + 0x7FFFu + ((floatBitsToUint(value) >> 16) & 1u)) >> 16);

    uint old_val = output_data[out_word];
    for (uint iter = 0u; iter < 65536u; ++iter) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(output_data[out_word], expected, new_val);
        if (old_val == expected) return;
    }
    // cap-exhaust unreachable in practice; see bmm_bf16.comp note.
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col_pair = gl_GlobalInvocationID.x;
    uint col0 = col_pair * 2;
    uint col1 = col_pair * 2 + 1;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    // Accumulate in float32 for precision
    float sum0 = 0.0;
    float sum1 = 0.0;

    uint num_tiles = (params.K + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from input
        uint a_col = t * 16 + local_col;
        if (row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = readInput(row * params.K + a_col);
        } else {
            tileA[local_row][local_col] = float(0.0);
        }

        // Load tile from weight (transposed: weight[col, k])
        uint b_row = t * 16 + local_row;
        if (b_row < params.K) {
            if (col0 < params.N) {
                tileB[local_row][local_col * 2] = readWeight(col0 * params.K + b_row);
            } else {
                tileB[local_row][local_col * 2] = float(0.0);
            }
            if (col1 < params.N) {
                tileB[local_row][local_col * 2 + 1] = readWeight(col1 * params.K + b_row);
            } else {
                tileB[local_row][local_col * 2 + 1] = float(0.0);
            }
        } else {
            tileB[local_row][local_col * 2] = float(0.0);
            tileB[local_row][local_col * 2 + 1] = float(0.0);
        }

        barrier();

        for (uint k = 0; k < 16; k++) {
            float a_val = float(tileA[local_row][k]);
            sum0 += a_val * float(tileB[k][local_col * 2]);
            sum1 += a_val * float(tileB[k][local_col * 2 + 1]);
        }

        barrier();
    }

    // Add bias if present
    if (row < params.M && col0 < params.N) {
        if (params.has_bias != 0) {
            sum0 += float(readBias(col0));
            if (col1 < params.N) {
                sum1 += float(readBias(col1));
            }
        }

        // Write each BF16 element to its own lane via bounded CAS. col0 and
        // col1 may land in different words (or share words with columns owned
        // by adjacent invocations) when N is odd, so each must be stored with
        // a masked atomic RMW rather than a single full-word store.
        uint out_idx0 = row * params.N + col0;
        writeBF16Out(out_idx0, sum0);
        if (col1 < params.N) {
            writeBF16Out(out_idx0 + 1u, sum1);
        }
    }
}
