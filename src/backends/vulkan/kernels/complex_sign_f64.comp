#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// findings.txt: Complex128 sign (sgn): z/|z|, and 0 for z == 0.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;  // number of COMPLEX elements
};

// JIT-R127: a * a + b * b overflows to Inf for |a| or |b| >~ 1e154 (double)
// even when the true hypot value is representable -- diverging from CPU/
// CUDA/ROCm/OneAPI's hypot-based sign() for very-large-magnitude complex
// inputs. Standard overflow-safe two-argument hypot (see complex_sign.comp
// for the Float32 variant).
double hypot_safe(double x, double y) {
    x = abs(x);
    y = abs(y);
    // JIT-R171: see complex_sign.comp for the Float32 variant -- max()/min()
    // silently discard a NaN operand on this hardware/driver instead of
    // propagating it, so a NaN component must be handled before them.
    if (isnan(x) || isnan(y)) return x + y;
    double mx = max(x, y);
    double mn = min(x, y);
    if (mx == 0.0) return 0.0;
    double r = mn / mx;
    return mx * sqrt(1.0 + r * r);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;
    double a = data_in[idx * 2u];
    double b = data_in[idx * 2u + 1u];
    double mag = hypot_safe(a, b);
    // JIT-R171: see complex_sign.comp for the Float32 variant.
    if (mag == 0.0) {
        data_out[idx * 2u]      = 0.0;
        data_out[idx * 2u + 1u] = 0.0;
    } else {
        data_out[idx * 2u]      = a / mag;
        data_out[idx * 2u + 1u] = b / mag;
    }
}
