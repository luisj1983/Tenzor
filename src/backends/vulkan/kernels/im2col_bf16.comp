#version 450

// Im2col (Unfold) operation for BFloat16
// Transforms (N,C,H,W) -> (N, C*K_h*K_w, L) where L=out_h*out_w
// BFloat16 elements are packed 2 per 32-bit word
// HH.6: per-axis kernel/stride/padding/dilation.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint height;
    uint width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint dil_h;
    uint dil_w;
    uint out_h;
    uint out_w;
} params;

// Read a single bfloat16 value from packed input buffer
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Write a single bfloat16 value to packed output buffer.
// Two bfloat16 elements share one 32-bit word, and neighbouring elements are
// written by independent invocations (one per output element), so the packed
// read-modify-write must be done atomically (CAS loop) to avoid one
// invocation's update being lost.
void writeBF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_bits = ((floatBitsToUint(value) + 0x7FFFu + ((floatBitsToUint(value) >> 16) & 1u)) >> 16);
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint observed = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (observed == old_word) return;
        old_word = observed;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint num_blocks = params.out_h * params.out_w;

    // Decode flat index to (b, c, kh, kw, block_idx)
    uint temp = idx;
    uint block_idx = temp % num_blocks; temp /= num_blocks;
    uint kw = temp % params.kernel_w; temp /= params.kernel_w;
    uint kh = temp % params.kernel_h; temp /= params.kernel_h;
    uint c = temp % params.channels; temp /= params.channels;
    uint b = temp;

    uint oh = block_idx / params.out_w;
    uint ow = block_idx % params.out_w;

    int ih = int(oh * params.stride_h) - int(params.pad_h) + int(kh * params.dil_h);
    int iw = int(ow * params.stride_w) - int(params.pad_w) + int(kw * params.dil_w);

    uint col_c = c * params.kernel_h * params.kernel_w +
                 kh * params.kernel_w + kw;

    uint output_idx = b * (params.channels * params.kernel_h * params.kernel_w * num_blocks) +
                      col_c * num_blocks +
                      block_idx;

    if (ih >= 0 && ih < int(params.height) && iw >= 0 && iw < int(params.width)) {
        uint input_idx = b * (params.channels * params.height * params.width) +
                        c * (params.height * params.width) +
                        uint(ih) * params.width + uint(iw);
        writeBF16(output_idx, readBF16(input_idx));
    } else {
        writeBF16(output_idx, 0.0);
    }
}
