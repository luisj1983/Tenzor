#version 450

// MaxUnpool3d Forward — scatter input values to output using indices.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input   { float input_data[]; };
layout(binding = 1) readonly buffer Indices { int   indices_data[]; };
layout(binding = 2) writeonly buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint total_input;
    uint in_spatial;     // D_in * H_in * W_in
    uint out_spatial;    // out_d * out_h * out_w
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_input) return;

    uint channel_idx = idx / params.in_spatial;
    uint base_out = channel_idx * params.out_spatial;
    int unpool_idx = indices_data[idx];
    output_data[base_out + uint(unpool_idx)] = input_data[idx];
}
