#version 450

// Vulkan device-side Philox4x32-10 dropout mask generator.
//
// F22-followup: eliminates the prior CPU fallback in the Vulkan
// FlashAttention composed-ops dropout path. Previously the mask was built
// host-side via `tenzor::philox_dropout_mask` and copied to the Vulkan
// device; this shader writes the mask directly into a device-allocated
// buffer in a single dispatch.
//
// Counter convention matches the host helper + OneAPI device kernel +
// CUDA/ROCm FA kernels exactly:
//
//     ctr = (batch_head, query_idx, kv_pos, offset)   // 3-D or 4-D attention shape
//     ctr = (linear_index, 0, 0, offset)              // generic shape
//     key = (seed_low_32, seed_low_32 ^ 0x1BD11BDA)
//
// So masks generated by this shader are bit-exactly identical to those
// produced by the autograd-level host helper in
// `src/autograd/function_attention.cpp`. Backward replay (whether on the
// Vulkan side or via the autograd helper) reconstructs the same mask.
//
// Output dtype: Float32 (binding 0). Float16/BFloat16 callers should
// dispatch this shader at Float32 and then cast the output via the
// existing Vulkan dispatchCast pipeline.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { float mask[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;      // total mask elements = product(shape)
    uint bh_dim;          // 0 if not attention-shaped; else batch_heads
    uint sq_dim;          // 0 if not attention-shaped; else seq_q
    uint sk_dim;          // 0 if not attention-shaped; else seq_kv
    uint seed_low;        // Philox key, low 32 bits of seed
    uint offset_low;      // Philox counter offset, low 32 bits
    float p;              // dropout probability ∈ [0, 1)
    float keep_scale;     // pre-computed 1 / (1 - p)
} params;

// One Philox4x32 round (matches `src/backends/oneapi/kernels/philox_dropout.cpp`
// `philox_round_device` exactly).
void philox_round(inout uvec4 ctr, uvec2 key) {
    const uint M0 = 0xD2511F53u;
    const uint M1 = 0xCD9E8D57u;
    uint hi0, lo0, hi1, lo1;
    // umulExtended(a, b, hi, lo): hi:lo = a * b as a 64-bit product.
    umulExtended(ctr.x, M0, hi0, lo0);
    umulExtended(ctr.z, M1, hi1, lo1);
    uint new0 = hi1 ^ ctr.y ^ key.x;
    uint new1 = lo1;
    uint new2 = hi0 ^ ctr.w ^ key.y;
    uint new3 = lo0;
    ctr = uvec4(new0, new1, new2, new3);
}

float philox_uniform(uint c0, uint c1, uint c2, uint c3, uint seed_low) {
    const uint W0 = 0x9E3779B9u;
    const uint W1 = 0xBB67AE85u;
    const uint KEY_XOR = 0x1BD11BDAu;
    uvec4 ctr = uvec4(c0, c1, c2, c3);
    uvec2 key = uvec2(seed_low, seed_low ^ KEY_XOR);
    for (int r = 0; r < 10; ++r) {
        philox_round(ctr, key);
        if (r < 9) {
            key.x += W0;
            key.y += W1;
        }
    }
    // 24-bit mantissa: shift right by 8 and divide by 2^24.
    return float(ctr.x >> 8u) * (1.0 / 16777216.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint c0, c1, c2;
    if (params.bh_dim > 0u && params.sq_dim > 0u && params.sk_dim > 0u &&
        params.bh_dim * params.sq_dim * params.sk_dim == params.n_elements) {
        // Attention-shape addressing: decode idx → (bh, qi, ki).
        uint ki = idx % params.sk_dim;
        uint rest = idx / params.sk_dim;
        uint qi = rest % params.sq_dim;
        uint bh = rest / params.sq_dim;
        c0 = bh; c1 = qi; c2 = ki;
    } else {
        c0 = idx; c1 = 0u; c2 = 0u;
    }
    float u = philox_uniform(c0, c1, c2, params.offset_low, params.seed_low);
    mask[idx] = (u >= params.p) ? params.keep_scale : 0.0;
}
