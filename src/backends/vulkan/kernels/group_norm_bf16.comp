#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Group Normalization for BFloat16
// Input/output are packed BF16 (2 elements per 32-bit word)
// Gamma/beta/mean/inv_std are Float32 (channel-level statistics)
// Computation done in float32 for numerical stability
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { uint input_data[]; };       // Packed BF16
layout(binding = 1) buffer Output { uint output_data[]; };     // Packed BF16
layout(binding = 2) buffer Gamma { float gamma_data[]; };      // Float32
layout(binding = 3) buffer Beta { float beta_data[]; };        // Float32
layout(binding = 4) buffer MeanOut { float mean_out[]; };      // Float32
layout(binding = 5) buffer InvStdOut { float inv_std_out[]; }; // Float32

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_channels;
    uint height;
    uint width;
    uint num_groups;
    float epsilon;
    uint affine;
} params;

shared float shared_sum[WORKGROUP_SIZE];
shared float shared_sum_sq[WORKGROUP_SIZE];

// Read a single BF16 element from packed buffer as float32
float readBF16(uint flat_idx) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = input_data[word_idx];
    return (half_idx == 0) ? unpackBF16x2(packed).x : unpackBF16x2(packed >> 16).x;
}

// Write a single BF16 element to packed buffer (read-modify-write)
void writeBF16(uint flat_idx, float val) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = output_data[word_idx];
    uint bits = ((floatBitsToUint(val) + 0x7FFFu + ((floatBitsToUint(val) >> 16) & 1u)) >> 16);
    if (half_idx == 0) {
        packed = (packed & 0xFFFF0000u) | bits;
    } else {
        packed = (packed & 0x0000FFFFu) | (bits << 16);
    }
    output_data[word_idx] = packed;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x / params.num_groups;
    uint group_idx = gl_WorkGroupID.x % params.num_groups;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint channels_per_group = params.num_channels / params.num_groups;
    uint spatial_size = params.height * params.width;
    uint group_size = channels_per_group * spatial_size;

    uint group_start = batch_idx * params.num_channels * spatial_size +
                       group_idx * channels_per_group * spatial_size;

    // Step 1: Compute mean
    float local_sum = 0.0;
    for (uint i = tid; i < group_size; i += WORKGROUP_SIZE) {
        local_sum += readBF16(group_start + i);
    }
    shared_sum[tid] = local_sum;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    float mean = shared_sum[0] / float(group_size);
    barrier();

    // Step 2: Compute variance
    float local_sum_sq = 0.0;
    for (uint i = tid; i < group_size; i += WORKGROUP_SIZE) {
        float diff = readBF16(group_start + i) - mean;
        local_sum_sq += diff * diff;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    float variance = shared_sum_sq[0] / float(group_size);
    float inv_std = 1.0 / sqrt(variance + params.epsilon);
    barrier();

    // Write mean and inv_std
    if (tid == 0) {
        uint stats_idx = batch_idx * params.num_groups + group_idx;
        mean_out[stats_idx] = mean;
        inv_std_out[stats_idx] = inv_std;
    }

    // Step 3: Normalize and apply affine — process pairs for safe packed writes
    uint num_words = (group_size + 1) / 2;
    for (uint w = tid; w < num_words; w += WORKGROUP_SIZE) {
        uint elem0 = w * 2;
        uint elem1 = w * 2 + 1;

        float r0 = 0.0, r1 = 0.0;

        if (elem0 < group_size) {
            float normalized = (readBF16(group_start + elem0) - mean) * inv_std;
            if (params.affine > 0) {
                uint local_channel = (elem0 / spatial_size);
                uint global_channel = group_idx * channels_per_group + local_channel;
                normalized = normalized * gamma_data[global_channel] + beta_data[global_channel];
            }
            r0 = normalized;
        }

        if (elem1 < group_size) {
            float normalized = (readBF16(group_start + elem1) - mean) * inv_std;
            if (params.affine > 0) {
                uint local_channel = (elem1 / spatial_size);
                uint global_channel = group_idx * channels_per_group + local_channel;
                normalized = normalized * gamma_data[global_channel] + beta_data[global_channel];
            }
            r1 = normalized;
        }

        uint out_word_idx = (group_start + elem0) / 2;
        uint bits0 = ((floatBitsToUint(r0) + 0x7FFFu + ((floatBitsToUint(r0) >> 16) & 1u)) >> 16);
        uint bits1 = ((floatBitsToUint(r1) + 0x7FFFu + ((floatBitsToUint(r1) >> 16) & 1u)) >> 16);
        output_data[out_word_idx] = bits0 | (bits1 << 16);
    }
}
