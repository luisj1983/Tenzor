#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Broadcasting-aware binary operations for Vulkan with Float64 support
// Supports NumPy-style broadcasting rules
layout(local_size_x_id = 0) in;

// For Float64, we use double buffers directly
layout(binding = 0) buffer InputA { double a[]; };
layout(binding = 1) buffer InputB { double b[]; };
layout(binding = 2) buffer Output { double result[]; };

layout(push_constant) uniform PushConstants {
    uint output_size;      // Total number of output elements
    uint op;               // Operation: 0=add, 1=sub, 2=mul, 3=div
    uint dtype;            // Data type: always 1 for Float64 in this shader
    uint ndim_a;           // Number of dimensions in tensor A
    uint ndim_b;           // Number of dimensions in tensor B
    uint ndim_out;         // Number of dimensions in output
    // Strides for tensor A (up to 8 dimensions)
    uint strides_a[8];
    // Strides for tensor B (up to 8 dimensions)
    uint strides_b[8];
    // Output shape (up to 8 dimensions)
    uint shape_out[8];
} params;

// --------------------------------------------------------------------------
// True-double helpers (ported verbatim from math_f64.comp) so the broadcast
// path produces FULL Float64 precision for atan2/float_power/xlog1py/ldexp,
// identical to the non-broadcast Float64 shader. The previous code downcast
// these to float() (~7 digits), diverging from same-shape Float64 results.
// --------------------------------------------------------------------------
double exp_double(double x) {
    if (x != x) return x;
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;
    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0 +
        r * (1.0/6227020800.0)))))))))))));
    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) { pow2 *= base; }
        base *= base;
        abs_k >>= 1;
    }
    return (k >= 0) ? (exp_r * pow2) : (exp_r / pow2);
}

double log_double(double x) {
    if (x != x) return x;
    if (x < 0.0LF) return 0.0LF / 0.0LF;   // NaN
    if (x == 0.0LF) return -1.0LF / 0.0LF; // -inf
    if (x > 1.7976931348623157e308LF) return x;
    if (x == 1.0LF) return 0.0LF;
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;
    int biased_exp = int((hi >> 20u) & 0x7FFu);
    int exp_val = biased_exp - 1023;
    uint hi_normalized = (hi & 0x000FFFFFu) | 0x3FF00000u;
    double m = packDouble2x32(uvec2(lo, hi_normalized));
    if (m > 1.4142135623730950488LF) { m *= 0.5LF; exp_val += 1; }
    double f = m - 1.0LF;
    double s = f / (2.0LF + f);
    double s2 = s * s;
    double c1 = 0.6666666666666735130LF;
    double c2 = 0.3999999999940941908LF;
    double c3 = 0.2857142874366239149LF;
    double c4 = 0.2222219843214978396LF;
    double c5 = 0.1818357216161805012LF;
    double c6 = 0.1531383769920937332LF;
    double c7 = 0.1479819860511658591LF;
    double s4 = s2 * s2;
    double t1 = c1 + c2 * s2 + c3 * s4;
    double s6 = s4 * s2;
    double t2 = c4 + c5 * s2 + c6 * s4 + c7 * s6;
    double R = t1 + t2 * s6;
    double log_m = 2.0LF * s + s * s2 * R;
    double ln2_hi = 0.69314718055994530942LF;
    double ln2_lo = 2.3190468138462995584e-17LF;
    double exp_dbl = double(exp_val);
    return exp_dbl * ln2_hi + (log_m + exp_dbl * ln2_lo);
}

double atan_double(double x) {
    if (x != x) return x;
    const double PI = 3.141592653589793;
    double sign = 1.0;
    double ax = x;
    if (ax < 0.0) { sign = -1.0; ax = -ax; }
    bool inv = (ax > 1.0);
    if (inv) ax = 1.0 / ax;
    double add = 0.0;
    const double TAN_PI_8 = 0.41421356237309503;
    if (ax > TAN_PI_8) { add = PI * 0.25; ax = (ax - 1.0) / (ax + 1.0); }
    double x2 = ax * ax;
    double p = (1.0/15.0) - x2 * ((1.0/17.0) - x2 * ((1.0/19.0) - x2 * ((1.0/21.0) - x2 * (1.0/23.0))));
    p = (1.0/5.0) - x2 * ((1.0/7.0) - x2 * ((1.0/9.0) - x2 * ((1.0/11.0) - x2 * ((1.0/13.0) - x2 * p))));
    double r = ax - ax * x2 * (1.0/3.0 - x2 * p);
    double result = add + r;
    if (inv) result = PI * 0.5 - result;
    return sign * result;
}

double atan2_double(double y, double x) {
    const double PI = 3.141592653589793;
    if (x > 0.0) return atan_double(y / x);
    if (x < 0.0) {
        if (y >= 0.0) return atan_double(y / x) + PI;
        return atan_double(y / x) - PI;
    }
    if (y > 0.0) return PI * 0.5;
    if (y < 0.0) return -PI * 0.5;
    return 0.0;
}

// Exact double-precision 2^n for n an integer-valued double (ldexp scaling).
// Powers of two are exactly representable in binary64, and squaring 2.0
// stays exact, so binary exponentiation yields a bit-exact result with no
// Taylor/clamp error (unlike exp_double(n*ln2)). Mirrors math_f64.comp's
// exp2_int_double so the broadcast ldexp path matches std::ldexp / same-shape
// Float64 results. Handles the full normal exponent range and saturates to
// ±inf / 0 like std::ldexp for out-of-range n.
double exp2_int_double(double n_dbl) {
    if (n_dbl != n_dbl) return n_dbl;  // NaN
    // Round toward nearest integer; ldexp's n is integral by contract, but
    // tolerate float representations like 3.0 exactly.
    double rn = round(n_dbl);
    // Saturate: 2^1024 overflows to +inf, 2^-1075 underflows to 0.
    if (rn > 1023.0) return 1.0 / 0.0;     // +inf
    if (rn < -1074.0) return 0.0;          // below smallest subnormal → 0
    int k = int(rn);
    if (k >= 0) {
        int abs_k = k;
        double pow2 = 1.0;
        double base = 2.0;
        while (abs_k > 0) {
            if ((abs_k & 1) != 0) pow2 *= base;
            base *= base;
            abs_k >>= 1;
        }
        return pow2;
    }
    // k < 0: build 2^k = (2^k1) * (2^k2) with each |ki| <= 537 so neither
    // intermediate overflows; the product underflows gracefully to
    // subnormals/zero exactly as a hardware multiply would.
    int neg = -k;            // neg in (0, 1074]
    int neg1 = neg / 2;
    int neg2 = neg - neg1;   // neg1 + neg2 == neg, both <= 537
    double s1 = 1.0;
    double s2 = 1.0;
    {
        int e = neg1; double base = 0.5;       // 0.5 = 2^-1
        while (e > 0) { if ((e & 1) != 0) s1 *= base; base *= base; e >>= 1; }
    }
    {
        int e = neg2; double base = 0.5;
        while (e > 0) { if ((e & 1) != 0) s2 *= base; base *= base; e >>= 1; }
    }
    return s1 * s2;
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.output_size) {
        return;
    }

    // Convert flat output index to multi-dimensional coordinates
    // Then use broadcasting strides to compute input indices
    uint idx_a = 0;
    uint idx_b = 0;
    uint tmp = out_idx;

    // Iterate from last dimension to first (row-major order)
    for (uint i = 0; i < params.ndim_out; i++) {
        uint dim_idx = params.ndim_out - 1 - i;
        uint coord = tmp % params.shape_out[dim_idx];
        tmp /= params.shape_out[dim_idx];

        // Add contribution to input indices using broadcasting strides
        // Broadcasting strides are 0 for broadcasted dimensions
        idx_a += coord * params.strides_a[dim_idx];
        idx_b += coord * params.strides_b[dim_idx];
    }

    // Float64 operations
    double val_a = a[idx_a];
    double val_b = b[idx_b];
    double res = 0.0;

    switch (params.op) {
        case 0: // add
            res = val_a + val_b;
            break;
        case 1: // sub
            res = val_a - val_b;
            break;
        case 2: // mul
            res = val_a * val_b;
            break;
        case 3: // div
            res = val_a / val_b;
            break;
        case 23: // atan2 (binary) - full double precision
            res = atan2_double(val_a, val_b);
            break;
        case 24: // fmod (binary) - truncated remainder
            res = val_a - trunc(val_a / val_b) * val_b;
            break;
        case 25: { // remainder (binary) - IEEE remainder
            double quot = val_a / val_b;
            double rounded = round(quot);
            res = val_a - rounded * val_b;
            break;
        }
        case 26: // minimum (binary)
            res = min(val_a, val_b);
            break;
        case 27: // maximum (binary)
            res = max(val_a, val_b);
            break;
        case 33: // hypot (binary)
            res = sqrt(val_a * val_a + val_b * val_b);
            break;
        case 34: { // copysign (binary)
            double mag = abs(val_a);
            res = (val_b < 0.0 || (val_b == 0.0 && sign(val_b) < 0.0)) ? -mag : mag;
            break;
        }
        case 42: // fmax (binary) - NaN-propagating max: fmax(NaN, x) = x
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = max(val_a, val_b);
            break;
        case 43: // fmin (binary) - NaN-propagating min: fmin(NaN, x) = x
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = min(val_a, val_b);
            break;
        case 47: // float_power (binary): pow(a, b) in double (matches math_f64)
            res = exp_double(val_b * log_double(val_a));
            break;
        case 48: // xlog1py (binary): x == 0 ? 0 : x * log(1+y) in double
            if (val_a == 0.0) res = 0.0;
            else res = val_a * log_double(1.0 + val_b);
            break;
        case 49: // ldexp (binary): x * 2^n in double — exact power-of-two scaling
            res = val_a * exp2_int_double(val_b);
            break;
        default:
            res = 0.0;
            break;
    }
    result[out_idx] = res;
}
