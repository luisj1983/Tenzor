#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// MaskedScatter — scatter source values into positions where mask is true.
// Step 1 (external): Compute prefix sum of mask to get scatter indices.
// Step 2 (this shader): For each position where mask[i] is true,
//         output[i] = source[prefix_sum[i] - 1], else output[i] = input[i].
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input     { float input_data[]; };
layout(binding = 1) readonly buffer Mask      { uint8_t mask_data[]; };
layout(binding = 2) readonly buffer Source    { float source_data[]; };
layout(binding = 3) readonly buffer PrefixSum { uint  prefix_data[]; };
layout(binding = 4) writeonly buffer Output   { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
    uint source_len;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;

    if (mask_data[idx] != uint8_t(0)) {
        uint prefix = prefix_data[idx];
        // Bounds-check the scatter index against the source length: prefix must
        // be >= 1 (mask set) and prefix-1 within source. A corrupt/short source
        // or zero prefix would otherwise read source_data[0xFFFFFFFF] (OOB).
        if (prefix >= 1u && (prefix - 1u) < params.source_len) {
            output_data[idx] = source_data[prefix - 1u];
        } else {
            output_data[idx] = input_data[idx];
        }
    } else {
        output_data[idx] = input_data[idx];
    }
}
