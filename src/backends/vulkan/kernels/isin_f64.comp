#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Isin — set membership test, native Float64 variant.
// Compares double values directly instead of downcasting through Float32,
// which loses precision above 2^24 (false-positive membership for distinct
// Float64 values that collide once truncated). Mirrors the CPU isin_kernel
// fix (advanced.cpp) that widens every floating dtype to Float64 for exact
// comparison; Float16/BFloat16/Float32 all widen losslessly.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Elements     { float64_t elements_data[]; };
layout(binding = 1) readonly buffer TestElements { float64_t test_data[]; };
layout(binding = 2) writeonly buffer Output      { uint8_t   output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;      // number of elements to test
    uint num_test_elements; // size of the test set
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;

    float64_t val = elements_data[idx];
    uint8_t found = uint8_t(0);

    for (uint i = 0; i < params.num_test_elements; i++) {
        if (val == test_data[i]) {
            found = uint8_t(1);
            break;
        }
    }

    output_data[idx] = found;
}
