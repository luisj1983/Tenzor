#version 450

// Fused Adam-Atan2 optimizer step for BFloat16 parameters
// Grad/param buffers are packed BF16; state buffers (exp_avg, exp_avg_sq, max) are Float32
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { uint grad_data[]; };                 // Packed BF16
layout(binding = 1) buffer Param { uint param_data[]; };               // Packed BF16
layout(binding = 2) buffer ExpAvg { float exp_avg[]; };                // Float32
layout(binding = 3) buffer ExpAvgSq { float exp_avg_sq[]; };           // Float32
layout(binding = 4) buffer MaxExpAvgSq { float max_exp_avg_sq[]; };    // Float32

layout(push_constant) uniform PushConstants {
    uint numel;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
    float bias_correction1;
    float bias_correction2_sqrt;
    uint decoupled;
    uint amsgrad;
    uint padding0;
    uint padding1;
} params;

// Helper to read bfloat16 from packed buffer
float readBF16(uint packed, uint offset) {
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

float adamAtan2Step(uint idx) {
    float g = readBF16(idx, 0);
    float p = readBF16(idx, 1);

    if (params.weight_decay > 0.0) {
        if (params.decoupled != 0) {
            p -= params.lr * params.weight_decay * p;
        } else {
            g += params.weight_decay * p;
        }
    }

    float m = params.beta1 * exp_avg[idx] + (1.0 - params.beta1) * g;
    exp_avg[idx] = m;

    float v = params.beta2 * exp_avg_sq[idx] + (1.0 - params.beta2) * g * g;
    exp_avg_sq[idx] = v;

    float denom_v = v;
    if (params.amsgrad != 0) {
        float max_v = max(max_exp_avg_sq[idx], v);
        max_exp_avg_sq[idx] = max_v;
        denom_v = max_v;
    }

    float m_hat = m / params.bias_correction1;
    float v_hat = denom_v / (params.bias_correction2_sqrt * params.bias_correction2_sqrt);

    // Atan2 update
    float update = atan(m_hat, sqrt(v_hat) + params.eps);
    p -= params.lr * update;
    return p;
}

void main() {
    uint word_idx = gl_GlobalInvocationID.x;
    uint num_words = (params.numel + 1) / 2;
    if (word_idx >= num_words) return;

    uint elem0 = word_idx * 2;
    uint elem1 = word_idx * 2 + 1;

    float p0 = 0.0, p1 = 0.0;

    if (elem0 < params.numel) {
        p0 = adamAtan2Step(elem0);
    }

    if (elem1 < params.numel) {
        p1 = adamAtan2Step(elem1);
    }

    uint bits0 = ((floatBitsToUint(p0) + 0x7FFFu + ((floatBitsToUint(p0) >> 16) & 1u)) >> 16);
    uint bits1 = ((floatBitsToUint(p1) + 0x7FFFu + ((floatBitsToUint(p1) >> 16) & 1u)) >> 16);
    param_data[word_idx] = bits0 | (bits1 << 16);
}
