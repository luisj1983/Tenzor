#version 450

// LogSigmoid: log(sigmoid(x)) = -softplus(-x)
// Numerically stable: x>=0: -log(1+exp(-x)), x<0: x - log(1+exp(x))
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer { float data[]; } input_buf;
layout(set = 0, binding = 1) writeonly buffer OutputBuffer { float data[]; } output_buf;

layout(push_constant) uniform PushConstants { uint num_elements; } pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    float x = input_buf.data[idx];
    if (x >= 0.0) {
        output_buf.data[idx] = -log(1.0 + exp(-x));
    } else {
        output_buf.data[idx] = x - log(1.0 + exp(x));
    }
}
