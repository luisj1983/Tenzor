#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Where (Float64) — output[i] = cond[i] ? x[i] : y[i]
// Condition stored as uint8_t (0 = false, non-zero = true).
// All three inputs must have identical shape and be contiguous.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Condition { uint8_t cond_data[]; };
layout(binding = 1) readonly buffer X         { double   x_data[]; };
layout(binding = 2) readonly buffer Y         { double   y_data[]; };
layout(binding = 3) writeonly buffer Output   { double   out_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;
    out_data[idx] = (cond_data[idx] != uint8_t(0)) ? x_data[idx] : y_data[idx];
}
