#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Group Normalization for Float16
// Input/output are packed F16 (2 elements per 32-bit word)
// Gamma/beta/mean/inv_std are Float32 (channel-level statistics)
// Computation done in float32 for numerical stability
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { uint input_data[]; };       // Packed F16
layout(binding = 1) buffer Output { uint output_data[]; };     // Packed F16
layout(binding = 2) buffer Gamma { float gamma_data[]; };      // Float32
layout(binding = 3) buffer Beta { float beta_data[]; };        // Float32
layout(binding = 4) buffer MeanOut { float mean_out[]; };      // Float32
layout(binding = 5) buffer InvStdOut { float inv_std_out[]; }; // Float32

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_channels;
    uint height;
    uint width;
    uint num_groups;
    float epsilon;
    uint affine;
} params;

shared float shared_sum[WORKGROUP_SIZE];
shared float shared_sum_sq[WORKGROUP_SIZE];

// Read a single F16 element from packed buffer as float32
float readF16(uint flat_idx) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = input_data[word_idx];
    return (half_idx == 0) ? unpackHalf2x16(packed).x : unpackHalf2x16(packed >> 16).x;
}

// Write a single F16 element to packed buffer (atomic CAS).
// A boundary word can be shared by two adjacent groups dispatched on
// different workgroups, so a plain read-modify-write would race and
// clobber the neighbouring group's half-word. atomicCompSwap makes the
// half-word update safe regardless of group_start parity.
void writeF16(uint flat_idx, float val) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = output_data[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(output_data[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring group's packed half-word at a shared boundary word.
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x / params.num_groups;
    uint group_idx = gl_WorkGroupID.x % params.num_groups;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint channels_per_group = params.num_channels / params.num_groups;
    uint spatial_size = params.height * params.width;
    uint group_size = channels_per_group * spatial_size;

    uint group_start = batch_idx * params.num_channels * spatial_size +
                       group_idx * channels_per_group * spatial_size;

    // Step 1: Compute mean
    float local_sum = 0.0;
    for (uint i = tid; i < group_size; i += WORKGROUP_SIZE) {
        local_sum += readF16(group_start + i);
    }
    shared_sum[tid] = local_sum;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    float mean = shared_sum[0] / float(group_size);
    barrier();

    // Step 2: Compute variance
    float local_sum_sq = 0.0;
    for (uint i = tid; i < group_size; i += WORKGROUP_SIZE) {
        float diff = readF16(group_start + i) - mean;
        local_sum_sq += diff * diff;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    float variance = shared_sum_sq[0] / float(group_size);
    float inv_std = 1.0 / sqrt(variance + params.epsilon);
    barrier();

    // Write mean and inv_std
    if (tid == 0) {
        uint stats_idx = batch_idx * params.num_groups + group_idx;
        mean_out[stats_idx] = mean;
        inv_std_out[stats_idx] = inv_std;
    }

    // Step 3: Normalize and apply affine.
    // Each invocation handles one element and stores it via the atomic
    // writeF16 helper. This is correct for any group_start parity: the
    // half-word at the actual flat index (group_start + i) is updated
    // without disturbing the other half of the word, which may belong to
    // an adjacent group processed by a different workgroup.
    for (uint i = tid; i < group_size; i += WORKGROUP_SIZE) {
        float normalized = (readF16(group_start + i) - mean) * inv_std;
        if (params.affine > 0) {
            uint local_channel = (i / spatial_size);
            uint global_channel = group_idx * channels_per_group + local_channel;
            normalized = normalized * gamma_data[global_channel] + beta_data[global_channel];
        }
        writeF16(group_start + i, normalized);
    }
}
