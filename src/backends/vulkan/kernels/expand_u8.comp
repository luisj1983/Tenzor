#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Expand operation for 1-byte types (Bool / Int8 / UInt8).
// Supports multi-dimensional broadcasting following NumPy rules.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input { uint8_t input_data[]; };
layout(binding = 1) writeonly buffer Output { uint8_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint input_ndim;
    uint output_ndim;
    uint input_shape[8];
    uint output_shape[8];
    uint input_strides[8];
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Reject rank >8: push-constant shape/stride arrays hold at most 8 dims;
    // a higher rank would read the uninitialized tail and index OOB. The host
    // (dispatchExpand) also rejects this.
    if (params.output_ndim > 8u || params.input_ndim > 8u) return;

    uint out_indices[8];
    uint temp = idx;
    for (int i = int(params.output_ndim) - 1; i >= 0; i--) {
        out_indices[i] = temp % params.output_shape[i];
        temp /= params.output_shape[i];
    }

    uint input_idx = 0;
    for (uint i = 0; i < params.input_ndim; i++) {
        uint out_dim_idx = params.output_ndim - params.input_ndim + i;
        uint in_idx = (params.input_shape[i] == 1) ? 0 : out_indices[out_dim_idx];
        input_idx += in_idx * params.input_strides[i];
    }

    output_data[idx] = input_data[input_idx];
}
