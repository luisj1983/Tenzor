#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Linear backward pass (BFloat16 version)
// Computes: grad_input = grad_output @ weight
// grad_output: (M, N), weight: (N, K) -> grad_input: (M, K)
// Uses tiled matrix multiplication with float32 accumulation
// BFloat16 elements packed 2 per uint32 word

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };  // Packed BF16
layout(binding = 1) buffer Weight { uint weight_data[]; };      // Packed BF16
layout(binding = 2) buffer GradInput { uint grad_input[]; };    // Packed BF16

layout(push_constant) uniform PushConstants {
    uint M;  // batch size
    uint N;  // output features
    uint K;  // input features
} params;

shared float tileA[16][16];
shared float tileB[16][16];

float readBF16GradOut(uint element_idx) {
    uint word_idx = element_idx >> 1u;
    uint packed = grad_output[word_idx];
    vec2 pair = unpackBF16x2(packed);
    return ((element_idx & 1u) == 0u) ? pair.x : pair.y;
}

float readBF16Weight(uint element_idx) {
    uint word_idx = element_idx >> 1u;
    uint packed = weight_data[word_idx];
    vec2 pair = unpackBF16x2(packed);
    return ((element_idx & 1u) == 0u) ? pair.x : pair.y;
}

void writeBF16(uint element_idx, float value) {
    uint word_idx = element_idx >> 1u;
    uint word_offset = element_idx & 1u;
    uint new_bits = ((floatBitsToUint(value) + 0x7FFFu + ((floatBitsToUint(value) >> 16) & 1u)) >> 16);
    uint shift = word_offset * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = grad_input[word_idx];
    for (uint iter = 0u; iter < 65536u; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // KK.9: removed non-atomic plain-store fallback; cap raised from 64 to 65536.
}

void main() {
    uint row = gl_GlobalInvocationID.y;  // batch index
    uint col = gl_GlobalInvocationID.x;  // input feature index
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    float sum = 0.0;

    uint num_tiles = (params.N + 15u) / 16u;

    for (uint t = 0u; t < num_tiles; t++) {
        // Load tile from grad_output (M, N)
        uint a_col = t * 16u + local_col;
        if (row < params.M && a_col < params.N) {
            tileA[local_row][local_col] = readBF16GradOut(row * params.N + a_col);
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from weight (N, K)
        uint b_row = t * 16u + local_row;
        if (b_row < params.N && col < params.K) {
            tileB[local_row][local_col] = readBF16Weight(b_row * params.K + col);
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    if (row < params.M && col < params.K) {
        writeBF16(row * params.K + col, sum);
    }
}
