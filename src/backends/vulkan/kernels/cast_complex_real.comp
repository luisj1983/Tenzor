#version 450

// Cast complex64 (interleaved float32 pairs) to real (float32).
// Extracts the real part of each complex element.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input  { float input_data[]; };
layout(binding = 1) writeonly buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;  // number of complex elements
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;

    output_data[idx] = input_data[idx * 2];  // extract real part
}
