#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// RMS Normalization (Float64)
// One workgroup per batch element
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Output { double output_data[]; };
layout(binding = 2) buffer Weight { double weight_data[]; };
layout(binding = 3) buffer RrmsOut { double rrms_out[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint normalized_shape;
    float epsilon;
    uint padding;
} params;

shared double shared_sum_sq[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.normalized_shape;

    // Step 1: Compute sum of squares
    double local_sum_sq = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += WORKGROUP_SIZE) {
        double val = input_data[base_idx + i];
        local_sum_sq += val * val;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    // Parallel reduction for sum of squares
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    double rms = sqrt(shared_sum_sq[0] / double(params.normalized_shape) + double(params.epsilon));
    double rrms = 1.0 / rms;
    barrier();

    // Store rrms for backward pass
    if (tid == 0) {
        rrms_out[batch_idx] = rrms;
    }

    // Step 2: Normalize and apply weight
    for (uint i = tid; i < params.normalized_shape; i += WORKGROUP_SIZE) {
        output_data[base_idx + i] = input_data[base_idx + i] * rrms * weight_data[i];
    }
}
