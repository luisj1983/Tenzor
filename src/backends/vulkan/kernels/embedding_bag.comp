#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// EmbeddingBag: look up multiple embedding rows and reduce (sum/mean/max).
// Input embeddings are pre-indexed (already selected rows stacked contiguously).
// Offsets define bag boundaries: bag[i] spans [offsets[i], offsets[i+1]).
// One workgroup per (bag, embedding_dim_chunk) — each thread handles one output element.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Embeddings { float emb_data[]; };   // (total_rows, embedding_dim)
layout(binding = 1) buffer Offsets { int offset_data[]; };       // (num_bags) or (num_bags+1) if include_last
layout(binding = 2) buffer Output { float out_data[]; };         // (num_bags, embedding_dim)
layout(binding = 3) buffer MaxIndices { int64_t idx_data[]; };    // (num_bags, embedding_dim) argmax element idx (max mode)

layout(push_constant) uniform PushConstants {
    uint num_bags;
    uint embedding_dim;
    uint total_rows;       // Total number of embedding rows in input
    uint mode;             // 0=sum, 1=mean, 2=max
    uint include_last_offset;  // 0=no, 1=yes (last offset is sentinel)
    uint num_offsets;      // Length of offsets array
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total_output = params.num_bags * params.embedding_dim;
    if (gid >= total_output) return;

    uint bag = gid / params.embedding_dim;
    uint j = gid % params.embedding_dim;

    // Determine bag range [start, end)
    int start = offset_data[bag];
    int end_val;
    if (bag + 1 < params.num_offsets) {
        end_val = offset_data[bag + 1];
    } else {
        end_val = int(params.total_rows);
    }

    int bag_size = end_val - start;
    if (bag_size <= 0) {
        out_data[gid] = 0.0;
        idx_data[gid] = int64_t(-1);
        return;
    }

    if (params.mode == 2) {
        // Max mode — also record the global argmax element index (strict '>': first wins).
        float max_val = emb_data[uint(start) * params.embedding_dim + j];
        int arg = start;
        for (int i = start + 1; i < end_val; ++i) {
            float v = emb_data[uint(i) * params.embedding_dim + j];
            if (v > max_val) { max_val = v; arg = i; }
        }
        out_data[gid] = max_val;
        idx_data[gid] = int64_t(arg);
    } else {
        // Sum or Mean mode
        float acc = 0.0;
        for (int i = start; i < end_val; ++i) {
            acc += emb_data[uint(i) * params.embedding_dim + j];
        }
        if (params.mode == 1) {
            acc /= float(bag_size);
        }
        out_data[gid] = acc;
    }
}
