#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Transpose operation for Float16: swap two dimensions
// Float16 elements are packed 2 per 32-bit word
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };
layout(binding = 2) buffer InputShape { int shape[]; };
layout(binding = 3) buffer InputStrides { int strides[]; };
layout(binding = 4) buffer OutputStrides { int out_strides[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint ndim;
    uint dim0;
    uint dim1;
} params;

// Read a single float16 value from packed input buffer
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write a single float16 value to packed output buffer
void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    if (word_offset == 0) {
        uint existing = output_data[word_idx] & 0xFFFF0000u;
        output_data[word_idx] = existing | bits;
    } else {
        uint existing = output_data[word_idx] & 0x0000FFFFu;
        output_data[word_idx] = existing | (bits << 16);
    }
}

// Convert linear index to multi-dimensional indices
void index_to_coords(uint linear_idx, uint ndims, out int coords[8]) {
    uint remaining = linear_idx;
    for (int i = int(ndims) - 1; i >= 0; i--) {
        coords[i] = int(remaining % uint(shape[i]));
        remaining /= uint(shape[i]);
    }
}

// Convert multi-dimensional indices to linear index using strides
uint coords_to_index(int coords[8], uint ndims, int stride_array[8]) {
    uint idx = 0;
    for (uint i = 0; i < ndims; i++) {
        idx += uint(coords[i] * stride_array[i]);
    }
    return idx;
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.n) {
        return;
    }

    // Get output coordinates
    int out_coords[8];
    index_to_coords(out_idx, params.ndim, out_coords);

    // Swap dimensions to get input coordinates
    int in_coords[8];
    for (uint i = 0; i < params.ndim; i++) {
        in_coords[i] = out_coords[i];
    }
    int temp = in_coords[params.dim0];
    in_coords[params.dim0] = in_coords[params.dim1];
    in_coords[params.dim1] = temp;

    // Convert input coordinates to linear index
    int in_strides[8];
    for (uint i = 0; i < params.ndim; i++) {
        in_strides[i] = strides[i];
    }
    uint in_idx = coords_to_index(in_coords, params.ndim, in_strides);

    // Copy data
    writeF16(out_idx, readF16(in_idx));
}
