#version 450

// Exclusive prefix sum (scan) for masked_select.
// Blelloch-style parallel scan, generic over workgroup size (power-of-two,
// controlled by spec constant 0). Previously hardcoded to 256 which silently
// produced wrong results on devices that picked a larger workgroup (e.g.
// RTX 5070 @ 1024), because threads 256..wg_size-1 wrote past the fixed-size
// shared buffer and the scan loops only visited the first 256 elements.
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Mask { uint mask_data[]; };
layout(binding = 1) buffer PrefixSums { uint prefix_sums[]; };
layout(binding = 2) buffer BlockSums { uint block_sums[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint mask_is_float;
    uint pass;
} params;

shared uint shared_data[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint bid = gl_WorkGroupID.x;

    if (params.pass == 0) {
        uint val = 0;
        if (gid < params.n_elements) {
            if (params.mask_is_float == 1) {
                float f = uintBitsToFloat(mask_data[gid]);
                val = (f != 0.0) ? 1 : 0;
            } else {
                uint byte_idx = gid / 4;
                uint bit_offset = (gid % 4) * 8;
                uint byte_val = (mask_data[byte_idx] >> bit_offset) & 0xFF;
                val = (byte_val != 0) ? 1 : 0;
            }
        }

        shared_data[tid] = val;
        barrier();

        uint offset = 1;
        // Up-sweep (reduce)
        for (uint d = WORKGROUP_SIZE >> 1; d > 0; d >>= 1) {
            barrier();
            if (tid < d) {
                uint ai = offset * (2 * tid + 1) - 1;
                uint bi = offset * (2 * tid + 2) - 1;
                if (bi < WORKGROUP_SIZE) {
                    shared_data[bi] += shared_data[ai];
                }
            }
            offset *= 2;
        }

        if (tid == 0) {
            block_sums[bid] = shared_data[WORKGROUP_SIZE - 1];
            shared_data[WORKGROUP_SIZE - 1] = 0;
        }
        barrier();

        // Down-sweep
        for (uint d = 1; d < WORKGROUP_SIZE; d *= 2) {
            offset >>= 1;
            barrier();
            if (tid < d) {
                uint ai = offset * (2 * tid + 1) - 1;
                uint bi = offset * (2 * tid + 2) - 1;
                if (bi < WORKGROUP_SIZE) {
                    uint t = shared_data[ai];
                    shared_data[ai] = shared_data[bi];
                    shared_data[bi] += t;
                }
            }
        }
        barrier();

        if (gid < params.n_elements) {
            prefix_sums[gid] = shared_data[tid];
        }
    } else {
        // Pass 1: Add block offsets
        if (bid == 0) return;

        uint block_offset = 0;
        for (uint i = 0; i < bid; i++) {
            block_offset += block_sums[i];
        }

        if (gid < params.n_elements) {
            prefix_sums[gid] += block_offset;
        }
    }
}
