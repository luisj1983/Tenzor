#version 450

// Trigonometric functions: sin, cos, tan, asin, acos, atan
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputBuffer { float input_data[]; };
layout(binding = 1) buffer OutputBuffer { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=sin, 1=cos, 2=tan, 3=asin, 4=acos, 5=atan
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    float val = input_data[idx];

    switch (params.op) {
        case 0: // sin
            output_data[idx] = sin(val);
            break;
        case 1: // cos
            output_data[idx] = cos(val);
            break;
        case 2: // tan
            output_data[idx] = tan(val);
            break;
        case 3: // asin
            output_data[idx] = asin(val);
            break;
        case 4: // acos
            output_data[idx] = acos(val);
            break;
        case 5: // atan
            output_data[idx] = atan(val);
            break;
        default:
            output_data[idx] = 0.0;
            break;
    }
}
