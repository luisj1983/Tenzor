#version 450

// Trigonometric functions: sin, cos, tan, asin, acos, atan
// sin/cos/tan use the same algorithm as the CPU's AVX2/AVX512 fast-math
// implementation to ensure parity between CPU and Vulkan backends.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputBuffer { float input_data[]; };
layout(binding = 1) buffer OutputBuffer { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=sin, 1=cos, 2=tan, 3=asin, 4=acos, 5=atan
} params;

// Algorithm matches the CPU fast-math sin: range-reduce to [-pi/2, pi/2]
// via k = round(x/pi), x' = x - k*pi, then apply a degree-11 Taylor
// polynomial centered at 0 and flip sign on odd k
// (sin(x + k*pi) = (-1)^k * sin(x')). Using the same reduction and
// coefficients keeps Vulkan and CPU outputs bitwise-identical.
//
// The earlier [-pi, pi] reduction with a degree-9 polynomial produced
// ~2e-3 error near +/-pi because the Taylor series diverges that far
// out; the tighter reduction + extra term bounds the worst case at
// ~6e-8 over the whole domain.
const float INV_PI    = 0.318309886183791;
const float PI        = 3.14159265358979;
const float PI_OVER_2 = 1.57079632679;

const float S3  = -0.16666666666;
const float S5  =  0.00833333333;
const float S7  = -0.00019841270;
const float S9  =  0.0000027557319;
const float S11 = -2.5052108e-8;

float fast_sin(float x) {
    // Range reduction to [-pi/2, pi/2].
    float kf = round(x * INV_PI);
    x = x - kf * PI;

    float x2 = x * x;
    float p = S11 * x2 + S9;
    p = p * x2 + S7;
    p = p * x2 + S5;
    p = p * x2 + S3;
    p = p * x2 + 1.0;
    float r = p * x;

    // Flip the sign where k is odd.
    int ki = int(kf);
    if ((ki & 1) != 0) r = -r;
    return r;
}

float fast_cos(float x) {
    // cos(x) = sin(x + pi/2), matching CPU cos_avx2()
    return fast_sin(x + PI_OVER_2);
}

// Tan uses Cephes-style range reduction to (-pi/4, pi/4] and a direct
// polynomial for tan, rather than fast_sin(x)/fast_cos(x). The division form
// magnifies cos's error near pi/2 by ~1/cos(x)^2, which gave Vulkan tan an
// effective ~1e-5 error at |x|>=1.5 — enough to make the JVP finite-difference
// test for tan flake (CPU's std::tan stays within ~1 ULP). Direct tan keeps
// the relative error close to libm.
//
// Cephes reduction: j = floor(|x| * 4/pi); round j up to even; then
// xr = |x| - j * pi/4 lies in (-pi/4, pi/4]. After polynomial:
//   if (j & 2): tan(x) = -1 / tan_poly(xr)  (shift by pi/2)
//   else:        tan(x) = tan_poly(xr)
// Three-part pi/4 subtraction (Cody-Waite) preserves precision for large |x|;
// using only two parts left ~2e-8 error in the reduced argument, which
// magnifies ~200x through the 1/tan path near pi/2.
const float FOUR_OVER_PI  = 1.27323954473516;
const float PI_OVER_4_HI  = 0.78515625;             // exact in f32
const float PI_OVER_4_MID = 2.4187564849853515e-4;
const float PI_OVER_4_LO  = 3.77489497744594108e-8; // pi/4 = HI + MID + LO

// Cephes tanf polynomial, accurate to ~1 ULP over (-pi/4, pi/4].
float tan_poly(float x) {
    float x2 = x * x;
    float p = 9.38540185543e-3;
    p = p * x2 + 3.11992232697e-3;
    p = p * x2 + 2.44301354525e-2;
    p = p * x2 + 5.34112807005e-2;
    p = p * x2 + 1.33387994085e-1;
    p = p * x2 + 3.33331568548e-1;
    return x + x * x2 * p;
}

float fast_tan(float x) {
    float ax = abs(x);
    float yf = floor(ax * FOUR_OVER_PI);
    int j = int(yf);
    if ((j & 1) != 0) { j += 1; yf += 1.0; }
    float xr = ((ax - yf * PI_OVER_4_HI) - yf * PI_OVER_4_MID) - yf * PI_OVER_4_LO;

    float t = tan_poly(xr);
    if ((j & 2) != 0) t = -1.0 / t;
    return (x < 0.0) ? -t : t;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    float val = input_data[idx];

    switch (params.op) {
        case 0: // sin
            output_data[idx] = fast_sin(val);
            break;
        case 1: // cos
            output_data[idx] = fast_cos(val);
            break;
        case 2: // tan
            output_data[idx] = fast_tan(val);
            break;
        case 3: // asin
            output_data[idx] = asin(val);
            break;
        case 4: // acos
            output_data[idx] = acos(val);
            break;
        case 5: // atan
            output_data[idx] = atan(val);
            break;
        default:
            output_data[idx] = 0.0;
            break;
    }
}
