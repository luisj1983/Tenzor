#version 450

// 2D Transposed Convolution Forward Pass (with groups support)
// Uses gather approach: each output element gathers contributions from input positions
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Weight { float weight_data[]; };
layout(binding = 2) buffer Bias { float bias_data[]; };
layout(binding = 3) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;      // Total output elements
    uint batch;           // Batch size
    uint in_channels;     // Input channels
    uint out_channels;    // Output channels
    uint in_height;       // Input height
    uint in_width;        // Input width
    uint kernel_h;        // Kernel height
    uint kernel_w;        // Kernel width
    uint stride;          // Stride
    uint padding;         // Padding
    uint output_padding;  // Output padding
    uint dilation;        // Dilation
    uint groups;          // Groups (for grouped convolution)
    uint out_h;           // Output height
    uint out_w;           // Output width
    uint has_bias;        // 1 if bias present, 0 otherwise
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) {
        return;
    }

    // Decode index to (n, oc, oh, ow)
    uint ow = idx % params.out_w;
    uint temp = idx / params.out_w;
    uint oh = temp % params.out_h;
    temp /= params.out_h;
    uint oc = temp % params.out_channels;
    uint n = temp / params.out_channels;

    float sum = 0.0;

    // Compute channel relationships for grouped convolution
    // Weight shape: [in_channels, out_channels/groups, kernel_h, kernel_w]
    uint in_channels_per_group = params.in_channels / params.groups;
    uint out_channels_per_group = params.out_channels / params.groups;
    uint group_id = oc / out_channels_per_group;
    uint oc_local = oc % out_channels_per_group;  // Output channel within group
    uint ic_start = group_id * in_channels_per_group;

    // Gather from all input positions that contribute to this output position
    for (uint ic = 0; ic < in_channels_per_group; ic++) {
        for (uint kh = 0; kh < params.kernel_h; kh++) {
            for (uint kw = 0; kw < params.kernel_w; kw++) {
                // For transposed conv:
                // oh = ih * stride - padding + kh * dilation
                // ih * stride = oh + padding - kh * dilation
                // ih = (oh + padding - kh * dilation) / stride (must be integer and in bounds)

                int h_shifted = int(oh) + int(params.padding) - int(kh * params.dilation);
                int w_shifted = int(ow) + int(params.padding) - int(kw * params.dilation);

                // Check if this maps to a valid input position (must be divisible by stride)
                if (h_shifted >= 0 && h_shifted % int(params.stride) == 0 &&
                    w_shifted >= 0 && w_shifted % int(params.stride) == 0) {

                    int ih = h_shifted / int(params.stride);
                    int iw = w_shifted / int(params.stride);

                    if (ih >= 0 && ih < int(params.in_height) && iw >= 0 && iw < int(params.in_width)) {
                        // Get input value
                        // Input shape: [batch, in_channels, in_h, in_w]
                        uint input_idx = n * (params.in_channels * params.in_height * params.in_width) +
                                        (ic_start + ic) * (params.in_height * params.in_width) +
                                        uint(ih) * params.in_width + uint(iw);

                        // Get weight value
                        // Weight shape: [in_channels, out_channels/groups, kernel_h, kernel_w]
                        uint weight_idx = (ic_start + ic) * (out_channels_per_group * params.kernel_h * params.kernel_w) +
                                         oc_local * (params.kernel_h * params.kernel_w) +
                                         kh * params.kernel_w + kw;

                        sum += input_data[input_idx] * weight_data[weight_idx];
                    }
                }
            }
        }
    }

    // Add bias if present
    if (params.has_bias == 1) {
        sum += bias_data[oc];
    }

    output_data[idx] = sum;
}
