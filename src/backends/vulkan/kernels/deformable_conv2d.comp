#version 450

// Deformable Conv2d Forward Pass (DCNv2)
// Each thread computes one output element at (n, oc, oh, ow).
// Offsets shift sampling locations; optional mask modulates contributions.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input  { float input_data[];  };  // (N, C_in, H, W)
layout(binding = 1) buffer Offset { float offset_data[]; };  // (N, offset_groups*kH*kW*2, H_out, W_out)
layout(binding = 2) buffer Weight { float weight_data[]; };  // (C_out, C_in/groups, kH, kW)
layout(binding = 3) buffer Bias   { float bias_data[];   };  // (C_out)
layout(binding = 4) buffer Mask   { float mask_data[];   };  // (N, offset_groups*kH*kW, H_out, W_out)
layout(binding = 5) buffer Output { float output_data[]; };  // (N, C_out, H_out, W_out)

layout(push_constant) uniform PushConstants {
    uint batch;
    uint in_channels;
    uint out_channels;
    uint H;
    uint W;
    uint kH;
    uint kW;
    uint H_out;
    uint W_out;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint dil_h;
    uint dil_w;
    uint groups;
    uint offset_groups;
    uint use_mask;
    uint use_bias;
    uint n_elements;
} params;

// Bilinear interpolation with bounds checking.
// base_idx is the start of the (N, C) spatial plane in input_data.
float bilinear_interp(uint base_idx, float h, float w) {
    if (h <= -1.0 || h >= float(params.H) || w <= -1.0 || w >= float(params.W))
        return 0.0;

    int h_low = int(floor(h));
    int w_low = int(floor(w));
    int h_high = h_low + 1;
    int w_high = w_low + 1;

    float lh = h - float(h_low);
    float lw = w - float(w_low);
    float hh = 1.0 - lh;
    float hw = 1.0 - lw;

    float v1 = 0.0, v2 = 0.0, v3 = 0.0, v4 = 0.0;

    if (h_low >= 0 && w_low >= 0)
        v1 = input_data[base_idx + uint(h_low) * params.W + uint(w_low)];
    if (h_low >= 0 && w_high < int(params.W))
        v2 = input_data[base_idx + uint(h_low) * params.W + uint(w_high)];
    if (h_high < int(params.H) && w_low >= 0)
        v3 = input_data[base_idx + uint(h_high) * params.W + uint(w_low)];
    if (h_high < int(params.H) && w_high < int(params.W))
        v4 = input_data[base_idx + uint(h_high) * params.W + uint(w_high)];

    return hh * hw * v1 + hh * lw * v2 + lh * hw * v3 + lh * lw * v4;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements)
        return;

    // Decode linear index -> (n, oc, oh, ow)
    uint ow = idx % params.W_out;
    uint tmp = idx / params.W_out;
    uint oh = tmp % params.H_out;
    tmp /= params.H_out;
    uint oc = tmp % params.out_channels;
    uint n  = tmp / params.out_channels;

    // Group and channel ranges
    uint in_channels_per_group  = params.in_channels / params.groups;
    uint out_channels_per_group = params.out_channels / params.groups;
    uint g = oc / out_channels_per_group;
    uint ic_start = g * in_channels_per_group;

    // How many input channels share one offset group
    uint channels_per_offset_group = params.in_channels / params.offset_groups;

    float sum = 0.0;

    for (uint ic_local = 0; ic_local < in_channels_per_group; ic_local++) {
        uint ic = ic_start + ic_local;
        uint og = ic / channels_per_offset_group;  // offset group for this channel

        for (uint kh = 0; kh < params.kH; kh++) {
            for (uint kw = 0; kw < params.kW; kw++) {
                // Base sampling position
                float h_base = float(oh * params.stride_h) - float(params.pad_h) + float(kh * params.dil_h);
                float w_base = float(ow * params.stride_w) - float(params.pad_w) + float(kw * params.dil_w);

                // Offset index: (n, og*kH*kW*2 + (kh*kW+kw)*2 + {0,1}, oh, ow)
                uint kernel_idx = kh * params.kW + kw;
                uint off_base = ((n * params.offset_groups + og) * params.kH * params.kW + kernel_idx) * 2;
                uint off_h_idx = off_base * params.H_out * params.W_out + oh * params.W_out + ow;
                uint off_w_idx = (off_base + 1) * params.H_out * params.W_out + oh * params.W_out + ow;

                float h_off = offset_data[off_h_idx];
                float w_off = offset_data[off_w_idx];

                float h_loc = h_base + h_off;
                float w_loc = w_base + w_off;

                // Bilinear sample from input plane (n, ic)
                uint input_plane = (n * params.in_channels + ic) * params.H * params.W;
                float val = bilinear_interp(input_plane, h_loc, w_loc);

                // Modulation mask
                if (params.use_mask == 1) {
                    uint mask_idx = ((n * params.offset_groups + og) * params.kH * params.kW + kernel_idx)
                                    * params.H_out * params.W_out + oh * params.W_out + ow;
                    val *= mask_data[mask_idx];
                }

                // Weight: (oc, ic_local, kh, kw)
                uint w_idx = ((oc * in_channels_per_group + ic_local) * params.kH + kh) * params.kW + kw;
                sum += val * weight_data[w_idx];
            }
        }
    }

    // Add bias (only when a bias tensor was supplied; otherwise bias_data is a
    // dummy binding and must not be read at oc).
    if (params.use_bias == 1)
        sum += bias_data[oc];

    output_data[idx] = sum;
}
