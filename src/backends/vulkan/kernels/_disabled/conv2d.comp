#version 450

// 2D Convolution with shared memory tiling for input patch
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Weight { float weight_data[]; };
layout(binding = 2) buffer Bias { float bias_data[]; };
layout(binding = 3) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint in_channels;
    uint in_height;
    uint in_width;
    uint out_channels;
    uint out_height;
    uint out_width;
    uint kernel_h;
    uint kernel_w;
    uint stride;
    uint padding;
    uint dilation;
    uint has_bias;
} params;

// Shared memory tile for input patch.
// Required tile: tile_h * tile_w where
//   tile_h = 16*stride + (kernel_h-1)*dilation
//   tile_w = 16*stride + (kernel_w-1)*dilation
// The capacity is a specialization constant so the host can size it to the
// actual (stride,kernel,dilation) configuration and validate it against
// VkPhysicalDeviceLimits::maxComputeSharedMemorySize before creating the
// pipeline. The default (2048 floats = 8 KiB) covers the common case
// (stride<=2, kernel<=7, dilation<=2 -> max ~45x45 = 2025 floats); larger
// configurations MUST raise TILE_CAPACITY via the specialization constant.
layout(constant_id = 0) const uint TILE_CAPACITY = 2048;
shared float tile[TILE_CAPACITY];

void main() {
    uint out_x = gl_GlobalInvocationID.x;
    uint out_y = gl_GlobalInvocationID.y;
    // gl_GlobalInvocationID.z packs (batch * out_channels). Split it so each
    // sample of the batch gets its own output-channel slot.
    uint nc = gl_GlobalInvocationID.z;
    uint out_c = nc % params.out_channels;
    uint n = nc / params.out_channels;

    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint lid = ly * 16 + lx;

    // Workgroup's output region start (in output coords)
    uint wg_out_x = gl_WorkGroupID.x * 16;
    uint wg_out_y = gl_WorkGroupID.y * 16;

    // Corresponding input region start (top-left corner of input tile)
    int tile_start_y = int(wg_out_y * params.stride) - int(params.padding);
    int tile_start_x = int(wg_out_x * params.stride) - int(params.padding);

    // Input tile dimensions needed by this workgroup
    uint tile_h = 16 * params.stride + (params.kernel_h - 1) * params.dilation;
    uint tile_w = 16 * params.stride + (params.kernel_w - 1) * params.dilation;
    uint tile_size = tile_h * tile_w;

    // The shared tile capacity is fixed at pipeline-creation time via the
    // TILE_CAPACITY specialization constant. If the host failed to size it for
    // this configuration, abort instead of indexing out of bounds. The host is
    // responsible for guaranteeing tile_size <= TILE_CAPACITY (and that
    // TILE_CAPACITY*4 <= maxComputeSharedMemorySize); this is a defensive
    // backstop only.
    if (tile_size > TILE_CAPACITY) {
        return;
    }

    bool in_bounds = (out_x < params.out_width && out_y < params.out_height &&
                      out_c < params.out_channels && n < params.batch);

    float sum = 0.0;

    for (uint in_c = 0; in_c < params.in_channels; in_c++) {
        // Cooperatively load input tile into shared memory.
        // Input layout is NCHW: offset by the batch sample as well.
        uint base_input = (n * params.in_channels + in_c) *
                          params.in_height * params.in_width;

        // Use all 256 threads to load the tile (may need multiple iterations)
        for (uint i = lid; i < tile_size; i += 256) {
            uint ty = i / tile_w;
            uint tx = i % tile_w;
            int iy = tile_start_y + int(ty);
            int ix = tile_start_x + int(tx);

            if (iy >= 0 && iy < int(params.in_height) &&
                ix >= 0 && ix < int(params.in_width)) {
                tile[i] = input_data[base_input + uint(iy) * params.in_width + uint(ix)];
            } else {
                tile[i] = 0.0;  // Zero-pad
            }
        }
        barrier();

        // Compute convolution from shared memory tile
        if (in_bounds) {
            uint weight_base = out_c * params.in_channels * params.kernel_h * params.kernel_w +
                               in_c * params.kernel_h * params.kernel_w;

            // This thread's position within the tile (relative to tile_start)
            uint local_y = ly * params.stride;
            uint local_x = lx * params.stride;

            for (uint kh = 0; kh < params.kernel_h; kh++) {
                for (uint kw = 0; kw < params.kernel_w; kw++) {
                    uint ty = local_y + kh * params.dilation;
                    uint tx = local_x + kw * params.dilation;
                    sum += tile[ty * tile_w + tx] * weight_data[weight_base + kh * params.kernel_w + kw];
                }
            }
        }
        barrier();
    }

    if (in_bounds) {
        // Add bias if present
        if (params.has_bias > 0) {
            sum += bias_data[out_c];
        }

        // Write output. Output layout is NCHW: offset by the batch sample.
        uint output_idx = (n * params.out_channels + out_c) *
                          params.out_height * params.out_width +
                          out_y * params.out_width + out_x;
        output_data[output_idx] = sum;
    }
}
