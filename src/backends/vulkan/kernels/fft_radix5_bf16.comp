#version 450

// Stockham mixed-radix FFT: radix-5 butterfly stage (BFloat16)
// Data layout: interleaved real/imag pairs, packed as uint32 (2 bf16 per word)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };  // packed bf16 pairs
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint stage_stride;
    uint direction;
    uint batch_offset;
};

const float PI = 3.14159265358979323846;
const float COS_2PI_5 = 0.30901699437148;
const float SIN_2PI_5 = 0.95105651629515;
const float COS_4PI_5 = -0.80901699437148;
const float SIN_4PI_5 = 0.58778525229247;

float readBF16Element(uint element_idx) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint packed = data_in[pair_idx];
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

void writeBF16Element(uint element_idx, float val) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint b = floatBitsToUint(val);
    uint bits = (b + 0x7FFFu + ((b >> 16) & 1u)) >> 16;
    if (offset == 0) {
        uint existing = data_out[pair_idx] & 0xFFFF0000u;
        data_out[pair_idx] = existing | bits;
    } else {
        uint existing = data_out[pair_idx] & 0x0000FFFFu;
        data_out[pair_idx] = existing | (bits << 16);
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 5;
    if (tid >= n_butterflies) return;

    uint group = tid / stage_stride;
    uint pos = tid % stage_stride;

    uint i0 = group * stage_stride * 5 + pos;
    uint i1 = i0 + stage_stride;
    uint i2 = i1 + stage_stride;
    uint i3 = i2 + stage_stride;
    uint i4 = i3 + stage_stride;

    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;
    uint o2 = o1 + n_butterflies;
    uint o3 = o2 + n_butterflies;
    uint o4 = o3 + n_butterflies;

    // Twiddle factors
    float base_angle = -2.0 * PI * float(pos) / float(stage_stride * 5);
    if (direction == 1) base_angle = -base_angle;

    // Load with twiddle (read in F32 for precision)
    float a0_re = readBF16Element((batch_offset+i0)*2), a0_im = readBF16Element((batch_offset+i0)*2+1);

    float w1_re = cos(base_angle), w1_im = sin(base_angle);
    float r1 = readBF16Element((batch_offset+i1)*2), j1 = readBF16Element((batch_offset+i1)*2+1);
    float a1_re = r1*w1_re - j1*w1_im, a1_im = r1*w1_im + j1*w1_re;

    float w2_re = cos(2.0*base_angle), w2_im = sin(2.0*base_angle);
    float r2 = readBF16Element((batch_offset+i2)*2), j2 = readBF16Element((batch_offset+i2)*2+1);
    float a2_re = r2*w2_re - j2*w2_im, a2_im = r2*w2_im + j2*w2_re;

    float w3_re = cos(3.0*base_angle), w3_im = sin(3.0*base_angle);
    float r3 = readBF16Element((batch_offset+i3)*2), j3 = readBF16Element((batch_offset+i3)*2+1);
    float a3_re = r3*w3_re - j3*w3_im, a3_im = r3*w3_im + j3*w3_re;

    float w4_re = cos(4.0*base_angle), w4_im = sin(4.0*base_angle);
    float r4 = readBF16Element((batch_offset+i4)*2), j4 = readBF16Element((batch_offset+i4)*2+1);
    float a4_re = r4*w4_re - j4*w4_im, a4_im = r4*w4_im + j4*w4_re;

    // 5-point DFT using Rader's trick
    float s1_re = a1_re + a4_re, s1_im = a1_im + a4_im;
    float d1_re = a1_re - a4_re, d1_im = a1_im - a4_im;
    float s2_re = a2_re + a3_re, s2_im = a2_im + a3_im;
    float d2_re = a2_re - a3_re, d2_im = a2_im - a3_im;

    writeBF16Element((batch_offset+o0)*2,   a0_re + s1_re + s2_re);
    writeBF16Element((batch_offset+o0)*2+1, a0_im + s1_im + s2_im);

    writeBF16Element((batch_offset+o1)*2,   a0_re + COS_2PI_5*s1_re + COS_4PI_5*s2_re - SIN_2PI_5*d1_im - SIN_4PI_5*d2_im);
    writeBF16Element((batch_offset+o1)*2+1, a0_im + COS_2PI_5*s1_im + COS_4PI_5*s2_im + SIN_2PI_5*d1_re + SIN_4PI_5*d2_re);

    writeBF16Element((batch_offset+o2)*2,   a0_re + COS_4PI_5*s1_re + COS_2PI_5*s2_re - SIN_4PI_5*d1_im + SIN_2PI_5*d2_im);
    writeBF16Element((batch_offset+o2)*2+1, a0_im + COS_4PI_5*s1_im + COS_2PI_5*s2_im + SIN_4PI_5*d1_re - SIN_2PI_5*d2_re);

    writeBF16Element((batch_offset+o3)*2,   a0_re + COS_4PI_5*s1_re + COS_2PI_5*s2_re + SIN_4PI_5*d1_im - SIN_2PI_5*d2_im);
    writeBF16Element((batch_offset+o3)*2+1, a0_im + COS_4PI_5*s1_im + COS_2PI_5*s2_im - SIN_4PI_5*d1_re + SIN_2PI_5*d2_re);

    writeBF16Element((batch_offset+o4)*2,   a0_re + COS_2PI_5*s1_re + COS_4PI_5*s2_re + SIN_2PI_5*d1_im + SIN_4PI_5*d2_im);
    writeBF16Element((batch_offset+o4)*2+1, a0_im + COS_2PI_5*s1_im + COS_4PI_5*s2_im - SIN_2PI_5*d1_re - SIN_4PI_5*d2_re);
}
