#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Bitonic sort (Float16 variant)
// One compare-and-swap pass per dispatch
// Operates on (value, index) pairs: sorts by value, produces sorted indices
// Values stored as packed uint32 (2 x float16 per word)
// Multiple dispatches required: log2(N) * (log2(N)+1) / 2 passes total
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Values { uint values[]; };       // Packed float16 pairs
layout(binding = 1) buffer Indices { int indices[]; };       // Corresponding indices (output)

layout(push_constant) uniform PushConstants {
    uint n;               // Original (unpadded) number of elements
    uint padded_n;        // Padded to power-of-2
    uint stage;           // Current stage (0, 1, 2, ...)
    uint substage;        // Current substage within stage
    uint descending;      // 0 = ascending, 1 = descending
} params;

// Read a float16 element from packed buffer, returning as float for comparison
float readF16(uint elem_idx) {
    uint word_idx = elem_idx / 2;
    uint half_idx = elem_idx % 2;
    uint packed = values[word_idx];
    uint bits = (half_idx == 0) ? (packed & 0xFFFFu) : (packed >> 16);
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write a float value back as float16 into the packed buffer.
// Two packed elements share one uint word, and concurrent threads (gid and
// gid+1) may update the two halves of the same word in the same pass, so the
// half-word merge must be an atomic CAS retry loop — a plain read-modify-write
// store would lose one update. Mirrors bilinear_interpolate_f16::writeF16Element.
void writeF16(uint elem_idx, float val) {
    uint word_idx = elem_idx / 2;
    uint half_offset = (elem_idx % 2) * 16;
    uint new_bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = values[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(values[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint gid = gl_GlobalInvocationID.x;

    // Each thread handles one compare-and-swap
    if (gid >= params.padded_n / 2) return;

    // Compute the pair of elements to compare
    uint block_size = 1u << (params.stage + 1);
    uint half_block = 1u << params.substage;

    // Determine position within the block structure
    uint block_id = gid / half_block;
    uint offset = gid % half_block;

    uint i = block_id * (half_block * 2) + offset;
    uint j = i + half_block;

    if (j >= params.padded_n) return;

    // Determine sort direction for this block
    // F140: block_ascending is the network's own merge-structure direction,
    // independent of the requested global sort order (see bitonic_sort.comp).
    uint sort_block = i / block_size;
    bool block_ascending = ((sort_block % 2) == 0);
    bool ascending_block = block_ascending;
    if (params.descending != 0) ascending_block = !ascending_block;

    // Read float16 values as float32 for comparison
    float val_i = readF16(i);
    float val_j = readF16(j);
    int idx_i = indices[i];
    int idx_j = indices[j];

    // F138: NaN-aware, STABLE comparator (see bitonic_sort.comp). NaN -> +INF,
    // value ties broken by original index (stability + real-before-padding).
    float ka = isnan(val_i) ? uintBitsToFloat(0x7F800000u) : val_i;
    float kb = isnan(val_j) ? uintBitsToFloat(0x7F800000u) : val_j;

    // F139/F140: value direction (ascending_block) is XORed with
    // params.descending; tie-break direction (block_ascending) is NOT --
    // ties must always break by ascending original index regardless of sort
    // direction, while still following the 0-1-principle R/R' network
    // structure. See bitonic_sort.comp for the full rationale.
    bool should_swap;
    bool tie_break = block_ascending ? (idx_i > idx_j) : (idx_i < idx_j);
    if (ascending_block) {
        should_swap = (ka > kb) || (ka == kb && tie_break);
    } else {
        should_swap = (ka < kb) || (ka == kb && tie_break);
    }

    if (should_swap) {
        writeF16(i, val_j);
        writeF16(j, val_i);
        int tmp = indices[i];
        indices[i] = indices[j];
        indices[j] = tmp;
    }
}
