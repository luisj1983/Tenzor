#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Cast Float32 -> UInt64 (clamp negatives to 0, truncate toward zero).
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    float data[];
} input_buf;

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
    uint64_t data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    // 2^64 (18446744073709551616.0) is not representable exactly in float32;
    // values at/above 2^64 (including +Inf) make uint64_t(v) an out-of-range
    // conversion (undefined in GLSL), so saturate them to UINT64_MAX. Clamp the
    // in-range positive side to the largest float32 strictly below 2^64
    // (2^64 - 2^40 = 18446742974197923840.0) so the truncating conversion stays
    // well-defined. Negatives (and NaN, via max returning the non-NaN operand)
    // clamp to 0, matching the saturating reference cast behavior.
    float v = input_buf.data[idx];
    if (v >= 18446744073709551616.0) {
        output_buf.data[idx] = 0xFFFFFFFFFFFFFFFFul;
    } else {
        v = clamp(v, 0.0, 18446742974197923840.0);
        output_buf.data[idx] = uint64_t(v);
    }
}
