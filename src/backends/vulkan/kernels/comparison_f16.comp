#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Comparison operations for Float16: eq, ne, lt, le, gt, ge
// Input: packed F16 pairs in uint32. Output: uint8 booleans per element.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { uint a[]; };
layout(binding = 1) buffer InputB { uint b[]; };
layout(binding = 2) buffer Output { uint8_t result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=eq, 1=ne, 2=lt, 3=le, 4=gt, 5=ge
} params;

float16_t readF16(uint packed, uint offset) {
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return float16_t(unpackHalf2x16(bits | (bits << 16)).x);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) return;

    // Read from packed F16 buffer
    uint word_idx = idx / 2;
    uint half_idx = idx % 2;

    float val_a = float(readF16(a[word_idx], half_idx));
    float val_b = float(readF16(b[word_idx], half_idx));

    uint8_t result_val;
    switch (params.op) {
        case 0: result_val = (val_a == val_b) ? uint8_t(1) : uint8_t(0); break;
        case 1: result_val = (val_a != val_b) ? uint8_t(1) : uint8_t(0); break;
        case 2: result_val = (val_a < val_b) ? uint8_t(1) : uint8_t(0); break;
        case 3: result_val = (val_a <= val_b) ? uint8_t(1) : uint8_t(0); break;
        case 4: result_val = (val_a > val_b) ? uint8_t(1) : uint8_t(0); break;
        case 5: result_val = (val_a >= val_b) ? uint8_t(1) : uint8_t(0); break;
        default: result_val = uint8_t(0); break;
    }

    result[idx] = result_val;
}
