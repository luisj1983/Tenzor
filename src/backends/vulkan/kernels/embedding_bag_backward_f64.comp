#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// EmbeddingBag Backward Pass (Float64)
// Scatter-add gradients back to embedding table.
//
// RACE CONDITION NOTE: The += on grad_weight_data is non-atomic. When duplicate indices
// exist in the batch, multiple invocations may write to the same row concurrently, causing
// lost updates (not corruption — just missed gradient contributions). This is a known
// limitation because GL_EXT_shader_atomic_float does not cover float64 atomics.
// See embedding_backward_f64.comp for detailed rationale.

layout(local_size_x = 256) in;

layout(binding = 0) buffer GradOutput { float64_t grad_output_data[]; };
layout(binding = 1) buffer Indices { int indices_data[]; };
layout(binding = 2) buffer Offsets { int offset_data[]; };
layout(binding = 3) buffer GradWeight { float64_t grad_weight_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_bags;
    uint embedding_dim;
    uint num_embeddings;
    uint mode;
    uint include_last_offset;
    uint num_offsets;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total_output = params.num_bags * params.embedding_dim;
    if (gid >= total_output) return;

    uint bag = gid / params.embedding_dim;
    uint j = gid % params.embedding_dim;

    int start = offset_data[bag];
    int end_val;
    if (bag + 1 < params.num_offsets) {
        end_val = offset_data[bag + 1];
    } else {
        return;
    }

    int bag_size = end_val - start;
    if (bag_size <= 0) return;

    float64_t grad_val = grad_output_data[bag * params.embedding_dim + j];

    if (params.mode == 1) {
        grad_val /= float64_t(bag_size);
    }

    for (int i = start; i < end_val; ++i) {
        int idx = indices_data[i];
        if (idx >= 0 && idx < int(params.num_embeddings)) {
            grad_weight_data[uint(idx) * params.embedding_dim + j] += grad_val;
        }
    }
}
