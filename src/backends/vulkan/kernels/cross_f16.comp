#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Cross product along a dimension for Float16
// Elements stored as packed pairs in uint words
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { uint a_buf[]; };
layout(binding = 1) buffer InputB { uint b_buf[]; };
layout(binding = 2) buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint num_pairs;
    uint dim_stride;
} params;

// Read a single f16 element from packed uint buffer at flat index
float readF16(uint flat_idx) {
    uint word = a_buf[flat_idx >> 1];
    uint shift = (flat_idx & 1u) * 16u;
    uint bits = (word >> shift) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

float readF16B(uint flat_idx) {
    uint word = b_buf[flat_idx >> 1];
    uint shift = (flat_idx & 1u) * 16u;
    uint bits = (word >> shift) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

void writeF16(uint flat_idx, float val) {
    uint word_idx = flat_idx >> 1;
    uint shift = (flat_idx & 1u) * 16u;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    atomicAnd(result[word_idx], ~(0xFFFFu << shift));
    atomicOr(result[word_idx], bits << shift);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_pairs) return;

    uint o = idx / params.dim_stride;
    uint i = idx % params.dim_stride;
    uint base = o * 3 * params.dim_stride + i;

    float a0 = readF16(base);
    float a1 = readF16(base + params.dim_stride);
    float a2 = readF16(base + 2 * params.dim_stride);
    float b0 = readF16B(base);
    float b1 = readF16B(base + params.dim_stride);
    float b2 = readF16B(base + 2 * params.dim_stride);

    writeF16(base,                           a1*b2 - a2*b1);
    writeF16(base + params.dim_stride,       a2*b0 - a0*b2);
    writeF16(base + 2 * params.dim_stride,   a0*b1 - a1*b0);
}
