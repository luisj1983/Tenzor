#version 450

// Complex64 sqrt: principal branch.
// Let r = hypot(a, b). Then sqrt(a+bi) = sqrt((r+a)/2) + i*sign(b)*sqrt((r-a)/2).

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { float data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;
    float a = data_in[idx * 2u];
    float b = data_in[idx * 2u + 1u];
    if (a == 0.0 && b == 0.0) {
        data_out[idx * 2u]      = 0.0;
        data_out[idx * 2u + 1u] = 0.0;
        return;
    }
    // Scale-free |z|.
    float ar = abs(a);
    float ai = abs(b);
    float m = max(ar, ai);
    float mag = m * sqrt((ar / m) * (ar / m) + (ai / m) * (ai / m));
    float s = sqrt(0.5 * (abs(a) + mag));
    float re, im;
    if (a >= 0.0) { re = s;                  im = b / (2.0 * s); }
    else           { re = abs(b) / (2.0 * s); im = (b >= 0.0) ? s : -s; }
    data_out[idx * 2u]      = re;
    data_out[idx * 2u + 1u] = im;
}
