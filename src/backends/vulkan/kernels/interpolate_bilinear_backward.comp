#version 450
#extension GL_EXT_shader_atomic_float : enable

// D3-followup Vulkan: bilinear backward via VK_EXT_shader_atomic_float
// fetch_add scatter. Mirror of the CUDA `interpolate_bilinear_backward_kernel`
// and the OneAPI `interpolate_bilinear_backward_dispatch`. One work-item
// per output element; each atomically adds 4 weighted contributions into
// the input-shape grad_input buffer.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, out_h, out_w)
layout(binding = 1) buffer GradInput  { float grad_input[]; };   // (N, C, in_h, in_w)

layout(push_constant) uniform PushConstants {
    uint n_elements;     // N * C * out_h * out_w
    uint batch;
    uint channels;
    uint in_h;
    uint in_w;
    uint out_h;
    uint out_w;
    uint align_corners;  // 0 / 1
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint ow = temp % params.out_w; temp /= params.out_w;
    uint oh = temp % params.out_h; temp /= params.out_h;
    uint c  = temp % params.channels; temp /= params.channels;
    uint b  = temp;

    float y;
    float x;
    if (params.align_corners != 0u) {
        y = (params.out_h > 1u)
            ? float(oh) * float(params.in_h - 1u) / float(params.out_h - 1u)
            : 0.0;
        x = (params.out_w > 1u)
            ? float(ow) * float(params.in_w - 1u) / float(params.out_w - 1u)
            : 0.0;
    } else {
        float scale_h = float(params.in_h) / float(params.out_h);
        float scale_w = float(params.in_w) / float(params.out_w);
        y = (float(oh) + 0.5) * scale_h - 0.5;
        x = (float(ow) + 0.5) * scale_w - 0.5;
    }
    y = clamp(y, 0.0, float(params.in_h - 1u));
    x = clamp(x, 0.0, float(params.in_w - 1u));

    uint y0 = uint(y);
    uint x0 = uint(x);
    uint y1 = min(y0 + 1u, params.in_h - 1u);
    uint x1 = min(x0 + 1u, params.in_w - 1u);
    float fy = y - float(y0);
    float fx = x - float(x0);

    float w00 = (1.0 - fy) * (1.0 - fx);
    float w01 = (1.0 - fy) * fx;
    float w10 = fy * (1.0 - fx);
    float w11 = fy * fx;

    float g = grad_output[idx];
    uint base_idx = b * (params.channels * params.in_h * params.in_w)
                  + c * (params.in_h * params.in_w);

    atomicAdd(grad_input[base_idx + y0 * params.in_w + x0], w00 * g);
    atomicAdd(grad_input[base_idx + y0 * params.in_w + x1], w01 * g);
    atomicAdd(grad_input[base_idx + y1 * params.in_w + x0], w10 * g);
    atomicAdd(grad_input[base_idx + y1 * params.in_w + x1], w11 * g);
}
