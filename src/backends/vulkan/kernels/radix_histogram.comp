#version 450

// Radix sort: per-workgroup histogram of 8-bit digit
// Each workgroup counts occurrences of each digit value (0-255) in its tile
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer Keys     { float keys[];    };
layout(set = 0, binding = 1) buffer Histograms         { uint histos[];   };  // [n_workgroups * 256]

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint digit;      // Which 8-bit digit (0=LSB, 3=MSB for 32-bit)
    uint n_wgs;      // Number of workgroups
    uint descending; // 0 = ascending, 1 = descending
};

shared uint local_histo[256];

// Convert float to radix-sortable uint32 (sign-bit flip for correct ordering).
// For a descending sort we additionally invert all bits of the sortable key so
// that an ASCENDING stable LSD radix over the inverted key yields descending
// VALUES while preserving ascending original-index order within equal-value
// runs, matching the CPU reference (std::stable_sort with '>' for descending).
uint float_to_sortable(float val) {
    uint bits = floatBitsToUint(val);
    // If sign bit set, flip all bits; else flip only sign bit
    uint mask = -int(bits >> 31) | 0x80000000u;
    uint sortable = bits ^ mask;
    if (descending != 0u) sortable = ~sortable;
    return sortable;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    // Clear local histogram. The histogram always has exactly 256 bins, but
    // the workgroup size is a runtime spec constant (local_size_x_id=0) that
    // can be <256 or >256, so clear all 256 bins via a strided loop rather
    // than one-bin-per-thread (which would leave bins uncleared for wgSize<256
    // and write past local_histo[256] for wgSize>256).
    for (uint b = lid; b < 256u; b += gl_WorkGroupSize.x) {
        local_histo[b] = 0u;
    }
    barrier();

    // Count digits in this workgroup's tile, striding by the actual workgroup
    // size (not a hardcoded 256) so every element is counted exactly once.
    uint tile_size = (n + n_wgs - 1) / n_wgs;
    uint tile_start = wg_id * tile_size;
    uint tile_end = min(tile_start + tile_size, n);

    for (uint i = tile_start + lid; i < tile_end; i += gl_WorkGroupSize.x) {
        uint sortable = float_to_sortable(keys[i]);
        uint digit_val = (sortable >> (digit * 8)) & 0xFFu;
        atomicAdd(local_histo[digit_val], 1);
    }
    barrier();

    // Write local histogram to global histogram matrix (column-major for prefix
    // sum). Only the first 256 lanes own a bin; guard so wgSize>256 lanes don't
    // write past the [256 * n_wgs] global buffer.
    if (lid < 256u) {
        histos[lid * n_wgs + wg_id] = local_histo[lid];
    }
}
