#version 450

// Radix sort: per-workgroup histogram of 8-bit digit
// Each workgroup counts occurrences of each digit value (0-255) in its tile
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Keys     { float keys[];    };
layout(set = 0, binding = 1) buffer Histograms         { uint histos[];   };  // [n_workgroups * 256]

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint digit;      // Which 8-bit digit (0=LSB, 3=MSB for 32-bit)
    uint n_wgs;      // Number of workgroups
};

shared uint local_histo[256];

// Convert float to radix-sortable uint32 (sign-bit flip for correct ordering)
uint float_to_sortable(float val) {
    uint bits = floatBitsToUint(val);
    // If sign bit set, flip all bits; else flip only sign bit
    uint mask = -int(bits >> 31) | 0x80000000u;
    return bits ^ mask;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    // Clear local histogram
    local_histo[lid] = 0;
    barrier();

    // Count digits in this workgroup's tile
    uint tile_size = (n + n_wgs - 1) / n_wgs;
    uint tile_start = wg_id * tile_size;
    uint tile_end = min(tile_start + tile_size, n);

    for (uint i = tile_start + lid; i < tile_end; i += 256) {
        uint sortable = float_to_sortable(keys[i]);
        uint digit_val = (sortable >> (digit * 8)) & 0xFFu;
        atomicAdd(local_histo[digit_val], 1);
    }
    barrier();

    // Write local histogram to global histogram matrix (column-major for prefix sum)
    histos[lid * n_wgs + wg_id] = local_histo[lid];
}
