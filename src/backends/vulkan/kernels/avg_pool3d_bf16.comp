#version 450

// Average Pooling 3D Forward Pass for BFloat16
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch_channels;
    uint in_depth;
    uint in_height;
    uint in_width;
    uint out_depth;
    uint out_height;
    uint out_width;
    uint kernel_d;
    uint kernel_h;
    uint kernel_w;
    uint stride_d;
    uint stride_h;
    uint stride_w;
    uint padding_d;
    uint padding_h;
    uint padding_w;
    uint count_include_pad;
} params;

float readBF16Element(uint flat_idx) {
    uint pair_idx = flat_idx / 2;
    uint offset = flat_idx % 2;
    uint packed = input_data[pair_idx];
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

void writeBF16Element(uint flat_idx, float val) {
    uint word_idx = flat_idx / 2;
    uint half_offset = (flat_idx % 2) * 16;
    uint b = floatBitsToUint(val);
    uint new_bits = (b + 0x7FFFu + ((b >> 16) & 1u)) >> 16;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint r = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (r == old_word) return;
        old_word = r;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint d_out = temp % params.out_depth;
    uint bc = temp / params.out_depth;

    int d_start = int(d_out * params.stride_d) - int(params.padding_d);
    int h_start = int(h_out * params.stride_h) - int(params.padding_h);
    int w_start = int(w_out * params.stride_w) - int(params.padding_w);

    float sum = 0.0;
    uint count = 0;

    uint in_spatial = params.in_depth * params.in_height * params.in_width;

    for (uint kd = 0; kd < params.kernel_d; kd++) {
        int d_in = d_start + int(kd);
        for (uint kh = 0; kh < params.kernel_h; kh++) {
            int h_in = h_start + int(kh);
            for (uint kw = 0; kw < params.kernel_w; kw++) {
                int w_in = w_start + int(kw);

                if (d_in >= 0 && d_in < int(params.in_depth) &&
                    h_in >= 0 && h_in < int(params.in_height) &&
                    w_in >= 0 && w_in < int(params.in_width)) {

                    uint input_idx = bc * in_spatial +
                                    uint(d_in) * params.in_height * params.in_width +
                                    uint(h_in) * params.in_width + uint(w_in);
                    sum += float(readBF16Element(input_idx));
                    count++;
                } else if (params.count_include_pad != 0) {
                    count++;
                }
            }
        }
    }

    float result = 0.0;
    if (count > 0) {
        result = sum / float(count);
    }

    writeBF16Element(idx, float(result));
}
