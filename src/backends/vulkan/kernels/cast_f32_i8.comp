#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Cast Float32 to Int8: truncate toward zero to a 32-bit int, then take the
// low 8 bits (modular truncation/wraparound). Matches CPU/CUDA/ROCm's raw
// static_cast (no clamping) and numpy/PyTorch's `.to(int8)` semantics, e.g.
// 200.0f -> -56 rather than saturating to 127. The previous clamp([-128,127])
// diverged from the majority-backend/PyTorch/numpy convention for
// out-of-range values.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    float data[];
} input_buf;

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
    int8_t data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    int iv = int(input_buf.data[idx]);  // truncate toward zero
    output_buf.data[idx] = int8_t(iv);  // modular narrowing (low 8 bits)
}
