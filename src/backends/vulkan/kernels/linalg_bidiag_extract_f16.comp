#version 450

// Extract diagonal and superdiagonal from bidiagonalized matrix — Float16 variant
// Reads packed F16 matrix, writes packed F16 diag/superdiag
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer MatrixA { uint A[]; };
layout(set = 0, binding = 1) buffer Diag { uint diag_buf[]; };
layout(set = 0, binding = 2) buffer SuperDiag { uint sdiag_buf[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch_idx;
};

float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = A[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void writeF16Diag(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;
    uint old_val = diag_buf[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(diag_buf[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word (X.7 / Y.11 / Y.16).
}

void writeF16Sdiag(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;
    uint old_val = sdiag_buf[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(sdiag_buf[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word (X.7 / Y.11 / Y.16).
}

void main() {
    uint tid = gl_LocalInvocationID.x + gl_WorkGroupID.x * gl_WorkGroupSize.x;
    uint elem_base = batch_idx * n * n;

    if (tid < n) {
        writeF16Diag(batch_idx * n + tid, readF16(elem_base + tid * n + tid));
    }

    if (tid < n - 1) {
        writeF16Sdiag(batch_idx * (n - 1) + tid, readF16(elem_base + tid * n + (tid + 1)));
    }
}
