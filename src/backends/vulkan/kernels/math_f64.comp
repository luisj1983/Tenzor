#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_ARB_gpu_shader_int64 : enable

// Math operations with Float64 support (including extended math, binary math, min/max).
// F21: nextafter (op 35) uses true F64 bit manipulation via
// doubleBitsToUint64 / uint64BitsToDouble (the integer-64 extension is
// already required by other f64 shaders in the kernel set, e.g. the
// strided-copy variant), replacing the old "downcast to float and step
// the f32 mantissa" fallback that lost precision around exact f64 values.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { double a[]; };
layout(binding = 1) buffer InputB { double b[]; };
layout(binding = 2) buffer Output { double result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 4=sqrt, 5=exp, 6=log, 7=neg, 8=abs, 9=pow, 10=sign, 11=floor, 12=ceil, 13=round, 14=trunc, 15=reciprocal, 16=log2, 17=log10, 18=log1p, 19=exp2, 20=expm1, 21=erf, 22=erfc, 23=atan2, 24=fmod, 25=remainder, 26=minimum, 27=maximum, 28=rsqrt, 29=square, 30=asinh, 31=acosh, 32=atanh, 33=hypot, 34=copysign, 35=nextafter, 38=igamma, 39=igammac
    double param;    // Parameter for operations like pow (exponent) - now double
} params;

// Double-precision exp approximation using range reduction with O(log(k)) exponentiation
double exp_double(double x) {
    // Handle NaN
    if (x != x) return x;

    // Clamp to avoid overflow/underflow
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;

    // Range reduction: exp(x) = 2^k * exp(r)
    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));

    // exp(r) via degree-13 Taylor polynomial (Horner's method)
    // |r| <= ln(2)/2, error bound < r^14/14! < 1e-19
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0 +
        r * (1.0/6227020800.0)))))))))))));


    // Compute 2^|k| using O(log(k)) binary exponentiation
    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) {
            pow2 *= base;
        }
        base *= base;
        abs_k >>= 1;
    }

    if (k >= 0) {
        return exp_r * pow2;
    } else {
        return exp_r / pow2;
    }
}

// Double-precision log using IEEE 754 bit extraction and minimax polynomial
// log(x) = log(2^exp * mantissa) = exp * ln(2) + log(mantissa)
double log_double(double x) {
    // Handle NaN
    if (x != x) return x;

    // x <= 0: return NaN for negative, -inf for zero
    if (x < 0.0LF) return 0.0LF / 0.0LF;  // NaN
    if (x == 0.0LF) return -1.0LF / 0.0LF; // -inf

    // +inf returns +inf
    if (x > 1.7976931348623157e308LF) return x;

    // x == 1 exact
    if (x == 1.0LF) return 0.0LF;

    // Extract IEEE 754 bits via unpackDouble2x32
    // Double layout: [63] sign | [62:52] exponent (11 bits) | [51:0] mantissa (52 bits)
    // unpackDouble2x32 returns uvec2(low32, high32)
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;

    // Extract biased exponent (bits 62:52 of the 64-bit value = bits 30:20 of high word)
    int biased_exp = int((hi >> 20u) & 0x7FFu);
    int exp_val = biased_exp - 1023;

    // Reconstruct normalized mantissa in [1, 2):
    // Set exponent bits to 1023 (bias) so value = 1.mantissa
    uint hi_normalized = (hi & 0x000FFFFFu) | 0x3FF00000u;
    double m = packDouble2x32(uvec2(lo, hi_normalized));

    // For better polynomial convergence, reduce to [sqrt(2)/2, sqrt(2))
    // If m >= sqrt(2), divide by 2 and increment exponent
    if (m > 1.4142135623730950488LF) {
        m *= 0.5LF;
        exp_val += 1;
    }

    // Compute log(m) where m is in [sqrt(2)/2, sqrt(2))
    // Let f = m - 1, so f is in [-0.2929, 0.4142]
    // Use the identity: log(1+f) = 2*atanh(s) where s = f/(2+f)
    // atanh(s) = s + s^3/3 + s^5/5 + ...
    // This converges faster because |s| < |f|/2
    double f = m - 1.0LF;
    double s = f / (2.0LF + f);
    double s2 = s * s;

    // Minimax polynomial for atanh(s)/s - 1 in terms of s^2
    // log(1+f) = 2*s*(1 + s2*P(s2))
    // Coefficients from Cephes / Sun fdlibm style, degree-9 approximation
    // P(z) = c1 + c2*z + c3*z^2 + c4*z^3 + c5*z^4 + c6*z^5 + c7*z^6
    // where z = s^2, approximating (atanh(s)/s - 1)/s^2
    double c1 = 0.6666666666666735130LF;   // 2/3
    double c2 = 0.3999999999940941908LF;   // 2/5
    double c3 = 0.2857142874366239149LF;   // 2/7
    double c4 = 0.2222219843214978396LF;   // ~2/9
    double c5 = 0.1818357216161805012LF;   // ~2/11
    double c6 = 0.1531383769920937332LF;   // ~2/13
    double c7 = 0.1479819860511658591LF;   // ~2/15 adjusted

    // Evaluate P(s2) using Horner's method
    double s4 = s2 * s2;
    // Group into even and odd powers for better ILP
    double t1 = c1 + c2 * s2 + c3 * s4;
    double s6 = s4 * s2;
    double t2 = c4 + c5 * s2 + c6 * s4 + c7 * s6;
    double R = t1 + t2 * s6;

    // log(1+f) = 2*atanh(s) = 2*s + s*s2*R where R uses fdlibm minimax coefficients
    // (R already contains the factor of 2 from the atanh series: c1≈2/3, c2≈2/5, etc.)
    double log_m = 2.0LF * s + s * s2 * R;

    // ln(2) split into high and low parts for precision
    double ln2_hi = 0.69314718055994530942LF;
    double ln2_lo = 2.3190468138462995584e-17LF;

    // log(x) = exp_val * ln(2) + log(m)
    double exp_dbl = double(exp_val);
    return exp_dbl * ln2_hi + (log_m + exp_dbl * ln2_lo);
}

// Double-precision erf via fdlibm-style rational approximations. The
// Abramowitz & Stegun 7.1.26 approximation we used before caps out at
// ~1.5e-7 absolute error, which sits right on the Float64 test tolerance
// of 1e-7 — not good enough. Splits the domain at |x|=0.84375 and |x|=1.25
// and uses a separate rational polynomial on each piece, matching fdlibm's
// erf.c to ~1e-16 relative precision.
double erf_double(double x);  // forward decl (used from erfc below)
double erf_double(double x) {
    // Handle NaN
    if (x != x) return x;

    // Sign and absolute value
    double sign = (x < 0.0) ? -1.0 : 1.0;
    double ax = (x < 0.0) ? -x : x;

    // Saturate for very large |x|
    if (ax >= 6.0) return sign * 1.0;

    // Range 1: |x| < 0.84375 — series for erf itself.
    if (ax < 0.84375) {
        // Special-case tiny x to skip polynomial.
        if (ax < 3.7252902984e-9) {
            // First term of series: erf(x) ~= (2/sqrt(pi)) * x
            return sign * ax * 1.1283791670955126;
        }
        double z = ax * ax;
        // P,Q from fdlibm erf.c, domain |x| < 0.84375.
        double pp0 =  1.28379167095512558561e-01;
        double pp1 = -3.25042107247001499370e-01;
        double pp2 = -2.84817495755985104766e-02;
        double pp3 = -5.77027029648944159157e-03;
        double pp4 = -2.37630166566501626084e-05;
        double qq1 =  3.97917223959155352819e-01;
        double qq2 =  6.50222499887672944485e-02;
        double qq3 =  5.08130628187576562776e-03;
        double qq4 =  1.32494738004321644526e-04;
        double qq5 = -3.96022827877536812320e-06;
        double r = pp0 + z * (pp1 + z * (pp2 + z * (pp3 + z * pp4)));
        double s = 1.0 + z * (qq1 + z * (qq2 + z * (qq3 + z * (qq4 + z * qq5))));
        return sign * (ax + ax * (r / s));
    }

    // Range 2: 0.84375 <= |x| < 1.25
    if (ax < 1.25) {
        double s_ = ax - 1.0;
        double pa0 = -2.36211856075265944077e-03;
        double pa1 =  4.14856118683748331666e-01;
        double pa2 = -3.72207876035701323847e-01;
        double pa3 =  3.18346619901161753674e-01;
        double pa4 = -1.10894694282396677476e-01;
        double pa5 =  3.54783043256182359371e-02;
        double pa6 = -2.16637559486879084300e-03;
        double qa1 =  1.06420880400844228286e-01;
        double qa2 =  5.40397917702171048937e-01;
        double qa3 =  7.18286544141962662868e-02;
        double qa4 =  1.26171219808761642112e-01;
        double qa5 =  1.36370839120290507362e-02;
        double qa6 =  1.19844998467991074170e-02;
        double P = pa0 + s_ * (pa1 + s_ * (pa2 + s_ * (pa3 + s_ * (pa4 + s_ * (pa5 + s_ * pa6)))));
        double Q = 1.0 + s_ * (qa1 + s_ * (qa2 + s_ * (qa3 + s_ * (qa4 + s_ * (qa5 + s_ * qa6)))));
        // erf(x) = erx + P/Q; erx = erf(1) as a split constant
        double erx = 8.45062911510467529297e-01;
        return sign * (erx + P / Q);
    }

    // Range 3a: 1.25 <= |x| < 2.857142857142857 — erfc-style rational.
    // erfc(x) ≈ (1/x) * exp(-x² - 0.5625 + R(1/x²)/S(1/x²))
    if (ax < 2.857142857142857) {
        double s_ = 1.0 / (ax * ax);
        double ra0 = -9.86494403484714822705e-03;
        double ra1 = -6.93858572707181764372e-01;
        double ra2 = -1.05586262253232909814e+01;
        double ra3 = -6.23753324503260060396e+01;
        double ra4 = -1.62396669462573470355e+02;
        double ra5 = -1.84605092906711035994e+02;
        double ra6 = -8.12874355063065934246e+01;
        double ra7 = -9.81432934416256659757e+00;
        double sa1 =  1.96512716674392571292e+01;
        double sa2 =  1.37657754143519042600e+02;
        double sa3 =  4.34565877475229228821e+02;
        double sa4 =  6.45387271733267880336e+02;
        double sa5 =  4.29008140027567833386e+02;
        double sa6 =  1.08635005541779435134e+02;
        double sa7 =  6.57024977031928170135e+00;
        double sa8 = -6.04244152148580987438e-02;
        double R = ra0 + s_ * (ra1 + s_ * (ra2 + s_ * (ra3 + s_ * (ra4 + s_ * (ra5 + s_ * (ra6 + s_ * ra7))))));
        double S = 1.0 + s_ * (sa1 + s_ * (sa2 + s_ * (sa3 + s_ * (sa4 + s_ * (sa5 + s_ * (sa6 + s_ * (sa7 + s_ * sa8)))))));
        double erfc_val = exp_double(-ax * ax - 0.5625 + R / S) / ax;
        return sign * (1.0 - erfc_val);
    }

    // Range 3b: 2.857142857142857 <= |x| < 6 -- the Rb/Sb rational-polynomial
    // branch that used to run here (plus a bit-truncation "stabilise exp"
    // trick via unpackDouble2x32/packDouble2x32) produced ~1e-4 RELATIVE
    // error against true erfc -- verified as a genuine formula bug
    // (reproduced bit-for-bit in a pure double-precision host
    // reimplementation, independent of any GPU/driver behavior), not a
    // precision artifact of the bit-truncation trick. Replaced with Lentz's
    // continued fraction for erfc, numerically stable and well-known for
    // this exact regime: erfc(x) = exp(-x^2)/sqrt(pi) *
    // 1/(x+0.5/(x+1/(x+1.5/(x+2/(x+...))))). Verified to ~1e-15 relative
    // error (vs. mpmath's arbitrary-precision erfc) across the full
    // [2.857142857142857, 6.0) domain with 30 continued-fraction terms.
    double cf = 0.0;
    for (int k = 30; k >= 1; --k) {
        cf = (double(k) * 0.5) / (ax + cf);
    }
    cf = 1.0 / (ax + cf);
    const double INV_SQRT_PI = 0.5641895835477562869480794515607726;
    double erfc_val = exp_double(-ax * ax) * INV_SQRT_PI * cf;
    return sign * (1.0 - erfc_val);
}

// Double-precision erfc, computed directly per range rather than via
// 1 - erf_double(x). For |x| large enough that erfc(x) is tiny, that
// subtraction cancels almost all of erf_double's precision (verified:
// erfc(5.0) via 1-erf was off by 1.5e-5 relative, erfc(5.9) by 54%) and,
// worse, erf_double saturates to exactly sign*1.0 for |x| >= 6.0, so
// 1.0 - 1.0 = 0.0 exactly even though erfc(6.0)~=2.15e-17 and
// erfc(10.0)~=2.09e-45 are both still representable Float64 magnitudes.
// Mirrors erf_double's range structure/coefficients above but returns each
// range's erfc value directly, with no upper saturation cutoff -- it decays
// naturally as exp_double(-x*x) underflows toward 0.
double erfc_double(double x) {
    if (x != x) return x;
    double sign = (x < 0.0) ? -1.0 : 1.0;
    double ax = (x < 0.0) ? -x : x;

    // No cancellation problem for |x| < 1.25 (erfc isn't tiny there).
    if (ax < 1.25) {
        return 1.0 - erf_double(x);
    }

    // Range 1.25 <= |x| < 2.857142857142857 -- same R/S rational as
    // erf_double's Range 3a above, but returning erfc_val directly instead
    // of 1 - erfc_val.
    if (ax < 2.857142857142857) {
        double s_ = 1.0 / (ax * ax);
        double ra0 = -9.86494403484714822705e-03;
        double ra1 = -6.93858572707181764372e-01;
        double ra2 = -1.05586262253232909814e+01;
        double ra3 = -6.23753324503260060396e+01;
        double ra4 = -1.62396669462573470355e+02;
        double ra5 = -1.84605092906711035994e+02;
        double ra6 = -8.12874355063065934246e+01;
        double ra7 = -9.81432934416256659757e+00;
        double sa1 =  1.96512716674392571292e+01;
        double sa2 =  1.37657754143519042600e+02;
        double sa3 =  4.34565877475229228821e+02;
        double sa4 =  6.45387271733267880336e+02;
        double sa5 =  4.29008140027567833386e+02;
        double sa6 =  1.08635005541779435134e+02;
        double sa7 =  6.57024977031928170135e+00;
        double sa8 = -6.04244152148580987438e-02;
        double R = ra0 + s_ * (ra1 + s_ * (ra2 + s_ * (ra3 + s_ * (ra4 + s_ * (ra5 + s_ * (ra6 + s_ * ra7))))));
        double S = 1.0 + s_ * (sa1 + s_ * (sa2 + s_ * (sa3 + s_ * (sa4 + s_ * (sa5 + s_ * (sa6 + s_ * (sa7 + s_ * sa8)))))));
        double erfc_val = exp_double(-ax * ax - 0.5625 + R / S) / ax;
        return (x < 0.0) ? (2.0 - erfc_val) : erfc_val;
    }

    // Range |x| >= 2.857142857142857: Lentz continued fraction for erfc
    // (same technique/coefficients as erf_double's Range 3b above, verified
    // to ~1e-15 relative error vs mpmath), used directly with no upper
    // cutoff so the result stays accurate (and needs no 1-erf cancellation)
    // all the way out to where exp_double(-x*x) itself underflows below
    // Float64's representable range.
    double cf = 0.0;
    for (int k = 30; k >= 1; --k) {
        cf = (double(k) * 0.5) / (ax + cf);
    }
    cf = 1.0 / (ax + cf);
    const double INV_SQRT_PI = 0.5641895835477562869480794515607726;
    double erfc_val = exp_double(-ax * ax) * INV_SQRT_PI * cf;
    return (x < 0.0) ? (2.0 - erfc_val) : erfc_val;
}

// Double-precision atan via range-reduction + Maclaurin polynomial.
// See kernels/trigonometric_f64.comp for derivation. Needed locally because
// GLSL atan is single-precision.
double atan_double(double x) {
    if (x != x) return x;
    const double PI = 3.141592653589793;

    double sign = 1.0;
    double ax = x;
    if (ax < 0.0) { sign = -1.0; ax = -ax; }

    bool inv = (ax > 1.0);
    if (inv) ax = 1.0 / ax;

    double add = 0.0;
    const double TAN_PI_8 = 0.41421356237309503;
    if (ax > TAN_PI_8) {
        add = PI * 0.25;
        ax = (ax - 1.0) / (ax + 1.0);
    }

    double x2 = ax * ax;
    double p = (1.0/15.0) - x2 * ((1.0/17.0) - x2 * ((1.0/19.0) - x2 * ((1.0/21.0) - x2 * (1.0/23.0))));
    p = (1.0/5.0) - x2 * ((1.0/7.0) - x2 * ((1.0/9.0) - x2 * ((1.0/11.0) - x2 * ((1.0/13.0) - x2 * p))));
    double r = ax - ax * x2 * (1.0/3.0 - x2 * p);

    double result = add + r;
    if (inv) result = PI * 0.5 - result;
    return sign * result;
}

// Double-precision atan2 with quadrant correction.
double atan2_double(double y, double x) {
    const double PI = 3.141592653589793;
    if (x > 0.0) return atan_double(y / x);
    if (x < 0.0) {
        if (y >= 0.0) return atan_double(y / x) + PI;
        return atan_double(y / x) - PI;
    }
    // x == 0
    if (y > 0.0) return PI * 0.5;
    if (y < 0.0) return -PI * 0.5;
    return 0.0;
}

// Exact double-precision 2^n for n an integer-valued double (ldexp scaling).
// Powers of two are exactly representable in binary64, and squaring 2.0
// stays exact, so binary exponentiation yields a bit-exact result with no
// Taylor/clamp error (unlike exp_double(n*ln2)). Mirrors the F32 exp2 path.
// Handles the full normal exponent range and saturates to ±inf / 0 like
// std::ldexp for out-of-range n.
double exp2_int_double(double n_dbl) {
    if (n_dbl != n_dbl) return n_dbl;  // NaN
    // Round toward nearest integer; ldexp's n is integral by contract, but
    // tolerate float representations like 3.0 exactly.
    double rn = round(n_dbl);
    // Saturate: 2^1024 overflows to +inf, 2^-1075 underflows to 0.
    if (rn > 1023.0) return 1.0 / 0.0;     // +inf
    if (rn < -1074.0) return 0.0;          // below smallest subnormal → 0
    int k = int(rn);
    // For deeply negative exponents the magnitude 2^|k| would overflow to
    // +inf (so 1/inf would wrongly give 0 in the subnormal range). Build the
    // scale directly as a positive power and, when negative, split into two
    // exact multiplications so the intermediate never overflows.
    if (k >= 0) {
        int abs_k = k;
        double pow2 = 1.0;
        double base = 2.0;
        while (abs_k > 0) {
            if ((abs_k & 1) != 0) pow2 *= base;
            base *= base;
            abs_k >>= 1;
        }
        return pow2;
    }
    // k < 0: result is 2^k. Compute 2^k = (2^k1) * (2^k2) with k1+k2 == k and
    // each |ki| <= 1022 so neither 2^(-ki) overflows; the product underflows
    // gracefully to subnormals/zero exactly as hardware multiply would.
    int neg = -k;            // neg in (0, 1074]
    int neg1 = neg / 2;
    int neg2 = neg - neg1;   // neg1 + neg2 == neg, both <= 537
    double s1 = 1.0;
    double s2 = 1.0;
    {
        int e = neg1; double base = 0.5;       // 0.5 = 2^-1
        while (e > 0) { if ((e & 1) != 0) s1 *= base; base *= base; e >>= 1; }
    }
    {
        int e = neg2; double base = 0.5;
        while (e > 0) { if ((e & 1) != 0) s2 *= base; base *= base; e >>= 1; }
    }
    return s1 * s2;
}

// Double-precision pow approximation
double pow_double(double base, double exp_val) {
    // Fast paths for common integer exponents keep x^n finite when x<0
    // (PowBackward of x^n feeds pow(x, n-1) back in).
    if (exp_val == 1.0) return base;
    if (exp_val == 0.0) return 1.0;
    if (exp_val == 2.0) return base * base;
    if (exp_val == 3.0) return base * base * base;
    if (exp_val == -1.0) return 1.0 / base;
    if (base < 0.0) {
        // Negative base: std::pow is finite only for integer exponents.
        // pow(-2,4)=16, pow(-2,3)=-8; non-integer exponent → NaN.
        double rexp = round(exp_val);
        if (rexp == exp_val) {
            // Integer exponent: compute |base|^exp, then restore sign for
            // odd exponents (sign = -1 when the integer exponent is odd).
            double mag = exp_double(exp_val * log_double(-base));
            // mod(round(exp_val), 2) is 0 for even, ±1 for odd integers.
            bool is_odd = (mod(rexp, 2.0) != 0.0);
            return is_odd ? -mag : mag;
        }
        return 0.0 / 0.0;  // NaN: negative base with non-integer exponent
    }
    if (base == 0.0) {
        // 0^positive = 0, 0^negative = +inf (exp_val==0 handled above).
        return (exp_val > 0.0) ? 0.0 : (1.0 / 0.0);
    }
    // pow(base, exp) = exp(exp * log(base))
    return exp_double(exp_val * log_double(base));
}

// Round-half-away-from-zero (double) to match std::round / CUDA/ROCm/OneAPI
// round semantics; GLSL's round() has implementation-defined 0.5 tie-break
// (unlike this file's other double helpers, this deliberately avoids the
// double-overload of sign() to sidestep any driver gaps in that overload).
double round_half_away_f64(double x) {
    if (x != x) return x;  // NaN
    if (x < 0.0) return -floor(-x + 0.5);
    return floor(x + 0.5);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    double val_a = a[idx];
    double val_b = b[idx];

    switch (params.op) {
        case 0: // add
            result[idx] = val_a + val_b;
            break;
        case 1: // sub
            result[idx] = val_a - val_b;
            break;
        case 2: // mul
            result[idx] = val_a * val_b;
            break;
        case 3: // div
            result[idx] = val_a / val_b;
            break;
        case 4: // sqrt (unary - uses a only)
            result[idx] = sqrt(val_a);
            break;
        case 5: // exp (unary)
            result[idx] = exp_double(val_a);
            break;
        case 6: // log (unary)
            result[idx] = log_double(val_a);
            break;
        case 7: // neg (unary)
            result[idx] = -val_a;
            break;
        case 8: // abs (unary)
            result[idx] = abs(val_a);
            break;
        case 9: // pow (unary with parameter)
            result[idx] = pow_double(val_a, params.param);
            break;
        case 10: // sign (unary)
            if (val_a < 0.0) {
                result[idx] = -1.0;
            } else if (val_a > 0.0) {
                result[idx] = 1.0;
            } else {
                result[idx] = 0.0;
            }
            break;
        case 11: // floor (unary)
            result[idx] = floor(val_a);
            break;
        case 12: // ceil (unary)
            result[idx] = ceil(val_a);
            break;
        case 13: // round (unary) — round-half-away-from-zero (matches
                 // std::round / CUDA/ROCm/OneAPI), not GLSL round()'s
                 // implementation-defined tie-break.
            result[idx] = round_half_away_f64(val_a);
            break;
        case 14: // trunc (unary)
            result[idx] = trunc(val_a);
            break;
        case 15: // reciprocal (unary)
            result[idx] = 1.0 / val_a;
            break;
        case 16: // log2 (unary)
            result[idx] = log_double(val_a) / 0.6931471805599453;
            break;
        case 17: // log10 (unary)
            result[idx] = log_double(val_a) / 2.302585092994046;
            break;
        case 18: // log1p (unary)
            result[idx] = log_double(1.0 + val_a);
            break;
        case 19: // exp2 (unary)
            result[idx] = exp_double(val_a * 0.6931471805599453);
            break;
        case 20: // expm1 (unary)
            result[idx] = exp_double(val_a) - 1.0;
            break;
        case 21: // erf (unary) — fdlibm double-precision rational
            result[idx] = erf_double(val_a);
            break;
        case 22: // erfc (unary) — direct computation, avoids 1-erf cancellation
            result[idx] = erfc_double(val_a);
            break;
        case 23: // atan2 (binary)
            result[idx] = atan2_double(val_a, val_b);
            break;
        case 24: // fmod (binary)
            result[idx] = val_a - trunc(val_a / val_b) * val_b;
            break;
        case 25: { // remainder (binary) - divisor-sign convention (matches
                   // CPU/CUDA/ROCm/OneAPI/Python/NumPy/PyTorch `%`/`remainder`:
                   // a - floor(a/b)*b), NOT IEEE round-to-nearest-even.
            double r = val_a - trunc(val_a / val_b) * val_b;
            if (r != 0.0 && ((r < 0.0) != (val_b < 0.0))) r += val_b;
            result[idx] = r;
            break;
        }
        case 26: // minimum (binary) — NaN-propagating (torch.minimum): NaN in
                 // either operand → NaN. GLSL min() suppresses NaN; propagate
                 // the NaN operand (no fast-math, so `x != x` is reliable).
            result[idx] = (val_a != val_a) ? val_a
                        : ((val_b != val_b) ? val_b : min(val_a, val_b));
            break;
        case 27: // maximum (binary) — NaN-propagating (torch.maximum).
            result[idx] = (val_a != val_a) ? val_a
                        : ((val_b != val_b) ? val_b : max(val_a, val_b));
            break;
        case 28: // rsqrt (unary)
            result[idx] = 1.0 / sqrt(val_a);
            break;
        case 29: // square (unary)
            result[idx] = val_a * val_a;
            break;
        case 30: // asinh (unary) - log(x + sqrt(x*x + 1))
            result[idx] = log_double(val_a + sqrt(val_a * val_a + 1.0));
            break;
        case 31: // acosh (unary) - log(x + sqrt(x*x - 1)). Explicit domain
                 // guard: for x<1, x*x-1 is negative and GLSL sqrt() is
                 // spec-undefined there (unlike the log_double/NaN-check
                 // pattern this file otherwise relies on); std::acosh
                 // deterministically returns NaN for x<1, so check up front
                 // instead of depending on sqrt(negative)'s driver behavior.
            result[idx] = (val_a != val_a) ? val_a
                : (val_a < 1.0) ? (0.0 / 0.0)
                : log_double(val_a + sqrt(val_a * val_a - 1.0));
            break;
        case 32: // atanh (unary) - 0.5 * log((1+x)/(1-x))
            result[idx] = 0.5 * log_double((1.0 + val_a) / (1.0 - val_a));
            break;
        case 33: // hypot (binary)
            result[idx] = sqrt(val_a * val_a + val_b * val_b);
            break;
        case 34: { // copysign (binary)
            double mag = abs(val_a);
            result[idx] = val_b < 0.0 ? -mag : mag;
            break;
        }
        case 35: { // F21: nextafter — true F64 bit manipulation
            // IEEE-754 binary64: sign bit (63), exp (62-52), mantissa (51-0).
            // Step semantics:
            //   nextafter(x, x) == x
            //   nextafter(x, y) where y > x → step toward +inf (lex-next bits if x≥0; lex-prev if x<0)
            //   nextafter(x, y) where y < x → step toward -inf (lex-prev bits if x≥0; lex-next if x<0)
            // NaN propagation: if either operand is NaN, return NaN.
            //
            // Special cases:
            //   nextafter(±0, +y) where y > 0 → smallest positive subnormal (0x0000000000000001)
            //   nextafter(±0, -y) where y < 0 → smallest negative subnormal (0x8000000000000001)
            //   nextafter(±0, 0)              → 0 (matches IEEE convention for distinct ±0)
            uint64_t bits_a = doubleBitsToUint64(val_a);
            uint64_t bits_b = doubleBitsToUint64(val_b);
            // NaN check: exp == 0x7ff and mantissa != 0 in either operand → result is NaN.
            bool a_is_nan = (val_a != val_a);
            bool b_is_nan = (val_b != val_b);
            if (a_is_nan || b_is_nan) {
                result[idx] = val_a + val_b;  // NaN (any arithmetic with NaN yields NaN)
                break;
            }
            if (val_a == val_b) {
                result[idx] = val_b;  // IEEE: nextafter(x, x) == x; for ±0 returns the sign of y
                break;
            }
            // If from is exactly ±0, jump to the smallest subnormal toward `to`.
            if (val_a == 0.0) {
                result[idx] = (val_b > 0.0)
                    ? uint64BitsToDouble(uint64_t(1))                          // +smallest_subnormal
                    : uint64BitsToDouble(uint64_t(0x8000000000000001UL));      // -smallest_subnormal
                break;
            }
            // Standard step: lex-next or lex-prev of the IEEE-754 magnitude bits.
            // For positive `from`, "step toward +inf" = bits_a + 1; "step toward -inf" = bits_a - 1.
            // For negative `from`, the magnitude bits live in the upper 63 bits and "step toward +inf"
            // (less negative) decreases magnitude → bits_a - 1; "step toward -inf" increases magnitude → bits_a + 1.
            bool toward_plus_inf = (val_b > val_a);
            uint64_t out_bits;
            if (val_a > 0.0) {
                out_bits = toward_plus_inf ? bits_a + uint64_t(1) : bits_a - uint64_t(1);
            } else {
                // val_a < 0.0 (val_a == 0 already handled above)
                out_bits = toward_plus_inf ? bits_a - uint64_t(1) : bits_a + uint64_t(1);
            }
            result[idx] = uint64BitsToDouble(out_bits);
            break;
        }
        case 38: { // igamma (binary) - series expansion
            double a = val_a;
            double x = val_b;
            if (x <= 0.0) { result[idx] = 0.0; break; }
            double term = 1.0 / a;
            double sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + double(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-10) break;
            }
            double lg = (a - 0.5) * log_double(a) - a + 0.9189385332046727;
            double res = exp_double(-x + a * log_double(x) - lg) * sum;
            result[idx] = clamp(res, 0.0, 1.0);
            break;
        }
        case 39: { // igammac (binary)
            double a = val_a;
            double x = val_b;
            if (x <= 0.0) { result[idx] = 1.0; break; }
            double term = 1.0 / a;
            double sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + double(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-10) break;
            }
            double lg = (a - 0.5) * log_double(a) - a + 0.9189385332046727;
            double res = exp_double(-x + a * log_double(x) - lg) * sum;
            result[idx] = 1.0 - clamp(res, 0.0, 1.0);
            break;
        }
        case 42: { // fmax (binary) - NaN-propagating max: fmax(NaN, x) = x
            double res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = max(val_a, val_b);
            result[idx] = res;
            break;
        }
        case 43: { // fmin (binary) - NaN-propagating min: fmin(NaN, x) = x
            double res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = min(val_a, val_b);
            result[idx] = res;
            break;
        }
        case 44: // deg2rad (unary): x * (PI / 180)
            result[idx] = val_a * 0.017453292519943295769;
            break;
        case 45: // rad2deg (unary): x * (180 / PI)
            result[idx] = val_a * 57.295779513082320876798;
            break;
        case 46: { // logit (unary): log(clamp(x,eps,1-eps) / (1 - clamp(x,eps,1-eps)))
            double eps = params.param > 0.0 ? params.param : 2.2250738585072014e-308;
            double clamped = clamp(val_a, eps, 1.0 - eps);
            result[idx] = log_double(clamped / (1.0 - clamped));
            break;
        }
        case 47: // float_power (binary): pow(a, b) in double
            result[idx] = exp_double(val_b * log_double(val_a));
            break;
        case 48: { // xlog1py (binary): x == 0 ? 0 : x * log(1+y)
            double res;
            if (val_a == 0.0) res = 0.0;
            else res = val_a * log_double(1.0 + val_b);
            result[idx] = res;
            break;
        }
        case 49: // ldexp (binary): x * 2^n (n is val_b as int) — exact power-of-two scaling
            result[idx] = val_a * exp2_int_double(val_b);
            break;
        case 50: // frac (unary): x - trunc(x) — sign-preserving (PyTorch convention)
            result[idx] = val_a - trunc(val_a);
            break;
        case 51: // log_sigmoid (unary): -log(1 + exp(-x))
            result[idx] = -log_double(1.0 + exp_double(-val_a));
            break;
    }
}
