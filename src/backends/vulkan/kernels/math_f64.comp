#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_ARB_gpu_shader_fp64 : enable

// Math operations with Float64 support (including extended math, binary math, min/max)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { double a[]; };
layout(binding = 1) buffer InputB { double b[]; };
layout(binding = 2) buffer Output { double result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 4=sqrt, 5=exp, 6=log, 7=neg, 8=abs, 9=pow, 10=sign, 11=floor, 12=ceil, 13=round, 14=trunc, 15=reciprocal, 16=log2, 17=log10, 18=log1p, 19=exp2, 20=expm1, 21=erf, 22=erfc, 23=atan2, 24=fmod, 25=remainder, 26=minimum, 27=maximum, 28=rsqrt, 29=square, 30=asinh, 31=acosh, 32=atanh, 33=hypot, 34=copysign, 35=nextafter, 38=igamma, 39=igammac
    double param;    // Parameter for operations like pow (exponent) - now double
} params;

// Double-precision exp approximation using range reduction with O(log(k)) exponentiation
double exp_double(double x) {
    // Handle NaN
    if (x != x) return x;

    // Clamp to avoid overflow/underflow
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;

    // Range reduction: exp(x) = 2^k * exp(r)
    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));

    // exp(r) via degree-13 Taylor polynomial (Horner's method)
    // |r| <= ln(2)/2, error bound < r^14/14! < 1e-19
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0 +
        r * (1.0/6227020800.0)))))))))))));


    // Compute 2^|k| using O(log(k)) binary exponentiation
    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) {
            pow2 *= base;
        }
        base *= base;
        abs_k >>= 1;
    }

    if (k >= 0) {
        return exp_r * pow2;
    } else {
        return exp_r / pow2;
    }
}

// Double-precision log using IEEE 754 bit extraction and minimax polynomial
// log(x) = log(2^exp * mantissa) = exp * ln(2) + log(mantissa)
double log_double(double x) {
    // Handle NaN
    if (x != x) return x;

    // x <= 0: return NaN for negative, -inf for zero
    if (x < 0.0LF) return 0.0LF / 0.0LF;  // NaN
    if (x == 0.0LF) return -1.0LF / 0.0LF; // -inf

    // +inf returns +inf
    if (x > 1.7976931348623157e308LF) return x;

    // x == 1 exact
    if (x == 1.0LF) return 0.0LF;

    // Extract IEEE 754 bits via unpackDouble2x32
    // Double layout: [63] sign | [62:52] exponent (11 bits) | [51:0] mantissa (52 bits)
    // unpackDouble2x32 returns uvec2(low32, high32)
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;

    // Extract biased exponent (bits 62:52 of the 64-bit value = bits 30:20 of high word)
    int biased_exp = int((hi >> 20u) & 0x7FFu);
    int exp_val = biased_exp - 1023;

    // Reconstruct normalized mantissa in [1, 2):
    // Set exponent bits to 1023 (bias) so value = 1.mantissa
    uint hi_normalized = (hi & 0x000FFFFFu) | 0x3FF00000u;
    double m = packDouble2x32(uvec2(lo, hi_normalized));

    // For better polynomial convergence, reduce to [sqrt(2)/2, sqrt(2))
    // If m >= sqrt(2), divide by 2 and increment exponent
    if (m > 1.4142135623730950488LF) {
        m *= 0.5LF;
        exp_val += 1;
    }

    // Compute log(m) where m is in [sqrt(2)/2, sqrt(2))
    // Let f = m - 1, so f is in [-0.2929, 0.4142]
    // Use the identity: log(1+f) = 2*atanh(s) where s = f/(2+f)
    // atanh(s) = s + s^3/3 + s^5/5 + ...
    // This converges faster because |s| < |f|/2
    double f = m - 1.0LF;
    double s = f / (2.0LF + f);
    double s2 = s * s;

    // Minimax polynomial for atanh(s)/s - 1 in terms of s^2
    // log(1+f) = 2*s*(1 + s2*P(s2))
    // Coefficients from Cephes / Sun fdlibm style, degree-9 approximation
    // P(z) = c1 + c2*z + c3*z^2 + c4*z^3 + c5*z^4 + c6*z^5 + c7*z^6
    // where z = s^2, approximating (atanh(s)/s - 1)/s^2
    double c1 = 0.6666666666666735130LF;   // 2/3
    double c2 = 0.3999999999940941908LF;   // 2/5
    double c3 = 0.2857142874366239149LF;   // 2/7
    double c4 = 0.2222219843214978396LF;   // ~2/9
    double c5 = 0.1818357216161805012LF;   // ~2/11
    double c6 = 0.1531383769920937332LF;   // ~2/13
    double c7 = 0.1479819860511658591LF;   // ~2/15 adjusted

    // Evaluate P(s2) using Horner's method
    double s4 = s2 * s2;
    // Group into even and odd powers for better ILP
    double t1 = c1 + c2 * s2 + c3 * s4;
    double s6 = s4 * s2;
    double t2 = c4 + c5 * s2 + c6 * s4 + c7 * s6;
    double R = t1 + t2 * s6;

    // log(1+f) = 2*atanh(s) = 2*s + s*s2*R where R uses fdlibm minimax coefficients
    // (R already contains the factor of 2 from the atanh series: c1≈2/3, c2≈2/5, etc.)
    double log_m = 2.0LF * s + s * s2 * R;

    // ln(2) split into high and low parts for precision
    double ln2_hi = 0.69314718055994530942LF;
    double ln2_lo = 2.3190468138462995584e-17LF;

    // log(x) = exp_val * ln(2) + log(m)
    double exp_dbl = double(exp_val);
    return exp_dbl * ln2_hi + (log_m + exp_dbl * ln2_lo);
}

// Double-precision pow approximation
double pow_double(double base, double exp_val) {
    if (base <= 0.0) {
        if (base == 0.0) return 0.0;
        return 0.0;  // Negative base with non-integer exp is undefined
    }
    // pow(base, exp) = exp(exp * log(base))
    return exp_double(exp_val * log_double(base));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    double val_a = a[idx];
    double val_b = b[idx];

    switch (params.op) {
        case 0: // add
            result[idx] = val_a + val_b;
            break;
        case 1: // sub
            result[idx] = val_a - val_b;
            break;
        case 2: // mul
            result[idx] = val_a * val_b;
            break;
        case 3: // div
            result[idx] = val_a / val_b;
            break;
        case 4: // sqrt (unary - uses a only)
            result[idx] = sqrt(val_a);
            break;
        case 5: // exp (unary)
            result[idx] = exp_double(val_a);
            break;
        case 6: // log (unary)
            result[idx] = log_double(val_a);
            break;
        case 7: // neg (unary)
            result[idx] = -val_a;
            break;
        case 8: // abs (unary)
            result[idx] = abs(val_a);
            break;
        case 9: // pow (unary with parameter)
            result[idx] = pow_double(val_a, params.param);
            break;
        case 10: // sign (unary)
            if (val_a < 0.0) {
                result[idx] = -1.0;
            } else if (val_a > 0.0) {
                result[idx] = 1.0;
            } else {
                result[idx] = 0.0;
            }
            break;
        case 11: // floor (unary)
            result[idx] = floor(val_a);
            break;
        case 12: // ceil (unary)
            result[idx] = ceil(val_a);
            break;
        case 13: // round (unary)
            result[idx] = round(val_a);
            break;
        case 14: // trunc (unary)
            result[idx] = trunc(val_a);
            break;
        case 15: // reciprocal (unary)
            result[idx] = 1.0 / val_a;
            break;
        case 16: // log2 (unary)
            result[idx] = log_double(val_a) / 0.6931471805599453;
            break;
        case 17: // log10 (unary)
            result[idx] = log_double(val_a) / 2.302585092994046;
            break;
        case 18: // log1p (unary)
            result[idx] = log_double(1.0 + val_a);
            break;
        case 19: // exp2 (unary)
            result[idx] = exp_double(val_a * 0.6931471805599453);
            break;
        case 20: // expm1 (unary)
            result[idx] = exp_double(val_a) - 1.0;
            break;
        case 21: { // erf (unary) - Abramowitz & Stegun approximation
            double x = val_a;
            double ax = abs(x);
            double t = 1.0 / (1.0 + 0.3275911 * ax);
            double y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp_double(-ax * ax);
            result[idx] = x < 0.0 ? -y : y;
            break;
        }
        case 22: { // erfc (unary)
            double x = val_a;
            double ax = abs(x);
            double t = 1.0 / (1.0 + 0.3275911 * ax);
            double y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp_double(-ax * ax);
            double erf_val = x < 0.0 ? -y : y;
            result[idx] = 1.0 - erf_val;
            break;
        }
        case 23: // atan2 (binary)
            // GLSL atan(y, x) computes atan2 — not available in f64, use float fallback
            result[idx] = double(atan(float(val_a), float(val_b)));
            break;
        case 24: // fmod (binary)
            result[idx] = val_a - trunc(val_a / val_b) * val_b;
            break;
        case 25: { // remainder (binary) - IEEE remainder
            double quot = val_a / val_b;
            double rounded = round(quot);
            result[idx] = val_a - rounded * val_b;
            break;
        }
        case 26: // minimum (binary)
            result[idx] = min(val_a, val_b);
            break;
        case 27: // maximum (binary)
            result[idx] = max(val_a, val_b);
            break;
        case 28: // rsqrt (unary)
            result[idx] = 1.0 / sqrt(val_a);
            break;
        case 29: // square (unary)
            result[idx] = val_a * val_a;
            break;
        case 30: // asinh (unary) - log(x + sqrt(x*x + 1))
            result[idx] = log_double(val_a + sqrt(val_a * val_a + 1.0));
            break;
        case 31: // acosh (unary) - log(x + sqrt(x*x - 1))
            result[idx] = log_double(val_a + sqrt(val_a * val_a - 1.0));
            break;
        case 32: // atanh (unary) - 0.5 * log((1+x)/(1-x))
            result[idx] = 0.5 * log_double((1.0 + val_a) / (1.0 - val_a));
            break;
        case 33: // hypot (binary)
            result[idx] = sqrt(val_a * val_a + val_b * val_b);
            break;
        case 34: { // copysign (binary)
            double mag = abs(val_a);
            result[idx] = val_b < 0.0 ? -mag : mag;
            break;
        }
        case 35: { // nextafter (binary) - use float fallback
            result[idx] = double(uintBitsToFloat(
                val_a == val_b ? floatBitsToUint(float(val_a)) :
                (float(val_a) >= 0.0 && float(val_b) > float(val_a)) ? floatBitsToUint(float(val_a)) + 1u :
                (float(val_a) > 0.0) ? floatBitsToUint(float(val_a)) - 1u :
                (float(val_a) < 0.0 && float(val_b) < float(val_a)) ? floatBitsToUint(float(val_a)) + 1u :
                floatBitsToUint(float(val_a)) - 1u
            ));
            break;
        }
        case 38: { // igamma (binary) - series expansion
            double a = val_a;
            double x = val_b;
            if (x <= 0.0) { result[idx] = 0.0; break; }
            double term = 1.0 / a;
            double sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + double(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-10) break;
            }
            double lg = (a - 0.5) * log_double(a) - a + 0.9189385332046727;
            double res = exp_double(-x + a * log_double(x) - lg) * sum;
            result[idx] = clamp(res, 0.0, 1.0);
            break;
        }
        case 39: { // igammac (binary)
            double a = val_a;
            double x = val_b;
            if (x <= 0.0) { result[idx] = 1.0; break; }
            double term = 1.0 / a;
            double sum = term;
            for (int nn = 1; nn < 100; ++nn) {
                term *= x / (a + double(nn));
                sum += term;
                if (abs(term) < abs(sum) * 1e-10) break;
            }
            double lg = (a - 0.5) * log_double(a) - a + 0.9189385332046727;
            double res = exp_double(-x + a * log_double(x) - lg) * sum;
            result[idx] = 1.0 - clamp(res, 0.0, 1.0);
            break;
        }
        case 42: { // fmax (binary) - NaN-propagating max: fmax(NaN, x) = x
            double res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = max(val_a, val_b);
            result[idx] = res;
            break;
        }
        case 43: { // fmin (binary) - NaN-propagating min: fmin(NaN, x) = x
            double res;
            if (isnan(val_a)) res = val_b;
            else if (isnan(val_b)) res = val_a;
            else res = min(val_a, val_b);
            result[idx] = res;
            break;
        }
    }
}
