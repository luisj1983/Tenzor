#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_ARB_gpu_shader_fp64 : enable

// Math operations with Float64 support
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputA { double a[]; };
layout(binding = 1) buffer InputB { double b[]; };
layout(binding = 2) buffer Output { double result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=add, 1=sub, 2=mul, 3=div, 4=sqrt, 5=exp, 6=log, 7=neg, 8=abs, 9=pow, 10=sign, 11=floor, 12=ceil, 13=round, 14=trunc, 15=reciprocal
    double param;    // Parameter for operations like pow (exponent) - now double
} params;

// Double-precision exp approximation using the identity: exp(x) = exp(x/2)^2
// This provides better precision than casting to float
double exp_double(double x) {
    // For large |x|, clamp to avoid overflow/underflow
    if (x > 709.0) return 1.0e308;  // near max double
    if (x < -745.0) return 0.0;

    // Use range reduction: exp(x) = 2^k * exp(r) where x = k*ln(2) + r
    // For values in reasonable range, use float exp with correction
    double ln2 = 0.6931471805599453;
    double k = floor(x / ln2);
    double r = x - k * ln2;

    // exp(r) where |r| < ln(2) ~ 0.693, use float exp which is accurate enough
    double exp_r = double(exp(float(r)));

    // Multiply by 2^k using ldexp-like operation
    // 2^k = exp(k * ln(2))
    if (k >= 0.0) {
        for (int i = 0; i < int(k); i++) {
            exp_r *= 2.0;
        }
    } else {
        for (int i = 0; i < int(-k); i++) {
            exp_r *= 0.5;
        }
    }
    return exp_r;
}

// Double-precision log approximation
// log(x) = log(m * 2^e) = log(m) + e * log(2)
double log_double(double x) {
    if (x <= 0.0) return -1.0 / 0.0;  // -inf for x <= 0
    if (x == 1.0) return 0.0;

    // For values that fit in float range with good precision, use float log
    // Float has ~7 decimal digits precision, sufficient for values 1e-38 to 1e38
    if (x >= 1.0e-30 && x <= 1.0e30) {
        return double(log(float(x)));
    }

    // For extreme values, use range reduction
    double ln2 = 0.6931471805599453;
    int e = 0;
    double m = x;

    // Normalize to range [1, 2)
    while (m >= 2.0) { m *= 0.5; e++; }
    while (m < 1.0) { m *= 2.0; e--; }

    // Now m is in [1, 2), compute log(m) using float
    double log_m = double(log(float(m)));

    return log_m + double(e) * ln2;
}

// Double-precision pow approximation
double pow_double(double base, double exp_val) {
    if (base <= 0.0) {
        if (base == 0.0) return 0.0;
        return 0.0;  // Negative base with non-integer exp is undefined
    }
    // pow(base, exp) = exp(exp * log(base))
    return exp_double(exp_val * log_double(base));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    double val_a = a[idx];
    double val_b = b[idx];

    switch (params.op) {
        case 0: // add
            result[idx] = val_a + val_b;
            break;
        case 1: // sub
            result[idx] = val_a - val_b;
            break;
        case 2: // mul
            result[idx] = val_a * val_b;
            break;
        case 3: // div
            result[idx] = val_a / val_b;
            break;
        case 4: // sqrt (unary - uses a only)
            result[idx] = sqrt(val_a);
            break;
        case 5: // exp (unary)
            result[idx] = exp_double(val_a);
            break;
        case 6: // log (unary)
            result[idx] = log_double(val_a);
            break;
        case 7: // neg (unary)
            result[idx] = -val_a;
            break;
        case 8: // abs (unary)
            result[idx] = abs(val_a);
            break;
        case 9: // pow (unary with parameter)
            result[idx] = pow_double(val_a, params.param);
            break;
        case 10: // sign (unary)
            if (val_a < 0.0) {
                result[idx] = -1.0;
            } else if (val_a > 0.0) {
                result[idx] = 1.0;
            } else {
                result[idx] = 0.0;
            }
            break;
        case 11: // floor (unary)
            result[idx] = floor(val_a);
            break;
        case 12: // ceil (unary)
            result[idx] = ceil(val_a);
            break;
        case 13: // round (unary)
            result[idx] = round(val_a);
            break;
        case 14: // trunc (unary)
            result[idx] = trunc(val_a);
            break;
        case 15: // reciprocal (unary)
            result[idx] = 1.0 / val_a;
            break;
    }
}
