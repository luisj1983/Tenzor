#version 450

// FractionalMaxPool2d Backward — scatter gradients using saved indices.
// Each invocation processes one output gradient and atomically adds it
// to the corresponding input gradient position using CAS loop for float atomics.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer GradOutput { float grad_out_data[]; }; // [N, C, out_h, out_w]
layout(binding = 1) readonly buffer Indices    { int   indices_data[]; };   // [N, C, out_h, out_w]
layout(binding = 2)          buffer GradInput  { uint  grad_in_data[]; };   // [N, C, H, W] as uint for atomics

layout(push_constant) uniform PushConstants {
    uint N;
    uint C;
    uint H_W;           // H * W (input spatial size)
    uint out_spatial;    // out_h * out_w
    uint total_output;   // N * C * out_h * out_w
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_output) return;

    uint channel_idx = idx / params.out_spatial;
    uint base_in = channel_idx * params.H_W;

    int max_idx = indices_data[idx];
    uint target = base_in + uint(max_idx);

    float grad_val = grad_out_data[idx];

    // Atomic float add via compare-and-swap loop
    uint expected = grad_in_data[target];
    uint desired;
    while (true) {
        desired = floatBitsToUint(uintBitsToFloat(expected) + grad_val);
        uint actual = atomicCompSwap(grad_in_data[target], expected, desired);
        if (actual == expected) break;
        expected = actual;
    }
}
