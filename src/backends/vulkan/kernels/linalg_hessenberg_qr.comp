#version 450

// Single Francis implicit double-shift QR step on upper Hessenberg matrix.
// Operates on the active unreduced block [active_start, active_end] of H.
// Computes shifts from the bottom-right 2x2 block, then chases the bulge.
// One workgroup (256 threads), thread 0 does the serial bulge chase.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer MatrixH { float H[]; };           // Upper Hessenberg n×n
layout(set = 0, binding = 1) buffer ShiftBuf { float shifts[]; };      // Output: deflation info
layout(set = 0, binding = 2) buffer ActiveStartBuf { uint a_start[]; };
layout(set = 0, binding = 3) buffer ActiveEndBuf   { uint a_end[]; };

layout(push_constant) uniform PushConstants {
    uint n;
};

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (tid != 0) return;

    uint batch_idx = gl_WorkGroupID.x;
    uint lo = a_start[batch_idx];
    uint hi = a_end[batch_idx];
    uint base = batch_idx * n * n;

    if (hi <= lo) return;
    if (hi - lo == 1) {
        // 2x2 block — just record shifts, no QR step needed
        shifts[batch_idx * 4] = H[base + lo * n + lo];
        shifts[batch_idx * 4 + 1] = H[base + hi * n + hi];
        return;
    }

    // Compute implicit double shift from bottom-right 2x2 block
    float a = H[base + (hi - 1) * n + (hi - 1)];
    float b = H[base + (hi - 1) * n + hi];
    float c = H[base + hi * n + (hi - 1)];
    float d = H[base + hi * n + hi];

    float s = a + d;  // trace of 2x2
    float t = a * d - b * c;  // det of 2x2

    // First column of (H - s1*I)(H - s2*I) = H^2 - s*H + t*I
    float h00 = H[base + lo * n + lo];
    float h10 = H[base + (lo + 1) * n + lo];
    float h01 = H[base + lo * n + (lo + 1)];
    float h11 = H[base + (lo + 1) * n + (lo + 1)];

    float x = h00 * h00 + h01 * h10 - s * h00 + t;
    float y = h10 * (h00 + h11 - s);
    float z = (lo + 2 <= hi) ? h10 * H[base + (lo + 2) * n + (lo + 1)] : 0.0;

    // Chase the bulge
    for (uint k = lo; k < hi - 1; k++) {
        // 3x3 (or 2x2 at end) Householder to zero y, z
        uint nr = (k + 2 <= hi - 1) ? 3 : 2;

        float norm_v;
        if (nr == 3) {
            norm_v = sqrt(x * x + y * y + z * z);
        } else {
            norm_v = sqrt(x * x + y * y);
        }

        if (norm_v < 1e-30) {
            if (k + 1 <= hi) x = H[base + (k + 1) * n + k];
            y = (k + 2 <= hi) ? H[base + (k + 2) * n + k] : 0.0;
            z = (k + 3 <= hi) ? H[base + (k + 3) * n + k] : 0.0;
            continue;
        }

        float alpha_h = -sign(x) * norm_v;
        float v0 = x - alpha_h;
        float v1 = y;
        float v2 = z;
        float v_sq = v0 * v0 + v1 * v1;
        if (nr == 3) v_sq += v2 * v2;
        if (v_sq < 1e-30) {
            if (k + 1 <= hi) x = H[base + (k + 1) * n + k];
            y = (k + 2 <= hi) ? H[base + (k + 2) * n + k] : 0.0;
            z = (k + 3 <= hi) ? H[base + (k + 3) * n + k] : 0.0;
            continue;
        }
        float tau_h = 2.0 / v_sq;

        // Apply from left: H = (I - tau*v*v^T) * H
        uint j_start = (k > lo) ? k - 1 : k;
        for (uint j = j_start; j < n; j++) {
            float dot = v0 * H[base + k * n + j] + v1 * H[base + (k + 1) * n + j];
            if (nr == 3) dot += v2 * H[base + (k + 2) * n + j];
            dot *= tau_h;

            H[base + k * n + j] -= v0 * dot;
            H[base + (k + 1) * n + j] -= v1 * dot;
            if (nr == 3) H[base + (k + 2) * n + j] -= v2 * dot;
        }

        // Apply from right: H = H * (I - tau*v*v^T)
        uint i_end = min(k + 4, hi + 1);
        if (i_end > n) i_end = n;
        for (uint i = 0; i < i_end; i++) {
            float dot = v0 * H[base + i * n + k] + v1 * H[base + i * n + (k + 1)];
            if (nr == 3) dot += v2 * H[base + i * n + (k + 2)];
            dot *= tau_h;

            H[base + i * n + k] -= v0 * dot;
            H[base + i * n + (k + 1)] -= v1 * dot;
            if (nr == 3) H[base + i * n + (k + 2)] -= v2 * dot;
        }

        // Zero out entries below subdiagonal
        if (k > lo) {
            H[base + (k + 1) * n + (k - 1)] = 0.0;
            if (nr == 3) H[base + (k + 2) * n + (k - 1)] = 0.0;
        }

        // Next iteration values
        x = H[base + (k + 1) * n + k];
        y = (k + 2 <= hi) ? H[base + (k + 2) * n + k] : 0.0;
        z = (k + 3 <= hi) ? H[base + (k + 3) * n + k] : 0.0;
    }

    // Final 2x2 rotation at bottom
    if (hi >= 1) {
        uint k = hi - 1;
        float norm_v = sqrt(x * x + y * y);
        if (norm_v > 1e-30) {
            float cos_v = x / norm_v;
            float sin_v = -y / norm_v;

            for (uint j = k; j < n; j++) {
                float tmp = cos_v * H[base + k * n + j] - sin_v * H[base + (k + 1) * n + j];
                H[base + (k + 1) * n + j] = sin_v * H[base + k * n + j] + cos_v * H[base + (k + 1) * n + j];
                H[base + k * n + j] = tmp;
            }
            for (uint i = 0; i <= min(k + 2, hi); i++) {
                float tmp = cos_v * H[base + i * n + k] - sin_v * H[base + i * n + (k + 1)];
                H[base + i * n + (k + 1)] = sin_v * H[base + i * n + k] + cos_v * H[base + i * n + (k + 1)];
                H[base + i * n + k] = tmp;
            }
        }
    }

    // Report deflation status: check if any subdiagonal entries became negligible
    uint deflated = 0;
    for (uint i = hi; i > lo; i--) {
        float tst = abs(H[base + (i - 1) * n + (i - 1)]) + abs(H[base + i * n + i]);
        if (tst == 0.0) tst = 1.0;
        if (abs(H[base + i * n + (i - 1)]) < 1e-7 * tst) {
            H[base + i * n + (i - 1)] = 0.0;
            deflated = i;
            break;
        }
    }
    shifts[batch_idx * 4] = float(deflated);
    shifts[batch_idx * 4 + 1] = float(lo);
    shifts[batch_idx * 4 + 2] = float(hi);
}
