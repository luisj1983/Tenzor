#version 450

// SVD via one-sided Jacobi method for small matrices (<= 32x32)
// Output: U (binding 1), S (binding 2), Vt (binding 3)

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf { float data_in[]; };
layout(set = 0, binding = 1) buffer UBuf     { float data_u[];  };
layout(set = 0, binding = 2) buffer SBuf     { float data_s[];  };
layout(set = 0, binding = 3) buffer VtBuf    { float data_vt[]; };

layout(push_constant) uniform PushConstants {
    uint m;       // rows
    uint n_cols;  // columns
    uint batch;
    uint full_matrices; // 0=reduced, 1=full
};

shared float U[32][32];
shared float V[32][32];
shared float converged;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (batch_idx >= batch) return;

    uint mat_offset_mn = batch_idx * m * n_cols;
    uint k = min(m, n_cols);

    // Load U = A
    for (uint row = 0; row < m; row++) {
        if (tid < n_cols) {
            U[row][tid] = data_in[mat_offset_mn + row * n_cols + tid];
        }
    }

    // V = I
    for (uint row = 0; row < n_cols; row++) {
        if (tid < n_cols) {
            V[row][tid] = (row == tid) ? 1.0 : 0.0;
        }
    }
    barrier();

    // Jacobi sweeps
    for (uint sweep = 0; sweep < 30; sweep++) {
        if (tid == 0) converged = 1.0;
        barrier();

        // For each column pair (p, q)
        for (uint p = 0; p < n_cols; p++) {
            for (uint q = p + 1; q < n_cols; q++) {
                // Thread 0: compute Jacobi rotation
                if (tid == 0) {
                    // Compute Gram matrix elements: a = U_p^T U_p, b = U_q^T U_q, d = U_p^T U_q
                    float a = 0.0, b = 0.0, d = 0.0;
                    for (uint i = 0; i < m; i++) {
                        a += U[i][p] * U[i][p];
                        b += U[i][q] * U[i][q];
                        d += U[i][p] * U[i][q];
                    }

                    if (abs(d) > 1e-10 * sqrt(a * b)) {
                        converged = 0.0;
                        float zeta = (b - a) / (2.0 * d);
                        float t = sign(zeta) / (abs(zeta) + sqrt(1.0 + zeta * zeta));
                        float c = 1.0 / sqrt(1.0 + t * t);
                        float s = t * c;

                        // Rotate columns of U
                        for (uint i = 0; i < m; i++) {
                            float up = U[i][p], uq = U[i][q];
                            U[i][p] = c * up - s * uq;
                            U[i][q] = s * up + c * uq;
                        }
                        // Rotate columns of V
                        for (uint i = 0; i < n_cols; i++) {
                            float vp = V[i][p], vq = V[i][q];
                            V[i][p] = c * vp - s * vq;
                            V[i][q] = s * vp + c * vq;
                        }
                    }
                }
                barrier();
            }
        }

        if (converged > 0.5) break;
        barrier();
    }

    // Extract singular values (column norms of U) and normalize U
    if (tid < k) {
        float norm = 0.0;
        for (uint i = 0; i < m; i++) {
            norm += U[i][tid] * U[i][tid];
        }
        norm = sqrt(norm);
        data_s[batch_idx * k + tid] = norm;

        if (norm > 1e-30) {
            for (uint i = 0; i < m; i++) {
                U[i][tid] /= norm;
            }
        }
    }
    barrier();

    // Write U
    for (uint row = 0; row < m; row++) {
        if (tid < k) {
            data_u[mat_offset_mn + row * k + tid] = U[row][tid];
        }
    }

    // Write Vt (transpose of V)
    uint vt_offset = batch_idx * n_cols * n_cols;
    for (uint row = 0; row < n_cols; row++) {
        if (tid < n_cols) {
            data_vt[vt_offset + tid * n_cols + row] = V[row][tid];
        }
    }
}
