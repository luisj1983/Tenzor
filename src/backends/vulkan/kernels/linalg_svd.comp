#version 450

// SVD via one-sided Jacobi method for small matrices (<= 32x32)
// Output: U (binding 1), S (binding 2), Vt (binding 3)
// S is sorted descending, with U columns and Vt rows permuted to match.

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf { float data_in[]; };
layout(set = 0, binding = 1) buffer UBuf     { float data_u[];  };
layout(set = 0, binding = 2) buffer SBuf     { float data_s[];  };
layout(set = 0, binding = 3) buffer VtBuf    { float data_vt[]; };

layout(push_constant) uniform PushConstants {
    uint m;       // rows
    uint n_cols;  // columns
    uint batch;
    uint full_matrices; // 0=reduced, 1=full
};

shared float U[32][32];
shared float V[32][32];
shared float s_vals[32];
shared float converged;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (batch_idx >= batch) return;

    uint mat_offset_mn = batch_idx * m * n_cols;
    uint k = min(m, n_cols);

    // Load U = A (row-major read)
    for (uint row = 0; row < m; row++) {
        if (tid < n_cols) {
            U[row][tid] = data_in[mat_offset_mn + row * n_cols + tid];
        }
    }

    // V = I
    for (uint row = 0; row < n_cols; row++) {
        if (tid < n_cols) {
            V[row][tid] = (row == tid) ? 1.0 : 0.0;
        }
    }
    barrier();

    // Jacobi sweeps
    for (uint sweep = 0; sweep < 30; sweep++) {
        if (tid == 0) converged = 1.0;
        barrier();

        for (uint p = 0; p < n_cols; p++) {
            for (uint q = p + 1; q < n_cols; q++) {
                if (tid == 0) {
                    float a = 0.0, b = 0.0, d = 0.0;
                    for (uint i = 0; i < m; i++) {
                        a += U[i][p] * U[i][p];
                        b += U[i][q] * U[i][q];
                        d += U[i][p] * U[i][q];
                    }
                    if (abs(d) > 1e-10 * sqrt(a * b)) {
                        converged = 0.0;
                        float zeta = (b - a) / (2.0 * d);
                        float t = sign(zeta) / (abs(zeta) + sqrt(1.0 + zeta * zeta));
                        float c = 1.0 / sqrt(1.0 + t * t);
                        float s = t * c;
                        for (uint i = 0; i < m; i++) {
                            float up = U[i][p], uq = U[i][q];
                            U[i][p] = c * up - s * uq;
                            U[i][q] = s * up + c * uq;
                        }
                        for (uint i = 0; i < n_cols; i++) {
                            float vp = V[i][p], vq = V[i][q];
                            V[i][p] = c * vp - s * vq;
                            V[i][q] = s * vp + c * vq;
                        }
                    }
                }
                barrier();
            }
        }

        if (converged > 0.5) break;
        barrier();
    }

    // Compute singular values (column norms of U) and normalize U.
    if (tid < k) {
        float norm = 0.0;
        for (uint i = 0; i < m; i++) norm += U[i][tid] * U[i][tid];
        norm = sqrt(norm);
        s_vals[tid] = norm;
        if (norm > 1e-30) {
            for (uint i = 0; i < m; i++) U[i][tid] /= norm;
        }
    }
    barrier();

    // Sort s_vals descending and apply the same permutation to U columns and
    // V columns (thread 0 does a simple selection sort — n ≤ 32 so cost is
    // negligible). When full_matrices is requested and m > k, also orthonormally
    // complete U's trailing columns (k..m-1) so U is a full m×m orthogonal basis
    // matching the CPU/CUDA reference (LAPACK jobz 'A').
    if (tid == 0) {
        for (uint i = 0; i < k; i++) {
            uint maxIdx = i;
            float maxVal = s_vals[i];
            for (uint j = i + 1; j < k; j++) {
                if (s_vals[j] > maxVal) { maxVal = s_vals[j]; maxIdx = j; }
            }
            if (maxIdx != i) {
                float tmp_s = s_vals[i]; s_vals[i] = s_vals[maxIdx]; s_vals[maxIdx] = tmp_s;
                for (uint r = 0; r < m; r++) {
                    float t = U[r][i]; U[r][i] = U[r][maxIdx]; U[r][maxIdx] = t;
                }
                for (uint r = 0; r < n_cols; r++) {
                    float t = V[r][i]; V[r][i] = V[r][maxIdx]; V[r][maxIdx] = t;
                }
            }
        }

        // Orthonormal completion of U from m×k to m×m (full mode, tall matrices).
        if (full_matrices == 1u && m > k) {
            uint filled = k;            // number of orthonormal columns so far
            // Try each canonical basis vector e_cand and Gram-Schmidt it against
            // the already-accepted columns; keep it if a non-degenerate remainder
            // survives. m ≤ 32, so at most m candidates are needed.
            for (uint cand = 0; cand < m && filled < m; cand++) {
                // w = e_cand
                float w[32];
                for (uint r = 0; r < m; r++) w[r] = (r == cand) ? 1.0 : 0.0;
                // Subtract projections onto existing columns 0..filled-1.
                for (uint col = 0; col < filled; col++) {
                    float dot = 0.0;
                    for (uint r = 0; r < m; r++) dot += w[r] * U[r][col];
                    for (uint r = 0; r < m; r++) w[r] -= dot * U[r][col];
                }
                float nrm = 0.0;
                for (uint r = 0; r < m; r++) nrm += w[r] * w[r];
                nrm = sqrt(nrm);
                if (nrm > 1e-6) {
                    float inv = 1.0 / nrm;
                    for (uint r = 0; r < m; r++) U[r][filled] = w[r] * inv;
                    filled++;
                }
            }
        }
    }
    barrier();

    // Write S (size k per batch).
    if (tid < k) {
        data_s[batch_idx * k + tid] = s_vals[tid];
    }

    // U column count: m in full mode, k in reduced mode.
    uint u_cols = (full_matrices == 1u) ? m : k;
    // Vt row count: n in full mode (V is full n×n), k in reduced mode.
    uint vt_rows = (full_matrices == 1u) ? n_cols : k;

    // Write U (shape m × u_cols). Batch stride uses m*u_cols.
    uint u_offset = batch_idx * m * u_cols;
    for (uint row = 0; row < m; row++) {
        if (tid < u_cols) {
            data_u[u_offset + row * u_cols + tid] = U[row][tid];
        }
    }

    // Write Vt (shape vt_rows × n — V^T). V^T[i,j] = V[j,i].
    uint vt_offset = batch_idx * vt_rows * n_cols;
    for (uint row = 0; row < vt_rows; row++) {
        if (tid < n_cols) {
            data_vt[vt_offset + row * n_cols + tid] = V[tid][row];
        }
    }
}
