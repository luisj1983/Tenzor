#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// IndexAdd (Int64): atomically accumulates int64 source values into output
// along a dimension via a 64-bit CAS loop, so Int64 accumulation keeps its full
// 64-bit range instead of being narrowed/rounded through Int32 (which silently
// truncates magnitudes > 2^31-1).
// output[(o * dim_size + index[k]) * inner + j] += source[(o * idx_n + k) * inner + j]
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint64_t out_data[]; };   // uint64_t for CAS atomics
layout(binding = 1) buffer Source { int64_t  src_data[]; };   // Source values to add
layout(binding = 2) buffer Index  { int      idx_data[]; };   // 1-D index tensor (Int32)

layout(push_constant) uniform PushConstants {
    uint outer;         // Product of dims before target dim
    uint dim_size;      // Size of target dim in output
    uint idx_n;         // Number of indices
    uint inner;         // Product of dims after target dim
} params;

// int64 and uint64 share the same bit layout; reinterpret freely.
void atomicAddI64(uint pos, int64_t val) {
    uint64_t old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        int64_t old_val = int64_t(old_bits);
        uint64_t new_bits = uint64_t(old_val + val);
        uint64_t result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total = params.outer * params.idx_n * params.inner;
    if (tid >= total) return;

    uint j = tid % params.inner;
    uint k = (tid / params.inner) % params.idx_n;
    uint o = tid / (params.inner * params.idx_n);

    int dest_idx = idx_data[k];
    if (dest_idx < 0) dest_idx += int(params.dim_size);  // wrap negatives (match CPU/OneAPI)
    if (dest_idx < 0 || dest_idx >= int(params.dim_size)) return;

    uint out_pos = (o * params.dim_size + uint(dest_idx)) * params.inner + j;
    uint src_pos = (o * params.idx_n + k) * params.inner + j;

    atomicAddI64(out_pos, src_data[src_pos]);
}
