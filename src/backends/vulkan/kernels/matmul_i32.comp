#version 450

// Matrix multiplication with tiling for int32
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer MatrixA { int a[]; };
layout(binding = 1) buffer MatrixB { int b[]; };
layout(binding = 2) buffer MatrixC { int c[]; };

layout(push_constant) uniform PushConstants {
    uint M;  // rows of A
    uint N;  // cols of B
    uint K;  // cols of A / rows of B
} params;

shared int tileA[16][16];
shared int tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    int sum = 0;

    // Tile-based computation
    uint num_tiles = (params.K + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from A
        uint a_row = row;
        uint a_col = t * 16 + local_col;
        if (a_row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = a[a_row * params.K + a_col];
        } else {
            tileA[local_row][local_col] = 0;
        }

        // Load tile from B
        uint b_row = t * 16 + local_row;
        uint b_col = col;
        if (b_row < params.K && b_col < params.N) {
            tileB[local_row][local_col] = b[b_row * params.N + b_col];
        } else {
            tileB[local_row][local_col] = 0;
        }

        barrier();

        // Compute partial dot product
        for (uint k = 0; k < 16; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    // Write result
    if (row < params.M && col < params.N) {
        c[row * params.N + col] = sum;
    }
}
