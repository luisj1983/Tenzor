#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Eye for Float64: generate identity matrix
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.rows * params.cols;
    if (idx >= total) return;

    uint row = idx / params.cols;
    uint col = idx % params.cols;
    output_data[idx] = (row == col) ? 1.0lf : 0.0lf;
}
