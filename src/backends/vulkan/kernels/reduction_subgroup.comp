#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

// Reduction operations with subgroup optimization: sum, mean, max, min
// Uses subgroup (warp-level) operations for the final reduction steps,
// eliminating shared memory barriers for threads within the same subgroup.
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements in input
    uint reduce_size;    // Size of dimension to reduce
    uint outer_size;     // Number of output elements
    uint inner_size;     // Product of dimensions after reduction dim
    uint op;             // 0=sum, 1=mean, 2=max, 3=min
} params;

// NOTE on subgroup size:
//   This shader does NOT assume a fixed/compile-time subgroup size. The host
//   dispatch only overrides specialization constant 0 (WORKGROUP_SIZE) and never
//   sets a subgroup-size constant, and the real hardware subgroup size varies per
//   device (8/16/32/64...). Relying on a hard-coded 32 silently under-counts sums
//   on devices whose subgroupSize < 32 (the assumed "single subgroup" of 32 lanes
//   would actually span multiple hardware subgroups, so subgroupAdd would only
//   reduce within each real subgroup). Instead we use the runtime subgroup
//   built-ins (gl_SubgroupID / gl_NumSubgroups / gl_SubgroupInvocationID), exactly
//   like reduction_tree.comp: each subgroup reduces internally, writes one partial
//   to shared memory, then a shared-memory tree reduces the per-subgroup partials.
//   This is correct for any hardware subgroup size.

// WORKGROUP_SIZE is the maximum number of subgroups (subgroupSize >= 1), so this
// is always large enough to hold one partial per subgroup.
shared float shared_data[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint output_idx = gl_WorkGroupID.x;

    if (output_idx >= params.outer_size) {
        return;
    }

    // Initialize accumulator based on operation
    float accum;
    if (params.op == 2) { // max
        accum = -1.0 / 0.0; // -infinity
    } else if (params.op == 3) { // min
        accum = 1.0 / 0.0; // +infinity
    } else {
        accum = 0.0;
    }

    uint outer_idx = output_idx / params.inner_size;
    uint inner_idx = output_idx % params.inner_size;
    uint base_idx = outer_idx * params.reduce_size * params.inner_size + inner_idx;

    // Each thread processes multiple elements along the reduction dimension
    for (uint i = tid; i < params.reduce_size; i += WORKGROUP_SIZE) {
        uint idx = base_idx + i * params.inner_size;
        if (idx < params.n) {
            float val = input_data[idx];
            switch (params.op) {
                case 0: // sum
                case 1: // mean
                    accum += val;
                    break;
                case 2: // max
                    accum = max(accum, val);
                    break;
                case 3: // min
                    accum = min(accum, val);
                    break;
            }
        }
    }

    // Step 1: reduce each thread's accumulator within its hardware subgroup.
    // This uses the real runtime subgroup size, so it is correct on every device.
    float subgroup_result;
    switch (params.op) {
        case 0:
        case 1:
            subgroup_result = subgroupAdd(accum);
            break;
        case 2:
            subgroup_result = subgroupMax(accum);
            break;
        case 3:
            subgroup_result = subgroupMin(accum);
            break;
        default:
            subgroup_result = accum;
            break;
    }

    // Step 2: each subgroup writes its single partial result to shared memory.
    if (gl_SubgroupInvocationID == 0u) {
        shared_data[gl_SubgroupID] = subgroup_result;
    }
    barrier();

    // Step 3: shared-memory tree reduction over the per-subgroup partials.
    // `count` is the number of live partials this round; `stride` folds the upper
    // half onto the lower half. Using (count+1)/2 makes this correct for a
    // non-power-of-two number of subgroups (the lone middle element when count is
    // odd is simply carried forward, never double-counted).
    for (uint count = gl_NumSubgroups; count > 1u; count = (count + 1u) / 2u) {
        uint stride = (count + 1u) / 2u;
        if (tid + stride < count) {
            switch (params.op) {
                case 0:
                case 1:
                    shared_data[tid] += shared_data[tid + stride];
                    break;
                case 2:
                    shared_data[tid] = max(shared_data[tid], shared_data[tid + stride]);
                    break;
                case 3:
                    shared_data[tid] = min(shared_data[tid], shared_data[tid + stride]);
                    break;
            }
        }
        barrier();
    }

    // Step 4: thread 0 holds the fully-reduced value.
    if (tid == 0u) {
        float val = shared_data[0];
        if (params.op == 1) { // mean
            val /= float(params.reduce_size);
        }
        output_data[output_idx] = val;
    }
}
