#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Roll operation for Float16: shift elements along a dimension with wrap-around.
// F16 buffers pack 2 Float16 per uint32. Writing a single element therefore
// needs a read-modify-write of the shared 32-bit word, which RACES when two
// invocations update the two halves of the same word concurrently (one clobbers
// the other, leaving the loser's element as 0). To avoid that, each output WORD
// is written exactly once: only even-element invocations run, and each gathers
// both halves and stores the full packed word in a single write.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input { uint in_data[]; };
layout(binding = 1) buffer Output { uint out_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements
    uint dim_size;       // Size of the roll dimension
    uint shift;          // Shift amount (already normalized to [0, dim_size))
    uint inner_size;     // Product of sizes of dims after the roll dim
} params;

// Read a single float16 element from packed uint buffer.
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2u;
    uint word_offset = element_idx % 2u;
    uint packed = in_data[word_idx];
    uint bits = (packed >> (word_offset * 16u)) & 0xFFFFu;
    return unpackHalf2x16(bits).x;
}

// Map an output element index to its source element index under the roll.
uint srcIndex(uint e) {
    uint inner_idx = e % params.inner_size;
    uint dim_idx = (e / params.inner_size) % params.dim_size;
    uint outer_idx = e / (params.inner_size * params.dim_size);
    uint src_dim_idx = (dim_idx - params.shift + params.dim_size) % params.dim_size;
    return (outer_idx * params.dim_size + src_dim_idx) * params.inner_size + inner_idx;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;
    if ((idx & 1u) != 0u) return;  // even invocation owns the whole 32-bit word

    float lo = readF16(srcIndex(idx));
    uint loBits = packHalf2x16(vec2(lo, 0.0)) & 0xFFFFu;

    uint hiBits = 0u;
    if (idx + 1u < params.n) {
        float hi = readF16(srcIndex(idx + 1u));
        hiBits = packHalf2x16(vec2(hi, 0.0)) & 0xFFFFu;
    }

    out_data[idx / 2u] = loBits | (hiBits << 16u);
}
