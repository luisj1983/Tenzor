#version 450

// FractionalMaxPool2d Forward — each invocation handles one output element.
// Computes pseudo-random pool region from sample values, finds max + index.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input   { float input_data[]; };    // [N, C, H, W]
layout(binding = 1) writeonly buffer Output  { float output_data[]; };   // [N, C, out_h, out_w]
layout(binding = 2) writeonly buffer Indices { int   indices_data[]; };   // [N, C, out_h, out_w]
layout(binding = 3) readonly buffer Samples  { float samples_data[]; };  // [N*C*2] or empty

layout(push_constant) uniform PushConstants {
    uint N;
    uint C;
    uint H;
    uint W;
    uint out_h;
    uint out_w;
    uint total_output;   // N * C * out_h * out_w
    uint has_samples;    // 1 if samples provided, 0 otherwise
    uint kernel_h;       // pool window height
    uint kernel_w;       // pool window width
} params;

// PyTorch FractionalMaxPool window start for output index `i` along one axis.
// Windows are `pool`-wide (== kernel_size) and OVERLAP when pool > alpha
// (torch.nn.FractionalMaxPool, ATen generate_intervals, Graham arXiv:1412.6071):
//   alpha    = (in - pool) / (out - 1)                     [out > 1]
//   start(i) = floor((i + u) * alpha) - floor(u * alpha)   [i < out-1]
//   start(out-1) = in - pool
// int() truncation == floor here since all operands are non-negative.
int frac_pool_start(int i, int in_size, int out_size, int pool, float u) {
    int start;
    if (out_size <= 1 || i == out_size - 1) {
        start = in_size - pool;
    } else {
        float alpha = float(in_size - pool) / float(out_size - 1);
        start = int((float(i) + u) * alpha) - int(u * alpha);
    }
    // GLSL's clamp(x, minVal, maxVal) is undefined when minVal > maxVal, which
    // happens here whenever pool > in_size (in_size - pool < 0). Observed on
    // this driver as clamp() effectively applying the upper bound last,
    // driving start negative -- an out-of-bounds input read. Apply the two
    // bounds explicitly, upper first, matching the CPU reference's
    // frac_pool_start (src/backends/cpu/kernels/pooling.cpp).
    start = min(start, in_size - pool);
    start = max(start, 0);
    return start;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_output) return;

    // Decompose flat index into (n, c, oh, ow)
    uint ow = idx % params.out_w;
    uint tmp = idx / params.out_w;
    uint oh = tmp % params.out_h;
    tmp = tmp / params.out_h;
    uint c = tmp % params.C;
    uint n = tmp / params.C;

    // Get sample values (default 0.5 if no samples provided)
    float sample_h = 0.5;
    float sample_w = 0.5;
    if (params.has_samples != 0) {
        uint sample_idx = (n * params.C + c) * 2;
        sample_h = samples_data[sample_idx];
        sample_w = samples_data[sample_idx + 1];
    }

    // PyTorch overlapping windows of width == kernel_h x kernel_w, positioned
    // by the pseudo-random sample offset (see frac_pool_start above). Earlier
    // versions ignored kernel_h/kernel_w and derived a disjoint window from the
    // input/output ratio (adaptive-style), diverging from torch.nn.
    int h_start = frac_pool_start(int(oh), int(params.H), int(params.out_h), int(params.kernel_h), sample_h);
    int w_start = frac_pool_start(int(ow), int(params.W), int(params.out_w), int(params.kernel_w), sample_w);

    int h_end = min(h_start + int(params.kernel_h), int(params.H));
    int w_end = min(w_start + int(params.kernel_w), int(params.W));

    // Find max in pool region
    float max_val = -1.0 / 0.0; // -inf
    int max_idx = h_start * int(params.W) + w_start;

    uint base = (n * params.C + c) * params.H * params.W;
    for (int h = h_start; h < h_end; h++) {
        for (int w = w_start; w < w_end; w++) {
            float val = input_data[base + uint(h) * params.W + uint(w)];
            if (val > max_val || val != val) {
                max_val = val;
                max_idx = h * int(params.W) + w;
            }
        }
    }

    output_data[idx]  = max_val;
    indices_data[idx] = max_idx;
}
