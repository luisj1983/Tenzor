#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Francis double-shift QR step on upper Hessenberg matrix (Float64)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer MatrixH { float64_t H[]; };
layout(set = 0, binding = 1) buffer ShiftBuf { float64_t shifts[]; };
layout(set = 0, binding = 2) buffer ActiveStartBuf { uint a_start[]; };
layout(set = 0, binding = 3) buffer ActiveEndBuf   { uint a_end[]; };

layout(push_constant) uniform PushConstants {
    uint n;
};

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (tid != 0) return;

    uint batch_idx = gl_WorkGroupID.x;
    uint lo = a_start[batch_idx];
    uint hi = a_end[batch_idx];
    uint base = batch_idx * n * n;

    if (hi <= lo) return;
    if (hi - lo == 1) {
        shifts[batch_idx * 4] = H[base + lo * n + lo];
        shifts[batch_idx * 4 + 1] = H[base + hi * n + hi];
        return;
    }

    float64_t a = H[base + (hi - 1) * n + (hi - 1)];
    float64_t b = H[base + (hi - 1) * n + hi];
    float64_t c = H[base + hi * n + (hi - 1)];
    float64_t d = H[base + hi * n + hi];
    float64_t s = a + d;
    float64_t t = a * d - b * c;

    float64_t h00 = H[base + lo * n + lo];
    float64_t h10 = H[base + (lo + 1) * n + lo];
    float64_t h01 = H[base + lo * n + (lo + 1)];
    float64_t h11 = H[base + (lo + 1) * n + (lo + 1)];

    float64_t x = h00 * h00 + h01 * h10 - s * h00 + t;
    float64_t y = h10 * (h00 + h11 - s);
    float64_t z = (lo + 2 <= hi) ? h10 * H[base + (lo + 2) * n + (lo + 1)] : 0.0lf;

    for (uint k = lo; k < hi - 1; k++) {
        uint nr = (k + 2 <= hi - 1) ? 3 : 2;

        float64_t norm_v;
        if (nr == 3) {
            norm_v = sqrt(x * x + y * y + z * z);
        } else {
            norm_v = sqrt(x * x + y * y);
        }

        if (norm_v < 1e-60lf) {
            if (k + 1 <= hi) x = H[base + (k + 1) * n + k];
            y = (k + 2 <= hi) ? H[base + (k + 2) * n + k] : 0.0lf;
            z = (k + 3 <= hi) ? H[base + (k + 3) * n + k] : 0.0lf;
            continue;
        }

        float64_t alpha_h = -sign(x) * norm_v;
        float64_t v0 = x - alpha_h;
        float64_t v1 = y;
        float64_t v2 = z;
        float64_t v_sq = v0 * v0 + v1 * v1;
        if (nr == 3) v_sq += v2 * v2;
        if (v_sq < 1e-60lf) {
            if (k + 1 <= hi) x = H[base + (k + 1) * n + k];
            y = (k + 2 <= hi) ? H[base + (k + 2) * n + k] : 0.0lf;
            z = (k + 3 <= hi) ? H[base + (k + 3) * n + k] : 0.0lf;
            continue;
        }
        float64_t tau_h = 2.0lf / v_sq;

        uint j_start = (k > lo) ? k - 1 : k;
        for (uint j = j_start; j < n; j++) {
            float64_t dot = v0 * H[base + k * n + j] + v1 * H[base + (k + 1) * n + j];
            if (nr == 3) dot += v2 * H[base + (k + 2) * n + j];
            dot *= tau_h;
            H[base + k * n + j] -= v0 * dot;
            H[base + (k + 1) * n + j] -= v1 * dot;
            if (nr == 3) H[base + (k + 2) * n + j] -= v2 * dot;
        }

        uint i_end = min(k + 4, hi + 1);
        if (i_end > n) i_end = n;
        for (uint i = 0; i < i_end; i++) {
            float64_t dot = v0 * H[base + i * n + k] + v1 * H[base + i * n + (k + 1)];
            if (nr == 3) dot += v2 * H[base + i * n + (k + 2)];
            dot *= tau_h;
            H[base + i * n + k] -= v0 * dot;
            H[base + i * n + (k + 1)] -= v1 * dot;
            if (nr == 3) H[base + i * n + (k + 2)] -= v2 * dot;
        }

        if (k > lo) {
            H[base + (k + 1) * n + (k - 1)] = 0.0lf;
            if (nr == 3) H[base + (k + 2) * n + (k - 1)] = 0.0lf;
        }

        x = H[base + (k + 1) * n + k];
        y = (k + 2 <= hi) ? H[base + (k + 2) * n + k] : 0.0lf;
        z = (k + 3 <= hi) ? H[base + (k + 3) * n + k] : 0.0lf;
    }

    if (hi >= 1) {
        uint k = hi - 1;
        float64_t norm_v = sqrt(x * x + y * y);
        if (norm_v > 1e-60lf) {
            float64_t cos_v = x / norm_v;
            float64_t sin_v = -y / norm_v;
            for (uint j = k; j < n; j++) {
                float64_t tmp = cos_v * H[base + k * n + j] - sin_v * H[base + (k + 1) * n + j];
                H[base + (k + 1) * n + j] = sin_v * H[base + k * n + j] + cos_v * H[base + (k + 1) * n + j];
                H[base + k * n + j] = tmp;
            }
            for (uint i = 0; i <= min(k + 2, hi); i++) {
                float64_t tmp = cos_v * H[base + i * n + k] - sin_v * H[base + i * n + (k + 1)];
                H[base + i * n + (k + 1)] = sin_v * H[base + i * n + k] + cos_v * H[base + i * n + (k + 1)];
                H[base + i * n + k] = tmp;
            }
        }
    }

    uint deflated = 0;
    for (uint i = hi; i > lo; i--) {
        float64_t tst = abs(H[base + (i - 1) * n + (i - 1)]) + abs(H[base + i * n + i]);
        if (tst == 0.0lf) tst = 1.0lf;
        if (abs(H[base + i * n + (i - 1)]) < 1e-15lf * tst) {
            H[base + i * n + (i - 1)] = 0.0lf;
            deflated = i;
            break;
        }
    }
    shifts[batch_idx * 4] = float64_t(deflated);
    shifts[batch_idx * 4 + 1] = float64_t(lo);
    shifts[batch_idx * 4 + 2] = float64_t(hi);
}
