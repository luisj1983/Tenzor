#version 450

// One-sided Jacobi SVD for m >= n, arbitrary size (global-memory working set).
// Orthogonalizes the n columns of A by Jacobi rotations applied on the right;
// V (n x n) accumulates the rotations. After convergence the singular values are
// the column norms, and U = A_columns / sigma. One workgroup per batch element.
//
// full_matrices honoured: U is allocated/written m x u_cols where u_cols == m in
// full mode (jobz 'A') or n in reduced mode (jobz 'S'). In full mode the trailing
// columns n..m-1 of U are filled with an orthonormal completion (Gram-Schmidt of
// canonical basis vectors against the n left singular vectors) so U is a full m x m
// orthogonal basis matching the CPU/LAPACK reference. Since m >= n here, k == n,
// V is already the full n x n basis (Vt = V^T is n x n in both modes).
//
// Outputs: U (m x u_cols, binding 1), S (n, binding 2), V (n x n, binding 3).
layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf { float data_in[]; };  // A (m*n per batch)
layout(set = 0, binding = 1) buffer UBuf     { float data_u[];  };  // U (m*u_cols), working columns
layout(set = 0, binding = 2) buffer SBuf     { float data_s[];  };  // S (n)
layout(set = 0, binding = 3) buffer VBuf     { float data_v[];  };  // V (n*n)

layout(push_constant) uniform PushConstants {
    uint m;
    uint n;
    uint batch;
    uint full_matrices; // 0=reduced (u_cols=n), 1=full (u_cols=m)
};

shared float sh_c;
shared float sh_s;
shared uint  sh_rot;
shared uint  converged;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (batch_idx >= batch) return;

    // U row stride: m in full mode, n in reduced mode (m >= n so k == n).
    uint u_cols = (full_matrices == 1u) ? m : n;
    uint in_off = batch_idx * m * n;        // A is always m x n
    uint u_off  = batch_idx * m * u_cols;   // U is m x u_cols
    uint v_off  = batch_idx * n * n;

    // U[:, 0:n] = A, V = I. (U's trailing columns, if any, are filled later.)
    for (uint idx = tid; idx < m * n; idx += gl_WorkGroupSize.x) {
        uint r = idx / n;
        uint c = idx - r * n;
        data_u[u_off + r * u_cols + c] = data_in[in_off + idx];
    }
    for (uint idx = tid; idx < n * n; idx += gl_WorkGroupSize.x) {
        uint r = idx / n;
        uint c = idx - r * n;
        data_v[v_off + idx] = (r == c) ? 1.0 : 0.0;
    }
    barrier();

    for (uint sweep = 0; sweep < 60u; sweep++) {
        if (tid == 0u) converged = 1u;
        barrier();

        for (uint i = 0; i < n; i++) {
            for (uint j = i + 1u; j < n; j++) {
                if (tid == 0u) {
                    float a = 0.0, b = 0.0, c = 0.0;
                    for (uint r = 0; r < m; r++) {
                        float ui = data_u[u_off + r * u_cols + i];
                        float uj = data_u[u_off + r * u_cols + j];
                        a += ui * ui;
                        b += uj * uj;
                        c += ui * uj;
                    }
                    if (abs(c) > 1e-12 * sqrt(a * b) && a > 0.0 && b > 0.0) {
                        converged = 0u;
                        float zeta = (b - a) / (2.0 * c);
                        float sgn = (zeta >= 0.0) ? 1.0 : -1.0;
                        float t = sgn / (abs(zeta) + sqrt(1.0 + zeta * zeta));
                        float cs = 1.0 / sqrt(1.0 + t * t);
                        sh_c = cs;
                        sh_s = cs * t;
                        sh_rot = 1u;
                    } else {
                        sh_rot = 0u;
                    }
                }
                barrier();

                if (sh_rot == 1u) {
                    float cs = sh_c;
                    float sn = sh_s;
                    // Rotate columns i,j of U (independent across rows).
                    for (uint r = tid; r < m; r += gl_WorkGroupSize.x) {
                        float ui = data_u[u_off + r * u_cols + i];
                        float uj = data_u[u_off + r * u_cols + j];
                        data_u[u_off + r * u_cols + i] = cs * ui - sn * uj;
                        data_u[u_off + r * u_cols + j] = sn * ui + cs * uj;
                    }
                    // Rotate columns i,j of V.
                    for (uint r = tid; r < n; r += gl_WorkGroupSize.x) {
                        float vi = data_v[v_off + r * n + i];
                        float vj = data_v[v_off + r * n + j];
                        data_v[v_off + r * n + i] = cs * vi - sn * vj;
                        data_v[v_off + r * n + j] = sn * vi + cs * vj;
                    }
                }
                barrier();
            }
        }
        if (converged > 0u) break;
        barrier();
    }

    // Singular values = column norms; normalize U columns (parallel over columns).
    for (uint j = tid; j < n; j += gl_WorkGroupSize.x) {
        float s = 0.0;
        for (uint r = 0; r < m; r++) {
            float uj = data_u[u_off + r * u_cols + j];
            s += uj * uj;
        }
        float sigma = sqrt(s);
        data_s[batch_idx * n + j] = sigma;
        float inv = (sigma > 1e-30) ? 1.0 / sigma : 0.0;
        for (uint r = 0; r < m; r++) {
            data_u[u_off + r * u_cols + j] *= inv;
        }
    }
    barrier();

    // Orthonormal completion of U from m x n to m x m (full mode, tall matrices).
    // Gram-Schmidt each canonical basis vector e_cand against the already-accepted
    // columns 0..filled-1; keep it if a non-degenerate remainder survives. Single
    // thread because the columns must be filled sequentially (each new column is
    // projected against the previous ones). m may exceed 32 here, so the working
    // vector is read directly from / written to global memory rather than a fixed
    // local array.
    if (full_matrices == 1u && m > n && tid == 0u) {
        uint filled = n;
        for (uint cand = 0; cand < m && filled < m; cand++) {
            // Initialize the candidate column slot with e_cand.
            for (uint r = 0; r < m; r++) {
                data_u[u_off + r * u_cols + filled] = (r == cand) ? 1.0 : 0.0;
            }
            // Subtract projections onto existing columns 0..filled-1.
            for (uint col = 0; col < filled; col++) {
                float dot = 0.0;
                for (uint r = 0; r < m; r++) {
                    dot += data_u[u_off + r * u_cols + filled] * data_u[u_off + r * u_cols + col];
                }
                for (uint r = 0; r < m; r++) {
                    data_u[u_off + r * u_cols + filled] -= dot * data_u[u_off + r * u_cols + col];
                }
            }
            float nrm = 0.0;
            for (uint r = 0; r < m; r++) {
                float w = data_u[u_off + r * u_cols + filled];
                nrm += w * w;
            }
            nrm = sqrt(nrm);
            if (nrm > 1e-6) {
                float inv = 1.0 / nrm;
                for (uint r = 0; r < m; r++) {
                    data_u[u_off + r * u_cols + filled] *= inv;
                }
                filled++;
            }
        }
    }
}
