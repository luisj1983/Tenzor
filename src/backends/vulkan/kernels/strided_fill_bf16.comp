#version 450

// Strided Fill for BFloat16: fill a tensor with a value, respecting non-contiguous strides
// BF16 packed buffers (2 BFloat16 per uint32), value passed as float in push constants
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Data { uint data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Total logical elements
    uint ndim;           // Number of dimensions (max 8)
    float fill_value;    // Value to fill (in float32, will be converted to BF16)
    // Interleaved shape[i], stride[i] pairs for compact push constant layout
    uint shape_stride[16]; // shape_stride[2*d] = shape[d], shape_stride[2*d+1] = stride[d]
} params;

// Write a single bfloat16 element to packed uint buffer
void writeBF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = ((floatBitsToUint(val) + 0x7FFFu + ((floatBitsToUint(val) >> 16) & 1u)) >> 16);
    uint existing = data[word_idx];
    uint mask = 0xFFFFu << (word_offset * 16);
    data[word_idx] = (existing & ~mask) | (bits << (word_offset * 16));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Decompose flat index into multi-dim coordinates, compute strided offset
    uint physical_offset = 0;
    uint rem = idx;
    for (int d = int(params.ndim) - 1; d >= 0; d--) {
        uint dim_size = params.shape_stride[2 * d];
        uint dim_stride = params.shape_stride[2 * d + 1];
        uint coord = rem % dim_size;
        rem /= dim_size;
        physical_offset += coord * dim_stride;
    }

    writeBF16(physical_offset, params.fill_value);
}
