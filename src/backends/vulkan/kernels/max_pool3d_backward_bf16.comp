#version 450

// Max Pooling 3D Backward Pass for BFloat16 using pre-computed indices.
// grad_input is PACKED-BF16 (2 bytes/elem); a float32 atomicAdd would write 4
// bytes per element index (OOB + misrouted gradients). Accumulate via CAS.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };
// Indices come from MaxPool3dForward as Int32, regardless of data dtype.
layout(binding = 1) buffer Indices { int indices_data[]; };
layout(binding = 2) buffer GradInput { uint grad_input[]; };  // Packed BF16, CAS-accumulated

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint grad_input_size;
    uint out_plane;   // per-(n,c) output plane size (F043)
    uint in_plane;    // per-(n,c) input plane size (F043)
} params;

// BF16 -> FP32: the 16 BF16 bits are the high 16 bits of an FP32 value.
// Matches the forward kernel (max_pool3d_bf16.comp readBF16Element).
float bf16_to_float(uint b) {
    return uintBitsToFloat((b & 0xFFFFu) << 16);
}

// Pack a float to BF16 (round-to-nearest-even).
uint float_to_bf16(float f) {
    uint b = floatBitsToUint(f);
    return (b + 0x7FFFu + ((b >> 16) & 1u)) >> 16;
}

void atomicAddBF16(uint flat_idx, float add_val) {
    uint word_idx = flat_idx / 2u;
    uint half_idx = flat_idx % 2u;
    uint mask = 0xFFFFu << (half_idx * 16u);
    uint old_val = grad_input[word_idx];
    uint expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        uint bits = (expected >> (half_idx * 16u)) & 0xFFFFu;
        float current = bf16_to_float(bits);
        float updated = current + add_val;
        uint new_bits = float_to_bf16(updated) & 0xFFFFu;
        uint new_val = (expected & ~mask) | (new_bits << (half_idx * 16u));
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint grad_word_idx = idx / 2;
    uint grad_half_idx = idx % 2;
    uint grad_packed = grad_output[grad_word_idx];
    uint grad_half = (grad_half_idx == 0) ? (grad_packed & 0xFFFFu) : (grad_packed >> 16);
    float grad = bf16_to_float(grad_half);

    // F043: forward stores PLANE-LOCAL argmax; rebuild the global

    // grad_input offset via the per-(n,c) plane base.

    int plane_local = indices_data[idx];

    uint nc = idx / params.out_plane;

    int target_idx = int(nc * params.in_plane) + plane_local;
    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAddBF16(uint(target_idx), grad);
    }
}
