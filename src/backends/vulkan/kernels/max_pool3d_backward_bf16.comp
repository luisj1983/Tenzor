#version 450
#extension GL_EXT_shader_atomic_float : enable

// Max Pooling 3D Backward Pass for BFloat16 using pre-computed indices
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };
// Indices come from MaxPool3dForward as Int32, regardless of data dtype.
layout(binding = 1) buffer Indices { int indices_data[]; };
layout(binding = 2) buffer GradInput { float grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint grad_input_size;
} params;

// BF16 -> FP32: the 16 BF16 bits are the high 16 bits of an FP32 value.
// Matches the forward kernel (max_pool3d_bf16.comp readBF16Element).
float bf16_to_float(uint b) {
    return uintBitsToFloat((b & 0xFFFFu) << 16);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint grad_word_idx = idx / 2;
    uint grad_half_idx = idx % 2;
    uint grad_packed = grad_output[grad_word_idx];
    uint grad_half = (grad_half_idx == 0) ? (grad_packed & 0xFFFFu) : (grad_packed >> 16);
    float grad = bf16_to_float(grad_half);

    int target_idx = indices_data[idx];

    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAdd(grad_input[target_idx], grad);
    }
}
