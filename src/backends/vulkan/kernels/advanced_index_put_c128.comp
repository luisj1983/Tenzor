#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Advanced index put — 16-byte elements (Complex128 = 2x double).
// Uses two consecutive int64_t as the bitwise-copy carrier (mirrors
// advanced_index_put_f64.comp's 8-byte int64_t carrier, doubled).
layout(local_size_x_id = 0) in;

layout(binding = 0)          buffer Dst  { int64_t dst_data[]; };
layout(binding = 1) readonly buffer Vals { int64_t vals_data[]; };
layout(binding = 2) readonly buffer Meta { int64_t meta[]; };
layout(binding = 3) readonly buffer Idx  { int64_t idx_data[]; };

const int META_SRC_SHAPE   = 5;
const int META_SRC_STRIDES = 21;
const int META_PASS_DIMS   = 37;
const int META_IS_INDEXED  = 53;
const int META_IDX_OFFSET  = 69;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    int64_t total_out = meta[3];
    if (int64_t(gid) >= total_out) return;

    int64_t pass_numel = meta[4];
    int64_t out_idx = int64_t(gid);
    int64_t bc;
    int64_t p;
    if (pass_numel > 0) {
        bc = out_idx / pass_numel;
        p  = out_idx - bc * pass_numel;
    } else {
        bc = out_idx;
        p  = 0;
    }

    int num_indices = int(meta[0]);
    int num_pass    = int(meta[2]);

    int64_t dst_offset = 0;
    for (int i = 0; i < num_indices; ++i) {
        if (meta[META_IS_INDEXED + i] != 0) {
            int64_t base = meta[META_IDX_OFFSET + i];
            int64_t idx_val = idx_data[uint(base + bc)];
            if (idx_val < 0) idx_val += meta[META_SRC_SHAPE + i];
            // Bounds check to prevent out-of-bounds device writes (matches gather.comp).
            if (idx_val < 0 || idx_val >= meta[META_SRC_SHAPE + i]) return;
            dst_offset += idx_val * meta[META_SRC_STRIDES + i];
        }
    }

    if (num_pass > 0) {
        int64_t remaining = p;
        for (int k = num_pass - 1; k >= 0; --k) {
            int d = int(meta[META_PASS_DIMS + k]);
            int64_t dim_sz = meta[META_SRC_SHAPE + d];
            int64_t coord = remaining - (remaining / dim_sz) * dim_sz;
            remaining = remaining / dim_sz;
            dst_offset += coord * meta[META_SRC_STRIDES + d];
        }
    }

    // Element offsets (dst_offset/gid) index whole Complex128 elements;
    // each occupies 2 consecutive int64_t slots in the raw buffers.
    uint dst_base = 2u * uint(dst_offset);
    uint val_base = 2u * gid;
    dst_data[dst_base]     = vals_data[val_base];
    dst_data[dst_base + 1] = vals_data[val_base + 1];
}
