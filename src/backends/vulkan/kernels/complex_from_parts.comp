#version 450

// Create complex tensor from separate real and imaginary parts (Float32)
// Input:  real[i], imag[i]
// Output: [real[0], imag[0], real[1], imag[1], ...]

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer RealBuf  { float real_in[];  };
layout(set = 0, binding = 1) buffer ImagBuf  { float imag_in[];  };
layout(set = 0, binding = 2) buffer OutputBuf { float data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;
    data_out[idx * 2]     = real_in[idx];
    data_out[idx * 2 + 1] = imag_in[idx];
}
