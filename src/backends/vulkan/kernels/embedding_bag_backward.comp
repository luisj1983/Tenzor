#version 450
#extension GL_EXT_shader_atomic_float : require

// EmbeddingBag Backward Pass (Float32)
// Scatter-add gradients from grad_output back to embedding table based on indices and offsets.
// Each thread handles one (bag, dim) pair: for each index in the bag range,
// atomicAdd grad to the corresponding embedding row.
//
// Input: grad_output (num_bags, embedding_dim), indices (total_indices), offsets (num_offsets)
// Output: grad_weight (num_embeddings, embedding_dim) — zero-initialized by host

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output_data[]; };   // (num_bags, embedding_dim)
layout(binding = 1) buffer Indices { int indices_data[]; };             // (total_indices)
layout(binding = 2) buffer Offsets { int offset_data[]; };              // (num_offsets)
layout(binding = 3) buffer GradWeight { float grad_weight_data[]; };   // (num_embeddings, embedding_dim)

layout(push_constant) uniform PushConstants {
    uint num_bags;
    uint embedding_dim;
    uint num_embeddings;
    uint mode;              // 0=sum, 1=mean, 2=max
    uint include_last_offset;
    uint num_offsets;
    uint total_indices;     // length of the indices array (last bag's end)
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total_output = params.num_bags * params.embedding_dim;
    if (gid >= total_output) return;

    uint bag = gid / params.embedding_dim;
    uint j = gid % params.embedding_dim;

    // Determine bag range [start, end)
    int start = offset_data[bag];
    int end_val;
    if (bag + 1 < params.num_offsets) {
        end_val = offset_data[bag + 1];
    } else {
        // Last bag: range runs to the end of the indices array. (For
        // include_last_offset the sentinel makes the branch above cover all
        // bags; for !include_last_offset the final bag lands here and must
        // extend to total_indices — previously this returned early, dropping
        // the last bag's gradient entirely.)
        end_val = int(params.total_indices);
    }

    int bag_size = end_val - start;
    if (bag_size <= 0) return;

    float grad_val = grad_output_data[bag * params.embedding_dim + j];

    // For mean mode, divide gradient by bag size
    if (params.mode == 1) {
        grad_val /= float(bag_size);
    }

    // For max mode, only the max element gets the gradient.
    // Without saved argmax indices, we approximate by distributing to all elements
    // (same as sum mode). The host should pass argmax for exact max backward.

    // Scatter-add to each embedding row in this bag
    for (int i = start; i < end_val; ++i) {
        int idx = indices_data[i];
        if (idx >= 0 && idx < int(params.num_embeddings)) {
            atomicAdd(grad_weight_data[uint(idx) * params.embedding_dim + j], grad_val);
        }
    }
}
