#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Stockham mixed-radix FFT: radix-3 butterfly stage (Float64)
// Data layout: interleaved real/imag pairs
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float64_t data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint stage_stride;
    uint direction;
    uint batch_size;
    uint batch_stride;
};

const float64_t PI = 3.14159265358979323846lf;
const float64_t COS_2PI_3 = -0.5lf;
const float64_t SIN_2PI_3 = 0.86602540378443864676lf;

// Double-precision sin/cos to avoid float-cast twiddle precision loss.
const float64_t TWO_OVER_PI_F = 0.6366197723675814lf;
const float64_t PI_OVER_2_HI = 1.5707963267948966lf;
const float64_t PI_OVER_2_LO = 6.123233995736766e-17lf;

void trig_reduce_f(float64_t x, out float64_t r, out int q) {
    float64_t j = floor(x * TWO_OVER_PI_F + 0.5lf);
    q = int(j) & 3;
    r = x - j * PI_OVER_2_HI;
    r = r - j * PI_OVER_2_LO;
}
float64_t sin_poly_f(float64_t x) {
    float64_t x2 = x * x;
    return x * (1.0lf - x2 * (1.0lf/6.0lf - x2 * (1.0lf/120.0lf - x2 * (1.0lf/5040.0lf - x2 / 362880.0lf))));
}
float64_t cos_poly_f(float64_t x) {
    float64_t x2 = x * x;
    return 1.0lf - x2 * (0.5lf - x2 * (1.0lf/24.0lf - x2 * (1.0lf/720.0lf - x2 / 40320.0lf)));
}
float64_t sin_df(float64_t x) {
    float64_t r; int q;
    trig_reduce_f(x, r, q);
    switch (q) {
        case 0: return sin_poly_f(r);
        case 1: return cos_poly_f(r);
        case 2: return -sin_poly_f(r);
        case 3: return -cos_poly_f(r);
    }
    return 0.0lf;
}
float64_t cos_df(float64_t x) {
    float64_t r; int q;
    trig_reduce_f(x, r, q);
    switch (q) {
        case 0: return cos_poly_f(r);
        case 1: return -sin_poly_f(r);
        case 2: return -cos_poly_f(r);
        case 3: return sin_poly_f(r);
    }
    return 0.0lf;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 3;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    uint group = local_tid / stage_stride;
    uint pos = local_tid % stage_stride;

    uint i0 = group * stage_stride * 3 + pos;
    uint i1 = i0 + stage_stride;
    uint i2 = i1 + stage_stride;

    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;
    uint o2 = o1 + n_butterflies;

    uint b0_in = (batch_idx * batch_stride + i0) * 2;
    uint b1_in = (batch_idx * batch_stride + i1) * 2;
    uint b2_in = (batch_idx * batch_stride + i2) * 2;
    uint b0_out = (batch_idx * batch_stride + o0) * 2;
    uint b1_out = (batch_idx * batch_stride + o1) * 2;
    uint b2_out = (batch_idx * batch_stride + o2) * 2;

    float64_t a0_re = data_in[b0_in], a0_im = data_in[b0_in + 1];
    float64_t a1_re = data_in[b1_in], a1_im = data_in[b1_in + 1];
    float64_t a2_re = data_in[b2_in], a2_im = data_in[b2_in + 1];

    float64_t angle1 = -2.0lf * PI * float64_t(pos) / float64_t(stage_stride * 3);
    float64_t angle2 = 2.0lf * angle1;
    if (direction == 1) { angle1 = -angle1; angle2 = -angle2; }

    float64_t w1_re = cos_df(angle1), w1_im = sin_df(angle1);
    float64_t w2_re = cos_df(angle2), w2_im = sin_df(angle2);

    float64_t t1_re = a1_re * w1_re - a1_im * w1_im;
    float64_t t1_im = a1_re * w1_im + a1_im * w1_re;
    float64_t t2_re = a2_re * w2_re - a2_im * w2_im;
    float64_t t2_im = a2_re * w2_im + a2_im * w2_re;

    float64_t s1_re = t1_re + t2_re;
    float64_t s1_im = t1_im + t2_im;
    float64_t d1_re = t1_re - t2_re;
    float64_t d1_im = t1_im - t2_im;

    data_out[b0_out]     = a0_re + s1_re;
    data_out[b0_out + 1] = a0_im + s1_im;
    data_out[b1_out]     = a0_re + COS_2PI_3 * s1_re - SIN_2PI_3 * d1_im;
    data_out[b1_out + 1] = a0_im + COS_2PI_3 * s1_im + SIN_2PI_3 * d1_re;
    data_out[b2_out]     = a0_re + COS_2PI_3 * s1_re + SIN_2PI_3 * d1_im;
    data_out[b2_out + 1] = a0_im + COS_2PI_3 * s1_im - SIN_2PI_3 * d1_re;
}
