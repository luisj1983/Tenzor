#version 450

// FractionalMaxPool3d Forward — each invocation handles one output element.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input   { float input_data[]; };    // [N, C, D, H, W]
layout(binding = 1) writeonly buffer Output  { float output_data[]; };   // [N, C, out_d, out_h, out_w]
layout(binding = 2) writeonly buffer Indices { int   indices_data[]; };   // same shape as output
layout(binding = 3) readonly buffer Samples  { float samples_data[]; };  // [N*C*3] or empty

layout(push_constant) uniform PushConstants {
    uint N; uint C; uint D; uint H; uint W;
    uint out_d; uint out_h; uint out_w;
    uint total_output;
    uint has_samples;
    uint kernel_d; uint kernel_h; uint kernel_w;
} params;

// PyTorch FractionalMaxPool window start for output index `i` along one axis;
// windows are `pool`-wide (== kernel_size) and OVERLAP (ATen generate_intervals,
// Graham arXiv:1412.6071):
//   alpha    = (in - pool) / (out - 1)                     [out > 1]
//   start(i) = floor((i + u) * alpha) - floor(u * alpha)   [i < out-1]
//   start(out-1) = in - pool
int frac_pool_start(int i, int in_size, int out_size, int pool, float u) {
    int start;
    if (out_size <= 1 || i == out_size - 1) {
        start = in_size - pool;
    } else {
        float alpha = float(in_size - pool) / float(out_size - 1);
        start = int((float(i) + u) * alpha) - int(u * alpha);
    }
    return clamp(start, 0, in_size - pool);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_output) return;

    // Decompose flat index into (n, c, od, oh, ow)
    uint ow = idx % params.out_w;
    uint tmp = idx / params.out_w;
    uint oh = tmp % params.out_h;
    tmp = tmp / params.out_h;
    uint od = tmp % params.out_d;
    tmp = tmp / params.out_d;
    uint c = tmp % params.C;
    uint n = tmp / params.C;

    float sample_d = 0.5, sample_h = 0.5, sample_w = 0.5;
    if (params.has_samples != 0) {
        uint si = (n * params.C + c) * 3;
        sample_d = samples_data[si];
        sample_h = samples_data[si + 1];
        sample_w = samples_data[si + 2];
    }

    // PyTorch overlapping windows of width == kernel_d x kernel_h x kernel_w,
    // positioned by the pseudo-random sample offset (see frac_pool_start above).
    // Earlier versions ignored the kernel sizes and derived a disjoint window
    // from the input/output ratio (adaptive-style), diverging from torch.nn.
    int d_start = frac_pool_start(int(od), int(params.D), int(params.out_d), int(params.kernel_d), sample_d);
    int h_start = frac_pool_start(int(oh), int(params.H), int(params.out_h), int(params.kernel_h), sample_h);
    int w_start = frac_pool_start(int(ow), int(params.W), int(params.out_w), int(params.kernel_w), sample_w);

    int d_end = min(d_start + int(params.kernel_d), int(params.D));
    int h_end = min(h_start + int(params.kernel_h), int(params.H));
    int w_end = min(w_start + int(params.kernel_w), int(params.W));

    float max_val = -1.0 / 0.0;
    int max_idx = (d_start * int(params.H) + h_start) * int(params.W) + w_start;

    uint base = (n * params.C + c) * params.D * params.H * params.W;
    for (int d = d_start; d < d_end; d++) {
        for (int h = h_start; h < h_end; h++) {
            for (int w = w_start; w < w_end; w++) {
                float val = input_data[base + (uint(d) * params.H + uint(h)) * params.W + uint(w)];
                if (val > max_val || val != val) {
                    max_val = val;
                    max_idx = (d * int(params.H) + h) * int(params.W) + w;
                }
            }
        }
    }

    output_data[idx]  = max_val;
    indices_data[idx] = max_idx;
}
