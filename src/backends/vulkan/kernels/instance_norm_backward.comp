#version 450
#extension GL_EXT_shader_atomic_float : enable

// Instance Normalization Backward Pass
// One workgroup per (N, C) pair. Computes:
// 1. grad_input per element
// 2. Atomically accumulates grad_weight and grad_bias across all (N, spatial) for each channel
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer GradOutput { float grad_output[]; };   // (N, C, H, W)
layout(binding = 1) buffer Input { float input_data[]; };          // (N, C, H, W)
layout(binding = 2) buffer Mean { float mean_data[]; };            // (N*C)
layout(binding = 3) buffer Rstd { float rstd_data[]; };            // (N*C) — reciprocal std
layout(binding = 4) buffer Weight { float weight_data[]; };        // (C)
layout(binding = 5) buffer GradInput { float grad_input[]; };      // (N, C, H, W)
layout(binding = 6) buffer GradWeight { float grad_weight[]; };    // (C) — accumulated atomically
layout(binding = 7) buffer GradBias { float grad_bias[]; };        // (C) — accumulated atomically

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint channels;
    uint spatial_size;
    uint affine;
} params;

shared float shared_sum_dy_w[WORKGROUP_SIZE];
shared float shared_sum_dy_w_xhat[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint nc_idx = gl_WorkGroupID.x;

    uint total_nc = params.batch_size * params.channels;
    if (nc_idx >= total_nc) return;

    uint c = nc_idx % params.channels;
    uint base = nc_idx * params.spatial_size;

    float mean = mean_data[nc_idx];
    float rstd = rstd_data[nc_idx];

    // NOTE: no rstd-magnitude clamp. The previous `rstd > 100` guard zeroed
    // grad_input for any legitimately small-but-valid variance (std < 0.01),
    // diverging from the CPU/CUDA/ROCm backends. rstd is finite (1/sqrt(var+eps)),
    // so the analytic formula below is well-defined even at var == 0.

    // Step 1: Compute reductions for grad_input formula
    float local_sum_dy_w = 0.0;
    float local_sum_dy_w_xhat = 0.0;
    for (uint i = tid; i < params.spatial_size; i += WORKGROUP_SIZE) {
        float dy = grad_output[base + i];
        float w = (params.affine > 0) ? weight_data[c] : 1.0;
        float xhat = (input_data[base + i] - mean) * rstd;

        local_sum_dy_w += dy * w;
        local_sum_dy_w_xhat += dy * w * xhat;
    }
    shared_sum_dy_w[tid] = local_sum_dy_w;
    shared_sum_dy_w_xhat[tid] = local_sum_dy_w_xhat;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_dy_w[tid] += shared_sum_dy_w[tid + s];
            shared_sum_dy_w_xhat[tid] += shared_sum_dy_w_xhat[tid + s];
        }
        barrier();
    }

    float sum_dy_w = shared_sum_dy_w[0];
    float sum_dy_w_xhat = shared_sum_dy_w_xhat[0];
    float inv_n = 1.0 / float(params.spatial_size);
    barrier();

    // Step 2: Compute grad_input and accumulate grad_weight, grad_bias
    for (uint i = tid; i < params.spatial_size; i += WORKGROUP_SIZE) {
        float dy = grad_output[base + i];
        float w = (params.affine > 0) ? weight_data[c] : 1.0;
        float xhat = (input_data[base + i] - mean) * rstd;

        // grad_input = rstd * (dy*w - sum_dy_w/N - xhat * sum_dy_w_xhat/N)
        float grad_in = rstd * (dy * w - sum_dy_w * inv_n - xhat * sum_dy_w_xhat * inv_n);
        grad_input[base + i] = grad_in;

        if (params.affine > 0) {
            atomicAdd(grad_weight[c], dy * xhat);
            atomicAdd(grad_bias[c], dy);
        }
    }
}
