#version 450

// Max Pooling 3D Forward Pass
// Finds maximum value in pooling window
// Supports dilation parameter

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };    // (N, C, D, H, W)
layout(binding = 1) buffer Output { float output_data[]; };  // (N, C, D_out, H_out, W_out)
layout(binding = 2) buffer Indices { int indices_data[]; };   // (N, C, D_out, H_out, W_out)

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output elements
    uint batch_channels;      // N * C
    uint in_depth;            // D
    uint in_height;           // H
    uint in_width;            // W
    uint out_depth;           // D_out
    uint out_height;          // H_out
    uint out_width;           // W_out
    uint kernel_d;            // Kernel depth
    uint kernel_h;            // Kernel height
    uint kernel_w;            // Kernel width
    uint stride_d;            // Stride depth
    uint stride_h;            // Stride height
    uint stride_w;            // Stride width
    uint padding_d;           // Padding depth
    uint padding_h;           // Padding height
    uint padding_w;           // Padding width
    uint dilation_d;          // Dilation depth
    uint dilation_h;          // Dilation height
    uint dilation_w;          // Dilation width
    uint ceil_mode;           // 1 if ceil_mode else 0 (recorded for parity; output shape already accounts)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Decode flat index to (bc, d_out, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint d_out = temp % params.out_depth;
    uint bc = temp / params.out_depth;

    // Compute input window bounds
    int d_start = int(d_out * params.stride_d) - int(params.padding_d);
    int h_start = int(h_out * params.stride_h) - int(params.padding_h);
    int w_start = int(w_out * params.stride_w) - int(params.padding_w);

    // Initialize max value to negative infinity
    float max_val = -1.0 / 0.0;
    int max_idx = 0;

    uint in_spatial = params.in_depth * params.in_height * params.in_width;

    for (uint kd = 0; kd < params.kernel_d; kd++) {
        int d_in = d_start + int(kd) * int(params.dilation_d);
        if (d_in < 0 || d_in >= int(params.in_depth)) continue;

        for (uint kh = 0; kh < params.kernel_h; kh++) {
            int h_in = h_start + int(kh) * int(params.dilation_h);
            if (h_in < 0 || h_in >= int(params.in_height)) continue;

            for (uint kw = 0; kw < params.kernel_w; kw++) {
                int w_in = w_start + int(kw) * int(params.dilation_w);
                if (w_in < 0 || w_in >= int(params.in_width)) continue;

                uint input_idx = bc * in_spatial +
                                uint(d_in) * params.in_height * params.in_width +
                                uint(h_in) * params.in_width +
                                uint(w_in);

                float val = input_data[input_idx];
                if (val > max_val) {
                    max_val = val;
                    max_idx = int(input_idx);
                }
            }
        }
    }

    output_data[idx] = max_val;
    indices_data[idx] = max_idx;
}
