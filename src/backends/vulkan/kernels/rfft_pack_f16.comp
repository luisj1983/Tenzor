#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Real-to-Complex FFT: Pack N real values into N/2 complex values — Float16
// Input:  N real float16 values in packed uint32 buffer (2 reals per word)
// Output: N/2 complex float16 values (1 complex per uint32 word: real low, imag high)
// Pairs adjacent reals as (re, im) for a half-length complex FFT

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;                // Original real FFT size (N)
    uint batch_size;       // Number of independent FFTs
    uint in_batch_stride;  // Stride between input batches (in real elements)
    uint out_batch_stride; // Stride between output batches (in uint32 words)
};

// Read a single float16 from packed real buffer
float readReal(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_sel = element_idx % 2;
    vec2 unpacked = unpackHalf2x16(data_in[word_idx]);
    return (half_sel == 0) ? unpacked.x : unpacked.y;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint half_n = n / 2;
    uint total_items = half_n * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / half_n;
    uint local_tid = tid % half_n;

    // Pack real[2k] as real part, real[2k+1] as imag part
    uint src_base = batch_idx * in_batch_stride;
    float re = readReal(src_base + local_tid * 2);
    float im = readReal(src_base + local_tid * 2 + 1);

    uint dst_base = batch_idx * out_batch_stride;
    data_out[dst_base + local_tid] = packHalf2x16(vec2(re, im));
}
