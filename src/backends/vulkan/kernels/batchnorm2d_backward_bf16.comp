#version 450
#extension GL_EXT_shader_atomic_float : enable

// Batch Normalization 2D Backward — Pass 1 for BFloat16.
//   grad_gamma[c] = sum over (n,h,w) of grad_out * (x - mean)/sqrt(var+eps)
//   grad_beta[c]  = sum over (n,h,w) of grad_out
// Pass 2 (batchnorm2d_backward_grad_input_bf16.comp) consumes these per-channel
// sums to compute grad_input with the correct training-mode batch-norm formula:
//   grad_in = gamma * invstd * (grad_out - sum_grad/N - normalized*sum_grad_norm/N)
// with N = batch * spatial_size.
//
// The previous single-pass BF16 shader returned only `grad_out * gamma * invstd`,
// which is the *inference-mode* backward — it dropped the two mean-correction
// terms required during training. It also accumulated grad_gamma/grad_beta into a
// 256-wide shared array hashed by channel index, silently dropping every channel
// >= 256 (e.g. ResNet 512/1024/2048). This pass-1 shader accumulates directly
// into the per-channel global buffers via atomicAdd, mirroring the corrected F32
// pass-1 shader (batchnorm2d_backward.comp).
//
// Input/grad tensors are packed BF16 (2 elements per 32-bit word).
// Statistics and parameter gradients are Float32.

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };   // Packed BF16 (N, C, H, W)
layout(binding = 1) buffer Input { uint input_data[]; };          // Packed BF16 (N, C, H, W)
layout(binding = 2) buffer Mean { float mean_data[]; };           // (C) Float32
layout(binding = 3) buffer InvStd { float invstd_data[]; };        // (C) Float32 - pre-computed 1/sqrt(var+eps)
layout(binding = 4) buffer Gamma { float gamma_data[]; };         // (C) Float32 - unused in pass 1
layout(binding = 5) buffer GradInput { uint grad_input[]; };      // written in pass 2
layout(binding = 6) buffer GradGamma { float grad_gamma[]; };     // (C) Float32 - accumulated atomically
layout(binding = 7) buffer GradBeta { float grad_beta[]; };       // (C) Float32 - accumulated atomically

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint spatial_size;
    float eps;
    uint has_gamma;
} params;

// Accumulate one element's grad_gamma/grad_beta contribution into the global
// per-channel buffers. half_idx selects which BF16 lane of the packed word.
void accumulateElement(uint flat_idx, uint word_idx, uint half_idx) {
    // Decode to get channel
    uint temp = flat_idx;
    temp /= params.spatial_size;
    uint c = temp % params.channels;

    // Read input and grad_output (packed BF16)
    uint packed_x = input_data[word_idx];
    uint packed_grad = grad_output[word_idx];
    float x = (half_idx == 0u) ? unpackBF16x2(packed_x).x : unpackBF16x2(packed_x >> 16).x;
    float grad_out = (half_idx == 0u) ? unpackBF16x2(packed_grad).x : unpackBF16x2(packed_grad >> 16).x;

    float mean = mean_data[c];
    float inv_std = invstd_data[c];
    float normalized = (x - mean) * inv_std;

    // Accumulate directly into the per-channel global buffers. Collisions are
    // resolved by atomicAdd; this trades throughput for correctness vs the old
    // shared-memory path that bounded c < 256 and dropped writes for higher
    // channels.
    atomicAdd(grad_gamma[c], grad_out * normalized);
    atomicAdd(grad_beta[c],  grad_out);
}

void main() {
    // Each thread processes one 32-bit word (2 BF16 elements).
    uint word_idx = gl_GlobalInvocationID.x;
    uint num_words = (params.n_elements + 1u) / 2u;
    if (word_idx >= num_words) return;

    uint elem0 = word_idx * 2u;
    uint elem1 = word_idx * 2u + 1u;

    if (elem0 < params.n_elements) {
        accumulateElement(elem0, word_idx, 0u);
    }
    if (elem1 < params.n_elements) {
        accumulateElement(elem1, word_idx, 1u);
    }
}
