#version 450

// Bit-reversal permutation for FFT input/output reordering — BFloat16
// Each complex element is one uint32 word (real in low 16, imag in high 16)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;            // FFT size (power of 2)
    uint log2_n;       // log2(n)
    uint batch_offset; // Offset in complex elements
};

uint bit_reverse(uint x, uint bits) {
    uint result = 0;
    for (uint i = 0; i < bits; i++) {
        result = (result << 1) | (x & 1);
        x >>= 1;
    }
    return result;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= n) return;

    uint rev = bit_reverse(tid, log2_n);

    // Copy complex element from position tid to position rev
    // Each complex element = 1 uint32 word
    data_out[batch_offset + rev] = data_in[batch_offset + tid];
}
