#version 450

// RepeatInterleave (scalar repeats) along a dimension — BFloat16 variant
// Uses packed uint32 words (2 bfloat16 elements per word)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint total_elements;
    uint repeats;
    uint dim_size;
    uint inner_size;
} params;

float readBF16(uint flat_idx) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (half_idx * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

void writeBF16(uint flat_idx, float val) {
    uint word_idx = flat_idx / 2;
    uint half_offset = (flat_idx % 2) * 16;
    uint new_bits = ((floatBitsToUint(val) + 0x7FFFu + ((floatBitsToUint(val) >> 16) & 1u)) >> 16);
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 1024; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;
    if (out_idx >= params.total_elements) return;

    uint inner_idx = out_idx % params.inner_size;
    uint dim_rep_idx = (out_idx / params.inner_size) % (params.dim_size * params.repeats);
    uint outer_idx = out_idx / (params.inner_size * params.dim_size * params.repeats);

    uint src_dim_idx = dim_rep_idx / params.repeats;

    uint src_idx = outer_idx * (params.dim_size * params.inner_size) +
                   src_dim_idx * params.inner_size +
                   inner_idx;

    writeBF16(out_idx, readBF16(src_idx));
}
