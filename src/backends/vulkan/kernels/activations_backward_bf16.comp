#version 450

// Backward activation functions for BFloat16 autograd
// Operations: 0=relu, 1=sigmoid, 2=tanh, 3=leaky_relu, 4=gelu
// BFloat16 elements are packed 2 per 32-bit word

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };
layout(binding = 1) buffer InputOrOutput { uint input_or_output[]; };
layout(binding = 2) buffer GradInput { uint grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation code
    float alpha;     // For leaky_relu_backward
} params;

const float PI = 3.14159265359;
const float sqrt_2_over_pi = 0.7978845608;
const float gelu_coeff = 0.044715;

// Helper to pack two bfloat16 values (round-to-nearest-even)
uint packBF16Pair(float v0, float v1) {
    uint b0 = floatBitsToUint(v0);
    uint b1 = floatBitsToUint(v1);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

float apply_backward(float g_out, float val) {
    switch (params.op) {
        case 0: // relu_backward: grad_output * (input > 0 ? 1 : 0)
            return (val > 0.0) ? g_out : 0.0;

        case 1: // sigmoid_backward: grad_output * output * (1 - output)
            // val is the output of sigmoid
            return g_out * val * (1.0 - val);

        case 2: // tanh_backward: grad_output * (1 - output * output)
            // val is the output of tanh
            return g_out * (1.0 - val * val);

        case 3: // leaky_relu_backward: grad_output * (input > 0 ? 1 : alpha)
            // val is the input
            return (val > 0.0) ? g_out : params.alpha * g_out;

        case 4: { // gelu_backward: Complex formula with tanh derivative
            // val is the input
            float x = val;
            float x_sq = x * x;
            float x_cubed = x_sq * x;

            float inner = sqrt_2_over_pi * (x + gelu_coeff * x_cubed);
            float tanh_inner = tanh(inner);
            float sech_sq = 1.0 - tanh_inner * tanh_inner;

            float derivative = 0.5 * (1.0 + tanh_inner) +
                             0.5 * x * sech_sq * sqrt_2_over_pi * (1.0 + 3.0 * gelu_coeff * x_sq);

            return g_out * derivative;
        }

        default:
            return 0.0;
    }
}

void main() {
    // Process 2 elements per thread (since bfloat16 is packed 2 per uint32)
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    if (idx0 >= params.n) {
        return;
    }

    // Read packed inputs
    uint packed_grad_out = grad_output[pair_idx];
    uint packed_val = input_or_output[pair_idx];

    // Unpack grad_output
    uint bits_g0 = packed_grad_out & 0xFFFFu;
    uint bits_g1 = (packed_grad_out >> 16) & 0xFFFFu;
    float g_out0 = uintBitsToFloat(bits_g0 << 16);
    float g_out1 = uintBitsToFloat(bits_g1 << 16);

    // Unpack input_or_output
    uint bits_v0 = packed_val & 0xFFFFu;
    uint bits_v1 = (packed_val >> 16) & 0xFFFFu;
    float val0 = uintBitsToFloat(bits_v0 << 16);
    float val1 = uintBitsToFloat(bits_v1 << 16);

    // Apply backward activation
    float result0 = apply_backward(g_out0, val0);
    float result1 = (idx1 < params.n) ? apply_backward(g_out1, val1) : 0.0;

    // Pack and write output
    grad_input[pair_idx] = packBF16Pair(result0, result1);
}
