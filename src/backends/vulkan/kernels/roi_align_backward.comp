#version 450
#extension GL_EXT_shader_atomic_float : require

// ROI Align Backward Pass (Float32)
// Distributes gradients from output back to feature map using bilinear weights
// Input: grad_output (num_rois, C, output_h, output_w), rois (num_rois, 5)
// Output: grad_features (N, C, H, W)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output_data[]; };
layout(binding = 1) buffer ROIs { float rois_data[]; };
layout(binding = 2) buffer GradFeatures { float grad_features_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total grad_output elements (num_rois * C * output_h * output_w)
    uint num_rois;
    uint channels;
    uint feat_height;
    uint feat_width;
    uint output_h;
    uint output_w;
    uint spatial_scale_bits;
    uint sampling_ratio;
    uint aligned;
    uint batch_size;          // N (for grad_features bounds)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (roi_idx, c, ph, pw)
    uint temp = idx;
    uint pw = temp % params.output_w;
    temp /= params.output_w;
    uint ph = temp % params.output_h;
    temp /= params.output_h;
    uint c = temp % params.channels;
    uint roi_idx = temp / params.channels;

    // Read ROI
    uint roi_base = roi_idx * 5;
    // Validate ROI batch index before scattering grad into features (unguarded
    // atomicAdd at an out-of-range batch_idx is an out-of-bounds device write).
    int batch_idx_signed = int(rois_data[roi_base]);
    if (batch_idx_signed < 0 || uint(batch_idx_signed) >= params.batch_size) {
        return;
    }
    uint batch_idx = uint(batch_idx_signed);
    float spatial_scale = uintBitsToFloat(params.spatial_scale_bits);

    float roi_x1 = rois_data[roi_base + 1] * spatial_scale;
    float roi_y1 = rois_data[roi_base + 2] * spatial_scale;
    float roi_x2 = rois_data[roi_base + 3] * spatial_scale;
    float roi_y2 = rois_data[roi_base + 4] * spatial_scale;

    if (params.aligned != 0) {
        roi_x1 -= 0.5;
        roi_y1 -= 0.5;
        roi_x2 -= 0.5;
        roi_y2 -= 0.5;
    }

    float roi_width = roi_x2 - roi_x1;
    float roi_height = roi_y2 - roi_y1;

    // Non-aligned mode clamps ROI extent to a minimum of 1 (torchvision / CPU
    // reference); the aligned path intentionally does not clamp. Must match the
    // forward kernel exactly or forward/backward sampling grids diverge.
    if (params.aligned == 0u) {
        roi_width = max(roi_width, 1.0);
        roi_height = max(roi_height, 1.0);
    }

    float bin_size_h = roi_height / float(params.output_h);
    float bin_size_w = roi_width / float(params.output_w);

    // Clamp adaptive grid to >= 1 (degenerate ROI -> bin_size<=0 -> count==0).
    uint roi_bin_grid_h = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : max(1u, uint(ceil(bin_size_h)));
    uint roi_bin_grid_w = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : max(1u, uint(ceil(bin_size_w)));

    uint count = roi_bin_grid_h * roi_bin_grid_w;
    float grad_val = grad_output_data[idx] / float(count);

    // Base offset in grad_features for this batch and channel
    uint base_offset = batch_idx * params.channels * params.feat_height * params.feat_width
                     + c * params.feat_height * params.feat_width;

    int height = int(params.feat_height);
    int width = int(params.feat_width);

    for (uint iy = 0; iy < roi_bin_grid_h; iy++) {
        for (uint ix = 0; ix < roi_bin_grid_w; ix++) {
            float y = roi_y1 + float(ph) * bin_size_h
                    + (float(iy) + 0.5) * bin_size_h / float(roi_bin_grid_h);
            float x = roi_x1 + float(pw) * bin_size_w
                    + (float(ix) + 0.5) * bin_size_w / float(roi_bin_grid_w);

            // Bounds check
            if (y < -1.0 || y > float(height) || x < -1.0 || x > float(width)) {
                continue;
            }

            y = max(0.0, min(y, float(height - 1)));
            x = max(0.0, min(x, float(width - 1)));

            int y_low = int(floor(y));
            int x_low = int(floor(x));
            int y_high = min(y_low + 1, height - 1);
            int x_high = min(x_low + 1, width - 1);

            float ly = y - float(y_low);
            float lx = x - float(x_low);
            float hy = 1.0 - ly;
            float hx = 1.0 - lx;

            // Distribute gradient to 4 neighbors using atomicAdd
            atomicAdd(grad_features_data[base_offset + y_low * width + x_low], grad_val * hy * hx);
            atomicAdd(grad_features_data[base_offset + y_low * width + x_high], grad_val * hy * lx);
            atomicAdd(grad_features_data[base_offset + y_high * width + x_low], grad_val * ly * hx);
            atomicAdd(grad_features_data[base_offset + y_high * width + x_high], grad_val * ly * lx);
        }
    }
}
