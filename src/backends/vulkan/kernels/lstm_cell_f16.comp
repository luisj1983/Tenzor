#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// LSTM Cell compute shader for Float16 -- processes one timestep
// Reads packed F16 pairs, computes in float32 for numerical stability
//
// Inputs:
//   binding 0: gates buffer (pre-computed linear: x*W_ih^T + h*W_hh^T + biases)
//              shape: [batch_size, 4 * hidden_size] -- layout: [i|f|g|o]
//   binding 1: c_prev -- previous cell state [batch_size, hidden_size]
//   binding 2: h_out -- output hidden state [batch_size, hidden_size]
//   binding 3: c_out -- output cell state [batch_size, hidden_size]
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Gates { uint gates[]; };       // Packed F16
layout(binding = 1) buffer CellPrev { uint c_prev[]; };   // Packed F16
layout(binding = 2) buffer HiddenOut { uint h_out[]; };   // Packed F16
layout(binding = 3) buffer CellOut { uint c_out[]; };     // Packed F16

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint hidden_size;
} params;

float readF16Gates(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = gates[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readF16CPrev(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = c_prev[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

// Write a single float16 value using a bounded atomicCompSwap. The dispatch
// launches one thread per (b,h) element, so two distinct concurrent threads
// (even idx and idx+1) target the same packed 32-bit word. A plain
// read-modify-write would let the last writer clobber the neighbouring
// half-word, corrupting h_out/c_out for half the hidden units. Mirror the
// safe pattern from log_softmax_backward_f16.comp.
void writeF16HOut(uint idx, float val) {
    uint word_idx = idx >> 1u;
    uint half_idx = idx & 1u;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = h_out[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(h_out[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT add a non-atomic fallback store -- it would clobber
    // the neighbouring packed half-word.
}

void writeF16COut(uint idx, float val) {
    uint word_idx = idx >> 1u;
    uint half_idx = idx & 1u;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = c_out[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(c_out[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT add a non-atomic fallback store -- it would clobber
    // the neighbouring packed half-word.
}

// Use exp()-based stable activations matching lstm_cell.comp (f32) exactly.
// The driver `tanh` intrinsic drifts >1e-3 from std::tanh on NVIDIA/Vulkan and
// breaks gradient parity; the backward shader recomputes from these values, so
// forward and backward must share the same stable formulation.
precise float sigmoid_stable(float x) {
    if (x >= 0.0) {
        float e = exp(-x);
        return 1.0 / (1.0 + e);
    } else {
        float e = exp(x);
        return e / (1.0 + e);
    }
}

// Stable tanh via sigmoid: tanh(x) = 2 * sigmoid(2x) - 1.
precise float tanh_stable(float x) {
    return 2.0 * sigmoid_stable(2.0 * x) - 1.0;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch_size * params.hidden_size;

    if (idx >= total) return;

    uint b = idx / params.hidden_size;
    uint h = idx % params.hidden_size;

    uint gate_base = b * (4 * params.hidden_size);

    float i_gate = sigmoid_stable(readF16Gates(gate_base + h));                              // input gate
    float f_gate = sigmoid_stable(readF16Gates(gate_base + params.hidden_size + h));         // forget gate
    float g_gate = tanh_stable(readF16Gates(gate_base + 2 * params.hidden_size + h));        // cell gate
    float o_gate = sigmoid_stable(readF16Gates(gate_base + 3 * params.hidden_size + h));     // output gate

    float c_new = f_gate * readF16CPrev(idx) + i_gate * g_gate;
    float h_new = o_gate * tanh_stable(c_new);

    writeF16COut(idx, c_new);
    writeF16HOut(idx, h_new);
}
