#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Argmax and Argmin operations
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { int64_t output_indices[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements
    uint reduce_size;    // Size of dimension to reduce
    uint outer_size;     // Number of output elements
    uint inner_size;     // Product of dimensions after reduction dim
    uint op;             // 0=argmax, 1=argmin
} params;

shared float shared_vals[WORKGROUP_SIZE];
shared int64_t shared_indices[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint output_idx = gl_WorkGroupID.x;

    // Each workgroup handles one output element
    if (output_idx >= params.outer_size) {
        return;
    }

    // Initialize with extreme values
    float best_value;
    int64_t best_index = -1L;

    if (params.op == 0) { // argmax
        best_value = -1.0 / 0.0; // -infinity
    } else { // argmin
        best_value = 1.0 / 0.0; // +infinity
    }

    // For dimensional reduction, compute proper indices
    // Calculate the position in output space
    uint outer_idx = output_idx / params.inner_size;
    uint inner_idx = output_idx % params.inner_size;

    // Starting position in input: outer_idx * (reduce_size * inner_size) + inner_idx
    uint base_idx = outer_idx * params.reduce_size * params.inner_size + inner_idx;

    // Each thread processes multiple elements along the reduction dimension
    for (uint i = tid; i < params.reduce_size; i += WORKGROUP_SIZE) {
        uint idx = base_idx + i * params.inner_size;
        if (idx < params.n) {
            float val = input_data[idx];

            if (params.op == 0) { // argmax
                if (val > best_value) {
                    best_value = val;
                    best_index = int64_t(i);
                }
            } else { // argmin
                if (val < best_value) {
                    best_value = val;
                    best_index = int64_t(i);
                }
            }
        }
    }

    shared_vals[tid] = best_value;
    shared_indices[tid] = best_index;
    barrier();

    // Parallel reduction in shared memory.
    // On value ties, keep the LOWEST source index to match the CPU/PyTorch
    // first-occurrence semantics. Strided partitioning means a lower-tid
    // thread can hold a higher source index than a higher-tid thread, so the
    // tie-break must compare indices explicitly rather than relying on tid.
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            float other_val = shared_vals[tid + s];
            int64_t other_idx = shared_indices[tid + s];
            int64_t cur_idx = shared_indices[tid];
            // Treat a slot that never observed an element (index == -1) as
            // always losing, so it can never win a value tie.
            bool other_valid = other_idx >= 0;
            bool cur_valid = cur_idx >= 0;
            bool take;
            if (params.op == 0) { // argmax
                take = other_valid && (!cur_valid ||
                       other_val > shared_vals[tid] ||
                       (other_val == shared_vals[tid] && other_idx < cur_idx));
            } else { // argmin
                take = other_valid && (!cur_valid ||
                       other_val < shared_vals[tid] ||
                       (other_val == shared_vals[tid] && other_idx < cur_idx));
            }
            if (take) {
                shared_vals[tid] = other_val;
                shared_indices[tid] = other_idx;
            }
        }
        barrier();
    }

    // Write result
    if (tid == 0) {
        output_indices[output_idx] = shared_indices[0];
    }
}
