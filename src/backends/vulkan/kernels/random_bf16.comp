#version 450

// GPU Random Number Generation for BFloat16 using Philox 4x32
// Generates values and converts to half precision
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint output_data[]; };  // Packed bfloat16 pairs

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint seed;
    uint offset;
    uint distribution;   // 0 = uniform, 1 = normal
} params;

const uint PHILOX_M0 = 0xD2511F53u;
const uint PHILOX_M1 = 0xCD9E8D57u;
const uint PHILOX_W0 = 0x9E3779B9u;
const uint PHILOX_W1 = 0xBB67AE85u;

uint mulhi(uint a, uint b) {
    uint a_lo = a & 0xFFFFu;
    uint a_hi = a >> 16;
    uint b_lo = b & 0xFFFFu;
    uint b_hi = b >> 16;
    uint p0 = a_lo * b_lo;
    uint p1 = a_lo * b_hi;
    uint p2 = a_hi * b_lo;
    uint p3 = a_hi * b_hi;
    uint carry = ((p0 >> 16) + (p1 & 0xFFFFu) + (p2 & 0xFFFFu)) >> 16;
    return p3 + (p1 >> 16) + (p2 >> 16) + carry;
}

void philox_round(inout uvec4 ctr, uvec2 key) {
    uint hi0 = mulhi(ctr.x, PHILOX_M0);
    uint lo0 = ctr.x * PHILOX_M0;
    uint hi1 = mulhi(ctr.z, PHILOX_M1);
    uint lo1 = ctr.z * PHILOX_M1;
    ctr = uvec4(hi1 ^ ctr.y ^ key.x, lo1, hi0 ^ ctr.w ^ key.y, lo0);
}

uvec4 philox4x32(uvec4 ctr, uvec2 key) {
    for (int i = 0; i < 10; i++) {
        philox_round(ctr, key);
        key.x += PHILOX_W0;
        key.y += PHILOX_W1;
    }
    return ctr;
}

float uint_to_float01(uint x) {
    return float(x >> 8) * (1.0 / 16777216.0);
}

vec2 box_muller(float u1, float u2) {
    u1 = max(u1, 1e-10);
    float r = sqrt(-2.0 * log(u1));
    float theta = 6.283185307179586 * u2;
    return vec2(r * cos(theta), r * sin(theta));
}

// Convert float to half-precision (IEEE 754)
uint float_to_half(float f) {
    uint bits = floatBitsToUint(f);
    uint sign = (bits >> 16) & 0x8000;
    int exp = int((bits >> 23) & 0xFF) - 127 + 15;
    uint mant = bits & 0x7FFFFF;

    if (exp <= 0) {
        if (exp < -10) return sign;
        mant |= 0x800000;
        uint shift = uint(14 - exp);
        mant >>= shift;
        return sign | mant;
    } else if (exp >= 31) {
        return sign | 0x7C00;
    }
    return sign | (uint(exp) << 10) | (mant >> 13);
}

void main() {
    // Each thread generates 2 bfloat16 values (one packed uint)
    uint idx = gl_GlobalInvocationID.x;
    uint word_idx = idx;

    if (word_idx * 2 >= params.n_elements) {
        return;
    }

    uint element_idx = word_idx * 2 + params.offset;
    uvec4 ctr = uvec4(element_idx, element_idx >> 16, 0, 0);
    uvec2 key = uvec2(params.seed, params.seed ^ 0xDEADBEEF);

    uvec4 rand_vals = philox4x32(ctr, key);

    float val0, val1;
    if (params.distribution == 0) {
        val0 = uint_to_float01(rand_vals.x);
        val1 = uint_to_float01(rand_vals.y);
    } else {
        float u1 = uint_to_float01(rand_vals.x);
        float u2 = uint_to_float01(rand_vals.y);
        vec2 normal = box_muller(u1, u2);
        val0 = normal.x;
        val1 = normal.y;
    }

    uint half0 = float_to_half(val0);
    uint half1 = float_to_half(val1);

    // Handle last element if n_elements is odd
    if (word_idx * 2 + 1 >= params.n_elements) {
        // Only write first half
        uint old_val = output_data[word_idx];
        output_data[word_idx] = (old_val & 0xFFFF0000) | half0;
    } else {
        output_data[word_idx] = half0 | (half1 << 16);
    }
}
