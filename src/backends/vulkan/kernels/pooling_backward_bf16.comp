#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Pooling backward pass (MaxPool2d and AvgPool2d gradients) for BFloat16
// Reads packed BF16 pairs, computes in float32 for stability
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { uint input_data[]; };       // Packed BF16 — Original input
layout(binding = 1) buffer GradOutput { uint grad_out[]; };    // Packed BF16 — Gradient from next layer
layout(binding = 2) buffer GradInput { uint grad_in[]; };      // Packed BF16 — Gradient to compute
layout(binding = 3) buffer Indices { int max_indices[]; };     // Max indices (for MaxPool)

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint in_height;
    uint in_width;
    uint out_height;
    uint out_width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint padding_h;
    uint padding_w;
    uint pool_type; // 0=max, 1=avg
} params;

float readBF16Input(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = input_data[word_idx];
    vec2 pair = unpackBF16x2(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readBF16GradOut(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = grad_out[word_idx];
    vec2 pair = unpackBF16x2(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

void writeBF16GradIn(uint idx, float val) {
    uint word_idx = idx >> 1u;
    uint packed = grad_in[word_idx];
    vec2 pair = unpackBF16x2(packed);
    if ((idx & 1u) == 0u) pair.x = val; else pair.y = val;
    grad_in[word_idx] = packBF16x2(pair);
}

void main() {
    uint in_x = gl_GlobalInvocationID.x;
    uint in_y = gl_GlobalInvocationID.y;
    uint c = gl_GlobalInvocationID.z;

    if (in_x >= params.in_width || in_y >= params.in_height ||
        c >= params.channels) {
        return;
    }

    uint input_idx = c * params.in_height * params.in_width +
                     in_y * params.in_width + in_x;

    float grad = 0.0;

    if (params.pool_type == 0) {
        // MaxPool backward: gradient flows only through max element
        for (uint out_y = 0; out_y < params.out_height; out_y++) {
            for (uint out_x = 0; out_x < params.out_width; out_x++) {
                int start_y = int(out_y * params.stride_h) - int(params.padding_h);
                int start_x = int(out_x * params.stride_w) - int(params.padding_w);

                if (int(in_y) >= start_y && int(in_y) < start_y + int(params.kernel_h) &&
                    int(in_x) >= start_x && int(in_x) < start_x + int(params.kernel_w)) {

                    uint out_idx = c * params.out_height * params.out_width +
                                   out_y * params.out_width + out_x;

                    int max_idx = max_indices[out_idx];
                    if (max_idx == int(input_idx)) {
                        grad += readBF16GradOut(out_idx);
                    }
                }
            }
        }
    } else {
        // AvgPool backward: distribute gradient evenly
        for (uint out_y = 0; out_y < params.out_height; out_y++) {
            for (uint out_x = 0; out_x < params.out_width; out_x++) {
                int start_y = int(out_y * params.stride_h) - int(params.padding_h);
                int start_x = int(out_x * params.stride_w) - int(params.padding_w);

                if (int(in_y) >= start_y && int(in_y) < start_y + int(params.kernel_h) &&
                    int(in_x) >= start_x && int(in_x) < start_x + int(params.kernel_w)) {

                    uint out_idx = c * params.out_height * params.out_width +
                                   out_y * params.out_width + out_x;

                    uint count = 0;
                    for (uint kh = 0; kh < params.kernel_h; kh++) {
                        for (uint kw = 0; kw < params.kernel_w; kw++) {
                            int ky = start_y + int(kh);
                            int kx = start_x + int(kw);
                            if (ky >= 0 && ky < int(params.in_height) &&
                                kx >= 0 && kx < int(params.in_width)) {
                                count++;
                            }
                        }
                    }

                    if (count > 0) {
                        grad += readBF16GradOut(out_idx) / float(count);
                    }
                }
            }
        }
    }

    writeBF16GradIn(input_idx, grad);
}
