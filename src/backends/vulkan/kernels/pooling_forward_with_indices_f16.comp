#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// MaxPool2d forward pass with index tracking for Float16
// Reads packed F16 pairs, computes in float32 for stability
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // Packed F16
layout(binding = 1) buffer Output { uint output_data[]; };  // Packed F16
layout(binding = 2) buffer Indices { int max_indices[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint in_height;
    uint in_width;
    uint out_height;
    uint out_width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint padding_h;
    uint padding_w;
} params;

float readF16Element(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = input_data[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

void writeF16Element(uint idx, float val) {
    uint word_idx = idx >> 1u;
    uint word_offset = idx & 1u;
    uint new_bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = word_offset * 16;
    uint mask = 0xFFFFu << shift;

    // Atomic compare-swap to avoid race when two threads write adjacent F16 elements
    uint old_val = output_data[word_idx];
    uint new_val, expected;
    do {
        expected = old_val;
        new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(output_data[word_idx], expected, new_val);
    } while (old_val != expected);
}

void main() {
    uint out_x = gl_GlobalInvocationID.x;
    uint out_y = gl_GlobalInvocationID.y;
    // z packs (batch, channel) — see the Float32 variant.
    uint bc = gl_GlobalInvocationID.z;
    uint c = bc % params.channels;
    uint b = bc / params.channels;

    if (out_x >= params.out_width || out_y >= params.out_height ||
        c >= params.channels || b >= params.batch) {
        return;
    }

    float max_val = -1.0 / 0.0; // -infinity
    int max_idx = -1;

    uint input_batch_base  = b * params.channels * params.in_height  * params.in_width;
    uint output_batch_base = b * params.channels * params.out_height * params.out_width;

    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int in_y = int(out_y * params.stride_h) - int(params.padding_h) + int(kh);
            int in_x = int(out_x * params.stride_w) - int(params.padding_w) + int(kw);

            if (in_y >= 0 && in_y < int(params.in_height) &&
                in_x >= 0 && in_x < int(params.in_width)) {
                uint input_idx = input_batch_base +
                                c * params.in_height * params.in_width +
                                uint(in_y) * params.in_width + uint(in_x);
                float value = readF16Element(input_idx);

                if (value > max_val) {
                    max_val = value;
                    max_idx = int(input_idx);
                }
            }
        }
    }

    // Write output
    uint output_idx = output_batch_base +
                     c * params.out_height * params.out_width +
                     out_y * params.out_width + out_x;
    writeF16Element(output_idx, max_val);
    max_indices[output_idx] = max_idx;
}
