#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Extract eigenvalues from quasi-upper-triangular (real Schur) form (Float64)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer MatrixT { float64_t T[]; };
layout(set = 0, binding = 1) buffer EigReal { float64_t eig_r[]; };
layout(set = 0, binding = 2) buffer EigImag { float64_t eig_i[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch_idx;
};

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (tid != 0) return;

    uint base = batch_idx * n * n;
    uint w_base = batch_idx * n;

    uint i = 0;
    while (i < n) {
        if (i + 1 >= n) {
            eig_r[w_base + i] = T[base + i * n + i];
            eig_i[w_base + i] = 0.0lf;
            i++;
        } else {
            float64_t sub = T[base + (i + 1) * n + i];
            if (abs(sub) < 1e-60lf) {
                eig_r[w_base + i] = T[base + i * n + i];
                eig_i[w_base + i] = 0.0lf;
                i++;
            } else {
                float64_t a = T[base + i * n + i];
                float64_t b = T[base + i * n + (i + 1)];
                float64_t c = T[base + (i + 1) * n + i];
                float64_t d = T[base + (i + 1) * n + (i + 1)];

                float64_t trace = a + d;
                float64_t det = a * d - b * c;
                float64_t disc = trace * trace - 4.0lf * det;

                if (disc >= 0.0lf) {
                    float64_t sq = sqrt(disc);
                    eig_r[w_base + i] = 0.5lf * (trace + sq);
                    eig_i[w_base + i] = 0.0lf;
                    eig_r[w_base + i + 1] = 0.5lf * (trace - sq);
                    eig_i[w_base + i + 1] = 0.0lf;
                } else {
                    float64_t sq = sqrt(-disc);
                    eig_r[w_base + i] = 0.5lf * trace;
                    eig_i[w_base + i] = 0.5lf * sq;
                    eig_r[w_base + i + 1] = 0.5lf * trace;
                    eig_i[w_base + i + 1] = -0.5lf * sq;
                }
                i += 2;
            }
        }
    }
}
