#version 450

// Reduction operations for int32: sum, mean, max, min
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { int input_data[]; };
layout(binding = 1) buffer Output { int output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements in input
    uint reduce_size;    // Size of dimension to reduce
    uint outer_size;     // Number of output elements
    uint inner_size;     // Product of dimensions after reduction dim
    uint op;             // 0=sum, 1=mean, 2=max, 3=min
} params;

shared int shared_data[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint output_idx = gl_WorkGroupID.x;

    if (output_idx >= params.outer_size) {
        return;
    }

    // Initialize accumulator based on operation
    int accum;
    if (params.op == 2) { // max
        accum = -2147483648; // INT_MIN
    } else if (params.op == 3) { // min
        accum = 2147483647; // INT_MAX
    } else {
        accum = 0;
    }

    uint outer_idx = output_idx / params.inner_size;
    uint inner_idx = output_idx % params.inner_size;
    uint base_idx = outer_idx * params.reduce_size * params.inner_size + inner_idx;

    // Each thread processes multiple elements along the reduction dimension
    for (uint i = tid; i < params.reduce_size; i += WORKGROUP_SIZE) {
        uint idx = base_idx + i * params.inner_size;
        if (idx < params.n) {
            int val = input_data[idx];
            switch (params.op) {
                case 0: // sum
                case 1: // mean
                    accum += val;
                    break;
                case 2: // max
                    accum = max(accum, val);
                    break;
                case 3: // min
                    accum = min(accum, val);
                    break;
            }
        }
    }

    shared_data[tid] = accum;
    barrier();

    // Parallel reduction in shared memory
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            switch (params.op) {
                case 0: // sum
                case 1: // mean
                    shared_data[tid] += shared_data[tid + s];
                    break;
                case 2: // max
                    shared_data[tid] = max(shared_data[tid], shared_data[tid + s]);
                    break;
                case 3: // min
                    shared_data[tid] = min(shared_data[tid], shared_data[tid + s]);
                    break;
            }
        }
        barrier();
    }

    // Write result
    if (tid == 0) {
        int result = shared_data[0];
        if (params.op == 1) { // mean - integer division
            result /= int(params.reduce_size);
        }
        output_data[output_idx] = result;
    }
}
