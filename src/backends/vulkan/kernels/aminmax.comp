#version 450

// Aminmax: compute min and max across all elements in a single pass.
// Dispatched as a single workgroup for full reduction.
// Output buffer: [0] = min, [1] = max
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input  { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
} params;

shared float s_min[WORKGROUP_SIZE];
shared float s_max[WORKGROUP_SIZE];

// NaN-propagating max/min (IEEE/PyTorch semantics). GLSL max()/min() return the
// non-NaN operand, so a plain reduction would silently drop NaNs. `x != x` is
// true iff x is NaN (see reduction.comp).
float nanmax(float a, float b) { return (a != a) ? a : ((b != b) ? b : max(a, b)); }
float nanmin(float a, float b) { return (a != a) ? a : ((b != b) ? b : min(a, b)); }

void main() {
    uint tid = gl_LocalInvocationID.x;

    float local_min =  1.0 / 0.0; // +inf
    float local_max = -1.0 / 0.0; // -inf

    for (uint i = tid; i < params.num_elements; i += WORKGROUP_SIZE) {
        float val = input_data[i];
        local_min = nanmin(local_min, val);
        local_max = nanmax(local_max, val);
    }

    s_min[tid] = local_min;
    s_max[tid] = local_max;
    barrier();

    // Tree reduction
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            s_min[tid] = nanmin(s_min[tid], s_min[tid + s]);
            s_max[tid] = nanmax(s_max[tid], s_max[tid + s]);
        }
        barrier();
    }

    if (tid == 0) {
        output_data[0] = s_min[0];
        output_data[1] = s_max[0];
    }
}
