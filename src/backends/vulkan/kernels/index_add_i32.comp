#version 450

// IndexAdd (Int32): atomically accumulates integer source values into output
// along a dimension. output[...][index[k]][...] += src[k]. Integer atomicAdd is
// core Vulkan (no extension / CAS loop needed). Narrow integers widen losslessly
// to Int32 on the host; Int64 narrows to Int32 (sparse counts/indices are in
// range). Previously every integer dtype fell through the Float32 shader, which
// reinterpreted integer bits as floats and produced garbage.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { int out_data[]; };       // Output (int atomics)
layout(binding = 1) buffer Source { int src_data[]; };        // Source values to add
layout(binding = 2) buffer Index { int idx_data[]; };          // 1-D index tensor

layout(push_constant) uniform PushConstants {
    uint outer;         // Product of dims before target dim
    uint dim_size;      // Size of target dim in output
    uint idx_n;         // Number of indices
    uint inner;         // Product of dims after target dim
} params;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total = params.outer * params.idx_n * params.inner;
    if (tid >= total) return;

    uint j = tid % params.inner;
    uint k = (tid / params.inner) % params.idx_n;
    uint o = tid / (params.inner * params.idx_n);

    int dest_idx = idx_data[k];
    if (dest_idx < 0) dest_idx += int(params.dim_size);  // wrap negatives (match CPU/OneAPI)
    if (dest_idx < 0 || dest_idx >= int(params.dim_size)) return;

    uint out_pos = (o * params.dim_size + uint(dest_idx)) * params.inner + j;
    uint src_pos = (o * params.idx_n + k) * params.inner + j;

    atomicAdd(out_data[out_pos], src_data[src_pos]);
}
