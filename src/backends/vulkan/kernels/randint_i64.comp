#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Randint for Int64: Generate random integers in [low, high) using Philox
// 4x32-10 PRNG.
//
// F042: bit-for-bit port of CPU's randint_kernel (src/backends/cpu/kernels/
// creation.cpp): draw a double-precision uniform in [0,1) via the same
// 53-bit-mantissa construction CPU's philox_uniform_f64 uses, then scale by
// the (double) range and truncate to int64 — NOT the previous
// `raw_bits64 % range` modulo-reduction scheme, which is a structurally
// different, non-CPU-matching range-mapping algorithm that produced
// plausible-looking but numerically wrong integers relative to CPU.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { int64_t output_data[]; };

// low/high are passed as 64-bit values split into two uint32 halves so the
// full Int64 range is representable. (The Int32 randint shader keeps int low/high.)
layout(push_constant) uniform PushConstants {
    uint n;
    uint low_lo;
    uint low_hi;
    uint high_lo;
    uint high_hi;
    uint seed_lo;         // Low 32 bits of the 64-bit global seed
    uint seed_hi;         // High 32 bits of the 64-bit global seed
    uint offset;
} params;

int64_t pack_i64(uint lo, uint hi) {
    return int64_t((uint64_t(hi) << 32u) | uint64_t(lo));
}

// Philox constants
const uint PHILOX_M0 = 0xD2511F53u;
const uint PHILOX_M1 = 0xCD9E8D57u;
const uint PHILOX_W0 = 0x9E3779B9u;
const uint PHILOX_W1 = 0xBB67AE85u;

uint mulhi(uint a, uint b) {
    uint a_lo = a & 0xFFFFu;
    uint a_hi = a >> 16;
    uint b_lo = b & 0xFFFFu;
    uint b_hi = b >> 16;

    uint p0 = a_lo * b_lo;
    uint p1 = a_lo * b_hi;
    uint p2 = a_hi * b_lo;
    uint p3 = a_hi * b_hi;

    uint carry = ((p0 >> 16) + (p1 & 0xFFFFu) + (p2 & 0xFFFFu)) >> 16;
    return p3 + (p1 >> 16) + (p2 >> 16) + carry;
}

void philox_round(inout uvec4 ctr, uvec2 key) {
    uint hi0 = mulhi(ctr.x, PHILOX_M0);
    uint lo0 = ctr.x * PHILOX_M0;
    uint hi1 = mulhi(ctr.z, PHILOX_M1);
    uint lo1 = ctr.z * PHILOX_M1;

    ctr = uvec4(hi1 ^ ctr.y ^ key.x, lo1, hi0 ^ ctr.w ^ key.y, lo0);
}

uvec4 philox4x32(uvec4 ctr, uvec2 key) {
    for (int i = 0; i < 10; i++) {
        philox_round(ctr, key);
        key.x += PHILOX_W0;
        key.y += PHILOX_W1;
    }
    return ctr;
}

// Convert two uint32s to double in [0, 1) with a 53-bit mantissa — matches
// CPU's philox_uniform_f64 exactly: mantissa = (hi << 21) | (lo >> 11).
double uints_to_double01(uint hi, uint lo) {
    double mantissa = double(hi) * 2097152.0LF + double(lo >> 11);
    return mantissa / 9007199254740992.0LF; // 2^53
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;

    // Counter/key layout matches CPU's philox.hpp exactly — see random.comp.
    uint element_idx = idx + params.offset;
    uvec4 ctr = uvec4(element_idx, 0u, 0u, 0u);
    uvec2 key = uvec2(params.seed_lo, params.seed_hi);

    uvec4 rand_vals = philox4x32(ctr, key);

    int64_t low  = pack_i64(params.low_lo, params.low_hi);
    int64_t high = pack_i64(params.high_lo, params.high_hi);

    // Map uniform [0, 1) (double precision) to integer range [low, high),
    // exactly as CPU: low + int64_t(u * range), clamped. `range` is the
    // int64 difference converted to double (matching CPU's
    // `static_cast<double>(high - low)`), not two separately-converted
    // endpoints subtracted — the two agree unless |low|/|high| exceed
    // double's 2^53 exact-integer range, in which case the int64
    // subtraction-first order matches CPU bit-for-bit.
    double u = uints_to_double01(rand_vals.x, rand_vals.y);
    double range = double(high - low);

    int64_t result = low + int64_t(u * range);

    if (result >= high) result = high - 1;
    if (result < low) result = low;

    output_data[idx] = result;
}
