#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Randint for Int64: Generate random integers in [low, high) using Philox 4x32-10 PRNG
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { int64_t output_data[]; };

// low/high are passed as 64-bit values split into two uint32 halves so the
// full Int64 range is representable. (The Int32 randint shader keeps int low/high.)
layout(push_constant) uniform PushConstants {
    uint n;
    uint low_lo;
    uint low_hi;
    uint high_lo;
    uint high_hi;
    uint seed;
    uint offset;
} params;

int64_t pack_i64(uint lo, uint hi) {
    return int64_t((uint64_t(hi) << 32u) | uint64_t(lo));
}

// Philox constants
const uint PHILOX_M0 = 0xD2511F53u;
const uint PHILOX_M1 = 0xCD9E8D57u;
const uint PHILOX_W0 = 0x9E3779B9u;
const uint PHILOX_W1 = 0xBB67AE85u;

uint mulhi(uint a, uint b) {
    uint a_lo = a & 0xFFFFu;
    uint a_hi = a >> 16;
    uint b_lo = b & 0xFFFFu;
    uint b_hi = b >> 16;

    uint p0 = a_lo * b_lo;
    uint p1 = a_lo * b_hi;
    uint p2 = a_hi * b_lo;
    uint p3 = a_hi * b_hi;

    uint carry = ((p0 >> 16) + (p1 & 0xFFFFu) + (p2 & 0xFFFFu)) >> 16;
    return p3 + (p1 >> 16) + (p2 >> 16) + carry;
}

void philox_round(inout uvec4 ctr, uvec2 key) {
    uint hi0 = mulhi(ctr.x, PHILOX_M0);
    uint lo0 = ctr.x * PHILOX_M0;
    uint hi1 = mulhi(ctr.z, PHILOX_M1);
    uint lo1 = ctr.z * PHILOX_M1;

    ctr = uvec4(hi1 ^ ctr.y ^ key.x, lo1, hi0 ^ ctr.w ^ key.y, lo0);
}

uvec4 philox4x32(uvec4 ctr, uvec2 key) {
    for (int i = 0; i < 10; i++) {
        philox_round(ctr, key);
        key.x += PHILOX_W0;
        key.y += PHILOX_W1;
    }
    return ctr;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;

    uint element_idx = idx + params.offset;
    uvec4 ctr = uvec4(element_idx, element_idx >> 16, 0, 0);
    uvec2 key = uvec2(params.seed, params.seed ^ 0xDEADBEEF);

    uvec4 rand_vals = philox4x32(ctr, key);

    int64_t low  = pack_i64(params.low_lo, params.low_hi);
    int64_t high = pack_i64(params.high_lo, params.high_hi);

    // Combine two 32-bit Philox words into a 64-bit uniform value, then reduce
    // modulo the (unsigned) range. Modulo avoids float precision loss across the
    // full 64-bit range; a small modulo bias is acceptable for randint.
    uint64_t rand64 = (uint64_t(rand_vals.y) << 32u) | uint64_t(rand_vals.x);
    uint64_t range = uint64_t(high - low);

    int64_t result;
    if (range == uint64_t(0)) {
        result = low;  // empty/degenerate range guard
    } else {
        result = low + int64_t(rand64 % range);
    }

    if (result >= high) result = high - 1;
    if (result < low) result = low;

    output_data[idx] = result;
}
