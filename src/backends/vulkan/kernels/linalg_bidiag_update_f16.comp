#version 450

// Blocked bidiagonal reduction — apply reflections to trailing submatrix — Float16 variant
// Float16 elements packed 2 per 32-bit word, all computation in float32.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer MatrixA { uint A[]; };
layout(set = 0, binding = 1) readonly buffer TauL { uint tau_l_buf[]; };
layout(set = 0, binding = 2) readonly buffer TauR { uint tau_r_buf[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

shared float dot_val;

// Read Float16 from matrix A
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = A[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write Float16 to matrix A
void writeF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = A[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(A[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word (X.7 / Y.11 / Y.16).
}

// Read Float16 from tau_l buffer
float readF16TauL(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = tau_l_buf[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Read Float16 from tau_r buffer
float readF16TauR(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = tau_r_buf[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint elem_base = batch_idx * n * n;
    uint trail_start = col_start + panel_cols;

    uint j = trail_start + gl_WorkGroupID.x;
    if (j >= n) return;

    // ---- Apply left Householder reflections to column j ----
    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;
        float left_tau = readF16TauL(batch_idx * n + col);
        if (abs(left_tau) < 1e-30) continue;

        if (tid == 0) {
            float dot = readF16(elem_base + col * n + j);
            for (uint r = col + 1; r < n; r++) {
                dot += readF16(elem_base + r * n + col) * readF16(elem_base + r * n + j);
            }
            dot_val = dot;
        }
        barrier();

        float dot = dot_val;

        for (uint r = col + 1 + tid; r < n; r += 256) {
            float v_r = readF16(elem_base + r * n + col);
            float cur = readF16(elem_base + r * n + j);
            writeF16(elem_base + r * n + j, cur - left_tau * v_r * dot);
        }
        if (tid == 0) {
            float cur = readF16(elem_base + col * n + j);
            writeF16(elem_base + col * n + j, cur - left_tau * dot);
        }
        barrier();
    }

    // ---- Apply right Householder reflections to row j ----
    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;
        if (col + 2 >= n) continue;

        float right_tau = readF16TauR(batch_idx * n + col);
        if (abs(right_tau) < 1e-30) continue;

        if (tid == 0) {
            float dot = readF16(elem_base + j * n + (col + 1));
            for (uint c = col + 2; c < n; c++) {
                dot += readF16(elem_base + j * n + c) * readF16(elem_base + col * n + c);
            }
            dot_val = dot;
        }
        barrier();

        float dot = dot_val;

        for (uint c = col + 2 + tid; c < n; c += 256) {
            float v_r = readF16(elem_base + col * n + c);
            float cur = readF16(elem_base + j * n + c);
            writeF16(elem_base + j * n + c, cur - right_tau * dot * v_r);
        }
        if (tid == 0) {
            float cur = readF16(elem_base + j * n + (col + 1));
            writeF16(elem_base + j * n + (col + 1), cur - right_tau * dot);
        }
        barrier();
    }
}
