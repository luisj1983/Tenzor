#version 450

// Extract eigenvalues from quasi-upper-triangular (real Schur) form.
// Walks diagonal blocks: 1x1 block = real eigenvalue, 2x2 block = complex pair.
// One workgroup per batch element, thread 0 does the serial walk.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer MatrixT { float T[]; };  // Quasi-upper-triangular n×n
layout(set = 0, binding = 1) buffer EigReal { float eig_r[]; };       // Real parts of eigenvalues
layout(set = 0, binding = 2) buffer EigImag { float eig_i[]; };       // Imaginary parts

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch_idx;
};

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (tid != 0) return;

    uint base = batch_idx * n * n;
    uint w_base = batch_idx * n;

    uint i = 0;
    while (i < n) {
        if (i + 1 >= n) {
            // Last diagonal element — real eigenvalue
            eig_r[w_base + i] = T[base + i * n + i];
            eig_i[w_base + i] = 0.0;
            i++;
        } else {
            // Check if there's a 2x2 block (non-zero subdiagonal)
            float sub = T[base + (i + 1) * n + i];
            if (abs(sub) < 1e-30) {
                // 1x1 block — real eigenvalue
                eig_r[w_base + i] = T[base + i * n + i];
                eig_i[w_base + i] = 0.0;
                i++;
            } else {
                // 2x2 block — solve quadratic for complex conjugate pair
                float a = T[base + i * n + i];
                float b = T[base + i * n + (i + 1)];
                float c = T[base + (i + 1) * n + i];
                float d = T[base + (i + 1) * n + (i + 1)];

                float trace = a + d;
                float det = a * d - b * c;
                float disc = trace * trace - 4.0 * det;

                if (disc >= 0.0) {
                    // Two real eigenvalues
                    float sq = sqrt(disc);
                    eig_r[w_base + i] = 0.5 * (trace + sq);
                    eig_i[w_base + i] = 0.0;
                    eig_r[w_base + i + 1] = 0.5 * (trace - sq);
                    eig_i[w_base + i + 1] = 0.0;
                } else {
                    // Complex conjugate pair
                    float sq = sqrt(-disc);
                    eig_r[w_base + i] = 0.5 * trace;
                    eig_i[w_base + i] = 0.5 * sq;
                    eig_r[w_base + i + 1] = 0.5 * trace;
                    eig_i[w_base + i + 1] = -0.5 * sq;
                }
                i += 2;
            }
        }
    }
}
