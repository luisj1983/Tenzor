#version 450

// Bitwise NOT (int32)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer { int data[]; } input_buf;
layout(set = 0, binding = 1) writeonly buffer OutputBuffer { int data[]; } output_buf;

layout(push_constant) uniform PushConstants { uint num_elements; } pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    output_buf.data[idx] = ~input_buf.data[idx];
}
