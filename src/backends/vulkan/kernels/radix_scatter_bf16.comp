#version 450

layout(local_size_x_id = 0) in;

// BF16 sort: keys stored as individual uint16 values packed in uint32 pairs
// But for sorting we need individual access, so we use a flat uint16 view via uint buffer
layout(set = 0, binding = 0) readonly buffer KeysIn   { uint keys_in[];   };  // packed bf16 pairs
layout(set = 0, binding = 1) readonly buffer IdxIn    { int idx_in[];     };
layout(set = 0, binding = 2) buffer KeysOut            { uint keys_out[];  };
layout(set = 0, binding = 3) buffer IdxOut             { int idx_out[];    };
layout(set = 0, binding = 4) buffer Histograms         { uint histos[];    };

layout(push_constant) uniform PushConstants {
    uint n;
    uint digit;  // 0 or 1 for 16-bit keys
    uint n_wgs;
};

shared uint local_offsets[256];

uint bf16_to_sortable(uint bits16) {
    // BFloat16 sign-bit flip for correct ordering
    uint mask = uint(-int(bits16 >> 15)) | 0x8000u;
    return (bits16 ^ mask) & 0xFFFFu;
}

uint readBF16Bits(uint element_idx) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint packed = keys_in[pair_idx];
    return (packed >> (offset * 16)) & 0xFFFFu;
}

void writeBF16Bits(uint element_idx, uint bits16) {
    uint pair_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_half = (bits16 & 0xFFFFu) << half_offset;
    uint mask = 0xFFFFu << half_offset;

    // Two BF16 keys share one uint32 word. Concurrent invocations may target
    // the two halves of the same word (e.g. consecutive dest = 2k, 2k+1 from
    // atomicAdd), so a plain read-modify-write would drop one key. Use an
    // atomicCompSwap retry loop to make the half-word update race-free
    // (same pattern as index_select_bf16.comp writeBF16).
    uint old_word = keys_out[pair_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | new_half;
        uint result = atomicCompSwap(keys_out[pair_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    for (uint b = lid; b < 256u; b += gl_WorkGroupSize.x) {
        local_offsets[b] = histos[b * n_wgs + wg_id];
    }
    barrier();

    uint tile_size = (n + n_wgs - 1) / n_wgs;
    uint tile_start = wg_id * tile_size;
    uint tile_end = min(tile_start + tile_size, n);

    // STABILITY (see radix_scatter.comp): scatter the tile in strict index
    // order from a single lane so equal-digit elements keep ascending-index
    // order. A parallel atomicAdd assigns slots in arbitration order, breaking
    // LSD-radix stability and diverging from the stable CPU reference.
    barrier();
    if (lid == 0u) {
        for (uint i = tile_start; i < tile_end; ++i) {
            uint bits16 = readBF16Bits(i);
            uint sortable = bf16_to_sortable(bits16);
            uint digit_val = (sortable >> (digit * 8)) & 0xFFu;
            uint dest = local_offsets[digit_val];
            local_offsets[digit_val] = dest + 1u;
            writeBF16Bits(dest, bits16);
            idx_out[dest] = idx_in[i];
        }
    }
}
