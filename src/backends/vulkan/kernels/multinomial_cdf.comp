#version 450

// Multinomial CDF: serial inclusive prefix sum over a small array.
// Single-task by design (num_categories is typically small, ≤1024).
// Dispatched with local_size=1, single workgroup.

layout(local_size_x = 1) in;

layout(binding = 0) buffer ProbsBuf { float probs[]; };
layout(binding = 1) buffer CdfBuf   { float cdf[]; };

layout(push_constant) uniform PushConstants {
    uint num_categories;
    uint probs_offset;
    uint cdf_offset;
} params;

void main() {
    if (gl_GlobalInvocationID.x != 0u) return;
    float acc = 0.0;
    for (uint i = 0; i < params.num_categories; ++i) {
        acc += probs[params.probs_offset + i];
        cdf[params.cdf_offset + i] = acc;
    }
}
