#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Stockham mixed-radix FFT: radix-5 butterfly stage (Float64)
// Data layout: interleaved real/imag pairs
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float64_t data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint stage_stride;
    uint direction;
    uint batch_offset;
};

const float64_t PI = 3.14159265358979323846lf;
const float64_t COS_2PI_5 = 0.30901699437148lf;
const float64_t SIN_2PI_5 = 0.95105651629515lf;
const float64_t COS_4PI_5 = -0.80901699437148lf;
const float64_t SIN_4PI_5 = 0.58778525229247lf;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 5;
    if (tid >= n_butterflies) return;

    uint group = tid / stage_stride;
    uint pos = tid % stage_stride;

    uint i0 = group * stage_stride * 5 + pos;
    uint i1 = i0 + stage_stride;
    uint i2 = i1 + stage_stride;
    uint i3 = i2 + stage_stride;
    uint i4 = i3 + stage_stride;

    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;
    uint o2 = o1 + n_butterflies;
    uint o3 = o2 + n_butterflies;
    uint o4 = o3 + n_butterflies;

    // Twiddle factors
    float64_t base_angle = -2.0lf * PI * float64_t(pos) / float64_t(stage_stride * 5);
    if (direction == 1) base_angle = -base_angle;

    // Load with twiddle
    float64_t a0_re = data_in[(batch_offset+i0)*2], a0_im = data_in[(batch_offset+i0)*2+1];

    float64_t w1_re = float64_t(cos(float(base_angle))), w1_im = float64_t(sin(float(base_angle)));
    float64_t r1 = data_in[(batch_offset+i1)*2], j1 = data_in[(batch_offset+i1)*2+1];
    float64_t a1_re = r1*w1_re - j1*w1_im, a1_im = r1*w1_im + j1*w1_re;

    float64_t w2_re = float64_t(cos(float(2.0lf*base_angle))), w2_im = float64_t(sin(float(2.0lf*base_angle)));
    float64_t r2 = data_in[(batch_offset+i2)*2], j2 = data_in[(batch_offset+i2)*2+1];
    float64_t a2_re = r2*w2_re - j2*w2_im, a2_im = r2*w2_im + j2*w2_re;

    float64_t w3_re = float64_t(cos(float(3.0lf*base_angle))), w3_im = float64_t(sin(float(3.0lf*base_angle)));
    float64_t r3 = data_in[(batch_offset+i3)*2], j3 = data_in[(batch_offset+i3)*2+1];
    float64_t a3_re = r3*w3_re - j3*w3_im, a3_im = r3*w3_im + j3*w3_re;

    float64_t w4_re = float64_t(cos(float(4.0lf*base_angle))), w4_im = float64_t(sin(float(4.0lf*base_angle)));
    float64_t r4 = data_in[(batch_offset+i4)*2], j4 = data_in[(batch_offset+i4)*2+1];
    float64_t a4_re = r4*w4_re - j4*w4_im, a4_im = r4*w4_im + j4*w4_re;

    // 5-point DFT using Rader's trick
    float64_t s1_re = a1_re + a4_re, s1_im = a1_im + a4_im;
    float64_t d1_re = a1_re - a4_re, d1_im = a1_im - a4_im;
    float64_t s2_re = a2_re + a3_re, s2_im = a2_im + a3_im;
    float64_t d2_re = a2_re - a3_re, d2_im = a2_im - a3_im;

    data_out[(batch_offset+o0)*2]   = a0_re + s1_re + s2_re;
    data_out[(batch_offset+o0)*2+1] = a0_im + s1_im + s2_im;

    data_out[(batch_offset+o1)*2]   = a0_re + COS_2PI_5*s1_re + COS_4PI_5*s2_re - SIN_2PI_5*d1_im - SIN_4PI_5*d2_im;
    data_out[(batch_offset+o1)*2+1] = a0_im + COS_2PI_5*s1_im + COS_4PI_5*s2_im + SIN_2PI_5*d1_re + SIN_4PI_5*d2_re;

    data_out[(batch_offset+o2)*2]   = a0_re + COS_4PI_5*s1_re + COS_2PI_5*s2_re - SIN_4PI_5*d1_im + SIN_2PI_5*d2_im;
    data_out[(batch_offset+o2)*2+1] = a0_im + COS_4PI_5*s1_im + COS_2PI_5*s2_im + SIN_4PI_5*d1_re - SIN_2PI_5*d2_re;

    data_out[(batch_offset+o3)*2]   = a0_re + COS_4PI_5*s1_re + COS_2PI_5*s2_re + SIN_4PI_5*d1_im - SIN_2PI_5*d2_im;
    data_out[(batch_offset+o3)*2+1] = a0_im + COS_4PI_5*s1_im + COS_2PI_5*s2_im - SIN_4PI_5*d1_re + SIN_2PI_5*d2_re;

    data_out[(batch_offset+o4)*2]   = a0_re + COS_2PI_5*s1_re + COS_4PI_5*s2_re + SIN_2PI_5*d1_im + SIN_4PI_5*d2_im;
    data_out[(batch_offset+o4)*2+1] = a0_im + COS_2PI_5*s1_im + COS_4PI_5*s2_im - SIN_2PI_5*d1_re - SIN_4PI_5*d2_re;
}
