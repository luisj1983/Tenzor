#version 450

// Phase 8.4: pack per-column min/max + bin counts into the (D × 2) dim_params
// buffer used by histogramdd. Eliminates the D-element host readback in the
// auto-range path. Each invocation handles one dimension d.
//
// dim_params[2d + 0] = adjusted min
// dim_params[2d + 1] = step = (adjusted_max - adjusted_min) / bins[d]
// adj_min/adj_max widen the range by 0.5 if vmin == vmax (matches host code).

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer ColMinBuf  { float col_min[]; };
layout(binding = 1) buffer ColMaxBuf  { float col_max[]; };
layout(binding = 2) buffer BinsBuf    { int   bins[]; };
layout(binding = 3) buffer ParamsBuf  { float dim_params[]; };

layout(push_constant) uniform PushConstants {
    uint D;
} params;

void main() {
    uint d = gl_GlobalInvocationID.x;
    if (d >= params.D) return;

    float vmin = col_min[d];
    float vmax = col_max[d];
    if (vmin == vmax) {
        vmin -= 0.5;
        vmax += 0.5;
    }
    float step = (vmax - vmin) / float(bins[d]);

    dim_params[d * 2u + 0u] = vmin;
    dim_params[d * 2u + 1u] = step;
}
