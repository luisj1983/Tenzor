#version 450
#extension GL_EXT_shader_atomic_float : enable

// Trilinear backward (5D) via VK_EXT_shader_atomic_float fetch_add scatter.
// Mirrors the CPU reference (interpolate_trilinear_backward_impl): one
// work-item per output element scatters into 8 input corners. The source
// coordinate is CLAMPED to [0, in-1] before flooring and the upper corner is
// clamped to min(base+1, in-1), exactly like the forward/CPU path. This makes
// the backward the exact transpose of the forward at the borders — no tap is
// ever dropped, so border-output gradient mass that the forward assigned to
// index 0 is correctly accumulated there (a raw floor + out-of-bounds skip
// would silently lose the (1-frac) border mass and break CPU parity).

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, out_d, out_h, out_w)
layout(binding = 1) buffer GradInput  { float grad_input[]; };   // (N, C, in_d, in_h, in_w)

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint in_d;
    uint in_h;
    uint in_w;
    uint out_d;
    uint out_h;
    uint out_w;
    uint align_corners;
} params;

void tri_add(uint base, int dd, int hh, int ww, float val) {
    // After clamping in main() all corner indices are guaranteed in-bounds;
    // the bounds check is retained purely as a defensive guard and never
    // drops a tap on the valid grids the dispatcher produces.
    if (dd < 0 || dd >= int(params.in_d) ||
        hh < 0 || hh >= int(params.in_h) ||
        ww < 0 || ww >= int(params.in_w)) return;
    atomicAdd(grad_input[base + uint(dd) * params.in_h * params.in_w + uint(hh) * params.in_w + uint(ww)], val);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint ow = temp % params.out_w; temp /= params.out_w;
    uint oh = temp % params.out_h; temp /= params.out_h;
    uint od = temp % params.out_d; temp /= params.out_d;
    uint c  = temp % params.channels; temp /= params.channels;
    uint b  = temp;

    float scd = (params.align_corners != 0u && params.out_d > 1u)
        ? float(params.in_d - 1u) / float(params.out_d - 1u) : float(params.in_d) / float(params.out_d);
    float sch = (params.align_corners != 0u && params.out_h > 1u)
        ? float(params.in_h - 1u) / float(params.out_h - 1u) : float(params.in_h) / float(params.out_h);
    float scw = (params.align_corners != 0u && params.out_w > 1u)
        ? float(params.in_w - 1u) / float(params.out_w - 1u) : float(params.in_w) / float(params.out_w);
    float sd = (params.align_corners != 0u) ? float(od) * scd : (float(od) + 0.5) * scd - 0.5;
    float sh = (params.align_corners != 0u) ? float(oh) * sch : (float(oh) + 0.5) * sch - 0.5;
    float sw = (params.align_corners != 0u) ? float(ow) * scw : (float(ow) + 0.5) * scw - 0.5;
    // Clamp the source coordinate to [0, in-1] before flooring, mirroring the
    // CPU reference. This keeps every fractional weight in [0,1) and every
    // corner index in-bounds so the backward is the exact transpose of the
    // forward at the borders (no dropped (1-frac) mass).
    sd = clamp(sd, 0.0, float(params.in_d - 1u));
    sh = clamp(sh, 0.0, float(params.in_h - 1u));
    sw = clamp(sw, 0.0, float(params.in_w - 1u));
    int d0 = int(floor(sd)), h0 = int(floor(sh)), w0 = int(floor(sw));
    int d1 = min(d0 + 1, int(params.in_d) - 1);
    int h1 = min(h0 + 1, int(params.in_h) - 1);
    int w1 = min(w0 + 1, int(params.in_w) - 1);
    float fd = sd - float(d0), fh = sh - float(h0), fw = sw - float(w0);

    float g = grad_output[idx];
    uint base = b * (params.channels * params.in_d * params.in_h * params.in_w)
              + c * (params.in_d * params.in_h * params.in_w);
    tri_add(base, d0, h0, w0, (1.0 - fd) * (1.0 - fh) * (1.0 - fw) * g);
    tri_add(base, d0, h0, w1, (1.0 - fd) * (1.0 - fh) * fw * g);
    tri_add(base, d0, h1, w0, (1.0 - fd) * fh * (1.0 - fw) * g);
    tri_add(base, d0, h1, w1, (1.0 - fd) * fh * fw * g);
    tri_add(base, d1, h0, w0, fd * (1.0 - fh) * (1.0 - fw) * g);
    tri_add(base, d1, h0, w1, fd * (1.0 - fh) * fw * g);
    tri_add(base, d1, h1, w0, fd * fh * (1.0 - fw) * g);
    tri_add(base, d1, h1, w1, fd * fh * fw * g);
}
