#version 450

// Tiled matrix multiplication with shared memory — per-vendor workgroup specialization
layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout(constant_id = 0) const uint TILE_X = 16;  // default fallback
layout(constant_id = 1) const uint TILE_Y = 16;  // default fallback

layout(binding = 0) buffer readonly MatA { float data[]; } a_buf;
layout(binding = 1) buffer readonly MatB { float data[]; } b_buf;
layout(binding = 2) buffer writeonly MatC { float data[]; } c_buf;

layout(push_constant) uniform PushConstants {
    uint M, N, K;
} params;

shared float tile_a[TILE_Y][TILE_X];
shared float tile_b[TILE_X][TILE_X];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;
    uint linear_id = local_row * TILE_X + local_col;
    uint num_threads = TILE_X * TILE_Y;

    float acc = 0.0;
    uint num_tiles = (params.K + TILE_X - 1u) / TILE_X;

    for (uint t = 0u; t < num_tiles; t++) {
        // Load tile of A into shared memory: TILE_Y x TILE_X, one per thread
        uint a_col = t * TILE_X + local_col;
        if (row < params.M && a_col < params.K)
            tile_a[local_row][local_col] = a_buf.data[row * params.K + a_col];
        else
            tile_a[local_row][local_col] = 0.0;

        // Load tile of B into shared memory: TILE_X x TILE_X, linearized
        for (uint i = linear_id; i < TILE_X * TILE_X; i += num_threads) {
            uint br = i / TILE_X;
            uint bc = i % TILE_X;
            uint b_row = t * TILE_X + br;
            uint b_col = gl_WorkGroupID.x * TILE_X + bc;
            if (b_row < params.K && b_col < params.N)
                tile_b[br][bc] = b_buf.data[b_row * params.N + b_col];
            else
                tile_b[br][bc] = 0.0;
        }

        barrier();

        // Compute partial dot product over TILE_X elements along K
        for (uint k = 0u; k < TILE_X; k++) {
            acc += tile_a[local_row][k] * tile_b[k][local_col];
        }

        barrier();
    }

    // Write result
    if (row < params.M && col < params.N) {
        c_buf.data[row * params.N + col] = acc;
    }
}
