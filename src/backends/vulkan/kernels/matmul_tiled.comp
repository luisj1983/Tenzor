#version 450

// Tiled matrix multiplication with shared memory
// Fixed 16x16 tile size for optimal shared memory usage
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer readonly MatA { float data[]; } a_buf;
layout(binding = 1) buffer readonly MatB { float data[]; } b_buf;
layout(binding = 2) buffer writeonly MatC { float data[]; } c_buf;

layout(push_constant) uniform PushConstants {
    uint M, N, K;
} params;

shared float tile_a[16][16];
shared float tile_b[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    float acc = 0.0;
    uint num_tiles = (params.K + 15u) / 16u;

    for (uint t = 0u; t < num_tiles; t++) {
        // Load tile of A into shared memory
        uint a_col = t * 16u + local_col;
        if (row < params.M && a_col < params.K)
            tile_a[local_row][local_col] = a_buf.data[row * params.K + a_col];
        else
            tile_a[local_row][local_col] = 0.0;

        // Load tile of B into shared memory
        uint b_row = t * 16u + local_row;
        if (b_row < params.K && col < params.N)
            tile_b[local_row][local_col] = b_buf.data[b_row * params.N + col];
        else
            tile_b[local_row][local_col] = 0.0;

        barrier();

        // Compute partial dot product
        for (uint k = 0u; k < 16u; k++) {
            acc += tile_a[local_row][k] * tile_b[k][local_col];
        }

        barrier();
    }

    // Write result
    if (row < params.M && col < params.N) {
        c_buf.data[row * params.N + col] = acc;
    }
}
