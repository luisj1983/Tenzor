#version 450

// Fused Adam optimizer step (Float32)
// Standard Adam with bias correction, optional weight decay (decoupled / L2),
// and optional AMSGrad.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { float grad_data[]; };
layout(binding = 1) buffer Param { float param_data[]; };
layout(binding = 2) buffer ExpAvg { float exp_avg[]; };          // First moment (m)
layout(binding = 3) buffer ExpAvgSq { float exp_avg_sq[]; };     // Second moment (v)
layout(binding = 4) buffer MaxExpAvgSq { float max_exp_avg_sq[]; }; // AMSGrad max(v)

layout(push_constant) uniform PushConstants {
    uint numel;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
    float bias_correction1;  // 1 - beta1^t (precomputed on host)
    float bias_correction2_sqrt;  // sqrt(1 - beta2^t) (precomputed on host)
    uint decoupled;          // 0=L2, 1=decoupled (AdamW)
    uint amsgrad;            // 0=off, 1=on
    uint padding0;
    uint padding1;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.numel) return;

    float g = grad_data[gid];
    float p = param_data[gid];

    // Weight decay
    if (params.weight_decay > 0.0) {
        if (params.decoupled != 0) {
            // Decoupled weight decay (AdamW): subtract directly from param
            p -= params.lr * params.weight_decay * p;
        } else {
            // L2 regularization: add to gradient
            g += params.weight_decay * p;
        }
    }

    // Update first moment: m = beta1 * m + (1 - beta1) * g
    float m = params.beta1 * exp_avg[gid] + (1.0 - params.beta1) * g;
    exp_avg[gid] = m;

    // Update second moment: v = beta2 * v + (1 - beta2) * g^2
    float v = params.beta2 * exp_avg_sq[gid] + (1.0 - params.beta2) * g * g;
    exp_avg_sq[gid] = v;

    float denom_v = v;
    if (params.amsgrad != 0) {
        // AMSGrad: use max of all past v
        float max_v = max(max_exp_avg_sq[gid], v);
        max_exp_avg_sq[gid] = max_v;
        denom_v = max_v;
    }

    // Bias-corrected estimates
    float m_hat = m / params.bias_correction1;
    float denom = sqrt(denom_v) / params.bias_correction2_sqrt + params.eps;

    p -= params.lr * m_hat / denom;
    param_data[gid] = p;
}
