#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Instance Normalization for Float16
// Input/output are packed F16 (2 elements per 32-bit word)
// Weight/bias/mean/var are Float32 (channel-level statistics)
// One workgroup per (N, C) pair
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { uint input_data[]; };       // Packed F16
layout(binding = 1) buffer Output { uint output_data[]; };     // Packed F16
layout(binding = 2) buffer Weight { float weight_data[]; };    // Float32
layout(binding = 3) buffer Bias { float bias_data[]; };        // Float32
layout(binding = 4) buffer Mean { float mean_data[]; };        // Float32
layout(binding = 5) buffer Var { float var_data[]; };          // Float32

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint channels;
    uint spatial_size;
    float epsilon;
    uint affine;
} params;

shared float shared_sum[WORKGROUP_SIZE];
shared float shared_sum_sq[WORKGROUP_SIZE];

float readF16(uint flat_idx) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = input_data[word_idx];
    return (half_idx == 0) ? unpackHalf2x16(packed).x : unpackHalf2x16(packed >> 16).x;
}

// Atomic packed-F16 write. Two adjacent elements share a 32-bit word and may
// belong to different (n,c) slices when spatial_size is odd, so update only the
// target half via compare-and-swap to avoid clobbering the neighbor.
void writeF16(uint flat_idx, float value) {
    uint word_idx = flat_idx / 2;
    uint shift = (flat_idx & 1u) * 16u;
    uint mask = 0xFFFFu << shift;
    uint half_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint new_half = half_bits << shift;
    uint prev = output_data[word_idx];
    for (uint attempt = 0u; attempt < 65536u; ++attempt) {
        uint desired = (prev & ~mask) | new_half;
        uint observed = atomicCompSwap(output_data[word_idx], prev, desired);
        if (observed == prev) return;
        prev = observed;
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint nc_idx = gl_WorkGroupID.x;

    uint total_nc = params.batch_size * params.channels;
    if (nc_idx >= total_nc) return;

    uint c = nc_idx % params.channels;
    uint base = nc_idx * params.spatial_size;

    // Step 1: Compute mean
    float local_sum = 0.0;
    for (uint i = tid; i < params.spatial_size; i += WORKGROUP_SIZE) {
        local_sum += readF16(base + i);
    }
    shared_sum[tid] = local_sum;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) shared_sum[tid] += shared_sum[tid + s];
        barrier();
    }

    float mean = shared_sum[0] / float(params.spatial_size);
    barrier();

    // Step 2: Compute variance
    float local_sum_sq = 0.0;
    for (uint i = tid; i < params.spatial_size; i += WORKGROUP_SIZE) {
        float diff = readF16(base + i) - mean;
        local_sum_sq += diff * diff;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) shared_sum_sq[tid] += shared_sum_sq[tid + s];
        barrier();
    }

    float variance = shared_sum_sq[0] / float(params.spatial_size);
    float inv_std = 1.0 / sqrt(variance + params.epsilon);

    if (tid == 0) {
        mean_data[nc_idx] = mean;
        var_data[nc_idx] = inv_std;
    }
    barrier();

    // Step 3: Normalize and write each element with an atomic packed-F16 store.
    // Per-element CAS is required because adjacent (n,c) slices can share a
    // 32-bit word when spatial_size is odd.
    for (uint e = tid; e < params.spatial_size; e += WORKGROUP_SIZE) {
        float normalized = (readF16(base + e) - mean) * inv_std;
        if (params.affine > 0) {
            normalized = normalized * weight_data[c] + bias_data[c];
        }
        writeF16(base + e, normalized);
    }
}
