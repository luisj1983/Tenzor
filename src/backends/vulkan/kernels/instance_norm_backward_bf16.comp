#version 450
#extension GL_EXT_shader_atomic_float : enable

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Instance Normalization Backward Pass for BFloat16
// Grad_output/input/grad_input are packed BF16; mean/rstd/weight/grad_weight/grad_bias are Float32
// One workgroup per (N, C) pair
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };    // Packed BF16
layout(binding = 1) buffer Input { uint input_data[]; };           // Packed BF16
layout(binding = 2) buffer Mean { float mean_data[]; };            // Float32
layout(binding = 3) buffer Rstd { float rstd_data[]; };            // Float32
layout(binding = 4) buffer Weight { float weight_data[]; };        // Float32
layout(binding = 5) buffer GradInput { uint grad_input[]; };       // Packed BF16
layout(binding = 6) buffer GradWeight { float grad_weight[]; };    // Float32
layout(binding = 7) buffer GradBias { float grad_bias[]; };        // Float32

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint channels;
    uint spatial_size;
    uint affine;
} params;

shared float shared_sum_dy_w[WORKGROUP_SIZE];
shared float shared_sum_dy_w_xhat[WORKGROUP_SIZE];

float readBF16From(uint flat_idx, uint buf_sel) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed;
    if (buf_sel == 0) packed = grad_output[word_idx];
    else packed = input_data[word_idx];
    return (half_idx == 0) ? unpackBF16x2(packed).x : unpackBF16x2(packed >> 16).x;
}

// Single-element BF16 write into the packed grad_input buffer using a bounded
// atomicCompSwap loop. Required because when `base` is odd or `spatial_size`
// is odd the packed 32-bit word straddles two (N, C) slices and a plain
// store would clobber the neighbour's half.
void writeBF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint b = floatBitsToUint(val);
    uint bits = ((b + 0x7FFFu + ((b >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = grad_input[word_idx];
    for (uint iter = 0u; iter < 65536u; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word.
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint nc_idx = gl_WorkGroupID.x;

    uint total_nc = params.batch_size * params.channels;
    if (nc_idx >= total_nc) return;

    uint c = nc_idx % params.channels;
    uint base = nc_idx * params.spatial_size;

    float mean = mean_data[nc_idx];
    float rstd = rstd_data[nc_idx];

    bool zero_variance = (rstd > 100.0);

    if (zero_variance) {
        // Per-element atomic writes via writeBF16: see writeF16 note in
        // instance_norm_backward_f16.comp — packed words straddle NC slices
        // when base or spatial_size is odd.
        for (uint i = tid; i < params.spatial_size; i += WORKGROUP_SIZE) {
            writeBF16(base + i, 0.0);
            if (params.affine > 0) {
                float dy = readBF16From(base + i, 0);
                atomicAdd(grad_bias[c], dy);
            }
        }
        return;
    }

    // Step 1: Compute reductions
    float local_sum_dy_w = 0.0;
    float local_sum_dy_w_xhat = 0.0;
    for (uint i = tid; i < params.spatial_size; i += WORKGROUP_SIZE) {
        float dy = readBF16From(base + i, 0);
        float w = (params.affine > 0) ? weight_data[c] : 1.0;
        float xhat = (readBF16From(base + i, 1) - mean) * rstd;

        local_sum_dy_w += dy * w;
        local_sum_dy_w_xhat += dy * w * xhat;
    }
    shared_sum_dy_w[tid] = local_sum_dy_w;
    shared_sum_dy_w_xhat[tid] = local_sum_dy_w_xhat;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_dy_w[tid] += shared_sum_dy_w[tid + s];
            shared_sum_dy_w_xhat[tid] += shared_sum_dy_w_xhat[tid + s];
        }
        barrier();
    }

    float sum_dy_w = shared_sum_dy_w[0];
    float sum_dy_w_xhat = shared_sum_dy_w_xhat[0];
    float inv_n = 1.0 / float(params.spatial_size);
    barrier();

    // Step 2: Per-element atomic writes via writeBF16 — packed word-stores
    // would clobber neighbouring NC slices when `base` or `spatial_size` is
    // odd (the boundary 32-bit word is shared with another slice).
    for (uint i = tid; i < params.spatial_size; i += WORKGROUP_SIZE) {
        float dy = readBF16From(base + i, 0);
        float w = (params.affine > 0) ? weight_data[c] : 1.0;
        float xhat = (readBF16From(base + i, 1) - mean) * rstd;
        float r = rstd * (dy * w - sum_dy_w * inv_n - xhat * sum_dy_w_xhat * inv_n);
        writeBF16(base + i, r);
        if (params.affine > 0) {
            atomicAdd(grad_weight[c], dy * xhat);
            atomicAdd(grad_bias[c], dy);
        }
    }
}
