#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Permute operation for Float64: arbitrary dimension reordering
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float64_t input_data[]; };
layout(binding = 1) buffer Output { float64_t output_data[]; };
layout(binding = 2) buffer InputShape { int shape[]; };       // Input shape
layout(binding = 3) buffer InputStrides { int strides[]; };   // Input strides
layout(binding = 4) buffer PermuteDims { int perm[]; };       // Permutation order

layout(push_constant) uniform PushConstants {
    uint n;          // Total number of elements
    uint ndim;       // Number of dimensions
} params;

// Convert linear index to multi-dimensional indices based on output shape
void index_to_coords(uint linear_idx, uint ndims, out int coords[8]) {
    uint remaining = linear_idx;
    // We need the output shape which is shape permuted
    int out_shape[8];
    for (uint i = 0; i < ndims && i < 8u; i++) {
        // Guard the perm[] index (malformed permutation -> OOB shape[] read);
        // the f32 kernel has this guard, the variants were missing it.
        int pi = perm[i];
        out_shape[i] = (pi >= 0 && uint(pi) < ndims && uint(pi) < 8u)
                           ? max(shape[pi], 1) : 1;  // also prevents div-by-zero
    }

    for (int i = int(ndims) - 1; i >= 0; i--) {
        int s = out_shape[i];  // Already guaranteed >= 1
        coords[i] = int(remaining % uint(s));
        remaining /= uint(s);
    }
}

// Convert multi-dimensional indices to linear index using strides
uint coords_to_index(int coords[8], uint ndims, int stride_array[8]) {
    uint idx = 0;
    for (uint i = 0; i < ndims; i++) {
        idx += uint(coords[i] * stride_array[i]);
    }
    return idx;
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.n) {
        return;
    }

    // Safety check: ndim must be valid (0-8)
    if (params.ndim > 8u) {
        return;
    }

    // Get output coordinates
    int out_coords[8];
    index_to_coords(out_idx, params.ndim, out_coords);

    // Permute coordinates to get input coordinates
    int in_coords[8];
    for (uint i = 0; i < params.ndim; i++) {
        // Guard the perm[] index: an out-of-range value would be an OOB write
        // into in_coords[8]. The f32 kernel has this guard (variants lacked it).
        uint p = uint(perm[i]);
        if (perm[i] < 0 || p >= params.ndim || p >= 8u) {
            return;
        }
        in_coords[p] = out_coords[i];
    }

    // Convert input coordinates to linear index
    int in_strides[8];
    for (uint i = 0; i < params.ndim; i++) {
        in_strides[i] = strides[i];
    }
    uint in_idx = coords_to_index(in_coords, params.ndim, in_strides);

    // Copy data
    output_data[out_idx] = input_data[in_idx];
}
