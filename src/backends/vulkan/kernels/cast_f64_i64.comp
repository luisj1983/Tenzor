#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Cast Float64 to Int64 (direct, no F32 intermediate)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    float64_t data[];
} input_buf;

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
    int64_t data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    float64_t v = input_buf.data[idx];
    // Saturating conversion (NaN->0, +Inf/overflow->INT64_MAX,
    // -Inf/-overflow->INT64_MIN), matching CPU/CUDA/ROCm/OneAPI's convention
    // instead of GLSL's UB int64_t() conversion for out-of-range/NaN input.
    if (isnan(v)) {
        output_buf.data[idx] = 0l;
    } else if (v >= 9223372036854775807.0lf) {
        output_buf.data[idx] = 9223372036854775807l;
    } else if (v <= -9223372036854775808.0lf) {
        output_buf.data[idx] = -9223372036854775808l;
    } else {
        output_buf.data[idx] = int64_t(v);
    }
}
