#version 450

// Eye for BFloat16: generate identity matrix
// BF16 packed buffers (2 BFloat16 per uint32)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint rows;
    uint cols;
} params;

void main() {
    // Each thread handles one uint32 word (2 BF16 elements)
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    uint total = params.rows * params.cols;
    if (idx0 >= total) return;

    uint row0 = idx0 / params.cols;
    uint col0 = idx0 % params.cols;
    float val0 = (row0 == col0) ? 1.0 : 0.0;

    float val1 = 0.0;
    if (idx1 < total) {
        uint row1 = idx1 / params.cols;
        uint col1 = idx1 % params.cols;
        val1 = (row1 == col1) ? 1.0 : 0.0;
    }

    // Pack two BF16 values into one uint32
    uint bits0 = ((floatBitsToUint(val0) + 0x7FFFu + ((floatBitsToUint(val0) >> 16) & 1u)) >> 16);
    uint bits1 = ((floatBitsToUint(val1) + 0x7FFFu + ((floatBitsToUint(val1) >> 16) & 1u)) >> 16);
    output_data[pair_idx] = bits0 | (bits1 << 16);
}
