#version 450

// Take operation: index select along the flattened tensor
// Each thread reads one index and copies input[index] to output[thread_id].
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint numel;        // Total number of input elements (for bounds checking)
    uint num_indices;  // Number of indices (= output size)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_indices) return;

    int take_idx = indices[idx];

    // Wrap negative flat indices (Python-style), matching CPU take
    // (indexing.cpp): idx += numel. Only genuinely out-of-range indices
    // fall through to the zero-output guard.
    if (take_idx < 0) take_idx += int(params.numel);

    // Bounds check: clamp out-of-range indices to zero output
    if (take_idx < 0 || take_idx >= int(params.numel)) {
        output_data[idx] = 0.0;
        return;
    }

    output_data[idx] = input_data[uint(take_idx)];
}
