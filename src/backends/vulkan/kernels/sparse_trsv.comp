#version 450

// Sparse triangular solve: L*x = b (lower) or U*x = b (upper)
// L/U is a CSR sparse matrix (N x N), b and x are dense vectors (N).
//
// Strategy: single-workgroup, single-thread SEQUENTIAL substitution.
//
// The previous implementation dispatched N workgroups (one row each) and had
// each consumer spin-wait (while atomicOr(solved[col],0)==0) on its producer
// rows. Vulkan provides NO cross-workgroup forward-progress guarantee, so when
// N exceeds the device's co-resident workgroup capacity a waiting consumer can
// occupy a slot while its producer is never scheduled -> hard deadlock (the
// same SIMT spin-wait hazard documented for the ROCm parallel triangular
// solve). We instead solve the rows in strict dependency order from one thread,
// which is always correct and deadlock-free; the host dispatches a single
// (1,1,1) workgroup.
//
// For lower triangular: process rows 0, 1, ..., N-1 (row i depends on j < i).
// For upper triangular: process rows N-1, N-2, ..., 0 (row i depends on j > i).

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) readonly buffer RowOffsets { int row_offsets[]; };
layout(set = 0, binding = 1) readonly buffer ColIndices { int col_indices[]; };
layout(set = 0, binding = 2) readonly buffer Values     { float values[];     };
layout(set = 0, binding = 3) readonly buffer RHS        { float b[];          };
layout(set = 0, binding = 4) buffer Output              { float x[];          };
// Retained for descriptor-set compatibility with the host (now unused).
layout(set = 0, binding = 5) buffer SolvedCounter        { int solved[];       };

layout(push_constant) uniform PushConstants {
    uint n;       // matrix dimension
    uint upper;   // 0 = lower triangular, 1 = upper triangular
};

void solve_row(uint row) {
    // x[row] = (b[row] - sum(A[row,j]*x[j] for j != row)) / A[row,row]
    // All dependency x[j] have already been written in processing order.
    float rhs = b[row];
    float diag = 1.0;
    uint rs = uint(row_offsets[row]);
    uint re = uint(row_offsets[row + 1u]);
    for (uint i = rs; i < re; i++) {
        uint col = uint(col_indices[i]);
        if (col == row) {
            diag = values[i];
        } else {
            rhs -= values[i] * x[col];
        }
    }
    x[row] = rhs / diag;
}

void main() {
    // A single invocation performs the entire sequential solve.
    if (gl_GlobalInvocationID.x != 0u) return;

    if (upper == 0u) {
        for (uint row = 0u; row < n; row++) {
            solve_row(row);
        }
    } else {
        for (uint t = 0u; t < n; t++) {
            solve_row(n - 1u - t);
        }
    }
}
