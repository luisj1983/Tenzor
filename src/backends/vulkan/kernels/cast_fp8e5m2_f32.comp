#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Cast FP8 E5M2 to Float32 (1 sign, 5 exponent, 2 mantissa, bias=15)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    uint8_t data[];
} input_buf;

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
    float data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;

    uint bits = uint(input_buf.data[idx]) & 0xFFu;

    uint sign = (bits >> 7) & 0x1u;
    uint exp = (bits >> 2) & 0x1Fu;
    uint mantissa = bits & 0x3u;

    uint f_sign = sign;
    uint f_exp;
    uint f_mantissa;

    if (exp == 0u) {
        if (mantissa == 0u) {
            // Zero
            f_exp = 0u;
            f_mantissa = 0u;
        } else {
            // Denormalized: normalize
            int e = -1;
            uint m = mantissa;
            while ((m & 0x4u) == 0u) {
                e++;
                m <<= 1;
            }
            f_exp = uint(127 - 15 - e);
            f_mantissa = (m & 0x3u) << 21;
        }
    } else if (exp == 0x1Fu) {
        // Inf or NaN
        f_exp = 0xFFu;
        f_mantissa = mantissa << 21;
    } else {
        // Normalized
        f_exp = exp - 15u + 127u;
        f_mantissa = mantissa << 21;
    }

    uint f_bits = (f_sign << 31) | (f_exp << 23) | f_mantissa;
    output_buf.data[idx] = uintBitsToFloat(f_bits);
}
