#version 450

// Symmetric eigenvalue decomposition (cyclic Jacobi) for matrices of ANY size.
// Unlike linalg_eigh.comp (which holds the working matrix in shared memory and is
// therefore capped at 32x32), this variant keeps the working matrix D and the
// eigenvector matrix V in global memory, so it works for arbitrary n (one
// workgroup per batch element). The rotation angle is computed serially on
// thread 0; the independent row/column and eigenvector updates are parallelized
// across the workgroup. Output: eigenvalues (binding 1), eigenvectors (binding 2).
layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf { float data_in[]; };  // A (n*n per batch)
layout(set = 0, binding = 1) buffer WBuf     { float data_w[];  };  // eigenvalues (n per batch)
layout(set = 0, binding = 2) buffer VBuf     { float data_v[];  };  // eigenvectors (n*n per batch)
layout(set = 0, binding = 3) buffer DBuf     { float data_d[];  };  // scratch working matrix (n*n per batch)

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch;
};

shared float sh_c;
shared float sh_s;
shared uint  sh_rot;
shared uint  converged;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (batch_idx >= batch) return;

    uint base = batch_idx * n * n;

    // Initialize D = A and V = I (parallel over all n*n elements).
    for (uint idx = tid; idx < n * n; idx += gl_WorkGroupSize.x) {
        uint r = idx / n;
        uint c = idx - r * n;
        data_d[base + idx] = data_in[base + idx];
        data_v[base + idx] = (r == c) ? 1.0 : 0.0;
    }
    barrier();

    for (uint sweep = 0; sweep < 60u; sweep++) {
        if (tid == 0u) converged = 1u;
        barrier();

        for (uint p = 0; p < n; p++) {
            for (uint q = p + 1u; q < n; q++) {
                if (tid == 0u) {
                    float app = data_d[base + p * n + p];
                    float aqq = data_d[base + q * n + q];
                    float apq = data_d[base + p * n + q];

                    if (abs(apq) > 1e-10 * sqrt(abs(app * aqq))) {
                        converged = 0u;
                        // Rotation angle (handles app==aqq: GLSL sign(0)=0 would
                        // give t=0 and never diagonalize, so force a 45-deg turn).
                        float t;
                        if (app == aqq) {
                            t = 1.0;
                        } else {
                            float tau_val = (aqq - app) / (2.0 * apq);
                            float s_t = (tau_val >= 0.0) ? 1.0 : -1.0;
                            t = s_t / (abs(tau_val) + sqrt(1.0 + tau_val * tau_val));
                        }
                        float c = 1.0 / sqrt(1.0 + t * t);
                        float s = t * c;
                        sh_c = c;
                        sh_s = s;
                        sh_rot = 1u;

                        // Diagonal block update (serial; off-diagonal i!=p,q done below).
                        data_d[base + p * n + p] = c*c*app - 2.0*s*c*apq + s*s*aqq;
                        data_d[base + q * n + q] = s*s*app + 2.0*s*c*apq + c*c*aqq;
                        data_d[base + p * n + q] = 0.0;
                        data_d[base + q * n + p] = 0.0;
                    } else {
                        sh_rot = 0u;
                    }
                }
                barrier();

                if (sh_rot == 1u) {
                    float c = sh_c;
                    float s = sh_s;
                    // D = G^T D G for rows/cols i != p,q (independent across i).
                    for (uint i = tid; i < n; i += gl_WorkGroupSize.x) {
                        if (i != p && i != q) {
                            float dip = data_d[base + i * n + p];
                            float diq = data_d[base + i * n + q];
                            float nip = c * dip - s * diq;
                            float niq = s * dip + c * diq;
                            data_d[base + i * n + p] = nip;
                            data_d[base + p * n + i] = nip;
                            data_d[base + i * n + q] = niq;
                            data_d[base + q * n + i] = niq;
                        }
                    }
                    // V update (columns p,q), independent across rows i.
                    for (uint i = tid; i < n; i += gl_WorkGroupSize.x) {
                        float vip = data_v[base + i * n + p];
                        float viq = data_v[base + i * n + q];
                        data_v[base + i * n + p] = c * vip - s * viq;
                        data_v[base + i * n + q] = s * vip + c * viq;
                    }
                }
                barrier();
            }
        }

        if (converged > 0u) break;
        barrier();
    }

    // Eigenvalues = diagonal of D.
    for (uint i = tid; i < n; i += gl_WorkGroupSize.x) {
        data_w[batch_idx * n + i] = data_d[base + i * n + i];
    }
}
