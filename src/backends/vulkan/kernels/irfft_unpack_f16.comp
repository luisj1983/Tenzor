#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Complex-to-Real IFFT: Unpack N/2 complex values back to N real values — Float16
// After N/2-point inverse FFT, extract interleaved real parts
// Input:  N/2 complex float16 (1 uint32 per complex element)
// Output: N real float16 values in packed uint32 buffer (2 reals per word)

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };  // N/2 complex
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };  // N real (packed)

layout(push_constant) uniform PushConstants {
    uint n;                // Original real FFT size (N)
    uint batch_size;       // Number of independent FFTs
    uint in_batch_stride;  // Stride between input batches (in uint32 words / complex elements)
    uint out_batch_stride; // Stride between output batches (in uint32 words)
};

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint half_n = n / 2;
    uint total_items = half_n * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / half_n;
    uint local_tid = tid % half_n;

    // Complex element k holds (real[2k], real[2k+1])
    uint src_word = batch_idx * in_batch_stride + local_tid;
    vec2 complex_val = unpackHalf2x16(data_in[src_word]);

    // Write two real values to output as one packed uint32
    // real[2k] = complex_val.x, real[2k+1] = complex_val.y
    uint dst_word = batch_idx * out_batch_stride + local_tid;
    data_out[dst_word] = packHalf2x16(complex_val);
}
