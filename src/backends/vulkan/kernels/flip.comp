#version 450

// Flip (reverse) elements along a dimension
// Grid-stride kernel: one thread per element
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { float a[]; };
layout(binding = 1) buffer Output { float result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // total elements
    uint dim_size;   // size of the dimension being flipped
    uint inner_size; // product of dims after the flip dim
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n) return;

    // Decompose flat index into (outer, dim_pos, inner)
    uint inner_idx = idx % inner_size;
    uint dim_pos = (idx / inner_size) % dim_size;
    uint outer_idx = idx / (dim_size * inner_size);

    // Reverse the position along the flip dimension
    uint flipped_dim_pos = dim_size - 1 - dim_pos;

    // Compute source index
    uint src_idx = outer_idx * (dim_size * inner_size) + flipped_dim_pos * inner_size + inner_idx;

    result[idx] = a[src_idx];
}
