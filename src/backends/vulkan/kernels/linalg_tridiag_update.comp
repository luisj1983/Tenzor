#version 450

// Blocked tridiagonalization — trailing-submatrix update: INTENTIONAL NO-OP.
//
// The panel shader linalg_tridiag_panel.comp does NOT restrict its symmetric
// rank-2 update to the panel columns: its A <- H*A*H^T update loop ranges r,c
// over the ENTIRE remaining submatrix [col+1, n) x [col+1, n) for every
// reflection. By the time the panel finishes columns
// [col_start, col_start+panel_cols), the trailing block [trail_start, n) has
// already had all panel reflections applied on both sides.
//
// A separate trailing update would therefore RE-APPLY each reflection a second
// time, destroying symmetry (A becomes H*A*H^T*H*A*H^T-like garbage) and
// corrupting every later panel — which made symmetric eigendecomposition wrong
// for n larger than one panel (TILED_BLOCK_SIZE=32). The original body here
// applied only a one-sided H*A product, which was wrong twice over.
//
// The host (runBlockedTridiag) no longer dispatches this shader. It is kept as
// a no-op only to preserve the build target and descriptor-set layout; if it is
// ever dispatched (e.g. from a stale pipeline cache) it must not touch A.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer MatrixA { float A[]; };
layout(set = 0, binding = 1) readonly buffer TauBuf { float tau[]; };
layout(set = 0, binding = 2) buffer WorkV { float v_buf[]; };
layout(set = 0, binding = 3) buffer WorkW { float w_buf[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

void main() {
    // No-op: the panel already performed the full two-sided trailing update.
}
