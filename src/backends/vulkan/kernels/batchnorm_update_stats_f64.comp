#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// BatchNorm running statistics update for Float64
layout(local_size_x = 256) in;

layout(binding = 0) buffer RunningMean { double running_mean[]; };
layout(binding = 1) buffer RunningVar { double running_var[]; };
layout(binding = 2) buffer BatchMean { double batch_mean[]; };
layout(binding = 3) buffer BatchVar { double batch_var[]; };

layout(push_constant) uniform PushConstants {
    uint n_channels;
    float momentum;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_channels) {
        return;
    }

    double momentum_d = double(params.momentum);
    double one_minus_momentum = 1.0 - momentum_d;

    running_mean[idx] = one_minus_momentum * running_mean[idx] + momentum_d * batch_mean[idx];
    running_var[idx] = one_minus_momentum * running_var[idx] + momentum_d * batch_var[idx];
}
