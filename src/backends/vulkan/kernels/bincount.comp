#version 450

// Bincount: count occurrences of each value in an integer tensor
// Uses CAS-loop atomics for thread-safe float accumulation (same pattern as scatter_add)
// Input values must be non-negative integers stored as int32.
// If weights are provided (binding 1), accumulates weights[i] into bins[input[i]].
// Otherwise accumulates 1.0 into bins[input[i]].
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { int input_data[]; };         // Input integer values
layout(binding = 1) buffer Weights { float weights_data[]; };   // Optional weights (unused if has_weights=0)
layout(binding = 2) buffer Output { uint output_data[]; };      // Output bins (uint for CAS atomics)

layout(push_constant) uniform PushConstants {
    uint n;              // Number of input elements
    uint num_bins;       // Number of output bins
    uint has_weights;    // 0 = no weights (count), 1 = weighted
} params;

// Atomic add for float using compare-and-swap loop
void atomicAddFloat(uint idx, float val) {
    uint old_bits = output_data[idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        uint new_bits = floatBitsToUint(old_val + val);
        uint result = atomicCompSwap(output_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    int val = input_data[i];
    if (val < 0 || uint(val) >= params.num_bins) return;

    if (params.has_weights != 0) {
        atomicAddFloat(uint(val), weights_data[i]);
    } else {
        // Unweighted counts use integer atomics — exact for any count,
        // unlike float accumulation which loses counts past 2^24.
        atomicAdd(output_data[uint(val)], 1u);
    }
}
