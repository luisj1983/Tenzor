#version 450

// Broadcasting-aware binary operations for Vulkan
// Supports NumPy-style broadcasting rules
// Supports both Float32 and Int32 data types
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { uint a[]; };
layout(binding = 1) buffer InputB { uint b[]; };
layout(binding = 2) buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint output_size;      // Total number of output elements
    uint op;               // Operation: 0=add, 1=sub, 2=mul, 3=div
    uint dtype;            // Data type: 0=float32, 1=int32
    uint ndim_a;           // Number of dimensions in tensor A
    uint ndim_b;           // Number of dimensions in tensor B
    uint ndim_out;         // Number of dimensions in output
    // Strides for tensor A (up to 8 dimensions)
    uint strides_a[8];
    // Strides for tensor B (up to 8 dimensions)
    uint strides_b[8];
    // Output shape (up to 8 dimensions)
    uint shape_out[8];
} params;

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.output_size) {
        return;
    }

    // Convert flat output index to multi-dimensional coordinates
    // Then use broadcasting strides to compute input indices
    uint idx_a = 0;
    uint idx_b = 0;
    uint tmp = out_idx;

    // Iterate from last dimension to first (row-major order)
    for (uint i = 0; i < params.ndim_out; i++) {
        uint dim_idx = params.ndim_out - 1 - i;
        uint coord = tmp % params.shape_out[dim_idx];
        tmp /= params.shape_out[dim_idx];

        // Add contribution to input indices using broadcasting strides
        // Broadcasting strides are 0 for broadcasted dimensions
        idx_a += coord * params.strides_a[dim_idx];
        idx_b += coord * params.strides_b[dim_idx];
    }

    if (params.dtype == 0) {
        // Float32 operations with denormal handling
        uint bits_a = a[idx_a];
        uint bits_b = b[idx_b];
        float val_a = uintBitsToFloat(bits_a);
        float val_b = uintBitsToFloat(bits_b);
        uint res_bits;

        // Check if both values are denormals (exponent == 0, mantissa != 0)
        // or zeros. Denormals have format: [sign:1][exp:8=0][mantissa:23!=0]
        uint exp_a = (bits_a >> 23) & 0xFFu;
        uint exp_b = (bits_b >> 23) & 0xFFu;
        bool both_denorm_or_zero = (exp_a == 0u) && (exp_b == 0u);

        switch (params.op) {
            case 0: // add
                if (both_denorm_or_zero) {
                    // For denormals/zeros with same sign, use integer arithmetic
                    // to preserve denormal results
                    uint sign_a = bits_a & 0x80000000u;
                    uint sign_b = bits_b & 0x80000000u;
                    uint mant_a = bits_a & 0x007FFFFFu;
                    uint mant_b = bits_b & 0x007FFFFFu;

                    if (sign_a == sign_b) {
                        // Same sign: add mantissas
                        uint mant_sum = mant_a + mant_b;
                        if (mant_sum >= 0x00800000u) {
                            // Overflow to normalized number (exponent becomes 1)
                            res_bits = sign_a | 0x00800000u | ((mant_sum - 0x00800000u) & 0x007FFFFFu);
                        } else {
                            // Still denormal
                            res_bits = sign_a | mant_sum;
                        }
                    } else {
                        // Different signs: subtract mantissas
                        if (mant_a >= mant_b) {
                            res_bits = sign_a | (mant_a - mant_b);
                        } else {
                            res_bits = sign_b | (mant_b - mant_a);
                        }
                    }
                } else {
                    res_bits = floatBitsToUint(val_a + val_b);
                }
                break;
            case 1: // sub
                if (both_denorm_or_zero) {
                    // For denormals, subtraction is like adding with flipped sign
                    uint sign_a = bits_a & 0x80000000u;
                    uint sign_b = bits_b ^ 0x80000000u;  // Flip sign of b
                    uint mant_a = bits_a & 0x007FFFFFu;
                    uint mant_b = bits_b & 0x007FFFFFu;

                    if (sign_a == sign_b) {
                        uint mant_sum = mant_a + mant_b;
                        if (mant_sum >= 0x00800000u) {
                            res_bits = sign_a | 0x00800000u | ((mant_sum - 0x00800000u) & 0x007FFFFFu);
                        } else {
                            res_bits = sign_a | mant_sum;
                        }
                    } else {
                        if (mant_a >= mant_b) {
                            res_bits = sign_a | (mant_a - mant_b);
                        } else {
                            res_bits = sign_b | (mant_b - mant_a);
                        }
                    }
                } else {
                    res_bits = floatBitsToUint(val_a - val_b);
                }
                break;
            case 2: // mul
                res_bits = floatBitsToUint(val_a * val_b);
                break;
            case 3: // div
                res_bits = floatBitsToUint(val_a / val_b);
                break;
            case 23: // atan2 (binary)
                res_bits = floatBitsToUint(atan(val_a, val_b));
                break;
            case 24: // fmod (binary) - truncated remainder
                res_bits = floatBitsToUint(val_a - trunc(val_a / val_b) * val_b);
                break;
            case 25: { // remainder (binary) - IEEE remainder
                float quot = val_a / val_b;
                float rounded = round(quot);
                res_bits = floatBitsToUint(val_a - rounded * val_b);
                break;
            }
            case 26: // minimum (binary)
                res_bits = floatBitsToUint(min(val_a, val_b));
                break;
            case 27: // maximum (binary)
                res_bits = floatBitsToUint(max(val_a, val_b));
                break;
            case 33: // hypot (binary)
                res_bits = floatBitsToUint(sqrt(val_a * val_a + val_b * val_b));
                break;
            case 34: { // copysign (binary)
                uint sign_b_bit = bits_b & 0x80000000u;
                uint mag_a_bits = bits_a & 0x7FFFFFFFu;
                res_bits = sign_b_bit | mag_a_bits;
                break;
            }
            case 35: { // nextafter (binary) - approximation via ULP step (mirrors math.comp)
                if (val_a == val_b) {
                    res_bits = bits_a;
                } else {
                    uint ua = bits_a;
                    if ((val_a >= 0.0 && val_b > val_a) || (val_a < 0.0 && val_b > val_a)) {
                        if (val_a >= 0.0) ua = ua + 1u;
                        else ua = ua - 1u;
                    } else {
                        if (val_a > 0.0) ua = ua - 1u;
                        else if (val_a < 0.0) ua = ua + 1u;
                        else ua = 0x80000001u; // -0 -> smallest negative denorm
                    }
                    res_bits = ua;
                }
                break;
            }
            case 36: { // gcd (integer via float encoding) (mirrors math.comp)
                int ia = int(val_a);
                int ib = int(val_b);
                ia = ia < 0 ? -ia : ia;
                ib = ib < 0 ? -ib : ib;
                while (ib != 0) { int t = ib; ib = ia - (ia / ib) * ib; ia = t; }
                res_bits = floatBitsToUint(float(ia));
                break;
            }
            case 37: { // lcm (integer via float encoding) (mirrors math.comp)
                int ia = int(val_a);
                int ib = int(val_b);
                int oa = ia < 0 ? -ia : ia;
                int ob = ib < 0 ? -ib : ib;
                int ga = oa; int gb = ob;
                while (gb != 0) { int t = gb; gb = ga - (ga / gb) * gb; ga = t; }
                int g = ga;
                res_bits = floatBitsToUint(g == 0 ? 0.0 : float((oa / g) * ob));
                break;
            }
            case 38: { // igamma (binary) - lower regularized incomplete gamma P(a, x) (mirrors math.comp)
                float a_ig = val_a;
                float x_ig = val_b;
                if (x_ig <= 0.0) { res_bits = floatBitsToUint(0.0); break; }
                const float lan_g = 7.0;
                const float lan_c0 =  0.99999999999980993;
                const float lan_c1 = 676.5203681218851;
                const float lan_c2 = -1259.1392167224028;
                const float lan_c3 = 771.32342877765313;
                const float lan_c4 = -176.61502916214059;
                const float lan_c5 = 12.507343278686905;
                const float lan_c6 = -0.13857109526572012;
                const float lan_c7 = 9.9843695780195716e-6;
                const float lan_c8 = 1.5056327351493116e-7;
                float z = a_ig - 1.0;
                float sx = lan_c0;
                sx += lan_c1 / (z + 1.0);
                sx += lan_c2 / (z + 2.0);
                sx += lan_c3 / (z + 3.0);
                sx += lan_c4 / (z + 4.0);
                sx += lan_c5 / (z + 5.0);
                sx += lan_c6 / (z + 6.0);
                sx += lan_c7 / (z + 7.0);
                sx += lan_c8 / (z + 8.0);
                float t = z + lan_g + 0.5;
                float lg = 0.9189385332046727 + (z + 0.5) * log(t) - t + log(sx);
                float term = 1.0 / a_ig;
                float sum = term;
                for (int nn = 1; nn < 100; ++nn) {
                    term *= x_ig / (a_ig + float(nn));
                    sum += term;
                    if (abs(term) < abs(sum) * 1e-7) break;
                }
                float res_ig = exp(-x_ig + a_ig * log(x_ig) - lg) * sum;
                res_ig = clamp(res_ig, 0.0, 1.0);
                res_bits = floatBitsToUint(res_ig);
                break;
            }
            case 39: { // igammac (binary) - upper regularized incomplete gamma = 1 - igamma (mirrors math.comp)
                float a_ig = val_a;
                float x_ig = val_b;
                if (x_ig <= 0.0) { res_bits = floatBitsToUint(1.0); break; }
                const float lan_g = 7.0;
                const float lan_c0 =  0.99999999999980993;
                const float lan_c1 = 676.5203681218851;
                const float lan_c2 = -1259.1392167224028;
                const float lan_c3 = 771.32342877765313;
                const float lan_c4 = -176.61502916214059;
                const float lan_c5 = 12.507343278686905;
                const float lan_c6 = -0.13857109526572012;
                const float lan_c7 = 9.9843695780195716e-6;
                const float lan_c8 = 1.5056327351493116e-7;
                float z = a_ig - 1.0;
                float sx = lan_c0;
                sx += lan_c1 / (z + 1.0);
                sx += lan_c2 / (z + 2.0);
                sx += lan_c3 / (z + 3.0);
                sx += lan_c4 / (z + 4.0);
                sx += lan_c5 / (z + 5.0);
                sx += lan_c6 / (z + 6.0);
                sx += lan_c7 / (z + 7.0);
                sx += lan_c8 / (z + 8.0);
                float t = z + lan_g + 0.5;
                float lg = 0.9189385332046727 + (z + 0.5) * log(t) - t + log(sx);
                float term = 1.0 / a_ig;
                float sum = term;
                for (int nn = 1; nn < 100; ++nn) {
                    term *= x_ig / (a_ig + float(nn));
                    sum += term;
                    if (abs(term) < abs(sum) * 1e-7) break;
                }
                float res_ig = exp(-x_ig + a_ig * log(x_ig) - lg) * sum;
                res_ig = clamp(res_ig, 0.0, 1.0);
                res_bits = floatBitsToUint(1.0 - res_ig);
                break;
            }
            case 42: { // fmax (binary) - NaN-propagating max: fmax(NaN, x) = x
                float res;
                if (isnan(val_a)) res = val_b;
                else if (isnan(val_b)) res = val_a;
                else res = max(val_a, val_b);
                res_bits = floatBitsToUint(res);
                break;
            }
            case 43: { // fmin (binary) - NaN-propagating min: fmin(NaN, x) = x
                float res;
                if (isnan(val_a)) res = val_b;
                else if (isnan(val_b)) res = val_a;
                else res = min(val_a, val_b);
                res_bits = floatBitsToUint(res);
                break;
            }
            case 47: // float_power (binary)
                res_bits = floatBitsToUint(pow(val_a, val_b));
                break;
            case 48: { // xlog1py (binary)
                float res;
                if (val_a == 0.0) res = 0.0;
                else res = val_a * log(1.0 + val_b);
                res_bits = floatBitsToUint(res);
                break;
            }
            case 49: // ldexp (binary)
                res_bits = floatBitsToUint(val_a * exp2(val_b));
                break;
            default:
                res_bits = 0u;
                break;
        }
        result[out_idx] = res_bits;
    } else {
        // Int32 operations
        int val_a = int(a[idx_a]);
        int val_b = int(b[idx_b]);
        int res = 0;

        switch (params.op) {
            case 0: // add
                res = val_a + val_b;
                break;
            case 1: // sub
                res = val_a - val_b;
                break;
            case 2: // mul
                res = val_a * val_b;
                break;
            case 3: // div
                res = (val_b != 0) ? (val_a / val_b) : 0;
                break;
            case 24: // fmod for integers (truncated, matches torch.fmod)
                res = (val_b != 0) ? (val_a % val_b) : 0;
                break;
            case 25: { // remainder for integers (floored, matches torch.remainder)
                int r = (val_b != 0) ? (val_a % val_b) : 0;
                if (r != 0 && ((r < 0) != (val_b < 0))) r += val_b;
                res = r;
                break;
            }
            case 26: // minimum
                res = min(val_a, val_b);
                break;
            case 27: // maximum
                res = max(val_a, val_b);
                break;
            default:
                res = 0;
                break;
        }

        result[out_idx] = uint(res);
    }
}
