#version 450

// Stockham mixed-radix FFT: radix-2 butterfly stage
// Data layout: interleaved real/imag pairs
// Unlike the Cooley-Tukey fft.comp, this uses Stockham auto-sort (ping-pong buffers)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { float data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;             // Total FFT size
    uint stage_stride;  // Stride for this stage (product of previous radices)
    uint direction;     // 0 = forward, 1 = inverse
    uint batch_size;    // Number of batches
    uint batch_stride;  // Stride between batches (in complex elements)
};

const float PI = 3.14159265358979323846;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 2;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;
    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    // Determine position in the butterfly structure
    uint group = local_tid / stage_stride;
    uint pos = local_tid % stage_stride;

    // Input indices (Stockham layout)
    uint i0 = group * stage_stride * 2 + pos;
    uint i1 = i0 + stage_stride;

    // Output indices
    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;

    // Apply batch offset
    uint b0_in = (batch_idx * batch_stride + i0) * 2;
    uint b1_in = (batch_idx * batch_stride + i1) * 2;
    uint b0_out = (batch_idx * batch_stride + o0) * 2;
    uint b1_out = (batch_idx * batch_stride + o1) * 2;

    // Load
    float a0_re = data_in[b0_in], a0_im = data_in[b0_in + 1];
    float a1_re = data_in[b1_in], a1_im = data_in[b1_in + 1];

    // Twiddle factor
    float angle = -2.0 * PI * float(pos) / float(stage_stride * 2);
    if (direction == 1) angle = -angle;

    float w_re = cos(angle), w_im = sin(angle);

    // Apply twiddle to a1
    float t_re = a1_re * w_re - a1_im * w_im;
    float t_im = a1_re * w_im + a1_im * w_re;

    // Radix-2 butterfly
    data_out[b0_out]     = a0_re + t_re;
    data_out[b0_out + 1] = a0_im + t_im;
    data_out[b1_out]     = a0_re - t_re;
    data_out[b1_out + 1] = a0_im - t_im;
}
