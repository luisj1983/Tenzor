#version 450

// Grid sample (bilinear and nearest, configurable padding) for 2D inputs.
// Replaces the previous CPU-roundtrip fallback. Float32 only — host
// dispatcher promotes other dtypes via dispatchCast before invocation.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputBuf  { float input_data[]; };
layout(binding = 1) buffer GridBuf   { float grid_data[]; };
layout(binding = 2) buffer OutputBuf { float output_data[]; };

layout(push_constant) uniform PushConstants {
    int N;
    int C;
    int H_in;
    int W_in;
    int H_out;
    int W_out;
    int padding_mode;   // 0=zeros, 1=border, 2=reflection
    int align_corners;  // bool as int
    int mode;           // 0=bilinear, 1=nearest
    int total;          // N*C*H_out*W_out
} params;

float denormalize(float coord, int size) {
    if (params.align_corners != 0) {
        return (coord + 1.0) * 0.5 * float(size - 1);
    }
    return ((coord + 1.0) * float(size) - 1.0) * 0.5;
}

float reflect_coord(float coord, int size) {
    if (size <= 1) return 0.0;
    float max_val = float(size - 1);
    coord = abs(coord);
    float period = 2.0 * max_val;
    coord = mod(coord, period);
    if (coord > max_val) coord = period - coord;
    return coord;
}

float safe_get(int n, int c, int y, int x) {
    if (y >= 0 && y < params.H_in && x >= 0 && x < params.W_in)
        return input_data[((n * params.C + c) * params.H_in + y) * params.W_in + x];
    return 0.0;
}

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= params.total) return;

    int w = idx % params.W_out;
    int h = (idx / params.W_out) % params.H_out;
    int c = (idx / (params.W_out * params.H_out)) % params.C;
    int n = idx / (params.C * params.H_out * params.W_out);

    int grid_idx = ((n * params.H_out + h) * params.W_out + w) * 2;
    float gx = grid_data[grid_idx];
    float gy = grid_data[grid_idx + 1];

    float ix = denormalize(gx, params.W_in);
    float iy = denormalize(gy, params.H_in);

    if (params.padding_mode == 1) {
        ix = clamp(ix, 0.0, float(params.W_in - 1));
        iy = clamp(iy, 0.0, float(params.H_in - 1));
    } else if (params.padding_mode == 2) {
        ix = reflect_coord(ix, params.W_in);
        iy = reflect_coord(iy, params.H_in);
    }

    float val = 0.0;
    if (params.mode == 1) {
        // nearest
        int nx = int(round(ix));
        int ny = int(round(iy));
        if (ny >= 0 && ny < params.H_in && nx >= 0 && nx < params.W_in) {
            val = input_data[((n * params.C + c) * params.H_in + ny) * params.W_in + nx];
        }
    } else {
        // bilinear
        int x0 = int(floor(ix));
        int y0 = int(floor(iy));
        int x1 = x0 + 1;
        int y1 = y0 + 1;

        float wx1 = ix - float(x0);
        float wy1 = iy - float(y0);
        float wx0 = 1.0 - wx1;
        float wy0 = 1.0 - wy1;

        val = wy0 * wx0 * safe_get(n, c, y0, x0) +
              wy0 * wx1 * safe_get(n, c, y0, x1) +
              wy1 * wx0 * safe_get(n, c, y1, x0) +
              wy1 * wx1 * safe_get(n, c, y1, x1);
    }

    output_data[((n * params.C + c) * params.H_out + h) * params.W_out + w] = val;
}
