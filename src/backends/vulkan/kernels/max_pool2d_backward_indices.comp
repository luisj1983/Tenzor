#version 450
#extension GL_EXT_shader_atomic_float : enable

// Max Pooling 2D Backward Pass using pre-computed indices
// This kernel scatters gradients to the positions where max values were found
// Uses atomic operations for overlapping pooling windows
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, H_out, W_out) flattened
layout(binding = 1) buffer Indices { int indices[]; };            // Pre-computed max indices (Int32 from forward)
layout(binding = 2) buffer GradInput { float grad_input[]; };     // (N, C, H, W) output

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output gradient elements (N * C * H_out * W_out)
    uint grad_input_size;     // Total input gradient elements (N * C * H * W)
    uint out_plane;           // H_out * W_out
    uint in_plane;            // H * W
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Get gradient and target index
    float grad = grad_output[idx];
    // indices are plane-local (in_y*W + in_x); reconstruct the global input
    // offset via the per-(n,c) plane base.
    int plane_local = indices[idx];
    uint nc = idx / params.out_plane;
    int target_idx = int(nc * params.in_plane) + plane_local;

    // Bounds check and scatter gradient
    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAdd(grad_input[target_idx], grad);
    }
}
