#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Stack operation for BFloat16: stack tensors along a new dimension
// BFloat16 elements are packed 2 per 32-bit word in uint buffers
// Input tensors are passed as a flat concatenation in a single buffer.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };   // Packed BF16 pairs
layout(binding = 1) buffer Output { uint output_data[]; }; // Packed BF16 pairs

layout(push_constant) uniform PushConstants {
    uint num_tensors;
    uint elements_per_tensor;
    uint output_numel;
    uint outer_size;
    uint inner_size;
} params;

// Read a single BFloat16 element from packed uint32 input array
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint bits = (input_data[word_idx] >> half_offset) & 0xFFFFu;
    return unpackBF16x2(bits).x;
}

// Write a single BFloat16 element to packed uint32 output array using CAS loop
void writeBF16(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_bits = ((floatBitsToUint(value) + 0x7FFFu + ((floatBitsToUint(value) >> 16) & 1u)) >> 16);
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 1024; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.output_numel) return;

    // Decompose output index into (outer, tensor, inner) — matches stack.comp.
    // The previous dim=0 assumption produced transposed data for dim>=1.
    uint inner = idx % params.inner_size;
    uint tmp   = idx / params.inner_size;
    uint tensor_idx = tmp % params.num_tensors;
    uint outer = tmp / params.num_tensors;

    if (tensor_idx >= params.num_tensors) return;

    uint input_offset = tensor_idx * params.elements_per_tensor
                      + outer * params.inner_size
                      + inner;
    writeBF16(idx, readBF16(input_offset));
}
