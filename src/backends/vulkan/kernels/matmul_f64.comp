#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Matrix multiplication with tiling for Float64 — per-vendor workgroup specialization
layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout(constant_id = 0) const uint TILE_X = 16;  // default fallback
layout(constant_id = 1) const uint TILE_Y = 16;  // default fallback

layout(binding = 0) buffer MatrixA { double a[]; };
layout(binding = 1) buffer MatrixB { double b[]; };
layout(binding = 2) buffer MatrixC { double c[]; };

layout(push_constant) uniform PushConstants {
    uint M;  // rows of A
    uint N;  // cols of B
    uint K;  // cols of A / rows of B
} params;

shared double tileA[TILE_Y][TILE_X];
shared double tileB[TILE_X][TILE_X];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;
    uint linear_id = local_row * TILE_X + local_col;
    uint num_threads = TILE_X * TILE_Y;

    double sum = 0.0;

    // Tile-based computation — K is tiled in steps of TILE_X
    uint num_tiles = (params.K + TILE_X - 1) / TILE_X;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from A: TILE_Y x TILE_X elements, one per thread
        uint a_row = row;
        uint a_col = t * TILE_X + local_col;
        if (a_row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = a[a_row * params.K + a_col];
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from B: TILE_X x TILE_X elements, linearized across threads
        for (uint i = linear_id; i < TILE_X * TILE_X; i += num_threads) {
            uint br = i / TILE_X;
            uint bc = i % TILE_X;
            uint b_row = t * TILE_X + br;
            uint b_col = gl_WorkGroupID.x * TILE_X + bc;
            if (b_row < params.K && b_col < params.N) {
                tileB[br][bc] = b[b_row * params.N + b_col];
            } else {
                tileB[br][bc] = 0.0;
            }
        }

        barrier();

        // Compute partial dot product over TILE_X elements along K
        for (uint k = 0; k < TILE_X; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    // Write result
    if (row < params.M && col < params.N) {
        c[row * params.N + col] = sum;
    }
}
