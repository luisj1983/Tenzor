#version 450

// Generate Bluestein chirp sequence on GPU
// chirp[k] = exp(sign * j * pi * k^2 / N)
//          = cos(angle) + j*sin(angle), where angle = sign * pi * k^2 / N
// Output: interleaved real/imag pairs — [re0, im0, re1, im1, ...]

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer OutputBuf { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint N;          // Signal length
    int sign;        // +1 or -1 (forward = -1, inverse = +1)
};

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= N) return;

    // angle = sign * pi * k^2 / N. k^2/N grows to ~N, so the raw argument
    // reaches ~pi*N radians (e.g. ~1256 for N=400), far outside the range where
    // GLSL cos/sin keep precision — the resulting chirp is near-garbage and
    // inflates Bluestein FFT error ~500x. The chirp is periodic in k^2/N modulo
    // 2, so reduce k^2 modulo 2N first (exact integer arithmetic) and only then
    // scale by pi/N, keeping the trig argument within [0, 2*pi).
    uint twoN = 2u * N;
    uint kr = k % twoN;                 // (k mod 2N)^2 == k^2 (mod 2N)
    uint m = (kr * kr) % twoN;
    float angle = float(sign) * 3.14159265358979323846 * float(m) / float(N);
    float c = cos(angle);
    float s = sin(angle);

    uint base = k * 2;
    output_data[base]     = c;
    output_data[base + 1] = s;
}
