#version 450

// Blocked Cholesky - trailing matrix SYRK update - Float16 variant
// Matrix buffer uses packed uint32 (2 float16 values per word)
// All computation done in float32.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) buffer Matrix { uint A[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint block_size;
    uint batch_idx;
};

shared float L_row[32][32];
shared float L_col[32][32];

float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = A[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void writeF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = A[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(A[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: 65536 retries exceeded — hardware/driver failure.
    // Do NOT add a non-atomic fallback store: it would clobber the
    // neighbouring packed half-word (X.7 / Y.11 / Y.16).
}

void main() {
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint tile_row = gl_WorkGroupID.x;
    uint tile_col = gl_WorkGroupID.y;
    if (tile_row < tile_col) return;  // skip upper triangle

    uint trail_start = col_start + block_size;
    uint row_start = trail_start + tile_row * 32;
    uint col_start_tile = trail_start + tile_col * 32;

    if (row_start >= n || col_start_tile >= n) return;

    uint base = batch_idx * n * n;
    uint row_end = min(row_start + 32, n);
    uint col_end = min(col_start_tile + 32, n);
    uint actual_rows = row_end - row_start;
    uint actual_cols = col_end - col_start_tile;

    float acc[4] = {0.0, 0.0, 0.0, 0.0};

    for (uint kb = 0; kb < block_size; kb += 32) {
        uint k_len = min(32u, block_size - kb);

        // Load L[row_start:row_end, col_start+kb:col_start+kb+k_len]
        for (uint r = ty; r < actual_rows; r += 16) {
            for (uint c = tx; c < k_len; c += 16) {
                L_row[r][c] = readF16(base + (row_start + r) * n + (col_start + kb + c));
            }
        }
        // Load L[col_start_tile:col_end, col_start+kb:col_start+kb+k_len]
        for (uint r = ty; r < actual_cols; r += 16) {
            for (uint c = tx; c < k_len; c += 16) {
                L_col[r][c] = readF16(base + (col_start_tile + r) * n + (col_start + kb + c));
            }
        }
        barrier();

        for (uint dy = 0; dy < 2; dy++) {
            uint r = ty * 2 + dy;
            if (r >= actual_rows) continue;
            for (uint dx = 0; dx < 2; dx++) {
                uint c = tx * 2 + dx;
                if (c >= actual_cols) continue;
                float sum = 0.0;
                for (uint k = 0; k < k_len; k++) {
                    sum += L_row[r][k] * L_col[c][k];
                }
                acc[dy * 2 + dx] += sum;
            }
        }
        barrier();
    }

    for (uint dy = 0; dy < 2; dy++) {
        uint r = ty * 2 + dy;
        if (r >= actual_rows) continue;
        for (uint dx = 0; dx < 2; dx++) {
            uint c = tx * 2 + dx;
            if (c >= actual_cols) continue;
            uint elem_idx = base + (row_start + r) * n + (col_start_tile + c);
            float current = readF16(elem_idx);
            writeF16(elem_idx, current - acc[dy * 2 + dx]);
        }
    }
}
