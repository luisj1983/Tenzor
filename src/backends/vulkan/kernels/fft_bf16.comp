#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Cooley-Tukey radix-2 decimation-in-frequency FFT (complex-to-complex) — BFloat16
// Data layout: interleaved real/imag pairs stored as packed uint32 (2 x bfloat16 per word)
// Each complex element = 2 bfloat16 values = 1 uint32 word (real in low half, imag in high half)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;            // FFT size (power of 2)
    uint stage;        // Current butterfly stage (0 to log2(n)-1)
    uint direction;    // 0 = forward, 1 = inverse
    uint batch_size;   // Number of independent FFTs
    uint batch_stride; // Stride between batches (in complex elements)
};

const float PI = 3.14159265358979323846;

// Read one complex element (stored as one uint32 word with real in low 16, imag in high 16)
vec2 readComplex(uint base, uint complex_idx) {
    uint packed = data_in[base + complex_idx];
    vec2 unpacked = unpackBF16x2(packed);
    return unpacked; // .x = real, .y = imag
}

// Write one complex element
void writeComplex(uint base, uint complex_idx, vec2 val) {
    data_out[base + complex_idx] = packBF16x2(val);
}

void main() {
    uint tid = gl_GlobalInvocationID.x;

    uint n_butterflies = n / 2;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    // Each thread handles one butterfly pair
    uint half_size = 1u << stage;
    uint group_size = half_size << 1;

    uint group_idx = local_tid / half_size;
    uint pos_in_group = local_tid % half_size;

    uint idx_top = group_idx * group_size + pos_in_group;
    uint idx_bot = idx_top + half_size;

    if (idx_bot >= n) return;

    // Apply batch stride
    uint base = batch_idx * batch_stride;

    // Load data
    vec2 a = readComplex(base, idx_top);  // (a_re, a_im)
    vec2 b = readComplex(base, idx_bot);  // (b_re, b_im)

    // Compute twiddle factor
    float angle = -2.0 * PI * float(pos_in_group) / float(group_size);
    if (direction == 1) angle = -angle;

    float w_re = cos(angle);
    float w_im = sin(angle);

    // Butterfly: multiply bottom by twiddle, then add/sub
    float tw_re = b.x * w_re - b.y * w_im;
    float tw_im = b.x * w_im + b.y * w_re;

    // Write results
    writeComplex(base, idx_top, vec2(a.x + tw_re, a.y + tw_im));
    writeComplex(base, idx_bot, vec2(a.x - tw_re, a.y - tw_im));
}
