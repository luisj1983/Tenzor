#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Layer Normalization for Float64
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Output { double output_data[]; };
layout(binding = 2) buffer Gamma { double gamma_data[]; };    // Optional affine parameter
layout(binding = 3) buffer Beta { double beta_data[]; };      // Optional affine parameter

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint normalized_shape;  // Size of dimensions to normalize over
    float epsilon;
    uint affine;           // 0=no affine, 1=with affine
} params;

shared double shared_sum[256];
shared double shared_sum_sq[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.normalized_shape;

    // Step 1: Compute mean
    double local_sum = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        local_sum += input_data[base_idx + i];
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    double mean = shared_sum[0] / double(params.normalized_shape);
    barrier();

    // Step 2: Compute variance
    double local_sum_sq = 0.0;
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        double diff = input_data[base_idx + i] - mean;
        local_sum_sq += diff * diff;
    }
    shared_sum_sq[tid] = local_sum_sq;
    barrier();

    // Parallel reduction for sum of squares
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum_sq[tid] += shared_sum_sq[tid + s];
        }
        barrier();
    }

    double variance = shared_sum_sq[0] / double(params.normalized_shape);
    double inv_std = 1.0 / sqrt(variance + double(params.epsilon));
    barrier();

    // Step 3: Normalize and apply affine transformation
    for (uint i = tid; i < params.normalized_shape; i += 256) {
        double normalized = (input_data[base_idx + i] - mean) * inv_std;

        if (params.affine > 0) {
            normalized = normalized * gamma_data[i] + beta_data[i];
        }

        output_data[base_idx + i] = normalized;
    }
}
