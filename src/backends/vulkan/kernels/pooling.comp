#version 450

// Pooling operations: MaxPool2d, AvgPool2d
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint in_height;
    uint in_width;
    uint out_height;
    uint out_width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint padding_h;
    uint padding_w;
    uint pool_type; // 0=max, 1=avg
} params;

void main() {
    uint out_x = gl_GlobalInvocationID.x;
    uint out_y = gl_GlobalInvocationID.y;
    // z encodes the flattened (batch, channel) index: bc = n * channels + c.
    // Decode it so pooling is correct for batch > 1.
    uint bc = gl_GlobalInvocationID.z;
    uint c = bc % params.channels;
    uint n = bc / params.channels;

    if (out_x >= params.out_width || out_y >= params.out_height ||
        n >= params.batch) {
        return;
    }

    float result;
    if (params.pool_type == 0) {
        // MaxPool
        result = -1.0 / 0.0; // -infinity
    } else {
        // AvgPool
        result = 0.0;
    }

    uint count = 0;

    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int in_y = int(out_y * params.stride_h) - int(params.padding_h) + int(kh);
            int in_x = int(out_x * params.stride_w) - int(params.padding_w) + int(kw);

            if (in_y >= 0 && in_y < int(params.in_height) &&
                in_x >= 0 && in_x < int(params.in_width)) {
                uint input_idx = (n * params.channels + c) *
                                    params.in_height * params.in_width +
                                uint(in_y) * params.in_width + uint(in_x);
                float value = input_data[input_idx];

                if (params.pool_type == 0) {
                    // MaxPool
                    result = max(result, value);
                } else {
                    // AvgPool
                    result += value;
                    count++;
                }
            }
        }
    }

    if (params.pool_type == 1 && count > 0) {
        result /= float(count);
    }

    // Write output
    uint output_idx = (n * params.channels + c) *
                        params.out_height * params.out_width +
                     out_y * params.out_width + out_x;
    output_data[output_idx] = result;
}
