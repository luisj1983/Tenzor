#version 450

// Gather for 16-bit dtypes (Int16 / UInt16): raw 16-bit element move (no float
// interpretation, unlike gather_f16). Elements are packed 2 per 32-bit word.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // packed 2x u16
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { uint output_data[]; };  // packed 2x u16

layout(push_constant) uniform PushConstants {
    uint input_size;
    uint output_size;
    uint dim;
    uint dim_size;
    uint inner_size;
    uint outer_size;
    uint input_dim_size;
} params;

uint readU16(uint e) {
    uint w = input_data[e >> 1];
    return ((e & 1u) == 0u) ? (w & 0xFFFFu) : (w >> 16);
}

void writeU16(uint e, uint v16) {
    uint widx = e >> 1;
    uint shift = (e & 1u) * 16u;
    uint mask = 0xFFFFu << shift;
    uint vv = (v16 & 0xFFFFu) << shift;
    uint old = output_data[widx];
    uint expected;
    do {
        expected = old;
        uint nw = (expected & ~mask) | vv;
        old = atomicCompSwap(output_data[widx], expected, nw);
    } while (old != expected);
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;
    if (out_idx >= params.output_size) return;

    uint outer_idx = out_idx / (params.inner_size * params.dim_size);
    uint remainder = out_idx % (params.inner_size * params.dim_size);
    uint inner_idx = remainder % params.inner_size;

    int gather_idx = indices[out_idx];
    if (gather_idx < 0 || gather_idx >= int(params.input_dim_size)) {
        writeU16(out_idx, 0u);
        return;
    }

    uint in_idx = outer_idx * (params.input_dim_size * params.inner_size) +
                  uint(gather_idx) * params.inner_size +
                  inner_idx;
    writeU16(out_idx, readU16(in_idx));
}
