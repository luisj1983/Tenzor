#version 450

// Gather for 16-bit dtypes (Int16 / UInt16): raw 16-bit element move (no float
// interpretation, unlike gather_f16). Elements are packed 2 per 32-bit word.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // packed 2x u16
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { uint output_data[]; };  // packed 2x u16

// See gather.comp for the per-dim decomposition rationale.
layout(push_constant) uniform PushConstants {
    uint output_size;
    uint input_size;
    uint ndim;
    uint dim;
    uint input_dim_size;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    uvec4 idx_shape_0_3;
    uvec4 idx_shape_4_7;
    ivec4 in_stride_0_3;
    ivec4 in_stride_4_7;
} params;

uint readU16(uint e) {
    uint w = input_data[e >> 1];
    return ((e & 1u) == 0u) ? (w & 0xFFFFu) : (w >> 16);
}

void writeU16(uint e, uint v16) {
    uint widx = e >> 1;
    uint shift = (e & 1u) * 16u;
    uint mask = 0xFFFFu << shift;
    uint vv = (v16 & 0xFFFFu) << shift;
    uint old = output_data[widx];
    uint expected;
    do {
        expected = old;
        uint nw = (expected & ~mask) | vv;
        old = atomicCompSwap(output_data[widx], expected, nw);
    } while (old != expected);
}

void main() {
    uint out_idx = gl_GlobalInvocationID.x;
    if (out_idx >= params.output_size) return;
    if (params.ndim > 8u) return;

    uint ish[8];
    ish[0] = max(params.idx_shape_0_3.x, 1u);
    ish[1] = max(params.idx_shape_0_3.y, 1u);
    ish[2] = max(params.idx_shape_0_3.z, 1u);
    ish[3] = max(params.idx_shape_0_3.w, 1u);
    ish[4] = max(params.idx_shape_4_7.x, 1u);
    ish[5] = max(params.idx_shape_4_7.y, 1u);
    ish[6] = max(params.idx_shape_4_7.z, 1u);
    ish[7] = max(params.idx_shape_4_7.w, 1u);
    int ist[8];
    ist[0] = params.in_stride_0_3.x;
    ist[1] = params.in_stride_0_3.y;
    ist[2] = params.in_stride_0_3.z;
    ist[3] = params.in_stride_0_3.w;
    ist[4] = params.in_stride_4_7.x;
    ist[5] = params.in_stride_4_7.y;
    ist[6] = params.in_stride_4_7.z;
    ist[7] = params.in_stride_4_7.w;

    int gather_idx = indices[out_idx];
    if (gather_idx < 0) gather_idx += int(params.input_dim_size);

    if (gather_idx < 0 || gather_idx >= int(params.input_dim_size)) {
        writeU16(out_idx, 0u);
        return;
    }

    uint remaining = out_idx;
    int in_off = 0;
    for (int d = int(params.ndim) - 1; d >= 0; --d) {
        uint coord = remaining % ish[d];
        remaining /= ish[d];
        uint c = (uint(d) == params.dim) ? uint(gather_idx) : coord;
        in_off += int(c) * ist[d];
    }

    if (in_off < 0 || uint(in_off) >= params.input_size) {
        writeU16(out_idx, 0u);
        return;
    }

    writeU16(out_idx, readU16(uint(in_off)));
}
