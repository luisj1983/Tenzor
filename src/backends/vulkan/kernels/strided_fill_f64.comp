#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Strided Fill — Float64 variant
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Data { double data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint ndim;
    // fill_value as two uint32 since push constants can't mix float64 alignment easily
    uint fill_value_lo;  // Low 32 bits of double
    uint fill_value_hi;  // High 32 bits of double
    uint shape_stride[16];
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint physical_offset = 0;
    uint rem = idx;
    for (int d = int(params.ndim) - 1; d >= 0; d--) {
        uint dim_size = params.shape_stride[2 * d];
        uint dim_stride = params.shape_stride[2 * d + 1];
        uint coord = rem % dim_size;
        rem /= dim_size;
        physical_offset += coord * dim_stride;
    }

    // Reconstruct double from two uint32s
    uvec2 bits = uvec2(params.fill_value_lo, params.fill_value_hi);
    data[physical_offset] = packDouble2x32(bits);
}
