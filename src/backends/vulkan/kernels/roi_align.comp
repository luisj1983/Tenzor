#version 450

// ROI Align Forward Pass (Float32)
// Extracts fixed-size feature maps from regions of interest using bilinear interpolation
// Input: features (N, C, H, W), rois (num_rois, 5) where each roi = [batch_idx, x1, y1, x2, y2]
// Output: (num_rois, C, output_h, output_w)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Features { float features_data[]; };
layout(binding = 1) buffer ROIs { float rois_data[]; };
layout(binding = 2) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output elements
    uint num_rois;            // Number of ROIs
    uint channels;            // C
    uint feat_height;         // H
    uint feat_width;          // W
    uint output_h;            // Output height per ROI
    uint output_w;            // Output width per ROI
    uint spatial_scale_bits;  // spatial_scale as float reinterpreted as uint
    uint sampling_ratio;      // Number of sampling points per bin (0 = adaptive)
    uint aligned;             // 1 if aligned mode, 0 otherwise
    uint batch_size;          // N (number of feature-map batches) for ROI bounds check
} params;

float bilinear_interpolate(uint base_offset, float y, float x) {
    int height = int(params.feat_height);
    int width = int(params.feat_width);

    // Handle out of bounds
    if (y < -1.0 || y > float(height) || x < -1.0 || x > float(width)) {
        return 0.0;
    }

    // Clamp to valid range
    y = max(0.0, min(y, float(height - 1)));
    x = max(0.0, min(x, float(width - 1)));

    int y_low = int(floor(y));
    int x_low = int(floor(x));
    int y_high = min(y_low + 1, height - 1);
    int x_high = min(x_low + 1, width - 1);

    float ly = y - float(y_low);
    float lx = x - float(x_low);
    float hy = 1.0 - ly;
    float hx = 1.0 - lx;

    float v1 = features_data[base_offset + y_low * width + x_low];
    float v2 = features_data[base_offset + y_low * width + x_high];
    float v3 = features_data[base_offset + y_high * width + x_low];
    float v4 = features_data[base_offset + y_high * width + x_high];

    return hy * hx * v1 + hy * lx * v2 + ly * hx * v3 + ly * lx * v4;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (roi_idx, c, ph, pw)
    uint temp = idx;
    uint pw = temp % params.output_w;
    temp /= params.output_w;
    uint ph = temp % params.output_h;
    temp /= params.output_h;
    uint c = temp % params.channels;
    uint roi_idx = temp / params.channels;

    // Read ROI: [batch_idx, x1, y1, x2, y2]
    uint roi_base = roi_idx * 5;
    // Validate the ROI batch index before using it to index features. ROI batch
    // ids come from upstream (e.g. RPN output) and are not guaranteed in range;
    // an out-of-range/negative value would read arbitrary device memory. Match the
    // CPU reference: zero this output element and return. Read as signed first so a
    // negative float is caught rather than wrapping to a huge uint.
    int batch_idx_signed = int(rois_data[roi_base]);
    if (batch_idx_signed < 0 || uint(batch_idx_signed) >= params.batch_size) {
        output_data[idx] = 0.0;
        return;
    }
    uint batch_idx = uint(batch_idx_signed);
    float spatial_scale = uintBitsToFloat(params.spatial_scale_bits);

    float roi_x1 = rois_data[roi_base + 1] * spatial_scale;
    float roi_y1 = rois_data[roi_base + 2] * spatial_scale;
    float roi_x2 = rois_data[roi_base + 3] * spatial_scale;
    float roi_y2 = rois_data[roi_base + 4] * spatial_scale;

    // Aligned mode: shift by 0.5 pixel
    if (params.aligned != 0) {
        roi_x1 -= 0.5;
        roi_y1 -= 0.5;
        roi_x2 -= 0.5;
        roi_y2 -= 0.5;
    }

    float roi_width = roi_x2 - roi_x1;
    float roi_height = roi_y2 - roi_y1;

    float bin_size_h = roi_height / float(params.output_h);
    float bin_size_w = roi_width / float(params.output_w);

    // Determine sampling grid
    // Clamp the adaptive grid to a minimum of 1 (matching torchvision): a
    // degenerate/zero-area ROI gives bin_size <= 0 -> ceil() == 0 -> count == 0
    // -> 0/0 NaN below. max(1u, ...) keeps at least one sample.
    uint roi_bin_grid_h = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : max(1u, uint(ceil(bin_size_h)));
    uint roi_bin_grid_w = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : max(1u, uint(ceil(bin_size_w)));

    uint count = roi_bin_grid_h * roi_bin_grid_w;

    // Base offset for this batch and channel in features
    uint base_offset = batch_idx * params.channels * params.feat_height * params.feat_width
                     + c * params.feat_height * params.feat_width;

    float sum = 0.0;

    for (uint iy = 0; iy < roi_bin_grid_h; iy++) {
        for (uint ix = 0; ix < roi_bin_grid_w; ix++) {
            float y = roi_y1 + float(ph) * bin_size_h
                    + (float(iy) + 0.5) * bin_size_h / float(roi_bin_grid_h);
            float x = roi_x1 + float(pw) * bin_size_w
                    + (float(ix) + 0.5) * bin_size_w / float(roi_bin_grid_w);

            sum += bilinear_interpolate(base_offset, y, x);
        }
    }

    output_data[idx] = sum / float(count);
}
