#version 450

// Bit-reversal permutation for FFT input/output reordering
// Rearranges complex elements so that element at index i moves to bit_reverse(i)
// Data layout: interleaved real/imag pairs

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { float data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;            // FFT size (power of 2)
    uint log2_n;       // log2(n)
    uint batch_offset; // Offset in complex elements
};

uint bit_reverse(uint x, uint bits) {
    uint result = 0;
    for (uint i = 0; i < bits; i++) {
        result = (result << 1) | (x & 1);
        x >>= 1;
    }
    return result;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= n) return;

    uint rev = bit_reverse(tid, log2_n);

    // Copy complex element from position tid to position rev
    uint src = (batch_offset + tid) * 2;
    uint dst = (batch_offset + rev) * 2;

    data_out[dst]     = data_in[src];
    data_out[dst + 1] = data_in[src + 1];
}
