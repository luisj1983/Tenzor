#version 450

// Stockham mixed-radix FFT: radix-3 butterfly stage (BFloat16)
// Data layout: interleaved real/imag pairs, packed as uint32 (2 bf16 per word)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };  // packed bf16 pairs
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint stage_stride;
    uint direction;
    uint batch_offset;
};

const float PI = 3.14159265358979323846;
const float COS_2PI_3 = -0.5;
const float SIN_2PI_3 = 0.86602540378443864676;

float readBF16Element(uint element_idx) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint packed = data_in[pair_idx];
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

void writeBF16Element(uint element_idx, float val) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    uint b = floatBitsToUint(val);
    uint bits = (b + 0x7FFFu + ((b >> 16) & 1u)) >> 16;
    if (offset == 0) {
        uint existing = data_out[pair_idx] & 0xFFFF0000u;
        data_out[pair_idx] = existing | bits;
    } else {
        uint existing = data_out[pair_idx] & 0x0000FFFFu;
        data_out[pair_idx] = existing | (bits << 16);
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 3;
    if (tid >= n_butterflies) return;

    uint group = tid / stage_stride;
    uint pos = tid % stage_stride;

    uint i0 = group * stage_stride * 3 + pos;
    uint i1 = i0 + stage_stride;
    uint i2 = i1 + stage_stride;

    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;
    uint o2 = o1 + n_butterflies;

    // Each complex = 2 bf16 elements
    uint b0_in = (batch_offset + i0) * 2;
    uint b1_in = (batch_offset + i1) * 2;
    uint b2_in = (batch_offset + i2) * 2;
    uint b0_out = (batch_offset + o0) * 2;
    uint b1_out = (batch_offset + o1) * 2;
    uint b2_out = (batch_offset + o2) * 2;

    // Read and compute in F32
    float a0_re = readBF16Element(b0_in), a0_im = readBF16Element(b0_in + 1);
    float a1_re = readBF16Element(b1_in), a1_im = readBF16Element(b1_in + 1);
    float a2_re = readBF16Element(b2_in), a2_im = readBF16Element(b2_in + 1);

    float angle1 = -2.0 * PI * float(pos) / float(stage_stride * 3);
    float angle2 = 2.0 * angle1;
    if (direction == 1) { angle1 = -angle1; angle2 = -angle2; }

    float w1_re = cos(angle1), w1_im = sin(angle1);
    float w2_re = cos(angle2), w2_im = sin(angle2);

    float t1_re = a1_re * w1_re - a1_im * w1_im;
    float t1_im = a1_re * w1_im + a1_im * w1_re;
    float t2_re = a2_re * w2_re - a2_im * w2_im;
    float t2_im = a2_re * w2_im + a2_im * w2_re;

    float s1_re = t1_re + t2_re, s1_im = t1_im + t2_im;
    float d1_re = t1_re - t2_re, d1_im = t1_im - t2_im;

    writeBF16Element(b0_out,     a0_re + s1_re);
    writeBF16Element(b0_out + 1, a0_im + s1_im);
    writeBF16Element(b1_out,     a0_re + COS_2PI_3 * s1_re - SIN_2PI_3 * d1_im);
    writeBF16Element(b1_out + 1, a0_im + COS_2PI_3 * s1_im + SIN_2PI_3 * d1_re);
    writeBF16Element(b2_out,     a0_re + COS_2PI_3 * s1_re + SIN_2PI_3 * d1_im);
    writeBF16Element(b2_out + 1, a0_im + COS_2PI_3 * s1_im - SIN_2PI_3 * d1_re);
}
