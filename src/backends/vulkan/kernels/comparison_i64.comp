#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

// Comparison operations for Int64 dtype: eq, ne, lt, le, gt, ge
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputA { int64_t a[]; };
layout(binding = 1) buffer InputB { int64_t b[]; };
layout(binding = 2) buffer Output { uint8_t result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=eq, 1=ne, 2=lt, 3=le, 4=gt, 5=ge
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    int64_t val_a = a[idx];
    int64_t val_b = b[idx];

    uint8_t result_val;
    switch (params.op) {
        case 0u: // eq (equal)
            result_val = (val_a == val_b) ? uint8_t(1) : uint8_t(0);
            break;
        case 1u: // ne (not equal)
            result_val = (val_a != val_b) ? uint8_t(1) : uint8_t(0);
            break;
        case 2u: // lt (less than)
            result_val = (val_a < val_b) ? uint8_t(1) : uint8_t(0);
            break;
        case 3u: // le (less than or equal)
            result_val = (val_a <= val_b) ? uint8_t(1) : uint8_t(0);
            break;
        case 4u: // gt (greater than)
            result_val = (val_a > val_b) ? uint8_t(1) : uint8_t(0);
            break;
        case 5u: // ge (greater than or equal)
            result_val = (val_a >= val_b) ? uint8_t(1) : uint8_t(0);
            break;
        default:
            result_val = uint8_t(0);
            break;
    }

    result[idx] = result_val;
}
