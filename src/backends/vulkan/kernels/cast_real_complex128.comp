#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Cast real (float64) to complex128 (interleaved float64 pairs).
// Each output element is [real, 0.0] from the corresponding input element.
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input  { float64_t input_data[]; };
layout(binding = 1) writeonly buffer Output { float64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_elements) return;

    output_data[idx * 2]     = input_data[idx];           // real part
    output_data[idx * 2 + 1] = float64_t(0.0);            // imaginary part = 0
}
