#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Cross Entropy Loss for Float16
// F16 packed buffers (2 Float16 per uint32), arithmetic in float32
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer LogProbs { uint log_probs[]; };     // Log probabilities (batch_size x num_classes), packed F16
layout(binding = 1) buffer Targets { int targets[]; };          // Target class indices (batch_size)
layout(binding = 2) buffer Losses { uint losses[]; };           // Output losses (batch_size), packed F16

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint reduction;  // 0=none, 1=mean, 2=sum
} params;

shared float shared_sum[WORKGROUP_SIZE];

// Read a single float16 element from packed uint buffer
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = log_probs[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write a single float16 element to the losses buffer using atomic CAS.
// For reduction==none, adjacent samples idx and idx+1 share one 32-bit word
// (word = idx/2) and run concurrently, so a plain read-modify-write would let
// one sample clobber the other's half-word. Use a bounded atomicCompSwap loop.
void writeF16Loss(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = losses[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(losses[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT add a non-atomic fallback store — it would clobber the
    // neighbouring packed half-word.
}

float sample_loss(uint s_idx) {
    int target = targets[s_idx];
    if (target >= 0 && target < int(params.num_classes)) {
        // Cross entropy: -log(p[target]). Read packed F16, compute in float32.
        return -readF16(s_idx * params.num_classes + uint(target));
    }
    return 0.0;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;

    if (params.reduction == 0) {
        if (idx < params.batch_size) {
            writeF16Loss(idx, sample_loss(idx));
        }
        return;
    }

    // Reduction (mean/sum): host launches ONE workgroup, so each thread must
    // block-stride over the whole batch before the tree reduction.
    float acc = 0.0;
    for (uint i = tid; i < params.batch_size; i += WORKGROUP_SIZE) {
        acc += sample_loss(i);
    }
    shared_sum[tid] = acc;
    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        float total = shared_sum[0];
        if (params.reduction == 1) { // mean
            total /= float(params.batch_size);
        }
        writeF16Loss(0, total);
    }
}
