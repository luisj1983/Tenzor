#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Cast Int32 -> Bool: out = (in != 0). Bool is stored as uint8_t to match
// the rest of the Vulkan backend (cast_f32_bool, cast_bool_i64).
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    int data[];
} input_buf;

layout(set = 0, binding = 1) writeonly buffer OutputBuffer {
    uint8_t data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;
    output_buf.data[idx] = (input_buf.data[idx] != 0) ? uint8_t(1) : uint8_t(0);
}
