#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Backward activation functions for Float16 autograd
// Operations: 0=relu, 1=sigmoid, 2=tanh, 3=leaky_relu, 4=gelu
// Float16 elements are packed 2 per 32-bit word

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };
layout(binding = 1) buffer InputOrOutput { uint input_or_output[]; };
layout(binding = 2) buffer GradInput { uint grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation code
    float alpha;     // For leaky_relu_backward
} params;

const float PI = 3.14159265359;

// erf via Abramowitz & Stegun 7.1.26 (max abs error ~1.5e-7); exact erf GELU
// matches the forward and the other backends.
float erf_approx(float x) {
    float s = sign(x);
    float ax = abs(x);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t
                      - 0.284496736) * t + 0.254829592) * t * exp(-ax * ax);
    return s * y;
}

// Helper to pack two float16 values
uint packF16Pair(float v0, float v1) {
    uint bits0 = packHalf2x16(vec2(v0, 0.0)) & 0xFFFFu;
    uint bits1 = packHalf2x16(vec2(v1, 0.0)) & 0xFFFFu;
    return bits0 | (bits1 << 16);
}

float apply_backward(float g_out, float val) {
    switch (params.op) {
        case 0: // relu_backward: grad_output * (input > 0 ? 1 : 0)
            return (val > 0.0) ? g_out : 0.0;

        case 1: // sigmoid_backward: grad_output * output * (1 - output)
            // val is the output of sigmoid
            return g_out * val * (1.0 - val);

        case 2: // tanh_backward: grad_output * (1 - output * output)
            // val is the output of tanh
            return g_out * (1.0 - val * val);

        case 3: // leaky_relu_backward: grad_output * (input > 0 ? 1 : alpha)
            // val is the input
            return (val > 0.0) ? g_out : params.alpha * g_out;

        case 4: { // gelu_backward (exact erf):
            // gelu'(x) = 0.5*(1+erf(x/sqrt(2))) + x*(1/sqrt(2*pi))*exp(-x^2/2)
            float x = val;  // val is the input
            float cdf = 0.5 * (1.0 + erf_approx(x * 0.70710678));
            float pdf = 0.39894228 * exp(-0.5 * x * x);  // 1/sqrt(2*pi)
            return g_out * (cdf + x * pdf);
        }

        default:
            return 0.0;
    }
}

void main() {
    // Process 2 elements per thread (since float16 is packed 2 per uint32)
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    if (idx0 >= params.n) {
        return;
    }

    // Read packed inputs
    uint packed_grad_out = grad_output[pair_idx];
    uint packed_val = input_or_output[pair_idx];

    // Unpack grad_output
    uint bits_g0 = packed_grad_out & 0xFFFFu;
    uint bits_g1 = (packed_grad_out >> 16) & 0xFFFFu;
    float g_out0 = unpackHalf2x16(bits_g0 | (bits_g0 << 16)).x;
    float g_out1 = unpackHalf2x16(bits_g1 | (bits_g1 << 16)).x;

    // Unpack input_or_output
    uint bits_v0 = packed_val & 0xFFFFu;
    uint bits_v1 = (packed_val >> 16) & 0xFFFFu;
    float val0 = unpackHalf2x16(bits_v0 | (bits_v0 << 16)).x;
    float val1 = unpackHalf2x16(bits_v1 | (bits_v1 << 16)).x;

    // Apply backward activation
    float result0 = apply_backward(g_out0, val0);
    float result1 = (idx1 < params.n) ? apply_backward(g_out1, val1) : 0.0;

    // Pack and write output
    grad_input[pair_idx] = packF16Pair(result0, result1);
}
