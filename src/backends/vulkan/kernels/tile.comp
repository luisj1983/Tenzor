#version 450

// Tile operation: repeat tensor along dimensions using modular indexing
// Each thread computes one output element by mapping its output coordinates
// back to input coordinates via modulo with the input shape.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };
layout(binding = 2) buffer InputShape { uint input_shape[]; };
layout(binding = 3) buffer OutputShape { uint output_shape[]; };

layout(push_constant) uniform PushConstants {
    uint output_numel;  // Total output elements
    uint ndims;         // Number of dimensions
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.output_numel) return;

    // Decompose output flat index into multi-dimensional coordinates,
    // then map each coordinate to input space via modulo.
    uint out_remaining = idx;
    uint input_idx = 0;
    uint input_stride = 1;

    // Process dimensions from last to first to compute input linear index.
    // We accumulate the input stride as we go.
    // First pass: compute input strides (product of input_shape from right)
    // We do this in a single reverse pass.
    uint in_coords[8];
    uint in_strides[8];

    // Compute input strides
    uint dims = min(params.ndims, 8u);
    if (dims > 0) {
        in_strides[dims - 1] = 1;
        for (int d = int(dims) - 2; d >= 0; d--) {
            in_strides[d] = in_strides[d + 1] * input_shape[d + 1];
        }
    }

    // Decompose output index and map to input via modulo
    uint temp = idx;
    for (int d = int(dims) - 1; d >= 0; d--) {
        uint out_coord = temp % output_shape[d];
        temp /= output_shape[d];

        // Map output coordinate to input coordinate via modulo
        uint in_coord = out_coord % input_shape[d];
        in_coords[d] = in_coord;
    }

    // Compute input flat index from input coordinates and strides
    input_idx = 0;
    for (uint d = 0; d < dims; d++) {
        input_idx += in_coords[d] * in_strides[d];
    }

    output_data[idx] = input_data[input_idx];
}
