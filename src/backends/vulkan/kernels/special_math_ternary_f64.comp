#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

// Special math ternary operation, Float64 path:
//   0=betainc(a, b, x) — regularized incomplete beta function I_x(a,b)
//
// Computed entirely in double precision. Uses Lentz's continued-fraction
// algorithm matching the CPU implementation. SPIR-V's Float64 capability
// covers arithmetic only — no transcendentals — so log64/exp64/sin64 are
// implemented inline using:
//   * frexp / ldexp (which ARE available in fp64) for range reduction,
//   * polynomial approximations (Taylor / atanh series) for the kernel.
// Each routine targets ≥1e-15 relative accuracy; combined with the Lentz
// CF convergence at 1e-15, the whole pipeline matches the CPU result to
// within rtol 1e-12 — well below the gradcheck Float64 tolerance.

layout(local_size_x_id = 0) in;
layout(binding = 0) buffer InputA { double a_data[]; };
layout(binding = 1) buffer InputB { double b_data[]; };
layout(binding = 2) buffer InputX { double x_data[]; };
layout(binding = 3) buffer Output { double out_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint op;
} params;

const double PI       = 3.141592653589793;
const double TWO_PI   = 6.283185307179586;
const double PI_HALF  = 1.5707963267948966;
const double LN2      = 0.6931471805599453;     // round-to-nearest double of ln(2)
const double SQRT_HALF = 0.7071067811865476;

double abs64(double x) { return x < 0.0 ? -x : x; }

// log64(x) for x > 0, via:
//   x = m * 2^e, m ∈ [√(1/2), √2) ⇒ |y = (m-1)/(m+1)| ≤ 0.1716
//   log(m) = 2 * atanh(y) = 2y * (1 + y²/3 + y⁴/5 + … + y²⁰/21)
//   log(x) = e*ln(2) + log(m).
// Truncation error at y²² is bounded by 0.0294¹¹/23 ≈ 1.3e-18 — full ULP.
double log64(double x) {
    int e;
    double m = frexp(x, e);            // m ∈ [0.5, 1)
    if (m < SQRT_HALF) { m *= 2.0; e -= 1; }
    double y = (m - 1.0) / (m + 1.0);
    double y2 = y * y;
    double s = 1.0 / 21.0;
    s = s * y2 + 1.0 / 19.0;
    s = s * y2 + 1.0 / 17.0;
    s = s * y2 + 1.0 / 15.0;
    s = s * y2 + 1.0 / 13.0;
    s = s * y2 + 1.0 / 11.0;
    s = s * y2 + 1.0 /  9.0;
    s = s * y2 + 1.0 /  7.0;
    s = s * y2 + 1.0 /  5.0;
    s = s * y2 + 1.0 /  3.0;
    s = s * y2 + 1.0;
    double log_m = 2.0 * y * s;
    return double(e) * LN2 + log_m;
}

// exp64(x) via:
//   k = round(x / ln 2), r = x - k*ln 2 ∈ [-ln 2/2, ln 2/2]
//   exp(x) = 2^k * exp(r), exp(r) by 14-term Taylor.
//   |r|¹⁵/15! ≤ 0.347¹⁵ / 1.3e12 ≈ 1e-12 — overshoot; we use 14 terms which
//   gives r¹⁴/14! ≤ 0.347¹⁴ / 87e9 ≈ 5e-20.
// Cody-Waite split avoids cancellation in (x - k·ln 2) for moderate k.
double exp64(double x) {
    if (x >  709.7) return 1.0 / 0.0;     // overflow
    if (x < -745.0) return 0.0;           // underflow
    const double LOG2E   = 1.4426950408889634;
    const double LN2_HI  = 0.6931471803691238;
    const double LN2_LO  = 1.9082149292705877e-10;
    double kf = floor(x * LOG2E + 0.5);
    int k = int(kf);
    // Subtract in Cody-Waite split for full precision r:
    double r = (x - kf * LN2_HI) - kf * LN2_LO;

    // Horner over 1 + r + r²/2! + ... + r¹⁴/14!
    double t = 1.0 / 87178291200.0;          // 1/14!
    t = t * r + 1.0 / 6227020800.0;          // 1/13!
    t = t * r + 1.0 / 479001600.0;           // 1/12!
    t = t * r + 1.0 / 39916800.0;            // 1/11!
    t = t * r + 1.0 / 3628800.0;             // 1/10!
    t = t * r + 1.0 / 362880.0;              // 1/9!
    t = t * r + 1.0 / 40320.0;               // 1/8!
    t = t * r + 1.0 / 5040.0;                // 1/7!
    t = t * r + 1.0 / 720.0;                 // 1/6!
    t = t * r + 1.0 / 120.0;                 // 1/5!
    t = t * r + 1.0 / 24.0;                  // 1/4!
    t = t * r + 1.0 / 6.0;                   // 1/3!
    t = t * r + 0.5;                         // 1/2!
    t = t * r + 1.0;                         // 1/1!
    t = t * r + 1.0;                         // 1/0!

    return ldexp(t, k);
}

// sin64(x) via:
//   r = x mod 2π, then reduce to [-π/2, π/2] using the identities
//     sin(r)  = sin(π - r)   for r ∈ ( π/2,  π]
//     sin(r)  = sin(-π - r)  for r ∈ [-π, -π/2)
//   Taylor: sin(r) = r * (1 - r²/3! + r⁴/5! - … - r²⁰/21!)
//   |r|²¹ / 21! ≤ 1.57²¹ / 5.1e19 ≈ 2e-16 ⇒ ~ULP precision.
double sin64(double x) {
    double q = floor(x / TWO_PI + 0.5);
    double r = x - q * TWO_PI;            // r ∈ [-π, π]
    if (r >  PI_HALF) r = PI - r;
    if (r < -PI_HALF) r = -PI - r;

    double r2 = r * r;
    // Horner: a_k = (-1)^k / (2k+1)!
    double s = 1.0 / 51090942171709440000.0;     //  +1/21!
    s = s * r2 - 1.0 / 121645100408832000.0;     //  -1/19!
    s = s * r2 + 1.0 / 355687428096000.0;        //  +1/17!
    s = s * r2 - 1.0 / 1307674368000.0;          //  -1/15!
    s = s * r2 + 1.0 / 6227020800.0;             //  +1/13!
    s = s * r2 - 1.0 / 39916800.0;               //  -1/11!
    s = s * r2 + 1.0 / 362880.0;                 //  +1/9!
    s = s * r2 - 1.0 / 5040.0;                   //  -1/7!
    s = s * r2 + 1.0 / 120.0;                    //  +1/5!
    s = s * r2 - 1.0 / 6.0;                      //  -1/3!
    s = s * r2 + 1.0;                            //  +1
    return r * s;
}

double lgamma_lanczos(double x) {
    double coef[9];
    coef[0] = 0.99999999999980993;
    coef[1] = 676.5203681218851;
    coef[2] = -1259.1392167224028;
    coef[3] = 771.32342877765313;
    coef[4] = -176.61502916214059;
    coef[5] = 12.507343278686905;
    coef[6] = -0.13857109526572012;
    coef[7] = 9.9843695780195716e-6;
    coef[8] = 1.5056327351493116e-7;

    double g = 7.0;
    double xm1 = x - 1.0;
    double a = coef[0];
    double t = xm1 + g + 0.5;
    for (int i = 1; i < 9; ++i) {
        a += coef[i] / (xm1 + double(i));
    }
    return 0.5 * log64(2.0 * PI) + (xm1 + 0.5) * log64(t) - t + log64(a);
}

double lgamma_impl(double x) {
    if (x < 0.5) {
        return log64(PI / abs64(sin64(PI * x))) - lgamma_lanczos(1.0 - x);
    }
    return lgamma_lanczos(x);
}

double betainc_impl(double a, double b, double x) {
    if (x < 0.0 || x > 1.0) return 0.0 / 0.0;  // NaN
    if (x == 0.0) return 0.0;
    if (x == 1.0) return 1.0;

    bool flipped = false;
    if (x > (a + 1.0) / (a + b + 2.0)) {
        double tmp = a; a = b; b = tmp;
        x = 1.0 - x;
        flipped = true;
    }

    double lbeta = lgamma_impl(a) + lgamma_impl(b) - lgamma_impl(a + b);
    double front = exp64(log64(x) * a + log64(1.0 - x) * b - lbeta) / a;

    double f = 1.0, c = 1.0, d = 1.0 - (a + b) * x / (a + 1.0);
    if (abs64(d) < 1.0e-300) d = 1.0e-300;
    d = 1.0 / d;
    f = d;

    for (int m = 1; m <= 200; ++m) {
        double num = double(m) * (b - double(m)) * x
                   / ((a + 2.0 * double(m) - 1.0) * (a + 2.0 * double(m)));
        d = 1.0 + num * d; if (abs64(d) < 1.0e-300) d = 1.0e-300; d = 1.0 / d;
        c = 1.0 + num / c; if (abs64(c) < 1.0e-300) c = 1.0e-300;
        f *= d * c;

        num = -((a + double(m)) * (a + b + double(m)) * x)
            / ((a + 2.0 * double(m)) * (a + 2.0 * double(m) + 1.0));
        d = 1.0 + num * d; if (abs64(d) < 1.0e-300) d = 1.0e-300; d = 1.0 / d;
        c = 1.0 + num / c; if (abs64(c) < 1.0e-300) c = 1.0e-300;
        double delta = d * c;
        f *= delta;
        if (abs64(delta - 1.0) < 1.0e-15) break;
    }
    double val = front * f;
    return flipped ? (1.0 - val) : val;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;
    double a = a_data[idx];
    double b = b_data[idx];
    double x = x_data[idx];
    out_data[idx] = betainc_impl(a, b, x);
}
