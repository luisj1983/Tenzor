#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

// Special math ternary operation, Float64 path:
//   0=betainc(a, b, x) — regularized incomplete beta function I_x(a,b)
//
// Uses Lentz's continued-fraction algorithm matching the CPU implementation,
// computed in double precision throughout. The Float32 variant only carries
// ~7 significant digits, which broke gradcheck for `betainc` wrt x: the
// numerical gradient is computed via finite-diff of the F64 forward, but
// the analytical gradient depended on a backward kernel that called this
// shader and downcast through F32 — losing 25 mantissa bits.

layout(local_size_x_id = 0) in;
layout(binding = 0) buffer InputA { double a_data[]; };
layout(binding = 1) buffer InputB { double b_data[]; };
layout(binding = 2) buffer InputX { double x_data[]; };
layout(binding = 3) buffer Output { double out_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint op;
} params;

const double PI = 3.14159265358979323846;

// GLSL has no double-precision transcendentals. Approximate via single-
// precision call + a first-order Newton correction. log64(x) ≈
// log32(xf) + (x - xf) / x, accurate to about 1 ULP of double when xf
// is the round-to-nearest float of x. Same trick for exp64.
double log64(double x) {
    float xf = float(x);
    float lf = log(xf);
    double l = double(lf);
    // Newton correction: f(l) = exp(l) - x = 0
    // l_new = l - (exp(l) - x)/exp(l) = l + x/exp(l) - 1
    // exp(l) ≈ x_f32 (because l = log(xf)) — we approximate exp(l) via xf.
    double e = double(exp(lf));
    return l + x / e - 1.0;
}

double exp64(double x) {
    float xf = float(x);
    float ef = exp(xf);
    double e = double(ef);
    // exp(x) ≈ exp(xf) * (1 + (x - xf)) — first-order Taylor.
    double dx = x - double(xf);
    return e * (1.0 + dx + 0.5 * dx * dx);
}

double sin64(double x) {
    return double(sin(float(x)));
}

double abs64(double x) {
    return x < 0.0 ? -x : x;
}

double lgamma_lanczos(double x) {
    double coef[9];
    coef[0] = 0.99999999999980993;
    coef[1] = 676.5203681218851;
    coef[2] = -1259.1392167224028;
    coef[3] = 771.32342877765313;
    coef[4] = -176.61502916214059;
    coef[5] = 12.507343278686905;
    coef[6] = -0.13857109526572012;
    coef[7] = 9.9843695780195716e-6;
    coef[8] = 1.5056327351493116e-7;

    double g = 7.0;
    double xm1 = x - 1.0;
    double a = coef[0];
    double t = xm1 + g + 0.5;
    for (int i = 1; i < 9; ++i) {
        a += coef[i] / (xm1 + double(i));
    }
    return 0.5 * log64(2.0 * PI) + (xm1 + 0.5) * log64(t) - t + log64(a);
}
double lgamma_impl(double x) {
    if (x < 0.5) {
        return log64(PI / abs64(sin64(PI * x))) - lgamma_lanczos(1.0 - x);
    }
    return lgamma_lanczos(x);
}

double betainc_impl(double a, double b, double x) {
    if (x < 0.0 || x > 1.0) return 0.0 / 0.0;  // NaN
    if (x == 0.0) return 0.0;
    if (x == 1.0) return 1.0;

    bool flipped = false;
    if (x > (a + 1.0) / (a + b + 2.0)) {
        double tmp = a; a = b; b = tmp;
        x = 1.0 - x;
        flipped = true;
    }

    double lbeta = lgamma_impl(a) + lgamma_impl(b) - lgamma_impl(a + b);
    double front = exp64(log64(x) * a + log64(1.0 - x) * b - lbeta) / a;

    double f = 1.0, c = 1.0, d = 1.0 - (a + b) * x / (a + 1.0);
    if (abs64(d) < 1.0e-300) d = 1.0e-300;
    d = 1.0 / d;
    f = d;

    for (int m = 1; m <= 200; ++m) {
        double num = double(m) * (b - double(m)) * x
                   / ((a + 2.0 * double(m) - 1.0) * (a + 2.0 * double(m)));
        d = 1.0 + num * d; if (abs64(d) < 1.0e-300) d = 1.0e-300; d = 1.0 / d;
        c = 1.0 + num / c; if (abs64(c) < 1.0e-300) c = 1.0e-300;
        f *= d * c;

        num = -((a + double(m)) * (a + b + double(m)) * x)
            / ((a + 2.0 * double(m)) * (a + 2.0 * double(m) + 1.0));
        d = 1.0 + num * d; if (abs64(d) < 1.0e-300) d = 1.0e-300; d = 1.0 / d;
        c = 1.0 + num / c; if (abs64(c) < 1.0e-300) c = 1.0e-300;
        double delta = d * c;
        f *= delta;
        if (abs64(delta - 1.0) < 1.0e-15) break;
    }
    double val = front * f;
    return flipped ? (1.0 - val) : val;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;
    double a = a_data[idx];
    double b = b_data[idx];
    double x = x_data[idx];
    out_data[idx] = betainc_impl(a, b, x);
}
