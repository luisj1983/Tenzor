#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Full operation: create tensor filled with specific value for Float16 dtype
// Float16 elements are packed 2 per 32-bit word
layout(local_size_x = 256) in;

layout(binding = 0) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;       // Number of float16 elements
    uint fill_value_f16;   // Fill value as float16 bits (only lower 16 bits used)
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Each thread handles 2 float16 elements packed in one uint32
    uint element_pair_idx = idx;
    uint base_element = element_pair_idx * 2;

    if (base_element >= params.n_elements) {
        return;
    }

    // Extract float16 value from push constant (lower 16 bits)
    uint value_f16 = params.fill_value_f16 & 0xFFFFu;

    // Pack two float16 values into one uint32
    uint packed_value;
    if (base_element + 1 < params.n_elements) {
        // Both elements are valid
        packed_value = value_f16 | (value_f16 << 16);
    } else {
        // Only one element is valid (odd number of elements)
        packed_value = value_f16;
    }

    output_data[element_pair_idx] = packed_value;
}
