#version 450
#extension GL_EXT_shader_atomic_float : enable

// Average Pooling 2D Backward Pass
// Distributes gradient evenly across pooling window
// Uses atomic operations for overlapping regions

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, H_out, W_out)
layout(binding = 1) buffer GradInput { float grad_input[]; };    // (N, C, H, W)

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output gradient elements (N * C * H_out * W_out)
    uint batch;               // N
    uint channels;            // C
    uint in_height;           // H
    uint in_width;            // W
    uint out_height;          // H_out
    uint out_width;           // W_out
    uint kernel_h;            // Kernel height
    uint kernel_w;            // Kernel width
    uint stride_h;            // Stride height
    uint stride_w;            // Stride width
    uint padding_h;           // Padding height
    uint padding_w;           // Padding width
    uint count_include_pad;   // 1 to include padding in count, 0 otherwise
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Bounds check
    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Get output gradient
    float grad_out = grad_output[idx];

    // Compute input window bounds
    int h_start = int(h_out * params.stride_h) - int(params.padding_h);
    int w_start = int(w_out * params.stride_w) - int(params.padding_w);

    // Count valid elements in pooling window
    uint count = 0;

    // First pass: count valid elements
    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int h_in = h_start + int(kh);
            int w_in = w_start + int(kw);

            if (h_in >= 0 && h_in < int(params.in_height) &&
                w_in >= 0 && w_in < int(params.in_width)) {
                count++;
            } else if (params.count_include_pad != 0) {
                count++;
            }
        }
    }

    // Compute gradient per input element
    float grad_per_element = 0.0;
    if (count > 0) {
        grad_per_element = grad_out / float(count);
    }

    // Second pass: distribute gradient to input
    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int h_in = h_start + int(kh);
            int w_in = w_start + int(kw);

            // Check if within input bounds
            if (h_in >= 0 && h_in < int(params.in_height) &&
                w_in >= 0 && w_in < int(params.in_width)) {

                // Compute input index: (n, c, h_in, w_in)
                uint input_idx = n * params.channels * params.in_height * params.in_width +
                                c * params.in_height * params.in_width +
                                uint(h_in) * params.in_width +
                                uint(w_in);

                // Atomically add gradient (for overlapping pooling windows)
                atomicAdd(grad_input[input_idx], grad_per_element);
            }
        }
    }
}
