#version 450

// LSTM Cell compute shader — processes one timestep
// Computes: gates = x*W_ih^T + h*W_hh^T + bias_ih + bias_hh
// Then applies sigmoid/tanh gating
//
// Inputs:
//   binding 0: gates buffer (pre-computed linear: x*W_ih^T + h*W_hh^T + biases)
//              shape: [batch_size, 4 * hidden_size] — layout: [i|f|g|o]
//   binding 1: c_prev — previous cell state [batch_size, hidden_size]
//   binding 2: h_out — output hidden state [batch_size, hidden_size]
//   binding 3: c_out — output cell state [batch_size, hidden_size]
//
// Activations use `exp`-based formulations rather than the GLSL `tanh`
// intrinsic. NVIDIA-driver GLSL `tanh` lowers to an `MUFU.TANH`-style
// approximation that drifts noticeably (>1e-3) from std::tanh in the
// midrange, and that error compounds over multi-timestep LSTM unrolling
// (AllBackends/NNRNNParity.LSTM_Dropout_Eval surfaced 0.06–0.15 max-abs
// divergence vs CPU on Vulkan only; CUDA/ROCm/OneAPI all match CPU to
// ~1e-7). exp-via-`exp()` matches the IEEE-754 std::exp closely enough
// that the compounded LSTM output stays within 1e-4 of CPU.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Gates { float gates[]; };
layout(binding = 1) buffer CellPrev { float c_prev[]; };
layout(binding = 2) buffer HiddenOut { float h_out[]; };
layout(binding = 3) buffer CellOut { float c_out[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint hidden_size;
} params;

// Numerically stable sigmoid: avoids exp() overflow for large |x|.
precise float sigmoid_stable(float x) {
    if (x >= 0.0) {
        float e = exp(-x);
        return 1.0 / (1.0 + e);
    } else {
        float e = exp(x);
        return e / (1.0 + e);
    }
}

// Stable tanh via sigmoid: tanh(x) = 2 * sigmoid(2x) - 1.
// Avoids the driver-supplied tanh approximation by routing through `exp()`,
// which matches std::tanh on tested NVIDIA / RADV stacks to ~2 ULP.
precise float tanh_stable(float x) {
    return 2.0 * sigmoid_stable(2.0 * x) - 1.0;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch_size * params.hidden_size;

    if (idx >= total) return;

    uint b = idx / params.hidden_size;
    uint h = idx % params.hidden_size;

    uint gate_base = b * (4 * params.hidden_size);

    precise float i_gate = sigmoid_stable(gates[gate_base + h]);                              // input gate
    precise float f_gate = sigmoid_stable(gates[gate_base + params.hidden_size + h]);         // forget gate
    precise float g_gate = tanh_stable(gates[gate_base + 2 * params.hidden_size + h]);        // cell gate
    precise float o_gate = sigmoid_stable(gates[gate_base + 3 * params.hidden_size + h]);     // output gate

    precise float c_new = f_gate * c_prev[idx] + i_gate * g_gate;
    precise float h_new = o_gate * tanh_stable(c_new);

    c_out[idx] = c_new;
    h_out[idx] = h_new;
}
