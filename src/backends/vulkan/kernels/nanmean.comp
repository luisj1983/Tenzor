#version 450

// Nanmean: compute nansum / count_non_nan in a single pass.
// Dispatched as a single workgroup for full reduction.
// Output buffer: output_data[0] = mean
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input  { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
} params;

shared float s_sum[WORKGROUP_SIZE];
shared float s_comp[WORKGROUP_SIZE];
shared float s_cnt[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;

    float accum = 0.0;
    float comp  = 0.0;
    float count = 0.0;

    for (uint i = tid; i < params.num_elements; i += WORKGROUP_SIZE) {
        float val = input_data[i];
        if (!isnan(val)) {
            float y = val - comp;
            float t = accum + y;
            comp = (t - accum) - y;
            accum = t;
            count += 1.0;
        }
    }

    s_sum[tid]  = accum;
    s_comp[tid] = comp;
    s_cnt[tid]  = count;
    barrier();

    // Tree reduction
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            // Kahan merge for sum
            float c = s_comp[tid] + s_comp[tid + s];
            float y = s_sum[tid + s] - c;
            float t = s_sum[tid] + y;
            s_comp[tid] = (t - s_sum[tid]) - y;
            s_sum[tid] = t;
            // Simple add for count
            s_cnt[tid] += s_cnt[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        if (s_cnt[0] > 0.0) {
            output_data[0] = s_sum[0] / s_cnt[0];
        } else {
            output_data[0] = 0.0 / 0.0; // NaN if no non-NaN elements
        }
    }
}
