#version 450

// Backward activation functions for autograd
// Operations: 0=relu, 1=sigmoid, 2=tanh, 3=leaky_relu, 4=gelu, 5=elu, 6=selu, 7=mish, 8=softplus
// For softmax/log_softmax backward: separate shader handles dimension reduction

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };
layout(binding = 1) buffer InputOrOutput { float input_or_output[]; };
layout(binding = 2) buffer GradInput { float grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation code
    float alpha;     // For leaky_relu, elu, softplus beta
} params;

const float SELU_ALPHA = 1.6732632423543772848170429916717;
const float SELU_SCALE = 1.0507009873554804934193349852946;

// Numerically-stable tanh via 2*sigmoid(2x)-1. The forward mish uses this same
// form (the GLSL intrinsic tanh() drifts from std::tanh on NVIDIA/RADV), so the
// mish backward must use it too for forward/backward and CPU consistency.
float tanh_stable(float x) {
    return 2.0 / (1.0 + exp(-2.0 * x)) - 1.0;
}

// erf via Abramowitz & Stegun 7.1.26 (max abs error ~1.5e-7) — GLSL has no
// built-in erf; exact erf GELU matches the forward and the other backends.
float erf_approx(float x) {
    float s = sign(x);
    float ax = abs(x);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t
                      - 0.284496736) * t + 0.254829592) * t * exp(-ax * ax);
    return s * y;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    float g_out = grad_output[idx];
    float val = input_or_output[idx];

    switch (params.op) {
        case 0: // relu_backward: grad_output * (input > 0 ? 1 : 0)
            grad_input[idx] = (val > 0.0) ? g_out : 0.0;
            break;

        case 1: // sigmoid_backward: grad_output * output * (1 - output)
            // val is the output of sigmoid
            grad_input[idx] = g_out * val * (1.0 - val);
            break;

        case 2: // tanh_backward: grad_output * (1 - output * output)
            // val is the output of tanh
            grad_input[idx] = g_out * (1.0 - val * val);
            break;

        case 3: // leaky_relu_backward: grad_output * (input > 0 ? 1 : alpha)
            // val is the input
            grad_input[idx] = (val > 0.0) ? g_out : params.alpha * g_out;
            break;

        case 4: { // gelu_backward (exact erf):
            // gelu'(x) = 0.5*(1+erf(x/sqrt(2))) + x*(1/sqrt(2*pi))*exp(-x^2/2)
            float x = val;  // val is the input
            float cdf = 0.5 * (1.0 + erf_approx(x * 0.70710678));
            float pdf = 0.39894228 * exp(-0.5 * x * x);  // 1/sqrt(2*pi)
            grad_input[idx] = g_out * (cdf + x * pdf);
            break;
        }

        case 5: // elu_backward: grad_output * (x > 0 ? 1 : alpha * exp(x))
            // val is the input
            if (val > 0.0) {
                grad_input[idx] = g_out;
            } else {
                grad_input[idx] = g_out * params.alpha * exp(val);
            }
            break;

        case 6: // selu_backward: grad_output * (x > 0 ? scale : scale * alpha * exp(x))
            // val is the input
            if (val > 0.0) {
                grad_input[idx] = g_out * SELU_SCALE;
            } else {
                grad_input[idx] = g_out * SELU_SCALE * SELU_ALPHA * exp(val);
            }
            break;

        case 7: { // mish_backward: Complex formula
            // val is the input
            float x = val;
            float sp = x > 20.0 ? x : (x < -20.0 ? exp(x) : log(1.0 + exp(x)));
            float tanh_sp = tanh_stable(sp);
            float sigmoid_x = 1.0 / (1.0 + exp(-x));
            float derivative = tanh_sp + x * sigmoid_x * (1.0 - tanh_sp * tanh_sp);
            grad_input[idx] = g_out * derivative;
            break;
        }

        case 8: { // softplus_backward: grad_output * sigmoid(beta * x)
            // val is the input, params.alpha is beta
            float bx = params.alpha * val;
            float grad;
            if (bx > 20.0) {
                grad = 1.0;
            } else if (bx < -20.0) {
                grad = exp(bx);
            } else {
                grad = 1.0 / (1.0 + exp(-bx));
            }
            grad_input[idx] = g_out * grad;
            break;
        }

        default:
            grad_input[idx] = 0.0;
            break;
    }
}
