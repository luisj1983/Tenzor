#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Complex-to-Real IFFT: Pack N/2+1 complex frequency bins into N/2 complex values — Float16
// This is the inverse of rfft_unpack: given X[0..N/2], reconstruct Z[0..N/2-1]
// such that a N/2-point inverse FFT of Z gives the packed real output.
//
// Z[k] = X[k] + conj(X[N/2-k]) + i*W_N^{-k}*(X[k] - conj(X[N/2-k]))

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };  // N/2+1 complex
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };  // N/2 complex

layout(push_constant) uniform PushConstants {
    uint n;                // Original real FFT size (N)
    uint batch_size;       // Number of independent FFTs
    uint in_batch_stride;  // Stride between input batches (in uint32 words)
    uint out_batch_stride; // Stride between output batches (in uint32 words / complex elements)
};

const float PI = 3.14159265358979323846;

vec2 readInput(uint in_base, uint idx) {
    return unpackHalf2x16(data_in[in_base + idx]);
}

void writeOutput(uint out_base, uint idx, vec2 val) {
    data_out[out_base + idx] = packHalf2x16(val);
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint half_n = n / 2;
    uint total_items = half_n * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / half_n;
    uint local_tid = tid % half_n;

    uint in_base = batch_idx * in_batch_stride;
    uint out_base = batch_idx * out_batch_stride;

    if (local_tid == 0) {
        // Z[0] = (X[0].re + X[N/2].re, X[0].re - X[N/2].re)
        vec2 x0 = readInput(in_base, 0);
        vec2 xn = readInput(in_base, half_n);
        writeOutput(out_base, 0, vec2(x0.x + xn.x, x0.x - xn.x));
        return;
    }

    uint k = local_tid;
    uint conj_k = half_n - k;

    // X[k]
    vec2 xk = readInput(in_base, k);
    // conj(X[N/2-k])
    vec2 xc_raw = readInput(in_base, conj_k);
    vec2 xc = vec2(xc_raw.x, -xc_raw.y);

    // A = X[k] + conj(X[N/2-k])
    float a_re = xk.x + xc.x;
    float a_im = xk.y + xc.y;

    // B = X[k] - conj(X[N/2-k])
    float b_re = xk.x - xc.x;
    float b_im = xk.y - xc.y;

    // Twiddle: W^{-k} = exp(+2*pi*i*k/N)
    float angle = 2.0 * PI * float(k) / float(n);
    float w_re = cos(angle);
    float w_im = sin(angle);

    // i * W^{-k} * B
    float iw_b_re = -(w_im * b_re + w_re * b_im);
    float iw_b_im =   w_re * b_re - w_im * b_im;

    // Z[k] = A + i*W^{-k}*B
    writeOutput(out_base, k, vec2(a_re + iw_b_re, a_im + iw_b_im));
}
