#version 450

// ============================================================================
// FlashAttention-2 tiled kernel (Vulkan, Float32)
// ============================================================================
//
// Computes scaled dot-product attention with online softmax so the
// full (seq_q × seq_k) attention matrix never has to be materialized in
// memory. This is the Phase 5.4 follow-up to the composed-ops
// `dispatchFlashAttention` path.
//
// Input layout (flat, batch_heads = batch * num_heads):
//   Q[B, S_q, D]   — queries
//   K[B, S_k, D]   — keys
//   V[B, S_k, Dv]  — values
// Output:
//   O[B, S_q, Dv]  — attention output
//
// Algorithm (per thread, one Q row in a Br-sized tile):
//   1. Load its Q row into registers.
//   2. For each K/V block of Bc rows:
//      a. Collaboratively load K and V into shared memory.
//      b. Compute S_ij = Q_i · K_j · scale for j in the block.
//      c. new_max = max(running_max, max(S))
//      d. P_ij    = exp(S_ij - new_max)
//      e. corr    = exp(running_max - new_max)
//      f. running_sum = corr * running_sum + sum(P)
//      g. O       = corr * O + P · V
//      h. running_max = new_max
//   3. Normalize: O_i /= running_sum_i
//
// Limitations (all documented in dispatchFlashAttention's fast-path
// gating):
//   - Float32 only (no FP16 variant yet — M8 work).
//   - head_dim and head_v up to MAX_HEAD_DIM = 128.
//   - Philox dropout NOT supported in-shader: the host wrapper routes
//     dropout_p > 0 cases to a composed softmax + Philox-mask + matmul
//     path that uses the `philox_dropout_mask.comp` shader. LSE is
//     emitted from this shader unconditionally now (audit C1 Vulkan).
//   - Workgroup size fixed at Br = 16 threads.
//
// Causal masking IS supported (audit C2 Vulkan fix): when push_constant.causal
// is non-zero, score is set to -INFINITY for kv positions > q position before
// softmax. The contract sentinel (-INFINITY, never -1e9 / -1e30) is used so
// the mask cleanly produces exp(-INFINITY) = 0 in the softmax below.
//
// Dispatch: (num_q_tiles, batch_heads, 1) workgroups where
//   num_q_tiles = ceil(S_q / Br).

#define Br 16
#define Bc 32
#define MAX_HEAD_DIM 128

layout(local_size_x = Br, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer QBuf { float q_data[]; };
layout(set = 0, binding = 1) buffer KBuf { float k_data[]; };
layout(set = 0, binding = 2) buffer VBuf { float v_data[]; };
layout(set = 0, binding = 3) buffer OBuf { float o_data[]; };
// LSE output (binding 4) — always Float32 per `attention_contract.hpp`'s
// kLseDType. Shape (B, H, S_q) flattened to (batch_heads, seq_q). Phase 1.5
// rewrite: the per-row log-sum-exp is written from this shader in the same
// pass that writes the output, eliminating the host-side
// `logsumexp(Q @ Kᵀ * scale)` recompute that previously defeated
// FlashAttention's memory savings.
layout(set = 0, binding = 4) buffer LBuf { float lse_data[]; };

layout(push_constant) uniform PushConstants {
    int seq_q;      // S_q
    int seq_k;      // S_k
    int head_dim;   // D  (<= MAX_HEAD_DIM)
    int head_v;     // Dv (<= MAX_HEAD_DIM)
    float scale;    // usually 1 / sqrt(D)
    int causal;     // M7: 0 = no mask, non-zero = causal lower-triangular
                    //     mask applied before softmax with -INFINITY sentinel
};

// Shared memory for one K block and one V block — re-used across Q rows
// within a workgroup and re-loaded on each iteration of the K/V loop.
shared float Ks[Bc][MAX_HEAD_DIM];
shared float Vs[Bc][MAX_HEAD_DIM];

void main() {
    int tid    = int(gl_LocalInvocationID.x);   // 0..Br-1
    int q_tile = int(gl_WorkGroupID.x);          // which Br-tile of queries
    int batch  = int(gl_WorkGroupID.y);          // which batch_head

    int q_row = q_tile * Br + tid;
    bool valid = (q_row < seq_q);

    // Per-thread Q register copy.
    float q_vec[MAX_HEAD_DIM];
    for (int d = 0; d < MAX_HEAD_DIM; ++d) q_vec[d] = 0.0;
    if (valid) {
        for (int d = 0; d < head_dim; ++d) {
            q_vec[d] = q_data[(batch * seq_q + q_row) * head_dim + d];
        }
    }

    // Per-thread output accumulator and running softmax stats. Uses
    // -1.0/0.0 = -INFINITY for the row_max sentinel (audit C2/C3 Vulkan)
    // — the contract requires -INFINITY (not -1e30) so masked rows produce
    // P = 0 cleanly without leaving residual gradient mass in FP16 paths.
    float o_vec[MAX_HEAD_DIM];
    for (int d = 0; d < MAX_HEAD_DIM; ++d) o_vec[d] = 0.0;
    float row_max = -1.0 / 0.0;  // -INFINITY
    float row_sum = 0.0;

    int num_k_blocks = (seq_k + Bc - 1) / Bc;
    for (int kb = 0; kb < num_k_blocks; ++kb) {
        int k_start = kb * Bc;

        // Collaborative load. Br=16 threads load Bc=32 rows, so each
        // thread handles exactly rows_per_thread = Bc/Br = 2 rows of K and V.
        const int rows_per_thread = 2;  // = Bc / Br
        for (int r = 0; r < rows_per_thread; ++r) {
            int kk = tid * rows_per_thread + r;  // 0..Bc-1
            int k_row = k_start + kk;
            if (k_row < seq_k) {
                for (int d = 0; d < head_dim; ++d) {
                    Ks[kk][d] = k_data[(batch * seq_k + k_row) * head_dim + d];
                }
                for (int d = 0; d < head_v; ++d) {
                    Vs[kk][d] = v_data[(batch * seq_k + k_row) * head_v + d];
                }
                // Zero out the rest so head_dim/head_v < MAX_HEAD_DIM don't
                // read stale shared memory.
                for (int d = head_dim; d < MAX_HEAD_DIM; ++d) Ks[kk][d] = 0.0;
                for (int d = head_v;   d < MAX_HEAD_DIM; ++d) Vs[kk][d] = 0.0;
            } else {
                for (int d = 0; d < MAX_HEAD_DIM; ++d) Ks[kk][d] = 0.0;
                for (int d = 0; d < MAX_HEAD_DIM; ++d) Vs[kk][d] = 0.0;
            }
        }
        barrier();

        // Compute S_ij = Q_i · K_j · scale for j in this K block. Out-of-range
        // and causally-masked positions get -INFINITY (contract sentinel,
        // audit Systemic #3 — never -1e9 / -1e30, those saturate FP16).
        float S[Bc];
        for (int j = 0; j < Bc; ++j) {
            int k_row = k_start + j;
            // F021: bottom-right causal alignment (matches the MHA/GQA manual
            // BMM path and PyTorch). Query at absolute row q_row attends to keys
            // k_row <= q_row + (seq_k - seq_q). Self-attention => offset 0;
            // KV-cache cross-attention (seq_q < seq_k) lets the query see all
            // preceding keys instead of only key 0.
            bool causally_masked = (causal != 0) && (k_row > q_row + (seq_k - seq_q));
            if (k_row < seq_k && !causally_masked) {
                float s = 0.0;
                for (int d = 0; d < head_dim; ++d) {
                    s += q_vec[d] * Ks[j][d];
                }
                S[j] = s * scale;
            } else {
                S[j] = -1.0 / 0.0;  // -INFINITY
            }
        }

        // Tile max for this block.
        float tile_max = S[0];
        for (int j = 1; j < Bc; ++j) tile_max = max(tile_max, S[j]);

        float new_max = max(row_max, tile_max);
        // Early-out when the entire history (incl. this tile) is masked —
        // exp(-INF - (-INF)) is NaN; treat correction as 0 (audit C3 Vulkan).
        // isinf(-INFINITY) returns true; new_max == -INFINITY iff both row_max
        // and tile_max are -INFINITY, which means no valid keys yet.
        bool prev_was_inf = isinf(row_max) && row_max < 0.0;
        bool all_masked = isinf(new_max) && new_max < 0.0;
        float correction = prev_was_inf ? 0.0 : exp(row_max - new_max);

        // P_ij and tile sum. When all_masked, leave row_sum at 0 — the
        // post-loop normalisation skips writing in that case.
        float P[Bc];
        float tile_sum = 0.0;
        if (!all_masked) {
            for (int j = 0; j < Bc; ++j) {
                P[j] = exp(S[j] - new_max);
                tile_sum += P[j];
            }
        } else {
            for (int j = 0; j < Bc; ++j) P[j] = 0.0;
        }

        // Running sum update.
        row_sum = correction * row_sum + tile_sum;

        // Output accumulator update: O = corr * O + P · V
        for (int d = 0; d < head_v; ++d) {
            float acc = correction * o_vec[d];
            for (int j = 0; j < Bc; ++j) {
                acc += P[j] * Vs[j][d];
            }
            o_vec[d] = acc;
        }

        row_max = new_max;
        barrier();  // next iteration will overwrite Ks/Vs
    }

    // Final normalization, write-back, and per-row LSE emission. The LSE
    // contract (include/tenzor/ops/attention_contract.hpp lines 60-73, 125-138)
    // demands `row_max + log(row_sum)` for live rows and `-INFINITY` for
    // fully-masked rows so backward's `P = exp(S - L)` evaluates to 0 there.
    if (valid) {
        int lse_idx = batch * seq_q + q_row;
        if (row_sum > 0.0) {
            float inv_sum = 1.0 / row_sum;
            for (int d = 0; d < head_v; ++d) {
                o_data[(batch * seq_q + q_row) * head_v + d] = o_vec[d] * inv_sum;
            }
            lse_data[lse_idx] = row_max + log(row_sum);
        } else {
            // Fully-masked row: explicitly zero the output (the buffer is
            // not guaranteed to be zero-initialised by the host) and emit
            // the contract sentinel LSE so backward sees P = exp(S - L)
            // = exp(anything - (-INF)) = 0.
            for (int d = 0; d < head_v; ++d) {
                o_data[(batch * seq_q + q_row) * head_v + d] = 0.0;
            }
            lse_data[lse_idx] = -1.0 / 0.0;  // -INFINITY
        }
    }
}
