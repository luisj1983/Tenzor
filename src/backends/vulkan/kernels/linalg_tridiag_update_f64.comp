#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Blocked tridiagonalization — trailing-submatrix update (Float64): NO-OP.
//
// See linalg_tridiag_update.comp for the full rationale. The panel shader
// linalg_tridiag_panel_f64.comp applies each Householder reflection as a full
// two-sided symmetric rank-2 update A <- H*A*H^T over the entire remaining
// submatrix [col+1, n) x [col+1, n), so the trailing block is already fully
// updated. A separate trailing update would double-apply each reflection and
// destroy symmetry. The host no longer dispatches this shader; it is retained
// as a no-op only to preserve the build target and descriptor-set layout.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer MatrixA { float64_t A[]; };
layout(set = 0, binding = 1) readonly buffer TauBuf { float64_t tau[]; };
layout(set = 0, binding = 2) buffer WorkV { float64_t v_buf[]; };
layout(set = 0, binding = 3) buffer WorkW { float64_t w_buf[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

void main() {
    // No-op: the panel already performed the full two-sided trailing update.
}
