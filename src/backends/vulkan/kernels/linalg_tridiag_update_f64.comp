#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Blocked tridiagonalization — trailing matrix update (Float64 variant)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer MatrixA { float64_t A[]; };
layout(set = 0, binding = 1) readonly buffer TauBuf { float64_t tau[]; };
layout(set = 0, binding = 2) buffer WorkV { float64_t v_buf[]; };
layout(set = 0, binding = 3) buffer WorkW { float64_t w_buf[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

shared float64_t dot_val;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = batch_idx * n * n;
    uint tau_base = batch_idx * n;
    uint trail_start = col_start + panel_cols;

    uint r = trail_start + gl_WorkGroupID.x;
    if (r >= n) return;

    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;
        float64_t tau_k = tau[tau_base + col];
        if (abs(tau_k) < 1e-60lf) continue;

        if (tid == 0) {
            float64_t dot = A[base + r * n + (col + 1)];
            for (uint c = col + 2; c < n; c++) {
                dot += A[base + c * n + col] * A[base + r * n + c];
            }
            dot_val = dot;
        }
        barrier();

        float64_t dot = dot_val;

        for (uint c = trail_start + tid; c < n; c += 256) {
            float64_t v_c = (c == col + 1) ? 1.0lf : ((c > col + 1) ? A[base + c * n + col] : 0.0lf);
            A[base + r * n + c] -= tau_k * dot * v_c;
        }
        if (tid == 0 && col + 1 >= trail_start) {
            A[base + r * n + (col + 1)] -= tau_k * dot;
        }
        barrier();
    }
}
