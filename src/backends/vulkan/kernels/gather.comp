#version 450

// Gather operation: gather elements along specified dimension
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { float output_data[]; };

// Per-dim decomposition: the index/output tensor may be smaller than the input
// in every non-gather dimension (PyTorch allows index.size(d) <= input.size(d)
// for d != dim), so a single flattened inner/outer stride is wrong. We decompose
// the output index into per-dim coordinates using the index shape, then recompose
// the input offset using the input's contiguous strides (dim coord replaced by the
// gathered index). uvec4/ivec4 packing keeps the block std140-aligned.
layout(push_constant) uniform PushConstants {
    uint output_size;      // total output/index elements (loop bound)
    uint input_size;       // total input elements (OOB read guard)
    uint ndim;             // number of dimensions (<= 8)
    uint dim;              // dimension to gather along
    uint input_dim_size;   // size of gather dim in input (bounds check + stride)
    uint _pad0;
    uint _pad1;
    uint _pad2;
    uvec4 idx_shape_0_3;   // index/output shape [0..3]
    uvec4 idx_shape_4_7;   // index/output shape [4..7]
    ivec4 in_stride_0_3;   // input contiguous strides [0..3]
    ivec4 in_stride_4_7;   // input contiguous strides [4..7]
} params;

void main() {
    uint out_idx = gl_GlobalInvocationID.x;

    if (out_idx >= params.output_size) {
        return;
    }
    if (params.ndim > 8u) {
        return;
    }

    uint ish[8];
    ish[0] = max(params.idx_shape_0_3.x, 1u);
    ish[1] = max(params.idx_shape_0_3.y, 1u);
    ish[2] = max(params.idx_shape_0_3.z, 1u);
    ish[3] = max(params.idx_shape_0_3.w, 1u);
    ish[4] = max(params.idx_shape_4_7.x, 1u);
    ish[5] = max(params.idx_shape_4_7.y, 1u);
    ish[6] = max(params.idx_shape_4_7.z, 1u);
    ish[7] = max(params.idx_shape_4_7.w, 1u);
    int ist[8];
    ist[0] = params.in_stride_0_3.x;
    ist[1] = params.in_stride_0_3.y;
    ist[2] = params.in_stride_0_3.z;
    ist[3] = params.in_stride_0_3.w;
    ist[4] = params.in_stride_4_7.x;
    ist[5] = params.in_stride_4_7.y;
    ist[6] = params.in_stride_4_7.z;
    ist[7] = params.in_stride_4_7.w;

    // Get the index to gather from
    int gather_idx = indices[out_idx];
    // Normalize negative indices like the CPU reference (idx += dim) before the
    // bounds check, so a valid negative index wraps instead of being zeroed.
    if (gather_idx < 0) gather_idx += int(params.input_dim_size);

    // Bounds check against input dimension size
    if (gather_idx < 0 || gather_idx >= int(params.input_dim_size)) {
        output_data[out_idx] = 0.0;
        return;
    }

    // Decompose the output/index linear position into per-dim coordinates
    // (row-major), then recompose the input offset using the input strides.
    uint remaining = out_idx;
    int in_off = 0;
    for (int d = int(params.ndim) - 1; d >= 0; --d) {
        uint coord = remaining % ish[d];
        remaining /= ish[d];
        uint c = (uint(d) == params.dim) ? uint(gather_idx) : coord;
        in_off += int(c) * ist[d];
    }

    if (in_off < 0 || uint(in_off) >= params.input_size) {
        output_data[out_idx] = 0.0;
        return;
    }

    output_data[out_idx] = input_data[uint(in_off)];
}
