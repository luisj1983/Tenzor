#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Real-to-Complex FFT: Unpack N/2-point complex FFT to N/2+1 complex output — Float64

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;                // Original real FFT size (N)
    uint batch_size;       // Number of independent FFTs
    uint in_batch_stride;  // Stride between input batches (in complex elements)
    uint out_batch_stride; // Stride between output batches (in double elements)
};

const double PI_D     = 3.14159265358979323846LF;
const double TWO_PI_D = 6.28318530717958647693LF;

// Double-precision sin/cos. GLSL's built-in cos/sin operate at float32
// precision; computing the twiddle there would discard ~9 significant digits
// in an otherwise all-double RFFT pipeline (matches irfft_pack_f64.comp's
// sincos_d — the prior `double(cos(float(angle)))` shortcut here dropped the
// twiddle to float precision). Range-reduce into [-pi, pi] and evaluate with
// a double-precision Taylor series (arguments are tiny, |x| <= pi).
void sincos_d(double x, out double s, out double c) {
    double q = floor(x / TWO_PI_D + 0.5LF);
    x = x - q * TWO_PI_D;

    double x2 = x * x;

    double term = x;
    s = term;
    term = -term * x2 / (2.0LF * 3.0LF);   s += term;   // x^3/3!
    term = -term * x2 / (4.0LF * 5.0LF);   s += term;   // x^5/5!
    term = -term * x2 / (6.0LF * 7.0LF);   s += term;   // x^7/7!
    term = -term * x2 / (8.0LF * 9.0LF);   s += term;   // x^9/9!
    term = -term * x2 / (10.0LF * 11.0LF); s += term;   // x^11/11!
    term = -term * x2 / (12.0LF * 13.0LF); s += term;   // x^13/13!
    term = -term * x2 / (14.0LF * 15.0LF); s += term;   // x^15/15!

    double ct = 1.0LF;
    c = ct;
    ct = -ct * x2 / (1.0LF * 2.0LF);   c += ct;   // x^2/2!
    ct = -ct * x2 / (3.0LF * 4.0LF);   c += ct;   // x^4/4!
    ct = -ct * x2 / (5.0LF * 6.0LF);   c += ct;   // x^6/6!
    ct = -ct * x2 / (7.0LF * 8.0LF);   c += ct;   // x^8/8!
    ct = -ct * x2 / (9.0LF * 10.0LF);  c += ct;   // x^10/10!
    ct = -ct * x2 / (11.0LF * 12.0LF); c += ct;   // x^12/12!
    ct = -ct * x2 / (13.0LF * 14.0LF); c += ct;   // x^14/14!
    ct = -ct * x2 / (15.0LF * 16.0LF); c += ct;   // x^16/16!
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint half_n = n / 2;
    uint items_per_batch = half_n + 1;
    uint total_items = items_per_batch * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / items_per_batch;
    uint local_tid = tid % items_per_batch;

    uint in_base = batch_idx * in_batch_stride;
    uint out_base = batch_idx * out_batch_stride;

    if (local_tid == 0) {
        double z0_re = data_in[in_base * 2];
        double z0_im = data_in[in_base * 2 + 1];
        data_out[out_base] = z0_re + z0_im;
        data_out[out_base + 1] = 0.0LF;
        return;
    }
    if (local_tid == half_n) {
        double z0_re = data_in[in_base * 2];
        double z0_im = data_in[in_base * 2 + 1];
        data_out[out_base + half_n * 2] = z0_re - z0_im;
        data_out[out_base + half_n * 2 + 1] = 0.0LF;
        return;
    }

    uint k = local_tid;
    uint conj_k = half_n - k;

    double zk_re = data_in[(in_base + k) * 2];
    double zk_im = data_in[(in_base + k) * 2 + 1];
    double zc_re =  data_in[(in_base + conj_k) * 2];
    double zc_im = -data_in[(in_base + conj_k) * 2 + 1];

    double a_re = zk_re + zc_re;
    double a_im = zk_im + zc_im;
    double b_re = zk_re - zc_re;
    double b_im = zk_im - zc_im;

    double angle = -2.0LF * PI_D * double(k) / double(n);
    double w_re;
    double w_im;
    sincos_d(angle, w_im, w_re);

    double iw_b_re = w_re * b_im + w_im * b_re;
    double iw_b_im = -w_re * b_re + w_im * b_im;

    data_out[out_base + k * 2]     = 0.5LF * (a_re + iw_b_re);
    data_out[out_base + k * 2 + 1] = 0.5LF * (a_im + iw_b_im);
}
