#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : enable

// Nearest Neighbor Interpolation Forward Pass - Float64 variant
// Input shape: (N, C, H_in, W_in)
// Output shape: (N, C, H_out, W_out)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint in_height;
    uint in_width;
    uint out_height;
    uint out_width;
    uint align_corners;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Compute nearest source coordinates
    uint h_in, w_in;
    if (params.align_corners != 0 && params.out_height > 1) {
        h_in = uint(round(float(h_out) * float(params.in_height - 1) / float(params.out_height - 1)));
    } else {
        h_in = min(uint(floor(float(h_out) * float(params.in_height) / float(params.out_height))),
                   params.in_height - 1);
    }

    if (params.align_corners != 0 && params.out_width > 1) {
        w_in = uint(round(float(w_out) * float(params.in_width - 1) / float(params.out_width - 1)));
    } else {
        w_in = min(uint(floor(float(w_out) * float(params.in_width) / float(params.out_width))),
                   params.in_width - 1);
    }

    // Compute input index: (n, c, h_in, w_in)
    uint input_idx = n * params.channels * params.in_height * params.in_width +
                     c * params.in_height * params.in_width +
                     h_in * params.in_width +
                     w_in;

    output_data[idx] = input_data[input_idx];
}
