#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Variance and Standard Deviation for Float16
// Float16 elements are packed 2 per 32-bit word
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };
layout(binding = 2) buffer Mean { uint mean_data[]; };  // Pre-computed mean (Float16)

layout(push_constant) uniform PushConstants {
    uint n;
    uint reduce_size;
    uint outer_size;
    uint op;        // 0=variance, 1=std
    uint unbiased;  // 0=biased, 1=unbiased
} params;

shared float shared_data[256];

// Read a single float16 value from packed buffer
float readF16Input(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

float readF16Mean(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = mean_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write a single float16 value to packed output buffer
void writeF16Output(uint element_idx, float value) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    if (word_offset == 0) {
        uint existing = output_data[word_idx] & 0xFFFF0000u;
        output_data[word_idx] = existing | bits;
    } else {
        uint existing = output_data[word_idx] & 0x0000FFFFu;
        output_data[word_idx] = existing | (bits << 16);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wid = gl_WorkGroupID.x;

    // Compute squared differences from mean (in float32 for precision)
    float value = 0.0;
    if (gid < params.n) {
        uint mean_idx = gid / params.reduce_size;
        float diff = readF16Input(gid) - readF16Mean(mean_idx);
        value = diff * diff;
    }
    shared_data[tid] = value;
    barrier();

    // Parallel reduction for sum of squared differences
    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s && (gid + s) < params.n) {
            shared_data[tid] += shared_data[tid + s];
        }
        barrier();
    }

    // Write result
    if (tid == 0) {
        float result = shared_data[0];

        uint divisor = params.reduce_size;
        if (params.unbiased > 0 && divisor > 1) {
            divisor -= 1;
        }
        result /= float(divisor);

        if (params.op == 1) {
            result = sqrt(result);
        }

        writeF16Output(wid, result);
    }
}
