#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Matrix multiplication with B transposed for Float64
// Computes C = A @ B^T where B is stored in transposed layout
// This avoids the need to make B contiguous when B is a transpose view
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer MatrixA { double a[]; };
layout(binding = 1) buffer MatrixB { double b[]; };  // Stored as B^T with shape [N, K]
layout(binding = 2) buffer MatrixC { double c[]; };

layout(push_constant) uniform PushConstants {
    uint M;  // rows of A and C
    uint N;  // cols of C (and rows of B^T in memory)
    uint K;  // cols of A (and cols of B^T in memory)
} params;

shared double tileA[16][16];
shared double tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    double sum = 0.0;

    // Tile-based computation
    uint num_tiles = (params.K + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from A (same as regular matmul)
        uint a_row = row;
        uint a_col = t * 16 + local_col;
        if (a_row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = a[a_row * params.K + a_col];
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from B (transposed access pattern)
        // B is stored with shape [N, K], so B[j, k] = b[j * K + k]
        // For B^T[k, j], we access b[j * K + k]
        uint b_row = t * 16 + local_row;  // k index
        uint b_col = col;                  // j index
        if (b_row < params.K && b_col < params.N) {
            // Access B[j, k] = b[j * K + k] = b[b_col * K + b_row]
            tileB[local_row][local_col] = b[b_col * params.K + b_row];
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        // Compute partial dot product
        for (uint k = 0; k < 16; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    // Write result
    if (row < params.M && col < params.N) {
        c[row * params.N + col] = sum;
    }
}
