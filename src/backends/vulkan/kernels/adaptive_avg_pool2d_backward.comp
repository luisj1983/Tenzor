#version 450
#extension GL_EXT_shader_atomic_float : enable

// Adaptive Average Pool 2D Backward
// Distributes gradients from output back to input positions
// This version uses atomic float operations (requires GL_EXT_shader_atomic_float)
layout(local_size_x = 256) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };
layout(binding = 1) buffer GradInput { float grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint H_in;
    uint W_in;
    uint H_out;
    uint W_out;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch * params.channels * params.H_out * params.W_out;

    if (idx >= total) return;

    // Decode output index
    uint w_out = idx % params.W_out;
    uint h_out = (idx / params.W_out) % params.H_out;
    uint c = (idx / (params.W_out * params.H_out)) % params.channels;
    uint n = idx / (params.W_out * params.H_out * params.channels);

    // Calculate adaptive pooling window
    uint h_start = (h_out * params.H_in) / params.H_out;
    uint h_end = ((h_out + 1) * params.H_in) / params.H_out;
    uint w_start = (w_out * params.W_in) / params.W_out;
    uint w_end = ((w_out + 1) * params.W_in) / params.W_out;

    uint count = (h_end - h_start) * (w_end - w_start);
    if (count == 0) return;

    float grad_val = grad_output[idx] / float(count);

    // Distribute gradient to input positions using atomic add
    for (uint h = h_start; h < h_end; ++h) {
        for (uint w = w_start; w < w_end; ++w) {
            uint input_idx = ((n * params.channels + c) * params.H_in + h) * params.W_in + w;
            atomicAdd(grad_input[input_idx], grad_val);
        }
    }
}
