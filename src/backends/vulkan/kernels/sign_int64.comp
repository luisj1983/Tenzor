#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Integer sign for 64-bit dtypes (Int64 / UInt64).
layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer Input  { int64_t input_data[]; };
layout(binding = 1)          buffer Output { int64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint is_signed;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.n_elements) return;
    int64_t v = input_data[idx];
    if (p.is_signed != 0u) {
        int64_t s = int64_t(v > 0L ? 1 : 0) - int64_t(v < 0L ? 1 : 0);
        output_data[idx] = s;
    } else {
        output_data[idx] = (uint64_t(v) > 0UL) ? 1L : 0L;
    }
}
