#version 450

// Phase 8.4: read min, max scalars (1-element tensors from aminmax) and pack
// them along with bin_width = (max-min)/num_bins (with degenerate-case fixup)
// into a 3-float device buffer for histogram_dyn. Single-thread dispatch.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer MinBuf   { float min_in[]; };
layout(binding = 1) buffer MaxBuf   { float max_in[]; };
layout(binding = 2) buffer RangeBuf { float range_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_bins;
} params;

void main() {
    if (gl_GlobalInvocationID.x != 0u) return;

    float mn = min_in[0];
    float mx = max_in[0];
    if (!(mx > mn)) {
        // Degenerate range: widen by 1 to match dispatchHistogram() host fixup
        mx = mn + 1.0;
    }
    float bin_width = (mx - mn) / float(params.num_bins);

    range_out[0] = mn;
    range_out[1] = mx;
    range_out[2] = bin_width;
}
