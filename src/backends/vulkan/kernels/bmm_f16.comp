#version 450

// Batched matrix multiplication with tiling (Float16 version)
// C[b, :, :] = A[b, :, :] @ B[b, :, :]
// A: (batch, M, K), B: (batch, K, N), C: (batch, M, N)
// Float16 elements packed 2 per uint32 word, accumulation in float32

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer MatrixA { uint a[]; };  // Packed F16
layout(binding = 1) buffer MatrixB { uint b[]; };  // Packed F16
layout(binding = 2) buffer MatrixC { uint c[]; };  // Packed F16

layout(push_constant) uniform PushConstants {
    uint batch;  // batch size
    uint M;      // rows of A
    uint N;      // cols of B
    uint K;      // cols of A / rows of B
} params;

shared float tileA[16][16];
shared float tileB[16][16];

float readF16A(uint element_idx) {
    uint word_idx = element_idx >> 1u;
    uint packed = a[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return ((element_idx & 1u) == 0u) ? pair.x : pair.y;
}

float readF16B(uint element_idx) {
    uint word_idx = element_idx >> 1u;
    uint packed = b[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return ((element_idx & 1u) == 0u) ? pair.x : pair.y;
}

void writeF16C(uint element_idx, float value) {
    uint word_idx = element_idx >> 1u;
    uint word_offset = element_idx & 1u;
    uint new_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint shift = word_offset * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = c[word_idx];
    for (uint iter = 0u; iter < 64u; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(c[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    uint cur = c[word_idx];
    c[word_idx] = (cur & ~mask) | (new_bits << shift);
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint batch_idx = gl_GlobalInvocationID.z;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    bool in_bounds = (batch_idx < params.batch && row < params.M && col < params.N);

    // Batch strides (in elements, not words)
    uint a_batch_stride = params.M * params.K;
    uint b_batch_stride = params.K * params.N;
    uint c_batch_stride = params.M * params.N;

    // Base offsets for this batch (in elements)
    uint a_base = batch_idx * a_batch_stride;
    uint b_base = batch_idx * b_batch_stride;
    uint c_base = batch_idx * c_batch_stride;

    float sum = 0.0;

    uint num_tiles = (params.K + 15u) / 16u;

    for (uint t = 0u; t < num_tiles; t++) {
        // Load tile from A
        uint a_col = t * 16u + local_col;
        if (batch_idx < params.batch && row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = readF16A(a_base + row * params.K + a_col);
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from B
        uint b_row = t * 16u + local_row;
        if (batch_idx < params.batch && b_row < params.K && col < params.N) {
            tileB[local_row][local_col] = readF16B(b_base + b_row * params.N + col);
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    if (in_bounds) {
        writeF16C(c_base + row * params.N + col, sum);
    }
}
