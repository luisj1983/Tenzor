#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Pooling operations (MaxPool2d, AvgPool2d) for Float16
// Reads packed F16 pairs, computes in float32 for stability
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { uint input_data[]; };   // Packed F16
layout(binding = 1) buffer Output { uint output_data[]; }; // Packed F16

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint in_height;
    uint in_width;
    uint out_height;
    uint out_width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint padding_h;
    uint padding_w;
    uint pool_type; // 0=max, 1=avg
} params;

float readF16Element(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = input_data[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

void writeF16Element(uint idx, float val) {
    uint word_idx = idx >> 1u;
    uint packed = output_data[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    if ((idx & 1u) == 0u) pair.x = val; else pair.y = val;
    output_data[word_idx] = packHalf2x16(pair);
}

void main() {
    uint out_x = gl_GlobalInvocationID.x;
    uint out_y = gl_GlobalInvocationID.y;
    uint c = gl_GlobalInvocationID.z;

    if (out_x >= params.out_width || out_y >= params.out_height ||
        c >= params.channels) {
        return;
    }

    float result;
    if (params.pool_type == 0) {
        // MaxPool
        result = -1.0 / 0.0; // -infinity
    } else {
        // AvgPool
        result = 0.0;
    }

    uint count = 0;

    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int in_y = int(out_y * params.stride_h) - int(params.padding_h) + int(kh);
            int in_x = int(out_x * params.stride_w) - int(params.padding_w) + int(kw);

            if (in_y >= 0 && in_y < int(params.in_height) &&
                in_x >= 0 && in_x < int(params.in_width)) {
                uint input_idx = c * params.in_height * params.in_width +
                                uint(in_y) * params.in_width + uint(in_x);
                float value = readF16Element(input_idx);

                if (params.pool_type == 0) {
                    // MaxPool
                    result = max(result, value);
                } else {
                    // AvgPool
                    result += value;
                    count++;
                }
            }
        }
    }

    if (params.pool_type == 1 && count > 0) {
        result /= float(count);
    }

    // Write output
    uint output_idx = c * params.out_height * params.out_width +
                     out_y * params.out_width + out_x;
    writeF16Element(output_idx, result);
}
