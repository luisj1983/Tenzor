#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

// Create complex tensor from separate real and imaginary parts (Float16)
// Operates on packed uint32 words: each uint32 holds 2 float16 values
// Input:  real packed F16, imag packed F16
// Output: interleaved complex F16 (one uint32 per complex element: [real, imag])

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer RealBuf  { uint real_in[];  };
layout(set = 0, binding = 1) buffer ImagBuf  { uint imag_in[];  };
layout(set = 0, binding = 2) buffer OutputBuf { uint data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_complex;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_complex) return;

    // Each packed F16 word contains 2 values; complex element idx maps to
    // real_in[idx/2] and imag_in[idx/2] with appropriate lane selection
    uint word_idx = idx >> 1;
    uint lane = idx & 1;

    uint real_word = real_in[word_idx];
    uint imag_word = imag_in[word_idx];

    // Extract the appropriate 16-bit half from the packed word
    uint real_bits = (lane == 0) ? (real_word & 0xFFFFu) : (real_word >> 16);
    uint imag_bits = (lane == 0) ? (imag_word & 0xFFFFu) : (imag_word >> 16);

    // Pack real and imag into one uint32 (real in low 16 bits, imag in high 16 bits)
    data_out[idx] = real_bits | (imag_bits << 16);
}
