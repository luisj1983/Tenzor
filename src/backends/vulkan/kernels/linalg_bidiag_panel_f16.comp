#version 450

// Blocked bidiagonal reduction — panel factorization — Float16 variant
// Float16 elements packed 2 per 32-bit word, all computation in float32.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer MatrixA { uint A[]; };
layout(set = 0, binding = 1) buffer TauL { uint tau_l_buf[]; };
layout(set = 0, binding = 2) buffer TauR { uint tau_r_buf[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

shared float col_data[256];
shared float norm_sq;
shared float alpha;
shared float tau_k;

// Read Float16 from matrix A
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = A[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write Float16 to matrix A
void writeF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = A[word_idx];
    uint new_val, expected;
    for (uint iter = 0; iter < 1024; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(A[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    A[word_idx] = new_val;
}

// Write Float16 to tau_l buffer
void writeF16TauL(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = tau_l_buf[word_idx];
    uint new_val, expected;
    for (uint iter = 0; iter < 1024; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(tau_l_buf[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    tau_l_buf[word_idx] = new_val;
}

// Read Float16 from tau_l buffer
float readF16TauL(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = tau_l_buf[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write Float16 to tau_r buffer
void writeF16TauR(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = tau_r_buf[word_idx];
    uint new_val, expected;
    for (uint iter = 0; iter < 1024; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(tau_r_buf[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    tau_r_buf[word_idx] = new_val;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint elem_base = batch_idx * n * n;

    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;

        // ---- Left Householder: zero A[col+1:n, col] ----
        if (tid == 0) {
            norm_sq = 0.0;
            for (uint r = col; r < n; r++) {
                float v = readF16(elem_base + r * n + col);
                norm_sq += v * v;
            }

            float a_diag = readF16(elem_base + col * n + col);
            alpha = -sign(a_diag) * sqrt(norm_sq);
            float v_k = a_diag - alpha;

            if (abs(v_k) < 1e-30) {
                tau_k = 0.0;
            } else {
                float sub_norm = norm_sq - a_diag * a_diag;
                tau_k = (sub_norm + v_k * v_k) / (v_k * v_k);
                tau_k = 2.0 / tau_k;
            }

            writeF16(elem_base + col * n + col, alpha);
            writeF16TauL(batch_idx * n + col, tau_k);
        }
        barrier();

        float left_tau = tau_k;

        if (abs(left_tau) > 1e-30) {
            for (uint j = col + 1; j < min(col_start + panel_cols, n); j++) {
                if (tid == 0) {
                    float dot = readF16(elem_base + col * n + j);
                    for (uint r = col + 1; r < n; r++) {
                        dot += readF16(elem_base + r * n + col) * readF16(elem_base + r * n + j);
                    }
                    col_data[0] = dot;
                }
                barrier();

                float dot = col_data[0];

                for (uint r = col + 1 + tid; r < n; r += 256) {
                    float v_r = readF16(elem_base + r * n + col);
                    float cur = readF16(elem_base + r * n + j);
                    writeF16(elem_base + r * n + j, cur - left_tau * v_r * dot);
                }
                if (tid == 0) {
                    float cur = readF16(elem_base + col * n + j);
                    writeF16(elem_base + col * n + j, cur - left_tau * dot);
                }
                barrier();
            }
        }

        // ---- Right Householder: zero A[col, col+2:n] ----
        if (col + 2 >= n) {
            if (tid == 0) {
                writeF16TauR(batch_idx * n + col, 0.0);
            }
            barrier();
            continue;
        }

        if (tid == 0) {
            norm_sq = 0.0;
            for (uint c = col + 1; c < n; c++) {
                float v = readF16(elem_base + col * n + c);
                norm_sq += v * v;
            }

            float a_super = readF16(elem_base + col * n + (col + 1));
            alpha = -sign(a_super) * sqrt(norm_sq);
            float v_k_r = a_super - alpha;

            if (abs(v_k_r) < 1e-30) {
                tau_k = 0.0;
            } else {
                float sub_norm = norm_sq - a_super * a_super;
                tau_k = (sub_norm + v_k_r * v_k_r) / (v_k_r * v_k_r);
                tau_k = 2.0 / tau_k;
            }

            writeF16(elem_base + col * n + (col + 1), alpha);
            writeF16TauR(batch_idx * n + col, tau_k);
        }
        barrier();

        float right_tau = tau_k;

        if (abs(right_tau) > 1e-30) {
            for (uint i = col + 1; i < min(col_start + panel_cols, n); i++) {
                if (tid == 0) {
                    float dot = readF16(elem_base + i * n + (col + 1));
                    for (uint c = col + 2; c < n; c++) {
                        dot += readF16(elem_base + i * n + c) * readF16(elem_base + col * n + c);
                    }
                    col_data[0] = dot;
                }
                barrier();

                float dot = col_data[0];

                for (uint c = col + 2 + tid; c < n; c += 256) {
                    float v_r = readF16(elem_base + col * n + c);
                    float cur = readF16(elem_base + i * n + c);
                    writeF16(elem_base + i * n + c, cur - right_tau * dot * v_r);
                }
                if (tid == 0) {
                    float cur = readF16(elem_base + i * n + (col + 1));
                    writeF16(elem_base + i * n + (col + 1), cur - right_tau * dot);
                }
                barrier();
            }
        }
    }
}
