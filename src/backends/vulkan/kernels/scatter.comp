#version 450

// Scatter operation: scatter elements along specified dimension
// Uses uint buffer for output to support CAS-loop atomics without requiring
// GL_EXT_shader_atomic_float (following the same pattern as scatter_f64.comp).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };       // Source data
layout(binding = 1) buffer Indices { int indices[]; };          // Scatter indices
layout(binding = 2) buffer Output { uint output_data[]; };      // Destination (uint for atomic CAS)
layout(binding = 3) buffer Values { float values[]; };          // Values to scatter (optional)

// Per-dim decode (matches CPU scatter_kernel): decode the flat index position
// with the INDEX tensor's contiguous strides and recompose the output offset
// with the SELF/output strides (index value substitutes the coord on the
// scatter dim). A collapsed inner/outer scheme mis-decodes when index is
// smaller than self on a non-scatter axis.
layout(push_constant) uniform PushConstants {
    uint input_size;        // indices.numel() (== values.numel())
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uint output_size;       // total output/self size (OOB guard)
    uint reduction;         // 0=none, 1=add, 2=multiply
    uint use_values;        // 0=use input_data, 1=use values buffer
    uint _pad;
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

// Atomic add for float using compare-and-swap loop (bounded to prevent hangs)
void atomicAddFloat(uint idx, float val) {
    uint old_bits = output_data[idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        uint new_bits = floatBitsToUint(old_val + val);
        uint result = atomicCompSwap(output_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

// Atomic multiply for float using compare-and-swap loop (bounded to prevent hangs)
void atomicMulFloat(uint idx, float val) {
    uint old_bits = output_data[idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        uint new_bits = floatBitsToUint(old_val * val);
        uint result = atomicCompSwap(output_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.input_size) {
        return;
    }

    // Get the scatter destination index
    int scatter_idx = indices[idx];
    // Normalize negative indices like the CPU reference (idx += dim) before the
    // bounds check, so a valid negative index wraps instead of being silently dropped.
    if (scatter_idx < 0) scatter_idx += int(params.dim_size);

    // Bounds check
    if (scatter_idx < 0 || scatter_idx >= int(params.dim_size)) {
        return;
    }

    // Per-dim decode of the flat index position, recomposed onto self strides.
    uint temp = idx;
    uint out_idx = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_idx += uint(scatter_idx) * selfStride(d);
        } else {
            out_idx += coord * selfStride(d);
        }
    }

    // Guard the computed output offset against the destination size (defensive;
    // the per-dim decode already keeps writes in-bounds for a valid index).
    if (out_idx >= params.output_size) {
        return;
    }

    // Get value to scatter
    float value;
    if (params.use_values > 0) {
        value = values[idx];
    } else {
        value = input_data[idx];
    }

    // Perform scatter with reduction
    if (params.reduction == 0) {
        // Mode 0: Direct assignment ("last write wins"). Racy for duplicate indices by design.
        output_data[out_idx] = floatBitsToUint(value);
    } else if (params.reduction == 1) {
        // Atomic add via CAS loop
        atomicAddFloat(out_idx, value);
    } else if (params.reduction == 2) {
        // Atomic multiply via CAS loop
        atomicMulFloat(out_idx, value);
    }
}
