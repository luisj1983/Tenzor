#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// LogSumExp reduction for Float64: log(sum(exp(x))) with numerical stability
// Two-pass algorithm: (1) max reduction, (2) sum(exp(x - max)) with Kahan summation
// Result: max + log(sum(exp(x - max)))
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float64_t input_data[]; };
layout(binding = 1) buffer Output { float64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;              // Total number of elements in input
    uint reduce_size;    // Size of dimension to reduce
    uint outer_size;     // Number of output elements
    uint inner_size;     // Product of dimensions after reduction dim
} params;

shared float64_t shared_max[WORKGROUP_SIZE];
shared float64_t shared_sum[WORKGROUP_SIZE];
shared float64_t shared_comp[WORKGROUP_SIZE]; // Kahan compensation

// Double-precision exp via range reduction + Horner polynomial. Keeps the
// Float64 reduction actually double-precision; the previous
// `double(exp(float(x)))` shortcut erased ~16 extra bits of mantissa and
// broke gradcheck.
float64_t exp_d(float64_t x) {
    if (x != x) return x;  // NaN
    if (x > 709.0LF) return 1.0e308LF;
    if (x < -745.0LF) return 0.0LF;
    float64_t ln2 = 0.6931471805599453LF;
    float64_t k_dbl = floor(x / ln2 + 0.5LF);
    float64_t r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0LF, 1100.0LF));
    float64_t exp_r = 1.0LF + r * (1.0LF + r * (0.5LF + r * (1.0LF/6.0LF + r * (1.0LF/24.0LF + r * (1.0LF/120.0LF +
        r * (1.0LF/720.0LF + r * (1.0LF/5040.0LF + r * (1.0LF/40320.0LF + r * (1.0LF/362880.0LF +
        r * (1.0LF/3628800.0LF + r * (1.0LF/39916800.0LF + r * (1.0LF/479001600.0LF +
        r * (1.0LF/6227020800.0LF)))))))))))));
    float64_t pow2 = 1.0LF;
    int abs_k = (k >= 0) ? k : -k;
    float64_t base = 2.0LF;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) pow2 *= base;
        base *= base;
        abs_k >>= 1;
    }
    return (k >= 0) ? (exp_r * pow2) : (exp_r / pow2);
}

// Double-precision log via IEEE 754 bit extraction + atanh series.
float64_t log_d(float64_t x) {
    if (x != x) return x;
    if (x < 0.0LF) return 0.0LF / 0.0LF;
    if (x == 0.0LF) return -1.0LF / 0.0LF;
    if (x == 1.0LF) return 0.0LF;
    uvec2 bits = unpackDouble2x32(x);
    uint hi = bits.y;
    uint lo = bits.x;
    int biased_exp = int((hi >> 20u) & 0x7FFu);
    int exp_val = biased_exp - 1023;
    uint hi_normalized = (hi & 0x000FFFFFu) | 0x3FF00000u;
    float64_t m = packDouble2x32(uvec2(lo, hi_normalized));
    if (m > 1.4142135623730950488LF) { m *= 0.5LF; exp_val += 1; }
    float64_t f = m - 1.0LF;
    float64_t s = f / (2.0LF + f);
    float64_t s2 = s * s;
    float64_t c1 = 0.6666666666666735130LF;
    float64_t c2 = 0.3999999999940941908LF;
    float64_t c3 = 0.2857142874366239149LF;
    float64_t c4 = 0.2222219843214978396LF;
    float64_t c5 = 0.1818357216161805012LF;
    float64_t c6 = 0.1531383769920937332LF;
    float64_t c7 = 0.1479819860511658591LF;
    float64_t s4 = s2 * s2;
    float64_t t1 = c1 + c2 * s2 + c3 * s4;
    float64_t s6 = s4 * s2;
    float64_t t2 = c4 + c5 * s2 + c6 * s4 + c7 * s6;
    float64_t R = t1 + t2 * s6;
    float64_t log_m = 2.0LF * s + s * s2 * R;
    float64_t ln2_hi = 0.69314718055994530942LF;
    float64_t ln2_lo = 2.3190468138462995584e-17LF;
    float64_t exp_dbl = float64_t(exp_val);
    return exp_dbl * ln2_hi + (log_m + exp_dbl * ln2_lo);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint output_idx = gl_WorkGroupID.x;

    if (output_idx >= params.outer_size) {
        return;
    }

    // Calculate position in output space
    uint outer_idx = output_idx / params.inner_size;
    uint inner_idx = output_idx % params.inner_size;
    uint base_idx = outer_idx * params.reduce_size * params.inner_size + inner_idx;

    // Pass 1: Find maximum for numerical stability
    float64_t local_max = -1.0 / 0.0; // -infinity
    for (uint i = tid; i < params.reduce_size; i += WORKGROUP_SIZE) {
        uint idx = base_idx + i * params.inner_size;
        if (idx < params.n) {
            local_max = max(local_max, input_data[idx]);
        }
    }

    shared_max[tid] = local_max;
    barrier();

    // Parallel reduction for max
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
        }
        barrier();
    }

    float64_t row_max = shared_max[0];
    barrier();

    // Pass 2: Compute sum(exp(x - max)) with Kahan summation
    float64_t local_sum = 0.0LF;
    float64_t local_comp = 0.0LF;
    for (uint i = tid; i < params.reduce_size; i += WORKGROUP_SIZE) {
        uint idx = base_idx + i * params.inner_size;
        if (idx < params.n) {
            float64_t val = exp_d(input_data[idx] - row_max);
            // Kahan summation
            float64_t y = val - local_comp;
            float64_t t = local_sum + y;
            local_comp = (t - local_sum) - y;
            local_sum = t;
        }
    }

    shared_sum[tid] = local_sum;
    shared_comp[tid] = local_comp;
    barrier();

    // Parallel reduction for sum (with compensation)
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            float64_t y = shared_sum[tid + s] - (shared_comp[tid] + shared_comp[tid + s]);
            float64_t t = shared_sum[tid] + y;
            shared_comp[tid] = (t - shared_sum[tid]) - y;
            shared_sum[tid] = t;
        }
        barrier();
    }

    // Write result: max + log(sum)
    if (tid == 0) {
        output_data[output_idx] = row_max + log_d(shared_sum[0]);
    }
}
