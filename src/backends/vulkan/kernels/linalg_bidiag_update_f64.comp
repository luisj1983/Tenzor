#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Blocked bidiagonal reduction — apply reflections to trailing submatrix (Float64)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer MatrixA { float64_t A[]; };
layout(set = 0, binding = 1) readonly buffer TauL { float64_t tau_l[]; };
layout(set = 0, binding = 2) readonly buffer TauR { float64_t tau_r[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint col_start;
    uint panel_cols;
    uint batch_idx;
};

shared float64_t dot_val;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = batch_idx * n * n;
    uint trail_start = col_start + panel_cols;

    uint j = trail_start + gl_WorkGroupID.x;
    if (j >= n) return;

    // ---- Apply left Householder reflections to column j ----
    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;
        float64_t left_tau = tau_l[batch_idx * n + col];
        if (abs(left_tau) < 1e-30lf) continue;

        if (tid == 0) {
            float64_t dot = A[base + col * n + j];
            for (uint r = col + 1; r < n; r++) {
                dot += A[base + r * n + col] * A[base + r * n + j];
            }
            dot_val = dot;
        }
        barrier();

        float64_t dot = dot_val;

        for (uint r = col + 1 + tid; r < n; r += 256) {
            A[base + r * n + j] -= left_tau * A[base + r * n + col] * dot;
        }
        if (tid == 0) {
            A[base + col * n + j] -= left_tau * dot;
        }
        barrier();
    }

    // ---- Apply right Householder reflections to row j ----
    for (uint k = 0; k < panel_cols; k++) {
        uint col = col_start + k;
        if (col + 2 >= n) continue;

        float64_t right_tau = tau_r[batch_idx * n + col];
        if (abs(right_tau) < 1e-30lf) continue;

        if (tid == 0) {
            float64_t dot = A[base + j * n + (col + 1)];
            for (uint c = col + 2; c < n; c++) {
                dot += A[base + j * n + c] * A[base + col * n + c];
            }
            dot_val = dot;
        }
        barrier();

        float64_t dot = dot_val;

        for (uint c = col + 2 + tid; c < n; c += 256) {
            A[base + j * n + c] -= right_tau * dot * A[base + col * n + c];
        }
        if (tid == 0) {
            A[base + j * n + (col + 1)] -= right_tau * dot;
        }
        barrier();
    }
}
