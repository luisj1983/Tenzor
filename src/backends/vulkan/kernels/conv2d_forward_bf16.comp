#version 450

// 2D Convolution Forward Pass - BFloat16 version (with groups support)
// BFloat16 packed buffers (2 BF16 per uint32).
// Accumulation in float32 for numerical stability.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Weight { uint weight_data[]; };
layout(binding = 2) buffer Bias { uint bias_data[]; };
layout(binding = 3) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;      // Total output elements
    uint batch;           // Batch size
    uint in_channels;     // Input channels
    uint out_channels;    // Output channels
    uint in_height;       // Input height
    uint in_width;        // Input width
    uint kernel_h;        // Kernel height
    uint kernel_w;        // Kernel width
    uint stride_h;        // Stride along H axis
    uint stride_w;        // Stride along W axis
    uint pad_h;           // Padding along H axis
    uint pad_w;           // Padding along W axis
    uint dil_h;           // Dilation along H axis
    uint dil_w;           // Dilation along W axis
    uint groups;          // Groups (for grouped convolution)
    uint out_h;           // Output height
    uint out_w;           // Output width
    uint has_bias;        // 1 if bias present, 0 otherwise
} params;

// Read a single BF16 element from a packed uint buffer.
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = (word_offset == 0) ? input_data[word_idx] : input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

float readBF16_buf(uint element_idx, uint buf_id) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed;
    if (buf_id == 0) packed = input_data[word_idx];
    else if (buf_id == 1) packed = weight_data[word_idx];
    else packed = bias_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Write a single BF16 element to the output packed buffer via CAS.
void writeBF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint shift = word_offset * 16;
    uint mask = 0xFFFFu << shift;
    uint bf16_bits = ((floatBitsToUint(val) + 0x7FFFu +
                      ((floatBitsToUint(val) >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint new_half = bf16_bits << shift;

    // Bounded CAS loop to avoid GPU livelock under contention; mirrors BB.7
    // saturation hard-stop pattern used elsewhere in the Vulkan backend.
    uint prev = output_data[word_idx];
    uint desired = (prev & ~mask) | new_half;
    for (uint attempt = 0u; attempt < 65536u; ++attempt) {
        desired = (prev & ~mask) | new_half;
        uint observed = atomicCompSwap(output_data[word_idx], prev, desired);
        if (observed == prev) return;
        prev = observed;
    }
    // Saturation hard-stop — extremely contended word; force last attempt.
    output_data[word_idx] = desired;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) {
        return;
    }

    // Decode index to (n, oc, oh, ow)
    uint ow = idx % params.out_w;
    uint temp = idx / params.out_w;
    uint oh = temp % params.out_h;
    temp /= params.out_h;
    uint oc = temp % params.out_channels;
    uint n = temp / params.out_channels;

    // Use float32 for accumulation to maintain precision
    float sum = 0.0;

    // Compute which input channels this output channel uses (for grouped convolution)
    uint channels_per_group = params.in_channels / params.groups;
    uint out_channels_per_group = params.out_channels / params.groups;
    uint group_id = oc / out_channels_per_group;
    uint ic_start = group_id * channels_per_group;
    uint ic_end = ic_start + channels_per_group;

    // Perform convolution
    for (uint ic = ic_start; ic < ic_end; ic++) {
        for (uint kh = 0; kh < params.kernel_h; kh++) {
            for (uint kw = 0; kw < params.kernel_w; kw++) {
                int ih = int(oh * params.stride_h) - int(params.pad_h) + int(kh * params.dil_h);
                int iw = int(ow * params.stride_w) - int(params.pad_w) + int(kw * params.dil_w);

                if (ih >= 0 && ih < int(params.in_height) && iw >= 0 && iw < int(params.in_width)) {
                    uint input_idx = n * (params.in_channels * params.in_height * params.in_width) +
                                    ic * (params.in_height * params.in_width) +
                                    uint(ih) * params.in_width + uint(iw);

                    uint ic_local = ic - ic_start;
                    uint weight_idx = oc * (channels_per_group * params.kernel_h * params.kernel_w) +
                                     ic_local * (params.kernel_h * params.kernel_w) +
                                     kh * params.kernel_w + kw;

                    sum += readBF16_buf(input_idx, 0) * readBF16_buf(weight_idx, 1);
                }
            }
        }
    }

    // Add bias if present
    if (params.has_bias == 1) {
        sum += readBF16_buf(oc, 2);
    }

    writeBF16(idx, sum);
}
