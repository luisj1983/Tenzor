#version 450

// Trilinear forward (5D). Mirrors interpolate_trilinear_backward.comp's
// coordinate transform exactly (same align_corners formula, same
// clamp-before-floor convention) so forward and backward agree — one
// work-item per output element, gathering the 8 surrounding input corners
// instead of scattering into them.

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input  { float input_data[]; };   // (N, C, in_d, in_h, in_w)
layout(binding = 1) buffer Output { float output_data[]; };  // (N, C, out_d, out_h, out_w)

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint in_d;
    uint in_h;
    uint in_w;
    uint out_d;
    uint out_h;
    uint out_w;
    uint align_corners;
} params;

float tri_get(uint base, int dd, int hh, int ww) {
    dd = clamp(dd, 0, int(params.in_d) - 1);
    hh = clamp(hh, 0, int(params.in_h) - 1);
    ww = clamp(ww, 0, int(params.in_w) - 1);
    return input_data[base + uint(dd) * params.in_h * params.in_w + uint(hh) * params.in_w + uint(ww)];
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    uint ow = temp % params.out_w; temp /= params.out_w;
    uint oh = temp % params.out_h; temp /= params.out_h;
    uint od = temp % params.out_d; temp /= params.out_d;
    uint c  = temp % params.channels; temp /= params.channels;
    uint b  = temp;

    float scd = (params.align_corners != 0u && params.out_d > 1u)
        ? float(params.in_d - 1u) / float(params.out_d - 1u) : float(params.in_d) / float(params.out_d);
    float sch = (params.align_corners != 0u && params.out_h > 1u)
        ? float(params.in_h - 1u) / float(params.out_h - 1u) : float(params.in_h) / float(params.out_h);
    float scw = (params.align_corners != 0u && params.out_w > 1u)
        ? float(params.in_w - 1u) / float(params.out_w - 1u) : float(params.in_w) / float(params.out_w);
    float sd = (params.align_corners != 0u) ? float(od) * scd : (float(od) + 0.5) * scd - 0.5;
    float sh = (params.align_corners != 0u) ? float(oh) * sch : (float(oh) + 0.5) * sch - 0.5;
    float sw = (params.align_corners != 0u) ? float(ow) * scw : (float(ow) + 0.5) * scw - 0.5;
    // Clamp the source coordinate to [0, in-1] before flooring — matches
    // interpolate_trilinear_backward.comp exactly, so forward and backward
    // agree on which 8 corners a border output samples/scatters into.
    sd = clamp(sd, 0.0, float(params.in_d - 1u));
    sh = clamp(sh, 0.0, float(params.in_h - 1u));
    sw = clamp(sw, 0.0, float(params.in_w - 1u));
    int d0 = int(floor(sd)), h0 = int(floor(sh)), w0 = int(floor(sw));
    int d1 = min(d0 + 1, int(params.in_d) - 1);
    int h1 = min(h0 + 1, int(params.in_h) - 1);
    int w1 = min(w0 + 1, int(params.in_w) - 1);
    float fd = sd - float(d0), fh = sh - float(h0), fw = sw - float(w0);

    uint base = b * (params.channels * params.in_d * params.in_h * params.in_w)
              + c * (params.in_d * params.in_h * params.in_w);

    float v000 = tri_get(base, d0, h0, w0);
    float v001 = tri_get(base, d0, h0, w1);
    float v010 = tri_get(base, d0, h1, w0);
    float v011 = tri_get(base, d0, h1, w1);
    float v100 = tri_get(base, d1, h0, w0);
    float v101 = tri_get(base, d1, h0, w1);
    float v110 = tri_get(base, d1, h1, w0);
    float v111 = tri_get(base, d1, h1, w1);

    float val =
        (1.0 - fd) * (1.0 - fh) * (1.0 - fw) * v000 +
        (1.0 - fd) * (1.0 - fh) * fw         * v001 +
        (1.0 - fd) * fh         * (1.0 - fw) * v010 +
        (1.0 - fd) * fh         * fw         * v011 +
        fd         * (1.0 - fh) * (1.0 - fw) * v100 +
        fd         * (1.0 - fh) * fw         * v101 +
        fd         * fh         * (1.0 - fw) * v110 +
        fd         * fh         * fw         * v111;

    output_data[idx] = val;
}
