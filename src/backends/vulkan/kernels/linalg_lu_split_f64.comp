#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer PackedBuf { double packed[]; };
layout(set = 0, binding = 1) writeonly buffer LBuf     { double L[];      };
layout(set = 0, binding = 2) writeonly buffer UBuf     { double U[];      };

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch_size;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint nn = n * n;
    uint total = batch_size * nn;
    if (gid >= total) return;

    uint b = gid / nn;
    uint ij = gid - b * nn;
    uint i = ij / n;
    uint j = ij - i * n;
    uint idx = b * nn + i * n + j;

    double v = packed[idx];
    if (i > j) {
        L[idx] = v;
        U[idx] = 0.0lf;
    } else if (i == j) {
        L[idx] = 1.0lf;
        U[idx] = v;
    } else {
        L[idx] = 0.0lf;
        U[idx] = v;
    }
}
