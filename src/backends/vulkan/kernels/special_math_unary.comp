#version 450

// Special math unary operations (Float32 storage, Float32 internal):
//   0=gamma, 1=lgamma, 2=digamma, 3=bessel_j0, 4=bessel_j1,
//   5=bessel_y0, 6=bessel_y1, 7=bessel_i0, 8=bessel_i1, 9=erfinv,
//   10=sinc, 11=polygamma (n via push_constant param_int),
//   12=i0e, 13=i1e, 14=entr, 15=spherical_bessel_j0
//
// Replaces the previous CPU-roundtrip fallbacks. Uses the same Cephes /
// Abramowitz polynomial approximations as the CPU backend.

layout(local_size_x_id = 0) in;
layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;        // Number of elements
    uint op;       // Operation opcode (see header)
    int param_int; // Polygamma order n (only used by op=11)
} params;

const float PI = 3.14159265358979f;

// ----- Lanczos lgamma (non-recursive) -----
// GLSL has no built-in lgamma. Lanczos g=7 approximation, with a single
// reflection step inlined for x < 0.5 (the recursive call always lands in
// the x >= 0.5 branch since 1-x > 0.5 when x < 0.5).
float lgamma_lanczos(float x) {
    float coef[9];
    coef[0] = 0.99999999999980993f;
    coef[1] = 676.5203681218851f;
    coef[2] = -1259.1392167224028f;
    coef[3] = 771.32342877765313f;
    coef[4] = -176.61502916214059f;
    coef[5] = 12.507343278686905f;
    coef[6] = -0.13857109526572012f;
    coef[7] = 9.9843695780195716e-6f;
    coef[8] = 1.5056327351493116e-7f;

    float g = 7.0f;
    float xm1 = x - 1.0f;
    float a = coef[0];
    float t = xm1 + g + 0.5f;
    for (int i = 1; i < 9; ++i) {
        a += coef[i] / (xm1 + float(i));
    }
    return 0.5f * log(2.0f * PI) + (xm1 + 0.5f) * log(t) - t + log(a);
}
float lgamma_impl(float x) {
    // Pole at every non-positive integer: the reflection formula below
    // divides by sin(PI*x), which floating-point PI never lands on exactly
    // zero for, so without this check it returns finite garbage instead of
    // +inf (verified: lgamma_impl(-1.0f)=17.397, lgamma_impl(-2.0f)=16.011).
    // Return the real IEEE +inf bit pattern directly, bypassing the
    // reflection formula entirely at poles.
    if (x <= 0.0f && x == floor(x)) {
        return uintBitsToFloat(0x7F800000u);  // +inf
    }
    if (x < 0.5f) {
        // Reflection: lgamma(x) = log(pi/sin(pi*x)) - lgamma(1-x)
        // The 1-x branch always satisfies (1-x) >= 0.5, so call lanczos directly.
        return log(PI / abs(sin(PI * x))) - lgamma_lanczos(1.0f - x);
    }
    return lgamma_lanczos(x);
}
float tgamma_impl(float x) {
    // gamma has a true sign-ambiguous pole at non-positive integers (it
    // diverges to +inf from one side, -inf from the other); NaN is the
    // standard convention (matches std::tgamma/scipy). Must be checked here
    // too, not just inherited via exp(lgamma_impl(x)) -- exp(+inf) would
    // wrongly give +inf instead of NaN.
    if (x <= 0.0f && x == floor(x)) {
        return uintBitsToFloat(0x7FC00000u);  // NaN
    }
    return exp(lgamma_impl(x));
}

// ----- Digamma -----
float digamma_impl(float x) {
    // True pole at every non-positive integer: PI/tan(PI*x) below depends on
    // tan(PI*x) hitting exactly zero, which floating-point PI never does --
    // each backend's differing PI precision then makes the "near-pole"
    // result diverge wildly and inconsistently from every other backend, not
    // just from the true pole. Digamma has no single-valued limit at these
    // poles, so NaN -- not a signed infinity -- is the mathematically
    // honest, scipy/PyTorch-consistent convention shared by every backend
    // after this fix.
    if (x <= 0.0f && x == floor(x)) {
        return uintBitsToFloat(0x7FC00000u);  // NaN
    }
    float result = 0.0f;
    if (x < 0.5f) {
        float y = 1.0f - x;
        float r = 0.0f;
        for (int i = 0; i < 100; ++i) {
            if (y >= 7.0f) break;
            r -= 1.0f / y;
            y += 1.0f;
        }
        float y2 = 1.0f / (y * y);
        r += log(y) - 0.5f / y
            - y2 * (0.0833333333f - y2 * (0.00833333333f - y2 * (0.00396825397f
            - y2 * (0.00416666667f - y2 * 0.00757575758f))));
        return r - PI / tan(PI * x);
    }
    for (int i = 0; i < 100; ++i) {
        if (x >= 7.0f) break;
        result -= 1.0f / x;
        x += 1.0f;
    }
    float x2 = 1.0f / (x * x);
    result += log(x) - 0.5f / x
            - x2 * (0.0833333333f - x2 * (0.00833333333f - x2 * (0.00396825397f
            - x2 * (0.00416666667f - x2 * 0.00757575758f))));
    return result;
}

// ----- Bessel J0 (Numerical Recipes rational approximation, ~1e-7) -----
float bessel_j0_impl(float x_in) {
    float ax = abs(x_in);
    if (ax < 8.0f) {
        float y = x_in * x_in;
        float r1 = 57568490574.0f + y * (-13362590354.0f
                 + y * (651619640.7f + y * (-11214424.18f
                 + y * (77392.33017f + y * (-184.9052456f)))));
        float r2 = 57568490411.0f + y * (1029532985.0f
                 + y * (9494680.718f + y * (59272.64853f
                 + y * (267.8532712f + y * 1.0f))));
        return r1 / r2;
    }
    float z = 8.0f / ax;
    float y = z * z;
    float r1 = 1.0f + y * (-0.1098628627e-2f + y * (0.2734510407e-4f
             + y * (-0.2073370639e-5f + y * 0.2093887211e-6f)));
    float r2 = -0.1562499995e-1f + y * (0.1430488765e-3f
             + y * (-0.6911147651e-5f + y * (0.7621095161e-6f
             + y * (-0.934935152e-7f))));
    return sqrt(0.636619772f / ax)
         * (cos(ax - 0.785398164f) * r1 - z * sin(ax - 0.785398164f) * r2);
}

// ----- Bessel J1 (Numerical Recipes rational approximation, ~1e-7) -----
float bessel_j1_impl(float x_in) {
    float ax = abs(x_in);
    float result;
    if (ax < 8.0f) {
        float y = x_in * x_in;
        float r1 = x_in * (72362614232.0f + y * (-7895059235.0f
                 + y * (242396853.1f + y * (-2972611.439f
                 + y * (15704.48260f + y * (-30.16036606f))))));
        float r2 = 144725228442.0f + y * (2300535178.0f
                 + y * (18583304.74f + y * (99447.43394f
                 + y * (376.9991397f + y * 1.0f))));
        result = r1 / r2;
    } else {
        float z = 8.0f / ax;
        float y = z * z;
        float r1 = 1.0f + y * (0.183105e-2f + y * (-0.3516396496e-4f
                 + y * (0.2457520174e-5f + y * (-0.240337019e-6f))));
        float r2 = 0.04687499995f + y * (-0.2002690873e-3f
                 + y * (0.8449199096e-5f + y * (-0.88228987e-6f
                 + y * 0.105787412e-6f)));
        float ans = sqrt(0.636619772f / ax)
                  * (cos(ax - 2.356194491f) * r1 - z * sin(ax - 2.356194491f) * r2);
        result = (x_in < 0.0f) ? -ans : ans;
        return result;
    }
    return result;
}

// ----- Bessel Y0 (Numerical Recipes rational approximation, ~1e-7) -----
float bessel_y0_impl(float x) {
    // Y0 has a true pole at x=0 and is undefined for x<0. Standardize on the
    // IEEE-754/native-libm convention (CUDA's y0f/ROCm's y0f, and this
    // file's own digamma/lgamma pole convention above): NaN for x<0, real
    // -inf exactly at x==0 -- a finite sentinel like -1e38 is silently
    // indistinguishable from an actual finite Y0 result.
    if (x < 0.0f) return uintBitsToFloat(0x7FC00000u);   // NaN
    if (x == 0.0f) return uintBitsToFloat(0xFF800000u);  // -inf
    if (x < 8.0f) {
        float y = x * x;
        float r1 = -2957821389.0f + y * (7062834065.0f
                 + y * (-512359803.6f + y * (10879881.29f
                 + y * (-86327.92757f + y * 228.4622733f))));
        float r2 = 40076544269.0f + y * (745249964.8f
                 + y * (7189466.438f + y * (47447.26470f
                 + y * (226.1030244f + y * 1.0f))));
        return (r1 / r2) + 0.636619772f * bessel_j0_impl(x) * log(x);
    }
    float z = 8.0f / x;
    float y = z * z;
    float r1 = 1.0f + y * (-0.1098628627e-2f + y * (0.2734510407e-4f
             + y * (-0.2073370639e-5f + y * 0.2093887211e-6f)));
    float r2 = -0.1562499995e-1f + y * (0.1430488765e-3f
             + y * (-0.6911147651e-5f + y * (0.7621095161e-6f
             + y * (-0.934935152e-7f))));
    return sqrt(0.636619772f / x)
         * (sin(x - 0.785398164f) * r1 + z * cos(x - 0.785398164f) * r2);
}

// ----- Bessel Y1 (Numerical Recipes rational approximation, ~1e-7) -----
float bessel_y1_impl(float x) {
    // Same NaN-for-x<0/-inf-at-x==0 convention as bessel_y0_impl above.
    if (x < 0.0f) return uintBitsToFloat(0x7FC00000u);   // NaN
    if (x == 0.0f) return uintBitsToFloat(0xFF800000u);  // -inf
    if (x < 8.0f) {
        float y = x * x;
        float r1 = x * (-4.900604943e13f + y * (1.275274390e13f
                 + y * (-5.153438139e11f + y * (7.349264551e9f
                 + y * (-4.237922726e7f + y * 8.511937935e4f)))));
        float r2 = 2.499580570e14f + y * (4.244419664e12f
                 + y * (3.733650367e10f + y * (2.245904002e8f
                 + y * (1.020426050e6f + y * (3.549632885e3f + y)))));
        return (r1 / r2) + 0.636619772f * (bessel_j1_impl(x) * log(x) - 1.0f / x);
    }
    float z = 8.0f / x;
    float y = z * z;
    float r1 = 1.0f + y * (0.183105e-2f + y * (-0.3516396496e-4f
             + y * (0.2457520174e-5f + y * (-0.240337019e-6f))));
    float r2 = 0.04687499995f + y * (-0.2002690873e-3f
             + y * (0.8449199096e-5f + y * (-0.88228987e-6f
             + y * 0.105787412e-6f)));
    return sqrt(0.636619772f / x)
         * (sin(x - 2.356194491f) * r1 + z * cos(x - 2.356194491f) * r2);
}

// ----- Modified Bessel I0 -----
float bessel_i0_impl(float x_in) {
    float ax = abs(x_in);
    if (ax < 3.75f) {
        float t = x_in / 3.75f;
        t = t * t;
        return 1.0f + t * (3.5156229f + t * (3.0899424f + t * (1.2067492f
               + t * (0.2659732f + t * (0.0360768f + t * 0.0045813f)))));
    }
    float t = 3.75f / ax;
    return (exp(ax) / sqrt(ax)) * (0.39894228f + t * (0.01328592f
           + t * (0.00225319f - t * (0.00157565f - t * (0.00916281f
           - t * (0.02057706f - t * (0.02635537f - t * (0.01647633f
           - t * 0.00392377f))))))));
}

// ----- Modified Bessel I1 -----
float bessel_i1_impl(float x_in) {
    float ax = abs(x_in);
    float result;
    if (ax < 3.75f) {
        float t = x_in / 3.75f;
        t = t * t;
        result = ax * (0.5f + t * (0.87890594f + t * (0.51498869f + t * (0.15084934f
                 + t * (0.02658733f + t * (0.00301532f + t * 0.00032411f))))));
    } else {
        float t = 3.75f / ax;
        result = (exp(ax) / sqrt(ax)) * (0.39894228f - t * (0.03988024f
                 - t * (0.00362018f + t * (0.00163801f - t * (0.01031555f
                 - t * (0.02282967f - t * (0.02895312f - t * (0.01787654f
                 - t * 0.00420059f))))))));
    }
    return (x_in < 0.0f) ? -result : result;
}

// ----- ErfInv (Winitzki + 2 Newton iterations) -----
// GLSL has no built-in erf; implement Abramowitz & Stegun 7.1.26
float erf_impl(float x) {
    float sgn = (x < 0.0f) ? -1.0f : 1.0f;
    x = abs(x);
    float a1 =  0.254829592f;
    float a2 = -0.284496736f;
    float a3 =  1.421413741f;
    float a4 = -1.453152027f;
    float a5 =  1.061405429f;
    float p_  =  0.3275911f;
    float t = 1.0f / (1.0f + p_ * x);
    float y = 1.0f - ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t * exp(-x * x);
    return sgn * y;
}
float erfinv_impl(float x) {
    if (x <= -1.0f) return -1.0e38f;
    if (x >= 1.0f) return 1.0e38f;
    if (x == 0.0f) return 0.0f;
    float a = 0.147f;
    float ln1mx2 = log(1.0f - x * x);
    float t1 = 2.0f / (PI * a) + 0.5f * ln1mx2;
    float t2 = ln1mx2 / a;
    float sgn = (x > 0.0f) ? 1.0f : -1.0f;
    float r = sgn * sqrt(sqrt(t1 * t1 - t2) - t1);
    for (int i = 0; i < 2; ++i) {
        float err = erf_impl(r) - x;
        float deriv = 2.0f / sqrt(PI) * exp(-r * r);
        r -= err / deriv;
    }
    return r;
}

// ----- Sinc -----
// sin(πx) loses precision for x near a non-zero integer (the argument is
// near a multiple of π where sin cancels to ~0); GLSL `sin()` on NVIDIA
// maps to `sin.approx.f32` which has ~32 LSB error globally. To match CPU
// libm sin (~1 ULP) we:
//   1. Reduce: sin(πx) = (-1)^round(x) * sin(π*frac), frac = x - round(x)
//      so |π*frac| ≤ π/2 (well-conditioned domain).
//   2. Evaluate sin via an explicit Taylor series rather than the built-in
//      `sin()` — for |t| ≤ π/2 the 8-term series is accurate to ~1 ULP.
float sin_taylor(float t) {
    // sin(t) = t - t^3/3! + t^5/5! - t^7/7! + t^9/9! - t^11/11! + t^13/13! - t^15/15!
    float t2 = t * t;
    // Horner form on the polynomial in t^2:
    //   sin(t)/t = 1 - t^2/6 + t^4/120 - t^6/5040 + t^8/362880 - t^10/39916800
    //            + t^12/6227020800 - t^14/1307674368000
    float poly = 1.0
        - t2 * (1.0/6.0
        - t2 * (1.0/120.0
        - t2 * (1.0/5040.0
        - t2 * (1.0/362880.0
        - t2 * (1.0/39916800.0
        - t2 * (1.0/6227020800.0
        - t2 * (1.0/1307674368000.0)))))));
    return t * poly;
}

float sinc_impl(float x) {
    if (x == 0.0f) return 1.0f;
    float n = round(x);
    float frac = x - n;
    // For |frac| < epsilon, sin(π*frac) ≈ π*frac, so sinc(x) ≈ ±π*frac/(π*x).
    // The Taylor series handles this correctly without extra logic.
    float sin_pi_frac = sin_taylor(PI * frac);
    float sign = (mod(n, 2.0) == 0.0) ? 1.0 : -1.0;
    return sign * sin_pi_frac / (PI * x);
}

// ----- I0e: exp(-|x|) * BesselI0(x) -----
float i0e_impl(float x_in) {
    float ax = abs(x_in);
    if (ax < 3.75f) {
        float t = x_in / 3.75f;
        t = t * t;
        float i0 = 1.0f + t * (3.5156229f + t * (3.0899424f + t * (1.2067492f
                   + t * (0.2659732f + t * (0.0360768f + t * 0.0045813f)))));
        return exp(-ax) * i0;
    }
    float t = 3.75f / ax;
    return (1.0f / sqrt(ax)) * (0.39894228f + t * (0.01328592f
           + t * (0.00225319f - t * (0.00157565f - t * (0.00916281f
           - t * (0.02057706f - t * (0.02635537f - t * (0.01647633f
           - t * 0.00392377f))))))));
}

// ----- I1e: exp(-|x|) * BesselI1(x) -----
float i1e_impl(float x_in) {
    float ax = abs(x_in);
    float result;
    if (ax < 3.75f) {
        float t = x_in / 3.75f;
        t = t * t;
        result = ax * (0.5f + t * (0.87890594f + t * (0.51498869f + t * (0.15084934f
                 + t * (0.02658733f + t * (0.00301532f + t * 0.00032411f))))));
        result = exp(-ax) * result;
    } else {
        float t = 3.75f / ax;
        result = (1.0f / sqrt(ax)) * (0.39894228f - t * (0.03988024f
                 - t * (0.00362018f + t * (0.00163801f - t * (0.01031555f
                 - t * (0.02282967f - t * (0.02895312f - t * (0.01787654f
                 - t * 0.00420059f))))))));
    }
    return (x_in < 0.0f) ? -result : result;
}

// ----- Entr: -x*log(x), 0->0, negative->-inf -----
float entr_impl(float x) {
    if (x > 0.0f) return -x * log(x);
    if (x == 0.0f) return 0.0f;
    return -1.0e38f;  // -inf for negative
}

// ----- SphericalBesselJ0: sin(x)/x, j0(0)=1 -----
float spherical_bessel_j0_impl(float x) {
    if (x == 0.0f) return 1.0f;
    return sin(x) / x;
}

// ----- Polygamma -----
// ψ^(n)(x) = (-1)^(n+1) [n! Σ 1/(x+k)^(n+1)]. The straight series
// converges as 1/k for n=1 (trigamma): 100 terms leaves a ~1/100 tail
// (~0.01 abs error), which is enough to fail Float32 gradcheck.
// Use the recurrence ψ^(n)(x) = ψ^(n)(x+1) + (-1)^(n+1) n! / x^(n+1) to
// shift x above a threshold, then use the asymptotic Bernoulli series.
//   ψ'(x) ~ 1/x + 1/(2x²) + B_2/x³ + B_4/x⁵ + …
// For n ≥ 2, differentiate term-wise:
//   ψ^(n)(x) ~ (-1)^(n+1) [(n-1)!/x^n + n!/(2 x^(n+1))
//                            + Σ B_{2k} (2k+n-1)! / ((2k)! x^(2k+n))]
float polygamma_impl(int n, float x) {
    if (n == 0) return digamma_impl(x);

    float fact_n = 1.0f;
    for (int k = 1; k <= n; ++k) fact_n *= float(k);
    float sgn = ((n + 1) % 2 == 0) ? 1.0f : -1.0f;

    // Recurrence: shift x up so the asymptotic series converges quickly.
    const float kShiftTarget = 12.0f;
    float shifted = 0.0f;
    for (int i = 0; i < 64; ++i) {
        if (x >= kShiftTarget) break;
        shifted += pow(x, -float(n + 1));
        x += 1.0f;
    }

    // Asymptotic expansion at the shifted x.
    float inv_x = 1.0f / x;
    float inv_x_n = pow(inv_x, float(n));
    float fact_nm1 = fact_n / float(n);  // (n-1)!

    float sum_asym = fact_nm1 * inv_x_n + 0.5f * fact_n * inv_x_n * inv_x;

    // Bernoulli correction terms B_{2k}/(2k)!:
    //   k=1: 1/12      k=2: -1/720      k=3: 1/30240
    //   k=4: -1/1209600  k=5: 5/479001600
    const float B_over_fact[5] = float[5](
        1.0f/12.0f,
        -1.0f/720.0f,
        1.0f/30240.0f,
        -1.0f/1209600.0f,
        1.0f/47900160.0f
    );
    // NOTE: same bug class as ROCm's polygamma (src/backends/rocm/kernels/
    // math.hip.cpp) had before its fix -- `rising` alone only accumulates
    // (n+2k-1)!/(n-1)!, so the term needs an explicit `* fact_nm1` to
    // recover the full (n+2k-1)! numerator that CPU/CUDA/OneAPI's polygamma
    // all include (OneAPI's special_math.cpp documents this exact
    // requirement). `power` must also start at x^-n (not x^-(n+1)) so that
    // after the k-th `power *= inv_x2` it equals x^-(n+2k), matching the
    // term's x^-(n+2k) denominator.
    float inv_x2 = inv_x * inv_x;
    float power = inv_x_n;
    float rising = 1.0f;
    for (int k = 1; k <= 5; ++k) {
        rising *= float(n + 2*k - 1) * float(n + 2*k - 2);
        power *= inv_x2;
        sum_asym += B_over_fact[k-1] * rising * fact_nm1 * power;
    }

    return sgn * (fact_n * shifted + sum_asym);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;
    float x = input_data[idx];
    float r;
    switch (params.op) {
        case 0:  r = tgamma_impl(x); break;
        case 1:  r = lgamma_impl(x); break;
        case 2:  r = digamma_impl(x); break;
        case 3:  r = bessel_j0_impl(x); break;
        case 4:  r = bessel_j1_impl(x); break;
        case 5:  r = bessel_y0_impl(x); break;
        case 6:  r = bessel_y1_impl(x); break;
        case 7:  r = bessel_i0_impl(x); break;
        case 8:  r = bessel_i1_impl(x); break;
        case 9:  r = erfinv_impl(x); break;
        case 10: r = sinc_impl(x); break;
        case 11: r = polygamma_impl(params.param_int, x); break;
        case 12: r = i0e_impl(x); break;
        case 13: r = i1e_impl(x); break;
        case 14: r = entr_impl(x); break;
        case 15: r = spherical_bessel_j0_impl(x); break;
        default: r = 0.0f;
    }
    output_data[idx] = r;
}
