#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Batch Normalization 2D - Compute Mean and Variance (Float64)
//
// Input shape: (N, C, H, W)
// Output shapes: mean (C), variance (C)
//
// For each channel c:
// mean[c] = sum(input[n, c, h, w]) / (N * H * W)
// var[c] = sum((input[n, c, h, w] - mean[c])^2) / (N * H * W)
//
// DETERMINISTIC one-workgroup-per-channel tree reduction, mirroring the
// Float32 variant (batchnorm2d_mean_var.comp). The previous version did one
// global atomicAdd(double) per element; float atomic addition is
// order-nondeterministic, so two identical forward passes produced results
// differing by ~1 ulp — which breaks run-to-run consistency tests and adds
// noise to finite-difference gradchecks. It also required the host to
// pre-zero temp_sum/var_data and depended on shaderBufferFloat64AtomicAdd.
// Here each thread accumulates a fixed strided slice of its channel, then a
// fixed-order shared-memory tree combines the partials: bitwise reproducible
// for a given workgroup size, and needing no float64 atomics (just a plain
// shared array + barrier).

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { double input_data[]; };      // (N, C, H, W)
layout(binding = 1) buffer Mean { double mean_data[]; };        // (C) - input in pass 1
layout(binding = 2) buffer Variance { double var_data[]; };     // (C) - output (pass 1)
layout(binding = 3) buffer TempSum { double temp_sum[]; };      // (C) - output (pass 0)

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Total elements (N * C * H * W)
    uint batch;          // N
    uint channels;       // C
    uint spatial_size;   // H * W
    uint pass_id;        // 0 = accumulate sum, 1 = accumulate squared diff
} params;

shared double partial_sum[WORKGROUP_SIZE];

void main() {
    const uint c = gl_WorkGroupID.x;          // one workgroup per channel
    const uint tid = gl_LocalInvocationID.x;
    if (c >= params.channels) return;

    const uint per_channel = params.batch * params.spatial_size;

    double acc = 0.0LF;
    if (params.pass_id == 0) {
        for (uint i = tid; i < per_channel; i += WORKGROUP_SIZE) {
            const uint b = i / params.spatial_size;
            const uint s = i % params.spatial_size;
            const uint idx = (b * params.channels + c) * params.spatial_size + s;
            acc += input_data[idx];
        }
    } else {
        const double mean = mean_data[c];
        for (uint i = tid; i < per_channel; i += WORKGROUP_SIZE) {
            const uint b = i / params.spatial_size;
            const uint s = i % params.spatial_size;
            const uint idx = (b * params.channels + c) * params.spatial_size + s;
            const double diff = input_data[idx] - mean;
            acc += diff * diff;
        }
    }

    partial_sum[tid] = acc;
    barrier();

    for (uint stride = WORKGROUP_SIZE / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial_sum[tid] += partial_sum[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        if (params.pass_id == 0) {
            temp_sum[c] = partial_sum[0];
        } else {
            var_data[c] = partial_sum[0];
        }
    }
}
