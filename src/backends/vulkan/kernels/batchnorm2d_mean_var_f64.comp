#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_EXT_shader_atomic_float : enable

// Batch Normalization 2D - Compute Mean and Variance (Float64 version)
// Computes running mean and variance across batch and spatial dimensions
//
// Input shape: (N, C, H, W)
// Output shapes: mean (C), variance (C)
//
// For each channel c:
// mean[c] = sum(input[n, c, h, w]) / (N * H * W)
// var[c] = sum((input[n, c, h, w] - mean[c])^2) / (N * H * W)
//
// Note: Uses buffer atomicAdd (shaderBufferFloat64AtomicAdd) instead of
// shared memory atomicAdd, since shaderSharedFloat64AtomicAdd is not
// available in standard Vulkan extensions.

layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { double input_data[]; };      // (N, C, H, W)
layout(binding = 1) buffer Mean { double mean_data[]; };        // (C) - output
layout(binding = 2) buffer Variance { double var_data[]; };     // (C) - output
layout(binding = 3) buffer TempSum { double temp_sum[]; };      // (C) - temporary for two-pass algorithm

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Total elements (N * C * H * W)
    uint batch;          // N
    uint channels;       // C
    uint spatial_size;   // H * W
    uint pass_id;        // 0 = compute mean, 1 = compute variance
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (b, c, h, w)
    uint temp = idx;
    uint w = temp % params.spatial_size;
    temp /= params.spatial_size;
    uint c = temp % params.channels;

    double value = input_data[idx];

    if (params.pass_id == 0) {
        // First pass: accumulate sum for mean computation
        // Use buffer atomicAdd (supported by VK_EXT_shader_atomic_float)
        atomicAdd(temp_sum[c], value);
    } else {
        // Second pass: accumulate sum of squared differences for variance
        double mean = mean_data[c];
        double diff = value - mean;
        atomicAdd(var_data[c], diff * diff);
    }
}
