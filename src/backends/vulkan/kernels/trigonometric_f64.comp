#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Trigonometric functions for Float64: sin, cos, tan, asin, acos, atan
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputBuffer { double input_data[]; };
layout(binding = 1) buffer OutputBuffer { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=sin, 1=cos, 2=tan, 3=asin, 4=acos, 5=atan
} params;

const double PI = 3.141592653589793;

// Double-precision range reduction for trig functions.
// Reduces x to [-pi/4, pi/4] using Cody-Waite extended-precision subtraction.
// Returns reduced value r and quadrant q (0-3).
void trig_reduce(double x, out double r, out int q) {
    // Two-part representation of 2/pi for extended precision
    double two_over_pi = 0.6366197723675814;
    double pi_over_2_hi = 1.5707963267948966;    // High part of pi/2
    double pi_over_2_lo = 6.123233995736766e-17;  // Low part of pi/2

    // Find quadrant
    double j = floor(x * two_over_pi + 0.5);
    q = int(j) & 3;

    // Cody-Waite reduction: r = x - j * (pi/2)
    r = x - j * pi_over_2_hi;
    r = r - j * pi_over_2_lo;
}

// Polynomial approximation of sin on [-pi/4, pi/4]
// Minimax polynomial coefficients
double sin_poly(double x) {
    double x2 = x * x;
    // Taylor series for sin on [-pi/4, pi/4]. The previous truncation at x^9
    // left a leading error term ~x^11/11! (~1.8e-9 at |x|=pi/4), which produced
    // the ~2.4e-8 Float64 sin divergence from the CPU/OneAPI reference. Extend to
    // x^15/15! so the truncation error (~x^17/17! ~ 1e-17) is below double eps.
    // sin(x) = x - x^3/3! + x^5/5! - x^7/7! + x^9/9! - x^11/11! + x^13/13! - x^15/15!
    return x * (1.0 - x2 * (1.0/6.0 - x2 * (1.0/120.0 - x2 * (1.0/5040.0
        - x2 * (1.0/362880.0 - x2 * (1.0/39916800.0
        - x2 * (1.0/6227020800.0 - x2 / 1307674368000.0)))))));
}

// Polynomial approximation of cos on [-pi/4, pi/4]
double cos_poly(double x) {
    double x2 = x * x;
    // Extended to x^14/14! to match the sin precision (the x^8 truncation left a
    // ~x^10/10! ~ 2.5e-8 error at |x|=pi/4). cos(x) = 1 - x^2/2! + x^4/4!
    // - x^6/6! + x^8/8! - x^10/10! + x^12/12! - x^14/14!
    return 1.0 - x2 * (0.5 - x2 * (1.0/24.0 - x2 * (1.0/720.0
        - x2 * (1.0/40320.0 - x2 * (1.0/3628800.0
        - x2 * (1.0/479001600.0 - x2 / 87178291200.0))))));
}

// Double-precision sin. Always uses range reduction + double-precision
// polynomial — the earlier `float(sin(float(x)))` fast path silently dropped
// all results to Float32 precision, which breaks gradcheck on Float64.
double sin_d(double x) {
    if (x != x) return x;  // NaN

    double r;
    int q;
    trig_reduce(x, r, q);

    switch (q) {
        case 0: return sin_poly(r);
        case 1: return cos_poly(r);
        case 2: return -sin_poly(r);
        case 3: return -cos_poly(r);
    }
    return 0.0;
}

// Double-precision cos
double cos_d(double x) {
    if (x != x) return x;  // NaN

    double r;
    int q;
    trig_reduce(x, r, q);

    switch (q) {
        case 0: return cos_poly(r);
        case 1: return -sin_poly(r);
        case 2: return -cos_poly(r);
        case 3: return sin_poly(r);
    }
    return 0.0;
}

// Double-precision tan
double tan_d(double x) {
    if (x != x) return x;  // NaN

    double s = sin_d(x);
    double c = cos_d(x);
    return s / c;
}

// Double-precision asin using identity asin(x) = atan(x / sqrt(1 - x^2)).
// Domain guard: |x|>1 must produce a deterministic NaN (matching
// std::asin), not a finite value. The previous clamp(x, -1, 1) silently
// masked out-of-domain inputs into +-pi/2 instead of NaN.
double atan_d(double x);  // forward decl
double asin_d(double x) {
    if (x != x) return x;
    if (x > 1.0 || x < -1.0) return 0.0 / 0.0;  // NaN
    double one_minus_xx = 1.0 - x * x;
    if (one_minus_xx <= 0.0) return (x > 0.0) ? (PI * 0.5) : (-PI * 0.5);  // exact +-1
    return atan_d(x / sqrt(one_minus_xx));
}

// Double-precision acos = pi/2 - asin
double acos_d(double x) {
    if (x != x) return x;
    return PI * 0.5 - asin_d(x);
}

// Double-precision atan via range-reduction + Maclaurin/Padé on [-tan(pi/8), tan(pi/8)].
// For |x| > 1 use atan(x) = pi/2 - atan(1/x). Then for |x| > tan(pi/8) use
// atan(x) = pi/4 + atan((x-1)/(x+1)). What remains is |x| <= tan(pi/8) ~ 0.4142,
// where a degree-11 odd polynomial gives ~double precision.
double atan_d(double x) {
    if (x != x) return x;

    double sign = 1.0;
    double ax = x;
    if (ax < 0.0) { sign = -1.0; ax = -ax; }

    bool inv = (ax > 1.0);
    if (inv) ax = 1.0 / ax;

    double add = 0.0;
    const double TAN_PI_8 = 0.41421356237309503;  // tan(pi/8)
    if (ax > TAN_PI_8) {
        // Reduce by pi/4
        add = PI * 0.25;
        ax = (ax - 1.0) / (ax + 1.0);
    }

    // Maclaurin series: atan(x) = x - x^3/3 + x^5/5 - x^7/7 + ...
    double x2 = ax * ax;
    // Use Horner's method with enough terms for double precision on |x| <= 0.414
    double p = (1.0/15.0) - x2 * ((1.0/17.0) - x2 * ((1.0/19.0) - x2 * ((1.0/21.0) - x2 * (1.0/23.0))));
    p = (1.0/5.0) - x2 * ((1.0/7.0) - x2 * ((1.0/9.0) - x2 * ((1.0/11.0) - x2 * ((1.0/13.0) - x2 * p))));
    double r = ax - ax * x2 * (1.0/3.0 - x2 * p);

    double result = add + r;
    if (inv) result = PI * 0.5 - result;
    return sign * result;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    double val = input_data[idx];

    switch (params.op) {
        case 0: // sin
            output_data[idx] = sin_d(val);
            break;
        case 1: // cos
            output_data[idx] = cos_d(val);
            break;
        case 2: // tan
            output_data[idx] = tan_d(val);
            break;
        case 3: // asin
            output_data[idx] = asin_d(val);
            break;
        case 4: // acos
            output_data[idx] = acos_d(val);
            break;
        case 5: // atan
            output_data[idx] = atan_d(val);
            break;
        default:
            output_data[idx] = 0.0;
            break;
    }
}
