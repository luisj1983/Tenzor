#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Quantized Conv2d: Int8 convolution with int64 accumulation, dequantize to
// Float32. The running total (and the input_zp*weight_zp*K correction term) can
// exceed INT32_MAX for wide layers, so accumulate in int64 to avoid silent
// wraparound, matching the CUDA quantized reference.
// Each thread computes one output element: output[n][oc][oh][ow]
//
// F044: supports per-axis kernel size (rectangular), per-axis stride/padding/
// dilation (asymmetric), and grouped convolution — matching the CPU/CUDA kernels.
// F045: per-channel weight scale/zero-point (bindings 4/5) when per_channel != 0.
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputData { int8_t input_data[]; };
layout(binding = 1) buffer WeightData { int8_t weight_data[]; };
layout(binding = 2) buffer BiasData { float bias_data[]; };
layout(binding = 3) buffer OutputData { float output_data[]; };
layout(binding = 4) readonly buffer WeightScales { float weight_scales[]; };
layout(binding = 5) readonly buffer WeightZeroPoints { int weight_zps[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint in_channels;
    uint out_channels;
    uint h_in;
    uint w_in;
    uint h_out;
    uint w_out;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint dil_h;
    uint dil_w;
    uint groups;
    float input_scale;
    float weight_scale;
    int input_zero_point;
    int weight_zero_point;
    uint per_channel;       // 0 = per-tensor scalars, 1 = per-channel buffers
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch * params.out_channels * params.h_out * params.w_out;
    if (idx >= total) return;

    // Decompose linear index into (n, oc, oh, ow)
    uint temp = idx;
    uint ow = temp % params.w_out; temp /= params.w_out;
    uint oh = temp % params.h_out; temp /= params.h_out;
    uint oc = temp % params.out_channels;
    uint n  = temp / params.out_channels;

    // Grouped convolution: each output channel reads only its group's input
    // channels. Weight is laid out [out_channels, in_channels/groups, kh, kw].
    uint in_ch_per_group  = params.in_channels / params.groups;
    uint out_ch_per_group = params.out_channels / params.groups;
    uint group            = oc / out_ch_per_group;
    uint ic_start         = group * in_ch_per_group;

    // Per-channel weight scale / zero-point (each output channel oc).
    int w_zp = params.weight_zero_point;
    float w_scale = params.weight_scale;
    if (params.per_channel != 0u) {
        w_scale = weight_scales[oc];
        w_zp = weight_zps[oc];
    }

    int64_t acc = 0;
    int64_t sum_x = 0;
    int64_t sum_w = 0;
    int pad_count = 0;

    for (uint icg = 0; icg < in_ch_per_group; ++icg) {
        uint ic = ic_start + icg;  // absolute input channel
        for (uint kh = 0; kh < params.kernel_h; ++kh) {
            for (uint kw = 0; kw < params.kernel_w; ++kw) {
                int ih = int(oh * params.stride_h) - int(params.pad_h) + int(kh * params.dil_h);
                int iw = int(ow * params.stride_w) - int(params.pad_w) + int(kw * params.dil_w);

                if (ih >= 0 && ih < int(params.h_in) && iw >= 0 && iw < int(params.w_in)) {
                    uint input_idx = ((n * params.in_channels + ic) * params.h_in + uint(ih)) * params.w_in + uint(iw);
                    // Weight uses the group-local input-channel index (icg).
                    uint weight_idx = ((oc * in_ch_per_group + icg) * params.kernel_h + kh) * params.kernel_w + kw;

                    int64_t iv = int64_t(input_data[input_idx]);
                    int64_t wv = int64_t(weight_data[weight_idx]);
                    acc += iv * wv;
                    sum_x += iv;
                    sum_w += wv;
                } else {
                    pad_count++;
                }
            }
        }
    }

    // Zero-point correction for non-padded positions. K is the per-group
    // receptive field (in_channels_per_group * kernel_h * kernel_w).
    uint K = in_ch_per_group * params.kernel_h * params.kernel_w;
    acc = acc - int64_t(params.input_zero_point) * sum_w
              - int64_t(w_zp) * sum_x
              + int64_t(params.input_zero_point) * int64_t(w_zp)
                * int64_t(int(K) - pad_count);

    // Padded taps contribute exactly 0 (input is padded with the input zero-point,
    // so (input_zp - input_zp) * (w - weight_zp) == 0). They are correctly excluded
    // from acc/sum_x/sum_w and the (K - pad_count) term above, so no extra term is
    // added here — matching the CPU/CUDA references.

    // Dequantize to float and add bias
    float result = float(acc) * params.input_scale * w_scale;
    result += bias_data[oc];

    output_data[idx] = result;
}
