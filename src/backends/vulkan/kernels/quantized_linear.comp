#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Quantized Linear: Int8 GEMM with int64 accumulation, dequantize to Float32.
// The running total (and the input_zp*weight_zp*K correction term) can exceed
// INT32_MAX for wide layers, so accumulate in int64 to avoid silent wraparound,
// matching the CUDA quantized reference.
// Each thread computes one output element: output[b][o]
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputData { int8_t input_data[]; };
layout(binding = 1) buffer WeightData { int8_t weight_data[]; };
layout(binding = 2) buffer BiasData { float bias_data[]; };
layout(binding = 3) buffer OutputData { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint M;                 // batch_size
    uint N;                 // out_features
    uint K;                 // in_features
    float input_scale;
    float weight_scale;
    int input_zero_point;
    int weight_zero_point;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.M * params.N;
    if (idx >= total) return;

    uint b = idx / params.N;  // batch index
    uint o = idx % params.N;  // output feature index

    // Accumulate in int64
    int64_t acc = 0;
    int64_t sum_x = 0;
    int64_t sum_w = 0;

    uint input_base = b * params.K;
    uint weight_base = o * params.K;

    for (uint i = 0; i < params.K; ++i) {
        int64_t iv = int64_t(input_data[input_base + i]);
        int64_t wv = int64_t(weight_data[weight_base + i]);
        acc += iv * wv;
        sum_x += iv;
        sum_w += wv;
    }

    // Zero-point correction:
    // sum((x_i - x_zp) * (w_j - w_zp))
    //   = sum(x_i * w_j) - x_zp * sum(w_j) - w_zp * sum(x_i) + x_zp * w_zp * K
    acc = acc - int64_t(params.input_zero_point) * sum_w
              - int64_t(params.weight_zero_point) * sum_x
              + int64_t(params.input_zero_point) * int64_t(params.weight_zero_point) * int64_t(params.K);

    // Dequantize to float and add bias
    float result = float(acc) * params.input_scale * params.weight_scale;
    result += bias_data[o];

    output_data[idx] = result;
}
