#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// Scatter operation for Float64: scatter elements along specified dimension
// Uses CAS-loop atomics for thread-safe reductions on float64 values
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float64_t input_data[]; };       // Source data
layout(binding = 1) buffer Indices { int indices[]; };               // Scatter indices
layout(binding = 2) buffer Output { uint64_t output_data[]; };      // Destination (uint64_t for atomic CAS)
layout(binding = 3) buffer Values { float64_t values[]; };           // Values to scatter (optional)

layout(push_constant) uniform PushConstants {
    uint input_size;       // Size of input/indices
    uint output_size;      // Total output size
    uint dim;              // Dimension to scatter along
    uint dim_size;         // Size of the dimension being scattered to (output)
    uint input_dim_size;   // Size of the dimension in input/values tensor
    uint inner_size;       // Product of dimensions after dim
    uint outer_size;       // Product of dimensions before dim
    uint reduction;        // 0=none, 1=add, 2=multiply
    uint use_values;       // 0=use input_data, 1=use values buffer
} params;

// Bit-cast helpers between float64_t and uint64_t via standard GLSL pack/unpack
float64_t bitsToF64(uint64_t bits) {
    return float64_t(packDouble2x32(uvec2(uint(bits), uint(bits >> 32u))));
}

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

// Atomic add for float64 using compare-and-swap loop (bounded to prevent hangs)
void atomicAddF64(uint idx, float64_t val) {
    uint64_t old_bits = output_data[idx];
    uint64_t new_bits;
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float64_t old_val = bitsToF64(old_bits);
        new_bits = f64ToBits(old_val + val);
        uint64_t result = atomicCompSwap(output_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
    // Last-resort direct write (better than hanging indefinitely)
    output_data[idx] = new_bits;
}

// Atomic multiply for float64 using compare-and-swap loop (bounded to prevent hangs)
void atomicMulF64(uint idx, float64_t val) {
    uint64_t old_bits = output_data[idx];
    uint64_t new_bits;
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float64_t old_val = bitsToF64(old_bits);
        new_bits = f64ToBits(old_val * val);
        uint64_t result = atomicCompSwap(output_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
    // Last-resort direct write (better than hanging indefinitely)
    output_data[idx] = new_bits;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.input_size) {
        return;
    }

    // Decompose input index based on VALUES tensor shape
    uint outer_idx = idx / (params.inner_size * params.input_dim_size);
    uint remainder = idx % (params.inner_size * params.input_dim_size);
    uint inner_idx = remainder % params.inner_size;

    // Get the scatter destination index
    int scatter_idx = indices[idx];

    // Bounds check
    if (scatter_idx < 0 || scatter_idx >= int(params.dim_size)) {
        return;
    }

    // Compute output index
    uint out_idx = outer_idx * (params.dim_size * params.inner_size) +
                   uint(scatter_idx) * params.inner_size +
                   inner_idx;

    // Get value to scatter
    float64_t value;
    if (params.use_values > 0) {
        value = values[idx];
    } else {
        value = input_data[idx];
    }

    // Perform scatter with reduction
    if (params.reduction == 0) {
        // Direct assignment
        output_data[out_idx] = f64ToBits(value);
    } else if (params.reduction == 1) {
        // Atomic add via CAS loop
        atomicAddF64(out_idx, value);
    } else if (params.reduction == 2) {
        // Atomic multiply via CAS loop
        atomicMulF64(out_idx, value);
    }
}
