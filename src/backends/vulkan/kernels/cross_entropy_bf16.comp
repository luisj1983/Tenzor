#version 450

// Cross Entropy Loss for BFloat16
// BF16 packed buffers (2 BFloat16 per uint32), arithmetic in float32
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer LogProbs { uint log_probs[]; };     // Log probabilities (batch_size x num_classes), packed BF16
layout(binding = 1) buffer Targets { int targets[]; };          // Target class indices (batch_size)
layout(binding = 2) buffer Losses { uint losses[]; };           // Output losses (batch_size), packed BF16

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint reduction;  // 0=none, 1=mean, 2=sum
} params;

shared float shared_sum[WORKGROUP_SIZE];

// Read a single bfloat16 element from packed uint buffer
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = log_probs[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Write a single bfloat16 element to the losses buffer using atomic CAS.
// Adjacent samples idx and idx+1 share one 32-bit word and run concurrently,
// so a plain read-modify-write would clobber a neighbour's half-word. Use a
// bounded atomicCompSwap loop.
void writeBF16Loss(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_idx = element_idx % 2;
    uint fbits = floatBitsToUint(val);
    uint bits = ((fbits + 0x7FFFu + ((fbits >> 16) & 1u)) >> 16) & 0xFFFFu;
    uint shift = half_idx * 16;
    uint mask = 0xFFFFu << shift;

    uint old_val = losses[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        new_val = (expected & ~mask) | (bits << shift);
        old_val = atomicCompSwap(losses[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    // Saturation: do NOT add a non-atomic fallback store — it would clobber the
    // neighbouring packed half-word.
}

// Cross entropy for one sample: -log(p[target]), read from packed BF16.
float sample_loss(uint s_idx) {
    int target = targets[s_idx];
    if (target >= 0 && target < int(params.num_classes)) {
        return -readBF16(s_idx * params.num_classes + uint(target));
    }
    return 0.0;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;

    if (params.reduction == 0) {
        // No reduction: one loss element per sample. The host launches enough
        // workgroups to cover the batch, so use the global index directly.
        if (idx < params.batch_size) {
            writeBF16Loss(idx, sample_loss(idx));
        }
        return;
    }

    // Reduction (mean/sum): the host launches exactly ONE workgroup, so each
    // thread must block-stride over the whole batch before the tree reduction.
    // (Previously only samples with idx < WORKGROUP_SIZE were summed, so the
    // total under-counted while mean still divided by the full batch_size.)
    float acc = 0.0;
    for (uint i = tid; i < params.batch_size; i += WORKGROUP_SIZE) {
        acc += sample_loss(i);
    }
    shared_sum[tid] = acc;
    barrier();

    // Parallel tree reduction over the workgroup (spec-constant size).
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        float total = shared_sum[0];
        if (params.reduction == 1) { // mean
            total /= float(params.batch_size);
        }
        writeBF16Loss(0, total);
    }
}
