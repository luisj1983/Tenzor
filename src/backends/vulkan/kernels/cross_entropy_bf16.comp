#version 450

// Cross Entropy Loss for BFloat16
// BF16 packed buffers (2 BFloat16 per uint32), arithmetic in float32
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer LogProbs { uint log_probs[]; };     // Log probabilities (batch_size x num_classes), packed BF16
layout(binding = 1) buffer Targets { int targets[]; };          // Target class indices (batch_size)
layout(binding = 2) buffer Losses { uint losses[]; };           // Output losses (batch_size), packed BF16

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint reduction;  // 0=none, 1=mean, 2=sum
} params;

shared float shared_sum[WORKGROUP_SIZE];

// Read a single bfloat16 element from packed uint buffer
float readBF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = log_probs[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Write a single bfloat16 element to the losses buffer
void writeBF16Loss(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint bits = ((floatBitsToUint(val) + 0x7FFFu + ((floatBitsToUint(val) >> 16) & 1u)) >> 16);
    uint existing = losses[word_idx];
    uint mask = 0xFFFFu << (word_offset * 16);
    losses[word_idx] = (existing & ~mask) | (bits << (word_offset * 16));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;

    float loss_val = 0.0;

    if (idx < params.batch_size) {
        int target = targets[idx];
        if (target >= 0 && target < int(params.num_classes)) {
            // Cross entropy: -log(p[target])
            // Read from packed BF16, compute in float32
            float log_p = readBF16(idx * params.num_classes + uint(target));
            loss_val = -log_p;
        }
        writeBF16Loss(idx, loss_val);
    }

    // Reduction
    if (params.reduction > 0) {
        shared_sum[tid] = (idx < params.batch_size) ? loss_val : 0.0;
        barrier();

        // Parallel reduction in float32
        for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
            if (tid < s && (tid + s) < 256) {
                shared_sum[tid] += shared_sum[tid + s];
            }
            barrier();
        }

        if (tid == 0) {
            float total = shared_sum[0];
            if (params.reduction == 1) { // mean
                total /= float(params.batch_size);
            }
            // Store result in first element
            writeBF16Loss(0, total);
        }
    }
}
