#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// GRU Cell backward compute shader — Float64 variant
// Computes gradients for one timestep, recomputing forward activations
// from saved pre-activation gates.
//
// Inputs:
//   binding 0: grad_h — gradient from next layer [batch, hidden]
//   binding 1: gates_x — pre-activation input gates [batch, 3*hidden]
//   binding 2: gates_h — pre-activation hidden gates [batch, 3*hidden]
//   binding 3: h_prev — previous hidden state [batch, hidden]
// Outputs:
//   binding 4: grad_gates_x — gradient w.r.t. gates_x [batch, 3*hidden]
//   binding 5: grad_gates_h — gradient w.r.t. gates_h [batch, 3*hidden]
//   binding 6: grad_h_prev — gradient w.r.t. h_prev [batch, hidden]
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradH     { double grad_h[]; };
layout(binding = 1) buffer GatesX    { double gates_x[]; };
layout(binding = 2) buffer GatesH    { double gates_h[]; };
layout(binding = 3) buffer HPrev     { double h_prev[]; };
layout(binding = 4) buffer GradGX    { double grad_gates_x[]; };
layout(binding = 5) buffer GradGH    { double grad_gates_h[]; };
layout(binding = 6) buffer GradHPrev { double grad_h_prev[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint hidden_size;
} params;

// Double-precision exp using range reduction
double exp_d(double x) {
    if (x != x) return x;
    if (x > 709.0) return 1.0e308;
    if (x < -745.0) return 0.0;
    double ln2 = 0.6931471805599453;
    double k_dbl = floor(x / ln2 + 0.5);
    double r = x - k_dbl * ln2;
    int k = int(clamp(k_dbl, -1100.0, 1100.0));
    double exp_r = 1.0 + r * (1.0 + r * (0.5 + r * (1.0/6.0 + r * (1.0/24.0 + r * (1.0/120.0 +
        r * (1.0/720.0 + r * (1.0/5040.0 + r * (1.0/40320.0 + r * (1.0/362880.0 +
        r * (1.0/3628800.0 + r * (1.0/39916800.0 + r * (1.0/479001600.0))))))))))));
    double pow2 = 1.0;
    int abs_k = (k >= 0) ? k : -k;
    double base = 2.0;
    while (abs_k > 0) {
        if ((abs_k & 1) != 0) pow2 *= base;
        base *= base;
        abs_k >>= 1;
    }
    return (k >= 0) ? (exp_r * pow2) : (exp_r / pow2);
}

double tanh_d(double x) {
    if (x != x) return x;
    if (x > 20.0) return 1.0;
    if (x < -20.0) return -1.0;
    if (x >= -9.0 && x <= 9.0) return double(tanh(float(x)));
    double e2x = exp_d(2.0 * x);
    return (e2x - 1.0) / (e2x + 1.0);
}

double sigmoid_d(double x) {
    return 1.0 / (1.0 + exp_d(-x));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch_size * params.hidden_size;

    if (idx >= total) return;

    uint b = idx / params.hidden_size;
    uint h = idx % params.hidden_size;

    uint H = params.hidden_size;
    uint gate_base = b * (3 * H);

    // Indices into the gate arrays
    uint r_idx = gate_base + h;
    uint z_idx = gate_base + H + h;
    uint n_idx = gate_base + 2 * H + h;

    // ---- Recompute forward activations ----
    double r = sigmoid_d(gates_x[r_idx] + gates_h[r_idx]);
    double z = sigmoid_d(gates_x[z_idx] + gates_h[z_idx]);
    double gh_n = gates_h[n_idx];
    double n_combined = gates_x[n_idx] + r * gh_n;
    double n = tanh_d(n_combined);

    // ---- Backward through h_out = (1 - z) * n + z * h_prev ----
    double dh = grad_h[idx];
    double dn = dh * (1.0 - z);
    double dz = dh * (h_prev[idx] - n);
    double dh_p = dh * z;

    // ---- Backward through tanh: n = tanh(n_combined) ----
    double dn_comb = dn * (1.0 - n * n);

    // ---- Backward through n_combined = gx_n + r * gh_n ----
    double d_gx_n = dn_comb;
    double d_gh_n = dn_comb * r;
    double dr = dn_comb * gh_n;

    // ---- Backward through sigmoid gates ----
    double dz_raw = dz * z * (1.0 - z);
    double dr_raw = dr * r * (1.0 - r);

    // ---- Write grad_gates_x: [dr_raw, dz_raw, d_gx_n] ----
    grad_gates_x[r_idx] = dr_raw;
    grad_gates_x[z_idx] = dz_raw;
    grad_gates_x[n_idx] = d_gx_n;

    // ---- Write grad_gates_h: [dr_raw, dz_raw, d_gh_n] ----
    grad_gates_h[r_idx] = dr_raw;
    grad_gates_h[z_idx] = dz_raw;
    grad_gates_h[n_idx] = d_gh_n;

    // ---- Write grad_h_prev ----
    grad_h_prev[idx] = dh_p;
}
