#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Fused Adam optimizer step (Float64)
// Standard Adam with bias correction, optional weight decay (decoupled / L2),
// and optional AMSGrad.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { float64_t grad_data[]; };
layout(binding = 1) buffer Param { float64_t param_data[]; };
layout(binding = 2) buffer ExpAvg { float64_t exp_avg[]; };          // First moment (m)
layout(binding = 3) buffer ExpAvgSq { float64_t exp_avg_sq[]; };     // Second moment (v)
layout(binding = 4) buffer MaxExpAvgSq { float64_t max_exp_avg_sq[]; }; // AMSGrad max(v)

layout(push_constant) uniform PushConstants {
    uint numel;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
    float bias_correction1;  // 1 - beta1^t (precomputed on host)
    float bias_correction2_sqrt;  // sqrt(1 - beta2^t) (precomputed on host)
    uint decoupled;          // 0=L2, 1=decoupled (AdamW)
    uint amsgrad;            // 0=off, 1=on
    uint padding0;
    uint padding1;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.numel) return;

    float64_t g = grad_data[gid];
    float64_t p = param_data[gid];

    float64_t lr_d = float64_t(params.lr);
    float64_t beta1_d = float64_t(params.beta1);
    float64_t beta2_d = float64_t(params.beta2);
    float64_t eps_d = float64_t(params.eps);
    float64_t wd_d = float64_t(params.weight_decay);

    // Weight decay
    if (params.weight_decay > 0.0) {
        if (params.decoupled != 0) {
            // Decoupled weight decay (AdamW): subtract directly from param
            p -= lr_d * wd_d * p;
        } else {
            // L2 regularization: add to gradient
            g += wd_d * p;
        }
    }

    // Update first moment: m = beta1 * m + (1 - beta1) * g
    float64_t m = beta1_d * exp_avg[gid] + (1.0LF - beta1_d) * g;
    exp_avg[gid] = m;

    // Update second moment: v = beta2 * v + (1 - beta2) * g^2
    float64_t v = beta2_d * exp_avg_sq[gid] + (1.0LF - beta2_d) * g * g;
    exp_avg_sq[gid] = v;

    float64_t denom_v = v;
    if (params.amsgrad != 0) {
        // AMSGrad: use max of all past v
        float64_t max_v = max(max_exp_avg_sq[gid], v);
        max_exp_avg_sq[gid] = max_v;
        denom_v = max_v;
    }

    // Bias-corrected estimates
    float64_t bc1_d = float64_t(params.bias_correction1);
    float64_t bc2s_d = float64_t(params.bias_correction2_sqrt);
    float64_t m_hat = m / bc1_d;
    // Per docs/internals/attention-contract.md (optimizer F64 paths): never
    // downcast to float for sqrt — defeats the whole point of FP64 (audit C10
    // Vulkan). GLSL sqrt isn't overloaded for float64_t in the base spec, so
    // we Newton-Raphson refine a float-precision initial guess in F64:
    //   inv = 1 / sqrt(float(x));                    # float-precision guess
    //   inv = inv * (1.5 - 0.5 * x * inv * inv);     # one F64 NR iteration
    // The single iteration adds ~24 bits of precision (doubles each step), so
    // the result is accurate to ~48 bits of mantissa — well within F64's 52.
    // Two iterations would saturate at ~52 bits but are usually overkill.
    float64_t denom_v_d = denom_v;
    float64_t inv_sqrt = float64_t(1.0) / float64_t(sqrt(float(denom_v_d)));
    inv_sqrt = inv_sqrt * (float64_t(1.5) - float64_t(0.5) * denom_v_d * inv_sqrt * inv_sqrt);
    float64_t sqrt_denom = denom_v_d * inv_sqrt;  // x * (1/sqrt(x)) = sqrt(x), refined
    float64_t denom_d = sqrt_denom / bc2s_d + eps_d;

    p -= lr_d * m_hat / denom_d;
    param_data[gid] = p;
}
