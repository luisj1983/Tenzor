#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Fused Adadelta optimizer step for Float16 parameters
// Grad/param buffers are packed F16; square_avg/acc_delta are Float32 (master weights)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Grad { uint grad_data[]; };            // Packed F16
layout(binding = 1) buffer Param { uint param_data[]; };          // Packed F16
layout(binding = 2) buffer SquareAvg { float square_avg[]; };     // Float32
layout(binding = 3) buffer AccDelta { float acc_delta[]; };       // Float32

layout(push_constant) uniform PushConstants {
    uint numel;
    float lr;
    float rho;
    float eps;
    float weight_decay;
    uint padding0;
    uint padding1;
    uint padding2;
} params;

float readF16(uint flat_idx, uint buf_sel) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed;
    if (buf_sel == 0) packed = grad_data[word_idx];
    else packed = param_data[word_idx];
    return (half_idx == 0) ? unpackHalf2x16(packed).x : unpackHalf2x16(packed >> 16).x;
}

float adadeltaStep(uint idx) {
    float g = readF16(idx, 0);
    float p = readF16(idx, 1);

    if (params.weight_decay > 0.0) {
        g += params.weight_decay * p;
    }

    float sq = params.rho * square_avg[idx] + (1.0 - params.rho) * g * g;
    square_avg[idx] = sq;

    float std_delta = sqrt(acc_delta[idx] + params.eps);
    float std_grad = sqrt(sq + params.eps);
    float delta = std_delta / std_grad * g;

    acc_delta[idx] = params.rho * acc_delta[idx] + (1.0 - params.rho) * delta * delta;

    p -= params.lr * delta;
    return p;
}

void main() {
    uint word_idx = gl_GlobalInvocationID.x;
    uint num_words = (params.numel + 1) / 2;
    if (word_idx >= num_words) return;

    uint elem0 = word_idx * 2;
    uint elem1 = word_idx * 2 + 1;

    float p0 = 0.0, p1 = 0.0;

    if (elem0 < params.numel) {
        p0 = adadeltaStep(elem0);
    }
    if (elem1 < params.numel) {
        p1 = adadeltaStep(elem1);
    }

    uint bits0 = packHalf2x16(vec2(p0, 0.0)) & 0xFFFFu;
    uint bits1 = packHalf2x16(vec2(p1, 0.0)) & 0xFFFFu;
    param_data[word_idx] = bits0 | (bits1 << 16);
}
