#version 450

// Conv2d Backward Input - Gradient w.r.t. input
// Supports grouped convolutions (including depthwise where groups == channels)
//
// Algorithm: For each input pixel (ih, iw), accumulate gradients from all
// output positions that used it during forward pass.
// With groups: each input channel only connects to output channels in same group.

layout(local_size_x = 256) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C_out, H_out, W_out)
layout(binding = 1) buffer Weight { float weight[]; };           // (C_out, C_in/groups, K_h, K_w)
layout(binding = 2) buffer GradInput { float grad_input[]; };    // (N, C_in, H_in, W_in)

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels_in;
    uint channels_out;
    uint height_in;
    uint width_in;
    uint height_out;
    uint width_out;
    uint kernel_h;
    uint kernel_w;
    uint stride;
    uint padding;
    uint dilation;
    uint groups;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_elements = params.batch * params.channels_in * params.height_in * params.width_in;

    if (idx >= total_elements) {
        return;
    }

    // Decode flat index to (b, c_in, ih, iw)
    uint temp = idx;
    uint iw = temp % params.width_in;
    temp /= params.width_in;
    uint ih = temp % params.height_in;
    temp /= params.height_in;
    uint c_in = temp % params.channels_in;
    uint b = temp / params.channels_in;

    // Grouped convolution parameters
    uint in_channels_per_group = params.channels_in / params.groups;
    uint out_channels_per_group = params.channels_out / params.groups;
    uint group = c_in / in_channels_per_group;
    uint c_in_local = c_in % in_channels_per_group;  // channel index within group

    // Output channels for this group
    uint c_out_start = group * out_channels_per_group;
    uint c_out_end = c_out_start + out_channels_per_group;

    // Accumulate gradient from all kernel positions that used this input pixel
    float sum = 0.0;

    // Iterate through all kernel positions
    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            // Reverse the forward mapping: given input (ih, iw) and kernel (kh, kw),
            // find which output position (oh, ow) used this input
            int ih_shifted = int(ih) + int(params.padding) - int(kh * params.dilation);
            int iw_shifted = int(iw) + int(params.padding) - int(kw * params.dilation);

            // Check if this maps to a valid output position (must be divisible by stride)
            if (ih_shifted % int(params.stride) == 0 && iw_shifted % int(params.stride) == 0) {
                int oh = ih_shifted / int(params.stride);
                int ow = iw_shifted / int(params.stride);

                // Check bounds
                if (oh >= 0 && oh < int(params.height_out) &&
                    ow >= 0 && ow < int(params.width_out)) {

                    // Only iterate over output channels in the same group
                    for (uint c_out = c_out_start; c_out < c_out_end; c_out++) {
                        // grad_output index: [b][c_out][oh][ow]
                        uint grad_out_idx = ((b * params.channels_out + c_out) * params.height_out + uint(oh)) * params.width_out + uint(ow);

                        // weight index: [c_out][c_in_local][kh][kw]
                        // Weight shape is (C_out, C_in/groups, K_h, K_w)
                        uint weight_idx = ((c_out * in_channels_per_group + c_in_local) * params.kernel_h + kh) * params.kernel_w + kw;

                        sum += grad_output[grad_out_idx] * weight[weight_idx];
                    }
                }
            }
        }
    }

    // Write gradient to output
    grad_input[idx] = sum;
}
