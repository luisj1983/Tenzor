#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Sparse triangular solve: L*X = B (lower) or U*X = B (upper) -- Float64
// Same algorithm as sparse_trsm.comp but with double precision.
//
// Single-workgroup SEQUENTIAL row substitution, threads parallel across RHS
// columns. The previous N-workgroup design spin-waited on solved[] across
// workgroups, which deadlocks under Vulkan's lack of cross-workgroup
// forward-progress (the same hazard sparse_trsv was fixed to remove). Rows are
// now processed in strict dependency order from one workgroup, with a barrier()
// between rows so each row's writes are visible to later rows; solved[] is gone.

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer RowOffsets { int row_offsets[]; };
layout(set = 0, binding = 1) readonly buffer ColIndices { int col_indices[]; };
layout(set = 0, binding = 2) readonly buffer Values     { float64_t values[]; };
layout(set = 0, binding = 3) readonly buffer RHS        { float64_t B[];      };
layout(set = 0, binding = 4) buffer Output              { float64_t X[];      };
// Retained for descriptor-set compatibility with the host (now unused).
layout(set = 0, binding = 5) buffer SolvedCounter        { int solved[];       };

layout(push_constant) uniform PushConstants {
    uint n;
    uint k_rhs;
    uint upper;
};

void solve_row(uint row, uint tid) {
    uint rs = uint(row_offsets[row]);
    uint re = uint(row_offsets[row + 1u]);
    for (uint c = tid; c < k_rhs; c += gl_WorkGroupSize.x) {
        float64_t rhs = B[row * k_rhs + c];
        float64_t diag = 1.0lf;
        for (uint i = rs; i < re; i++) {
            uint col = uint(col_indices[i]);
            if (col == row) {
                diag = values[i];
            } else {
                rhs -= values[i] * X[col * k_rhs + c];
            }
        }
        X[row * k_rhs + c] = rhs / diag;
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;

    if (upper == 0u) {
        for (uint row = 0u; row < n; row++) {
            solve_row(row, tid);
            barrier();
        }
    } else {
        for (uint t = 0u; t < n; t++) {
            solve_row(n - 1u - t, tid);
            barrier();
        }
    }
}
