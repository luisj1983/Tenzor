#version 450

// Average Pooling 1D Forward Pass
// Computes average over pooling window
// Supports count_include_pad parameter

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };    // (N, C, L)
layout(binding = 1) buffer Output { float output_data[]; };  // (N, C, L_out)

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output elements (N * C * L_out)
    uint batch;               // N
    uint channels;            // C
    uint in_length;           // L
    uint out_length;          // L_out
    uint kernel_size;         // Kernel size
    uint stride;              // Stride
    uint padding;             // Padding
    uint count_include_pad;   // 1 to include padding in average, 0 otherwise
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Bounds check
    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, l_out)
    uint temp = idx;
    uint l_out = temp % params.out_length;
    temp /= params.out_length;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Compute input window start
    int l_start = int(l_out * params.stride) - int(params.padding);

    // Accumulate sum and count
    float sum = 0.0;
    uint count = 0;

    // Iterate over pooling window
    for (uint k = 0; k < params.kernel_size; k++) {
        int l_in = l_start + int(k);

        // Check if within input bounds
        if (l_in >= 0 && l_in < int(params.in_length)) {
            // Compute input index: (n, c, l_in)
            uint input_idx = n * params.channels * params.in_length +
                            c * params.in_length +
                            uint(l_in);

            sum += input_data[input_idx];
            count++;
        } else if (params.count_include_pad != 0) {
            // Include padding in count (but not in sum)
            count++;
        }
    }

    // Compute average
    float result = 0.0;
    if (count > 0) {
        result = sum / float(count);
    }

    // Write output
    output_data[idx] = result;
}
