#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_ARB_gpu_shader_fp64 : enable

// Cross product along a dimension for Float64
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { double a_buf[]; };
layout(binding = 1) buffer InputB { double b_buf[]; };
layout(binding = 2) buffer Output { double result[]; };

layout(push_constant) uniform PushConstants {
    uint num_pairs;
    uint dim_stride;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_pairs) return;

    uint o = idx / params.dim_stride;
    uint i = idx % params.dim_stride;
    uint base = o * 3 * params.dim_stride + i;

    double a0 = a_buf[base];
    double a1 = a_buf[base + params.dim_stride];
    double a2 = a_buf[base + 2 * params.dim_stride];
    double b0 = b_buf[base];
    double b1 = b_buf[base + params.dim_stride];
    double b2 = b_buf[base + 2 * params.dim_stride];

    result[base]                           = a1*b2 - a2*b1;
    result[base + params.dim_stride]       = a2*b0 - a0*b2;
    result[base + 2 * params.dim_stride]   = a0*b1 - a1*b0;
}
