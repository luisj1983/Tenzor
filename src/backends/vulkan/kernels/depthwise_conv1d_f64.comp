#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Depthwise Conv1d forward (groups == channels), native Float64.
// Contract: input [N,C,1,L] (H==1), weight [C,1,1,kL], output [N,C,1,L_out].
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InBuf  { float64_t input_data[]; };
layout(binding = 1) buffer WBuf   { float64_t weight_data[]; };
layout(binding = 2) buffer BBuf   { float64_t bias_data[]; };
layout(binding = 3) buffer OutBuf { float64_t output_data[]; };

layout(push_constant) uniform PC {
    uint n_elements;
    uint N;
    uint C;
    uint L;
    uint kL;
    uint stride;
    uint pad;
    uint dil;
    uint Lo;
    uint has_bias;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.n_elements) return;

    uint ol = idx % p.Lo;
    uint c  = (idx / p.Lo) % p.C;
    uint n  = idx / (p.C * p.Lo);

    uint in_base = (n * p.C + c) * p.L;
    uint w_base  = c * p.kL;

    float64_t acc = (p.has_bias != 0u) ? bias_data[c] : 0.0LF;
    for (uint k = 0u; k < p.kL; ++k) {
        int il = int(ol) * int(p.stride) - int(p.pad) + int(k) * int(p.dil);
        if (il >= 0 && il < int(p.L)) {
            acc += input_data[in_base + uint(il)] * weight_data[w_base + k];
        }
    }
    output_data[(n * p.C + c) * p.Lo + ol] = acc;
}
