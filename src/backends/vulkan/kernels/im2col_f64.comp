#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Im2col (Unfold) operation — Float64 variant
// Transforms (N,C,H,W) → (N, C*K_h*K_w, L) where L=out_h*out_w
// HH.6: per-axis kernel/stride/padding/dilation.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { double input_data[]; };
layout(binding = 1) buffer Output { double output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;    // Total elements to process
    uint batch;
    uint channels;
    uint height;
    uint width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint pad_h;
    uint pad_w;
    uint dil_h;
    uint dil_w;
    uint out_h;
    uint out_w;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Calculate derived values
    uint num_blocks = params.out_h * params.out_w;

    // Decode flat index to (b, c, kh, kw, block_idx)
    uint temp = idx;
    uint block_idx = temp % num_blocks; temp /= num_blocks;
    uint kw = temp % params.kernel_w; temp /= params.kernel_w;
    uint kh = temp % params.kernel_h; temp /= params.kernel_h;
    uint c = temp % params.channels; temp /= params.channels;
    uint b = temp;

    // Calculate output position from block_idx
    uint oh = block_idx / params.out_w;
    uint ow = block_idx % params.out_w;

    // Calculate input position with padding and dilation
    int ih = int(oh * params.stride_h) - int(params.pad_h) + int(kh * params.dil_h);
    int iw = int(ow * params.stride_w) - int(params.pad_w) + int(kw * params.dil_w);

    // Column index in output: (c * K_h * K_w + kh * K_w + kw)
    uint col_c = c * params.kernel_h * params.kernel_w +
                 kh * params.kernel_w + kw;

    // Output index: (b, col_c, block_idx)
    uint output_idx = b * (params.channels * params.kernel_h * params.kernel_w * num_blocks) +
                      col_c * num_blocks +
                      block_idx;

    // Check bounds and apply padding
    if (ih >= 0 && ih < int(params.height) && iw >= 0 && iw < int(params.width)) {
        uint input_idx = b * (params.channels * params.height * params.width) +
                        c * (params.height * params.width) +
                        uint(ih) * params.width + uint(iw);
        output_data[output_idx] = input_data[input_idx];
    } else {
        output_data[output_idx] = 0.0;  // Padding with zeros
    }
}
