#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Nearest Neighbor Interpolation Forward Pass for Float16
// Reads packed F16 pairs, copies nearest neighbor value
// Input shape: (N, C, H_in, W_in)
// Output shape: (N, C, H_out, W_out)

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };    // Packed F16
layout(binding = 1) buffer Output { uint output_data[]; };  // Packed F16

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Total output elements
    uint batch;          // N
    uint channels;       // C
    uint in_height;      // H_in
    uint in_width;       // W_in
    uint out_height;     // H_out
    uint out_width;      // W_out
    uint align_corners;  // 1 if align_corners, 0 otherwise
} params;

float readF16Element(uint flat_idx) {
    uint word_idx = flat_idx / 2;
    uint half_idx = flat_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (half_idx * 16)) & 0xFFFFu;
    return float(float16_t(unpackHalf2x16(bits | (bits << 16)).x));
}

void writeF16Element(uint flat_idx, float val) {
    uint word_idx = flat_idx / 2;
    uint half_offset = (flat_idx % 2) * 16;
    uint new_bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 1024; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Compute nearest source coordinates
    uint h_in, w_in;
    if (params.align_corners != 0 && params.out_height > 1) {
        h_in = uint(round(float(h_out) * float(params.in_height - 1) / float(params.out_height - 1)));
    } else {
        h_in = min(uint(floor(float(h_out) * float(params.in_height) / float(params.out_height))),
                   params.in_height - 1);
    }

    if (params.align_corners != 0 && params.out_width > 1) {
        w_in = uint(round(float(w_out) * float(params.in_width - 1) / float(params.out_width - 1)));
    } else {
        w_in = min(uint(floor(float(w_out) * float(params.in_width) / float(params.out_width))),
                   params.in_width - 1);
    }

    // Compute input index: (n, c, h_in, w_in)
    uint input_idx = n * params.channels * params.in_height * params.in_width +
                     c * params.in_height * params.in_width +
                     h_in * params.in_width +
                     w_in;

    float val = readF16Element(input_idx);
    writeF16Element(idx, val);
}
