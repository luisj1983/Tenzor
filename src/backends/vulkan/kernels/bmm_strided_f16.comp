#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Strided batched matrix multiplication with tiling for Float16
// C[b, :, :] = A[b, :, :] @ B[b, :, :]
// F16 packed buffers (2 Float16 per uint32), all arithmetic in float32.
// A: (batch, M, K), B: (batch, K, N), C: (batch, M, N)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer MatrixA { uint a[]; };
layout(binding = 1) buffer MatrixB { uint b[]; };
layout(binding = 2) buffer MatrixC { uint c[]; };

layout(push_constant) uniform PushConstants {
    uint batch;  // batch size
    uint M;      // rows of A
    uint N;      // cols of B
    uint K;      // cols of A / rows of B
    // A strides (in elements)
    uint a_stride0;  // batch stride
    uint a_stride1;  // row stride
    uint a_stride2;  // col stride
    // B strides (in elements)
    uint b_stride0;  // batch stride
    uint b_stride1;  // row stride
    uint b_stride2;  // col stride
} params;

shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint batch_idx = gl_GlobalInvocationID.z;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    bool in_bounds = (batch_idx < params.batch && row < params.M && col < params.N);

    // Base offsets for this batch (using strides, in elements)
    uint a_base = batch_idx * params.a_stride0;
    uint b_base = batch_idx * params.b_stride0;

    // Output is always contiguous
    uint c_batch_stride = params.M * params.N;
    uint c_base = batch_idx * c_batch_stride;

    float sum = 0.0;

    // Tile-based computation
    uint num_tiles = (params.K + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from A using strides
        uint a_col = t * 16 + local_col;
        if (batch_idx < params.batch && row < params.M && a_col < params.K) {
            uint a_elem = a_base + row * params.a_stride1 + a_col * params.a_stride2;
            uint a_word = a_elem / 2;
            uint a_off = a_elem % 2;
            uint a_packed = a[a_word];
            uint a_bits = (a_packed >> (a_off * 16)) & 0xFFFFu;
            tileA[local_row][local_col] = unpackHalf2x16(a_bits | (a_bits << 16)).x;
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from B using strides
        uint b_row = t * 16 + local_row;
        if (batch_idx < params.batch && b_row < params.K && col < params.N) {
            uint b_elem = b_base + b_row * params.b_stride1 + col * params.b_stride2;
            uint b_word = b_elem / 2;
            uint b_off = b_elem % 2;
            uint b_packed = b[b_word];
            uint b_bits = (b_packed >> (b_off * 16)) & 0xFFFFu;
            tileB[local_row][local_col] = unpackHalf2x16(b_bits | (b_bits << 16)).x;
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        // Compute partial dot product in float32
        for (uint k = 0; k < 16; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    // Write result (output is always contiguous, packed F16)
    if (in_bounds) {
        uint out_elem = c_base + row * params.N + col;
        uint out_word = out_elem / 2;
        uint out_off = out_elem % 2;
        uint bits = packHalf2x16(vec2(sum, 0.0)) & 0xFFFFu;
        // Read-modify-write for packed output
        uint existing = c[out_word];
        uint mask = 0xFFFFu << (out_off * 16);
        uint new_word = (existing & ~mask) | (bits << (out_off * 16));
        c[out_word] = new_word;
    }
}
