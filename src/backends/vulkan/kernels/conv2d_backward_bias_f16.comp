#version 450

// Conv2d Backward Bias - Gradient w.r.t. bias (Float16 version)
// Sum grad_output across batch, height, and width for each output channel
// Accumulates in float32 for numerical stability

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };  // Packed F16: (N, C_out, H_out, W_out)
layout(binding = 1) buffer GradBias { uint grad_bias[]; };      // Packed F16: (C_out)

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels_out;
    uint height_out;
    uint width_out;
} params;

float readF16(uint element_idx) {
    uint word_idx = element_idx >> 1u;
    uint packed = grad_output[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return ((element_idx & 1u) == 0u) ? pair.x : pair.y;
}

void writeF16(uint element_idx, float value) {
    uint word_idx = element_idx >> 1u;
    uint word_offset = element_idx & 1u;
    uint new_bits = packHalf2x16(vec2(value, 0.0)) & 0xFFFFu;
    uint shift = word_offset * 16u;
    uint mask = 0xFFFFu << shift;

    uint old_val = grad_bias[word_idx];
    for (uint iter = 0u; iter < 64u; iter++) {
        uint expected = old_val;
        uint new_val = (expected & ~mask) | (new_bits << shift);
        old_val = atomicCompSwap(grad_bias[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
    uint cur = grad_bias[word_idx];
    grad_bias[word_idx] = (cur & ~mask) | (new_bits << shift);
}

void main() {
    uint c = gl_GlobalInvocationID.x;

    if (c >= params.channels_out) {
        return;
    }

    // Accumulate in float32
    float sum = 0.0;

    for (uint b = 0; b < params.batch; b++) {
        for (uint h = 0; h < params.height_out; h++) {
            for (uint w = 0; w < params.width_out; w++) {
                uint idx = ((b * params.channels_out + c) * params.height_out + h) * params.width_out + w;
                sum += readF16(idx);
            }
        }
    }

    writeF16(c, sum);
}
