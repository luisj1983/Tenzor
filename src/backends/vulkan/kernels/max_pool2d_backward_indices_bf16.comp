#version 450
#extension GL_EXT_shader_atomic_float : enable

// Max Pooling 2D Backward Pass for BFloat16 using pre-computed indices
// We work in float32 for the atomic operations, then pack back to bfloat16
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };   // Packed bfloat16 pairs
layout(binding = 1) buffer Indices { int indices_data[]; };      // Int32 argmax indices (forward stores Int32)
layout(binding = 2) buffer GradInput { float grad_input[]; };    // Work in float32 for atomic ops

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint grad_input_size;
    uint out_plane;   // H_out * W_out
    uint in_plane;    // H * W
} params;

// Convert bfloat16 (low 16 bits) to float32 by zero-extending the mantissa.
float bf16_to_float(uint bits) {
    return uintBitsToFloat((bits & 0xFFFFu) << 16);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    // Read gradient from packed bfloat16
    uint grad_word_idx = idx / 2;
    uint grad_half_idx = idx % 2;
    uint grad_packed = grad_output[grad_word_idx];
    uint grad_half = (grad_half_idx == 0) ? (grad_packed & 0xFFFFu) : (grad_packed >> 16);
    float grad = bf16_to_float(grad_half);

    // Plane-local index (in_y*W + in_x) -> global offset via the (n,c) plane base.
    int plane_local = indices_data[idx];
    uint nc = idx / params.out_plane;
    int target_idx = int(nc * params.in_plane) + plane_local;

    if (target_idx >= 0 && target_idx < int(params.grad_input_size)) {
        atomicAdd(grad_input[target_idx], grad);
    }
}
