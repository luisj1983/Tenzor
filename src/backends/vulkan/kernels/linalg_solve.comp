#version 450

// Solve AX = B via LU factorization for small matrices (<= 32x32).
// Each workgroup solves one system in the batch and supports nrhs columns
// of B by applying forward/back substitution per column after a shared
// LU factorization.

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer MatrixA { float a_data[]; };
layout(set = 0, binding = 1) buffer MatrixB { float b_data[]; };
layout(set = 0, binding = 2) buffer OutputX { float x_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;      // Matrix dimension
    uint batch;  // Batch size
    uint nrhs;   // Number of right-hand sides
};

shared float mat[32][32];
shared float rhs[32][32];   // up to 32 RHS columns
shared uint  piv[32];

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;

    if (batch_idx >= batch) return;

    uint a_offset = batch_idx * n * n;
    uint b_offset = batch_idx * n * nrhs;

    // Load matrix and all RHS columns. B is row-major (N, nrhs).
    for (uint row = 0; row < n; row++) {
        if (tid < n) {
            mat[row][tid] = a_data[a_offset + row * n + tid];
        }
        if (tid < nrhs) {
            rhs[row][tid] = b_data[b_offset + row * nrhs + tid];
        }
    }
    if (tid < n) piv[tid] = tid;
    barrier();

    // LU factorization with partial pivoting (serialized in thread 0).
    for (uint col = 0; col < n; col++) {
        if (tid == 0) {
            uint max_row = col;
            float max_val = abs(mat[col][col]);
            for (uint row = col + 1; row < n; row++) {
                float val = abs(mat[row][col]);
                if (val > max_val) { max_val = val; max_row = row; }
            }
            piv[col] = max_row;
            if (max_row != col) {
                for (uint j = 0; j < n; j++) {
                    float tmp = mat[col][j];
                    mat[col][j] = mat[max_row][j];
                    mat[max_row][j] = tmp;
                }
                for (uint k = 0; k < nrhs; k++) {
                    float tmp = rhs[col][k];
                    rhs[col][k] = rhs[max_row][k];
                    rhs[max_row][k] = tmp;
                }
            }
        }
        barrier();

        if (tid > col && tid < n) {
            float pivot = mat[col][col];
            if (abs(pivot) > 1e-30) {
                float factor = mat[tid][col] / pivot;
                mat[tid][col] = factor;
                for (uint j = col + 1; j < n; j++) {
                    mat[tid][j] -= factor * mat[col][j];
                }
                for (uint k = 0; k < nrhs; k++) {
                    rhs[tid][k] -= factor * rhs[col][k];
                }
            }
        }
        barrier();
    }

    // Back substitution per RHS column.
    if (tid == 0) {
        for (uint k = 0; k < nrhs; k++) {
            for (int i = int(n) - 1; i >= 0; i--) {
                float sum = rhs[i][k];
                for (uint j = uint(i) + 1; j < n; j++) {
                    sum -= mat[i][j] * rhs[j][k];
                }
                if (abs(mat[i][i]) > 1e-30) {
                    rhs[i][k] = sum / mat[i][i];
                } else {
                    rhs[i][k] = 0.0;
                }
            }
        }
    }
    barrier();

    // Write output X (row-major N x nrhs).
    for (uint row = 0; row < n; row++) {
        if (tid < nrhs) {
            x_data[b_offset + row * nrhs + tid] = rhs[row][tid];
        }
    }
}
