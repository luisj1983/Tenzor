#version 450

// MaxPool2d forward pass with index tracking for backward pass
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };
layout(binding = 2) buffer Indices { int max_indices[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint in_height;
    uint in_width;
    uint out_height;
    uint out_width;
    uint kernel_h;
    uint kernel_w;
    uint stride_h;
    uint stride_w;
    uint padding_h;
    uint padding_w;
    uint dilation_h;
    uint dilation_w;
} params;

void main() {
    uint out_x = gl_GlobalInvocationID.x;
    uint out_y = gl_GlobalInvocationID.y;
    // The z dim encodes (batch, channel) packed as b*channels + c, so a
    // single dispatch covers every (n, c, h_out, w_out) cell. The previous
    // host-side `for (b = 0..batch-1) vkCmdDispatch(...)` loop dispatched
    // the same work N times without offsetting the bindings, so every
    // batch iteration overwrote batch 0's output region and batches 1..N-1
    // were left uninitialized — a silent batch>1 correctness bug.
    uint bc = gl_GlobalInvocationID.z;
    uint c = bc % params.channels;
    uint b = bc / params.channels;

    if (out_x >= params.out_width || out_y >= params.out_height ||
        c >= params.channels || b >= params.batch) {
        return;
    }

    float max_val = -1.0 / 0.0; // -infinity
    int max_idx = -1;

    uint input_batch_base  = b * params.channels * params.in_height  * params.in_width;
    uint output_batch_base = b * params.channels * params.out_height * params.out_width;

    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int in_y = int(out_y * params.stride_h) - int(params.padding_h) + int(kh) * int(params.dilation_h);
            int in_x = int(out_x * params.stride_w) - int(params.padding_w) + int(kw) * int(params.dilation_w);

            if (in_y >= 0 && in_y < int(params.in_height) &&
                in_x >= 0 && in_x < int(params.in_width)) {
                uint input_idx = input_batch_base +
                                c * params.in_height * params.in_width +
                                uint(in_y) * params.in_width + uint(in_x);
                float value = input_data[input_idx];

                if (value > max_val) {
                    max_val = value;
                    // Plane-local index (in_y*W + in_x): matches CPU/PyTorch and
                    // max_unpool; the backward reconstructs the global offset.
                    max_idx = int(uint(in_y) * params.in_width + uint(in_x));
                }
            }
        }
    }

    // Write output
    uint output_idx = output_batch_base +
                     c * params.out_height * params.out_width +
                     out_y * params.out_width + out_x;
    output_data[output_idx] = max_val;
    max_indices[output_idx] = max_idx;
}
