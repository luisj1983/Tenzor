#version 450

// ScatterReduce: scatter source values into output along a dimension with reduction.
// Modes (push constant): 0=sum, 1=prod, 2=mean(sum pass), 3=amax, 4=amin
// Uses CAS-loop atomics for thread-safe float operations.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint out_data[]; };       // Output (uint for CAS atomics)
layout(binding = 1) buffer Source { float src_data[]; };       // Source values
layout(binding = 2) buffer Index  { int idx_data[]; };         // 1-D index tensor (int32)
layout(binding = 3) buffer Counts { int count_data[]; };       // Count buffer (for mean mode)

layout(push_constant) uniform PushConstants {
    uint n;                 // index.numel()
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uint mode;              // 0=sum, 1=prod, 2=mean, 3=amax, 4=amin
    uint pad0;
    uint pad1;
    uint pad2;
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

// Atomic add for float using compare-and-swap loop
void atomicAddFloat(uint pos, float val) {
    uint old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        uint new_bits = floatBitsToUint(old_val + val);
        uint result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

// Atomic mul for float using compare-and-swap loop
void atomicMulFloat(uint pos, float val) {
    uint old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        uint new_bits = floatBitsToUint(old_val * val);
        uint result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

// Atomic max for float using compare-and-swap loop
void atomicMaxFloat(uint pos, float val) {
    uint old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        if (val <= old_val) return;
        uint new_bits = floatBitsToUint(val);
        uint result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

// Atomic min for float using compare-and-swap loop
void atomicMinFloat(uint pos, float val) {
    uint old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float old_val = uintBitsToFloat(old_bits);
        if (val >= old_val) return;
        uint new_bits = floatBitsToUint(val);
        uint result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= params.n) return;

    int dest_idx = idx_data[tid];
    if (dest_idx < 0) dest_idx += int(params.dim_size);
    if (dest_idx < 0 || dest_idx >= int(params.dim_size)) return;

    // Per-dim decode of the flat index position, recomposed onto self strides.
    uint temp = tid;
    uint out_pos = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_pos += uint(dest_idx) * selfStride(d);
        } else {
            out_pos += coord * selfStride(d);
        }
    }

    float val = src_data[tid];

    if (params.mode == 0u || params.mode == 2u) {
        // sum / mean (sum pass)
        atomicAddFloat(out_pos, val);
        if (params.mode == 2u) {
            atomicAdd(count_data[out_pos], 1);
        }
    } else if (params.mode == 1u) {
        atomicMulFloat(out_pos, val);
    } else if (params.mode == 3u) {
        atomicMaxFloat(out_pos, val);
    } else if (params.mode == 4u) {
        atomicMinFloat(out_pos, val);
    }
}
