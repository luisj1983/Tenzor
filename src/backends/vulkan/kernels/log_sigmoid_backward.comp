#version 450

// LogSigmoid backward pass
// output = grad * sig_neg_x
// where sig_neg_x = (x >= 0) ? exp(-x)/(1+exp(-x)) : 1/(1+exp(x))
// This is equivalent to: sigmoid(-x) = 1 - sigmoid(x)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer GradOutput { float data[]; } grad_buf;
layout(set = 0, binding = 1) readonly buffer InputBuffer { float data[]; } input_buf;
layout(set = 0, binding = 2) writeonly buffer GradInput { float data[]; } grad_input_buf;

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;

    float g = grad_buf.data[idx];
    float x = input_buf.data[idx];

    // Numerically stable sigmoid(-x)
    float sig_neg_x;
    if (x >= 0.0) {
        float e = exp(-x);
        sig_neg_x = e / (1.0 + e);
    } else {
        sig_neg_x = 1.0 / (1.0 + exp(x));
    }

    grad_input_buf.data[idx] = g * sig_neg_x;
}
