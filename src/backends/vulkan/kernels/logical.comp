#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable

// Logical operations: and, or, not, xor
// Inputs treated as Bool (nonzero = true), output is uint8_t Bool
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer InputA { uint8_t a[]; };
layout(binding = 1) buffer InputB { uint8_t b[]; };
layout(binding = 2) buffer Output { uint8_t result[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint op;         // Operation: 0=and, 1=or, 2=not (ignores b), 3=xor
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    bool val_a = (a[idx] != uint8_t(0));
    bool val_b = (b[idx] != uint8_t(0));

    uint8_t result_val;
    switch (params.op) {
        case 0: // logical_and
            result_val = (val_a && val_b) ? uint8_t(1) : uint8_t(0);
            break;
        case 1: // logical_or
            result_val = (val_a || val_b) ? uint8_t(1) : uint8_t(0);
            break;
        case 2: // logical_not (unary, ignores b)
            result_val = (!val_a) ? uint8_t(1) : uint8_t(0);
            break;
        case 3: // logical_xor
            result_val = (val_a != val_b) ? uint8_t(1) : uint8_t(0);
            break;
        default:
            result_val = uint8_t(0);
            break;
    }

    result[idx] = result_val;
}
