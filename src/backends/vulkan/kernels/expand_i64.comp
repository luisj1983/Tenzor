#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Expand operation: broadcast tensor to larger size (Int64 variant).
// Identical to expand.comp but with int64_t element type — needed because
// the default expand shader's `float input_data[]` declaration has 4-byte
// stride, so routing Int64 tensors through it reads/writes the wrong bytes
// (bug surfaced as MoE routing divergence on Vulkan).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input  { int64_t input_data[];  };
layout(binding = 1) buffer Output { int64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;        // Total output elements
    uint input_ndim;        // Input dimensions
    uint output_ndim;       // Output dimensions
    uint input_shape[8];    // Input shape (max 8 dims)
    uint output_shape[8];   // Output shape (max 8 dims)
    uint input_strides[8];  // Input strides for indexing
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    // Reject rank >8: push-constant shape/stride arrays hold at most 8 dims;
    // a higher rank would read the uninitialized tail and index OOB. The host
    // (dispatchExpand) also rejects this.
    if (params.output_ndim > 8u || params.input_ndim > 8u) return;

    uint out_indices[8];
    uint temp = idx;
    for (int i = int(params.output_ndim) - 1; i >= 0; i--) {
        out_indices[i] = temp % params.output_shape[i];
        temp /= params.output_shape[i];
    }

    uint input_idx = 0;
    for (uint i = 0; i < params.input_ndim; i++) {
        uint out_dim_idx = params.output_ndim - params.input_ndim + i;
        uint in_idx = (params.input_shape[i] == 1) ? 0 : out_indices[out_dim_idx];
        input_idx += in_idx * params.input_strides[i];
    }

    output_data[idx] = input_data[input_idx];
}
