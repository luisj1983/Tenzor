#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// IndexAdd (Float64): atomically accumulates double source values into output
// along a dimension via a 64-bit CAS loop, so Float64 accumulation keeps its 53
// mantissa bits instead of being rounded through Float32.
// output[(o * dim_size + index[k]) * inner + j] += source[(o * idx_n + k) * inner + j]
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint64_t out_data[]; };   // uint64_t for CAS atomics
layout(binding = 1) buffer Source { float64_t src_data[]; };   // Source values to add
layout(binding = 2) buffer Index { int idx_data[]; };          // 1-D index tensor

layout(push_constant) uniform PushConstants {
    uint outer;         // Product of dims before target dim
    uint dim_size;      // Size of target dim in output
    uint idx_n;         // Number of indices
    uint inner;         // Product of dims after target dim
} params;

float64_t bitsToF64(uint64_t bits) {
    return float64_t(packDouble2x32(uvec2(uint(bits), uint(bits >> 32u))));
}

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

void atomicAddF64(uint pos, float64_t val) {
    uint64_t old_bits = out_data[pos];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float64_t old_val = bitsToF64(old_bits);
        uint64_t new_bits = f64ToBits(old_val + val);
        uint64_t result = atomicCompSwap(out_data[pos], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total = params.outer * params.idx_n * params.inner;
    if (tid >= total) return;

    uint j = tid % params.inner;
    uint k = (tid / params.inner) % params.idx_n;
    uint o = tid / (params.inner * params.idx_n);

    int dest_idx = idx_data[k];
    if (dest_idx < 0 || dest_idx >= int(params.dim_size)) return;

    uint out_pos = (o * params.dim_size + uint(dest_idx)) * params.inner + j;
    uint src_pos = (o * params.idx_n + k) * params.inner + j;

    atomicAddF64(out_pos, src_data[src_pos]);
}
