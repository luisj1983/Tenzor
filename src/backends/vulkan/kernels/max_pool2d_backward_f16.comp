#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Max Pooling 2D Backward Pass for Float16
// Gradient flows only to max element, recomputes max indices in shader.
// grad_input is a PACKED-F16 buffer (2 bytes/elem). A float32 atomicAdd into it
// would write 4 bytes per element index — out of bounds for the upper half of
// the tensor and corrupting adjacent packed halves. We accumulate into the
// packed-F16 buffer via a CAS loop, mirroring avg_pool2d_backward_f16.comp.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { uint grad_output[]; };   // Packed F16 (N, C, H_out, W_out)
layout(binding = 1) buffer Input { uint input_data[]; };         // Packed F16 (N, C, H, W)
layout(binding = 2) buffer GradInput { uint grad_input[]; };     // Packed F16, CAS-accumulated (N, C, H, W)

layout(push_constant) uniform PushConstants {
    uint n_elements;          // Total output gradient elements (N * C * H_out * W_out)
    uint batch;               // N
    uint channels;            // C
    uint in_height;           // H
    uint in_width;            // W
    uint out_height;          // H_out
    uint out_width;           // W_out
    uint kernel_h;            // Kernel height
    uint kernel_w;            // Kernel width
    uint stride_h;            // Stride height
    uint stride_w;            // Stride width
    uint padding_h;           // Padding height
    uint padding_w;           // Padding width
    uint dilation_h;          // Dilation height
    uint dilation_w;          // Dilation width
} params;

float readF16GradOut(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = grad_output[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

float readF16Input(uint idx) {
    uint word_idx = idx >> 1u;
    uint packed = input_data[word_idx];
    vec2 pair = unpackHalf2x16(packed);
    return (idx & 1u) == 0u ? pair.x : pair.y;
}

// Atomically add an F16 value to a packed F16 buffer element via a CAS loop on
// the enclosing uint32 word (no native F16 atomicAdd). Same pattern as
// avg_pool2d_backward_f16.comp::atomicAddF16.
void atomicAddF16(uint flat_idx, float add_val) {
    uint word_idx = flat_idx / 2u;
    uint half_idx = flat_idx % 2u;
    uint mask = 0xFFFFu << (half_idx * 16u);

    uint old_val = grad_input[word_idx];
    uint new_val, expected;
    for (uint iter = 0u; iter < 65536u; iter++) {
        expected = old_val;
        uint bits = (expected >> (half_idx * 16u)) & 0xFFFFu;
        float current = unpackHalf2x16(bits | (bits << 16u)).x;
        float updated = current + add_val;
        uint new_bits = packHalf2x16(vec2(updated, 0.0)).x & 0xFFFFu;
        new_val = (expected & ~mask) | (new_bits << (half_idx * 16u));
        old_val = atomicCompSwap(grad_input[word_idx], expected, new_val);
        if (old_val == expected) return;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Bounds check
    if (idx >= params.n_elements) {
        return;
    }

    // Decode flat index to (n, c, h_out, w_out)
    uint temp = idx;
    uint w_out = temp % params.out_width;
    temp /= params.out_width;
    uint h_out = temp % params.out_height;
    temp /= params.out_height;
    uint c = temp % params.channels;
    uint n = temp / params.channels;

    // Get output gradient
    float grad_out = readF16GradOut(idx);

    // Compute input window bounds
    int h_start = int(h_out * params.stride_h) - int(params.padding_h);
    int w_start = int(w_out * params.stride_w) - int(params.padding_w);

    // Find max value and its position (recompute from forward pass)
    float max_val = -1.0 / 0.0;
    int max_h = -1;
    int max_w = -1;

    // Iterate over pooling window with dilation to find max
    for (uint kh = 0; kh < params.kernel_h; kh++) {
        for (uint kw = 0; kw < params.kernel_w; kw++) {
            int h_in = h_start + int(kh * params.dilation_h);
            int w_in = w_start + int(kw * params.dilation_w);

            // Check if within input bounds
            if (h_in >= 0 && h_in < int(params.in_height) &&
                w_in >= 0 && w_in < int(params.in_width)) {

                // Compute input index: (n, c, h_in, w_in)
                uint input_idx = n * params.channels * params.in_height * params.in_width +
                                c * params.in_height * params.in_width +
                                uint(h_in) * params.in_width +
                                uint(w_in);

                float val = readF16Input(input_idx);

                // Update max if current value is larger
                if (val > max_val || val != val) {
                    max_val = val;
                    max_h = h_in;
                    max_w = w_in;
                }
            }
        }
    }

    // Propagate gradient only to max element
    if (max_h >= 0 && max_w >= 0) {
        // Compute input index for max element
        uint max_idx = n * params.channels * params.in_height * params.in_width +
                      c * params.in_height * params.in_width +
                      uint(max_h) * params.in_width +
                      uint(max_w);

        // Atomically add gradient into the packed-F16 buffer via CAS.
        atomicAddF16(max_idx, grad_out);
    }
}
