#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Memory format conversion for Float16: NCHW <-> NHWC
// format=0: NCHW->NHWC, format=1: NHWC->NCHW
// F16 packed buffers (2 Float16 per uint32)
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { uint input_data[]; };
layout(binding = 1) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;  // Total elements
    uint N;           // Batch size
    uint C;           // Channels
    uint H;           // Height
    uint W;           // Width
    uint format;      // 0 = NCHW->NHWC, 1 = NHWC->NCHW
} params;

// Read a single float16 element from packed uint input buffer
float readF16(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = input_data[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

// Write a single float16 element to packed uint output buffer using a CAS loop.
// Output elements idx and idx+1 share word_idx = idx/2 and run concurrently on
// separate threads; a plain read-modify-write would let the last writer clobber
// the other thread's half. atomicCompSwap merges this half atomically.
void writeF16(uint element_idx, float val) {
    uint word_idx = element_idx / 2;
    uint half_offset = (element_idx % 2) * 16;
    uint new_bits = packHalf2x16(vec2(val, 0.0)) & 0xFFFFu;
    uint mask = 0xFFFFu << half_offset;

    uint old_word = output_data[word_idx];
    for (int attempt = 0; attempt < 65536; ++attempt) {
        uint new_word = (old_word & ~mask) | (new_bits << half_offset);
        uint result = atomicCompSwap(output_data[word_idx], old_word, new_word);
        if (result == old_word) return;
        old_word = result;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint src_idx;

    if (params.format == 0) {
        // NCHW -> NHWC: output[n,h,w,c] = input[n,c,h,w]
        uint c = idx % params.C;
        uint temp = idx / params.C;
        uint w = temp % params.W;
        temp /= params.W;
        uint h = temp % params.H;
        uint n = temp / params.H;

        src_idx = n * (params.C * params.H * params.W) +
                  c * (params.H * params.W) +
                  h * params.W + w;
    } else {
        // NHWC -> NCHW: output[n,c,h,w] = input[n,h,w,c]
        uint w = idx % params.W;
        uint temp = idx / params.W;
        uint h = temp % params.H;
        temp /= params.H;
        uint c = temp % params.C;
        uint n = temp / params.C;

        src_idx = n * (params.H * params.W * params.C) +
                  h * (params.W * params.C) +
                  w * params.C + c;
    }

    float val = readF16(src_idx);
    writeF16(idx, val);
}
