#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// scatter_reduce mean divisor pass (Float64) — divides each output element by its
// scatter-count (+1 if include_self), keeping full double precision.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint64_t out_data[]; };  // float64 storage as uint64
layout(binding = 1) buffer Counts { int count_data[]; };

layout(push_constant) uniform PushConstants {
    uint numel;
    uint include_self;  // 0 or 1
} params;

float64_t bitsToF64(uint64_t bits) {
    return float64_t(packDouble2x32(uvec2(uint(bits), uint(bits >> 32u))));
}

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= params.numel) return;
    int c = count_data[tid];
    if (c <= 0) return;
    int divisor_int = (params.include_self != 0u) ? (c + 1) : c;
    float64_t divisor = float64_t(divisor_int);
    out_data[tid] = f64ToBits(bitsToF64(out_data[tid]) / divisor);
}
