#version 450

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint LOCAL_SIZE_X = 256;

// Winograd F(2,3) filter transform: U = G * g * G^T
// Transforms 3x3 filters for use with Winograd convolution.
//
// G = [ 1     0     0   ]
//     [ 1/2   1/2   1/2 ]
//     [ 1/2  -1/2   1/2 ]
//     [ 0     0     1   ]

layout(binding = 0) buffer readonly FilterBuffer { float data[]; } filter_buf;
layout(binding = 1) buffer writeonly OutputBuffer { float data[]; } output_buf;

layout(push_constant) uniform PushConstants {
    uint out_channels;   // K (number of output channels / filters)
    uint in_channels;    // C (number of input channels per filter)
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total_filters = params.out_channels * params.in_channels;
    if (gid >= total_filters) return;

    uint c = gid % params.in_channels;
    uint k = gid / params.in_channels;

    // Load 3x3 filter g[i][j]
    // Filter layout: [K, C, 3, 3]
    float g[3][3];
    uint base = (k * params.in_channels + c) * 9u;
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            g[i][j] = filter_buf.data[base + uint(i) * 3u + uint(j)];
        }
    }

    // Compute temp = g * G^T (right-multiply by G^T)
    // G^T = [ 1    1/2   1/2   0 ]
    //       [ 0    1/2  -1/2   0 ]
    //       [ 0    1/2   1/2   1 ]
    float tmp_mat[3][4];
    for (int i = 0; i < 3; i++) {
        tmp_mat[i][0] = g[i][0];
        tmp_mat[i][1] = 0.5 * (g[i][0] + g[i][1] + g[i][2]);
        tmp_mat[i][2] = 0.5 * (g[i][0] - g[i][1] + g[i][2]);
        tmp_mat[i][3] = g[i][2];
    }

    // Compute U = G * tmp (left-multiply by G)
    // G = [ 1     0     0   ]
    //     [ 1/2   1/2   1/2 ]
    //     [ 1/2  -1/2   1/2 ]
    //     [ 0     0     1   ]
    float U[4][4];
    for (int j = 0; j < 4; j++) {
        U[0][j] = tmp_mat[0][j];
        U[1][j] = 0.5 * (tmp_mat[0][j] + tmp_mat[1][j] + tmp_mat[2][j]);
        U[2][j] = 0.5 * (tmp_mat[0][j] - tmp_mat[1][j] + tmp_mat[2][j]);
        U[3][j] = tmp_mat[2][j];
    }

    // Store transformed filter: layout [alpha][beta][K][C]
    // where alpha, beta index the 4x4 Winograd domain
    uint filter_idx = k * params.in_channels + c;
    uint filter_stride = params.out_channels * params.in_channels;

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            uint out_idx = (uint(i) * 4u + uint(j)) * filter_stride + filter_idx;
            output_buf.data[out_idx] = U[i][j];
        }
    }
}
