#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Masked select - Pass 2: Gather selected elements (Float16 variant)
// Reads/writes uint16 pairs packed in uint32
layout(local_size_x = 256) in;

layout(binding = 0) buffer Input { uint input_data[]; };     // Packed F16 pairs
layout(binding = 1) buffer Mask { uint mask_data[]; };
layout(binding = 2) buffer Output { uint output_data[]; };   // Packed F16 pairs
layout(binding = 3) buffer PrefixSums { uint prefix_sums[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint mask_is_float;
    uint output_size;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;

    if (gid >= params.n_elements) return;

    bool selected = false;
    if (params.mask_is_float == 1) {
        float val = uintBitsToFloat(mask_data[gid]);
        selected = (val != 0.0);
    } else {
        uint byte_idx = gid / 4;
        uint bit_offset = (gid % 4) * 8;
        uint byte_val = (mask_data[byte_idx] >> bit_offset) & 0xFF;
        selected = (byte_val != 0);
    }

    if (selected) {
        uint out_idx = prefix_sums[gid];
        if (out_idx < params.output_size) {
            // Read F16 value: gid-th 16-bit value from packed uint32 array
            uint word_idx = gid / 2;
            uint half_offset = (gid % 2) * 16;
            uint val = (input_data[word_idx] >> half_offset) & 0xFFFF;

            // Write F16 value to output using CAS loop for thread safety
            uint out_word_idx = out_idx / 2;
            uint out_half_offset = (out_idx % 2) * 16;
            uint out_mask = 0xFFFFu << out_half_offset;

            uint old_word = output_data[out_word_idx];
            for (int attempt = 0; attempt < 1024; ++attempt) {
                uint new_word = (old_word & ~out_mask) | (val << out_half_offset);
                uint cas_result = atomicCompSwap(output_data[out_word_idx], old_word, new_word);
                if (cas_result == old_word) break;
                old_word = cas_result;
            }
        }
    }
}
