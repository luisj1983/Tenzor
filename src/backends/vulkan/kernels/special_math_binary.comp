#version 450

// Special math binary operations:
//   0=beta(a,b) = exp(lgamma(a)+lgamma(b)-lgamma(a+b))
//   1=zeta(s,q) = Σ 1/(q+n)^s + Euler-Maclaurin remainder
//   2=logaddexp(a,b) = max(a,b) + log1p(exp(-|a-b|))
//   3=logaddexp2(a,b) = max(a,b) + log2(1 + exp2(-|a-b|))
//   4=xlogy(x,y) = x==0 ? 0 : x*log(y)

layout(local_size_x_id = 0) in;
layout(binding = 0) buffer InputA { float a_data[]; };
layout(binding = 1) buffer InputB { float b_data[]; };
layout(binding = 2) buffer Output { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint op;
} params;

const float PI = 3.14159265358979f;

// Lanczos lgamma (non-recursive; matches special_math_unary.comp)
float lgamma_lanczos(float x) {
    float coef[9];
    coef[0] = 0.99999999999980993f;
    coef[1] = 676.5203681218851f;
    coef[2] = -1259.1392167224028f;
    coef[3] = 771.32342877765313f;
    coef[4] = -176.61502916214059f;
    coef[5] = 12.507343278686905f;
    coef[6] = -0.13857109526572012f;
    coef[7] = 9.9843695780195716e-6f;
    coef[8] = 1.5056327351493116e-7f;

    float g = 7.0f;
    float xm1 = x - 1.0f;
    float a = coef[0];
    float t = xm1 + g + 0.5f;
    for (int i = 1; i < 9; ++i) {
        a += coef[i] / (xm1 + float(i));
    }
    return 0.5f * log(2.0f * PI) + (xm1 + 0.5f) * log(t) - t + log(a);
}
float lgamma_impl(float x) {
    // Pole at every non-positive integer: the reflection formula below
    // divides by sin(PI*x), which floating-point PI never lands on exactly
    // zero for. Return the real IEEE +inf bit pattern directly, bypassing
    // the reflection formula entirely at poles (same fix as
    // special_math_unary.comp's lgamma_impl -- this file has its own
    // independent copy since each .comp shader is compiled standalone).
    if (x <= 0.0f && x == floor(x)) {
        return uintBitsToFloat(0x7F800000u);  // +inf
    }
    if (x < 0.5f) {
        return log(PI / abs(sin(PI * x))) - lgamma_lanczos(1.0f - x);
    }
    return lgamma_lanczos(x);
}

float beta_impl(float a, float b) {
    // Gamma has a pole at non-positive integers, so Beta(a,b) inherits one
    // too whenever a, b, or a+b is a non-positive integer. With lgamma_impl
    // now returning a real +inf at those poles, exp(...) here naturally
    // propagates: e.g. beta(-1,2) = exp(lgamma(-1)[+inf] + lgamma(2)[0] -
    // lgamma(1)[0]) = exp(+inf) = +inf, correctly signaling the pole instead
    // of the previous finite-garbage result.
    return exp(lgamma_impl(a) + lgamma_impl(b) - lgamma_impl(a + b));
}

float zeta_impl(float s, float a) {
    float result = 0.0f;
    for (int i = 0; i < 12; ++i) {
        result += pow(a + float(i), -s);
    }
    float aN = a + 12.0f;
    if (s != 1.0f) result += pow(aN, 1.0f - s) / (s - 1.0f);
    result += 0.5f * pow(aN, -s);
    // Leading Euler-Maclaurin Bernoulli correction terms (B2/12, B4/720,
    // B6/30240), matching the CPU/CUDA/OneAPI hurwitz_zeta reference; without
    // them the truncated sum carries an O(s·(a+N)^(-s-1)) error (~7.6e-5 for
    // ζ(2,1)).
    result += s * pow(aN, -s - 1.0f) / 12.0f;
    result -= (s * (s + 1.0f) * (s + 2.0f)) * pow(aN, -s - 3.0f) / 720.0f;
    result += (s * (s + 1.0f) * (s + 2.0f) * (s + 3.0f) * (s + 4.0f))
              * pow(aN, -s - 5.0f) / 30240.0f;
    return result;
}

// log1p(x) = log(1+x), numerically stable
float log1p_impl(float x) {
    float u = 1.0f + x;
    if (u == 1.0f) return x;
    return log(u) * (x / (u - 1.0f));
}

float logaddexp_impl(float a, float b) {
    float m = max(a, b);
    return m + log1p_impl(exp(-abs(a - b)));
}

float logaddexp2_impl(float a, float b) {
    float m = max(a, b);
    return m + log2(1.0f + exp2(-abs(a - b)));
}

float xlogy_impl(float x, float y) {
    if (x == 0.0f) return 0.0f;
    return x * log(y);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;
    float a = a_data[idx];
    float b = b_data[idx];
    float r;
    switch (params.op) {
        case 0: r = beta_impl(a, b); break;
        case 1: r = zeta_impl(a, b); break;
        case 2: r = logaddexp_impl(a, b); break;
        case 3: r = logaddexp2_impl(a, b); break;
        case 4: r = xlogy_impl(a, b); break;
        default: r = 0.0f;
    }
    out_data[idx] = r;
}
