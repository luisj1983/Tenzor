#version 450

// Linspace for BFloat16: generate linearly-spaced values from start to end
// BF16 packed buffers (2 BFloat16 per uint32), arithmetic in float32
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    float start;
    float end_val;
    uint num_steps;
} params;

void main() {
    // Each thread handles one uint32 word (2 BF16 elements)
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    if (idx0 >= params.num_steps) return;

    // Compute values in float32
    float val0;
    float val1;

    if (params.num_steps == 1) {
        val0 = params.start;
        val1 = 0.0;
    } else {
        float denom = float(params.num_steps - 1);
        float t0 = float(idx0) / denom;
        val0 = params.start + t0 * (params.end_val - params.start);

        if (idx1 < params.num_steps) {
            float t1 = float(idx1) / denom;
            val1 = params.start + t1 * (params.end_val - params.start);
        } else {
            val1 = 0.0;
        }
    }

    // Pack two BF16 values into one uint32
    uint bits0 = ((floatBitsToUint(val0) + 0x7FFFu + ((floatBitsToUint(val0) >> 16) & 1u)) >> 16);
    uint bits1 = ((floatBitsToUint(val1) + 0x7FFFu + ((floatBitsToUint(val1) >> 16) & 1u)) >> 16);
    output_data[pair_idx] = bits0 | (bits1 << 16);
}
