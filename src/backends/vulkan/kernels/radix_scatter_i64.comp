#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer KeysIn   { int64_t keys_in[];  };
layout(set = 0, binding = 1) readonly buffer IdxIn    { int idx_in[];       };
layout(set = 0, binding = 2) buffer KeysOut            { int64_t keys_out[]; };
layout(set = 0, binding = 3) buffer IdxOut             { int idx_out[];      };
layout(set = 0, binding = 4) buffer Histograms         { uint histos[];      };

layout(push_constant) uniform PushConstants {
    uint n;
    uint digit;
    uint n_wgs;
    uint descending; // 0 = ascending, 1 = descending
};

shared uint local_offsets[256];

// Must derive exactly the same digit as the histogram pass, so apply the same
// descending key inversion here: an ascending LSD radix over the inverted key
// yields descending values with stable (ascending-index) tie order.
uint64_t int64_to_sortable(int64_t val) {
    uint64_t sortable = uint64_t(val) ^ 0x8000000000000000ul;
    if (descending != 0u) sortable = ~sortable;
    return sortable;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    // Load this workgroup's per-digit base offsets into shared memory. There
    // are always exactly 256 bins, but the workgroup size is a runtime spec
    // constant (local_size_x_id=0) that can be <256 or >256, so stride the load
    // by the actual workgroup size: a one-bin-per-thread load would leave bins
    // uninitialized for wgSize<256 and read past local_offsets[256]/histos for
    // wgSize>256.
    for (uint b = lid; b < 256u; b += gl_WorkGroupSize.x) {
        local_offsets[b] = histos[b * n_wgs + wg_id];
    }
    barrier();

    uint tile_size = (n + n_wgs - 1) / n_wgs;
    uint tile_start = wg_id * tile_size;
    uint tile_end = min(tile_start + tile_size, n);

    // Scatter this workgroup's tile, striding by the actual workgroup size (not
    // a hardcoded 256) so every element is processed exactly once. A hardcoded
    // stride of 256 with wgSize>256 makes lanes lid and lid+256/+512/... cover
    // overlapping element ranges, scattering the same elements multiple times.
    // STABILITY (see radix_scatter.comp): scatter the tile in strict index
    // order from a single lane so equal-digit elements keep ascending-index
    // order. A parallel atomicAdd assigns slots in arbitration order, breaking
    // LSD-radix stability and diverging from the stable CPU reference.
    barrier();
    if (lid == 0u) {
        for (uint i = tile_start; i < tile_end; ++i) {
            uint64_t sortable = int64_to_sortable(keys_in[i]);
            uint digit_val = uint((sortable >> (digit * 8)) & 0xFFul);
            uint dest = local_offsets[digit_val];
            local_offsets[digit_val] = dest + 1u;
            keys_out[dest] = keys_in[i];
            idx_out[dest] = idx_in[i];
        }
    }
}
