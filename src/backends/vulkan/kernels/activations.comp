#version 450

// Activation functions: ReLU, Sigmoid, Tanh, GELU, LeakyReLU, Swish, ELU, SELU, Mish, Softplus
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;          // Number of elements
    uint activation; // 0=ReLU, 1=Sigmoid, 2=Tanh, 3=GELU, 4=LeakyReLU, 5=Swish, 6=ELU, 7=SELU, 8=Mish, 9=Softplus
    float alpha;     // Parameter for LeakyReLU, ELU, Softplus beta
} params;

const float PI = 3.14159265359;
const float SELU_ALPHA = 1.6732632423543772848170429916717;
const float SELU_SCALE = 1.0507009873554804934193349852946;

float relu(float x) {
    return max(0.0, x);
}

float sigmoid(float x) {
    return 1.0 / (1.0 + exp(-x));
}

float gelu(float x) {
    // Approximation: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
    float cdf = 0.5 * (1.0 + tanh(sqrt(2.0 / PI) * (x + 0.044715 * x * x * x)));
    return x * cdf;
}

float leaky_relu(float x, float alpha) {
    return x > 0.0 ? x : alpha * x;
}

float swish(float x) {
    // Swish/SiLU: x * sigmoid(x) = x / (1 + exp(-x))
    return x / (1.0 + exp(-x));
}

float elu(float x, float alpha) {
    // ELU: x if x > 0, alpha * (exp(x) - 1) otherwise
    return x > 0.0 ? x : alpha * (exp(x) - 1.0);
}

float selu(float x) {
    // SELU: scale * (x if x > 0, alpha * (exp(x) - 1) otherwise)
    return x > 0.0 ? SELU_SCALE * x : SELU_SCALE * SELU_ALPHA * (exp(x) - 1.0);
}

float softplus(float x, float beta) {
    // Softplus: (1/beta) * log(1 + exp(beta * x))
    // Numerically stable version
    float bx = beta * x;
    if (bx > 20.0) return x;
    if (bx < -20.0) return exp(bx) / beta;
    return log(1.0 + exp(bx)) / beta;
}

float mish(float x) {
    // Mish: x * tanh(softplus(x)) = x * tanh(ln(1 + exp(x)))
    float sp = x > 20.0 ? x : (x < -20.0 ? exp(x) : log(1.0 + exp(x)));
    return x * tanh(sp);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    float x = input_data[idx];
    float result;

    switch (params.activation) {
        case 0: // ReLU
            result = relu(x);
            break;
        case 1: // Sigmoid
            result = sigmoid(x);
            break;
        case 2: // Tanh
            result = tanh(x);
            break;
        case 3: // GELU
            result = gelu(x);
            break;
        case 4: // LeakyReLU
            result = leaky_relu(x, params.alpha);
            break;
        case 5: // Swish
            result = swish(x);
            break;
        case 6: // ELU
            result = elu(x, params.alpha);
            break;
        case 7: // SELU
            result = selu(x);
            break;
        case 8: // Mish
            result = mish(x);
            break;
        case 9: // Softplus
            result = softplus(x, params.alpha);
            break;
        default:
            result = x;
    }

    output_data[idx] = result;
}
