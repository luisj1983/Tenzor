#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Fill tensor with a constant value for Int64 dtype
// Note: Push constants are limited in size, so we pass value as two 32-bit parts
layout(local_size_x = 256) in;

layout(binding = 0) buffer Output { int64_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;           // Total number of elements
    uint value_low;   // Low 32 bits of the int64 value
    uint value_high;  // High 32 bits of the int64 value
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n) {
        return;
    }

    // Reconstruct int64 from two uint32 parts
    int64_t value = int64_t(params.value_low) | (int64_t(params.value_high) << 32);
    output_data[idx] = value;
}
