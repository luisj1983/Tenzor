#version 450
#extension GL_EXT_shader_8bit_storage : require

// Fill tensor with ones for UInt8 dtype
// Uses direct byte access via 8-bit storage extension
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { uint8_t output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;     // Number of uint8 elements
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    output_data[idx] = uint8_t(1);
}
