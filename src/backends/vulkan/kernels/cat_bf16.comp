#version 450

// Concatenate operation for BFloat16: join tensors along a dimension
// BFloat16 elements are packed 2 per uint32
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input0 { uint input0_data[]; };
layout(binding = 1) buffer Input1 { uint input1_data[]; };
layout(binding = 2) buffer Output { uint output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n_elements;        // Total output elements (in bfloat16 count)
    uint cat_dim;           // Dimension to concatenate along
    uint ndim;              // Number of dimensions
    uint output_shape[8];   // Output shape (max 8 dims)
    uint input0_dim_size;   // Size of input0 along cat_dim
    uint input1_dim_size;   // Size of input1 along cat_dim
    uint outer_size;        // Product of dimensions before cat_dim
    uint inner_size;        // Product of dimensions after cat_dim
} params;

// Helper to read bfloat16 from packed buffer
float readBF16(uint packed, uint offset) {
    uint bits = (packed >> (offset * 16)) & 0xFFFFu;
    return uintBitsToFloat(bits << 16);
}

// Helper to pack two bfloat16 values (round-to-nearest-even)
uint packBF16Pair(float v0, float v1) {
    uint b0 = floatBitsToUint(v0);
    uint b1 = floatBitsToUint(v1);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Read a single bfloat16 element from input0 at the given element index
float readFromInput0(uint element_idx) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    return readBF16(input0_data[pair_idx], offset);
}

// Read a single bfloat16 element from input1 at the given element index
float readFromInput1(uint element_idx) {
    uint pair_idx = element_idx / 2;
    uint offset = element_idx % 2;
    return readBF16(input1_data[pair_idx], offset);
}

// Read from the appropriate input based on cat position
float readElement(uint idx) {
    uint inner_idx = idx % params.inner_size;
    uint temp = idx / params.inner_size;
    uint cat_pos = temp % (params.input0_dim_size + params.input1_dim_size);
    uint outer_idx = temp / (params.input0_dim_size + params.input1_dim_size);

    if (cat_pos < params.input0_dim_size) {
        uint input_idx = outer_idx * params.input0_dim_size * params.inner_size +
                        cat_pos * params.inner_size + inner_idx;
        return readFromInput0(input_idx);
    } else {
        uint cat_pos_in = cat_pos - params.input0_dim_size;
        uint input_idx = outer_idx * params.input1_dim_size * params.inner_size +
                        cat_pos_in * params.inner_size + inner_idx;
        return readFromInput1(input_idx);
    }
}

void main() {
    // Process 2 elements per thread (packed BF16 pair)
    uint pair_idx = gl_GlobalInvocationID.x;
    uint idx0 = pair_idx * 2;
    uint idx1 = pair_idx * 2 + 1;

    if (idx0 >= params.n_elements) return;

    float val0 = readElement(idx0);
    float val1 = (idx1 < params.n_elements) ? readElement(idx1) : float(0.0);

    output_data[pair_idx] = packBF16Pair(val0, val1);
}
