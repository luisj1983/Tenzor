#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// General eigenvalue decomposition via QR iteration with implicit double shifts
// Float64 variant for non-symmetric matrices (up to 32x32)
// Output: eigenvalues_real (binding 1), eigenvalues_imag (binding 2)

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer WRealBuf  { float64_t data_wr[];  };
layout(set = 0, binding = 2) buffer WImagBuf  { float64_t data_wi[];  };

layout(push_constant) uniform PushConstants {
    uint n;
    uint batch;
    uint max_iterations;
};

shared float64_t H[32][32];
shared float64_t converged;

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (batch_idx >= batch) return;

    uint mat_offset = batch_idx * n * n;

    for (uint row = 0; row < n; row++) {
        if (tid < n) {
            H[row][tid] = data_in[mat_offset + row * n + tid];
        }
    }
    barrier();

    // Step 1: Reduce to upper Hessenberg form via Householder reflections
    for (uint k = 0; k + 2 < n; k++) {
        if (tid == 0) {
            float64_t sigma = 0.0lf;
            for (uint i = k + 1; i < n; i++) {
                sigma += H[i][k] * H[i][k];
            }
            float64_t norm_x = sqrt(sigma);
            if (norm_x < 1e-30lf) continue;

            float64_t alpha = -sign(H[k+1][k]) * norm_x;
            float64_t v0 = H[k+1][k] - alpha;
            float64_t v_norm_sq = v0 * v0;
            for (uint i = k + 2; i < n; i++) {
                v_norm_sq += H[i][k] * H[i][k];
            }
            if (v_norm_sq < 1e-30lf) continue;

            float64_t tau = 2.0lf / v_norm_sq;

            // Left: H = (I - tau * v * v^T) * H
            for (uint j = k; j < n; j++) {
                float64_t dot = v0 * H[k+1][j];
                for (uint i = k + 2; i < n; i++) {
                    dot += H[i][k] * H[i][j];
                }
                dot *= tau;
                H[k+1][j] -= v0 * dot;
                for (uint i = k + 2; i < n; i++) {
                    H[i][j] -= H[i][k] * dot;
                }
            }

            // Right: H = H * (I - tau * v * v^T)
            for (uint i = 0; i < n; i++) {
                float64_t dot = v0 * H[i][k+1];
                for (uint j = k + 2; j < n; j++) {
                    dot += H[j][k] * H[i][j];
                }
                dot *= tau;
                H[i][k+1] -= v0 * dot;
                for (uint j = k + 2; j < n; j++) {
                    H[i][j] -= H[j][k] * dot;
                }
            }

            H[k+1][k] = alpha;
            for (uint i = k + 2; i < n; i++) {
                H[i][k] = 0.0lf;
            }
        }
        barrier();
    }

    // Step 2: QR iteration with implicit double shifts
    uint nn = n;

    for (uint iter = 0; iter < max_iterations && nn > 0; iter++) {
        if (tid == 0) {
            if (nn >= 2) {
                float64_t tst = abs(H[nn-2][nn-2]) + abs(H[nn-1][nn-1]);
                if (tst == 0.0lf) tst = 1.0lf;
                if (abs(H[nn-1][nn-2]) < 1e-14lf * tst) {
                    data_wr[batch_idx * n + nn - 1] = H[nn-1][nn-1];
                    data_wi[batch_idx * n + nn - 1] = 0.0lf;
                    H[nn-1][nn-2] = 0.0lf;
                    nn--;
                    continue;
                }
            }

            if (nn >= 3) {
                float64_t tst = abs(H[nn-3][nn-3]) + abs(H[nn-2][nn-2]);
                if (tst == 0.0lf) tst = 1.0lf;
                if (abs(H[nn-2][nn-3]) < 1e-14lf * tst) {
                    float64_t a = H[nn-2][nn-2], b = H[nn-2][nn-1];
                    float64_t c = H[nn-1][nn-2], d = H[nn-1][nn-1];
                    float64_t trace = a + d;
                    float64_t det = a * d - b * c;
                    float64_t disc = trace * trace - 4.0lf * det;

                    if (disc >= 0.0lf) {
                        float64_t sq = sqrt(disc);
                        data_wr[batch_idx * n + nn - 2] = 0.5lf * (trace + sq);
                        data_wi[batch_idx * n + nn - 2] = 0.0lf;
                        data_wr[batch_idx * n + nn - 1] = 0.5lf * (trace - sq);
                        data_wi[batch_idx * n + nn - 1] = 0.0lf;
                    } else {
                        float64_t sq = sqrt(-disc);
                        data_wr[batch_idx * n + nn - 2] = 0.5lf * trace;
                        data_wi[batch_idx * n + nn - 2] = 0.5lf * sq;
                        data_wr[batch_idx * n + nn - 1] = 0.5lf * trace;
                        data_wi[batch_idx * n + nn - 1] = -0.5lf * sq;
                    }

                    H[nn-2][nn-3] = 0.0lf;
                    nn -= 2;
                    continue;
                }
            }

            if (nn == 1) {
                data_wr[batch_idx * n] = H[0][0];
                data_wi[batch_idx * n] = 0.0lf;
                nn = 0;
                continue;
            }

            // Francis QR step
            float64_t s = H[nn-2][nn-2] + H[nn-1][nn-1];
            float64_t t = H[nn-2][nn-2] * H[nn-1][nn-1] - H[nn-2][nn-1] * H[nn-1][nn-2];

            float64_t x = H[0][0] * H[0][0] + H[0][1] * H[1][0] - s * H[0][0] + t;
            float64_t y = H[1][0] * (H[0][0] + H[1][1] - s);
            float64_t z = (nn > 2) ? H[1][0] * H[2][1] : 0.0lf;

            for (uint k = 0; k + 2 < nn; k++) {
                float64_t norm_v = sqrt(x*x + y*y + z*z);
                if (norm_v < 1e-30lf) { x = H[k+1][k]; y = (k+2 < nn) ? H[k+2][k] : 0.0lf; z = (k+3 < nn) ? H[k+3][k] : 0.0lf; continue; }

                float64_t alpha_h = -sign(x) * norm_v;
                float64_t v0 = x - alpha_h;
                float64_t v1 = y;
                float64_t v2 = z;
                float64_t v_sq = v0*v0 + v1*v1 + v2*v2;
                if (v_sq < 1e-30lf) { x = H[k+1][k]; y = (k+2 < nn) ? H[k+2][k] : 0.0lf; z = (k+3 < nn) ? H[k+3][k] : 0.0lf; continue; }
                float64_t tau_h = 2.0lf / v_sq;

                uint m = min(k + 4, nn);

                for (uint j = k; j < nn; j++) {
                    float64_t dot = v0 * H[k][j] + v1 * H[k+1][j];
                    if (k + 2 < nn) dot += v2 * H[k+2][j];
                    dot *= tau_h;
                    H[k][j]   -= v0 * dot;
                    H[k+1][j] -= v1 * dot;
                    if (k + 2 < nn) H[k+2][j] -= v2 * dot;
                }

                for (uint i = 0; i < m; i++) {
                    float64_t dot = v0 * H[i][k] + v1 * H[i][k+1];
                    if (k + 2 < nn) dot += v2 * H[i][k+2];
                    dot *= tau_h;
                    H[i][k]   -= v0 * dot;
                    H[i][k+1] -= v1 * dot;
                    if (k + 2 < nn) H[i][k+2] -= v2 * dot;
                }

                if (k > 0) H[k][k-1] = alpha_h;
                if (k + 2 < nn) H[k+2][k] = 0.0lf;
                if (k + 3 < nn) H[k+3][k] = 0.0lf;

                x = H[k+1][k];
                y = (k + 2 < nn) ? H[k+2][k] : 0.0lf;
                z = (k + 3 < nn) ? H[k+3][k] : 0.0lf;
            }

            if (nn >= 2) {
                uint k = nn - 2;
                float64_t norm_v = sqrt(x*x + y*y);
                if (norm_v > 1e-30lf) {
                    float64_t c = x / norm_v;
                    float64_t s_val = -y / norm_v;
                    for (uint j = k; j < nn; j++) {
                        float64_t tmp = c * H[k][j] - s_val * H[k+1][j];
                        H[k+1][j] = s_val * H[k][j] + c * H[k+1][j];
                        H[k][j] = tmp;
                    }
                    for (uint i = 0; i < nn; i++) {
                        float64_t tmp = c * H[i][k] - s_val * H[i][k+1];
                        H[i][k+1] = s_val * H[i][k] + c * H[i][k+1];
                        H[i][k] = tmp;
                    }
                }
            }
        }
        barrier();
    }

    // Handle remaining blocks
    if (tid == 0) {
        if (nn == 1) {
            data_wr[batch_idx * n] = H[0][0];
            data_wi[batch_idx * n] = 0.0lf;
        } else if (nn == 2) {
            float64_t a = H[0][0], b = H[0][1], c = H[1][0], d = H[1][1];
            float64_t trace = a + d;
            float64_t det = a * d - b * c;
            float64_t disc = trace * trace - 4.0lf * det;
            if (disc >= 0.0lf) {
                float64_t sq = sqrt(disc);
                data_wr[batch_idx * n] = 0.5lf * (trace + sq);
                data_wi[batch_idx * n] = 0.0lf;
                data_wr[batch_idx * n + 1] = 0.5lf * (trace - sq);
                data_wi[batch_idx * n + 1] = 0.0lf;
            } else {
                float64_t sq = sqrt(-disc);
                data_wr[batch_idx * n] = 0.5lf * trace;
                data_wi[batch_idx * n] = 0.5lf * sq;
                data_wr[batch_idx * n + 1] = 0.5lf * trace;
                data_wi[batch_idx * n + 1] = -0.5lf * sq;
            }
        }
    }
}
