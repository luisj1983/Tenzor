#version 450
#extension GL_EXT_shader_atomic_float : enable

// Adaptive Average Pool 3D Backward (Float32).
// Distributes each output gradient over its adaptive input window:
//   start = floor(o * in / out), end = ceil((o + 1) * in / out) (per spatial axis),
//   matching the CPU/PyTorch adaptive-pool convention.
// Uses atomic float add to accumulate into overlapping input positions, so it
// iterates over OUTPUT elements (one thread per output gradient).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float grad_output[]; };
layout(binding = 1) buffer GradInput { float grad_input[]; };

layout(push_constant) uniform PushConstants {
    uint batch;
    uint channels;
    uint D_in;
    uint H_in;
    uint W_in;
    uint D_out;
    uint H_out;
    uint W_out;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = params.batch * params.channels * params.D_out * params.H_out * params.W_out;
    if (idx >= total) return;

    // Decode output index
    uint w_out = idx % params.W_out;
    uint h_out = (idx / params.W_out) % params.H_out;
    uint d_out = (idx / (params.W_out * params.H_out)) % params.D_out;
    uint c = (idx / (params.W_out * params.H_out * params.D_out)) % params.channels;
    uint n = idx / (params.W_out * params.H_out * params.D_out * params.channels);

    // Adaptive window boundaries
    uint d_start = (d_out * params.D_in) / params.D_out;
    uint d_end = ((d_out + 1) * params.D_in + params.D_out - 1) / params.D_out;
    uint h_start = (h_out * params.H_in) / params.H_out;
    uint h_end = ((h_out + 1) * params.H_in + params.H_out - 1) / params.H_out;
    uint w_start = (w_out * params.W_in) / params.W_out;
    uint w_end = ((w_out + 1) * params.W_in + params.W_out - 1) / params.W_out;

    uint count = (d_end - d_start) * (h_end - h_start) * (w_end - w_start);
    if (count == 0u) return;

    float grad_val = grad_output[idx] / float(count);

    for (uint d = d_start; d < d_end; ++d) {
        for (uint h = h_start; h < h_end; ++h) {
            for (uint w = w_start; w < w_end; ++w) {
                uint input_idx = (((n * params.channels + c) * params.D_in + d) * params.H_in + h) * params.W_in + w;
                atomicAdd(grad_input[input_idx], grad_val);
            }
        }
    }
}
