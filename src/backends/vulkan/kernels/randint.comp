#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// Randint: Generate random integers in [low, high) using Philox 4x32-10 PRNG.
//
// F042: bit-for-bit port of CPU's randint_kernel (src/backends/cpu/kernels/
// creation.cpp): draw a double-precision uniform in [0,1) via the same
// 53-bit-mantissa construction CPU's philox_uniform_f64 uses, then scale by
// the (double) range and truncate — NOT a 32-bit-float scale (insufficient
// mantissa precision to reproduce CPU's exact integer for ranges wider than
// ~2^24) and NOT a `raw_bits % range` modulo reduction (a structurally
// different, non-CPU-matching range-mapping scheme; the previous randint.comp
// used the former, and randint_i64.comp used the latter — both produced
// plausible-looking but numerically wrong integers relative to CPU).
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Output { int output_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    int low;
    int high;
    uint seed_lo;         // Low 32 bits of the 64-bit global seed
    uint seed_hi;         // High 32 bits of the 64-bit global seed
    uint offset;
} params;

// Philox constants
const uint PHILOX_M0 = 0xD2511F53u;
const uint PHILOX_M1 = 0xCD9E8D57u;
const uint PHILOX_W0 = 0x9E3779B9u;
const uint PHILOX_W1 = 0xBB67AE85u;

// 32-bit multiply returning high 32 bits (emulated without 64-bit)
uint mulhi(uint a, uint b) {
    uint a_lo = a & 0xFFFFu;
    uint a_hi = a >> 16;
    uint b_lo = b & 0xFFFFu;
    uint b_hi = b >> 16;

    uint p0 = a_lo * b_lo;
    uint p1 = a_lo * b_hi;
    uint p2 = a_hi * b_lo;
    uint p3 = a_hi * b_hi;

    uint carry = ((p0 >> 16) + (p1 & 0xFFFFu) + (p2 & 0xFFFFu)) >> 16;
    return p3 + (p1 >> 16) + (p2 >> 16) + carry;
}

void philox_round(inout uvec4 ctr, uvec2 key) {
    uint hi0 = mulhi(ctr.x, PHILOX_M0);
    uint lo0 = ctr.x * PHILOX_M0;
    uint hi1 = mulhi(ctr.z, PHILOX_M1);
    uint lo1 = ctr.z * PHILOX_M1;

    ctr = uvec4(hi1 ^ ctr.y ^ key.x, lo1, hi0 ^ ctr.w ^ key.y, lo0);
}

uvec4 philox4x32(uvec4 ctr, uvec2 key) {
    for (int i = 0; i < 10; i++) {
        philox_round(ctr, key);
        key.x += PHILOX_W0;
        key.y += PHILOX_W1;
    }
    return ctr;
}

// Convert two uint32s to double in [0, 1) with a 53-bit mantissa — matches
// CPU's philox_uniform_f64 exactly: mantissa = (hi << 21) | (lo >> 11).
double uints_to_double01(uint hi, uint lo) {
    double mantissa = double(hi) * 2097152.0LF + double(lo >> 11);
    return mantissa / 9007199254740992.0LF; // 2^53
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n) return;

    // Counter/key layout matches CPU's philox.hpp exactly — see random.comp.
    uint element_idx = idx + params.offset;
    uvec4 ctr = uvec4(element_idx, 0u, 0u, 0u);
    uvec2 key = uvec2(params.seed_lo, params.seed_hi);

    uvec4 rand_vals = philox4x32(ctr, key);

    // Map uniform [0, 1) (double precision) to integer range [low, high),
    // exactly as CPU: low + int64_t(u * range), clamped.
    double u = uints_to_double01(rand_vals.x, rand_vals.y);
    double range = double(params.high - params.low);
    int result = params.low + int(u * range);

    if (result >= params.high) result = params.high - 1;
    if (result < params.low) result = params.low;

    output_data[idx] = result;
}
