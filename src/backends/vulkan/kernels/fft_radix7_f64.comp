#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Stockham mixed-radix FFT: radix-7 butterfly stage (Float64)
// Data layout: interleaved real/imag pairs
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { float64_t data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float64_t data_out[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint stage_stride;
    uint direction;
    uint batch_size;
    uint batch_stride;
};

const float64_t PI = 3.14159265358979323846lf;
const float64_t COS_2PI_7 =  0.62348980185873lf;
const float64_t SIN_2PI_7 =  0.78183148246803lf;
const float64_t COS_4PI_7 = -0.22252093395631lf;
const float64_t SIN_4PI_7 =  0.97492791218182lf;
const float64_t COS_6PI_7 = -0.90096886790242lf;
const float64_t SIN_6PI_7 =  0.43388373911756lf;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint n_butterflies = N / 7;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;
    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    uint group = local_tid / stage_stride;
    uint pos = local_tid % stage_stride;

    // Input indices (Stockham layout)
    uint i0 = group * stage_stride * 7 + pos;
    uint i1 = i0 + stage_stride;
    uint i2 = i1 + stage_stride;
    uint i3 = i2 + stage_stride;
    uint i4 = i3 + stage_stride;
    uint i5 = i4 + stage_stride;
    uint i6 = i5 + stage_stride;

    // Output indices
    uint o0 = group * stage_stride + pos;
    uint o1 = o0 + n_butterflies;
    uint o2 = o1 + n_butterflies;
    uint o3 = o2 + n_butterflies;
    uint o4 = o3 + n_butterflies;
    uint o5 = o4 + n_butterflies;
    uint o6 = o5 + n_butterflies;

    // Twiddle factors
    float64_t base_angle = -2.0lf * PI * float64_t(pos) / float64_t(stage_stride * 7);
    if (direction == 1) base_angle = -base_angle;

    // Load with twiddle
    float64_t a0_re = data_in[(batch_idx * batch_stride+i0)*2], a0_im = data_in[(batch_idx * batch_stride+i0)*2+1];

    float64_t w1_re = float64_t(cos(float(base_angle))), w1_im = float64_t(sin(float(base_angle)));
    float64_t r1 = data_in[(batch_idx * batch_stride+i1)*2], j1 = data_in[(batch_idx * batch_stride+i1)*2+1];
    float64_t a1_re = r1*w1_re - j1*w1_im, a1_im = r1*w1_im + j1*w1_re;

    float64_t w2_re = float64_t(cos(float(2.0lf*base_angle))), w2_im = float64_t(sin(float(2.0lf*base_angle)));
    float64_t r2 = data_in[(batch_idx * batch_stride+i2)*2], j2 = data_in[(batch_idx * batch_stride+i2)*2+1];
    float64_t a2_re = r2*w2_re - j2*w2_im, a2_im = r2*w2_im + j2*w2_re;

    float64_t w3_re = float64_t(cos(float(3.0lf*base_angle))), w3_im = float64_t(sin(float(3.0lf*base_angle)));
    float64_t r3 = data_in[(batch_idx * batch_stride+i3)*2], j3 = data_in[(batch_idx * batch_stride+i3)*2+1];
    float64_t a3_re = r3*w3_re - j3*w3_im, a3_im = r3*w3_im + j3*w3_re;

    float64_t w4_re = float64_t(cos(float(4.0lf*base_angle))), w4_im = float64_t(sin(float(4.0lf*base_angle)));
    float64_t r4 = data_in[(batch_idx * batch_stride+i4)*2], j4 = data_in[(batch_idx * batch_stride+i4)*2+1];
    float64_t a4_re = r4*w4_re - j4*w4_im, a4_im = r4*w4_im + j4*w4_re;

    float64_t w5_re = float64_t(cos(float(5.0lf*base_angle))), w5_im = float64_t(sin(float(5.0lf*base_angle)));
    float64_t r5 = data_in[(batch_idx * batch_stride+i5)*2], j5 = data_in[(batch_idx * batch_stride+i5)*2+1];
    float64_t a5_re = r5*w5_re - j5*w5_im, a5_im = r5*w5_im + j5*w5_re;

    float64_t w6_re = float64_t(cos(float(6.0lf*base_angle))), w6_im = float64_t(sin(float(6.0lf*base_angle)));
    float64_t r6 = data_in[(batch_idx * batch_stride+i6)*2], j6 = data_in[(batch_idx * batch_stride+i6)*2+1];
    float64_t a6_re = r6*w6_re - j6*w6_im, a6_im = r6*w6_im + j6*w6_re;

    // 7-point DFT using symmetric decomposition
    float64_t s1_re = a1_re + a6_re, s1_im = a1_im + a6_im;
    float64_t d1_re = a1_re - a6_re, d1_im = a1_im - a6_im;
    float64_t s2_re = a2_re + a5_re, s2_im = a2_im + a5_im;
    float64_t d2_re = a2_re - a5_re, d2_im = a2_im - a5_im;
    float64_t s3_re = a3_re + a4_re, s3_im = a3_im + a4_im;
    float64_t d3_re = a3_re - a4_re, d3_im = a3_im - a4_im;

    // X[0] = x0 + s1 + s2 + s3
    data_out[(batch_idx * batch_stride+o0)*2]   = a0_re + s1_re + s2_re + s3_re;
    data_out[(batch_idx * batch_stride+o0)*2+1] = a0_im + s1_im + s2_im + s3_im;

    // k=1
    data_out[(batch_idx * batch_stride+o1)*2]   = a0_re + COS_2PI_7*s1_re + COS_4PI_7*s2_re + COS_6PI_7*s3_re
                                            - SIN_2PI_7*d1_im - SIN_4PI_7*d2_im - SIN_6PI_7*d3_im;
    data_out[(batch_idx * batch_stride+o1)*2+1] = a0_im + COS_2PI_7*s1_im + COS_4PI_7*s2_im + COS_6PI_7*s3_im
                                            + SIN_2PI_7*d1_re + SIN_4PI_7*d2_re + SIN_6PI_7*d3_re;

    // k=2
    data_out[(batch_idx * batch_stride+o2)*2]   = a0_re + COS_4PI_7*s1_re + COS_6PI_7*s2_re + COS_2PI_7*s3_re
                                            - SIN_4PI_7*d1_im - SIN_6PI_7*d2_im + SIN_2PI_7*d3_im;
    data_out[(batch_idx * batch_stride+o2)*2+1] = a0_im + COS_4PI_7*s1_im + COS_6PI_7*s2_im + COS_2PI_7*s3_im
                                            + SIN_4PI_7*d1_re + SIN_6PI_7*d2_re - SIN_2PI_7*d3_re;

    // k=3
    data_out[(batch_idx * batch_stride+o3)*2]   = a0_re + COS_6PI_7*s1_re + COS_2PI_7*s2_re + COS_4PI_7*s3_re
                                            - SIN_6PI_7*d1_im + SIN_2PI_7*d2_im + SIN_4PI_7*d3_im;
    data_out[(batch_idx * batch_stride+o3)*2+1] = a0_im + COS_6PI_7*s1_im + COS_2PI_7*s2_im + COS_4PI_7*s3_im
                                            + SIN_6PI_7*d1_re - SIN_2PI_7*d2_re - SIN_4PI_7*d3_re;

    // k=4 (conjugate symmetry with k=3)
    data_out[(batch_idx * batch_stride+o4)*2]   = a0_re + COS_6PI_7*s1_re + COS_2PI_7*s2_re + COS_4PI_7*s3_re
                                            + SIN_6PI_7*d1_im - SIN_2PI_7*d2_im - SIN_4PI_7*d3_im;
    data_out[(batch_idx * batch_stride+o4)*2+1] = a0_im + COS_6PI_7*s1_im + COS_2PI_7*s2_im + COS_4PI_7*s3_im
                                            - SIN_6PI_7*d1_re + SIN_2PI_7*d2_re + SIN_4PI_7*d3_re;

    // k=5 (conjugate symmetry with k=2)
    data_out[(batch_idx * batch_stride+o5)*2]   = a0_re + COS_4PI_7*s1_re + COS_6PI_7*s2_re + COS_2PI_7*s3_re
                                            + SIN_4PI_7*d1_im + SIN_6PI_7*d2_im - SIN_2PI_7*d3_im;
    data_out[(batch_idx * batch_stride+o5)*2+1] = a0_im + COS_4PI_7*s1_im + COS_6PI_7*s2_im + COS_2PI_7*s3_im
                                            - SIN_4PI_7*d1_re - SIN_6PI_7*d2_re + SIN_2PI_7*d3_re;

    // k=6 (conjugate symmetry with k=1)
    data_out[(batch_idx * batch_stride+o6)*2]   = a0_re + COS_2PI_7*s1_re + COS_4PI_7*s2_re + COS_6PI_7*s3_re
                                            + SIN_2PI_7*d1_im + SIN_4PI_7*d2_im + SIN_6PI_7*d3_im;
    data_out[(batch_idx * batch_stride+o6)*2+1] = a0_im + COS_2PI_7*s1_im + COS_4PI_7*s2_im + COS_6PI_7*s3_im
                                            - SIN_2PI_7*d1_re - SIN_4PI_7*d2_re - SIN_6PI_7*d3_re;
}
