#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Bitonic sort (Float64 variant)
// One compare-and-swap pass per dispatch
// Operates on (value, index) pairs: sorts by value, produces sorted indices
// Multiple dispatches required: log2(N) * (log2(N)+1) / 2 passes total
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Values { double values[]; };
layout(binding = 1) buffer Indices { int indices[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint padded_n;
    uint stage;
    uint substage;
    uint descending;
} params;

void main() {
    uint gid = gl_GlobalInvocationID.x;

    if (gid >= params.padded_n / 2) return;

    uint block_size = 1u << (params.stage + 1);
    uint half_block = 1u << params.substage;

    uint block_id = gid / half_block;
    uint offset = gid % half_block;

    uint i = block_id * (half_block * 2) + offset;
    uint j = i + half_block;

    if (j >= params.padded_n) return;

    // F140: block_ascending is the network's own merge-structure direction,
    // independent of the requested global sort order (see bitonic_sort.comp).
    uint sort_block = i / block_size;
    bool block_ascending = ((sort_block % 2) == 0);
    bool ascending_block = block_ascending;
    if (params.descending != 0) ascending_block = !ascending_block;

    double val_i = values[i];
    double val_j = values[j];
    int idx_i = indices[i];
    int idx_j = indices[j];

    // F138: NaN-aware, STABLE comparator (see bitonic_sort.comp). NaN -> +INF,
    // value ties broken by original index (stability + real-before-padding).
    double ka = isnan(val_i) ? packDouble2x32(uvec2(0u, 0x7FF00000u)) : val_i;
    double kb = isnan(val_j) ? packDouble2x32(uvec2(0u, 0x7FF00000u)) : val_j;

    // F139/F140: value direction (ascending_block) is XORed with
    // params.descending; tie-break direction (block_ascending) is NOT --
    // ties must always break by ascending original index regardless of sort
    // direction, while still following the 0-1-principle R/R' network
    // structure. See bitonic_sort.comp for the full rationale.
    bool should_swap;
    bool tie_break = block_ascending ? (idx_i > idx_j) : (idx_i < idx_j);
    if (ascending_block) {
        should_swap = (ka > kb) || (ka == kb && tie_break);
    } else {
        should_swap = (ka < kb) || (ka == kb && tie_break);
    }

    if (should_swap) {
        values[i] = val_j;
        values[j] = val_i;
        int tmp = indices[i];
        indices[i] = indices[j];
        indices[j] = tmp;
    }
}
