#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Scatter for Complex128: each element is two float64 lanes (re, im).
// reduction 0=overwrite, 1=add, 2=complex-multiply. Reductions 1/2 are
// non-atomic (racy for duplicate destination indices), matching the
// "last/under-defined for duplicates" contract; overwrite is the common path.
layout(local_size_x_id = 0) in;

layout(binding = 0) buffer Input { float64_t input_data[]; };   // 2 per element
layout(binding = 1) buffer Indices { int indices[]; };
layout(binding = 2) buffer Output { float64_t output_data[]; }; // 2 per element
layout(binding = 3) buffer Values { float64_t values[]; };      // 2 per element

layout(push_constant) uniform PushConstants {
    uint input_size;        // indices.numel() (== values.numel())
    uint ndim;              // <= 8
    uint dim;               // normalized scatter dim
    uint dim_size;          // self_shape[dim] (wrap + bounds)
    uint output_size;       // total output/self size (OOB guard)
    uint reduction;         // 0=none, 1=add, 2=multiply
    uint use_values;        // 0=use input_data, 1=use values buffer
    uint _pad;
    uvec4 index_strides0;   // INDEX contiguous strides, dims 0..3
    uvec4 index_strides1;   // dims 4..7
    uvec4 self_strides0;    // SELF contiguous strides, dims 0..3
    uvec4 self_strides1;    // dims 4..7
} params;

uint idxStride(uint d)  { return (d < 4u) ? params.index_strides0[d] : params.index_strides1[d - 4u]; }
uint selfStride(uint d) { return (d < 4u) ? params.self_strides0[d]  : params.self_strides1[d - 4u]; }

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.input_size) return;

    int scatter_idx = indices[idx];
    if (scatter_idx < 0) scatter_idx += int(params.dim_size);
    if (scatter_idx < 0 || scatter_idx >= int(params.dim_size)) return;

    uint temp = idx;
    uint out_idx = 0u;
    for (uint d = 0u; d < params.ndim; ++d) {
        uint coord = temp / idxStride(d);
        temp = temp % idxStride(d);
        if (d == params.dim) {
            out_idx += uint(scatter_idx) * selfStride(d);
        } else {
            out_idx += coord * selfStride(d);
        }
    }

    // Guard the computed output offset against the destination size. The non-scatter
    // dims of the values/index tensor can exceed the output's, yielding out_idx >=
    // output_size; without this guard the two-lane (re/im) write below is an
    // out-of-bounds device write. output_size counts complex elements, so guarding
    // out_idx covers both 2u*out_idx and 2u*out_idx+1u.
    if (out_idx >= params.output_size) return;

    float64_t re = (params.use_values > 0u) ? values[2u * idx]      : input_data[2u * idx];
    float64_t im = (params.use_values > 0u) ? values[2u * idx + 1u] : input_data[2u * idx + 1u];

    if (params.reduction == 1u) {
        output_data[2u * out_idx]      = output_data[2u * out_idx] + re;
        output_data[2u * out_idx + 1u] = output_data[2u * out_idx + 1u] + im;
    } else if (params.reduction == 2u) {
        float64_t orr = output_data[2u * out_idx];
        float64_t oii = output_data[2u * out_idx + 1u];
        output_data[2u * out_idx]      = orr * re - oii * im;
        output_data[2u * out_idx + 1u] = orr * im + oii * re;
    } else {
        output_data[2u * out_idx]      = re;
        output_data[2u * out_idx + 1u] = im;
    }
}
