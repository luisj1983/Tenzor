#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// ROI Align Backward Pass (Float64)
// Distributes gradients from output back to feature map using bilinear weights.
// Each invocation owns one output bin (roi, c, ph, pw) and scatters into the four
// neighbouring input feature pixels. Overlapping bins/ROIs alias the same input
// pixel from concurrent invocations, so the scatter MUST be atomic to avoid lost
// updates. Vulkan has no native f64 atomicAdd, so grad_features is bound as a
// uint64 SSBO and accumulated via a bit-cast atomicCompSwap loop (the same pattern
// used by max_pool2d_backward_f64 and the other f64 scatter-backward shaders).

layout(local_size_x_id = 0) in;

layout(binding = 0) buffer GradOutput { float64_t grad_output_data[]; };
layout(binding = 1) buffer ROIs { float64_t rois_data[]; };
layout(binding = 2) buffer GradFeatures { uint64_t grad_features_data[]; }; // uint64 for CAS atomics

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint num_rois;
    uint channels;
    uint feat_height;
    uint feat_width;
    uint output_h;
    uint output_w;
    uint spatial_scale_bits;
    uint sampling_ratio;
    uint aligned;
    uint batch_size;
} params;

// Bit-cast helpers between float64 and its uint64 representation.
float64_t bitsToF64(uint64_t bits) {
    return float64_t(packDouble2x32(uvec2(uint(bits), uint(bits >> 32u))));
}

uint64_t f64ToBits(float64_t val) {
    uvec2 v = unpackDouble2x32(double(val));
    return uint64_t(v.x) | (uint64_t(v.y) << 32u);
}

// Race-free f64 accumulation via CAS loop on the uint64 representation.
void atomicAddF64(uint idx, float64_t val) {
    uint64_t old_bits = grad_features_data[idx];
    uint64_t new_bits;
    for (int attempt = 0; attempt < 65536; ++attempt) {
        float64_t old_val = bitsToF64(old_bits);
        new_bits = f64ToBits(old_val + val);
        uint64_t result = atomicCompSwap(grad_features_data[idx], old_bits, new_bits);
        if (result == old_bits) return;
        old_bits = result;
    }
    grad_features_data[idx] = new_bits;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= params.n_elements) {
        return;
    }

    uint temp = idx;
    uint pw = temp % params.output_w;
    temp /= params.output_w;
    uint ph = temp % params.output_h;
    temp /= params.output_h;
    uint c = temp % params.channels;
    uint roi_idx = temp / params.channels;

    uint roi_base = roi_idx * 5;
    // Validate ROI batch index before scattering grad into features (unguarded
    // atomic write at an out-of-range batch_idx is an out-of-bounds device write).
    int batch_idx_signed = int(rois_data[roi_base]);
    if (batch_idx_signed < 0 || uint(batch_idx_signed) >= params.batch_size) {
        return;
    }
    uint batch_idx = uint(batch_idx_signed);
    float64_t spatial_scale = float64_t(uintBitsToFloat(params.spatial_scale_bits));

    float64_t roi_x1 = rois_data[roi_base + 1] * spatial_scale;
    float64_t roi_y1 = rois_data[roi_base + 2] * spatial_scale;
    float64_t roi_x2 = rois_data[roi_base + 3] * spatial_scale;
    float64_t roi_y2 = rois_data[roi_base + 4] * spatial_scale;

    if (params.aligned != 0) {
        roi_x1 -= 0.5lf;
        roi_y1 -= 0.5lf;
        roi_x2 -= 0.5lf;
        roi_y2 -= 0.5lf;
    }

    float64_t roi_width = roi_x2 - roi_x1;
    float64_t roi_height = roi_y2 - roi_y1;

    float64_t bin_size_h = roi_height / float64_t(params.output_h);
    float64_t bin_size_w = roi_width / float64_t(params.output_w);

    uint roi_bin_grid_h = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : uint(ceil(bin_size_h));
    uint roi_bin_grid_w = (params.sampling_ratio > 0)
        ? params.sampling_ratio
        : uint(ceil(bin_size_w));

    uint count = roi_bin_grid_h * roi_bin_grid_w;
    // Accumulate in full f64 precision (the CAS atomic add operates on f64).
    float64_t grad_val = grad_output_data[idx] / float64_t(count);

    uint base_offset = batch_idx * params.channels * params.feat_height * params.feat_width
                     + c * params.feat_height * params.feat_width;

    int height = int(params.feat_height);
    int width = int(params.feat_width);

    for (uint iy = 0; iy < roi_bin_grid_h; iy++) {
        for (uint ix = 0; ix < roi_bin_grid_w; ix++) {
            float64_t y = roi_y1 + float64_t(ph) * bin_size_h
                        + (float64_t(iy) + 0.5lf) * bin_size_h / float64_t(roi_bin_grid_h);
            float64_t x = roi_x1 + float64_t(pw) * bin_size_w
                        + (float64_t(ix) + 0.5lf) * bin_size_w / float64_t(roi_bin_grid_w);

            if (y < -1.0lf || y > float64_t(height) || x < -1.0lf || x > float64_t(width)) {
                continue;
            }

            y = max(0.0lf, min(y, float64_t(height - 1)));
            x = max(0.0lf, min(x, float64_t(width - 1)));

            int y_low = int(floor(y));
            int x_low = int(floor(x));
            int y_high = min(y_low + 1, height - 1);
            int x_high = min(x_low + 1, width - 1);

            float64_t ly = y - float64_t(y_low);
            float64_t lx = x - float64_t(x_low);
            float64_t hy = 1.0lf - ly;
            float64_t hx = 1.0lf - lx;

            // Race-free scatter into the four neighbouring input pixels.
            uint off1 = base_offset + uint(y_low) * uint(width) + uint(x_low);
            uint off2 = base_offset + uint(y_low) * uint(width) + uint(x_high);
            uint off3 = base_offset + uint(y_high) * uint(width) + uint(x_low);
            uint off4 = base_offset + uint(y_high) * uint(width) + uint(x_high);

            atomicAddF64(off1, grad_val * hy * hx);
            atomicAddF64(off2, grad_val * hy * lx);
            atomicAddF64(off3, grad_val * ly * hx);
            atomicAddF64(off4, grad_val * ly * lx);
        }
    }
}
