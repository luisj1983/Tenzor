#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Complex128 abs: |a + bi| = hypot(a, b). Output is Float64.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { double data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { double data_out[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;
    double re = data_in[idx * 2u];
    double im = data_in[idx * 2u + 1u];
    double ar = abs(re);
    double ai = abs(im);
    double m = max(ar, ai);
    if (m == 0.0lf) { data_out[idx] = 0.0lf; return; }
    double r = ar / m;
    double i = ai / m;
    data_out[idx] = m * sqrt(r * r + i * i);
}
