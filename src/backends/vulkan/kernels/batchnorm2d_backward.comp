#version 450
#extension GL_EXT_shader_atomic_float : enable

// Batch Normalization 2D Backward — Pass 1: compute grad_gamma / grad_beta.
//   grad_gamma[c] = sum over (n,h,w) of grad_out * (x - mean)/sqrt(var+eps)
//   grad_beta[c]  = sum over (n,h,w) of grad_out
// Pass 2 (see batchnorm2d_backward_grad_input.comp) uses these sums to
// compute grad_input with the correct batch-norm formula:
//   grad_in = gamma * invstd * (N*grad_out - sum_grad - normalized*sum_grad_norm) / N
// The previous single-pass shader returned only `grad_out * gamma * invstd`,
// which is the *inference-mode* backward — it dropped the two mean-correction
// terms required during training.

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer GradOutput { float grad_output[]; };  // (N, C, H, W)
layout(binding = 1) buffer Input      { float input_data[]; };   // (N, C, H, W)
layout(binding = 2) buffer Mean       { float mean_data[]; };    // (C)
layout(binding = 3) buffer InvStd     { float invstd_data[]; };  // (C) — 1/sqrt(var+eps)
layout(binding = 4) buffer Gamma      { float gamma_data[]; };   // (C) — unused in pass 1
layout(binding = 5) buffer GradInput  { float grad_input[]; };   // written in pass 2
layout(binding = 6) buffer GradGamma  { float grad_gamma[]; };   // (C) — atomically accumulated
layout(binding = 7) buffer GradBeta   { float grad_beta[]; };    // (C) — atomically accumulated

layout(push_constant) uniform PushConstants {
    uint n_elements;
    uint batch;
    uint channels;
    uint spatial_size;
    float eps;
    uint has_gamma;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.n_elements) return;

    uint temp = idx;
    temp /= params.spatial_size;
    uint c = temp % params.channels;

    float x = input_data[idx];
    float grad_out = grad_output[idx];
    float mean = mean_data[c];
    float inv_std = invstd_data[c];
    float normalized = (x - mean) * inv_std;

    // Accumulate directly into the per-channel global buffers. Collisions are
    // resolved by atomicAdd; this trades throughput for correctness vs the
    // previous shared-memory path that hashed `c % 256` and dropped writes
    // when two channels mapped to the same slot.
    atomicAdd(grad_gamma[c], grad_out * normalized);
    atomicAdd(grad_beta[c],  grad_out);
}
