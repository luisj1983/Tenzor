#version 450

// Non-symmetric real eigendecomposition (Float32), arbitrary n.
// One invocation per batch element over global-memory scratch; no shared
// memory, no barriers. Faithful EISPACK hqr2: orthogonal Hessenberg reduction
// (Householder, V accumulated) -> real Schur form via Francis double-shift QR
// with deflation + exceptional shifts at iters 10/20 -> eigenvector back-
// substitution (with overflow control) -> map to original basis (V <- V*H) ->
// unit 2-norm. Output packing matches LAPACK geev: real eigenvalue k -> column
// k; complex pair (wi[k]>0) -> column k = Re, column k+1 = Im (conjugate next).
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer HBuf  { float Hbuf[];  };  // input copy -> Schur form -> eigvecs
layout(set = 0, binding = 1) buffer VBuf  { float Vbuf[];  };  // eigenvector output
layout(set = 0, binding = 2) buffer WRBuf { float WRbuf[]; };
layout(set = 0, binding = 3) buffer WIBuf { float WIbuf[]; };
layout(set = 0, binding = 4) buffer VsBuf { float Vsbuf[]; };  // Householder scratch, length n

layout(push_constant) uniform PushConstants {
    uint n;
    uint nbatch;
};

float csign(float a, float b) { return (b < 0.0) ? -abs(a) : abs(a); }

void cdiv(float cr, float ci, float dr, float di, out float zr, out float zi) {
    if (abs(dr) > abs(di)) {
        float r = di / dr; float d = dr + di * r;
        zr = (cr + ci * r) / d; zi = (ci - cr * r) / d;
    } else {
        float r = dr / di; float d = di + dr * r;
        zr = (cr * r + ci) / d; zi = (ci * r - cr) / d;
    }
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= nbatch) return;
    int n = int(n);
    uint hb = gid * uint(n) * uint(n);
    uint wb = gid * uint(n);
    const float eps = 1.19e-7;

    // local index helpers via macros-as-expressions
    #define H(i,j) Hbuf[hb + uint((i)*n + (j))]
    #define Z(i,j) Vbuf[hb + uint((i)*n + (j))]
    #define WR(i)  WRbuf[wb + uint(i)]
    #define WI(i)  WIbuf[wb + uint(i)]
    #define VV(i)  Vsbuf[wb + uint(i)]

    for (int i = 0; i < n; ++i) { for (int j = 0; j < n; ++j) Z(i,j) = 0.0; Z(i,i) = 1.0; }

    // orthogonal Hessenberg reduction (Householder), accumulate Z
    for (int k = 0; k + 2 < n; ++k) {
        float sigma = 0.0;
        for (int i = k+1; i < n; ++i) sigma += H(i,k)*H(i,k);
        if (sigma == 0.0) continue;
        float nx = sqrt(sigma);
        float a = -csign(nx, H(k+1,k));
        VV(k+1) = H(k+1,k) - a;
        for (int i = k+2; i < n; ++i) VV(i) = H(i,k);
        float vn2 = 0.0;
        for (int i = k+1; i < n; ++i) vn2 += VV(i)*VV(i);
        if (vn2 == 0.0) continue;
        float tau = 2.0/vn2;
        for (int j = 0; j < n; ++j) { float d=0.0; for(int i=k+1;i<n;++i) d+=VV(i)*H(i,j); d*=tau; for(int i=k+1;i<n;++i) H(i,j)-=VV(i)*d; }
        for (int i = 0; i < n; ++i) { float d=0.0; for(int j=k+1;j<n;++j) d+=H(i,j)*VV(j); d*=tau; for(int j=k+1;j<n;++j) H(i,j)-=d*VV(j); }
        for (int i = 0; i < n; ++i) { float d=0.0; for(int j=k+1;j<n;++j) d+=Z(i,j)*VV(j); d*=tau; for(int j=k+1;j<n;++j) Z(i,j)-=d*VV(j); }
        H(k+1,k) = a;
        for (int i = k+2; i < n; ++i) H(i,k) = 0.0;
    }

    // hqr2: real Schur form + eigenvalues
    float norm = 0.0;
    for (int i = 0; i < n; ++i) { int j0 = (i-1 > 0) ? i-1 : 0; for (int j = j0; j < n; ++j) norm += abs(H(i,j)); }
    float t = 0.0;
    int en = n - 1;
    while (en >= 0) {
        int its = 0; int na = en - 1;
        while (true) {
            int l;
            for (l = en; l >= 1; --l) {
                float s = abs(H(l-1,l-1)) + abs(H(l,l));
                if (s == 0.0) s = norm;
                if (abs(H(l,l-1)) <= eps*s) break;
            }
            float x = H(en,en);
            if (l == en) { H(en,en) = x + t; WR(en) = H(en,en); WI(en) = 0.0; en -= 1; break; }
            float y = H(na,na);
            float w = H(en,na)*H(na,en);
            if (l == na) {
                float p = 0.5*(y - x);
                float q = p*p + w;
                float zz = sqrt(abs(q));
                x = x + t; H(en,en) = x; H(na,na) = y + t;
                if (q >= 0.0) {
                    zz = p + csign(zz, p);
                    WR(na) = x + zz; WR(en) = x + zz;
                    if (zz != 0.0) WR(en) = x - w/zz;
                    WI(na) = 0.0; WI(en) = 0.0;
                    x = H(en,na);
                    float s = abs(x) + abs(zz);
                    float p2 = x/s; float q2 = zz/s;
                    float r = sqrt(p2*p2 + q2*q2);
                    p2 /= r; q2 /= r;
                    for (int j = na; j < n; ++j) { float t1=H(na,j); H(na,j)=q2*t1+p2*H(en,j); H(en,j)=q2*H(en,j)-p2*t1; }
                    for (int i = 0; i <= en; ++i) { float t1=H(i,na); H(i,na)=q2*t1+p2*H(i,en); H(i,en)=q2*H(i,en)-p2*t1; }
                    for (int i = 0; i < n; ++i)  { float t1=Z(i,na); Z(i,na)=q2*t1+p2*Z(i,en); Z(i,en)=q2*Z(i,en)-p2*t1; }
                } else { WR(na) = x + p; WR(en) = x + p; WI(na) = zz; WI(en) = -zz; }
                en -= 2; break;
            }
            if (its == 30) { en = -1; break; }
            if (its == 10 || its == 20) {
                t += x;
                for (int i = 0; i <= en; ++i) H(i,i) -= x;
                float s = abs(H(en,na)) + abs(H(na,na-1));
                x = 0.75*s; y = x; w = -0.4375*s*s;
            }
            its += 1;
            float p; float q; float r; int m;
            for (m = en-2; m >= l; --m) {
                float zz = H(m,m);
                r = x - zz; float s = y - zz;
                p = (r*s - w)/H(m+1,m) + H(m,m+1);
                q = H(m+1,m+1) - zz - r - s;
                r = H(m+2,m+1);
                float sc = abs(p)+abs(q)+abs(r);
                p /= sc; q /= sc; r /= sc;
                if (m == l) break;
                float tst1 = abs(p)*(abs(H(m-1,m-1))+abs(zz)+abs(H(m+1,m+1)));
                float tst2 = abs(H(m,m-1))*(abs(q)+abs(r));
                if (tst2 <= eps*tst1) break;
            }
            for (int i = m+2; i <= en; ++i) { H(i,i-2)=0.0; if (i != m+2) H(i,i-3)=0.0; }
            for (int k = m; k <= na; ++k) {
                bool notlast = (k != na);
                if (k != m) {
                    p = H(k,k-1); q = H(k+1,k-1); r = notlast ? H(k+2,k-1) : 0.0;
                    x = abs(p)+abs(q)+abs(r);
                    if (x == 0.0) continue;
                    p /= x; q /= x; r /= x;
                }
                float s = csign(sqrt(p*p+q*q+r*r), p);
                if (k == m) { if (l != m) H(k,k-1) = -H(k,k-1); }
                else H(k,k-1) = -s*x;
                p += s;
                float xx = p/s; float yy = q/s; float zz = r/s;
                q /= p; r /= p;
                for (int j = k; j < n; ++j) {
                    p = H(k,j) + q*H(k+1,j);
                    if (notlast) { p += r*H(k+2,j); H(k+2,j) -= p*zz; }
                    H(k+1,j) -= p*yy; H(k,j) -= p*xx;
                }
                int jmax = (en < k+3) ? en : k+3;
                for (int i = 0; i <= jmax; ++i) {
                    p = xx*H(i,k) + yy*H(i,k+1);
                    if (notlast) { p += zz*H(i,k+2); H(i,k+2) -= p*r; }
                    H(i,k+1) -= p*q; H(i,k) -= p;
                }
                for (int i = 0; i < n; ++i) {
                    p = xx*Z(i,k) + yy*Z(i,k+1);
                    if (notlast) { p += zz*Z(i,k+2); Z(i,k+2) -= p*r; }
                    Z(i,k+1) -= p*q; Z(i,k) -= p;
                }
            }
        }
    }

    // eigenvector back-substitution on the Schur form
    if (norm != 0.0) {
        for (int e = n-1; e >= 0; --e) {
            float p = WR(e); float q = WI(e);
            int na2 = e - 1;
            if (q == 0.0) {
                int m = e; H(e,e) = 1.0;
                float zz_s = 0.0; float s_s = 0.0;
                for (int i = e-1; i >= 0; --i) {
                    float w = H(i,i) - p;
                    float r = 0.0;
                    for (int j = m; j <= e; ++j) r += H(i,j)*H(j,e);
                    if (WI(i) < 0.0) { zz_s = w; s_s = r; continue; }
                    m = i;
                    if (WI(i) == 0.0) {
                        float tt = (w == 0.0) ? eps*norm : w;
                        H(i,e) = -r/tt;
                    } else {
                        float xx = H(i,i+1); float yv = H(i+1,i);
                        float qd = (WR(i)-p)*(WR(i)-p) + WI(i)*WI(i);
                        float tt = (xx*s_s - zz_s*r)/qd;
                        H(i,e) = tt;
                        if (abs(xx) > abs(zz_s)) H(i+1,e) = (-r - w*tt)/xx;
                        else                     H(i+1,e) = (-s_s - yv*tt)/zz_s;
                    }
                    float tmag = abs(H(i,e));
                    if ((eps*tmag)*tmag > 1.0) for (int j = i; j <= e; ++j) H(j,e) /= tmag;
                }
            } else if (q < 0.0) {
                int m = na2;
                if (abs(H(e,na2)) > abs(H(na2,e))) {
                    H(na2,na2) = q/H(e,na2);
                    H(na2,e)   = -(H(e,e)-p)/H(e,na2);
                } else {
                    float zr; float zi; cdiv(0.0, -H(na2,e), H(na2,na2)-p, q, zr, zi);
                    H(na2,na2) = zr; H(na2,e) = zi;
                }
                H(e,na2) = 0.0; H(e,e) = 1.0;
                float zz_s = 0.0; float ra_s = 0.0; float sa_s = 0.0;
                for (int i = e-2; i >= 0; --i) {
                    float w = H(i,i) - p;
                    float ra = 0.0; float sa = 0.0;
                    for (int j = m; j <= e; ++j) { ra += H(i,j)*H(j,na2); sa += H(i,j)*H(j,e); }
                    if (WI(i) < 0.0) { zz_s = w; ra_s = ra; sa_s = sa; continue; }
                    m = i;
                    if (WI(i) == 0.0) {
                        float zr; float zi; cdiv(-ra, -sa, w, q, zr, zi);
                        H(i,na2) = zr; H(i,e) = zi;
                    } else {
                        float xx = H(i,i+1); float yv = H(i+1,i);
                        float vr = (WR(i)-p)*(WR(i)-p) + WI(i)*WI(i) - q*q;
                        float vi = (WR(i)-p)*2.0*q;
                        if (vr == 0.0 && vi == 0.0)
                            vr = eps*norm*(abs(w)+abs(q)+abs(xx)+abs(yv)+abs(zz_s));
                        float zr; float zi;
                        cdiv(xx*ra_s - zz_s*ra + q*sa, xx*sa_s - zz_s*sa - q*ra, vr, vi, zr, zi);
                        H(i,na2) = zr; H(i,e) = zi;
                        if (abs(xx) > abs(zz_s) + abs(q)) {
                            H(i+1,na2) = (-ra - w*H(i,na2) + q*H(i,e))/xx;
                            H(i+1,e)   = (-sa - w*H(i,e) - q*H(i,na2))/xx;
                        } else {
                            float z2r; float z2i; cdiv(-ra_s - yv*H(i,na2), -sa_s - yv*H(i,e), zz_s, q, z2r, z2i);
                            H(i+1,na2) = z2r; H(i+1,e) = z2i;
                        }
                    }
                    float tmag = max(abs(H(i,na2)), abs(H(i,e)));
                    if ((eps*tmag)*tmag > 1.0) for (int j = i; j <= e; ++j) { H(j,na2) /= tmag; H(j,e) /= tmag; }
                }
            }
        }
        for (int j = n-1; j >= 0; --j)
            for (int i = 0; i < n; ++i) {
                float s = 0.0;
                for (int k = 0; k <= j; ++k) s += Z(i,k)*H(k,j);
                Z(i,j) = s;
            }
    }

    // normalize each (complex) eigenvector to unit 2-norm
    for (int k = 0; k < n; ++k) {
        if (WI(k) > 0.0) {
            float nrm = 0.0; for (int i=0;i<n;++i) nrm += Z(i,k)*Z(i,k)+Z(i,k+1)*Z(i,k+1);
            nrm = sqrt(nrm); if (nrm>0.0) for(int i=0;i<n;++i){ Z(i,k)/=nrm; Z(i,k+1)/=nrm; }
            ++k;
        } else if (WI(k) == 0.0) {
            float nrm = 0.0; for (int i=0;i<n;++i) nrm += Z(i,k)*Z(i,k);
            nrm = sqrt(nrm); if (nrm>0.0) for(int i=0;i<n;++i) Z(i,k)/=nrm;
        }
    }
}
