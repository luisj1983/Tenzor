#version 450

// Cooley-Tukey radix-2 FFT (complex-to-complex), multi-pass: each dispatch
// handles one butterfly stage, reading and writing global memory directly
// (no shared-memory staging — invocations across the workgroup are independent).
// Data layout: interleaved real/imag pairs — [re0, im0, re1, im1, ...]

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) buffer InputBuf  { float data_in[];  };
layout(set = 0, binding = 1) buffer OutputBuf { float data_out[]; };

layout(push_constant) uniform PushConstants {
    uint n;            // FFT size (power of 2)
    uint stage;        // Current butterfly stage (0 to log2(n)-1)
    uint direction;    // 0 = forward, 1 = inverse
    uint batch_size;   // Number of independent FFTs
    uint batch_stride; // Stride between batches (in complex elements)
};


const float PI = 3.14159265358979323846;

void main() {
    uint tid = gl_GlobalInvocationID.x;

    uint n_butterflies = n / 2;
    uint total_items = n_butterflies * batch_size;
    if (tid >= total_items) return;

    uint batch_idx = tid / n_butterflies;
    uint local_tid = tid % n_butterflies;

    // Each thread handles one butterfly pair
    uint half_size = 1u << stage;
    uint group_size = half_size << 1;

    uint group_idx = local_tid / half_size;
    uint pos_in_group = local_tid % half_size;

    uint idx_top = group_idx * group_size + pos_in_group;
    uint idx_bot = idx_top + half_size;

    if (idx_bot >= n) return;

    // Apply batch stride (each complex element = 2 floats)
    uint base_top = (batch_idx * batch_stride + idx_top) * 2;
    uint base_bot = (batch_idx * batch_stride + idx_bot) * 2;

    float a_re = data_in[base_top];
    float a_im = data_in[base_top + 1];
    float b_re = data_in[base_bot];
    float b_im = data_in[base_bot + 1];

    // Twiddle w = exp(-i*2*PI*pos/group_size). pos/group_size is in [0, 0.5),
    // so the raw angle spans up to PI — past PI/2 GLSL cos/sin lose precision
    // (only ~2^-11 absolute is guaranteed outside [-PI/2, PI/2]). Reduce the
    // first-quadrant fraction so the trig argument stays in [0, PI/2], then
    // rebuild cos/sin by quadrant. Matters for the Bluestein internal FFTs whose
    // near-zero output bins are otherwise inflated.
    float frac = float(pos_in_group) / float(group_size);   // [0, 0.5)
    float x = 2.0 * PI * frac;                               // [0, PI)
    float c, s;                                              // cos(x), sin(x)
    if (x > 0.5 * PI) {
        float y = x - 0.5 * PI;                             // (0, PI/2]
        c = -sin(y);
        s =  cos(y);
    } else {
        c = cos(x);
        s = sin(x);
    }
    // angle = -x for forward, +x for inverse. cos is even, sin is odd.
    float w_re = c;
    float w_im = (direction == 1) ? s : -s;

    float tw_re = b_re * w_re - b_im * w_im;
    float tw_im = b_re * w_im + b_im * w_re;

    data_out[base_top]     = a_re + tw_re;
    data_out[base_top + 1] = a_im + tw_im;
    data_out[base_bot]     = a_re - tw_re;
    data_out[base_bot + 1] = a_im - tw_im;
}
