#version 450

// Radix sort: scatter pass — write keys and indices to sorted positions
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer KeysIn   { float keys_in[];   };
layout(set = 0, binding = 1) readonly buffer IdxIn    { int idx_in[];      };
layout(set = 0, binding = 2) buffer KeysOut            { float keys_out[];  };
layout(set = 0, binding = 3) buffer IdxOut             { int idx_out[];     };
layout(set = 0, binding = 4) buffer Histograms         { uint histos[];     };

layout(push_constant) uniform PushConstants {
    uint n;
    uint digit;
    uint n_wgs;
    uint descending; // 0 = ascending, 1 = descending
};

shared uint local_offsets[256];

// Must derive exactly the same digit as the histogram pass, so apply the same
// descending key inversion here: an ascending LSD radix over the inverted key
// yields descending values with stable (ascending-index) tie order.
uint float_to_sortable(float val) {
    uint bits = floatBitsToUint(val);
    uint mask = -int(bits >> 31) | 0x80000000u;
    uint sortable = bits ^ mask;
    if (descending != 0u) sortable = ~sortable;
    return sortable;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    // Load this workgroup's prefix sums into shared memory. The offset table
    // always has exactly 256 bins, but the workgroup size is a runtime spec
    // constant (local_size_x_id=0) that can be <256 or >256, so load all 256
    // bins via a strided loop rather than one-bin-per-thread (which would leave
    // local_offsets[wgSize..255] uninitialized for wgSize<256 and read/write
    // past local_offsets[256] for wgSize>256).
    for (uint b = lid; b < 256u; b += gl_WorkGroupSize.x) {
        local_offsets[b] = histos[b * n_wgs + wg_id];
    }
    barrier();

    // Process this workgroup's tile
    uint tile_size = (n + n_wgs - 1) / n_wgs;
    uint tile_start = wg_id * tile_size;
    uint tile_end = min(tile_start + tile_size, n);

    // STABILITY: LSD radix is only correct if, within each pass, elements that
    // share a digit keep their ASCENDING-INDEX order (the host depends on this
    // — see vulkan_ops_sort.cpp — and the CPU reference is stable). A parallel
    // `dest = atomicAdd(local_offsets[digit],1)` assigns consecutive slots in
    // atomic-arbitration order, NOT index order, so equal-digit elements within
    // a tile come out in a non-deterministic permutation — a wrong (unstable)
    // sort/argsort/topk tie order that diverges from CPU.
    //
    // To guarantee stability we scatter each tile in strict index order. A
    // single lane walks tile_start..tile_end and consumes per-digit offsets
    // sequentially, so element i is always placed before element j whenever
    // i<j and they share a digit. local_offsets is per-workgroup (loaded from
    // this wg's histogram slice), so different workgroups still scatter into
    // disjoint, correctly-based ranges in parallel; only the WITHIN-tile order
    // is serialized, which is what stability requires. No atomics are needed
    // because only one lane mutates local_offsets.
    barrier();
    if (lid == 0u) {
        for (uint i = tile_start; i < tile_end; ++i) {
            uint sortable = float_to_sortable(keys_in[i]);
            uint digit_val = (sortable >> (digit * 8)) & 0xFFu;
            uint dest = local_offsets[digit_val];
            local_offsets[digit_val] = dest + 1u;
            keys_out[dest] = keys_in[i];
            idx_out[dest] = idx_in[i];
        }
    }
}
