#version 450

// Log Softmax with numerical stability (Float32).
//
// The sum-of-exp is accumulated in FLOAT to match the CPU/CUDA/ROCm/oneAPI/MPS
// reference implementations, which all accumulate this reduction in float for
// Float32 inputs. Vulkan previously accumulated in double (via a software f64
// Taylor-series exp), which — while more accurate — made it the sole outlier
// and broke tight cross-backend parity tolerances. The F64 path lives in
// log_softmax_f64.comp and keeps double accumulation.
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint dim;
} params;

shared float shared_max[WORKGROUP_SIZE];
shared float shared_sum[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.num_classes;

    // Step 1: Find maximum for numerical stability
    float local_max = -1.0 / 0.0; // -infinity
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        local_max = max(local_max, input_data[base_idx + i]);
    }
    shared_max[tid] = local_max;
    barrier();

    // Parallel reduction for max
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
        }
        barrier();
    }

    float row_max = shared_max[0];
    barrier();

    // Step 2: Compute sum(exp(x - max)) accumulating in float
    float local_sum = 0.0;
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        local_sum += exp(input_data[base_idx + i] - row_max);
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    float log_sum_exp = log(shared_sum[0]);
    barrier();

    // Step 3: Compute log_softmax = x - max - log(sum(exp(x - max)))
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        output_data[base_idx + i] = input_data[base_idx + i] - row_max - log_sum_exp;
    }
}
