#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Log Softmax with numerical stability (accumulates in double for Float32 inputs)
layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint WORKGROUP_SIZE = 256;

layout(binding = 0) buffer Input { float input_data[]; };
layout(binding = 1) buffer Output { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
    uint dim;
} params;

shared float shared_max[WORKGROUP_SIZE];
shared double shared_sum[WORKGROUP_SIZE];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.x;

    if (batch_idx >= params.batch_size) {
        return;
    }

    uint base_idx = batch_idx * params.num_classes;

    // Step 1: Find maximum for numerical stability
    float local_max = -1.0 / 0.0; // -infinity
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        local_max = max(local_max, input_data[base_idx + i]);
    }
    shared_max[tid] = local_max;
    barrier();

    // Parallel reduction for max
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
        }
        barrier();
    }

    float row_max = shared_max[0];
    barrier();

    // Step 2: Compute sum(exp(x - max)) accumulating in double
    double local_sum = 0.0lf;
    double row_max_d = double(row_max);
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        // Widen diff to double before exp to get higher precision.
        // exp() on double uses the software f64 path on desktop GPUs.
        double diff_d = double(input_data[base_idx + i]) - row_max_d;
        // Manual exp in double via range reduction + 11-term Taylor:
        // exp(x) = 2^k * exp(r)  where r = x - k*ln2  and |r| <= ln2/2
        double ln2 = 0.69314718055994530941723212145817657lf;
        double inv_ln2 = 1.4426950408889634073599246810018921lf;
        double k_d = floor(diff_d * inv_ln2 + 0.5lf);
        double r = diff_d - k_d * ln2;
        // Taylor series of exp(r) around 0
        double er = 1.0lf;
        double term = 1.0lf;
        for (int n = 1; n <= 15; ++n) {
            term = term * r / double(n);
            er += term;
        }
        int k_i = int(k_d);
        // Scale by 2^k via ldexp-like bit manipulation is not available for double,
        // so use float exp2 -- adequate because k is a small integer.
        double scale = double(exp2(float(k_i)));
        local_sum += er * scale;
    }
    shared_sum[tid] = local_sum;
    barrier();

    // Parallel reduction for sum
    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    // Compute log(sum) in double via Newton's method starting from float log.
    double sum_d = shared_sum[0];
    double log_sum_exp_d;
    {
        // Initial guess from float log
        double y = double(log(float(sum_d)));
        // One Newton step: y <- y + (sum_d / exp(y) - 1)
        // Use double exp via same polynomial
        double r2 = y;
        double ln2 = 0.69314718055994530941723212145817657lf;
        double inv_ln2 = 1.4426950408889634073599246810018921lf;
        double k2 = floor(r2 * inv_ln2 + 0.5lf);
        double rr = r2 - k2 * ln2;
        double er2 = 1.0lf;
        double trm = 1.0lf;
        for (int n = 1; n <= 15; ++n) {
            trm = trm * rr / double(n);
            er2 += trm;
        }
        double scale2 = double(exp2(float(int(k2))));
        double ey = er2 * scale2;
        y = y + (sum_d / ey - 1.0lf);
        log_sum_exp_d = y;
    }
    barrier();

    // Step 3: Compute log_softmax = x - max - log(sum(exp(x - max)))
    for (uint i = tid; i < params.num_classes; i += WORKGROUP_SIZE) {
        double out_d = double(input_data[base_idx + i]) - row_max_d - log_sum_exp_d;
        output_data[base_idx + i] = float(out_d);
    }
}
