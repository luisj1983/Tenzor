#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Matrix multiplication with B transposed for Float16 — per-vendor workgroup specialization
// Computes C = A @ B^T where B is stored in transposed layout
// F16 packed buffers (2 Float16 per uint32), accumulation in float32
layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout(constant_id = 0) const uint TILE_X = 16;  // default fallback
layout(constant_id = 1) const uint TILE_Y = 16;  // default fallback

layout(binding = 0) buffer MatrixA { uint a[]; };
layout(binding = 1) buffer MatrixB { uint b[]; };  // Stored as B^T with shape [N, K]
layout(binding = 2) buffer MatrixC { uint c[]; };

layout(push_constant) uniform PushConstants {
    uint M;  // rows of A and C
    uint N;  // cols of C (and rows of B^T in memory)
    uint K;  // cols of A (and cols of B^T in memory)
} params;

shared float tileA[TILE_Y][TILE_X];
shared float tileB[TILE_X][TILE_X];

// Read a single float16 element from packed uint buffer
float readF16A(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = a[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

float readF16B(uint element_idx) {
    uint word_idx = element_idx / 2;
    uint word_offset = element_idx % 2;
    uint packed = b[word_idx];
    uint bits = (packed >> (word_offset * 16)) & 0xFFFFu;
    return unpackHalf2x16(bits | (bits << 16)).x;
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;
    uint linear_id = local_row * TILE_X + local_col;
    uint num_threads = TILE_X * TILE_Y;

    float sum = 0.0;

    // Tile-based computation — K is tiled in steps of TILE_X
    uint num_tiles = (params.K + TILE_X - 1) / TILE_X;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from A: TILE_Y x TILE_X, one per thread
        uint a_row = row;
        uint a_col = t * TILE_X + local_col;
        if (a_row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = readF16A(a_row * params.K + a_col);
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from B (transposed): TILE_X x TILE_X elements, linearized
        // B is stored with shape [N, K], so B[j, k] = b[j * K + k]
        for (uint i = linear_id; i < TILE_X * TILE_X; i += num_threads) {
            uint br = i / TILE_X;   // k index within tile
            uint bc = i % TILE_X;   // j index within tile
            uint b_k = t * TILE_X + br;
            uint b_j = gl_WorkGroupID.x * TILE_X + bc;
            if (b_k < params.K && b_j < params.N) {
                tileB[br][bc] = readF16B(b_j * params.K + b_k);
            } else {
                tileB[br][bc] = 0.0;
            }
        }

        barrier();

        // Compute partial dot product in float32 over TILE_X elements along K
        for (uint k = 0; k < TILE_X; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    // Write result (packed F16). Use atomicCompSwap so threads writing to
    // different halves of the same 32-bit word (which always happens for
    // adjacent col indices, and for adjacent rows when N is odd) cannot
    // corrupt each other via a racy non-atomic read-modify-write.
    if (row < params.M && col < params.N) {
        uint out_elem = row * params.N + col;
        uint out_word = out_elem >> 1u;
        uint out_off = out_elem & 1u;
        uint bits = packHalf2x16(vec2(sum, 0.0)) & 0xFFFFu;
        uint shift = out_off * 16u;
        uint mask = 0xFFFFu << shift;

        uint old_val = c[out_word];
        for (uint iter = 0u; iter < 65536u; iter++) {
            uint expected = old_val;
            uint new_val = (expected & ~mask) | (bits << shift);
            old_val = atomicCompSwap(c[out_word], expected, new_val);
            if (old_val == expected) return;
        }
        // KK.9: removed non-atomic plain-store fallback; cap raised from 64 to 65536.
    }
}
