#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Batched matrix multiplication with tiling for Float64
// C[b, :, :] = A[b, :, :] @ B[b, :, :]
// A: (batch, M, K), B: (batch, K, N), C: (batch, M, N)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer MatrixA { double a[]; };
layout(binding = 1) buffer MatrixB { double b[]; };
layout(binding = 2) buffer MatrixC { double c[]; };

layout(push_constant) uniform PushConstants {
    uint batch;  // batch size
    uint M;      // rows of A
    uint N;      // cols of B
    uint K;      // cols of A / rows of B
} params;

shared double tileA[16][16];
shared double tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y % params.M;
    uint col = gl_GlobalInvocationID.x;
    uint batch_idx = gl_GlobalInvocationID.y / params.M;

    // Early exit if out of bounds
    if (batch_idx >= params.batch || col >= params.N) {
        return;
    }

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    // Batch strides
    uint a_batch_stride = params.M * params.K;
    uint b_batch_stride = params.K * params.N;
    uint c_batch_stride = params.M * params.N;

    // Base offsets for this batch
    uint a_base = batch_idx * a_batch_stride;
    uint b_base = batch_idx * b_batch_stride;
    uint c_base = batch_idx * c_batch_stride;

    double sum = 0.0;

    // Tile-based computation
    uint num_tiles = (params.K + 15) / 16;

    for (uint t = 0; t < num_tiles; t++) {
        // Load tile from A
        uint a_row = row;
        uint a_col = t * 16 + local_col;
        if (a_row < params.M && a_col < params.K) {
            tileA[local_row][local_col] = a[a_base + a_row * params.K + a_col];
        } else {
            tileA[local_row][local_col] = 0.0;
        }

        // Load tile from B
        uint b_row = t * 16 + local_row;
        uint b_col = col;
        if (b_row < params.K && b_col < params.N) {
            tileB[local_row][local_col] = b[b_base + b_row * params.N + b_col];
        } else {
            tileB[local_row][local_col] = 0.0;
        }

        barrier();

        // Compute partial dot product
        for (uint k = 0; k < 16; k++) {
            sum += tileA[local_row][k] * tileB[k][local_col];
        }

        barrier();
    }

    // Write result
    if (row < params.M && col < params.N) {
        c[c_base + row * params.N + col] = sum;
    }
}
