#version 450

// BF16 utility: unpack two bfloat16 values from a uint32 word
vec2 unpackBF16x2(uint packed) {
    float lo = uintBitsToFloat((packed & 0xFFFFu) << 16);
    float hi = uintBitsToFloat(packed & 0xFFFF0000u);
    return vec2(lo, hi);
}

// BF16 utility: pack two float values into a uint32 as bfloat16 (round-to-nearest-even)
uint packBF16x2(vec2 v) {
    uint b0 = floatBitsToUint(v.x);
    uint b1 = floatBitsToUint(v.y);
    uint bf0 = (b0 + 0x7FFFu + ((b0 >> 16) & 1u)) >> 16;
    uint bf1 = (b1 + 0x7FFFu + ((b1 >> 16) & 1u)) >> 16;
    return bf0 | (bf1 << 16);
}

// Complex-to-Real IFFT: Pack N/2+1 complex frequency bins into N/2 complex values — BFloat16
// This is the inverse of rfft_unpack: given X[0..N/2], reconstruct Z[0..N/2-1]
// such that a N/2-point inverse FFT of Z gives the packed real output.
//
// Z[k] = X[k] + conj(X[N/2-k]) + i*W_N^{-k}*(X[k] - conj(X[N/2-k]))

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InputBuf  { uint data_in[];  };  // N/2+1 complex
layout(set = 0, binding = 1) buffer OutputBuf { uint data_out[]; };  // N/2 complex

layout(push_constant) uniform PushConstants {
    uint n;            // Original real FFT size (N)
    uint batch_offset; // Offset in complex elements into data_out
};

const float PI = 3.14159265358979323846;

vec2 readInput(uint idx) {
    return unpackBF16x2(data_in[idx]);
}

void writeOutput(uint idx, vec2 val) {
    data_out[batch_offset + idx] = packBF16x2(val);
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint half_n = n / 2;

    if (tid >= half_n) return;

    if (tid == 0) {
        // Z[0] = (X[0].re + X[N/2].re, X[0].re - X[N/2].re)
        vec2 x0 = readInput(0);
        vec2 xn = readInput(half_n);
        writeOutput(0, vec2(x0.x + xn.x, x0.x - xn.x));
        return;
    }

    uint k = tid;
    uint conj_k = half_n - k;

    // X[k]
    vec2 xk = readInput(k);
    // conj(X[N/2-k])
    vec2 xc_raw = readInput(conj_k);
    vec2 xc = vec2(xc_raw.x, -xc_raw.y);

    // A = X[k] + conj(X[N/2-k])
    float a_re = xk.x + xc.x;
    float a_im = xk.y + xc.y;

    // B = X[k] - conj(X[N/2-k])
    float b_re = xk.x - xc.x;
    float b_im = xk.y - xc.y;

    // Twiddle: W^{-k} = exp(+2*pi*i*k/N)
    float angle = 2.0 * PI * float(k) / float(n);
    float w_re = cos(angle);
    float w_im = sin(angle);

    // i * W^{-k} * B
    float iw_b_re = -(w_im * b_re + w_re * b_im);
    float iw_b_im =   w_re * b_re - w_im * b_im;

    // Z[k] = A + i*W^{-k}*B
    writeOutput(k, vec2(a_re + iw_b_re, a_im + iw_b_im));
}
