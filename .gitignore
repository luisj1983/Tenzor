# Build directories
build/
bin/
lib/
cmake-build-*/

# Third-party binary distributions (large, not source). Kept here so
# CMake can find them locally without polluting $HOME. See
# docs/jit-mlir-setup.md for what should live here.
third_party/iree_dist/
.venv-iree/

# Compiled files
*.o
*.so
*.a
*.dylib
*.dll
*.exe

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.cache/
.claude/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
# CMake-generated config files (templates live in cmake/)
/TenzorConfig.cmake
/TenzorConfigVersion.cmake
/tenzor.pc
# CMake-generated artifacts from accidental in-source builds at repo root
/_deps/
/generated/
/compile_commands.json

# Testing
Testing/
CTestTestfile.cmake

# Documentation
docs/_build/
docs/api/html/
docs/api/xml/

# Example / test run artifacts at repo root
/*.onnx
/*.pth
/currentfailures.txt

# Sanitizer / fuzz output
fuzz-*.log
crash-*
.bench-mkl-shim/

# Local git worktrees
.worktrees/
.superpowers/

# audit-11 PP.4: gtest_discover_tests / tenzor_discover_tests PRE_TEST
# include files are auto-generated into the build tree by cmake (see
# tests/CMakeLists.txt:241 — CMAKE_CURRENT_BINARY_DIR). A previous commit
# (d710e695) accidentally checked in 1492 copies of these files with the
# original developer's absolute /home/lee/Projects/Tenzor/ paths baked in,
# which made the EXISTS check fail on every other machine and silently
# degraded test discovery to *_NOT_BUILT for every test.
tests/**/*\[1\]_include.cmake
tests/**/*\[1\]_tests.cmake
